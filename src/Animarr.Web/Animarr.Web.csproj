<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- L-12: pinned versions (resolved via `dotnet list package` 2026-05-12).
       Bump deliberately rather than letting `*` drift. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.2" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.2" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <!-- Hosts the WASM client's _framework bundle + maps SPA fallback. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
    <!-- v4 auth: BCrypt for password hashing (work factor 12, ~250ms verify).
         BCrypt.Net-Next is the canonical .NET fork — actively maintained. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animarr.Shared\Animarr.Shared.csproj" />
    <!-- Reference the WASM client so its static files (Animarr.Web.Client.bundle
         scope CSS, _framework/blazor.webassembly.js, .dll bundle) get copied
         into Animarr.Web's wwwroot at publish time. Map a fallback route in
         Program.cs to serve them as the SPA. -->
    <ProjectReference Include="..\Animarr.Web.Client\Animarr.Web.Client.csproj" />
  </ItemGroup>

</Project>
