<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The WebAssembly.Server package copies the 12 MB BlazorDebugProxy/ tool into
       every output. It only serves app.UseWebAssemblyDebugging(), which Program.cs
       never calls, so keep it out of Release builds and the published image. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <BlazorWebAssemblyOmitDebugProxyOutput>true</BlazorWebAssemblyOmitDebugProxyOutput>
  </PropertyGroup>

  <!-- L-12: pinned versions (resolved via `dotnet list package` 2026-05-12).
       Bump deliberately rather than letting `*` drift. -->
  <ItemGroup>
    <!-- Design-time only (dotnet ef migrations / database update). PrivateAssets
         keeps it — and the Roslyn / MSBuild / Humanizer graph it drags in, ~25 MB
         incl. 13 satellite-language dirs — out of the publish output and the
         Docker image; the dotnet-ef tool still loads it from the build output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <!-- Hosts the WASM client's _framework bundle + maps SPA fallback. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <!-- v4 auth: BCrypt for password hashing (work factor 12, ~250ms verify).
         BCrypt.Net-Next is the canonical .NET fork — actively maintained. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- v5 multi-server: advertise the install over mDNS as _animarr._tcp.local.
         Tmds.MDns is browse-only (no Advertise method); Makaretu.Dns.Multicast
         provides ServiceProfile + ServiceDiscovery.Advertise, which is what we
         need. Compatible with net10.0 via netstandard2.0. -->
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <!-- Makaretu pulls in IPNetwork2, whose System.Net.IPNetwork collides with
         the BCL type of the same name (used for ANIMARR_TRUSTED_PROXIES /
         ForwardedHeadersOptions.KnownIPNetworks). Same version, aliased away
         so the plain name means the BCL type. -->
    <PackageReference Include="IPNetwork2" Version="2.1.2" Aliases="IPNetwork2" />
    <!-- v5 Phase 7 TV pairing: server-side QR generation. PngByteQRCode is
         a pure-managed PNG encoder (no System.Drawing native deps) so it
         runs cleanly under the Debian-slim runtime image. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animarr.Shared\Animarr.Shared.csproj" />
    <!-- Reference the WASM client so its static files (Animarr.Web.Client.bundle
         scope CSS, _framework/blazor.webassembly.js, .dll bundle) get copied
         into Animarr.Web's wwwroot at publish time. Map a fallback route in
         Program.cs to serve them as the SPA. -->
    <ProjectReference Include="..\Animarr.Web.Client\Animarr.Web.Client.csproj" />
  </ItemGroup>

</Project>
