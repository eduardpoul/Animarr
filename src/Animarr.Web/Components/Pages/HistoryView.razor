@*
    Embed-able rename-history view (extracted from History.razor).
    Used by:
      - the standalone /history and /renames routes (via History.razor wrapper)
      - Settings → Rename history tab
    No @page directive — pure component.

    UI: two-tab segmented control (Renames / Scan logs), each rendering a
    plain HTML <table class="d-table"> with simple prev/next pagination on
    the renames tab. No FluentX usage.
*@

@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IRenameService RenameService
@inject IToastService ToastService

@* Segmented tabs (native buttons) — design pattern for the embedded view. *@
<div class="hv-tabs">
    <button type="button"
            class="@($"hv-tab {(_activeTab == "renames" ? "hv-tab--active" : "")}")"
            @onclick="@(() => _activeTab = "renames")">@L["history.tab_renames"]</button>
    <button type="button"
            class="@($"hv-tab {(_activeTab == "scanlogs" ? "hv-tab--active" : "")}")"
            @onclick="@(() => _activeTab = "scanlogs")">@L["history.tab_scan_logs"]</button>
</div>

@if (_activeTab == "renames")
{
    <div class="hv-pane">

    <div class="hv-filters">
        <label class="settings-field hv-filter-field">
            <span class="settings-field__label">@L["history.filter_folder_label"]</span>
            <select class="settings-field__select"
                    value="@_filterFolder"
                    @onchange="@(async e => { _filterFolder = e.Value?.ToString() ?? ""; await OnFilterChangedAsync(); })">
                <option value="">@L["history.filter_folder_all"]</option>
                @foreach (var f in _allFolders)
                {
                    <option value="@f.Id.ToString()">@f.Label</option>
                }
            </select>
        </label>
        <label class="settings-field hv-filter-field hv-filter-field--narrow">
            <span class="settings-field__label">@L["history.filter_status_label"]</span>
            <select class="settings-field__select"
                    value="@_filterStatus"
                    @onchange="@(async e => { _filterStatus = e.Value?.ToString() ?? ""; await OnFilterChangedAsync(); })">
                <option value="">@L["history.filter_status_all"]</option>
                <option value="Renamed">@L["history.status_renamed"]</option>
                <option value="Skipped">@L["history.status_skipped"]</option>
                <option value="Error">@L["history.status_error"]</option>
                <option value="Reverted">@L["history.status_reverted"]</option>
            </select>
        </label>
        <button type="button" class="hv-icon-btn" title="@L["history.btn_reset_filters"]" @onclick="ResetFilters">
            <DIcon Name="x" Size="16" />
        </button>
    </div>

    @if (_loading)
    {
        @* Three-dot loader while the rename history page query runs.
           Spec: loaders.html §06. *@
        <div class="hv-loading">
            <InlineDots Label="Loading rename history" />
        </div>
    }
    else
    {
        <div class="d-table-wrap">
            <table class="d-table d-table--renames">
                <thead>
                    <tr>
                        <th>@L["history.col_date"]</th>
                        <th>@L["history.col_folder"]</th>
                        <th>@L["history.col_original_name"]</th>
                        <th></th>
                        <th>@L["history.col_new_name"]</th>
                        <th>@L["history.col_status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pageItems.Count == 0)
                    {
                        <tr><td colspan="7" class="d-table__empty">@L["history.empty"]</td></tr>
                    }
                    else
                    {
                        @foreach (var ctx in _pageItems)
                        {
                            var folderLabel = _allFolders.FirstOrDefault(f => f.Id == ctx.FolderId)?.Label ?? "—";
                            <tr>
                                <td class="d-table__date">@ctx.ProcessedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td>
                                <td class="d-table__folder" title="@folderLabel">@folderLabel</td>
                                <td class="d-table__name"><code>@Path.GetFileName(ctx.OriginalPath)</code></td>
                                <td class="d-table__arrow">→</td>
                                <td class="d-table__name"><code>@Path.GetFileName(ctx.NewPath)</code></td>
                                <td class="d-table__status">
                                    <Pill Tone="@StatusTone(ctx.Status)" Dense="true">@GetStatusLabel(ctx.Status)</Pill>
                                </td>
                                <td class="d-table__actions">
                                    @if (ctx.Status == RenameStatus.Renamed && !ctx.IsReverted)
                                    {
                                        <button type="button" class="hv-icon-btn"
                                                title="@L["history.btn_revert"]"
                                                @onclick="@(() => AskRevert(ctx))">
                                            <DIcon Name="undo" Size="16" />
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="hv-pager">
            <button type="button" class="hv-icon-btn"
                    disabled="@(_pageIndex == 0)"
                    @onclick="PrevPageAsync">
                <DIcon Name="chev-l" Size="14" />
            </button>
            <span class="hv-pager__label">
                @(_totalCount == 0 ? 0 : _pageIndex * PageSize + 1)–@(Math.Min(_totalCount, (_pageIndex + 1) * PageSize)) / @_totalCount
            </span>
            <button type="button" class="hv-icon-btn"
                    disabled="@((_pageIndex + 1) * PageSize >= _totalCount)"
                    @onclick="NextPageAsync">
                <DIcon Name="chev-r" Size="14" />
            </button>
        </div>
    }
    </div>
}

@if (_activeTab == "scanlogs")
{
    <div class="hv-pane">

    <div class="hv-filters">
        <label class="settings-field hv-filter-field">
            <span class="settings-field__label">@L["history.filter_folder_label"]</span>
            <select class="settings-field__select"
                    value="@_scanFilterFolder"
                    @onchange="@(e => { _scanFilterFolder = e.Value?.ToString() ?? ""; StateHasChanged(); })">
                <option value="">@L["history.filter_folder_all"]</option>
                @foreach (var f in _allFolders)
                {
                    <option value="@f.Id.ToString()">@f.Label</option>
                }
            </select>
        </label>
        <label class="settings-field hv-filter-field hv-filter-field--narrow">
            <span class="settings-field__label">@L["history.filter_status_label"]</span>
            <select class="settings-field__select"
                    value="@_scanFilterStatus"
                    @onchange="@(e => { _scanFilterStatus = e.Value?.ToString() ?? ""; StateHasChanged(); })">
                <option value="">@L["history.filter_status_all"]</option>
                <option value="Done">@L["history.scan_status_done"]</option>
                <option value="Failed">@L["history.scan_status_failed"]</option>
                <option value="Queued">@L["history.scan_status_queued"]</option>
                <option value="Processing">@L["history.scan_status_processing"]</option>
            </select>
        </label>
        <button type="button" class="hv-icon-btn" title="@L["history.btn_reset_filters"]" @onclick="ResetScanFilters">
            <DIcon Name="x" Size="16" />
        </button>
        <button type="button" class="hv-icon-btn" title="@L["history.btn_refresh"]" @onclick="LoadAsync">
            <DIcon Name="refresh" Size="16" />
        </button>
    </div>

    @if (_loading)
    {
        <div class="hv-loading">
            <InlineDots Label="Loading scan logs" />
        </div>
    }
    else if (!FilteredScanJobs().Any())
    {
        <div class="hv-empty">@L["history.scan_empty"]</div>
    }
    else
    {
        <div class="hv-scanlist">
            @foreach (var job in FilteredScanJobs())
            {
                var folder = _allFolders.FirstOrDefault(f => f.Id == job.FolderId);
                <div class="hv-scan">
                    <button type="button" class="hv-scan__head" @onclick="@(() => ToggleScanLog(job.Id))">
                        <Pill Tone="@ScanStatusTone(job.Status)" Dense="true">@ScanStatusLabel(job.Status)</Pill>
                        <span class="hv-scan__title">@(folder?.Label ?? job.FolderId.ToString())</span>
                        <span class="hv-scan__when">
                            @((job.ProcessedAt ?? job.QueuedAt).ToLocalTime().ToString("dd.MM.yy HH:mm"))
                        </span>
                        @if (!string.IsNullOrEmpty(job.ErrorMessage))
                        {
                            <span class="hv-scan__err" title="@job.ErrorMessage">⚠ @job.ErrorMessage</span>
                        }
                        <span class="hv-scan__chev">
                            <DIcon Name="@(_expandedScanIds.Contains(job.Id) ? "chev-d" : "chev-r")" Size="14" />
                        </span>
                    </button>
                    @if (_expandedScanIds.Contains(job.Id))
                    {
                        @if (!string.IsNullOrEmpty(job.LogDetails))
                        {
                            <div class="hv-scan__body">
                                <pre class="hv-scan__log">@job.LogDetails</pre>
                            </div>
                        }
                        else
                        {
                            <div class="hv-scan__body hv-scan__body--empty">@L["history.scan_no_log"]</div>
                        }
                    }
                </div>
            }
        </div>
    }
    </div>
}

@if (!_revertHidden)
{
    <div class="rvdlg-overlay" @onclick="@(() => _revertHidden = true)"></div>
    <div class="rvdlg" role="dialog" aria-modal="true">
        <header class="rvdlg__header">
            <h4 class="rvdlg__title">@L["history.revert_dialog_title"]</h4>
            <button type="button" class="rvdlg__close" @onclick="@(() => _revertHidden = true)" aria-label="Close">
                <DIcon Name="x" Size="18" />
            </button>
        </header>
        <div class="rvdlg__body">
            @L["history.revert_dialog_body"]<br />
            <b>@Path.GetFileName(_revertTarget?.NewPath ?? "")</b>
            &nbsp;→&nbsp;
            <b>@Path.GetFileName(_revertTarget?.OriginalPath ?? "")</b>
        </div>
        <footer class="rvdlg__footer">
            @* Loading flips while RenameService.RevertAsync is in flight —
               the dialog Btn becomes the source of truth (per-row revert is
               an icon button below, not a Btn primitive). Spec: loaders.html §04. *@
            <Btn Variant="primary" OnClick="ConfirmRevert"
                 Loading="@(_revertingId is not null && _revertTarget?.Id == _revertingId)">
                @L["history.btn_revert_confirm"]
            </Btn>
            <Btn Variant="flat" OnClick="@(() => _revertHidden = true)">@L["history.btn_cancel"]</Btn>
        </footer>
    </div>
}

@code {
    private const int PageSize = 50;

    // H-6: server-side paginated history page.
    private List<RenameHistory> _pageItems = [];
    private int _pageIndex;
    private int _totalCount;

    private List<FolderWatcher> _allFolders = [];
    private List<IdentificationQueue> _scanJobs = [];
    private bool _loading = true;
    private string _filterFolder = "";
    private string _filterStatus = "";
    private string _scanFilterFolder = "";
    private string _scanFilterStatus = "";
    private string _activeTab = "renames";
    private HashSet<Guid> _expandedScanIds = [];

    private bool _revertHidden = true;
    private RenameHistory? _revertTarget;
    // Per-row revert tracking — Guid of the entry currently being reverted,
    // null when no revert is in-flight. The dialog Btn flips its Loading
    // state on the matching row. Spec: loaders.html §04.
    private Guid? _revertingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _allFolders = await db.FolderWatchers.OrderBy(f => f.Label).ToListAsync();
        await LoadHistoryPageAsync(db);
        _scanJobs   = await db.IdentificationQueues
            .OrderByDescending(q => q.ProcessedAt ?? q.QueuedAt)
            .Take(200)
            .ToListAsync();
        StateHasChanged();
    }

    private async Task LoadHistoryPageAsync(AppDbContext db)
    {
        IQueryable<RenameHistory> q = db.RenameHistories;
        if (!string.IsNullOrEmpty(_filterFolder) && Guid.TryParse(_filterFolder, out var fid))
            q = q.Where(h => h.FolderId == fid);
        if (!string.IsNullOrEmpty(_filterStatus) && Enum.TryParse<RenameStatus>(_filterStatus, out var st))
            q = q.Where(h => h.Status == st);

        _totalCount = await q.CountAsync();
        if (_pageIndex * PageSize >= _totalCount)
            _pageIndex = Math.Max(0, (_totalCount - 1) / PageSize);

        _pageItems = await q
            .OrderByDescending(h => h.ProcessedAt)
            .Skip(_pageIndex * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        _pageIndex = 0;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadHistoryPageAsync(db);
    }

    private async Task NextPageAsync()
    {
        if ((_pageIndex + 1) * PageSize >= _totalCount) return;
        _pageIndex++;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadHistoryPageAsync(db);
    }

    private async Task PrevPageAsync()
    {
        if (_pageIndex == 0) return;
        _pageIndex--;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadHistoryPageAsync(db);
    }

    private async Task ResetFilters()
    {
        _filterFolder = ""; _filterStatus = "";
        await OnFilterChangedAsync();
    }

    private void ResetScanFilters() { _scanFilterFolder = ""; _scanFilterStatus = ""; }

    private IEnumerable<IdentificationQueue> FilteredScanJobs()
    {
        var q = _scanJobs.AsEnumerable();
        if (!string.IsNullOrEmpty(_scanFilterFolder) && Guid.TryParse(_scanFilterFolder, out var fid))
            q = q.Where(j => j.FolderId == fid);
        if (!string.IsNullOrEmpty(_scanFilterStatus) && Enum.TryParse<IdentificationQueueStatus>(_scanFilterStatus, out var st))
            q = q.Where(j => j.Status == st);
        return q;
    }

    private void ToggleScanLog(Guid id)
    {
        if (!_expandedScanIds.Add(id))
            _expandedScanIds.Remove(id);
    }

    private void AskRevert(RenameHistory r) { _revertTarget = r; _revertHidden = false; }

    private async Task ConfirmRevert()
    {
        if (_revertTarget is null) return;
        _revertingId = _revertTarget.Id;
        StateHasChanged();
        try
        {
            var ok = await RenameService.RevertAsync(_revertTarget.Id);
            ToastService.ShowToast(ok ? ToastIntent.Success : ToastIntent.Error,
                ok ? L["history.toast_revert_ok"] : L["history.toast_revert_fail"]);
            _revertHidden = true;
            _revertTarget = null;
            await LoadAsync();
        }
        finally { _revertingId = null; StateHasChanged(); }
    }

    private string GetStatusLabel(RenameStatus s) => s switch
    {
        RenameStatus.Renamed  => L["history.status_renamed"],
        RenameStatus.Skipped  => L["history.status_skipped"],
        RenameStatus.Error    => L["history.status_error"],
        RenameStatus.Reverted => L["history.status_reverted"],
        _ => "—"
    };

    // Map RenameStatus → Pill tone (replaces FluentBadge Appearance).
    private static string StatusTone(RenameStatus s) => s switch
    {
        RenameStatus.Renamed  => "accent",
        RenameStatus.Error    => "warn",
        RenameStatus.Reverted => "info",
        _                     => "default",
    };

    private string ScanStatusLabel(IdentificationQueueStatus s) => s switch
    {
        IdentificationQueueStatus.Done       => L["history.scan_status_done"],
        IdentificationQueueStatus.Failed     => L["history.scan_status_failed"],
        IdentificationQueueStatus.Processing => L["history.scan_status_processing"],
        _                                    => L["history.scan_status_queued"],
    };

    private static string ScanStatusTone(IdentificationQueueStatus s) => s switch
    {
        IdentificationQueueStatus.Done       => "success",
        IdentificationQueueStatus.Failed     => "warn",
        IdentificationQueueStatus.Processing => "info",
        _                                    => "default",
    };
}
