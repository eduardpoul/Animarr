@* Phase 2.1: /browse is deprecated — it duplicated MediaDetail's subfolders
   section and Explorer's file-system view. Redirect to Explorer; the back-id
   query parameter is preserved so the Explorer page can highlight the parent
   media item if desired in the future. *@
@page "/browse"
@rendermode InteractiveServer
@inject NavigationManager Nav

@code {
    [SupplyParameterFromQuery(Name = "path")] public string? Path { get; set; }
    [SupplyParameterFromQuery(Name = "back")] public string? Back { get; set; }

    protected override void OnInitialized()
    {
        var dest = string.IsNullOrEmpty(Path)
            ? "/explorer"
            : $"/explorer?path={Uri.EscapeDataString(Path)}";
        Nav.NavigateTo(dest, replace: true);
    }
}
