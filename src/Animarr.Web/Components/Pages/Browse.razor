@page "/browse"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.RegularExpressions
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject IAppConfigService AppConfig

<PageTitle>@(_navStack.Count > 0 ? _navStack[^1].Label : "Browse") — Animarr</PageTitle>

<style>
    .browse-grid-dirs {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
        margin-bottom: 28px;
    }
    .browse-grid-files {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 10px;
    }
    .browse-card {
        border-radius: 8px;
        overflow: hidden;
        background: var(--neutral-layer-2);
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
        user-select: none;
        border: 1px solid transparent;
    }
    .browse-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(0,0,0,.35);
        border-color: var(--neutral-stroke-strong);
    }
    .browse-art-poster {
        aspect-ratio: 2/3;
        overflow: hidden;
        background: var(--neutral-layer-3);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .browse-art-video {
        aspect-ratio: 16/9;
        overflow: hidden;
        background: var(--neutral-layer-3);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    .browse-art-poster img, .browse-art-video img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .browse-card-label {
        padding: 6px 8px 7px;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .browse-card-meta {
        padding: 0 8px 7px;
        font-size: 11px;
        color: var(--neutral-foreground-hint);
    }
    .browse-play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity .15s;
        background: rgba(0,0,0,.3);
    }
    .browse-card:hover .browse-play-overlay {
        opacity: 1;
    }
    .browse-section-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--neutral-foreground-hint);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 12px;
    }
</style>

@if (_loading)
{
    <FluentProgress Width="100%" />
}
else
{
    <!-- ── Header ─────────────────────────────────────────────────── -->
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:20px;flex-wrap:wrap;">
        <FluentButton Appearance="Appearance.Stealth"
                      IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                      OnClick="NavigateBack" />

        <div style="display:flex;align-items:center;gap:6px;flex:1;min-width:0;flex-wrap:wrap;font-size:18px;font-weight:600;">
            @if (_backTitle != null)
            {
                <span style="cursor:pointer;color:var(--accent-foreground-rest);"
                      @onclick="GoBackToCatalog">
                    @_backTitle
                </span>
                <span style="color:var(--neutral-foreground-hint);font-weight:400;">/</span>
            }
            @for (int i = 0; i < _navStack.Count; i++)
            {
                var entry = _navStack[i];
                var idx = i;
                if (i > 0)
                {
                    <span style="color:var(--neutral-foreground-hint);font-weight:400;">/</span>
                }
                if (i == _navStack.Count - 1)
                {
                    <span>@entry.Label</span>
                }
                else
                {
                    <span style="cursor:pointer;color:var(--accent-foreground-rest);"
                          @onclick="@(() => NavigateToCrumb(idx))">@entry.Label</span>
                }
            }
        </div>
    </div>

    <!-- ── Parent series hero (MediaDetail-style) ─────────────────── -->
    @if (_parentInfo != null)
    {
        var heroPoster  = GetInfoPosterUrl();
        var heroFanart  = GetInfoFanartUrl();
        var heroLogo    = GetInfoLogoUrl();
        var heroDesc    = _currentSeason?.Overview ?? _parentInfo.Description;
        var seasonLabel = _currentSeason?.Name is { Length: > 0 } sn
                          && !sn.Equals(_parentInfo.Title, StringComparison.OrdinalIgnoreCase)
                          ? sn
                          : _navStack.Count > 0 && !_navStack[^1].Label.Equals(_parentInfo.Title, StringComparison.OrdinalIgnoreCase)
                            ? _navStack[^1].Label
                            : null;
        var heroGenres = string.IsNullOrWhiteSpace(_parentInfo.GenresJson)
                         ? new List<string>()
                         : (JsonSerializer.Deserialize<List<string>>(_parentInfo.GenresJson) ?? []);

        <!-- Fanart hero banner -->
        @if (heroFanart != null)
        {
            <div style="position:relative;width:calc(100% + 48px);margin:-24px -24px 0;height:340px;overflow:hidden;">
                <img src="@heroFanart" alt=""
                     style="width:100%;height:100%;object-fit:cover;object-position:center top;display:block;" />
                <div style="position:absolute;inset:0;background:linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 80%, var(--neutral-layer-1,#1a1a1a) 100%);"></div>
                <div style="position:absolute;bottom:24px;left:28px;right:28px;">
                    @if (heroLogo != null)
                    {
                        <img src="@heroLogo" alt="@_parentInfo.Title" style="max-height:80px;max-width:340px;object-fit:contain;object-position:left;" />
                    }
                    else
                    {
                        <div style="font-size:26px;font-weight:700;color:white;text-shadow:0 2px 8px rgba(0,0,0,.8);">
                            @_parentInfo.Title
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Poster + meta block -->
        <div style="display:flex;gap:28px;align-items:flex-start;margin-top:@(heroFanart != null ? "16px" : "0");margin-bottom:24px;flex-wrap:wrap;">
            <!-- Poster -->
            <div style="flex-shrink:0;width:200px;">
                @if (heroPoster != null)
                {
                    <img src="@heroPoster" alt="@_parentInfo.Title"
                         style="width:200px;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,.3);display:block;"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div style="display:none;width:200px;aspect-ratio:2/3;border-radius:8px;background:var(--neutral-layer-3);align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,.3);">
                        <FluentIcon Value="@(new Icons.Regular.Size48.VideoClip())" Style="opacity:0.25;" />
                    </div>
                }
                else
                {
                    <div style="width:200px;aspect-ratio:2/3;border-radius:8px;background:var(--neutral-layer-3);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,.3);">
                        <FluentIcon Value="@(new Icons.Regular.Size48.VideoClip())" Style="opacity:0.25;" />
                    </div>
                }
            </div>

            <!-- Meta -->
            <div style="flex:1;min-width:240px;">
                <!-- Title -->
                @if (heroFanart != null)
                {
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:4px;">
                        <a href="/catalog/@_parentInfo.Id" style="color:inherit;text-decoration:none;">@_parentInfo.Title</a>
                    </FluentLabel>
                }
                <!-- Original title -->
                @if (!string.IsNullOrEmpty(_parentInfo.OriginalTitle) && _parentInfo.OriginalTitle != _parentInfo.Title)
                {
                    <div style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:6px;">@_parentInfo.OriginalTitle</div>
                }
                <!-- Season/folder label -->
                @if (seasonLabel != null)
                {
                    <div style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:6px;">@seasonLabel</div>
                }
                <!-- Pills row -->
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;align-items:center;">
                    @if (_parentInfo.Year.HasValue)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">@_parentInfo.Year</FluentBadge>
                    }
                    @if (_parentInfo.MediaType != MediaItemType.Unknown)
                    {
                        <FluentBadge Appearance="Appearance.Accent">
                            @(_parentInfo.MediaType switch {
                                MediaItemType.Anime  => L["catalog.badge_anime"],
                                MediaItemType.Series => L["catalog.badge_series"],
                                MediaItemType.Movie  => L["catalog.badge_movie"],
                                _                    => L["catalog.badge_unknown"],
                            })
                        </FluentBadge>
                    }
                    @if (seasonLabel != null)
                    {
                        <FluentBadge Appearance="Appearance.Lightweight">@seasonLabel</FluentBadge>
                    }
                    @if (_parentInfo.Rating.HasValue)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">★ @_parentInfo.Rating.Value.ToString("F1")</FluentBadge>
                    }
                </div>
                <!-- Genres -->
                @if (heroGenres.Count > 0)
                {
                    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;">
                        @foreach (var g in heroGenres)
                        {
                            <span style="font-size:12px;padding:2px 8px;background:var(--neutral-layer-3);border-radius:12px;color:var(--neutral-foreground-hint);">@g</span>
                        }
                    </div>
                }
                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(heroDesc))
                {
                    <div style="font-size:14px;line-height:1.6;color:var(--neutral-foreground-rest);margin-bottom:12px;max-width:680px;">
                        @heroDesc
                    </div>
                }
                <!-- Catalog link -->
                <div style="font-size:12px;color:var(--neutral-foreground-hint);">
                    <a href="/catalog/@_parentInfo.Id" style="color:var(--accent-fill-rest);">↗ @_parentInfo.Title</a>
                </div>
            </div>
        </div>
    }

    <!-- ── Subfolders — hidden when parent already has a seasons interface ── -->
    @if (_dirs.Count > 0 && (_parentInfo == null || _parentInfo.Seasons.Count == 0))
    {
        @if (_files.Count > 0)
        {
            <div class="browse-section-title">@L["browse.folders"]</div>
        }
        <div class="browse-grid-dirs">
            @foreach (var dir in _dirs)
            {
                var d = dir;
                <div class="browse-card" @onclick="@(() => OnDirClick(d))">
                    <div class="browse-art-poster">
                        @if (d.PosterUrl != null)
                        {
                            <img loading="lazy" src="@d.PosterUrl" alt="@d.Name" />
                        }
                        else
                        {
                            @if (d.MediaItemId.HasValue)
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size32.VideoClip())" Style="opacity:0.35;" />
                            }
                            else
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size32.Folder())" Style="opacity:0.35;" />
                            }
                        }
                    </div>
                    <div class="browse-card-label" title="@d.Name">@d.Name</div>
                </div>
            }
        </div>
    }

    <!-- ── Files ───────────────────────────────────────────────── -->
    @if (_files.Count > 0)
    {
        @if (_dirs.Count > 0)
        {
            <FluentDivider Style="margin-bottom:16px;" />
            <div class="browse-section-title">@L["browse.files"]</div>
        }
        <div class="browse-grid-files">
            @foreach (var f in _files)
            {
                var file = f;
                <div class="browse-card">
                    <div class="browse-art-video">
                        @if (file.ThumbUrl != null)
                        {
                            <img loading="lazy" src="@file.ThumbUrl" alt="@file.Name" />
                        }
                        else
                        {
                            @if (IsVideo(file.Ext))
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size32.Play())" Style="opacity:0.35;" />
                            }
                            else
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size32.ClosedCaption())" Style="opacity:0.35;" />
                            }
                        }
                        @if (IsVideo(file.Ext))
                        {
                            <div class="browse-play-overlay">
                                <FluentIcon Value="@(new Icons.Filled.Size32.Play())" Style="color:white;filter:drop-shadow(0 2px 6px rgba(0,0,0,.5));" />
                            </div>
                        }
                    </div>
                    <div class="browse-card-label" title="@file.Name">@file.Name</div>
                    <div class="browse-card-meta">@FormatSize(file.Size)</div>
                </div>
            }
        </div>
    }

    @if (_dirs.Count == 0 && _files.Count == 0)
    {
        <div style="text-align:center;padding:60px 0;color:var(--neutral-foreground-hint);">
            <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.25;margin-bottom:12px;display:block;margin-left:auto;margin-right:auto;" />
            <div>@L["browse.empty"]</div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "path")] public string? InitPath { get; set; }
    [SupplyParameterFromQuery(Name = "back")]  public string? Back { get; set; }

    private record NavEntry(string Path, string Label);
    private record SubDirItem(string Name, string Path, string? PosterUrl, Guid? MediaItemId);
    private record FileItem(string Name, string Path, long Size, string Ext, string? ThumbUrl);
    private record ParentInfo(Guid Id, string Title, int? Year, string? Description,
                               string? OriginalTitle, string? GenresJson, double? Rating,
                               MediaItemType MediaType,
                               string? PosterPath, string? FanartPath, string? LogoPath,
                               string FolderPath, List<SeasonMeta> Seasons,
                               long ImageVersion = 0);

    private List<NavEntry>   _navStack    = [];
    private List<SubDirItem> _dirs        = [];
    private List<FileItem>   _files       = [];
    private string?          _backTitle;
    private ParentInfo?      _parentInfo;
    private SeasonMeta?      _currentSeason;
    private bool             _loading  = true;

    private string CurrentPath => _navStack.Count > 0 ? _navStack[^1].Path : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(InitPath)) { _loading = false; return; }

        var label = System.IO.Path.GetFileName(
            InitPath.TrimEnd(System.IO.Path.DirectorySeparatorChar, System.IO.Path.AltDirectorySeparatorChar));
        _navStack = [new NavEntry(InitPath, string.IsNullOrEmpty(label) ? InitPath : label)];

        // Load back title from DB
        if (Guid.TryParse(Back, out var backId))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var mi = await db.MediaItems
                .Include(m => m.Folder)
                .Where(m => m.Id == backId)
                .Select(m => new {
                    m.Id, m.Title, m.Year, m.Description,
                    m.OriginalTitle, m.GenresJson, m.Rating, m.MediaType,
                    m.PosterPath, m.FanartPath, m.LogoPath,
                    FolderPath = m.Folder!.Path,
                    m.SeasonsJson,
                    m.LastMetadataRefreshedAt
                })
                .FirstOrDefaultAsync();

            if (mi != null)
            {
                _backTitle = mi.Title;
                List<SeasonMeta> seasons = [];
                if (!string.IsNullOrWhiteSpace(mi.SeasonsJson))
                {
                    try { seasons = JsonSerializer.Deserialize<List<SeasonMeta>>(mi.SeasonsJson) ?? []; }
                    catch { /* ignore malformed JSON */ }
                }
                _parentInfo = new ParentInfo(mi.Id, mi.Title ?? string.Empty, mi.Year,
                                             mi.Description, mi.OriginalTitle, mi.GenresJson, mi.Rating,
                                             mi.MediaType,
                                             mi.PosterPath, mi.FanartPath, mi.LogoPath,
                                             mi.FolderPath ?? string.Empty, seasons,
                                             mi.LastMetadataRefreshedAt?.Ticks ?? 0);
            }
        }

        // Try to match first nav entry to a season
        if (_parentInfo is { Seasons.Count: > 0 } && _navStack.Count > 0)
            _currentSeason = DetectSeason(_navStack[0].Label, _parentInfo.Seasons);

        await LoadCurrentAsync();
    }

    private async Task LoadCurrentAsync()
    {
        _loading = true;
        StateHasChanged();

        _dirs  = [];
        _files = [];

        var path = CurrentPath;
        if (string.IsNullOrEmpty(path) || !Directory.Exists(path))
        {
            _loading = false;
            return;
        }

        var videoExts    = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".mkv", ".mp4", ".avi", ".m4v", ".mov", ".wmv", ".ts", ".m2ts" };
        var subtitleExts = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".srt", ".ass", ".ssa", ".sub", ".vtt" };
        var allExts      = videoExts.Concat(subtitleExts).ToHashSet(StringComparer.OrdinalIgnoreCase);

        List<string> rawDirs  = [];
        List<string> rawFiles = [];

        try
        {
            rawDirs = [.. Directory.EnumerateDirectories(path)
                .Where(d => !System.IO.Path.GetFileName(d).StartsWith('.'))
                .OrderBy(d => d, StringComparer.OrdinalIgnoreCase)];
        }
        catch { /* access denied */ }

        try
        {
            rawFiles = [.. Directory.EnumerateFiles(path)
                .Where(f => allExts.Contains(System.IO.Path.GetExtension(f)))
                .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)];
        }
        catch { /* access denied */ }

        // DB: find registered MediaItems for subdirs
        Dictionary<string, Guid> dirMediaItems = [];
        if (rawDirs.Count > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var fwMatches = await db.FolderWatchers
                .Where(fw => rawDirs.Contains(fw.Path))
                .Select(fw => new { fw.Path, fw.Id })
                .ToListAsync();

            if (fwMatches.Count > 0)
            {
                var fwIds = fwMatches.Select(x => x.Id).ToList();
                var miMap = await db.MediaItems
                    .Where(m => fwIds.Contains(m.FolderId))
                    .Select(m => new { m.FolderId, m.Id })
                    .ToDictionaryAsync(m => m.FolderId, m => m.Id);

                foreach (var fw in fwMatches)
                {
                    if (miMap.TryGetValue(fw.Id, out var miId))
                        dirMediaItems[fw.Path] = miId;
                }
            }
        }

        _dirs = rawDirs.Select(d => new SubDirItem(
            System.IO.Path.GetFileName(d),
            d,
            FindDirPoster(d),
            dirMediaItems.TryGetValue(d, out var id) ? id : (Guid?)null
        )).ToList();

        _files = rawFiles.Select(f =>
        {
            var info = new FileInfo(f);
            return new FileItem(info.Name, f, info.Length, info.Extension.ToLowerInvariant(), FindFileThumb(f));
        }).ToList();

        _loading = false;
    }

    private void OnDirClick(SubDirItem dir)
    {
        if (dir.MediaItemId.HasValue)
            Nav.NavigateTo($"/catalog/{dir.MediaItemId.Value}");
        else
        {
            _navStack.Add(new NavEntry(dir.Path, dir.Name));
            _ = LoadCurrentAsync();
        }
    }

    private async Task NavigateBack()
    {
        if (_navStack.Count > 1)
        {
            _navStack.RemoveAt(_navStack.Count - 1);
            await LoadCurrentAsync();
        }
        else if (Guid.TryParse(Back, out var id))
        {
            Nav.NavigateTo($"/catalog/{id}");
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }

    private void GoBackToCatalog()
    {
        if (Guid.TryParse(Back, out var id))
            Nav.NavigateTo($"/catalog/{id}");
    }

    private async Task NavigateToCrumb(int idx)
    {
        _navStack = [.._navStack.Take(idx + 1)];
        await LoadCurrentAsync();
    }

    private static string? FindDirPoster(string dirPath)
    {
        foreach (var name in new[] { ".animarr/poster.jpg", ".animarr/poster.png", "poster.jpg", "poster.png", "folder.jpg", "cover.jpg", "folder.jpeg" })
        {
            var full = System.IO.Path.Combine(dirPath, name);
            if (File.Exists(full))
                return $"/api/image?path={Uri.EscapeDataString(full)}";
        }
        return null;
    }

    private static string? FindFileThumb(string filePath)
    {
        var dir       = System.IO.Path.GetDirectoryName(filePath);
        var nameNoExt = System.IO.Path.GetFileNameWithoutExtension(filePath);
        if (dir == null) return null;

        foreach (var ext in new[] { ".jpg", ".jpeg", ".png", ".webp" })
        {
            var thumb = System.IO.Path.Combine(dir, nameNoExt + ext);
            if (File.Exists(thumb))
                return $"/api/image?path={Uri.EscapeDataString(thumb)}";
        }
        return null;
    }

    private static bool IsVideo(string ext) =>
        ext is ".mkv" or ".mp4" or ".avi" or ".m4v" or ".mov" or ".wmv" or ".ts" or ".m2ts";

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824.0:F1} GB",
        >= 1_048_576     => $"{bytes / 1_048_576.0:F0} MB",
        >= 1_024         => $"{bytes / 1_024.0:F0} KB",
        _                => $"{bytes} B",
    };

    private static SeasonMeta? DetectSeason(string folderLabel, List<SeasonMeta> seasons)
    {
        // Match common patterns: Season 1, S01, S1, Series 1
        var m = Regex.Match(folderLabel, @"\b(?:Season|Series|S)\s*0*(\d+)\b", RegexOptions.IgnoreCase);
        if (m.Success && int.TryParse(m.Groups[1].Value, out var n))
            return seasons.FirstOrDefault(s => s.Number == n);

        // Fall back to matching by stored season name
        foreach (var s in seasons)
            if (!string.IsNullOrEmpty(s.Name) &&
                folderLabel.Contains(s.Name, StringComparison.OrdinalIgnoreCase))
                return s;

        return null;
    }

    private string? GetInfoPosterUrl()
    {
        if (_parentInfo is null) return null;
        var v = _parentInfo.ImageVersion;
        if (_currentSeason?.PosterPath is { Length: > 0 } seasonRel)
        {
            var full = System.IO.Path.Combine(_parentInfo.FolderPath, seasonRel);
            if (File.Exists(full)) return $"/api/image?path={Uri.EscapeDataString(full)}&t={v}";
        }
        if (_parentInfo.PosterPath is { Length: > 0 } seriesRel)
        {
            var full = System.IO.Path.Combine(_parentInfo.FolderPath, seriesRel);
            if (File.Exists(full)) return $"/api/image?path={Uri.EscapeDataString(full)}&t={v}";
        }
        return null;
    }

    private string? GetInfoFanartUrl()
    {
        if (_parentInfo?.FanartPath is not { Length: > 0 } rel) return null;
        var full = System.IO.Path.Combine(_parentInfo.FolderPath, rel);
        var v = _parentInfo.ImageVersion;
        return File.Exists(full) ? $"/api/image?path={Uri.EscapeDataString(full)}&t={v}" : null;
    }

    private string? GetInfoLogoUrl()
    {
        if (_parentInfo?.LogoPath is not { Length: > 0 } rel) return null;
        var full = System.IO.Path.Combine(_parentInfo.FolderPath, rel);
        var v = _parentInfo.ImageVersion;
        return File.Exists(full) ? $"/api/image?path={Uri.EscapeDataString(full)}&t={v}" : null;
    }

    // ── Backdrop ──────────────────────────────────────────────────

    private bool _backdropOwned;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var fanartUrl = GetInfoFanartUrl();
        if (fanartUrl is null) return;
        var enabled = await AppConfig.GetAsync<bool>(AppConfigKeys.BackdropEnabled, true);
        if (!enabled) return;
        var blur       = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBlurPx, 0);
        if (blur > 20) blur = 0;
        var brightness = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBrightness, 60);
        _backdropOwned = true;
        await JS.InvokeVoidAsync("initBackdrop", new[] { fanartUrl }, 999, blur, brightness);
    }

    public async ValueTask DisposeAsync()
    {
        if (_backdropOwned)
            try { await JS.InvokeVoidAsync("restoreGlobalBackdrop"); } catch { }
    }
}
