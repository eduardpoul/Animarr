@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IToastService ToastService
@inject NavigationManager Nav
@inject MetadataService MetadataService
@inject TmdbClient TmdbClient
@inject MalClient MalClient
@inject IJSRuntime JS
@inject IAppConfigService AppConfig
@implements IAsyncDisposable

<PageTitle>Animarr — @L["catalog.title"]</PageTitle>


<div style="position:relative;z-index:1;">

    <!-- ── Header row ─────────────────────────────────────────────────────── -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap;">
        <FluentLabel Typo="Typography.H4" Style="flex:1;margin:0;">@L["catalog.title"]</FluentLabel>
        <FluentTextField @bind-Value="_searchFilter"
                         Placeholder="@(L["catalog.search_placeholder"])"
                         style="width:240px;"
                         Immediate="true"
                         @oninput="OnSearchInput" />
    </div>

    <!-- ── Section tabs ─────────────────────────────────────────────── -->
    @if (_sections.Count > 0)
    {
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;">
            <FluentButton Appearance="@(_activeSection == null ? Appearance.Accent : Appearance.Neutral)"
                          OnClick="@(() => SetActiveSection(null))">
                @L["catalog.tab_all"]
            </FluentButton>
            @foreach (var sec in _sections)
            {
                <FluentButton Appearance="@(_activeSection == sec.Id ? Appearance.Accent : Appearance.Neutral)"
                              OnClick="@(() => SetActiveSection(sec.Id))">
                    @sec.Label
                </FluentButton>
            }
        </div>
    }

    <!-- ── Grid ───────────────────────────────────────────────────────────── -->
    @if (_loading)
    {
        <FluentProgress Width="100%" />
    }
    else if (_filtered.Count == 0)
    {
        <div style="text-align:center;padding:60px 0;color:var(--neutral-foreground-hint);">
            <FluentIcon Value="@(new Icons.Regular.Size48.VideoClip())" Style="opacity:0.3;" />
            <div style="margin-top:12px;font-size:15px;">@L["catalog.empty"]</div>
        </div>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px;">
            @* H-7: cap rendered items to 240. Catalog stays snappy even at 1000+ entries;
               full list is still searchable via the filter input. *@
            @foreach (var item in _filtered.Take(240))
            {
                <a href="/catalog/@item.Id" class="catalog-card"
                   style="display:block;text-decoration:none;color:inherit;cursor:pointer;border-radius:8px;overflow:hidden;background:var(--neutral-layer-2);box-shadow:0 2px 8px rgba(0,0,0,.15);transition:transform .15s,box-shadow .15s;"
                   title="@item.Title">

                    <!-- Poster -->
                    <div style="position:relative;aspect-ratio:2/3;background:var(--neutral-layer-3);">
                        @if (item.PosterPath != null)
                        {
                            <img loading="lazy"
                                 src="@GetImageUrl(item)"
                                 alt="@item.Title"
                                 style="width:100%;height:100%;object-fit:cover;display:block;" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--neutral-foreground-hint);">
                                <FluentIcon Value="@(new Icons.Regular.Size48.VideoClip())" Style="opacity:0.3;" />
                            </div>
                        }

                        <!-- Type badge -->
                        <div style="position:absolute;top:6px;left:6px;">
                            <FluentBadge Appearance="@TypeBadgeAppearance(item.MediaType)"
                                         style="font-size:10px;padding:1px 5px;">
                                @TypeLabel(item.MediaType)
                            </FluentBadge>
                        </div>

                        <!-- Identification activity indicator -->
                        @if (_activeQueueFolderIds.Contains(item.FolderId))
                        {
                            <div style="position:absolute;top:6px;right:6px;">
                                <FluentProgressRing Width="20px" />
                            </div>
                        }
                        else if (item.IdentificationStatus != IdentificationStatus.Identified &&
                             item.IdentificationStatus != IdentificationStatus.Manual)
                        {
                            <div style="position:absolute;top:6px;right:6px;">
                                <FluentBadge Appearance="Appearance.Neutral"
                                             style="font-size:10px;padding:1px 5px;opacity:0.85;">
                                    @StatusLabel(item.IdentificationStatus)
                                </FluentBadge>
                            </div>
                        }

                        <!-- Delete button (visible on hover via CSS class) -->
                        <div class="catalog-card-delete"
                             style="position:absolute;bottom:6px;right:6px;opacity:0;transition:opacity .15s;"
                             @onclick:stopPropagation="true"
                             @onclick:preventDefault="true">
                            <FluentButton Appearance="Appearance.Neutral"
                                          IconStart="@(new Icons.Regular.Size16.Delete())"
                                          style="background:rgba(0,0,0,.55);border:none;padding:4px;min-width:0;"
                                          title="@L["catalog.btn_delete_item"]"
                                          OnClick="@(() => { _deleteTarget = item; _deleteDialogHidden = false; })" />
                        </div>

                    </div>

                    <!-- Title -->
                    <div style="padding:8px 8px 6px;font-size:12px;font-weight:600;line-height:1.3;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                        @item.Title
                    </div>
                    @if (item.Year.HasValue)
                    {
                        <div style="padding:0 8px 8px;font-size:11px;color:var(--neutral-foreground-hint);">
                            @item.Year
                        </div>
                    }
                </a>
            }
        </div>
        @if (_filtered.Count > 240)
        {
            <div style="text-align:center;padding:24px 0;color:var(--neutral-foreground-hint);font-size:13px;">
                @L.Get("catalog.shown_of_total", 240, _filtered.Count)
            </div>
        }
    }

</div>

<!-- ══ Delete media item confirm dialog ════════════════════════════════════ -->
<FluentDialog @bind-Hidden="_deleteDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true" Width="400px">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H4">@L["catalog.delete_dialog_title"]</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <p style="margin:0;font-size:14px;">
            @L.Get("catalog.delete_dialog_body", _deleteTarget?.Title ?? "")
        </p>
        <p style="margin-top:10px;font-size:12px;color:var(--neutral-foreground-hint);">
            @L["catalog.delete_dialog_hint"]
        </p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="DeleteMediaItemAsync">@L["catalog.delete_dialog_confirm"]</FluentButton>
        <FluentButton OnClick="@(() => _deleteDialogHidden = true)">@L["media_search.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ══ Tag manager dialog ════════════════════════════════════════════════ --><FluentDialog @bind-Hidden="_tagDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true" Width="440px">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H4">@L["catalog.tag_dialog_title"]</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" Style="gap:12px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" Style="gap:8px;">
                <FluentTextField @bind-Value="_newTagName"
                                 Placeholder="@(L["catalog.tag_new_placeholder"])"
                                 style="flex:1;" />
                <FluentButton Appearance="Appearance.Accent"
                              Disabled="@string.IsNullOrWhiteSpace(_newTagName)"
                              OnClick="AddTagAsync">
                    @L["catalog.tag_btn_add"]
                </FluentButton>
            </FluentStack>
            @foreach (var tag in _tags)
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap:8px;">
                    <div style="flex:1;font-size:14px;">@tag.Name</div>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size20.Delete())"
                                  OnClick="@(() => DeleteTagAsync(tag))" />
                </FluentStack>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton OnClick="@(() => _tagDialogHidden = true)">@L["media_search.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ══ Manual search dialog ══════════════════════════════════════════════ -->
<FluentDialog @bind-Hidden="_searchDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true" Width="600px">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H4">
            @L["media_search.title"]
            @if (_searchTarget != null)
            {
                <span style="font-weight:400;font-size:14px;margin-left:8px;color:var(--neutral-foreground-hint);">— @_searchTarget.Title</span>
            }
        </FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" Style="gap:12px;">
            <!-- Source selector -->
            <FluentStack Orientation="Orientation.Horizontal" Style="gap:8px;" VerticalAlignment="VerticalAlignment.Bottom">
                <FluentSelect TOption="string"
                              @bind-Value="_searchSource"
                              style="width:120px;">
                    <FluentOption TOption="string" Value="tmdb_tv">TMDB TV</FluentOption>
                    <FluentOption TOption="string" Value="tmdb_movie">TMDB Movie</FluentOption>
                    <FluentOption TOption="string" Value="mal">MAL Anime</FluentOption>
                </FluentSelect>
                <FluentTextField @bind-Value="_searchQuery"
                                 Label="@(L["media_search.input_label"])"
                                 Placeholder="@(L["media_search.input_placeholder"])"
                                 style="flex:1;" />
                <FluentButton Appearance="Appearance.Accent"
                              OnClick="RunSearchAsync"
                              Disabled="@(string.IsNullOrWhiteSpace(_searchQuery) || _searchBusy)">
                    @L["media_search.btn_search"]
                </FluentButton>
            </FluentStack>

            @if (_searchBusy)
            {
                <FluentProgress Width="100%" />
            }
            else if (_searchResults.Count == 0 && _searchDone)
            {
                <div style="color:var(--neutral-foreground-hint);text-align:center;padding:20px 0;">
                    @L["media_search.no_results"]
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:8px;max-height:380px;overflow-y:auto;">
                    @foreach (var r in _searchResults)
                    {
                        <div style="display:flex;gap:12px;align-items:flex-start;padding:8px;border-radius:6px;background:var(--neutral-layer-2);cursor:pointer;"
                             @onclick="() => ApplySearchResultAsync(r)">
                            @if (!string.IsNullOrEmpty(r.PosterUrl))
                            {
                                <img src="@r.PosterUrl" alt="@r.Title"
                                     style="width:50px;height:75px;object-fit:cover;border-radius:4px;flex-shrink:0;" loading="lazy" />
                            }
                            else
                            {
                                <div style="width:50px;height:75px;background:var(--neutral-layer-3);border-radius:4px;flex-shrink:0;"></div>
                            }
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;font-size:14px;">@r.Title</div>
                                @if (r.Year.HasValue)
                                {
                                    <div style="font-size:12px;color:var(--neutral-foreground-hint);">@r.Year</div>
                                }
                                @if (!string.IsNullOrEmpty(r.Overview))
                                {
                                    <div style="font-size:12px;margin-top:4px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;color:var(--neutral-foreground-hint);">
                                        @r.Overview
                                    </div>
                                }
                            </div>
                            <FluentButton Appearance="Appearance.Accent" style="flex-shrink:0;align-self:center;">
                                @L["media_search.btn_select"]
                            </FluentButton>
                        </div>
                    }
                </div>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton OnClick="@(() => _searchDialogHidden = true)">@L["media_search.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<style>
    .catalog-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,.25) !important; }
    .catalog-card:hover .catalog-card-overlay { opacity: 1 !important; }
    .catalog-card:hover .catalog-card-delete { opacity: 1 !important; }
</style>

@code {
    private List<MediaItem>       _allItems       = [];
    private List<MediaItem>       _filtered       = [];
    private List<MediaTag>        _tags           = [];
    private List<FolderWatcher>   _sections       = [];
    private bool   _loading        = true;
    private Guid?  _activeSection  = null;
    private string _searchFilter   = "";

    // Active identification queue tracking
    private HashSet<Guid> _activeQueueFolderIds = [];
    private CancellationTokenSource? _timerCts;

    // Tag manager
    private bool   _tagDialogHidden = true;
    private string _newTagName = "";

    // Manual search
    private bool              _searchDialogHidden = true;
    private MediaItem?        _searchTarget;
    private string            _searchSource  = "tmdb_tv";
    private string            _searchQuery   = "";
    private bool              _searchBusy    = false;
    private bool              _searchDone    = false;
    private List<SearchResult> _searchResults = [];

    // Delete media item
    private bool        _deleteDialogHidden = true;
    private MediaItem?  _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _tags     = await db.MediaTags.OrderBy(t => t.SortOrder).ThenBy(t => t.Name).ToListAsync();
        _sections = await db.FolderWatchers
            .Where(f => f.IsSection)
            .OrderBy(f => f.Label)
            .ToListAsync();
        // H-7: skip the eager Tags join — they're not rendered in the catalog grid (M-13).
        _allItems = await db.MediaItems
            .Include(m => m.Folder)
            .Where(m => m.Folder != null && !m.Folder.IsSection)
            .OrderBy(m => m.Title)
            .ToListAsync();
        _loading = false;
        ApplyFilter();

        _activeQueueFolderIds = await LoadActiveQueueAsync();
        if (_activeQueueFolderIds.Count > 0)
            _ = RunRefreshTimerAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchFilter = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void SetActiveSection(Guid? sectionId)
    {
        _activeSection = sectionId;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var src = _allItems.AsEnumerable();

        // Section filter
        if (_activeSection.HasValue)
            src = src.Where(m => m.Folder?.ParentSectionId == _activeSection.Value);

        // Text filter
        if (!string.IsNullOrWhiteSpace(_searchFilter))
        {
            var q = _searchFilter.ToLowerInvariant();
            src = src.Where(m =>
                m.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (m.OriginalTitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _filtered = src.ToList();
    }

    private string GetImageUrl(MediaItem item)
    {
        if (item.PosterPath is null || item.Folder is null) return "";
        var full = Path.Combine(item.Folder.Path, item.PosterPath);
        var v = item.LastMetadataRefreshedAt?.Ticks ?? 0;
        return $"/api/image?path={Uri.EscapeDataString(full)}&t={v}";
    }

    private static Appearance TypeBadgeAppearance(MediaItemType t) => t switch
    {
        MediaItemType.Anime  => Appearance.Accent,
        MediaItemType.Series => Appearance.Neutral,
        MediaItemType.Movie  => Appearance.Lightweight,
        _                    => Appearance.Neutral,
    };

    private string TypeLabel(MediaItemType t) => t switch
    {
        MediaItemType.Anime  => L["catalog.badge_anime"],
        MediaItemType.Series => L["catalog.badge_series"],
        MediaItemType.Movie  => L["catalog.badge_movie"],
        _                    => L["catalog.badge_unknown"],
    };

    private string StatusLabel(IdentificationStatus s) => s switch
    {
        IdentificationStatus.Pending     => L["catalog.status_pending"],
        IdentificationStatus.Identified  => L["catalog.status_identified"],
        IdentificationStatus.NeedsReview => L["catalog.status_needs_review"],
        IdentificationStatus.Failed      => L["catalog.status_failed"],
        IdentificationStatus.Manual      => L["catalog.status_manual"],
        _                                => "",
    };

    // ── Delete MediaItem ──────────────────────────────────────────────────────

    private async Task DeleteMediaItemAsync()
    {
        if (_deleteTarget is null) return;
        _deleteDialogHidden = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.MediaItems.FindAsync(_deleteTarget.Id);
        if (entity != null)
        {
            db.MediaItems.Remove(entity);
            await db.SaveChangesAsync();
        }
        _allItems.RemoveAll(m => m.Id == _deleteTarget.Id);
        ApplyFilter();
        ToastService.ShowToast(ToastIntent.Success, L.Get("catalog.delete_toast", _deleteTarget.Title));
        _deleteTarget = null;
    }

    // ── Tag management ────────────────────────────────────────────────────────

    private async Task OpenTagManagerAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _tags = await db.MediaTags.OrderBy(t => t.SortOrder).ThenBy(t => t.Name).ToListAsync();
        _newTagName = "";
        _tagDialogHidden = false;
    }

    private async Task AddTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTagName)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.MediaTags.AnyAsync(t => t.Name == _newTagName))
        {
            db.MediaTags.Add(new MediaTag { Id = Guid.NewGuid(), Name = _newTagName.Trim() });
            await db.SaveChangesAsync();
        }
        _newTagName = "";
        _tags = await db.MediaTags.OrderBy(t => t.SortOrder).ThenBy(t => t.Name).ToListAsync();
    }

    private async Task DeleteTagAsync(MediaTag tag)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.MediaTags.FindAsync(tag.Id);
        if (entity != null) { db.MediaTags.Remove(entity); await db.SaveChangesAsync(); }
        _tags = await db.MediaTags.OrderBy(t => t.SortOrder).ThenBy(t => t.Name).ToListAsync();
    }

    // ── Re-identify ───────────────────────────────────────────────────────────

    private async Task ReidentifyAsync(MediaItem item)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Avoid duplicates
        if (!await db.IdentificationQueues.AnyAsync(q =>
            q.FolderId == item.FolderId && q.Status <= IdentificationQueueStatus.Processing))
        {
            db.IdentificationQueues.Add(new IdentificationQueue
            {
                Id           = Guid.NewGuid(),
                FolderId     = item.FolderId,
                ForceRefresh = true,
                QueuedAt     = DateTime.UtcNow,
            });
            await db.SaveChangesAsync();
            ToastService.ShowToast(ToastIntent.Info, L["catalog.btn_reidentify"]);
        }
    }

    // ── Manual search ─────────────────────────────────────────────────────────

    private void OpenSearchModal(MediaItem item)
    {
        _searchTarget        = item;
        _searchQuery         = item.Title;
        _searchResults       = [];
        _searchDone          = false;
        _searchDialogHidden  = false;
    }

    private async Task RunSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searchTarget is null) return;
        _searchBusy    = true;
        _searchResults = [];
        StateHasChanged();

        _searchResults = await FetchSearchResultsAsync(_searchSource, _searchQuery);
        _searchBusy = false;
        _searchDone = true;
    }

    private async Task<List<SearchResult>> FetchSearchResultsAsync(string source, string query)
    {
        if (source == "mal")
        {
            var results = await MalClient.SearchAsync(query);
            return results.Select(r => new SearchResult
            {
                Source    = "mal",
                Id        = r.Id,
                Title     = r.EnglishTitle,
                Year      = r.Year,
                PosterUrl = r.PosterUrl,
                Overview  = r.Synopsis,
            }).ToList();
        }

        List<TmdbSearchResult> tmdbResults = source == "tmdb_movie"
            ? await TmdbClient.SearchMovieAsync(query)
            : await TmdbClient.SearchTvAsync(query);
        return tmdbResults.Select(r => new SearchResult
        {
            Source    = source,
            Id        = r.Id,
            Title     = r.DisplayTitle,
            Year      = r.Year,
            PosterUrl = r.PosterPath != null ? TmdbClient.PosterUrl(r.PosterPath, "w185") : null,
            Overview  = r.Overview,
        }).ToList();
    }

    private async Task ApplySearchResultAsync(SearchResult result)
    {
        if (_searchTarget is null) return;
        _searchDialogHidden = true;
        await MetadataService.ApplyManualAsync(_searchTarget.FolderId, result.Source, result.Id);
        ToastService.ShowToast(ToastIntent.Success, L["media_search.toast_applied"]);

        // Refresh the item in the list
        await using var db = await DbFactory.CreateDbContextAsync();
        var updated = await db.MediaItems
            .Include(m => m.Folder)
            .Include(m => m.Tags).ThenInclude(mt => mt.MediaTag)
            .FirstOrDefaultAsync(m => m.Id == _searchTarget.Id);
        if (updated != null)
        {
            var idx = _allItems.FindIndex(m => m.Id == updated.Id);
            if (idx >= 0) _allItems[idx] = updated;
            else _allItems.Add(updated);
            ApplyFilter();
        }
    }

    private record SearchResult
    {
        public string Source    { get; init; } = "";
        public int    Id        { get; init; }
        public string Title     { get; init; } = "";
        public int?   Year      { get; init; }
        public string? PosterUrl { get; init; }
        public string? Overview  { get; init; }
    }

    // ── Identification queue tracking ────────────────────────────────────────

    private async Task<HashSet<Guid>> LoadActiveQueueAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.IdentificationQueues
            .Where(q => q.Status == IdentificationQueueStatus.Queued ||
                        q.Status == IdentificationQueueStatus.Processing)
            .Select(q => q.FolderId)
            .ToHashSetAsync();
    }

    private async Task RunRefreshTimerAsync()
    {
        _timerCts = new CancellationTokenSource();
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_timerCts.Token))
            {
                var stillActive = await LoadActiveQueueAsync();

                // Folders that just finished — reload their MediaItems
                var justCompleted = _activeQueueFolderIds.Except(stillActive).ToList();
                _activeQueueFolderIds = stillActive;

                if (justCompleted.Count > 0)
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    // M-13: drop the Tags include — refresh only the catalog-visible fields.
                    var updatedItems = await db.MediaItems
                        .Include(m => m.Folder)
                        .Where(m => justCompleted.Contains(m.FolderId) && m.Folder != null && !m.Folder.IsSection)
                        .ToListAsync();

                    foreach (var updated in updatedItems)
                    {
                        var idx = _allItems.FindIndex(m => m.FolderId == updated.FolderId);
                        if (idx >= 0) _allItems[idx] = updated;
                        else _allItems.Add(updated);
                    }
                    ApplyFilter();
                }
                else
                {
                    // L-3: no completion → don't trigger a full re-render
                    continue;
                }

                await InvokeAsync(StateHasChanged);

                // Stop polling once queue is empty
                if (_activeQueueFolderIds.Count == 0) break;
            }
        }
        catch (OperationCanceledException) { }
    }

    // ── Backdrop managed by MainLayout globally ──────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Backdrop is now managed globally by MainLayout.
    }

    private string? GetFanartUrl(MediaItem item)
    {
        if (item.FanartPath is null || item.Folder is null) return null;
        var full = Path.Combine(item.Folder.Path, item.FanartPath);
        return $"/api/image?path={Uri.EscapeDataString(full)}";
    }

    public async ValueTask DisposeAsync()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        // Backdrop is managed by MainLayout — do not stop it here.
    }
}

