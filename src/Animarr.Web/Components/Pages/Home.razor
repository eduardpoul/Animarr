@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IAppConfigService AppConfig
@inject FolderWatcherService WatcherService
@inject MetadataService MetadataService
@inject IdentificationQueueProcessorService QueueProc
@implements IAsyncDisposable

<PageTitle>Animarr — @L["catalog.title"]</PageTitle>


<div class="catalog-page">

    @* ── Featured hero (top 5 by rating, rotates) ────────────────────────── *@
    @if (_featured.Count > 0)
    {
        <CatalogHero Items="@_featured" IntervalSec="@_heroInterval" />
    }

    @* ── Filter bar ──────────────────────────────────────────────────────── *@
    <div class="catalog-filter">
        <Tabs T="MediaItemType?"
              Items="@_typeTabs"
              SelectedValue="@_typeFilter"
              SelectedValueChanged="@OnTypeFilterChanged"
              Mode="segmented" />

        <Input Value="@_searchFilter"
               ValueChanged="@OnSearchChanged"
               Placeholder="@(L["catalog.search_placeholder"])"
               IconBefore="search"
               Clearable="true" />

        @* Rescan-all moved to Settings → Root folders block (top-right). The
           catalog page is read-only by design — rescan is a config-tab action. *@
        <NeedsReviewChip />

        <div class="catalog-count">
            @_filtered.Count<span class="catalog-count__sep">/</span>@_allItems.Count
            <span class="catalog-count__label">TITLES</span>
        </div>
    </div>

    @* ── Folder chip strip (sections) ──────────────────────────────────────
       Design uses 11.5px regular-case Geist buttons, NOT micro mono pills —
       see CatalogV3 lines 177-192. Custom .catalog-chip class below. *@
    @if (_sections.Count > 0)
    {
        <div class="catalog-folders">
            <span class="catalog-folders__label">FOLDER</span>
            <button type="button"
                    class="@($"catalog-chip {(_activeSection is null ? "catalog-chip--active" : "")}")"
                    @onclick="@(() => SetActiveSection(null))">@L["catalog.tab_all"]</button>
            @foreach (var sec in _sections)
            {
                var id = sec.Id;
                <button type="button"
                        class="@($"catalog-chip {(_activeSection == id ? "catalog-chip--active" : "")}")"
                        @onclick="@(() => SetActiveSection(id))">@sec.Label</button>
            }
        </div>
    }

    @* ── Identification banner — auto-shows while QueueDepth > 0, hides otherwise.
       Sits directly above the grid so users see "Identifying titles via LLM"
       as posters fill in. Self-contained; safe to render unconditionally. *@
    <IdentificationBanner />

    @* ── Grid ─────────────────────────────────────────────────────────────── *@
    @if (_loading)
    {
        @* Skeleton placeholder — 12 poster-shaped shimmers in the same
           .catalog-grid layout so the page doesn't reflow when real cards
           land. Spec: design_handoff_animarr/pages/loaders.html §03. *@
        <div class="catalog-grid">
            @for (int i = 0; i < 12; i++)
            {
                <Skeleton Variant="poster" />
            }
        </div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="catalog-empty">
            <DIcon Name="video" Size="48" />
            <div class="catalog-empty__text">@L["catalog.empty"]</div>
        </div>
    }
    else
    {
        <div class="catalog-grid">
            @* H-7: cap rendered items to 240. Catalog stays snappy even at 1000+ entries. *@
            @foreach (var item in _filtered.Take(240))
            {
                <Poster Item="@item" />
            }
        </div>
        @if (_filtered.Count > 240)
        {
            <div class="catalog-more">
                @L.Get("catalog.shown_of_total", 240, _filtered.Count)
            </div>
        }
    }

</div>

@*
    The catalog used to have per-poster delete, tag-manager and manual-search
    dialogs. The redesign moved all three workflows to other surfaces:
      - delete   → MediaDetail Edit Metadata → Danger zone
      - tags     → MediaDetail Edit Metadata → Basics (TagsJson chips)
      - search   → NeedsReview chip + MediaDetail Edit Metadata → Source IDs
    Old dialog markup + supporting state have been removed.
*@

@code {
    private List<MediaItem>       _allItems       = [];
    private List<MediaItem>       _filtered       = [];
    private List<MediaItem>       _featured       = [];
    private List<FolderWatcher>   _sections       = [];
    private bool   _loading        = true;
    private Guid?  _activeSection  = null;
    private MediaItemType? _typeFilter = null;
    private string _searchFilter   = "";
    private int    _heroInterval   = 30;

    private static readonly IReadOnlyList<Tabs<MediaItemType?>.TabItem> _typeTabs =
    [
        new(null,                          "All"),
        new(MediaItemType.Anime,           "Anime"),
        new(MediaItemType.Movie,           "Movie"),
        new(MediaItemType.Series,          "Series"),
        new(MediaItemType.Multserials,     "Multi"),
    ];

    // Active identification queue tracking
    private HashSet<Guid> _activeQueueFolderIds = [];
    private CancellationTokenSource? _timerCts;

    protected override void OnInitialized()
    {
        // Subscribe to push events so the grid refreshes after a manual identify
        // (NeedsReview → Use) or after a basics-editor Save in the metadata drawer.
        // The queue processor's ItemIdentified also bubbles in via the timer loop
        // below — these two cover the manual-apply path that doesn't queue.
        MetadataService.MediaItemChanged += OnMediaItemChanged;
        QueueProc.ItemIdentified         += OnMediaItemChanged;
    }

    private void OnMediaItemChanged(Guid folderId) => InvokeAsync(async () =>
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var updated = await db.MediaItems
            .Include(m => m.Folder)
            .FirstOrDefaultAsync(m => m.FolderId == folderId);
        if (updated is null) return;
        var idx = _allItems.FindIndex(m => m.FolderId == folderId);
        if (idx >= 0) _allItems[idx] = updated;
        else          _allItems.Add(updated);
        ApplyFilter();
        StateHasChanged();
    });

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _sections = await db.FolderWatchers
            .Where(f => f.IsSection)
            .OrderBy(f => f.Label)
            .ToListAsync();
        // H-7: skip the eager Tags join — they're not rendered in the catalog grid (M-13).
        var raw = await db.MediaItems
            .Include(m => m.Folder)
            .Where(m => m.Folder != null && !m.Folder.IsSection)
            .OrderBy(m => m.Title)
            .ToListAsync();
        // Hide ghost entries — MediaItems whose folder (or single-file path) is
        // no longer on disk. They previously survived "delete from catalog" and
        // reappeared on the next Identify, which was the source of the ghost
        // "The Portal"-style cards. We don't auto-delete here (the Folder might
        // be on a temporarily-unreachable mount); just hide them in the grid.
        _allItems = raw.Where(m =>
            m.Folder!.SingleFilePath is { Length: > 0 } sfp
                ? File.Exists(sfp)
                : Directory.Exists(m.Folder.Path)
        ).ToList();
        // Featured = top 5 by rating (>= 8.0). Powers the hero rotator.
        _featured = _allItems
            .Where(m => (m.Rating ?? 0) >= 8.0 && !string.IsNullOrEmpty(m.FanartPath))
            .OrderByDescending(m => m.Rating ?? 0)
            .ThenByDescending(m => m.RatingCount ?? 0)
            .Take(5)
            .ToList();
        _heroInterval = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropIntervalSec, 30);

        _loading = false;
        ApplyFilter();

        _activeQueueFolderIds = await LoadActiveQueueAsync();
        if (_activeQueueFolderIds.Count > 0)
            _ = RunRefreshTimerAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchFilter = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void OnSearchChanged(string? v)
    {
        _searchFilter = v ?? "";
        ApplyFilter();
    }

    private void OnTypeFilterChanged(MediaItemType? v)
    {
        _typeFilter = v;
        ApplyFilter();
    }

    private void SetActiveSection(Guid? sectionId)
    {
        _activeSection = sectionId;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var src = _allItems.AsEnumerable();

        // Type filter (Anime/Movie/Series/Multserials)
        if (_typeFilter.HasValue)
            src = src.Where(m => m.MediaType == _typeFilter.Value);

        // Section filter
        if (_activeSection.HasValue)
            src = src.Where(m => m.Folder?.ParentSectionId == _activeSection.Value);

        // Text filter — extended to include CJK + English alts.
        if (!string.IsNullOrWhiteSpace(_searchFilter))
        {
            var q = _searchFilter.ToLowerInvariant();
            src = src.Where(m =>
                m.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (m.OriginalTitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.EnglishTitle?.Contains(q, StringComparison.OrdinalIgnoreCase)  ?? false) ||
                (m.CjkTitle?.Contains(q, StringComparison.OrdinalIgnoreCase)      ?? false));
        }

        _filtered = src.ToList();
    }

    private string GetImageUrl(MediaItem item)
    {
        if (item.PosterPath is null || item.Folder is null) return "";
        var full = Path.Combine(item.Folder.Path, item.PosterPath);
        var v = item.LastMetadataRefreshedAt?.Ticks ?? 0;
        return $"/api/image?path={Uri.EscapeDataString(full)}&t={v}";
    }

    private string TypeLabel(MediaItemType t) => t switch
    {
        MediaItemType.Anime  => L["catalog.badge_anime"],
        MediaItemType.Series => L["catalog.badge_series"],
        MediaItemType.Movie  => L["catalog.badge_movie"],
        _                    => L["catalog.badge_unknown"],
    };

    private string StatusLabel(IdentificationStatus s) => s switch
    {
        IdentificationStatus.Pending     => L["catalog.status_pending"],
        IdentificationStatus.Identified  => L["catalog.status_identified"],
        IdentificationStatus.NeedsReview => L["catalog.status_needs_review"],
        IdentificationStatus.Failed      => L["catalog.status_failed"],
        IdentificationStatus.Manual      => L["catalog.status_manual"],
        _                                => "",
    };

    // ── Identification queue tracking ────────────────────────────────────────

    private async Task<HashSet<Guid>> LoadActiveQueueAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.IdentificationQueues
            .Where(q => q.Status == IdentificationQueueStatus.Queued ||
                        q.Status == IdentificationQueueStatus.Processing)
            .Select(q => q.FolderId)
            .ToHashSetAsync();
    }

    private async Task RunRefreshTimerAsync()
    {
        _timerCts = new CancellationTokenSource();
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_timerCts.Token))
            {
                var stillActive = await LoadActiveQueueAsync();

                // Folders that just finished — reload their MediaItems
                var justCompleted = _activeQueueFolderIds.Except(stillActive).ToList();
                _activeQueueFolderIds = stillActive;

                if (justCompleted.Count > 0)
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    // M-13: drop the Tags include — refresh only the catalog-visible fields.
                    var updatedItems = await db.MediaItems
                        .Include(m => m.Folder)
                        .Where(m => justCompleted.Contains(m.FolderId) && m.Folder != null && !m.Folder.IsSection)
                        .ToListAsync();

                    foreach (var updated in updatedItems)
                    {
                        var idx = _allItems.FindIndex(m => m.FolderId == updated.FolderId);
                        if (idx >= 0) _allItems[idx] = updated;
                        else _allItems.Add(updated);
                    }
                    ApplyFilter();
                }
                else
                {
                    // L-3: no completion → don't trigger a full re-render
                    continue;
                }

                await InvokeAsync(StateHasChanged);

                // Stop polling once queue is empty
                if (_activeQueueFolderIds.Count == 0) break;
            }
        }
        catch (OperationCanceledException) { }
    }

    // ── Backdrop managed by MainLayout globally ──────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Backdrop is now managed globally by MainLayout.
    }

    private string? GetFanartUrl(MediaItem item)
    {
        if (item.FanartPath is null || item.Folder is null) return null;
        var full = Path.Combine(item.Folder.Path, item.FanartPath);
        var v = item.LastMetadataRefreshedAt?.Ticks ?? 0;
        return $"/api/image?path={Uri.EscapeDataString(full)}&t={v}";
    }

    public async ValueTask DisposeAsync()
    {
        MetadataService.MediaItemChanged -= OnMediaItemChanged;
        QueueProc.ItemIdentified         -= OnMediaItemChanged;
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        // Backdrop is managed by MainLayout — do not stop it here.
        await Task.CompletedTask;
    }
}

