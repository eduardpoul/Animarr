@page "/settings"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IPatternMatchService Matcher
@inject IOptions<AppSettings> AppSettingsOptions
@inject IToastService ToastService
@inject ThemeService ThemeService
@inject TorrentEngineService TorrentEngine
@inject IWebHostEnvironment Env
@inject NavigationManager Nav
@inject IAppConfigService AppConfig
@inject ILlmService LlmService

<PageTitle>Animarr</PageTitle>

<FluentLabel Typo="Typography.H4" Style="margin-bottom:20px;">@L["settings.title"]</FluentLabel>

<FluentTabs @bind-ActiveTabId="_activeTab">

    <!-- ============================================================ -->
    <!-- TAB: General -->
    <!-- ============================================================ -->
    <FluentTab Id="general" Label="@(L["settings.tab_general"])">
        <FluentStack Orientation="Orientation.Vertical" Style="gap:24px;padding-top:16px;">

            <div>
                <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.section_language"]</FluentLabel>
                <FluentSelect TOption="string"
                              Value="@L.CurrentLanguage"
                              ValueChanged="OnLanguageChanged"
                              Label="@(L["settings.language_label"])"
                              style="width:240px;">
                    @foreach (var lang in L.SupportedLanguages)
                    {
                        <FluentOption TOption="string" Value="@lang.Code">@lang.Label</FluentOption>
                    }
                </FluentSelect>
            </div>

            <FluentDivider />

            <div>
                <FluentLabel Typo="Typography.H3" Style="margin-bottom:8px;">@L["settings.section_app_params"]</FluentLabel>
                <FluentLabel Style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:12px;">
                    @L["settings.app_params_hint"]
                </FluentLabel>
                <div style="padding:16px;background:var(--neutral-layer-2,#f3f2f1);border-radius:6px;font-size:13px;line-height:2;">
                    <div><b>@L["settings.param_watcher_delay"]</b> @_cfg.WatcherDelayMs ms</div>
                    <div><b>@L["settings.param_video_ext"]</b> @string.Join(", ", _cfg.VideoExtensions)</div>
                    <div><b>@L["settings.param_subtitles"]</b> @string.Join(", ", _cfg.SubtitleExtensions)</div>
                    <div><b>@L["settings.param_images"]</b> @string.Join(", ", _cfg.ImageExtensions)</div>
                </div>
            </div>

        </FluentStack>
    </FluentTab>

    <!-- ============================================================ -->
    <!-- TAB: Appearance -->
    <!-- ============================================================ -->
    <FluentTab Id="appearance" Label="@(L["settings.tab_appearance"])">
        <FluentStack Orientation="Orientation.Vertical" Style="gap:24px;padding-top:16px;">

            <div>
                <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.section_appearance"]</FluentLabel>
                <FluentSelect TOption="string"
                              Value="@_themeStr"
                              ValueChanged="OnThemeChanged"
                              Label="@(L["settings.theme_label"])"
                              style="width:240px;">
                    <FluentOption TOption="string" Value="System">@L["settings.theme_system"]</FluentOption>
                    <FluentOption TOption="string" Value="Dark">@L["settings.theme_dark"]</FluentOption>
                    <FluentOption TOption="string" Value="Light">@L["settings.theme_light"]</FluentOption>
                </FluentSelect>

                <div style="margin-top:16px;">
                    <FluentLabel Style="font-size:13px;color:var(--neutral-foreground-hint);display:block;margin-bottom:8px;">
                        @L["settings.accent_color_label"]
                    </FluentLabel>
                    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
                        @foreach (var (color, hex) in _accentColors)
                        {
                            var isSelected = _accentColorValue == color;
                            var isDefault = color == null;
                            <FluentTooltip Anchor="@($"swatch-{(color == null ? "default" : color.ToString())}")" Position="TooltipPosition.Bottom">
                                @(isDefault ? L["settings.accent_color_default"] : color!.ToString())
                            </FluentTooltip>
                            <button id="@($"swatch-{(color == null ? "default" : color.ToString())}")"
                                    title="@(isDefault ? L["settings.accent_color_default"] : color!.ToString())"
                                    @onclick="() => OnAccentColorChanged(color)"
                                    style="@($"width:24px;height:24px;border-radius:50%;border:{(isSelected ? "3px solid var(--neutral-foreground-rest)" : "2px solid transparent")};padding:0;cursor:pointer;background:{(isDefault ? "conic-gradient(red,orange,yellow,green,cyan,blue,violet,red)" : hex)};outline:{(isSelected ? "2px solid var(--accent-fill-rest)" : "none")};outline-offset:2px;")">
                            </button>
                        }
                    </div>
                </div>
            </div>

            <FluentDivider />

            <!-- ── Backdrop ── -->
            <div>
                <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.backdrop_title"]</FluentLabel>
                <div style="display:flex;flex-direction:column;gap:12px;max-width:400px;">
                    <FluentSwitch @bind-Value="_backdropEnabled">@L["settings.backdrop_enabled_switch"]</FluentSwitch>
                    <FluentNumberField @bind-Value="_backdropIntervalSec"
                                       Label="@(L["settings.backdrop_interval_label"])"
                                       Min="5" Max="300" style="width:160px;"
                                       Disabled="@(!_backdropEnabled)" />
                    <div>
                        <FluentLabel Style="font-size:13px;margin-bottom:6px;display:block;">
                            @L["settings.backdrop_blur_label"]: <b>@_backdropBlurPx px</b>
                        </FluentLabel>
                        <input type="range" min="0" max="20" step="1"
                               value="@_backdropBlurPx"
                               @oninput="@(e => _backdropBlurPx = int.TryParse(e.Value?.ToString(), out var v) ? v : _backdropBlurPx)"
                               disabled="@(!_backdropEnabled)"
                               style="width:280px;accent-color:var(--accent-fill-rest);" />
                        <div style="display:flex;justify-content:space-between;width:280px;font-size:11px;color:var(--neutral-foreground-hint);margin-top:2px;">
                            <span>0</span><span>5</span><span>10</span><span>15</span><span>20</span>
                        </div>
                    </div>
                    <div>
                        <FluentLabel Style="font-size:13px;margin-bottom:6px;display:block;">
                            @L["settings.backdrop_brightness_label"]: <b>@_backdropBrightness%</b>
                        </FluentLabel>
                        <input type="range" min="10" max="100" step="5"
                               value="@_backdropBrightness"
                               @oninput="@(e => _backdropBrightness = int.TryParse(e.Value?.ToString(), out var v) ? v : _backdropBrightness)"
                               disabled="@(!_backdropEnabled)"
                               style="width:280px;accent-color:var(--accent-fill-rest);" />
                        <div style="display:flex;justify-content:space-between;width:280px;font-size:11px;color:var(--neutral-foreground-hint);margin-top:2px;">
                            <span>10%</span><span>30%</span><span>50%</span><span>70%</span><span>100%</span>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <FluentButton Appearance="Appearance.Accent" OnClick="SaveAppearanceAsync">
                    @L["settings.btn_save_appearance"]
                </FluentButton>
            </div>

        </FluentStack>
    </FluentTab>

    <!-- ============================================================ -->
    <!-- TAB: Patterns -->
    <!-- ============================================================ -->
    <FluentTab Id="patterns" Label="@(L["settings.tab_patterns"])">
        <FluentStack Orientation="Orientation.Vertical" Style="gap:16px;padding-top:16px;">

            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom:4px;">
                <FluentLabel Typo="Typography.H3" Style="flex:1;margin:0;">@L["patterns.title"]</FluentLabel>
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size20.Add())"
                              Title="@(L["patterns.add_button"])"
                              OnClick="@(() => OpenPatternDialog(null))" />
            </FluentStack>

            @if (_patternsLoading)
            {
                <FluentProgress Width="100%" />
            }
            else
            {
                <FluentDataGrid Items="@_patterns.AsQueryable()" TGridItem="RenamePattern" ShowHover="true">
                    <TemplateColumn Title="@(L["patterns.col_priority"])" Width="60px" Align="Align.Center">
                        @context.Priority
                    </TemplateColumn>
                    <PropertyColumn Property="@(p => p.Name)" Title="@(L["patterns.col_name"])" />
                    <TemplateColumn Title="@(L["patterns.col_regex"])">
                        <code style="font-size:11px;word-break:break-all;">@context.Pattern</code>
                    </TemplateColumn>
                    <TemplateColumn Title="@(L["patterns.col_type"])" Width="140px">
                        <FluentBadge Appearance="@(context.IsBuiltIn ? Appearance.Accent : Appearance.Neutral)">
                            @(context.IsBuiltIn ? L["patterns.type_builtin"] : L["patterns.type_custom"])
                        </FluentBadge>
                    </TemplateColumn>
                    <TemplateColumn Title="@(L["patterns.col_applicable"])" Width="240px">
                        @(context.ApplicableTo switch {
                            FolderType.Movie  => L["patterns.applicable_movie"],
                            FolderType.Series => L["patterns.applicable_series"],
                            _                 => L["patterns.applicable_all"]
                        })
                    </TemplateColumn>
                    <TemplateColumn Title="@(L["patterns.col_actions"])" Align="Align.End" Width="140px">
                        @if (!context.IsBuiltIn)
                        {
                            <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                                          Title="@(L["patterns.btn_edit"])"
                                          OnClick="@(() => OpenPatternDialog(context))" />
                            <FluentButton Appearance="Appearance.Stealth"
                                          IconStart="@(new Icons.Regular.Size20.Delete())"
                                          Title="@(L["patterns.btn_delete"])"
                                          OnClick="@(() => DeletePattern(context))" />
                        }
                    </TemplateColumn>
                </FluentDataGrid>

                <FluentDivider Style="margin:28px 0 20px;" />

                <FluentLabel Typo="Typography.H3" Style="margin-bottom:12px;">@L["patterns.test_title"]</FluentLabel>
                <FluentLabel Style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:10px;">
                    @L["patterns.test_hint"]
                </FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal" Style="gap:10px;max-width:800px;" VerticalAlignment="VerticalAlignment.Bottom">
                    <FluentTextField @bind-Value="_testInput"
                                     Label="@(L["patterns.test_field_label"])"
                                     Placeholder="@(L["patterns.test_placeholder"])"
                                     style="flex:1;" />
                    <FluentButton Appearance="Appearance.Accent" OnClick="TestPattern">@L["patterns.test_button"]</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral"
                                  Disabled="@(_llmSuggestBusy || string.IsNullOrWhiteSpace(_testInput))"
                                  OnClick="SuggestRegexAsync"
                                  title="@L["patterns.llm_suggest_tooltip"]">
                        @if (_llmSuggestBusy)
                        {
                            <FluentProgress Width="60px" />
                        }
                        else
                        {
                            @L["patterns.llm_suggest_btn"]
                        }
                    </FluentButton>
                </FluentStack>

                @if (_llmSuggestion != null)
                {
                    <div style="margin-top:10px;padding:12px;background:var(--neutral-layer-2);border-radius:6px;max-width:800px;">
                        <div style="font-size:12px;font-weight:600;margin-bottom:4px;">@L["patterns.llm_suggest_result"]</div>
                        <div style="font-family:monospace;font-size:13px;word-break:break-all;margin-bottom:4px;">@_llmSuggestion.Pattern</div>
                        @if (!string.IsNullOrEmpty(_llmSuggestion.Explanation))
                        {
                            <div style="font-size:12px;color:var(--neutral-foreground-hint);">@_llmSuggestion.Explanation</div>
                        }
                        <div style="margin-top:8px;display:flex;gap:8px;">
                            <FluentButton Appearance="Appearance.Accent" style="font-size:12px;"
                                          OnClick="UseAiSuggestion">
                                @L["patterns.llm_suggest_use"]
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Stealth" style="font-size:12px;"
                                          OnClick="@(() => _llmSuggestion = null)">
                                @L["patterns.llm_suggest_dismiss"]
                            </FluentButton>
                        </div>
                    </div>
                }

                @if (_testResult is not null)
                {
                    <div style="margin-top:14px;padding:14px;background:var(--neutral-layer-2,#f3f2f1);border-radius:6px;">
                        @if (_testResult.IsMatched)
                        {
                            <div style="color:var(--color-fluent-success);font-weight:600;margin-bottom:6px;">@L["patterns.test_matched"]</div>
                            <div style="font-family:monospace;font-size:13px;line-height:1.8;">
                                @L["patterns.test_season_label"] <b>@(_testResult.Season?.ToString() ?? L["patterns.test_season_not_found"])</b><br />
                                @L["patterns.test_episode_label"] <b>@_testResult.Episode</b><br />
                                @L["patterns.test_kind_label"] <b>@_testKind</b><br />
                                @L["patterns.test_new_name_label"] <b style="color:var(--color-fluent-success);">@(_testNewName ?? "—")</b>
                            </div>
                        }
                        else
                        {
                            <div style="color:var(--color-fluent-error);font-weight:600;">@L["patterns.test_not_matched"]</div>
                        }
                    </div>
                }
            }

        </FluentStack>
    </FluentTab>

    <!-- ============================================================ -->
    <!-- TAB: Ignore Rules -->
    <!-- ============================================================ -->
    <FluentTab Id="rules" Label="@(L["settings.tab_rules"])">
        <FluentStack Orientation="Orientation.Vertical" Style="gap:16px;padding-top:16px;">

            @if (_loading)
            {
                <FluentProgress Width="100%" />
            }
            else
            {
                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:6px;">@L["settings.section_ignore_rules"]</FluentLabel>
                    <FluentLabel Style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:14px;">
                        @L["settings.ignore_rules_hint"]
                    </FluentLabel>

                    <FluentStack Orientation="Orientation.Horizontal" Style="margin-bottom:14px;gap:8px;"
                                 VerticalAlignment="VerticalAlignment.Bottom">
                        <FluentTextField @bind-Value="_newMask"
                                         Placeholder="@(L["settings.new_mask_placeholder"])"
                                         Label="@(L["settings.new_mask_label"])"
                                         style="flex:1;" />
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size20.Add())"
                                      OnClick="AddRule"
                                      Title="@(L["settings.btn_add_mask"])"
                                      Disabled="@string.IsNullOrWhiteSpace(_newMask)" />
                    </FluentStack>

                    <FluentDataGrid Items="@_rules.AsQueryable()" TGridItem="IgnoreRule" ShowHover="true">
                        <PropertyColumn Property="@(r => r.Mask)" Title="@(L["settings.col_mask"])" />
                        <TemplateColumn Title="" Align="Align.End" Width="100px">
                            <FluentButton Appearance="Appearance.Stealth"
                                          IconStart="@(new Icons.Regular.Size20.Delete())"
                                          Title="@(L["settings.btn_delete_mask"])"
                                          OnClick="@(() => DeleteRule(context))" />
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }

        </FluentStack>
    </FluentTab>

    <!-- ============================================================ -->
    <!-- TAB: Torrent -->
    <!-- ============================================================ -->
    <FluentTab Id="torrent" Label="@(L["settings.tab_torrent"])">
        @if (_torrentCfg is null)
        {
            <FluentProgress Width="100%" Style="margin-top:var(--spacingVerticalL);" />
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" Style="gap:20px;padding-top:16px;">

                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.torrent_speed_title"]</FluentLabel>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                        <FluentNumberField @bind-Value="_globalDlLimitMbps"
                                           Label="@(L["settings.torrent_dl_limit_label"])"
                                           Min="0" style="width:260px;" />
                        <FluentNumberField @bind-Value="_globalUlLimitMbps"
                                           Label="@(L["settings.torrent_ul_limit_label"])"
                                           Min="0" style="width:260px;" />
                    </div>
                </div>

                <FluentDivider />

                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.torrent_connections_title"]</FluentLabel>
                    <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:10px;">
                        <FluentNumberField @bind-Value="_torrentCfg.ListenPort"
                                           Label="@(L["settings.torrent_port_label"])" Min="1024" Max="65535"
                                           style="width:200px;" />
                        <FluentNumberField @bind-Value="_torrentCfg.MaxConnections"
                                           Label="@(L["settings.torrent_max_connections_label"])" Min="1" Max="2000"
                                           style="width:200px;" />
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        <FluentSwitch @bind-Value="_torrentCfg.EnableDHT">@L["settings.torrent_dht_switch"]</FluentSwitch>
                        <FluentSwitch @bind-Value="_torrentCfg.EnableLSD">@L["settings.torrent_lsd_switch"]</FluentSwitch>
                        <FluentSwitch @bind-Value="_torrentCfg.EnableUPnP">@L["settings.torrent_upnp_switch"]</FluentSwitch>
                    </div>
                </div>

                <FluentDivider />

                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.torrent_seeding_done_title"]</FluentLabel>
                    <FluentSwitch @bind-Value="_torrentCfg.StopSeedingAfterDone">@L["settings.torrent_stop_after_done"]</FluentSwitch>
                    <div style="display:flex;align-items:center;gap:10px;margin-top:10px;">
                        <FluentLabel Style="font-size:13px;">@L["settings.torrent_stop_ratio_label"]</FluentLabel>
                        <FluentNumberField @bind-Value="_torrentCfg.StopSeedingRatio"
                                           Min="0" Step="0.1" style="width:120px;" />
                        <FluentLabel Style="font-size:12px;color:var(--neutral-foreground-hint);">@L["settings.torrent_stop_ratio_hint"]</FluentLabel>
                    </div>
                </div>

                <FluentDivider />

                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.torrent_automation_title"]</FluentLabel>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        <FluentSwitch @bind-Value="_torrentCfg.AutoRenameAfterDownload">
                            @L["settings.torrent_auto_rename_switch"]
                        </FluentSwitch>

                    </div>
                </div>

                <FluentDivider />

                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:8px;">@L["settings.torrent_service_title"]</FluentLabel>
                    <div style="font-size:13px;color:var(--neutral-foreground-hint);">
                        <div>@L["settings.torrent_cache_dir_label"] <code>@_torrentCfg.CacheDirectory</code></div>
                    </div>
                </div>

                <div>
                    <FluentButton Appearance="Appearance.Accent" OnClick="SaveTorrentSettingsAsync">
                        @L["settings.btn_save_torrent"]
                    </FluentButton>
                </div>

            </FluentStack>
        }
    </FluentTab>

    <!-- ============================================================ -->
    <!-- TAB: Metadata & LLM -->
    <!-- ============================================================ -->
    <FluentTab Id="metadata" Label="@(L["settings.tab_metadata"])">
        @if (_metaLoading)
        {
            <FluentProgress Width="100%" Style="margin-top:var(--spacingVerticalL);" />
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" Style="gap:24px;padding-top:16px;">

                <!-- ── Metadata sources ── -->
                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:6px;">@L["settings.meta_sources_title"]</FluentLabel>
                    <FluentLabel Style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:14px;">
                        @L["settings.meta_sources_hint"]
                    </FluentLabel>
                    <div style="display:flex;flex-direction:column;gap:14px;max-width:520px;">
                        <div>
                            <FluentTextField @bind-Value="_tmdbApiKey"
                                             Label="@(L["settings.tmdb_key_label"])"
                                             Placeholder="@(L["settings.tmdb_key_placeholder"])"
                                             style="width:100%;" />
                            <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;">@L["settings.tmdb_key_hint"]</div>
                        </div>
                        <div>
                            <FluentTextField @bind-Value="_malClientId"
                                             Label="@(L["settings.mal_client_id_label"])"
                                             Placeholder="@(L["settings.mal_client_id_placeholder"])"
                                             style="width:100%;" />
                            <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;">@L["settings.mal_client_id_hint"]</div>
                        </div>
                    </div>
                </div>

                <FluentDivider />

                <!-- ── Source priority ── -->
                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:6px;">@L["settings.search_sources_title"]</FluentLabel>
                    <FluentLabel Style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:14px;">
                        @L["settings.search_sources_hint"]
                    </FluentLabel>
                    <div style="display:flex;flex-direction:column;gap:8px;max-width:400px;">
                        @for (int i = 0; i < _searchSources.Count; i++)
                        {
                            var idx = i;
                            var src = _searchSources[idx];
                            <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--neutral-layer-3);border-radius:6px;">
                                <div style="font-size:12px;color:var(--neutral-foreground-hint);width:20px;text-align:center;font-weight:600;">@(idx + 1)</div>
                                <FluentCheckbox @bind-Value="src.Enabled" style="margin:0;" />
                                <div style="flex:1;font-size:14px;">@SourceLabel(src.Id)</div>
                                <FluentButton Appearance="Appearance.Stealth"
                                              IconStart="@(new Icons.Regular.Size16.ChevronUp())"
                                              Disabled="@(idx == 0)"
                                              OnClick="@(() => MoveSourceUp(idx))"
                                              style="min-width:0;padding:4px;" />
                                <FluentButton Appearance="Appearance.Stealth"
                                              IconStart="@(new Icons.Regular.Size16.ChevronDown())"
                                              Disabled="@(idx == _searchSources.Count - 1)"
                                              OnClick="@(() => MoveSourceDown(idx))"
                                              style="min-width:0;padding:4px;" />
                            </div>
                        }
                    </div>
                </div>

                <FluentDivider />

                <!-- ── Automation ── -->
                <div>
                    <FluentLabel Typo="Typography.H3" Style="margin-bottom:10px;">@L["settings.meta_auto_title"]</FluentLabel>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        <FluentSwitch @bind-Value="_autoIdentifyEnabled">@L["settings.auto_identify_switch"]</FluentSwitch>
                        <div>
                            <FluentSwitch @bind-Value="_downloadEpThumbs">@L["settings.download_ep_thumbs_switch"]</FluentSwitch>
                            <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;padding-left:4px;">@L["settings.download_ep_thumbs_hint"]</div>
                        </div>
                        @* Auto-rename of container folders was removed after two
                           catastrophic data-corruption incidents. Identification
                           only updates DB associations now; on-disk paths are
                           never modified. *@
                        <div>
                            <FluentSwitch @bind-Value="_includeEpisodeName">@L["settings.include_episode_name_switch"]</FluentSwitch>
                            <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;padding-left:4px;">@L["settings.include_episode_name_hint"]</div>
                        </div>
                    </div>
                </div>

                <div>
                    <FluentButton Appearance="Appearance.Accent" OnClick="SaveMetadataSettingsAsync">
                        @L["settings.btn_save_metadata"]
                    </FluentButton>
                </div>

            </FluentStack>
        }
    </FluentTab>

    <!-- ============================================================ -->
    <!-- TAB: AI / LLM -->
    <!-- ============================================================ -->
    <FluentTab Id="ai" Label="@(L["settings.tab_ai"])">
        <FluentStack Orientation="Orientation.Vertical" Style="gap:24px;padding-top:16px;">

            <!-- ── LLM / AI ── -->
            <div>
                <FluentLabel Typo="Typography.H3" Style="margin-bottom:6px;">@L["settings.llm_title"]</FluentLabel>
                <FluentLabel Style="font-size:13px;color:var(--neutral-foreground-hint);margin-bottom:14px;">
                    @L["settings.llm_hint"]
                </FluentLabel>
                <div style="display:flex;flex-direction:column;gap:14px;max-width:520px;">

                    <FluentSwitch @bind-Value="_llmEnabled">@L["settings.llm_enabled_switch"]</FluentSwitch>

                    <!-- Provider selector -->
                    <div>
                        <FluentLabel style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">
                            @L["settings.llm_provider_label"]
                        </FluentLabel>
                        <FluentSelect TOption="string" @bind-Value="_llmProvider" style="width:100%;" Disabled="@(!_llmEnabled)">
                            <FluentOption TOption="string" Value="compatible">@L["settings.llm_provider_compatible"]</FluentOption>
                            <FluentOption TOption="string" Value="openai">@L["settings.llm_provider_openai"]</FluentOption>
                        </FluentSelect>
                        <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;">@L["settings.llm_provider_hint"]</div>
                    </div>

                    <!-- Base URL (shown for compatible provider) -->
                    @if (_llmProvider == "compatible")
                    {
                        <div>
                            <FluentTextField @bind-Value="_llmBaseUrl"
                                             Label="@(L["settings.llm_base_url_label"])"
                                             Placeholder="@(L["settings.llm_base_url_placeholder"])"
                                             style="width:100%;"
                                             Disabled="@(!_llmEnabled)" />
                            <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;">@L["settings.llm_base_url_hint"]</div>
                        </div>
                    }

                    <!-- API Key -->
                    <div>
                        <FluentTextField @bind-Value="_llmApiKey"
                                         Label="@(L["settings.llm_api_key_label"])"
                                         Placeholder="@(_llmProvider == "openai" ? L["settings.llm_api_key_placeholder_openai"] : L["settings.llm_api_key_placeholder_local"])"
                                         TextFieldType="TextFieldType.Password"
                                         style="width:100%;"
                                         Disabled="@(!_llmEnabled)" />
                        <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;">
                            @(_llmProvider == "openai" ? L["settings.llm_api_key_hint_openai"] : L["settings.llm_api_key_hint_local"])
                        </div>
                    </div>

                    <!-- Model -->
                    <div>
                        <FluentTextField @bind-Value="_llmModel"
                                         Label="@(L["settings.llm_model_label"])"
                                         Placeholder="@(_llmProvider == "openai" ? "gpt-4o-mini" : "qwen2.5:1.5b")"
                                         style="width:240px;"
                                         Disabled="@(!_llmEnabled)" />
                        <div style="font-size:12px;color:var(--neutral-foreground-hint);margin-top:4px;">@L["settings.llm_model_hint"]</div>
                    </div>

                    <!-- Connection check -->
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap:12px;">
                        <FluentButton Appearance="Appearance.Neutral"
                                      Disabled="@(!_llmEnabled || _llmChecking)"
                                      OnClick="CheckLlmAsync">
                            @L["settings.llm_btn_check"]
                        </FluentButton>
                        <span style="font-size:13px;">
                            @L["settings.llm_status_label"]
                            @if (_llmChecking)
                            {
                                <span style="color:var(--neutral-foreground-hint);margin-left:6px;">@L["settings.llm_status_checking"]</span>
                            }
                            else if (_llmStatus == true)
                            {
                                <span style="color:var(--colorPaletteGreenForeground2,#107c10);font-weight:600;margin-left:6px;">✓ @L["settings.llm_status_ok"]</span>
                            }
                            else if (_llmStatus == false)
                            {
                                <span style="color:var(--colorPaletteRedForeground2,#a4262c);font-weight:600;margin-left:6px;">✗ @L["settings.llm_status_error"]</span>
                            }
                        </span>
                    </FluentStack>
                </div>
            </div>

            <div>
                <FluentButton Appearance="Appearance.Accent" OnClick="SaveAiSettingsAsync">
                    @L["settings.btn_save_ai"]
                </FluentButton>
            </div>

        </FluentStack>
    </FluentTab>

</FluentTabs>

<!-- Add/Edit pattern dialog -->
<FluentDialog @bind-Hidden="_patternDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true" Width="540px">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H4">
            @(_patternEditTarget is null ? L["patterns.dialog_add_title"] : L["patterns.dialog_edit_title"])
        </FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" Style="gap:14px;">
            <FluentTextField @bind-Value="_formName" Label="@(L["patterns.field_name_label"])" Placeholder="@(L["patterns.field_name_placeholder"])" style="width:100%;" />
            <FluentTextField @bind-Value="_formPattern"
                             Label="@(L["patterns.field_regex_label"])"
                             Placeholder="@(L["patterns.field_regex_placeholder"])"
                             style="width:100%;font-family:monospace;" />
            <FluentNumberField TValue="int" @bind-Value="_formPriority"
                               Label="@(L["patterns.field_priority_label"])"
                               Min="1" Max="999" style="width:160px;" />
            <FluentSelect TOption="string"
                          Label="@(L["patterns.field_applicable_label"])"
                          Value="@(_formApplicableTo?.ToString() ?? "")"
                          ValueChanged="@(v => _formApplicableTo = string.IsNullOrEmpty(v) ? null : Enum.Parse<FolderType>(v))"
                          style="width:240px;">
                <FluentOption TOption="string" Value="">@L["patterns.applicable_all"]</FluentOption>
                <FluentOption TOption="string" Value="Series">@L["patterns.applicable_series"]</FluentOption>
                <FluentOption TOption="string" Value="Movie">@L["patterns.applicable_movie"]</FluentOption>
            </FluentSelect>
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="SavePattern"
                      Disabled="@(string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formPattern))">
            @L["patterns.btn_save"]
        </FluentButton>
        <FluentButton OnClick="@(() => _patternDialogHidden = true)">@L["patterns.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    // ── General / Rules / Torrent state ──────────────────────────
    private List<IgnoreRule> _rules = [];
    private bool _loading = true;
    private string _newMask = "";
    private AppSettings _cfg = new();
    private string _themeStr = "System";
    private OfficeColor? _accentColorValue;
    private string _activeTab = "general";

    private static readonly (OfficeColor? Color, string Hex)[] _accentColors =
    [
        (null,                        "#808080"),
        (OfficeColor.Outlook,         "#0f6cbd"),
        (OfficeColor.Teams,           "#6264a7"),
        (OfficeColor.Word,            "#2b579a"),
        (OfficeColor.Excel,           "#217346"),
        (OfficeColor.PowerPoint,      "#b7472a"),
        (OfficeColor.OneNote,         "#7719aa"),
        (OfficeColor.PowerApps,       "#742774"),
        (OfficeColor.Stream,          "#bc1948"),
        (OfficeColor.Sway,            "#008272"),
        (OfficeColor.Publisher,       "#077568"),
        (OfficeColor.Planner,         "#31752f"),
        (OfficeColor.Visio,           "#3955a3"),
        (OfficeColor.Yammer,          "#106ebe"),
        (OfficeColor.PowerBI,         "#f2c811"),
        (OfficeColor.Office,          "#d83b01"),
        (OfficeColor.Access,          "#a4373a"),
    ];
    private TorrentConfig? _torrentCfg;
    private int _globalDlLimitMbps;
    private int _globalUlLimitMbps;

    // ── Metadata / LLM state ─────────────────────────────────────
    private bool _metaLoading = true;
    private string _tmdbApiKey = "";
    private string _malClientId = "";
    private bool _autoIdentifyEnabled = true;
    private bool _downloadEpThumbs = false;
    private bool _includeEpisodeName = true;
    // Source order
    private List<SearchSourceItem> _searchSources = [
        new("tmdb_tv",       true),
        new("tmdb_movie",    true),
        new("mal",           false),
        new("imdb_search",   false),
    ];
    private sealed class SearchSourceItem(string id, bool enabled)
    {
        public string Id      { get; } = id;
        public bool   Enabled { get; set; } = enabled;
    }
    // LLM / AI provider
    private bool   _llmEnabled  = false;
    private string _llmProvider = "compatible";
    private string _llmBaseUrl  = "http://ollama:11434";
    private string _llmApiKey   = "";
    private string _llmModel    = "qwen2.5:1.5b";
    private bool   _backdropEnabled = true;
    private int    _backdropIntervalSec = 30;
    private int    _backdropBlurPx = 2;
    private int    _backdropBrightness = 60;
    private bool?  _llmStatus;     // null=untested, true=ok, false=error
    private bool   _llmChecking = false;

    // ── Patterns state ───────────────────────────────────────────
    private List<RenamePattern> _patterns = [];
    private bool _patternsLoading = true;

    private bool _patternDialogHidden = true;
    private RenamePattern? _patternEditTarget;
    private string _formName = "";
    private string _formPattern = "";
    private int _formPriority = 100;
    private FolderType? _formApplicableTo;

    private string _testInput = "";
    private ParseResult? _testResult;
    private string? _testNewName;
    private string _testKind = "";

    // LLM suggestions
    private bool _llmSuggestBusy = false;
    private LlmRegexResult? _llmSuggestion;

    private async Task SuggestRegexAsync()
    {
        if (string.IsNullOrWhiteSpace(_testInput)) return;
        _llmSuggestBusy = true;
        _llmSuggestion = null;
        StateHasChanged();
        _llmSuggestion = await LlmService.SuggestRegexAsync(_testInput);
        _llmSuggestBusy = false;
    }

    private void UseAiSuggestion()
    {
        if (_llmSuggestion is null) return;
        _patternEditTarget = null;
        _formName     = "AI Suggested";
        _formPattern  = _llmSuggestion.Pattern;
        _formPriority = 100;
        _formApplicableTo = null;
        _patternDialogHidden = false;
        _llmSuggestion = null;
    }

    protected override async Task OnInitializedAsync()
    {
        // honour ?tab=xxx redirects (e.g. from /patterns)
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (qs["tab"] is { Length: > 0 } tab) _activeTab = tab;

        _themeStr = ThemeService.Mode.ToString();
        _accentColorValue = ThemeService.AccentColor;        _cfg = AppSettingsOptions.Value;
        await ReloadRulesAsync();
        _loading = false;

        await using var db = await DbFactory.CreateDbContextAsync();
        _torrentCfg = await db.TorrentConfig.FirstOrDefaultAsync(c => c.Id == 1) ?? new TorrentConfig();
        _globalDlLimitMbps = _torrentCfg.GlobalDownloadLimit / 125000;
        _globalUlLimitMbps = _torrentCfg.GlobalUploadLimit / 125000;

        await LoadPatternsAsync();
        _patternsLoading = false;

        await LoadMetadataSettingsAsync();
        _metaLoading = false;
    }

    private void OnThemeChanged(string value)
    {
        _themeStr = value;
        if (Enum.TryParse<DesignThemeModes>(value, out var mode))
            ThemeService.Set(mode);
    }

    private void OnAccentColorChanged(OfficeColor? color)
    {
        _accentColorValue = color;
        ThemeService.SetAccentColor(color);
    }

    private async Task OnLanguageChanged(string lang)
    {
        if (lang == L.CurrentLanguage) return;
        await L.LoadAsync(lang, Env);
        await AppConfig.SetAsync(AppConfigKeys.Language, lang);
        ToastService.ShowToast(ToastIntent.Success, L["settings.toast_language_saved"]);
    }

    private async Task ReloadRulesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _rules = await db.IgnoreRules
            .Where(r => r.Scope == RuleScope.Global && r.FolderId == null)
            .OrderBy(r => r.Mask)
            .ToListAsync();
    }

    private async Task AddRule()
    {
        if (string.IsNullOrWhiteSpace(_newMask)) return;
        var mask = _newMask.Trim().ToLowerInvariant();

        if (_rules.Any(r => r.Mask.Equals(mask, StringComparison.OrdinalIgnoreCase)))
        {
            ToastService.ShowToast(ToastIntent.Warning, L["settings.toast_mask_exists"]);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.IgnoreRules.Add(new IgnoreRule { Id = Guid.NewGuid(), Mask = mask, Scope = RuleScope.Global });
        await db.SaveChangesAsync();
        _newMask = "";
        ToastService.ShowToast(ToastIntent.Success, L.Get("settings.toast_rule_added", mask));
        await ReloadRulesAsync();
    }

    private async Task DeleteRule(IgnoreRule rule)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.IgnoreRules.FindAsync(rule.Id);
        if (entity is not null) { db.IgnoreRules.Remove(entity); await db.SaveChangesAsync(); }
        ToastService.ShowToast(ToastIntent.Success, L.Get("settings.toast_rule_deleted", rule.Mask));
        await ReloadRulesAsync();
    }

    // ── Patterns methods ─────────────────────────────────────────
    private async Task LoadPatternsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _patterns = await db.RenamePatterns
            .Where(p => p.Scope == PatternScope.Global)
            .OrderBy(p => p.Priority)
            .ToListAsync();
    }

    private void OpenPatternDialog(RenamePattern? pattern)
    {
        _patternEditTarget = pattern;
        _formName = pattern?.Name ?? "";
        _formPattern = pattern?.Pattern ?? "";
        _formPriority = pattern?.Priority ?? 100;
        _formApplicableTo = pattern?.ApplicableTo;
        _patternDialogHidden = false;
    }

    private async Task SavePattern()
    {
        if (string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formPattern)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (_patternEditTarget is null)
        {
            db.RenamePatterns.Add(new RenamePattern
            {
                Id = Guid.NewGuid(),
                Name = _formName.Trim(),
                Pattern = _formPattern.Trim(),
                Priority = _formPriority,
                ApplicableTo = _formApplicableTo,
                Scope = PatternScope.Global,
                IsBuiltIn = false,
            });
            ToastService.ShowToast(ToastIntent.Success, L["patterns.toast_added"]);
        }
        else
        {
            var entity = await db.RenamePatterns.FindAsync(_patternEditTarget.Id);
            if (entity is null) return;
            entity.Name = _formName.Trim();
            entity.Pattern = _formPattern.Trim();
            entity.Priority = _formPriority;
            entity.ApplicableTo = _formApplicableTo;
            ToastService.ShowToast(ToastIntent.Success, L["patterns.toast_updated"]);
        }

        await db.SaveChangesAsync();
        _patternDialogHidden = true;
        await LoadPatternsAsync();
    }

    private async Task DeletePattern(RenamePattern pattern)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.RenamePatterns.FindAsync(pattern.Id);
        if (entity is not null) { db.RenamePatterns.Remove(entity); await db.SaveChangesAsync(); }
        ToastService.ShowToast(ToastIntent.Success, L.Get("patterns.toast_deleted", pattern.Name));
        await LoadPatternsAsync();
    }

    private void TestPattern()
    {
        if (string.IsNullOrWhiteSpace(_testInput)) return;
        var ext = Path.GetExtension(_testInput);
        var kind = Matcher.DetermineFileKind(ext);
        _testKind = kind.ToString();
        _testResult = Matcher.ParseFileName(_testInput, _patterns);
        _testNewName = _testResult.IsMatched
            ? Matcher.BuildTargetName(_testResult, null, kind, ext)
            : null;
    }

    private async Task SaveTorrentSettingsAsync()
    {
        if (_torrentCfg is null) return;
        _torrentCfg.GlobalDownloadLimit = _globalDlLimitMbps * 125000;
        _torrentCfg.GlobalUploadLimit   = _globalUlLimitMbps * 125000;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.TorrentConfig.FirstOrDefaultAsync(c => c.Id == 1);
        if (existing is null)
        {
            _torrentCfg.Id = 1;
            db.TorrentConfig.Add(_torrentCfg);
        }
        else
        {
            existing.GlobalDownloadLimit = _torrentCfg.GlobalDownloadLimit;
            existing.GlobalUploadLimit = _torrentCfg.GlobalUploadLimit;
            existing.ListenPort = _torrentCfg.ListenPort;
            existing.MaxConnections = _torrentCfg.MaxConnections;
            existing.EnableDHT = _torrentCfg.EnableDHT;
            existing.EnableLSD = _torrentCfg.EnableLSD;
            existing.EnableUPnP = _torrentCfg.EnableUPnP;
            existing.StopSeedingAfterDone = _torrentCfg.StopSeedingAfterDone;
            existing.StopSeedingRatio = _torrentCfg.StopSeedingRatio;
            existing.AutoRenameAfterDownload = _torrentCfg.AutoRenameAfterDownload;
            existing.CacheDirectory = _torrentCfg.CacheDirectory;
        }
        await db.SaveChangesAsync();
        await TorrentEngine.UpdateGlobalSettingsAsync(_torrentCfg);
        ToastService.ShowToast(ToastIntent.Success, L["settings.toast_torrent_saved"]);
    }

    // ── Metadata / LLM methods ───────────────────────────────────
    private async Task LoadMetadataSettingsAsync()
    {
        _tmdbApiKey          = await AppConfig.GetAsync(AppConfigKeys.TmdbApiKey) ?? "";
        _malClientId         = await AppConfig.GetAsync(AppConfigKeys.MalClientId) ?? "";
        _autoIdentifyEnabled = await AppConfig.GetAsync<bool>(AppConfigKeys.AutoIdentifyEnabled, true);
        _downloadEpThumbs    = await AppConfig.GetAsync<bool>(AppConfigKeys.DownloadEpisodeThumbs, false);
        _includeEpisodeName  = await AppConfig.GetAsync<bool>(AppConfigKeys.IncludeEpisodeNameInFile, true);

        var sourceOrderJson = await AppConfig.GetAsync(AppConfigKeys.SearchSourceOrder);
        if (!string.IsNullOrWhiteSpace(sourceOrderJson))
        {
            try
            {
                var parsed = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(sourceOrderJson);
                if (parsed != null)
                {
                    _searchSources = parsed.Select(e => new SearchSourceItem(
                        e.GetProperty("Id").GetString() ?? "",
                        e.TryGetProperty("Enabled", out var en) && en.GetBoolean()
                    )).Where(s => s.Id is "tmdb_tv" or "tmdb_movie" or "mal" or "imdb_search").ToList();
                    // ensure all sources present
                    foreach (var (id, def) in new[] { ("tmdb_tv", true), ("tmdb_movie", true), ("mal", false), ("imdb_search", false) })
                        if (!_searchSources.Any(s => s.Id == id))
                            _searchSources.Add(new SearchSourceItem(id, def));
                }
            }
            catch { /* keep defaults */ }
        }

        // LLM — read new keys, migrate from legacy Ollama keys if new ones are absent
#pragma warning disable CS0618
        _llmEnabled  = await AppConfig.GetAsync<bool>(AppConfigKeys.LlmEnabled, false)
                    || await AppConfig.GetAsync<bool>(AppConfigKeys.OllamaEnabled, false);
        _llmProvider = await AppConfig.GetAsync(AppConfigKeys.LlmProvider) ?? "compatible";
        _llmBaseUrl  = await AppConfig.GetAsync(AppConfigKeys.LlmBaseUrl)
                    ?? await AppConfig.GetAsync(AppConfigKeys.OllamaUrl)
                    ?? "http://ollama:11434";
        _llmApiKey   = await AppConfig.GetAsync(AppConfigKeys.LlmApiKey) ?? "";
        _llmModel    = await AppConfig.GetAsync(AppConfigKeys.LlmModel)
                    ?? await AppConfig.GetAsync(AppConfigKeys.OllamaModel)
                    ?? "qwen2.5:1.5b";
#pragma warning restore CS0618

        _backdropEnabled     = await AppConfig.GetAsync<bool>(AppConfigKeys.BackdropEnabled, true);
        _backdropIntervalSec = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropIntervalSec, 30);
        _backdropBlurPx      = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBlurPx, 0);
        if (_backdropBlurPx > 20) _backdropBlurPx = 0;
        _backdropBrightness  = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBrightness, 60);
    }

    private async Task SaveMetadataSettingsAsync()
    {
        await AppConfig.SetAsync(AppConfigKeys.TmdbApiKey, _tmdbApiKey);
        await AppConfig.SetAsync(AppConfigKeys.MalClientId, _malClientId);
        await AppConfig.SetAsync<bool>(AppConfigKeys.AutoIdentifyEnabled, _autoIdentifyEnabled);
        await AppConfig.SetAsync<bool>(AppConfigKeys.DownloadEpisodeThumbs, _downloadEpThumbs);
        await AppConfig.SetAsync<bool>(AppConfigKeys.IncludeEpisodeNameInFile, _includeEpisodeName);
        var sourceOrderJson = System.Text.Json.JsonSerializer.Serialize(
            _searchSources.Select(s => new { s.Id, s.Enabled }));
        await AppConfig.SetAsync(AppConfigKeys.SearchSourceOrder, sourceOrderJson);
        ToastService.ShowToast(ToastIntent.Success, L["settings.toast_metadata_saved"]);
    }

    private void MoveSourceUp(int idx)
    {
        if (idx <= 0) return;
        (_searchSources[idx - 1], _searchSources[idx]) = (_searchSources[idx], _searchSources[idx - 1]);
    }

    private void MoveSourceDown(int idx)
    {
        if (idx >= _searchSources.Count - 1) return;
        (_searchSources[idx], _searchSources[idx + 1]) = (_searchSources[idx + 1], _searchSources[idx]);
    }

    private string SourceLabel(string id) => id switch
    {
        "tmdb_tv"      => "TMDB — TV / Series",
        "tmdb_movie"   => "TMDB — Movies",
        "mal"          => "MyAnimeList — Anime",
        "imdb_search"  => "IMDb — Search (imdbapi.dev)",
        _              => id,
    };

    private async Task SaveAiSettingsAsync()
    {
        await AppConfig.SetAsync<bool>(AppConfigKeys.LlmEnabled, _llmEnabled);
        await AppConfig.SetAsync(AppConfigKeys.LlmProvider, _llmProvider);
        await AppConfig.SetAsync(AppConfigKeys.LlmBaseUrl, _llmBaseUrl);
        await AppConfig.SetAsync(AppConfigKeys.LlmApiKey, _llmApiKey);
        await AppConfig.SetAsync(AppConfigKeys.LlmModel, _llmModel);
        ToastService.ShowToast(ToastIntent.Success, L["settings.toast_ai_saved"]);
    }

    private async Task SaveAppearanceAsync()
    {
        await AppConfig.SetAsync<bool>(AppConfigKeys.BackdropEnabled, _backdropEnabled);
        await AppConfig.SetAsync<int>(AppConfigKeys.BackdropIntervalSec, _backdropIntervalSec);
        await AppConfig.SetAsync<int>(AppConfigKeys.BackdropBlurPx, _backdropBlurPx);
        await AppConfig.SetAsync<int>(AppConfigKeys.BackdropBrightness, _backdropBrightness);
        await AppConfig.SetAsync(AppConfigKeys.ThemeMode, _themeStr);
        await AppConfig.SetAsync(AppConfigKeys.AccentColor, _accentColorValue?.ToString());
        ToastService.ShowToast(ToastIntent.Success, L["settings.toast_appearance_saved"]);
    }

    private async Task CheckLlmAsync()
    {
        _llmChecking = true;
        _llmStatus = null;
        StateHasChanged();
        try
        {
            // Persist current values so ILlmService picks them up in IsAvailableAsync
            await AppConfig.SetAsync<bool>(AppConfigKeys.LlmEnabled, _llmEnabled);
            await AppConfig.SetAsync(AppConfigKeys.LlmProvider, _llmProvider);
            await AppConfig.SetAsync(AppConfigKeys.LlmBaseUrl, _llmBaseUrl);
            await AppConfig.SetAsync(AppConfigKeys.LlmApiKey, _llmApiKey);
            await AppConfig.SetAsync(AppConfigKeys.LlmModel, _llmModel);
            _llmStatus = await LlmService.IsAvailableAsync();
        }
        catch
        {
            _llmStatus = false;
        }
        finally
        {
            _llmChecking = false;
        }
    }
}
