    private bool _appearanceSaving;
    private bool _patternSaving;
    private bool _ruleSaving;

    // ── Patterns state ───────────────────────────────────────────
    private List<RenamePattern> _patterns = [];
    private bool _patternsLoading = true;

    private bool _patternDialogHidden = true;
    private RenamePattern? _patternEditTarget;
    private string _formName = "";
    private string _formPattern = "";
    private int _formPriority = 100;
    private FolderType? _formApplicableTo;

    private string _testInput = "";
    private ParseResult? _testResult;
    private string? _testNewName;
    private string _testKind = "";

    // LLM suggestions
    private bool _llmSuggestBusy = false;
    private LlmRegexResult? _llmSuggestion;

    // ── Root folder dialog state ─────────────────────────────────
    private bool _sectionDialogOpen;
    private FolderWatcher? _sectionEditTarget;
    private FolderWatcher? _sectionDeleteTarget;
    private int _rfReloadToken;

    private void OpenAddSection()
    {
        _sectionEditTarget   = null;
        _sectionDialogOpen   = true;
    }

    /// <summary>Queues every identify-enabled child folder across ALL sections
    /// for re-identification. Moved here from the Catalog filter bar — per design,
    /// config-level actions belong in Settings, not the catalog.</summary>
    private async Task RescanAllAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var folderIds = await db.FolderWatchers
            .Where(f => !f.IsSection && f.IdentifyEnabled)
            .Select(f => f.Id)
            .ToListAsync();
        int queued = 0;
        foreach (var fid in folderIds)
        {
            // Skip folders already in flight to avoid duplicate queue entries.
            if (await db.IdentificationQueues.AnyAsync(q =>
                q.FolderId == fid &&
                (q.Status == IdentificationQueueStatus.Queued || q.Status == IdentificationQueueStatus.Processing)))
                continue;
            db.IdentificationQueues.Add(new IdentificationQueue
            {
                Id = Guid.NewGuid(),
                FolderId = fid,
                ForceRefresh = true,
                Status = IdentificationQueueStatus.Queued,
                QueuedAt = DateTime.UtcNow,
            });
            queued++;
        }
        await db.SaveChangesAsync();
        ToastService.ShowToast(ToastIntent.Info, $"Queued {queued} folder(s) for rescan.");
    }

    private void OpenEditSection(FolderWatcher section)
    {
        _sectionEditTarget   = section;
        _sectionDialogOpen   = true;
