@page "/settings"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IPatternMatchService Matcher
@inject IOptions<AppSettings> AppSettingsOptions
@inject IToastService ToastService
@inject ThemeService ThemeService
@inject TorrentEngineService TorrentEngine
@inject IWebHostEnvironment Env
@inject NavigationManager Nav
@inject IAppConfigService AppConfig
@inject ILlmService LlmService
@inject IdentificationQueueProcessorService QueueProc
@inject HardwareInfoService Hardware

<PageTitle>Animarr</PageTitle>

<header class="d-page-header">
    <div class="d-page-header__main">
        <div class="d-page-header__overline">CONFIG</div>
        <h1 class="d-page-header__title">SETTINGS</h1>
        <div class="d-page-header__sub">Single-user, no auth. Changes apply live — no restart required.</div>
    </div>
</header>

<div class="settings-grid">
    <nav class="settings-nav">
        @foreach (var (key, label) in _settingsTabs)
        {
            var k = key;
            <button type="button"
                    class="@($"settings-nav__btn {(_activeTab == k ? "settings-nav__btn--active" : "")}")"
                    @onclick="@(() => _activeTab = k)">@label</button>
        }
    </nav>
    <div class="settings-content">


    <!-- ============================================================ -->
    <!-- TAB: General -->
    <!-- ============================================================ -->
    @if (_activeTab == "general") {
        <div class="settings-card">
            <h3 class="settings-card__title">LANGUAGE</h3>
            <div class="settings-card__sub">Switches instantly. All copy is translated server-side.</div>
            @* Design pattern: mono uppercase label above the control (Field primitive
               from screens.jsx:394). Native <select> styled via .d-select primitive. *@
            <label class="settings-field settings-field--240">
                <span class="settings-field__label">Interface language</span>
                <select class="settings-field__select" value="@L.CurrentLanguage"
                        @onchange="@(async e => await OnLanguageChanged(e.Value?.ToString() ?? "en"))">
                    @foreach (var lang in L.SupportedLanguages)
                    {
                        <option value="@lang.Code">@lang.Label</option>
                    }
                </select>
            </label>
        </div>

        <div class="settings-card">
            <h3 class="settings-card__title">APPLICATION PARAMETERS</h3>
            <div class="settings-card__sub">Read-only — set via appsettings.json or Docker env vars (e.g. <code>AppSettings__WatcherDelayMs=2000</code>).</div>
            <div class="settings-readonly">
                <span class="settings-readonly__key">Watcher delay</span><span class="settings-readonly__val">@_cfg.WatcherDelayMs ms</span>
                <span class="settings-readonly__key">Video ext.</span><span class="settings-readonly__val settings-readonly__val--dim">@string.Join(" ", _cfg.VideoExtensions)</span>
                <span class="settings-readonly__key">Subtitles</span><span class="settings-readonly__val settings-readonly__val--dim">@string.Join(" ", _cfg.SubtitleExtensions)</span>
                <span class="settings-readonly__key">Images</span><span class="settings-readonly__val settings-readonly__val--dim">@string.Join(" ", _cfg.ImageExtensions)</span>
            </div>
        </div>
    }

    <!-- ============================================================ -->
    <!-- TAB: Root folders (inline CRUD — replaces /explorer) -->
    <!-- ============================================================ -->
    @if (_activeTab == "root_folders") {
        <div class="settings-card">
            @* Header row pairs the title/sub with a top-right Rescan-all action
               (moved off the catalog filter bar — Settings is the new home for
               config-level operations). *@
            <div class="settings-card__head">
                <div class="settings-card__head-text">
                    <h3 class="settings-card__title">ROOT FOLDERS</h3>
                    <div class="settings-card__sub">Section folders Animarr watches. Each immediate subdirectory becomes its own FolderWatcher. Animarr never renames folders on disk.</div>
                </div>
                <Btn Variant="ghost" Size="md" OnClick="RescanAllAsync">
                    <DIcon Name="refresh" Size="14" /> Rescan all
                </Btn>
            </div>

            <RootFoldersList ReloadToken="@_rfReloadToken"
                             OnEdit="@OpenEditSection"
                             OnDelete="@OpenDeleteSection" />

            @* Design Btn primitive — primary variant matches CANVAS §01.6.1.
               Opens an inline dialog instead of navigating. *@
            <div class="settings-add">
                <Btn Variant="primary" Size="md" OnClick="OpenAddSection">
                    <DIcon Name="plus" Size="13" /> Add section folder
                </Btn>
            </div>
        </div>
    }

    <!-- ============================================================ -->
    <!-- TAB: Rename history (embedded HistoryView) -->
    <!-- ============================================================ -->
    @if (_activeTab == "rename_history") {
        <div class="settings-card">
            <h3 class="settings-card__title">RENAME HISTORY</h3>
            <div class="settings-card__sub">Every file rename, persisted in SQLite. One-click revert restores the original filename on disk. Folder names are never touched.</div>
            <HistoryKpiTiles />
            <HistoryView />
        </div>
    }

    <!-- ============================================================ -->
    <!-- TAB: Appearance -->
    <!-- ============================================================ -->
    @if (_activeTab == "appearance") {
        @* ── Theme buttons (design Phase 6: locked Dark but UI kept for parity) ─── *@
        <div class="settings-card">
            <h3 class="settings-card__title">THEME</h3>
            <div class="settings-card__sub">Light, dark, or follow system. Dark recommended for the cinematic backdrop.</div>
            <div class="theme-buttons">
                @foreach (var (key, label) in new[] { ("System", "System"), ("Light", "Light"), ("Dark", "Dark") })
                {
                    var k = key;
                    <button type="button"
                            class="@($"theme-btn {(_themeStr == k ? "theme-btn--active" : "")}")"
                            @onclick="@(() => OnThemeChanged(k))">@label</button>
                }
            </div>
        </div>

        @* ── Accent swatches: design wants 6 oklch colors as 42x42 circles ─── *@
        <div class="settings-card">
            <h3 class="settings-card__title">ACCENT</h3>
            <div class="settings-card__sub">A single accent color flows through buttons, links, progress bars and active states.</div>
            <div class="accent-swatches">
                @foreach (var (label, hue) in _accentHues)
                {
                    var isSelected = _accentHueValue == hue;
                    var bg         = $"oklch(0.66 0.20 {hue})";
                    <button type="button"
                            class="@($"accent-swatch {(isSelected ? "accent-swatch--active" : "")}")"
                            style="@($"--c:{bg};")"
                            title="@label"
                            @onclick="@(() => OnAccentHueChanged(hue))">
                        @if (isSelected)
                        {
                            <DIcon Name="check" Size="16" />
                        }
                    </button>
                }
            </div>
        </div>

        @* AUDIO SYNC, HARDWARE ACCELERATION, EXTERNAL PLAYER moved into
           their own tabs (Audio + Hardware) — see below this Appearance
           block. Keeps each tab focused on one concern. *@
    }

    <!-- ============================================================ -->
    <!-- TAB: Audio -->
    <!-- ============================================================ -->
    @if (_activeTab == "audio") {
        @* ── Audio sync calibration (two channels) ─── *@
        <div class="settings-card">
            <h3 class="settings-card__title">AUDIO SYNC</h3>
            <div class="settings-card__sub">
                The server picks one of two pipelines per file based on its
                codec. Each has its own audio-vs-video latency profile that
                a single offset can't tune for both. Drag each slider while a
                file of that type is playing in another tab; close + reopen
                the player for the new value to take effect.
                <br /><br />
                <strong>Positive values delay audio</strong> (use when audio
                feels ahead of picture). Negative pulls audio forward.
            </div>

            @* ── HW channel: VAAPI re-encode (HEVC 8-bit → H.264) ── *@
            <div class="audio-sync-slider" id="animarr-sync-hw-block">
                <label class="settings-field">
                    <span class="settings-field__label">
                        Hardware re-encode (HEVC 8-bit) ·
                        <strong id="animarr-sync-hw-value">70</strong> ms
                    </span>
                    @* Inline oninput is intentional — Blazor interactive
                       re-renders blow away addEventListener handlers attached
                       elsewhere. Attribute-bound handlers survive the diff. *@
                    <input type="range" min="-200" max="300" step="5"
                           id="animarr-sync-hw-range"
                           class="settings-range"
                           value="70"
                           oninput="(function(el){var v=parseInt(el.value,10);document.getElementById('animarr-sync-hw-value').innerText=v;window.animarrCalibrate&&window.animarrCalibrate.setManual('hw',v);})(this)" />
                </label>
                <div class="audio-sync-slider__hint">
                    Applies to <strong>H.264 stream-copy isn't affected</strong>
                    (PCR sync in MPEG-TS is already accurate), but HEVC 8-bit
                    re-encoded via VAAPI uses this value. The auto-calibration
                    measures and writes here.
                </div>
                <div class="audio-sync-slider__buttons">
                    <button type="button" class="settings-btn"
                            onclick="var el=document.getElementById('animarr-sync-hw-range');el.value=70;el.dispatchEvent(new Event('input'));">
                        Reset to 70 ms
                    </button>
                    <button type="button" class="settings-btn"
                            onclick="window.animarrCalibrate&&window.animarrCalibrate.clearCache('hw');var el=document.getElementById('animarr-sync-hw-range');el.value=70;el.dispatchEvent(new Event('input'));">
                        Re-run auto calibration
                    </button>
                </div>
            </div>

            @* ── SW channel: stream-copy (HEVC 10-bit / HDR / DV) ── *@
            <div class="audio-sync-slider" id="animarr-sync-sw-block">
                <label class="settings-field">
                    <span class="settings-field__label">
                        Stream-copy (HEVC 10-bit / HDR / DV) ·
                        <strong id="animarr-sync-sw-value">0</strong> ms
                    </span>
                    @* Range bumped to 700ms — UHD BluRay remuxes use deep B-frame
                       structures (B7-B15 at 23.976 fps = 292-625ms of display
                       reorder), and audio-ahead of that magnitude is real. The
                       previous 300ms cap was clamping users with B15 content. *@
                    <input type="range" min="-200" max="700" step="5"
                           id="animarr-sync-sw-range"
                           class="settings-range"
                           value="0"
                           oninput="(function(el){var v=parseInt(el.value,10);document.getElementById('animarr-sync-sw-value').innerText=v;window.animarrCalibrate&&window.animarrCalibrate.setManual('sw',v);})(this)" />
                </label>
                <div class="audio-sync-slider__hint">
                    HEVC 10-bit content can't be hardware-encoded by Vega 11,
                    so it ships stream-copied as fMP4. The B-frame display
                    reorder leaves audio <strong>200-500&nbsp;ms ahead</strong>
                    of video depending on GOP depth — UHD BluRay remuxes with
                    deep B15 structures need the higher end. Start with
                    <strong>+300&nbsp;ms</strong>, slide up if audio still leads.
                </div>
                <div class="audio-sync-slider__buttons">
                    <button type="button" class="settings-btn"
                            onclick="var el=document.getElementById('animarr-sync-sw-range');el.value=0;el.dispatchEvent(new Event('input'));">
                        Reset to 0 ms
                    </button>
                    <button type="button" class="settings-btn"
                            onclick="var el=document.getElementById('animarr-sync-sw-range');el.value=300;el.dispatchEvent(new Event('input'));">
                        Try +300 ms (UHD remux)
                    </button>
                </div>
            </div>

            <script suppress-error="BL9992">
                // Initial values pulled from localStorage so the sliders show
                // the actual stored offsets when the page opens.
                (function syncSlidersInitial() {
                    if (!window.animarrCalibrate) return;
                    const init = (rangeId, labelId, channel, dflt) => {
                        const range = document.getElementById(rangeId);
                        const label = document.getElementById(labelId);
                        if (!range || !label) return;
                        const stored = window.animarrCalibrate.getCached(channel);
                        const value = (stored === null) ? dflt : stored;
                        range.value = value;
                        label.innerText = value;
                    };
                    init('animarr-sync-hw-range', 'animarr-sync-hw-value', 'hw', 70);
                    init('animarr-sync-sw-range', 'animarr-sync-sw-value', 'sw', 0);
                })();
            </script>
        </div>

        @* External player + hardware-acceleration cards moved out — see
           Audio tab (External Player) and Hardware tab (Hardware Accel) below. *@
    }

    <!-- ============================================================ -->
    <!-- TAB: Hardware -->
    <!-- ============================================================ -->
    @if (_activeTab == "hardware") {
        @* ── Hardware acceleration status ─── *@
        <div class="settings-card">
            <h3 class="settings-card__title">HARDWARE ACCELERATION</h3>
            <div class="settings-card__sub">
                What the server detected at startup. Animarr automatically picks
                the best encoder for each file — NVENC &gt; VAAPI &gt; software
                stream-copy. To enable a vendor that shows ❌, follow the help
                under it (requires host-side setup + container restart).
            </div>
            @if (_hwInfo is null)
            {
                <div class="hw-row">Loading…</div>
            }
            else
            {
                <div class="hw-grid">
                    @* VAAPI row (AMD / older Intel) *@
                    <div class="@($"hw-row {(_hwInfo.Vaapi.Available ? "hw-row--ok" : "hw-row--off")}")">
                        <div class="hw-row__label">
                            <span class="hw-row__icon">@(_hwInfo.Vaapi.Available ? "✅" : "❌")</span>
                            <strong>VAAPI</strong>
                            <span class="hw-row__sub">(AMD / Intel)</span>
                        </div>
                        <div class="hw-row__detail">
                            @if (_hwInfo.Vaapi.Available)
                            {
                                @if (!string.IsNullOrEmpty(_hwInfo.Vaapi.DeviceName))
                                {
                                    <div class="hw-row__device">@_hwInfo.Vaapi.DeviceName</div>
                                }
                                <div class="hw-row__line">@_hwInfo.Vaapi.Detail</div>
                            }
                            else
                            {
                                <div class="hw-row__line">@_hwInfo.Vaapi.Detail</div>
                                <details class="hw-row__help">
                                    <summary>How to enable</summary>
                                    <p>On the docker host, add to <code>docker run</code>:</p>
                                    <pre>--device /dev/dri:/dev/dri --group-add video</pre>
                                    <p>The deploy script adds this automatically when <code>/dev/dri</code> is present on the host.</p>
                                </details>
                            }
                        </div>
                    </div>

                    @* NVENC row *@
                    <div class="@($"hw-row {(_hwInfo.Nvenc.Available ? "hw-row--ok" : "hw-row--off")}")">
                        <div class="hw-row__label">
                            <span class="hw-row__icon">@(_hwInfo.Nvenc.Available ? "✅" : "❌")</span>
                            <strong>NVENC</strong>
                            <span class="hw-row__sub">(NVIDIA)</span>
                        </div>
                        <div class="hw-row__detail">
                            @if (_hwInfo.Nvenc.Available)
                            {
                                <div class="hw-row__device">@_hwInfo.Nvenc.DeviceName</div>
                                <div class="hw-row__line">@_hwInfo.Nvenc.DriverInfo · @_hwInfo.Nvenc.Detail</div>
                            }
                            else
                            {
                                <div class="hw-row__line">@_hwInfo.Nvenc.Detail</div>
                                <details class="hw-row__help">
                                    <summary>How to enable</summary>
                                    <ol class="hw-row__steps">
                                        <li>Install NVIDIA driver on the host: <code>sudo apt install nvidia-driver-535</code></li>
                                        <li>Install nvidia-container-toolkit: <code>sudo apt install nvidia-container-toolkit</code></li>
                                        <li>Restart Docker: <code>sudo systemctl restart docker</code></li>
                                        <li>Re-deploy Animarr — the deploy script auto-detects and adds <code>--gpus all</code></li>
                                    </ol>
                                </details>
                            }
                        </div>
                    </div>

                    @* QSV row (Intel) — informational only, we use VAAPI for Intel currently *@
                    <div class="@($"hw-row {(_hwInfo.Qsv.Available ? "hw-row--ok" : "hw-row--off")}")">
                        <div class="hw-row__label">
                            <span class="hw-row__icon">@(_hwInfo.Qsv.Available ? "✅" : "❌")</span>
                            <strong>QSV</strong>
                            <span class="hw-row__sub">(Intel Quick Sync)</span>
                        </div>
                        <div class="hw-row__detail">
                            <div class="hw-row__line">@_hwInfo.Qsv.Detail</div>
                        </div>
                    </div>
                </div>
                <div class="hw-actions">
                    <button type="button" class="settings-btn" @onclick="RescanHardwareAsync">Re-scan</button>
                    <span class="hw-actions__hint">Last probed: @_hwInfo.ProbedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                </div>
            }
        </div>

    }

    <!-- ============================================================ -->
    <!-- TAB: Audio (continued — External Player) -->
    <!-- ============================================================ -->
    @if (_activeTab == "audio") {
        @* ── External player handoff ─── *@
        <div class="settings-card">
            <h3 class="settings-card__title">EXTERNAL PLAYER</h3>
            <div class="settings-card__sub">
                The external-icon button in the in-browser player hands the
                current file off to a native player (better HDR / DV / Atmos
                than browser HLS). Pick which player to use here. <strong>mpv</strong>
                also reports progress back to Animarr (Continue / % watched
                stays in sync); the others just play.
            </div>
            <label class="settings-field settings-field--240">
                <span class="settings-field__label">Preferred external player</span>
                <select class="settings-field__select"
                        @bind="_externalPlayer"
                        @bind:after="SaveExternalPlayerAsync">
                    <option value="mpv">mpv (desktop, with progress tracking)</option>
                    <option value="iina">IINA (macOS)</option>
                    <option value="infuse">Infuse (iOS / tvOS / macOS)</option>
                    <option value="vlc_ios">VLC (iOS — vlc-x-callback)</option>
                    <option value="m3u">.m3u download (universal — works with VLC, MPC, PotPlayer, etc.)</option>
                    <option value="custom">Custom URI template</option>
                </select>
            </label>
            @if (_externalPlayer == "custom")
            {
                <label class="settings-field">
                    <span class="settings-field__label">
                        Custom URI template (use <code>&#123;url&#125;</code> for the stream URL)
                    </span>
                    <input type="text"
                           class="settings-field__input"
                           placeholder="potplayer://{url}"
                           @bind="_externalPlayerCustom"
                           @bind:after="SaveExternalPlayerAsync" />
                </label>
            }
            @if (_externalPlayer == "mpv")
            {
                <details class="mpv-install-wrap" open>
                    <summary class="mpv-install-summary">mpv setup instructions</summary>
                    <ol class="mpv-install">
                        <li>
                            Install mpv.net (Windows) or mpv (Linux / macOS) —
                            both register the <code>mpv://</code> URI scheme.
                            <div class="ext-btn-row">
                                <a class="settings-btn settings-btn--icon"
                                   href="https://mpv.net" target="_blank" rel="noopener">
                                    <DIcon Name="external" Size="14" /> mpv.net (Windows)
                                </a>
                                <a class="settings-btn settings-btn--icon"
                                   href="https://mpv.io/installation/" target="_blank" rel="noopener">
                                    <DIcon Name="external" Size="14" /> mpv.io (Linux / macOS)
                                </a>
                            </div>
                        </li>
                        <li>
                            Download the tracker script.
                            <div class="ext-btn-row">
                                <a class="settings-btn settings-btn--icon"
                                   href="/api/mpv-tracker.lua"
                                   download="animarr-tracker.lua">
                                    <DIcon Name="download" Size="14" /> animarr-tracker.lua
                                </a>
                            </div>
                        </li>
                        <li>
                            Drop it into your mpv scripts directory:
                            <ul class="mpv-install__paths">
                                <li><code>%APPDATA%\mpv.net\scripts\</code> — mpv.net (Windows)</li>
                                <li><code>~/.config/mpv/scripts/</code> — mpv (Linux / macOS)</li>
                            </ul>
                        </li>
                        <li>Restart mpv. Clicking the external icon in any video now plays + tracks.</li>
                    </ol>
                </details>
            }
            else if (_externalPlayer == "m3u")
            {
                <div class="mpv-install-note">
                    <strong>One-click flow:</strong> in the player's top bar, click
                    the external icon → browser auto-downloads a tiny <code>.m3u</code>
                    file → OS opens it with whatever player is set as default
                    for <code>.m3u</code>. No URLs to copy, no setup beyond
                    setting your preferred player as the default <code>.m3u</code>
                    handler in your OS (most installers do this automatically).
                </div>
            }
            else if (_externalPlayer == "iina")
            {
                <div class="mpv-install-note">
                    IINA on macOS handles <code>iina://weblink?url=...</code>
                    out of the box.
                </div>
                <div class="ext-btn-row">
                    <a class="settings-btn settings-btn--icon"
                       href="https://iina.io" target="_blank" rel="noopener">
                        <DIcon Name="external" Size="14" /> iina.io
                    </a>
                </div>
            }
            else if (_externalPlayer == "infuse")
            {
                <div class="mpv-install-note">
                    Infuse on iOS / tvOS / macOS accepts
                    <code>infuse://x-callback-url/play?url=...</code>.
                </div>
                <div class="ext-btn-row">
                    <a class="settings-btn settings-btn--icon"
                       href="https://firecore.com/infuse" target="_blank" rel="noopener">
                        <DIcon Name="external" Size="14" /> firecore.com/infuse
                    </a>
                </div>
            }
            else if (_externalPlayer == "vlc_ios")
            {
                <div class="mpv-install-note">
                    VLC on iOS responds to
                    <code>vlc-x-callback://x-callback-url/stream?url=...</code>.
                    Doesn't apply to VLC desktop — use the <strong>.m3u
                    download</strong> option for that.
                </div>
                <div class="ext-btn-row">
                    <a class="settings-btn settings-btn--icon"
                       href="https://apps.apple.com/app/vlc-for-mobile/id650377962"
                       target="_blank" rel="noopener">
                        <DIcon Name="external" Size="14" /> VLC on App Store
                    </a>
                </div>
            }
        </div>
    }

    <!-- ============================================================ -->
    <!-- TAB: Appearance (continued — Backdrop) -->
    <!-- ============================================================ -->
    @if (_activeTab == "appearance") {
        @* ── Backdrop ─── *@
        <div class="settings-card">
            <h3 class="settings-card__title">BACKDROP</h3>
            <div class="settings-card__sub">Ambient fanart slideshow behind every page. Sourced from your library.</div>
            <div class="backdrop-row">
                <span>Show animated backdrop on all pages</span>
                @* Design Toggle primitive — matches CANVAS §01.6.3 (34×18, accent fill, glow). *@
                <Toggle Checked="_backdropEnabled" CheckedChanged="@(v => _backdropEnabled = v)" />
            </div>
            <div class="backdrop-sliders @(_backdropEnabled ? "" : "backdrop-sliders--disabled")">
                <label class="settings-field">
                    <span class="settings-field__label">Rotation interval (s)</span>
                    @* Native number input styled via .settings-field__input--mono — matches the design Input primitive. *@
                    <input type="number" min="5" max="300"
                           class="settings-field__input settings-field__input--mono settings-field__input--120"
                           value="@_backdropIntervalSec"
                           @oninput="@(e => _backdropIntervalSec = int.TryParse(e.Value?.ToString(), out var v) ? v : _backdropIntervalSec)"
                           disabled="@(!_backdropEnabled)" />
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">Blur · @_backdropBlurPx px</span>
                    <input type="range" min="0" max="20" step="1"
                           class="settings-range"
                           value="@_backdropBlurPx"
                           @oninput="@(e => _backdropBlurPx = int.TryParse(e.Value?.ToString(), out var v) ? v : _backdropBlurPx)"
                           disabled="@(!_backdropEnabled)" />
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">Brightness · @_backdropBrightness%</span>
                    <input type="range" min="10" max="100" step="5"
                           class="settings-range"
                           value="@_backdropBrightness"
                           @oninput="@(e => _backdropBrightness = int.TryParse(e.Value?.ToString(), out var v) ? v : _backdropBrightness)"
                           disabled="@(!_backdropEnabled)" />
                </label>
            </div>
            <div class="settings-actions">
                <Btn Variant="primary" OnClick="SaveAppearanceAsync" Loading="@_appearanceSaving">
                    <DIcon Name="check" Size="13" /> Save appearance
                </Btn>
            </div>
        </div>
    }

    <!-- ============================================================ -->
    <!-- TAB: Patterns -->
    <!-- ============================================================ -->
    @if (_activeTab == "patterns") {
        <div class="settings-card">
            <h3 class="settings-card__title">RENAME PATTERNS</h3>
            <div class="settings-card__sub">Regex with named groups: <code>(?&lt;season&gt;)</code> <code>(?&lt;episode&gt;)</code> <code>(?&lt;title&gt;)</code> <code>(?&lt;year&gt;)</code>. Higher priority wins.</div>

            @if (_patternsLoading)
            {
                @* Skeleton rows — same form-row visual rhythm as the real list.
                   Spec: design_handoff_animarr/pages/loaders.html §03. *@
                <div class="settings-skel">
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                </div>
            }
            else
            {
                @* Design pattern: native grid table (screens.jsx::SettingsPatterns 1591-1620).
                   Columns: 40 / 1fr / 1.5fr / 110 / 80 / 70 — first slot is a Toggle in the
                   design (per-pattern enable). Animarr's data model stores IsBuiltIn instead
                   of an Enable flag, so the first cell shows the source pill (BUILT-IN/CUSTOM)
                   and the SCOPE column shows the applicable folder type. *@
                <div class="ntable ntable--patterns">
                    <div class="ntable__head">
                        <span>SRC</span>
                        <span>NAME</span>
                        <span>REGEX</span>
                        <span>SCOPE</span>
                        <span>PRIO</span>
                        <span></span>
                    </div>
                    @foreach (var p in _patterns)
                    {
                        <div class="ntable__row">
                            <Pill Tone="@(p.IsBuiltIn ? "accent" : "default")">
                                @(p.IsBuiltIn ? "BUILT-IN" : "CUSTOM")
                            </Pill>
                            <span class="ntable__name">@p.Name</span>
                            <code class="ntable__regex">@p.Pattern</code>
                            <span class="ntable__scope">
                                @(p.ApplicableTo switch {
                                    FolderType.Movie  => "MOVIE",
                                    FolderType.Series => "SERIES",
                                    _                 => "ALL"
                                })
                            </span>
                            <span class="ntable__prio">@p.Priority</span>
                            <span class="ntable__actions">
                                @if (!p.IsBuiltIn)
                                {
                                    <button type="button" title="Edit" class="ntable__icon"
                                            @onclick="@(() => OpenPatternDialog(p))">
                                        <DIcon Name="pencil" Size="14" />
                                    </button>
                                    <button type="button" title="Delete" class="ntable__icon"
                                            @onclick="@(() => DeletePattern(p))">
                                        <DIcon Name="trash" Size="14" />
                                    </button>
                                }
                            </span>
                        </div>
                    }
                </div>
                <div class="settings-actions">
                    <Btn Variant="primary" OnClick="@(() => OpenPatternDialog(null))">
                        <DIcon Name="plus" Size="13" /> New pattern
                    </Btn>
                </div>

                @* Tester section. The design only shows a list + Add CTA in this card;
                   the tester is an Animarr-specific affordance kept below the divider. *@
                <hr class="settings-divider" />

                <h4 class="settings-subhead">@L["patterns.test_title"]</h4>
                <div class="settings-subhead__hint">@L["patterns.test_hint"]</div>

                <div class="ptest-row">
                    <label class="settings-field settings-field--grow">
                        <span class="settings-field__label">@L["patterns.test_field_label"]</span>
                        <input class="settings-field__input settings-field__input--mono"
                               placeholder="@L["patterns.test_placeholder"]"
                               value="@_testInput"
                               @oninput="@(e => _testInput = e.Value?.ToString() ?? "")" />
                    </label>
                    <Btn Variant="primary" OnClick="TestPattern">@L["patterns.test_button"]</Btn>
                    <Btn Variant="ghost"
                         Disabled="@(_llmSuggestBusy || string.IsNullOrWhiteSpace(_testInput))"
                         OnClick="SuggestRegexAsync"
                         title="@L["patterns.llm_suggest_tooltip"]">
                        @if (_llmSuggestBusy)
                        {
                            <span>…</span>
                        }
                        else
                        {
                            <DIcon Name="sparkle" Size="13" />
                            @L["patterns.llm_suggest_btn"]
                        }
                    </Btn>
                </div>

                @if (_llmSuggestion != null)
                {
                    <div class="ptest-panel">
                        <div class="ptest-panel__title">@L["patterns.llm_suggest_result"]</div>
                        <code class="ptest-panel__code">@_llmSuggestion.Pattern</code>
                        @if (!string.IsNullOrEmpty(_llmSuggestion.Explanation))
                        {
                            <div class="ptest-panel__hint">@_llmSuggestion.Explanation</div>
                        }
                        <div class="ptest-panel__actions">
                            <Btn Variant="primary" Size="sm" OnClick="UseAiSuggestion">
                                @L["patterns.llm_suggest_use"]
                            </Btn>
                            <Btn Variant="flat" Size="sm" OnClick="@(() => _llmSuggestion = null)">
                                @L["patterns.llm_suggest_dismiss"]
                            </Btn>
                        </div>
                    </div>
                }

                @if (_testResult is not null)
                {
                    <div class="ptest-panel @(_testResult.IsMatched ? "ptest-panel--ok" : "ptest-panel--err")">
                        @if (_testResult.IsMatched)
                        {
                            <div class="ptest-panel__title ptest-panel__title--ok">@L["patterns.test_matched"]</div>
                            <div class="ptest-panel__rows">
                                <div>@L["patterns.test_season_label"] <b>@(_testResult.Season?.ToString() ?? L["patterns.test_season_not_found"])</b></div>
                                <div>@L["patterns.test_episode_label"] <b>@_testResult.Episode</b></div>
                                <div>@L["patterns.test_kind_label"] <b>@_testKind</b></div>
                                <div>@L["patterns.test_new_name_label"] <b class="ptest-panel__newname">@(_testNewName ?? "—")</b></div>
                            </div>
                        }
                        else
                        {
                            <div class="ptest-panel__title ptest-panel__title--err">@L["patterns.test_not_matched"]</div>
                        }
                    </div>
                }
            }

        </div>
    }

    <!-- ============================================================ -->
    <!-- TAB: Ignore Rules -->
    <!-- ============================================================ -->
    @if (_activeTab == "rules") {
        <div class="settings-card">
            <h3 class="settings-card__title">IGNORE RULES</h3>
            <div class="settings-card__sub">Glob patterns. Matching files are invisible to watchers, scans and rename queues.</div>

            @if (_loading)
            {
                <div class="settings-skel">
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                </div>
            }
            else
            {
                @* Inline add-rule row — mono input + primary Btn, matching the design's
                   "New rule" CTA pattern (screens.jsx::SettingsIgnore line 1641). *@
                <div class="ignore-add">
                    <input class="settings-field__input settings-field__input--mono ignore-add__input"
                           placeholder="*.nfo, fanart*, sample.*, …"
                           value="@_newMask"
                           @oninput="@(e => _newMask = e.Value?.ToString() ?? "")" />
                    <Btn Variant="primary"
                         Disabled="@string.IsNullOrWhiteSpace(_newMask)"
                         Loading="@_ruleSaving"
                         OnClick="AddRule">
                        <DIcon Name="plus" Size="13" /> Add
                    </Btn>
                </div>

                @* Native grid table — columns: 1fr / 130 / 70 (design line 1628). *@
                <div class="ntable ntable--ignore">
                    <div class="ntable__head">
                        <span>GLOB</span>
                        <span>SCOPE</span>
                        <span></span>
                    </div>
                    @foreach (var r in _rules)
                    {
                        <div class="ntable__row">
                            <span class="ntable__name ntable__name--mono">@r.Mask</span>
                            <Pill>GLOBAL</Pill>
                            <span class="ntable__actions">
                                <button type="button" class="ntable__icon" title="Delete"
                                        @onclick="@(() => DeleteRule(r))">
                                    <DIcon Name="trash" Size="14" />
                                </button>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- ============================================================ -->
    <!-- TAB: Torrent -->
    <!-- ============================================================ -->
    @if (_activeTab == "torrent") {
        @if (_torrentCfg is null)
        {
            <div class="settings-card">
                <div class="settings-skel">
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                </div>
            </div>
        }
        else
        {
        <div class="settings-card">
            <h3 class="settings-card__title">TORRENT</h3>
            <div class="settings-card__sub">Global limits override individual torrents only when lower.</div>

            @* Design pattern (screens.jsx::SettingsTorrent 1645-1662):
               2-col grid of Field/Input pairs followed by a column of ToggleRow rows. *@
            <div class="settings-fields-2col">
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.torrent_dl_limit_label"]</span>
                    <input type="number" min="0" class="settings-field__input settings-field__input--mono"
                           value="@_globalDlLimitMbps"
                           @oninput="@(e => _globalDlLimitMbps = int.TryParse(e.Value?.ToString(), out var v) ? v : _globalDlLimitMbps)" />
                    <span class="settings-field__hint">0 = unlimited</span>
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.torrent_ul_limit_label"]</span>
                    <input type="number" min="0" class="settings-field__input settings-field__input--mono"
                           value="@_globalUlLimitMbps"
                           @oninput="@(e => _globalUlLimitMbps = int.TryParse(e.Value?.ToString(), out var v) ? v : _globalUlLimitMbps)" />
                    <span class="settings-field__hint">0 = unlimited</span>
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.torrent_port_label"]</span>
                    <input type="number" min="1024" max="65535" class="settings-field__input settings-field__input--mono"
                           value="@_torrentCfg.ListenPort"
                           @oninput="@(e => _torrentCfg.ListenPort = int.TryParse(e.Value?.ToString(), out var v) ? v : _torrentCfg.ListenPort)" />
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.torrent_max_connections_label"]</span>
                    <input type="number" min="1" max="2000" class="settings-field__input settings-field__input--mono"
                           value="@_torrentCfg.MaxConnections"
                           @oninput="@(e => _torrentCfg.MaxConnections = int.TryParse(e.Value?.ToString(), out var v) ? v : _torrentCfg.MaxConnections)" />
                </label>
            </div>

            @* ToggleRow column — Toggle + label, 13px text-dim, matches ToggleRow primitive
               (screens.jsx::ToggleRow 1167-1175). *@
            <div class="settings-toggles">
                <label class="settings-toggle-row">
                    <Toggle Checked="_torrentCfg.EnableDHT" CheckedChanged="@(v => _torrentCfg.EnableDHT = v)" />
                    <span>@L["settings.torrent_dht_switch"]</span>
                </label>
                <label class="settings-toggle-row">
                    <Toggle Checked="_torrentCfg.EnableLSD" CheckedChanged="@(v => _torrentCfg.EnableLSD = v)" />
                    <span>@L["settings.torrent_lsd_switch"]</span>
                </label>
                <label class="settings-toggle-row">
                    <Toggle Checked="_torrentCfg.EnableUPnP" CheckedChanged="@(v => _torrentCfg.EnableUPnP = v)" />
                    <span>@L["settings.torrent_upnp_switch"]</span>
                </label>
            </div>

            <hr class="settings-divider" />
            <h4 class="settings-subhead">@L["settings.torrent_seeding_done_title"]</h4>
            <div class="settings-toggles">
                <label class="settings-toggle-row">
                    <Toggle Checked="_torrentCfg.StopSeedingAfterDone"
                            CheckedChanged="@(v => _torrentCfg.StopSeedingAfterDone = v)" />
                    <span>@L["settings.torrent_stop_after_done"]</span>
                </label>
                <div class="settings-inline-field">
                    <span class="settings-field__label settings-field__label--inline">@L["settings.torrent_stop_ratio_label"]</span>
                    <input type="number" min="0" step="0.1"
                           class="settings-field__input settings-field__input--mono settings-field__input--120"
                           value="@_torrentCfg.StopSeedingRatio"
                           @oninput="@(e => _torrentCfg.StopSeedingRatio = double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : _torrentCfg.StopSeedingRatio)" />
                    <span class="settings-field__hint">@L["settings.torrent_stop_ratio_hint"]</span>
                </div>
            </div>

            <hr class="settings-divider" />
            <h4 class="settings-subhead">@L["settings.torrent_automation_title"]</h4>
            <div class="settings-toggles">
                <label class="settings-toggle-row">
                    <Toggle Checked="_torrentCfg.AutoRenameAfterDownload"
                            CheckedChanged="@(v => _torrentCfg.AutoRenameAfterDownload = v)" />
                    <span>@L["settings.torrent_auto_rename_switch"]</span>
                </label>
            </div>

            <hr class="settings-divider" />
            <h4 class="settings-subhead">@L["settings.torrent_service_title"]</h4>
            <div class="settings-readonly settings-readonly--inline">
                <span class="settings-readonly__key">@L["settings.torrent_cache_dir_label"]</span>
                <span class="settings-readonly__val">@_torrentCfg.CacheDirectory</span>
            </div>

            <div class="settings-actions">
                <Btn Variant="primary" OnClick="SaveTorrentSettingsAsync" Loading="@_torrentSaving">
                    <DIcon Name="check" Size="13" /> @L["settings.btn_save_torrent"]
                </Btn>
            </div>
        </div>
        }
    }

    <!-- ============================================================ -->
    <!-- TAB: Metadata & LLM -->
    <!-- ============================================================ -->
    @if (_activeTab == "metadata") {
        @if (_metaLoading)
        {
            <div class="settings-card">
                <div class="settings-skel">
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                    <Skeleton Variant="row" Height="48" />
                </div>
            </div>
        }
        else
        {
        <div class="settings-card">
            <h3 class="settings-card__title">METADATA SOURCES</h3>
            <div class="settings-card__sub">@L["settings.meta_sources_hint"]</div>

            @* API keys — Field/Input pattern (screens.jsx::Field 394, Input 402). *@
            <div class="settings-fields-stack">
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.tmdb_key_label"]</span>
                    <input class="settings-field__input settings-field__input--mono"
                           placeholder="@L["settings.tmdb_key_placeholder"]"
                           value="@_tmdbApiKey"
                           @oninput="@(e => _tmdbApiKey = e.Value?.ToString() ?? "")" />
                    <span class="settings-field__hint">@L["settings.tmdb_key_hint"]</span>
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.mal_client_id_label"]</span>
                    <input class="settings-field__input settings-field__input--mono"
                           placeholder="@L["settings.mal_client_id_placeholder"]"
                           value="@_malClientId"
                           @oninput="@(e => _malClientId = e.Value?.ToString() ?? "")" />
                    <span class="settings-field__hint">@L["settings.mal_client_id_hint"]</span>
                </label>
            </div>

            <hr class="settings-divider" />
            <h4 class="settings-subhead">@L["settings.search_sources_title"]</h4>
            <div class="settings-subhead__hint">@L["settings.search_sources_hint"]</div>

            @* Source priority list — design ::SettingsMeta 1664-1683 uses a rows table.
               Animarr's variant adds order indices + up/down reorder controls. *@
            <div class="meta-sources">
                @for (int i = 0; i < _searchSources.Count; i++)
                {
                    var idx = i;
                    var src = _searchSources[idx];
                    <div class="meta-sources__row">
                        <span class="meta-sources__idx">@(idx + 1)</span>
                        <Toggle Checked="src.Enabled" CheckedChanged="@(v => src.Enabled = v)" />
                        <span class="meta-sources__name">@SourceLabel(src.Id)</span>
                        <button type="button" class="ntable__icon meta-sources__chev-up" title="Move up"
                                disabled="@(idx == 0)"
                                @onclick="@(() => MoveSourceUp(idx))">
                            <DIcon Name="chev-d" Size="14" />
                        </button>
                        <button type="button" class="ntable__icon" title="Move down"
                                disabled="@(idx == _searchSources.Count - 1)"
                                @onclick="@(() => MoveSourceDown(idx))">
                            <DIcon Name="chev-d" Size="14" />
                        </button>
                    </div>
                }
            </div>

            <hr class="settings-divider" />
            <h4 class="settings-subhead">@L["settings.meta_auto_title"]</h4>
            <div class="settings-toggles">
                <label class="settings-toggle-row">
                    <Toggle Checked="_autoIdentifyEnabled" CheckedChanged="@(v => _autoIdentifyEnabled = v)" />
                    <span>@L["settings.auto_identify_switch"]</span>
                </label>
                <div class="settings-toggle-block">
                    <label class="settings-toggle-row">
                        <Toggle Checked="_downloadEpThumbs" CheckedChanged="@(v => _downloadEpThumbs = v)" />
                        <span>@L["settings.download_ep_thumbs_switch"]</span>
                    </label>
                    <div class="settings-toggle-block__hint">@L["settings.download_ep_thumbs_hint"]</div>
                </div>
                @* Auto-rename of container folders was removed after two catastrophic
                   data-corruption incidents. Identification only updates DB associations now. *@
                <div class="settings-toggle-block">
                    <label class="settings-toggle-row">
                        <Toggle Checked="_includeEpisodeName" CheckedChanged="@(v => _includeEpisodeName = v)" />
                        <span>@L["settings.include_episode_name_switch"]</span>
                    </label>
                    <div class="settings-toggle-block__hint">@L["settings.include_episode_name_hint"]</div>
                </div>
            </div>

            <div class="settings-actions">
                <Btn Variant="primary" OnClick="SaveMetadataSettingsAsync" Loading="@_metaSaving">
                    <DIcon Name="check" Size="13" /> @L["settings.btn_save_metadata"]
                </Btn>
            </div>
        </div>
        }
    }

    <!-- ============================================================ -->
    <!-- TAB: AI / LLM -->
    <!-- ============================================================ -->
    @if (_activeTab == "ai") {
        <div class="settings-card">
            <h3 class="settings-card__title">AI / LLM</h3>
            <div class="settings-card__sub">Optional language-model assist for filename → canonical title normalisation. Local (Ollama, LM Studio) or any OpenAI-compatible endpoint.</div>

            @* ── AI/LLM hero status card (sparkle gradient + live counters).
                  Spec: screens.jsx::SettingsLLM 1545-1558. *@
            @{
                var llmTel = LlmService.GetTelemetry();
                var statusClass = !_llmEnabled ? "off" : llmTel.LastProbeOk ? "online" : "error";
                var statusText  = !_llmEnabled ? "DISABLED"
                                 : llmTel.LastProbeOk ? "ACTIVE"
                                 : llmTel.LastProbeAt is not null ? "ERROR" : "PROBING";
            }
            <div class="@($"llm-hero llm-hero--{statusClass}")">
                <div class="llm-hero__icon"><DIcon Name="sparkle" Size="18" /></div>
                <div class="llm-hero__text">
                    <div class="llm-hero__title">@statusText · @(_llmProvider ?? "—") · @(_llmModel ?? "—")</div>
                    <div class="llm-hero__meta">
                        @QueueProc.QueueDepth in queue
                        @if (llmTel.CallCount > 0) { <span> · avg @llmTel.AverageLatencyMs ms/item</span> }
                        @if (QueueProc.HitCount + QueueProc.MissCount > 0)
                        {
                            <span> · @($"{QueueProc.HitRate:P1}") TMDB hit-rate</span>
                        }
                    </div>
                </div>
                <button type="button" class="llm-hero__btn" @onclick="CheckLlmAsync" disabled="@_llmChecking">
                    @(_llmChecking ? "Testing…" : "Test connection")
                </button>
            </div>

            @* Hint copy stays as a small block above the form. *@
            <div class="settings-subhead__hint settings-subhead__hint--top">@L["settings.llm_hint"]</div>

            @* Master enable toggle. *@
            <div class="settings-toggles">
                <label class="settings-toggle-row">
                    <Toggle Checked="_llmEnabled" CheckedChanged="@(v => _llmEnabled = v)" />
                    <span>@L["settings.llm_enabled_switch"]</span>
                </label>
            </div>

            @* 2-col grid of Field/Input pairs (screens.jsx::SettingsLLM 1559-1582):
               Provider | Model
               Base URL | API Key *@
            <div class="settings-fields-2col @(!_llmEnabled ? "settings-fields-2col--disabled" : "")">
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.llm_provider_label"]</span>
                    <select class="settings-field__select"
                            value="@_llmProvider"
                            disabled="@(!_llmEnabled)"
                            @onchange="@(e => _llmProvider = e.Value?.ToString() ?? "compatible")">
                        <option value="compatible">@L["settings.llm_provider_compatible"]</option>
                        <option value="openai">@L["settings.llm_provider_openai"]</option>
                    </select>
                    <span class="settings-field__hint">@L["settings.llm_provider_hint"]</span>
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.llm_model_label"]</span>
                    <input class="settings-field__input settings-field__input--mono"
                           placeholder="@(_llmProvider == "openai" ? "gpt-4o-mini" : "qwen2.5:1.5b")"
                           disabled="@(!_llmEnabled)"
                           value="@_llmModel"
                           @oninput="@(e => _llmModel = e.Value?.ToString() ?? "")" />
                    <span class="settings-field__hint">@L["settings.llm_model_hint"]</span>
                </label>
                @if (_llmProvider == "compatible")
                {
                    <label class="settings-field">
                        <span class="settings-field__label">@L["settings.llm_base_url_label"]</span>
                        <input class="settings-field__input settings-field__input--mono"
                               placeholder="@L["settings.llm_base_url_placeholder"]"
                               disabled="@(!_llmEnabled)"
                               value="@_llmBaseUrl"
                               @oninput="@(e => _llmBaseUrl = e.Value?.ToString() ?? "")" />
                        <span class="settings-field__hint">@L["settings.llm_base_url_hint"]</span>
                    </label>
                }
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.llm_api_key_label"]</span>
                    <input type="password"
                           class="settings-field__input settings-field__input--mono"
                           placeholder="@(_llmProvider == "openai" ? L["settings.llm_api_key_placeholder_openai"] : L["settings.llm_api_key_placeholder_local"])"
                           disabled="@(!_llmEnabled)"
                           value="@_llmApiKey"
                           @oninput="@(e => _llmApiKey = e.Value?.ToString() ?? "")" />
                    <span class="settings-field__hint">
                        @(_llmProvider == "openai" ? L["settings.llm_api_key_hint_openai"] : L["settings.llm_api_key_hint_local"])
                    </span>
                </label>
            </div>

            @* Confidence thresholds — auto-apply vs needs-review.
               Higher auto-apply → fewer false positives, more NeedsReview entries
               for the user to confirm manually. Lower needs-review → fewer Failed
               drops, more low-confidence guesses surfaced for review. *@
            <hr class="settings-divider" />
            <h4 class="settings-subhead">Match confidence</h4>
            <div class="settings-fields-stack">
                <label class="settings-field">
                    <span class="settings-field__label">
                        Auto-apply threshold · <span class="settings-field__inline-val">@(_autoApplyConf.ToString("P0", System.Globalization.CultureInfo.InvariantCulture))</span>
                    </span>
                    <input type="range" min="50" max="100" step="1"
                           value="@((int)Math.Round(_autoApplyConf * 100))"
                           @oninput="@(e => _autoApplyConf = (int.TryParse(e.Value?.ToString(), out var v) ? v : 95) / 100.0)" />
                    <span class="settings-field__hint">
                        At or above this score the LLM/source winner is silently saved as identified.
                        Below it lands in <strong>Needs Review</strong> with top-3 candidates.
                        Default 95%.
                    </span>
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">
                        Needs-review floor · <span class="settings-field__inline-val">@(_needsReviewConf.ToString("P0", System.Globalization.CultureInfo.InvariantCulture))</span>
                    </span>
                    <input type="range" min="10" max="90" step="1"
                           value="@((int)Math.Round(_needsReviewConf * 100))"
                           @oninput="@(e => _needsReviewConf = (int.TryParse(e.Value?.ToString(), out var v) ? v : 50) / 100.0)" />
                    <span class="settings-field__hint">
                        Below this floor the match is marked <strong>Failed</strong> (not surfaced in the NR modal).
                        Default 50%.
                    </span>
                </label>
            </div>

            @* Connection check row — ghost Btn + status text. *@
            <div class="llm-check">
                <Btn Variant="ghost"
                     Disabled="@(!_llmEnabled)"
                     Loading="@_llmChecking"
                     OnClick="CheckLlmAsync">
                    @L["settings.llm_btn_check"]
                </Btn>
                <span class="llm-check__status">
                    @L["settings.llm_status_label"]
                    @if (_llmChecking)
                    {
                        <span class="llm-check__status--probing">@L["settings.llm_status_checking"]</span>
                    }
                    else if (_llmStatus == true)
                    {
                        <span class="llm-check__status--ok">✓ @L["settings.llm_status_ok"]</span>
                    }
                    else if (_llmStatus == false)
                    {
                        <span class="llm-check__status--err">✗ @L["settings.llm_status_error"]</span>
                    }
                </span>
            </div>

            <div class="settings-actions">
                <Btn Variant="primary" OnClick="SaveAiSettingsAsync" Loading="@_llmSaving">
                    <DIcon Name="check" Size="13" /> @L["settings.btn_save_ai"]
                </Btn>
            </div>
        </div>
    }

</div>  @* settings-content *@
</div>

<!-- Add/Edit pattern dialog — native modal w/ scoped .pdlg-* styles. -->
@if (!_patternDialogHidden)
{
    <div class="pdlg-overlay" @onclick="@(() => _patternDialogHidden = true)"></div>
    <div class="pdlg" role="dialog" aria-modal="true">
        <header class="pdlg__header">
            <h4 class="pdlg__title">
                @(_patternEditTarget is null ? L["patterns.dialog_add_title"] : L["patterns.dialog_edit_title"])
            </h4>
            <button type="button" class="pdlg__close" @onclick="@(() => _patternDialogHidden = true)" aria-label="Close">
                <DIcon Name="x" Size="18" />
            </button>
        </header>
        <div class="pdlg__body">
            <div class="pdlg__form">
                <label class="settings-field">
                    <span class="settings-field__label">@L["patterns.field_name_label"]</span>
                    <input class="settings-field__input"
                           placeholder="@L["patterns.field_name_placeholder"]"
                           value="@_formName"
                           @oninput="@(e => _formName = e.Value?.ToString() ?? "")" />
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["patterns.field_regex_label"]</span>
                    <input class="settings-field__input settings-field__input--mono"
                           placeholder="@L["patterns.field_regex_placeholder"]"
                           value="@_formPattern"
                           @oninput="@(e => _formPattern = e.Value?.ToString() ?? "")" />
                </label>
                <label class="settings-field settings-field--160">
                    <span class="settings-field__label">@L["patterns.field_priority_label"]</span>
                    <input type="number" min="1" max="999"
                           class="settings-field__input settings-field__input--mono"
                           value="@_formPriority"
                           @oninput="@(e => _formPriority = int.TryParse(e.Value?.ToString(), out var v) ? v : _formPriority)" />
                </label>
                <label class="settings-field settings-field--240">
                    <span class="settings-field__label">@L["patterns.field_applicable_label"]</span>
                    <select class="settings-field__select"
                            value="@(_formApplicableTo?.ToString() ?? "")"
                            @onchange="@(e => _formApplicableTo = string.IsNullOrEmpty(e.Value?.ToString()) ? null : Enum.Parse<FolderType>(e.Value!.ToString()!))">
                        <option value="">@L["patterns.applicable_all"]</option>
                        <option value="Series">@L["patterns.applicable_series"]</option>
                        <option value="Movie">@L["patterns.applicable_movie"]</option>
                    </select>
                </label>
            </div>
        </div>
        <footer class="pdlg__footer">
            <Btn Variant="primary" OnClick="SavePattern"
                 Loading="@_patternSaving"
                 Disabled="@(string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formPattern))">
                @L["patterns.btn_save"]
            </Btn>
            <Btn Variant="flat" OnClick="@(() => _patternDialogHidden = true)">@L["patterns.btn_cancel"]</Btn>
        </footer>
    </div>
}

