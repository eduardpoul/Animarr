@* Phase 2.1: /folders/{id}/subfolders is deprecated — Explorer's drill-in
   already shows section children. Redirect to Explorer. *@
@page "/folders/{SectionId:guid}/subfolders"
@rendermode InteractiveServer
@inject NavigationManager Nav

@code {
    [Parameter] public Guid SectionId { get; set; }
    protected override void OnInitialized() => Nav.NavigateTo("/explorer", replace: true);
}
