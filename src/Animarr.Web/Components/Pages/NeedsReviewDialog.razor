@*
    NeedsReview modal — design Phase 5b.
    Spec: design_handoff_animarr/screens.jsx::NRModal (lines 172-262).

    720px wide centered modal with warn-accent header, candidate cards grid,
    "+ Search manually" dashed empty slot per folder. Uses MY own overlay so
    visual matches pixel-perfect (FluentDialog's chrome shows through).
*@

@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject MetadataService MetadataService
@inject IdentificationQueueProcessorService QueueProc
@inject IToastService Toast

@if (IsOpen)
{
    <div class="nrm-overlay" @onclick="OnCloseAsync"></div>
    <div class="nrm">
        <header class="nrm__header">
            <div class="nrm__header-icon"><DIcon Name="warn" Size="17" /></div>
            <div class="nrm__header-text">
                <div class="nrm__overline">NEEDS REVIEW</div>
                <h2 class="nrm__title">@_entries.Count TITLES BELOW CONFIDENCE</h2>
                <div class="nrm__sub">Pick the right match — Animarr stores it in SQLite, leaves folders on disk untouched.</div>
            </div>
            <button type="button" class="nrm__close" @onclick="OnCloseAsync" aria-label="Close">
                <DIcon Name="x" Size="18" />
            </button>
        </header>

        <div class="nrm__body">
            @if (_loading)
            {
                <div class="nrm__empty">Loading…</div>
            }
            else if (_entries.Count == 0)
            {
                <div class="nrm__empty">All items are identified.</div>
            }
            else
            {
                @foreach (var entry in _entries)
                {
                    <div class="nrm-row">
                        <div class="nrm-row__folder"><code>@entry.FolderLabel</code></div>
                        <div class="nrm-row__candidates">
                            @foreach (var c in entry.Candidates)
                            {
                                var key = $"{entry.FolderId}|{c.Source}|{c.Id}";
                                <div class="nrm-card">
                                    <div class="nrm-card__poster" style="--hue:@(c.Hue);">
                                        <span class="nrm-card__cjk">@c.Cjk</span>
                                    </div>
                                    <div class="nrm-card__body">
                                        <div>
                                            <div class="nrm-card__title">@c.Title</div>
                                            <div class="nrm-card__meta">@(c.Year?.ToString() ?? "—") · @c.Source.ToUpperInvariant()</div>
                                        </div>
                                        <div class="nrm-card__foot">
                                            <span class="@($"nrm-card__conf {(c.Score > 0.7 ? "nrm-card__conf--ok" : "nrm-card__conf--warn")}")">
                                                @($"{c.Score:P0}")
                                            </span>
                                            @* Spinner inline while ApplyAsync is in flight for this candidate.
                                               The existing _busyKey already tracks per-row state — same
                                               composite key (folder|source|id) so two folders with the same
                                               candidate ID don't accidentally share a loader.
                                               Spec: loaders.html §04. *@
                                            <button type="button"
                                                    class="@($"nrm-card__use {(_busyKey == key ? "nrm-card__use--loading" : "")}")"
                                                    disabled="@(_busyKey == key)"
                                                    @onclick="@(() => ApplyAsync(entry, c))">
                                                @if (_busyKey == key) { <Spinner Size="sm" Tone="light" /> }
                                                Use
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            <button type="button" class="nrm-search">
                                <DIcon Name="search" Size="13" /> SEARCH MANUALLY
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _loading = true;
    private string? _busyKey;
    private List<Entry> _entries = [];

    private sealed class Entry
    {
        public Guid FolderId { get; init; }
        public string FolderLabel { get; init; } = "";
        public List<CandidateRow> Candidates { get; init; } = [];
    }

    private sealed class CandidateRow
    {
        public string Source { get; init; } = "";
        public string Id     { get; init; } = "";
        public string Title  { get; init; } = "";
        public string? Cjk   { get; init; }
        public int?   Year   { get; init; }
        public double Score  { get; init; }
        public int    Hue    { get; init; }
    }

    protected override async Task OnInitializedAsync()
    {
        QueueProc.ItemIdentified += OnItemIdentified;
        if (IsOpen) await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && _entries.Count == 0 && !_loading) return; // already loaded
        if (IsOpen) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var items = await db.MediaItems
            .Include(m => m.Folder)
            .Where(m => m.IdentificationStatus == IdentificationStatus.NeedsReview
                     && !string.IsNullOrEmpty(m.CandidatesJson))
            .ToListAsync();

        _entries = items.Select(m => new Entry
        {
            FolderId    = m.FolderId,
            FolderLabel = m.Folder?.Label ?? m.Title,
            Candidates  = ParseCandidates(m.CandidatesJson!, m.Hue ?? 25),
        }).ToList();
        _loading = false;
        StateHasChanged();
    }

    private static List<CandidateRow> ParseCandidates(string json, int hue)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var list = new List<CandidateRow>();
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                list.Add(new CandidateRow
                {
                    Source = el.TryGetProperty("Source", out var s) ? s.GetString() ?? "" : "",
                    Id     = el.TryGetProperty("Id",     out var i) ? i.ToString() : "",
                    Title  = el.TryGetProperty("Title",  out var t) ? t.GetString() ?? "" : "",
                    Year   = el.TryGetProperty("Year",   out var y) && y.ValueKind != System.Text.Json.JsonValueKind.Null
                                ? y.GetInt32() : null,
                    Score  = el.TryGetProperty("Score",  out var sc) ? sc.GetDouble() : 0d,
                    Hue    = hue,
                });
            }
            return list;
        }
        catch { return []; }
    }

    private async Task ApplyAsync(Entry entry, CandidateRow cand)
    {
        _busyKey = $"{entry.FolderId}|{cand.Source}|{cand.Id}";
        StateHasChanged();
        try
        {
            if (int.TryParse(cand.Id, out var intId))
                await MetadataService.ApplyManualAsync(entry.FolderId, cand.Source, intId);
            else
                await MetadataService.ApplyManualAsync(entry.FolderId, cand.Source, cand.Id);
            Toast.ShowSuccess($"Applied {cand.Title}");
            await LoadAsync();
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { _busyKey = null; StateHasChanged(); }
    }

    private void OnItemIdentified(Guid _) => InvokeAsync(async () => { if (IsOpen) await LoadAsync(); });

    private async Task OnCloseAsync() => await OnClose.InvokeAsync();

    public void Dispose() { QueueProc.ItemIdentified -= OnItemIdentified; }
}
