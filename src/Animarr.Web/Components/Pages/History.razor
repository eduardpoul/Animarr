@*
    Thin route wrapper around HistoryView. The same view is mounted inside
    Settings → Rename history tab. Keep both /history and /renames URLs for
    deep links from earlier app versions.

    Header copy mirrors design_handoff_animarr/screens.jsx::HistoryScreen
    (overline JOURNAL / title RENAME HISTORY / sub) so a direct deep-link
    has the same chrome as the in-Settings tab.
*@
@page "/renames"
@page "/history"
@rendermode InteractiveServer

<PageTitle>Animarr — @L["history.title"]</PageTitle>

<header class="d-page-header">
    <div class="d-page-header__main">
        <div class="d-page-header__overline">JOURNAL</div>
        <h1 class="d-page-header__title">RENAME HISTORY</h1>
        <div class="d-page-header__sub">Every file rename, persisted in SQLite. One-click revert restores the original filename on disk. Folder names are never touched.</div>
    </div>
</header>

<HistoryKpiTiles />
<HistoryView />
