@page "/renames"
@page "/history"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IRenameService RenameService
@inject IToastService ToastService

<PageTitle>Animarr</PageTitle>

<FluentLabel Typo="Typography.H4" Style="margin-bottom:16px;">@L["history.title"]</FluentLabel>

<FluentTabs @bind-ActiveTabId="_activeTab" Style="margin-bottom:0;">
    <FluentTab Id="renames" Label="@L["history.tab_renames"]">
        <div style="padding-top:16px;">

        <FluentStack Orientation="Orientation.Horizontal" Style="margin-bottom:16px;gap:10px;flex-wrap:wrap;"
                     VerticalAlignment="VerticalAlignment.Bottom">
            <FluentSelect TOption="string" Value="@_filterFolder" ValueChanged="@(async (string v) => { _filterFolder = v; await OnFilterChangedAsync(); })" Label="@(L["history.filter_folder_label"])" Style="min-width:200px;">
                <FluentOption Value="">@L["history.filter_folder_all"]</FluentOption>
                @foreach (var f in _allFolders)
                {
                    <FluentOption Value="@f.Id.ToString()">@f.Label</FluentOption>
                }
            </FluentSelect>
            <FluentSelect TOption="string" Value="@_filterStatus" ValueChanged="@(async (string v) => { _filterStatus = v; await OnFilterChangedAsync(); })" Label="@(L["history.filter_status_label"])" Style="min-width:160px;">
                <FluentOption Value="">@L["history.filter_status_all"]</FluentOption>
                <FluentOption Value="Renamed">@L["history.status_renamed"]</FluentOption>
                <FluentOption Value="Skipped">@L["history.status_skipped"]</FluentOption>
                <FluentOption Value="Error">@L["history.status_error"]</FluentOption>
                <FluentOption Value="Reverted">@L["history.status_reverted"]</FluentOption>
            </FluentSelect>
            <FluentButton IconStart="@(new Icons.Regular.Size20.Dismiss())" Title="@L["history.btn_reset_filters"]" OnClick="ResetFilters" />
        </FluentStack>

        @if (_loading)
        {
            <div style="display:flex;justify-content:center;align-items:center;padding:80px 0;">
                <FluentProgressRing />
            </div>
        }
        else
        {
            <FluentDataGrid Items="@_pageItems.AsQueryable()" TGridItem="RenameHistory"
                            ShowHover="true"
                            RowSize="DataGridRowSize.Medium"
                            Style="font-size:13px;width:100%;">
                <TemplateColumn Title="@(L["history.col_date"])" Width="120px">
                    @context.ProcessedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")
                </TemplateColumn>
                <TemplateColumn Title="@(L["history.col_folder"])" Width="130px">
                    <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;" title="@(_allFolders.FirstOrDefault(f => f.Id == context.FolderId)?.Label ?? "—")">
                        @(_allFolders.FirstOrDefault(f => f.Id == context.FolderId)?.Label ?? "—")
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@(L["history.col_original_name"])">
                    <code style="font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;">@Path.GetFileName(context.OriginalPath)</code>
                </TemplateColumn>
                <TemplateColumn Title="" Width="28px" Align="Align.Center">
                    <span style="color:var(--neutral-foreground-hint);">→</span>
                </TemplateColumn>
                <TemplateColumn Title="@(L["history.col_new_name"])">
                    <code style="font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;">@Path.GetFileName(context.NewPath)</code>
                </TemplateColumn>
                <TemplateColumn Title="@(L["history.col_status"])" Width="110px">
                    <FluentBadge Appearance="@GetStatusAppearance(context.Status)">@GetStatusLabel(context.Status)</FluentBadge>
                </TemplateColumn>
                <TemplateColumn Title="" Width="52px" Align="Align.Center">
                    @if (context.Status == RenameStatus.Renamed && !context.IsReverted)
                    {
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size20.ArrowCounterclockwise())"
                                      Title="@(L["history.btn_revert"])"
                                      Style="margin-right:8px;"
                                      OnClick="@(() => AskRevert(context))" />
                    }
                </TemplateColumn>
            </FluentDataGrid>
            <div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:8px;font-size:13px;">
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size16.ChevronLeft())"
                              Disabled="@(_pageIndex == 0)"
                              OnClick="PrevPageAsync" />
                <span style="color:var(--neutral-foreground-hint);">
                    @(_totalCount == 0 ? 0 : _pageIndex * PageSize + 1)–@(Math.Min(_totalCount, (_pageIndex + 1) * PageSize)) / @_totalCount
                </span>
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size16.ChevronRight())"
                              Disabled="@((_pageIndex + 1) * PageSize >= _totalCount)"
                              OnClick="NextPageAsync" />
            </div>
        }
        </div>
    </FluentTab>

    <FluentTab Id="scanlogs" Label="@L["history.tab_scan_logs"]">
        <div style="padding-top:16px;">

        <FluentStack Orientation="Orientation.Horizontal" Style="margin-bottom:16px;gap:10px;flex-wrap:wrap;"
                     VerticalAlignment="VerticalAlignment.Bottom">
            <FluentSelect TOption="string" Value="@_scanFilterFolder" ValueChanged="@((string v) => { _scanFilterFolder = v; StateHasChanged(); })" Label="@(L["history.filter_folder_label"])" Style="min-width:200px;">
                <FluentOption Value="">@L["history.filter_folder_all"]</FluentOption>
                @foreach (var f in _allFolders)
                {
                    <FluentOption Value="@f.Id.ToString()">@f.Label</FluentOption>
                }
            </FluentSelect>
            <FluentSelect TOption="string" Value="@_scanFilterStatus" ValueChanged="@((string v) => { _scanFilterStatus = v; StateHasChanged(); })" Label="@(L["history.filter_status_label"])" Style="min-width:160px;">
                <FluentOption Value="">@L["history.filter_status_all"]</FluentOption>
                <FluentOption Value="Done">@L["history.scan_status_done"]</FluentOption>
                <FluentOption Value="Failed">@L["history.scan_status_failed"]</FluentOption>
                <FluentOption Value="Queued">@L["history.scan_status_queued"]</FluentOption>
                <FluentOption Value="Processing">@L["history.scan_status_processing"]</FluentOption>
            </FluentSelect>
            <FluentButton IconStart="@(new Icons.Regular.Size20.Dismiss())" Title="@L["history.btn_reset_filters"]" OnClick="ResetScanFilters" />
            <FluentButton IconStart="@(new Icons.Regular.Size20.ArrowSync())" Title="@L["history.btn_refresh"]" OnClick="LoadAsync" />
        </FluentStack>

        @if (_loading)
        {
            <div style="display:flex;justify-content:center;align-items:center;padding:80px 0;">
                <FluentProgressRing />
            </div>
        }
        else if (!FilteredScanJobs().Any())
        {
            <div style="text-align:center;padding:60px 0;color:var(--neutral-foreground-hint);">@L["history.scan_empty"]</div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:8px;">
                @foreach (var job in FilteredScanJobs())
                {
                    var folder = _allFolders.FirstOrDefault(f => f.Id == job.FolderId);
                    <div style="border-radius:8px;background:var(--neutral-layer-2);overflow:hidden;">
                        <!-- Header row -->
                        <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;cursor:pointer;"
                             @onclick="@(() => ToggleScanLog(job.Id))">
                            <FluentBadge Appearance="@ScanStatusAppearance(job.Status)" style="flex-shrink:0;">@ScanStatusLabel(job.Status)</FluentBadge>
                            <span style="flex:1;font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(folder?.Label ?? job.FolderId.ToString())
                            </span>
                            <span style="font-size:11px;color:var(--neutral-foreground-hint);flex-shrink:0;">
                                @((job.ProcessedAt ?? job.QueuedAt).ToLocalTime().ToString("dd.MM.yy HH:mm"))
                            </span>
                            @if (!string.IsNullOrEmpty(job.ErrorMessage))
                            {
                                <span style="font-size:11px;color:var(--error);margin-left:8px;flex-shrink:0;" title="@job.ErrorMessage">⚠ @job.ErrorMessage</span>
                            }
                            @{ Microsoft.FluentUI.AspNetCore.Components.Icon _chevron = _expandedScanIds.Contains(job.Id) ? (Microsoft.FluentUI.AspNetCore.Components.Icon)new Icons.Regular.Size16.ChevronUp() : new Icons.Regular.Size16.ChevronDown(); }
                            <FluentIcon Value="@_chevron" Style="flex-shrink:0;opacity:0.5;" />
                        </div>
                        <!-- Expandable log -->
                        @if (_expandedScanIds.Contains(job.Id) && !string.IsNullOrEmpty(job.LogDetails))
                        {
                            <div style="border-top:1px solid var(--neutral-stroke-rest);padding:10px 14px;">
                                <pre style="font-size:11px;font-family:monospace;white-space:pre-wrap;color:var(--neutral-foreground-rest);margin:0;line-height:1.5;">@job.LogDetails</pre>
                            </div>
                        }
                        else if (_expandedScanIds.Contains(job.Id))
                        {
                            <div style="border-top:1px solid var(--neutral-stroke-rest);padding:10px 14px;font-size:12px;color:var(--neutral-foreground-hint);">
                                @L["history.scan_no_log"]
                            </div>
                        }
                    </div>
                }
            </div>
        }
        </div>
    </FluentTab>
</FluentTabs>

<FluentDialog @bind-Hidden="_revertHidden" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H6">@L["history.revert_dialog_title"]</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentLabel>
            @L["history.revert_dialog_body"]<br />
            <b>@Path.GetFileName(_revertTarget?.NewPath ?? "")</b>
            &nbsp;→&nbsp;
            <b>@Path.GetFileName(_revertTarget?.OriginalPath ?? "")</b>
        </FluentLabel>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmRevert">@L["history.btn_revert_confirm"]</FluentButton>
        <FluentButton OnClick="@(() => _revertHidden = true)">@L["history.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private const int PageSize = 50;

    // H-6: server-side paginated history page.
    private List<RenameHistory> _pageItems = [];
    private int _pageIndex;
    private int _totalCount;

    private List<FolderWatcher> _allFolders = [];
    private List<IdentificationQueue> _scanJobs = [];
    private bool _loading = true;
    private string _filterFolder = "";
    private string _filterStatus = "";
    private string _scanFilterFolder = "";
    private string _scanFilterStatus = "";
    private string _activeTab = "renames";
    private HashSet<Guid> _expandedScanIds = [];

    private bool _revertHidden = true;
    private RenameHistory? _revertTarget;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _allFolders = await db.FolderWatchers.OrderBy(f => f.Label).ToListAsync();
        await LoadHistoryPageAsync(db);
        _scanJobs   = await db.IdentificationQueues
            .OrderByDescending(q => q.ProcessedAt ?? q.QueuedAt)
            .Take(200)
            .ToListAsync();
        StateHasChanged();
    }

    private async Task LoadHistoryPageAsync(AppDbContext db)
    {
        // Build the filter at the DB level so we don't load 10k rows into memory.
        IQueryable<RenameHistory> q = db.RenameHistories;
        if (!string.IsNullOrEmpty(_filterFolder) && Guid.TryParse(_filterFolder, out var fid))
            q = q.Where(h => h.FolderId == fid);
        if (!string.IsNullOrEmpty(_filterStatus) && Enum.TryParse<RenameStatus>(_filterStatus, out var st))
            q = q.Where(h => h.Status == st);

        _totalCount = await q.CountAsync();
        if (_pageIndex * PageSize >= _totalCount)
            _pageIndex = Math.Max(0, (_totalCount - 1) / PageSize);

        _pageItems = await q
            .OrderByDescending(h => h.ProcessedAt)
            .Skip(_pageIndex * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        _pageIndex = 0;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadHistoryPageAsync(db);
    }

    private async Task NextPageAsync()
    {
        if ((_pageIndex + 1) * PageSize >= _totalCount) return;
        _pageIndex++;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadHistoryPageAsync(db);
    }

    private async Task PrevPageAsync()
    {
        if (_pageIndex == 0) return;
        _pageIndex--;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadHistoryPageAsync(db);
    }

    private async Task ResetFilters()
    {
        _filterFolder = ""; _filterStatus = "";
        await OnFilterChangedAsync();
    }

    private void ResetScanFilters() { _scanFilterFolder = ""; _scanFilterStatus = ""; }

    private IEnumerable<IdentificationQueue> FilteredScanJobs()
    {
        var q = _scanJobs.AsEnumerable();
        if (!string.IsNullOrEmpty(_scanFilterFolder) && Guid.TryParse(_scanFilterFolder, out var fid))
            q = q.Where(j => j.FolderId == fid);
        if (!string.IsNullOrEmpty(_scanFilterStatus) && Enum.TryParse<IdentificationQueueStatus>(_scanFilterStatus, out var st))
            q = q.Where(j => j.Status == st);
        return q;
    }

    private void ToggleScanLog(Guid id)
    {
        if (!_expandedScanIds.Add(id))
            _expandedScanIds.Remove(id);
    }

    private void AskRevert(RenameHistory r) { _revertTarget = r; _revertHidden = false; }

    private async Task ConfirmRevert()
    {
        if (_revertTarget is null) return;
        var ok = await RenameService.RevertAsync(_revertTarget.Id);
        ToastService.ShowToast(ok ? ToastIntent.Success : ToastIntent.Error,
            ok ? L["history.toast_revert_ok"] : L["history.toast_revert_fail"]);
        _revertHidden = true;
        _revertTarget = null;
        await LoadAsync();
    }

    private string GetStatusLabel(RenameStatus s) => s switch
    {
        RenameStatus.Renamed  => L["history.status_renamed"],
        RenameStatus.Skipped  => L["history.status_skipped"],
        RenameStatus.Error    => L["history.status_error"],
        RenameStatus.Reverted => L["history.status_reverted"],
        _ => "—"
    };

    private static Appearance GetStatusAppearance(RenameStatus s) => s switch
    {
        RenameStatus.Renamed  => Appearance.Accent,
        _                     => Appearance.Neutral
    };

    private string ScanStatusLabel(IdentificationQueueStatus s) => s switch
    {
        IdentificationQueueStatus.Done       => L["history.scan_status_done"],
        IdentificationQueueStatus.Failed     => L["history.scan_status_failed"],
        IdentificationQueueStatus.Processing => L["history.scan_status_processing"],
        _                                    => L["history.scan_status_queued"],
    };

    private static Appearance ScanStatusAppearance(IdentificationQueueStatus s) => s switch
    {
        IdentificationQueueStatus.Done       => Appearance.Accent,
        IdentificationQueueStatus.Failed     => Appearance.Neutral,
        IdentificationQueueStatus.Processing => Appearance.Lightweight,
        _                                    => Appearance.Neutral,
    };
}
