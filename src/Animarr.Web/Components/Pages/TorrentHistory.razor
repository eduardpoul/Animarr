@page "/torrents/history"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TorrentEngineService TorrentEngine
@inject NavigationManager Nav

<PageTitle>Animarr</PageTitle>

<div class="th-header">
    <h1 class="th-header__title">@L["torrent_history.title"]</h1>
    <Btn Variant="ghost" Size="sm" OnClick="@(() => Nav.NavigateTo("/torrents"))">
        <DIcon Name="chev-l" Size="14" /> @L["torrent_history.back_link"]
    </Btn>
</div>

@if (_loading)
{
    @* Inline dots replace the old indeterminate progress bar while the
       initial DB query is in flight. Spec: loaders.html §06. *@
    <div class="th-loading">
        <InlineDots Label="Loading torrent history" />
    </div>
}
else if (_records.Count == 0)
{
    <div class="th-empty">@L["torrent_history.empty"]</div>
}
else
{
    var paged = _records.Skip(_pageIndex * _pageSize).Take(_pageSize).ToList();
    var pageCount = (int)Math.Ceiling(_records.Count / (double)_pageSize);
    <div class="th-table-wrap">
        <table class="th-table">
            <thead>
                <tr>
                    <th class="th-col-dot"></th>
                    <th>@L["torrent_history.col_name"]</th>
                    <th class="th-col-folder">@L["torrent_history.col_folder"]</th>
                    <th class="th-col-mono">@L["torrent_history.col_size"]</th>
                    <th class="th-col-mono">@L["torrent_history.col_speed"]</th>
                    <th class="th-col-date">@L["torrent_history.col_added"]</th>
                    <th class="th-col-date">@L["torrent_history.col_completed"]</th>
                    <th class="th-col-status">@L["torrent_history.col_status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in paged)
                {
                    <tr>
                        <td class="th-col-dot">
                            <span class="tor-dot tor-dot--@StateColorClass(r.State)" title="@r.State.ToString()"></span>
                        </td>
                        <td>@r.Name</td>
                        <td class="tor-cell tor-cell--dim" title="@r.SavePath">
                            @System.IO.Path.GetFileName(r.SavePath.TrimEnd('/', '\\'))
                        </td>
                        <td class="tor-cell tor-cell--mono">@FormatBytes(r.TotalSize)</td>
                        <td class="tor-cell tor-cell--mono">@FormatBytes(r.Downloaded) / @FormatBytes(r.Uploaded)</td>
                        <td class="tor-cell tor-cell--mono">@r.AddedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="tor-cell tor-cell--mono">
                            @(r.CompletedAt.HasValue ? r.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")
                        </td>
                        <td class="tor-cell">@StateLabel(r.State)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pageCount > 1)
    {
        <div class="th-paginator">
            <Btn Variant="ghost" Size="sm" Disabled="@(_pageIndex == 0)" OnClick="@(() => _pageIndex--)">
                <DIcon Name="chev-l" Size="13" />
            </Btn>
            <span class="th-paginator__label">@(_pageIndex + 1) / @pageCount</span>
            <Btn Variant="ghost" Size="sm" Disabled="@(_pageIndex >= pageCount - 1)" OnClick="@(() => _pageIndex++)">
                <DIcon Name="chev-r" Size="13" />
            </Btn>
        </div>
    }
}

@code {
    private List<TorrentRecord> _records = [];
    private bool _loading = true;
    private int _pageIndex;
    private const int _pageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _records = await db.TorrentRecords
            .Where(r => r.State != TorrentRecordState.Downloading &&
                        r.State != TorrentRecordState.Hashing)
            .OrderByDescending(r => r.AddedAt)
            .ToListAsync();
        _loading = false;
    }

    private static string StateColorClass(TorrentRecordState state) => state switch
    {
        TorrentRecordState.Seeding     => "success",
        TorrentRecordState.Stopped     => "neutral",
        TorrentRecordState.Error       => "error",
        TorrentRecordState.Hashing     => "warning",
        TorrentRecordState.Downloading => "info",
        _                              => "neutral",
    };

    private string StateLabel(TorrentRecordState state) => state switch
    {
        TorrentRecordState.Seeding     => L["torrent_history.state_seeding"],
        TorrentRecordState.Stopped     => L["torrent_history.state_stopped"],
        TorrentRecordState.Error       => L["torrent_history.state_error"],
        TorrentRecordState.Paused      => L["torrent_history.state_paused"],
        TorrentRecordState.Hashing     => L["torrent_history.state_hashing"],
        TorrentRecordState.Downloading => L["torrent_history.state_downloading"],
        _                              => state.ToString(),
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F2} GB";
        if (bytes >= 1_048_576)     return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024)          return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }
}
