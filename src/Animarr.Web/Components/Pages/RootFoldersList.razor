@*
    Settings → Root folders list.
    Spec: design_handoff_animarr/screens.jsx::SettingsFolders (lines 1334-1380).
    Each row: 44x44 thumb with hue gradient · title + path · status pills · Rescan · edit/trash.

    Edit and Delete are NOT navigations — they raise events up to the parent
    (Settings.razor) which opens inline dialogs.
*@

@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IToastService Toast
@inject NavigationManager Nav
@inject MetadataService MetadataService
@inject FolderWatcherService WatcherService

@if (_loading)
{
    <div class="rfl-empty">Loading…</div>
}
else if (_sections.Count == 0)
{
    <div class="rfl-empty">No section folders yet. Click <strong>Add section folder</strong> to point Animarr at a directory.</div>
}
else
{
    <div class="rfl">
        @foreach (var s in _sections)
        {
            var hue     = s.Section.Hue ?? 25;
            var section = s.Section;
            <div class="rfl-row">
                <div class="rfl-row__thumb" style="--hue:@hue;">
                    <DIcon Name="folder" Size="14" />
                </div>
                <div class="rfl-row__text">
                    <div class="rfl-row__title">@section.Label</div>
                    <div class="rfl-row__path">@section.Path</div>
                </div>
                <div class="rfl-row__pills">
                    <span class="rfl-pill">@s.Watchers w</span>
                    <span class="rfl-pill rfl-pill--success">@s.Identified ID</span>
                    @if (s.Missing > 0)
                    {
                        <span class="rfl-pill rfl-pill--warn">@s.Missing ?</span>
                    }
                </div>
                <button type="button" class="rfl-btn" @onclick="@(() => RescanAsync(section.Id))">
                    <DIcon Name="refresh" Size="13" /> Rescan
                </button>
                <div class="rfl-row__icons">
                    <button type="button" class="rfl-icon" title="Edit" @onclick="@(() => OnEdit.InvokeAsync(section))">
                        <DIcon Name="pencil" Size="14" />
                    </button>
                    <button type="button" class="rfl-icon rfl-icon--danger" title="Remove" @onclick="@(() => OnDelete.InvokeAsync(section))">
                        <DIcon Name="trash" Size="14" />
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// Bumping this from the parent (e.g. after Save/Delete) forces a reload of the section list.
    /// </summary>
    [Parameter] public int ReloadToken { get; set; }
    [Parameter] public EventCallback<FolderWatcher> OnEdit { get; set; }
    [Parameter] public EventCallback<FolderWatcher> OnDelete { get; set; }

    private bool _loading = true;
    private List<SectionStat> _sections = [];
    private int _lastReloadToken = -1;

    private sealed class SectionStat
    {
        public FolderWatcher Section { get; init; } = null!;
        public int Watchers { get; init; }
        public int Identified { get; init; }
        public int Missing { get; init; }
    }

    protected override async Task OnInitializedAsync()
    {
        MetadataService.MediaItemChanged += OnChanged;
        await LoadAsync();
        _lastReloadToken = ReloadToken;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ReloadToken != _lastReloadToken)
        {
            _lastReloadToken = ReloadToken;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var sections = await db.FolderWatchers
            .Where(f => f.IsSection)
            .OrderBy(f => f.Label)
            .ToListAsync();

        var stats = new List<SectionStat>();
        foreach (var s in sections)
        {
            var children = await db.FolderWatchers
                .Where(f => f.ParentSectionId == s.Id)
                .Select(f => new { f.Id })
                .ToListAsync();
            var childIds = children.Select(c => c.Id).ToList();
            var items = await db.MediaItems
                .Where(m => childIds.Contains(m.FolderId))
                .Select(m => m.IdentificationStatus)
                .ToListAsync();
            var ident   = items.Count(st => st is IdentificationStatus.Identified or IdentificationStatus.Manual);
            var missing = items.Count(st => st is IdentificationStatus.NeedsReview or IdentificationStatus.Failed);
            stats.Add(new SectionStat
            {
                Section    = s,
                Watchers   = children.Count,
                Identified = ident,
                Missing    = missing,
            });
        }
        _sections = stats;
        _loading = false;
        StateHasChanged();
    }

    private async Task RescanAsync(Guid sectionId)
    {
        // Discover any new subfolders first — covers dirs that appeared while
        // the app was down OR that were already there when the section was
        // added (the FSW only fires for dirs created AFTER it starts). Without
        // this, an "empty" section would queue 0 and the toast would mislead.
        int newlyDiscovered = 0;
        try
        {
            var discovered = await WatcherService.DiscoverChildrenAsync(sectionId);
            newlyDiscovered = discovered.Count;
        }
        catch { /* best-effort */ }

        await using var db = await DbFactory.CreateDbContextAsync();
        var childIds = await db.FolderWatchers
            .Where(f => f.ParentSectionId == sectionId && f.IdentifyEnabled)
            .Select(f => f.Id)
            .ToListAsync();
        int queued = 0;
        foreach (var fid in childIds)
        {
            if (await db.IdentificationQueues.AnyAsync(q =>
                q.FolderId == fid &&
                (q.Status == IdentificationQueueStatus.Queued || q.Status == IdentificationQueueStatus.Processing)))
                continue;
            db.IdentificationQueues.Add(new IdentificationQueue
            {
                Id = Guid.NewGuid(),
                FolderId = fid,
                ForceRefresh = true,
                Status = IdentificationQueueStatus.Queued,
                QueuedAt = DateTime.UtcNow,
            });
            queued++;
        }
        await db.SaveChangesAsync();
        Toast.ShowInfo(newlyDiscovered > 0
            ? $"Discovered {newlyDiscovered} new folder(s); queued {queued} for rescan."
            : $"Queued {queued} folder(s) for rescan.");
        await LoadAsync();
    }

    private void OnChanged(Guid _) => InvokeAsync(LoadAsync);

    public void Dispose() { MetadataService.MediaItemChanged -= OnChanged; }
}
