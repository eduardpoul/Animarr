@page "/torrents"
@rendermode InteractiveServer
@implements IDisposable
@using MonoTorrent
@using MonoTorrent.Client
@inject TorrentEngineService TorrentEngine
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IToastService ToastService
@inject NavigationManager Nav

<PageTitle>Animarr</PageTitle>

@{
    // Header counters/overline read off the same snapshot used by the grid so
    // the "N ACTIVE" overline can never disagree with the row count.
    var totalDn = _torrentSnapshot.Sum(t => t.DownloadRate) / 1024d / 1024d;
    var totalUp = _torrentSnapshot.Sum(t => t.UploadRate)   / 1024d / 1024d;
    var activeN = _torrentSnapshot.Count(t => t.State == TorrentState.Downloading);
}

<div class="d-page-header">
    <div class="d-page-header__main">
        <div class="d-page-header__overline">LIVE · @activeN ACTIVE</div>
        <h1 class="d-page-header__title">@L["torrents.title"]</h1>
        <div class="d-page-header__sub">Per-file priority, per-torrent speed caps in Mbps, auto-rename after download via global patterns. Updates over SignalR — no refresh.</div>
    </div>

    @* Right slot: boxed DOWN/UP stats widget + Add CTA. Design
       components.jsx::TorrentsScreen lines 922-935 — display font for the
       value, accent for DOWN, success for UP. *@
    <div class="d-page-header__right">
        <div class="torrents-stats">
            <div class="torrents-stats__cell">
                <div class="torrents-stats__cell-label">DOWN</div>
                <div class="torrents-stats__cell-val torrents-stats__cell-val--dn">
                    @($"{totalDn:F1}") <span class="torrents-stats__cell-unit">MB/s</span>
                </div>
            </div>
            <div class="torrents-stats__cell">
                <div class="torrents-stats__cell-label">UP</div>
                <div class="torrents-stats__cell-val torrents-stats__cell-val--up">
                    @($"{totalUp:F1}") <span class="torrents-stats__cell-unit">MB/s</span>
                </div>
            </div>
        </div>

        <Btn Variant="primary" Size="md"
             OnClick="@(() => { _addPanelOpen = true; _detailsPanelOpen = false; _detailsHash = null; })">
            <DIcon Name="plus" Size="14" /> @L["torrents.add_button"]
        </Btn>
    </div>
</div>

@{
    var tabItems = new List<Tabs<string>.TabItem>
    {
        new("active",  L["torrents.tab_active"]),
        new("history", L["torrents.tab_history"]),
    };
}
<Tabs T="string"
      Items="@tabItems"
      SelectedValue="@_activeTabId"
      SelectedValueChanged="@OnTabIdChanged"
      Mode="segmented" />

@if (_activeTabId == "active")
{
    // M-14: snapshot taken once per render — avoids a fresh GetAll() materialization on every grid cell.
    var torrents = _torrentSnapshot;

    @if (!_initialLoadComplete)
    {
        @* First TorrentEngine.GetAll() hasn't returned yet — show the
           three-dot inline loader instead of the "no torrents" empty copy
           so the user doesn't briefly see "empty" before live data arrives.
           Spec: loaders.html §06. *@
        <div class="torrents-loading">
            <InlineDots Label="Loading torrents from session" />
        </div>
    }
    else if (torrents.Count == 0)
    {
        <div class="torrents-empty">@L["torrents.empty"]</div>
    }
    else
    {
        <div class="torrents-grid-wrap">
            <table class="tor-table">
                <thead>
                    <tr>
                        <th class="tor-col-dot"></th>
                        <th>@L["torrents.col_name"]</th>
                        <th class="tor-col-folder">@L["torrents.col_folder"]</th>
                        <th class="tor-col-progress">@L["torrents.col_progress"]</th>
                        <th class="tor-col-speed">@L["torrents.col_speed"]</th>
                        <th class="tor-col-size">@L["torrents.col_size"]</th>
                        <th class="tor-col-peers">@L["torrents.col_peers"]</th>
                        <th class="tor-col-eta">@L["torrents.col_eta"]</th>
                        <th class="tor-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in torrents)
                    {
                        var ctx   = t;
                        var blink = ctx.State == TorrentState.Downloading;
                        <tr>
                            <td class="tor-col-dot">
                                <span class="tor-dot tor-dot--@StatusColorClass(ctx) @(blink ? "tor-dot--blink" : "")"
                                      title="@ctx.State.ToString()"></span>
                            </td>
                            <td>
                                <div class="tor-name">
                                    <span class="tor-name__text">@ctx.Name</span>
                                    @if (ctx.State == TorrentState.Metadata)
                                    {
                                        <span class="tor-name__hint">@L["torrents.state_loading_metadata"]</span>
                                    }
                                </div>
                            </td>
                            <td class="tor-cell tor-cell--dim" title="@ctx.SavePath">
                                @System.IO.Path.GetFileName(ctx.SavePath.TrimEnd('/', '\\'))
                            </td>
                            <td>
                                @if (ctx.State == TorrentState.Hashing)
                                {
                                    <div class="animarr-progress">
                                        <div class="animarr-progress__track">
                                            <div class="animarr-progress__fill animarr-progress__fill--indeterminate"></div>
                                        </div>
                                        <span class="animarr-progress__label">@L["torrents.state_hashing"]</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="animarr-progress tor-progress tor-progress--@StatusColorClass(ctx)">
                                        <div class="animarr-progress__track">
                                            <div class="animarr-progress__fill"
                                                 style="width:@(ctx.Progress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                        </div>
                                        <span class="animarr-progress__label">@ctx.Progress.ToString("F1")%</span>
                                    </div>
                                }
                            </td>
                            <td class="tor-cell tor-cell--mono">@FormatSpeed(ctx.DownloadRate) / @FormatSpeed(ctx.UploadRate)</td>
                            <td class="tor-cell tor-cell--mono">@FormatBytesPair(ctx.Downloaded, ctx.TotalSize)</td>
                            <td class="tor-cell tor-cell--mono">@ctx.Seeds+@ctx.Peers</td>
                            <td class="tor-cell tor-cell--mono tor-cell--dim">@FormatEta(ctx)</td>
                            <td class="tor-col-actions">
                                <div class="tor-actions">
                                    <button type="button" class="tor-iconbtn"
                                            title="@(L["torrents.btn_edit"])"
                                            @onclick="@(() => OpenDetails(ctx.InfoHash))">
                                        <DIcon Name="pencil" Size="14" />
                                    </button>
                                    @if (ctx.State == TorrentState.Downloading || ctx.State == TorrentState.Metadata || ctx.State == TorrentState.Seeding)
                                    {
                                        <button type="button" class="tor-iconbtn"
                                                title="@(L["torrents.btn_pause"])"
                                                @onclick="@(() => PauseAsync(ctx.InfoHash))">
                                            <DIcon Name="pause" Size="14" />
                                        </button>
                                    }
                                    else if (ctx.State == TorrentState.Paused || ctx.State == TorrentState.Stopped)
                                    {
                                        <button type="button" class="tor-iconbtn"
                                                title="@(L["torrents.btn_resume"])"
                                                @onclick="@(() => ResumeAsync(ctx.InfoHash))">
                                            <DIcon Name="play" Size="14" />
                                        </button>
                                    }
                                    @if (ctx.State != TorrentState.Stopped)
                                    {
                                        <button type="button" class="tor-iconbtn"
                                                title="@(L["torrents.btn_stop"])"
                                                @onclick="@(() => StopAsync(ctx.InfoHash))">
                                            <DIcon Name="x" Size="14" />
                                        </button>
                                    }
                                    <button type="button" class="tor-iconbtn tor-iconbtn--danger"
                                            title="@(L["torrents.btn_delete"])"
                                            @onclick="@(() => AskDelete(ctx.InfoHash, ctx.Name))">
                                        <DIcon Name="trash" Size="14" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_activeTabId == "history")
{
    @if (_historyLoading)
    {
        <div class="torrents-history__loading">
            <div class="animarr-progress" style="width:240px;">
                <div class="animarr-progress__track">
                    <div class="animarr-progress__fill animarr-progress__fill--indeterminate"></div>
                </div>
            </div>
        </div>
    }
    else if (_historyRecords.Count == 0)
    {
        <div class="torrents-empty">@L["torrent_history.empty"]</div>
    }
    else
    {
        var paged = _historyRecords.Skip(_historyPageIndex * _historyPageSize).Take(_historyPageSize).ToList();
        var pageCount = (int)Math.Ceiling(_historyRecords.Count / (double)_historyPageSize);
        <div class="torrents-grid-wrap">
            <table class="tor-table">
                <thead>
                    <tr>
                        <th class="tor-col-dot"></th>
                        <th>@L["torrent_history.col_name"]</th>
                        <th class="tor-col-folder">@L["torrent_history.col_folder"]</th>
                        <th class="tor-col-mono">@L["torrent_history.col_size"]</th>
                        <th class="tor-col-mono">@L["torrent_history.col_speed"]</th>
                        <th class="tor-col-date">@L["torrent_history.col_added"]</th>
                        <th class="tor-col-date">@L["torrent_history.col_completed"]</th>
                        <th class="tor-col-status">@L["torrent_history.col_status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ctx in paged)
                    {
                        <tr>
                            <td class="tor-col-dot">
                                <span class="tor-dot tor-dot--@HistoryStateColorClass(ctx.State)"
                                      title="@ctx.State.ToString()"></span>
                            </td>
                            <td>@ctx.Name</td>
                            <td class="tor-cell tor-cell--dim" title="@ctx.SavePath">
                                @System.IO.Path.GetFileName(ctx.SavePath.TrimEnd('/', '\\'))
                            </td>
                            <td class="tor-cell tor-cell--mono">@FormatBytes(ctx.TotalSize)</td>
                            <td class="tor-cell tor-cell--mono">@FormatBytes(ctx.Downloaded) / @FormatBytes(ctx.Uploaded)</td>
                            <td class="tor-cell tor-cell--mono">@ctx.AddedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="tor-cell tor-cell--mono">
                                @(ctx.CompletedAt.HasValue ? ctx.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")
                            </td>
                            <td class="tor-cell">@HistoryStateLabel(ctx.State)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (pageCount > 1)
        {
            <div class="tor-paginator">
                <Btn Variant="ghost" Size="sm" Disabled="@(_historyPageIndex == 0)" OnClick="@(() => _historyPageIndex--)">
                    <DIcon Name="chev-l" Size="13" />
                </Btn>
                <span class="tor-paginator__label">@(_historyPageIndex + 1) / @pageCount</span>
                <Btn Variant="ghost" Size="sm" Disabled="@(_historyPageIndex >= pageCount - 1)" OnClick="@(() => _historyPageIndex++)">
                    <DIcon Name="chev-r" Size="13" />
                </Btn>
            </div>
        }
    }
}

<!-- =================== ADD TORRENT DRAWER (design page 11) ============== -->
@if (_addPanelOpen)
{
<div class="add-drawer__backdrop" @onclick="CloseAddPanel"></div>
<div class="add-drawer">
    <div class="add-drawer__header">
        <div class="add-drawer__head-text">
            <div class="add-drawer__overline">NEW</div>
            <h2 class="add-drawer__title">ADD TORRENT</h2>
        </div>
        <button type="button" class="add-drawer__close" @onclick="CloseAddPanel" title="Close">
            <DIcon Name="x" Size="18" />
        </button>
    </div>
    <div class="add-drawer__body">

        @* Source-type segmented toggle: File vs Magnet. Default is File — most users
           drop a .torrent from their browser's Downloads folder; the magnet
           tab is the secondary path. Switching wipes the other input so we
           don't accidentally have both filled at the same time. Design uses
           a 2-col grid segmented control with icons rather than radio dots. *@
        <div class="add-source-toggle" role="tablist" aria-label="Source type">
            <button type="button" role="tab"
                    aria-selected="@(_addSourceType == "file")"
                    class="@($"add-source-toggle__btn {(_addSourceType == "file" ? "add-source-toggle__btn--active" : "")}")"
                    @onclick="@(() => SwitchAddSource("file"))">
                <DIcon Name="file" Size="13" /> @L["add_torrent.source_file"]
            </button>
            <button type="button" role="tab"
                    aria-selected="@(_addSourceType == "magnet")"
                    class="@($"add-source-toggle__btn {(_addSourceType == "magnet" ? "add-source-toggle__btn--active" : "")}")"
                    @onclick="@(() => SwitchAddSource("magnet"))">
                <DIcon Name="link" Size="13" /> @L["add_torrent.source_magnet"]
            </button>
        </div>

        @if (_addSourceType == "magnet")
        {
            <label class="add-field">
                <span class="add-field__label">@L["add_torrent.magnet_label"]</span>
                <Input Value="@_addMagnet"
                       ValueChanged="@(async (string? v) => { _addMagnet = v ?? string.Empty; await OnMagnetChangedAsync(); })"
                       Placeholder="@(L["add_torrent.magnet_placeholder"])" />
            </label>
        }
        else
        {
            @* Design uses a dashed-border drop zone. We still trigger via the
               hidden InputFile since Blazor InteractiveServer can't read
               drag-dropped files without OnInputFileChange wired through. *@
            <div class="add-dropzone">
                <InputFile id="torrentFileInput" OnChange="OnTorrentFileSelected" accept=".torrent" class="add-dropzone__input" />
                <label for="torrentFileInput" class="add-dropzone__label">
                    <DIcon Name="upload" Size="20" />
                    <span class="add-dropzone__primary">
                        @L["add_torrent.torrent_file_label"]
                        <span class="add-dropzone__link">@L["add_torrent.select_file_button"]</span>
                    </span>
                    @if (_torrentFileName is not null)
                    {
                        <span class="add-dropzone__loaded" title="@_torrentFileName">
                            <DIcon Name="check" Size="11" /> @_torrentFileName
                        </span>
                    }
                </label>
            </div>
        }

        @if (!string.IsNullOrEmpty(_suggestedMatch))
        {
            <div class="add-suggest">
                <DIcon Name="sparkle" Size="14" />
                <span class="add-suggest__text">@L.Get("add_torrent.suggested_match", _suggestedMatch)</span>
                <button type="button" class="add-suggest__dismiss"
                        @onclick="@(() => { _suggestedMatch = null; _addFolderWatcherId = null; _addFolderStr = ""; })"
                        title="Dismiss">
                    <DIcon Name="x" Size="12" />
                </button>
            </div>
        }

        @if (_addFileEntries.Count > 0)
        {
            <div class="add-files">
                <div class="add-files__header">
                    <input type="checkbox"
                           class="add-files__select-all"
                           checked="@(_addFilePriorities.Count > 0 && _addFilePriorities.Values.All(v => v > 0))"
                           @onchange="@(e => { bool chk = (bool)e.Value!; foreach (var k in _addFilePriorities.Keys.ToList()) _addFilePriorities[k] = chk ? 4 : 0; StateHasChanged(); })" />
                    <span class="add-files__heading">@L.Get("add_torrent.files_label", _addFileEntries.Count)</span>
                </div>
                <div class="add-files__list">
                    @foreach (var item in _addFlatTree)
                    {
                        @if (IsItemVisible(item))
                        {
                        @if (item.IsFolder)
                        {
                            var fp = item.FullPath!;
                            var collapsed = _collapsedFolders.Contains(fp);
                            var folderChecked = IsFolderChecked(fp);
                            <div class="add-files__folder"
                                 style="--depth:@(item.Depth)"
                                 @onclick="@(() => ToggleFolderCollapse(fp))">
                                <span class="add-files__chev">@(collapsed ? "▶" : "▼")</span>
                                <input type="checkbox" checked="@folderChecked"
                                       @onclick:stopPropagation
                                       @onchange="@(e => ToggleFolderCheck(fp))" />
                                <DIcon Name="folder" Size="13" />
                                <span class="add-files__folder-name">@item.Name</span>
                            </div>
                        }
                        else
                        {
                            var fp = item.FullPath!;
                            var prio = _addFilePriorities.GetValueOrDefault(fp, 4);
                            <div class="add-files__file" style="--depth:@(item.Depth)">
                                <input type="checkbox" checked="@(prio != 0)"
                                       @onchange="@(e => { bool chk = (bool)e.Value!; _addFilePriorities[fp] = chk ? 4 : 0; StateHasChanged(); })" />
                                <DIcon Name="video" Size="13" />
                                <span class="add-files__file-name" title="@fp">@item.Name</span>
                                <span class="add-files__file-size">@FormatBytes(item.Length)</span>
                                <select class="add-files__priority @(prio == 0 ? "add-files__priority--skip" : "")"
                                        value="@prio"
                                        @onchange="@(e => _addFilePriorities[fp] = int.Parse(e.Value!.ToString()!))">
                                    <option value="0">@L["file_priority.skip"]</option>
                                    <option value="2">@L["file_priority.low"]</option>
                                    <option value="4">@L["file_priority.normal"]</option>
                                    <option value="6">@L["file_priority.high"]</option>
                                </select>
                            </div>
                        }
                        }
                    }
                </div>
            </div>
        }

        <label class="add-field">
            <span class="add-field__label">@L["add_torrent.folder_label"]</span>
            <div class="add-field__row">
                @* Phase 3.1 MVP: native <select> grouped by section so the user
                   sees library structure (Anime → Cowboy Bebop, etc.) instead of
                   a flat alphabetical dropdown. Keeps autocomplete via browser. *@
                <select class="add-select"
                        value="@_addFolderStr"
                        @onchange="@(e => OnFolderPicked(e.Value?.ToString() ?? ""))">
                    <option value="">@L["add_torrent.folder_placeholder"]</option>
                    @foreach (var grp in _foldersBySection)
                    {
                        @* Each optgroup gets two kinds of entries:
                           1. The section ROOT itself (first option) — for dropping
                              a torrent straight into e.g. /Pool-D1/Media/Movies
                              without picking a specific identified title.
                           2. Child folders — one per already-identified title.
                           Section header keeps the disk label (sections aren't
                           identified — they're library roots). Children render
                           via DisplayFor: user-customised Label wins over the
                           auto-identified MediaItem.Title. *@
                        @if (grp.Section is not null)
                        {
                            <optgroup label="@grp.Section.Label">
                                <option value="@grp.Section.Id">— @grp.Section.Label (section root) —</option>
                                @foreach (var f in grp.Children)
                                {
                                    <option value="@f.Id">@DisplayFor(f)</option>
                                }
                            </optgroup>
                        }
                        else
                        {
                            @foreach (var f in grp.Children)
                            {
                                <option value="@f.Id">@DisplayFor(f)</option>
                            }
                        }
                    }
                </select>
                <Btn Variant="solid" Size="md"
                     OnClick="@(() => { _createSubfolderMode = !_createSubfolderMode; _newSubfolderName = string.Empty; })"
                     title="@(L["add_torrent.create_subfolder_title"])">
                    <DIcon Name="plus" Size="13" /> Subfolder
                </Btn>
            </div>
            @if (_createSubfolderMode)
            {
                var baseFolder = _folders.FirstOrDefault(f => f.Id == _addFolderWatcherId);
                <div class="add-subfolder">
                    @if (baseFolder is not null)
                    {
                        <span class="add-subfolder__prefix" title="@baseFolder.Path">@baseFolder.Path /</span>
                        <input type="text" class="add-subfolder__input"
                               value="@_newSubfolderName"
                               @onchange="@(e => _newSubfolderName = e.Value?.ToString() ?? string.Empty)"
                               placeholder="@(L["add_torrent.subfolder_placeholder"])" />
                        <Btn Variant="primary" Size="sm"
                             Disabled="@string.IsNullOrWhiteSpace(_newSubfolderName)"
                             OnClick="@(() => { _addCustomPath = System.IO.Path.Combine(baseFolder.Path, _newSubfolderName.Trim()); _createSubfolderMode = false; })">
                            <DIcon Name="check" Size="12" />
                        </Btn>
                    }
                    else
                    {
                        <input type="text" class="add-subfolder__input"
                               value="@_addCustomPath"
                               @onchange="@(e => _addCustomPath = e.Value?.ToString() ?? string.Empty)"
                               placeholder="/mnt/media/MyShow" />
                        <Btn Variant="primary" Size="sm"
                             Disabled="@string.IsNullOrWhiteSpace(_addCustomPath)"
                             OnClick="@(() => { _createSubfolderMode = false; })">
                            <DIcon Name="check" Size="12" />
                        </Btn>
                    }
                    <Btn Variant="ghost" Size="sm" OnClick="@(() => { _createSubfolderMode = false; _newSubfolderName = string.Empty; })">
                        <DIcon Name="x" Size="12" />
                    </Btn>
                </div>
                @if (!string.IsNullOrWhiteSpace(_addCustomPath))
                {
                    <div class="add-subfolder__preview">→ @_addCustomPath</div>
                }
            }
        </label>

        <label class="add-field">
            <span class="add-field__label">@L["add_torrent.custom_path_label"]</span>
            <Input Value="@_addCustomPath"
                   ValueChanged="@(v => _addCustomPath = v ?? string.Empty)"
                   Placeholder="@(L["add_torrent.custom_path_placeholder"])" />
        </label>

        <div class="add-field-pair">
            <label class="add-field">
                <span class="add-field__label">@L["add_torrent.dl_limit_label"]</span>
                <input type="number" class="add-input add-input--mono" min="0"
                       value="@_addDlLimit"
                       @onchange="@(e => int.TryParse(e.Value?.ToString(), out _addDlLimit))" />
            </label>
            <label class="add-field">
                <span class="add-field__label">@L["add_torrent.ul_limit_label"]</span>
                <input type="number" class="add-input add-input--mono" min="0"
                       value="@_addUlLimit"
                       @onchange="@(e => int.TryParse(e.Value?.ToString(), out _addUlLimit))" />
            </label>
        </div>

        @* Toggle rows — design 11 spec ToggleRow component. Toggle on left,
           dim label on right. Flatten subfolders only surfaces when the
           torrent actually has nested paths (no point if it's a single file).
           Outer wrapper is a <div> rather than a <label> because the Toggle
           primitive itself renders a <label>, and nested labels are invalid
           HTML and break native click-to-toggle. *@
        <div class="add-toggles">
            <div class="add-toggle-row">
                <Toggle Checked="@_addStartPaused"
                        CheckedChanged="@((bool v) => _addStartPaused = v)" />
                <span class="add-toggle-row__label">@L["add_torrent.start_paused"]</span>
            </div>
            <div class="add-toggle-row">
                <Toggle Checked="@_addStopAfterDownload"
                        CheckedChanged="@((bool v) => _addStopAfterDownload = v)" />
                <span class="add-toggle-row__label">@L["add_torrent.stop_after_download"]</span>
            </div>
            @if (_addFileEntries.Any(f => f.Path.Contains('/') || f.Path.Contains('\\')))
            {
                <div class="add-toggle-row">
                    <Toggle Checked="@_addSkipSubfolderStructure"
                            CheckedChanged="@((bool v) => _addSkipSubfolderStructure = v)" />
                    <span class="add-toggle-row__label">@L["add_torrent.flatten_subfolders"]</span>
                </div>
            }

            @{
                // MonoTorrent always creates a root folder from torrent.Name for multi-file torrents.
                // ParseTorrentFilesAsync returns paths without the info.name prefix, so we detect
                // the root folder by: multiple files (always get a root folder) OR a file in a subdir.
                var torrentHasRootFolder = _torrentFileBytes is not null
                    && _addFileEntries.Count > 0
                    && (_addFileEntries.Count > 1
                        || _addFileEntries.Any(f => f.Path.Contains('/') || f.Path.Contains('\\')));
            }
            @if (torrentHasRootFolder)
            {
                <div class="add-toggle-row">
                    <Toggle Checked="@_addSuppressRootFolder"
                            CheckedChanged="@((bool v) => { _addSuppressRootFolder = v; if (v) _addCustomRootFolderName = string.Empty; })" />
                    <span class="add-toggle-row__label">@L["add_torrent.suppress_root_folder"]</span>
                </div>
                @if (!_addSuppressRootFolder)
                {
                    <div class="add-field add-field--nested">
                        <span class="add-field__label">@L["add_torrent.custom_root_folder_label"]</span>
                        <Input Value="@_addCustomRootFolderName"
                               ValueChanged="@(v => _addCustomRootFolderName = v ?? string.Empty)"
                               Placeholder="@(L["add_torrent.custom_root_folder_placeholder"])" />
                    </div>
                }
            }
        </div>

        @if (_addFolderWatcherId.HasValue)
        {
            var selFolder = _folders.FirstOrDefault(f => f.Id == _addFolderWatcherId);
            if (selFolder is not null)
            {
                <div class="add-hint">
                    @(selFolder.RenameEnabled ? L["add_torrent.auto_rename_enabled"] : L["add_torrent.auto_rename_disabled"])
                </div>
            }
        }

        @if (_addError is not null)
        {
            <div class="add-error">@_addError</div>
        }

        <div class="add-actions">
            <Btn Variant="primary" Size="md" OnClick="AddTorrentAsync"
                 Disabled="@(_addBusy || (string.IsNullOrWhiteSpace(_addMagnet) && _torrentFileBytes is null))">
                <DIcon Name="download" Size="13" />
                @(_addBusy ? L["add_torrent.btn_adding"] : L["add_torrent.btn_add"])
            </Btn>
            <Btn Variant="ghost" Size="md" OnClick="CloseAddPanel">
                @L["add_torrent.btn_cancel"]
            </Btn>
        </div>
    </div>
</div>
}

<!-- =================== TORRENT DETAILS PANEL =================== -->
@{
    var live = _detailsHash is not null ? TorrentEngine.Get(_detailsHash) : null;
    var files = _detailsHash is not null ? TorrentEngine.GetFiles(_detailsHash) : null;
}
@if (_detailsPanelOpen)
{
<div class="tor-details__backdrop" @onclick="@(() => _detailsPanelOpen = false)"></div>
<div class="tor-details">
    <div class="tor-details__header">
        <h2 class="tor-details__title">@(live?.Name ?? _detailsHash ?? "")</h2>
        <Btn Variant="ghost" Size="sm" OnClick="@(() => Nav.NavigateTo("/torrents/" + _detailsHash + "/edit"))">
            <DIcon Name="pencil" Size="14" />
        </Btn>
        <Btn Variant="ghost" Size="sm" OnClick="@(() => _detailsPanelOpen = false)">
            <DIcon Name="x" Size="14" />
        </Btn>
    </div>
    <div class="tor-details__body">
        @if (live is not null)
        {
            <!-- Info -->
            <div class="tor-details__info">
                <div>@L["torrent_details.path_label"] <b>@live.SavePath</b></div>
                <div>@L["torrent_details.hash_label"] <code class="tor-details__hash">@_detailsHash[..20]…</code></div>
            </div>

            <!-- Progress -->
            <div class="tor-details__progress">
                <div class="tor-details__progress-head">
                    <span>@FormatBytes(live.Downloaded) / @FormatBytes(live.TotalSize)</span>
                    <b>@live.Progress.ToString("F1")%</b>
                </div>
                <div class="animarr-progress">
                    <div class="animarr-progress__track">
                        <div class="animarr-progress__fill"
                             style="width:@(live.Progress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                    </div>
                </div>
                <div class="tor-details__progress-foot">
                    <span>↓ @FormatSpeed(live.DownloadRate)</span>
                    <span>↑ @FormatSpeed(live.UploadRate)</span>
                    <span>@L["torrent_details.seeds_label"] @live.Seeds</span>
                    <span>@L["torrent_details.peers_label"] @live.Peers</span>
                </div>
            </div>

            <hr class="tor-details__hr" />

            <!-- Speed limits -->
            <h3 class="tor-details__h3">@L["torrent_details.speed_limits_title"]</h3>
            <div class="tor-details__limits">
                <label class="tor-details__limit-field">
                    <span class="tor-details__field-label">@L["torrent_details.dl_limit_label"]</span>
                    <input type="number" min="0" class="tor-details__input"
                           value="@_detailsDlLimit"
                           @onchange="@(e => int.TryParse(e.Value?.ToString(), out _detailsDlLimit))" />
                </label>
                <label class="tor-details__limit-field">
                    <span class="tor-details__field-label">@L["torrent_details.ul_limit_label"]</span>
                    <input type="number" min="0" class="tor-details__input"
                           value="@_detailsUlLimit"
                           @onchange="@(e => int.TryParse(e.Value?.ToString(), out _detailsUlLimit))" />
                </label>
                <Btn Variant="primary" Size="sm" OnClick="ApplySpeedLimits">@L["torrent_details.btn_apply"]</Btn>
            </div>

            <hr class="tor-details__hr" />

            <!-- File tree -->
            @if (!live.MetadataReceived)
            {
                <div class="tor-details__loading">
                    <div class="animarr-progress" style="width:64px;">
                        <div class="animarr-progress__track">
                            <div class="animarr-progress__fill animarr-progress__fill--indeterminate"></div>
                        </div>
                    </div>
                    <span>@L["torrent_details.loading_metadata"]</span>
                </div>
            }
            else if (files is not null && files.Count > 0)
            {
                if (_detailsFlatTree.Count == 0) BuildDetailsFlatTree(_detailsHash!);
                var fileProgress = TorrentEngine.GetFileProgress(_detailsHash!);
                <h3 class="tor-details__h3">@L["torrent_details.files_section"] (@files.Count)</h3>
                <div class="tor-details__tree">
                    @foreach (var item in _detailsFlatTree)
                    {
                        @if (!_detailsCollapsedFolders.Any(cf => item.FullPath != null && item.FullPath.StartsWith(cf + "/")))
                        {
                            @if (item.IsFolder)
                            {
                                var fp = item.FullPath!;
                                var collapsed = _detailsCollapsedFolders.Contains(fp);
                                <div class="tor-details__tree-folder" style="--depth:@(item.Depth)"
                                     @onclick="@(() => ToggleDetailsFolder(fp))">
                                    <span class="tor-details__tree-chev">@(collapsed ? "▶" : "▼")</span>
                                    <DIcon Name="folder" Size="13" />
                                    <span>@item.Name</span>
                                </div>
                            }
                            else
                            {
                                var fp = item.FullPath!;
                                var matchedFile = files.FirstOrDefault(f => f.Path.Replace('\\', '/') == fp);
                                var pct = fileProgress?.GetValueOrDefault(fp, 0) ?? 0;
                                var prio = matchedFile is not null ? (int)matchedFile.Priority : 4;
                                <div class="tor-details__tree-file" style="--depth:@(item.Depth)">
                                    <div class="tor-details__tree-file-head">
                                        <span class="tor-details__tree-file-name" title="@fp">@item.Name</span>
                                        <span class="tor-details__tree-file-pct">@pct.ToString("F0")%</span>
                                        <span class="tor-details__tree-file-size">@FormatBytes(item.Length)</span>
                                        @if (matchedFile is not null)
                                        {
                                            <select class="tor-details__tree-priority @(prio == 0 ? "tor-details__tree-priority--skip" : "")"
                                                    value="@prio"
                                                    @onchange="@(async e => await SetFilePriorityAsync(_detailsHash!, matchedFile.Path, int.Parse(e.Value!.ToString()!)))">
                                                <option value="0">@L["file_priority.skip"]</option>
                                                <option value="2">@L["file_priority.low"]</option>
                                                <option value="4">@L["file_priority.normal"]</option>
                                                <option value="6">@L["file_priority.high"]</option>
                                            </select>
                                        }
                                    </div>
                                    <div class="tor-details__tree-file-bar">
                                        <div class="tor-details__tree-file-bar-fill"
                                             style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
                <div class="tor-details__tree-foot">
                    <Btn Variant="ghost" Size="sm" OnClick="@(() => Nav.NavigateTo("/torrents/" + _detailsHash + "/edit"))">
                        <DIcon Name="pencil" Size="13" /> @L["torrent_details.btn_full_editor"]
                    </Btn>
                </div>
            }

            <hr class="tor-details__hr" />

            <!-- Controls -->
            <h3 class="tor-details__h3">@L["torrent_details.controls_title"]</h3>
            <div class="tor-details__controls">
                @if (live.State == TorrentState.Downloading || live.State == TorrentState.Metadata || live.State == TorrentState.Seeding)
                {
                    <Btn Variant="ghost" Size="sm" OnClick="@(() => PauseAsync(_detailsHash!))">
                        <DIcon Name="pause" Size="14" /> @L["torrent_details.btn_pause"]
                    </Btn>
                }
                @if (live.State == TorrentState.Paused || live.State == TorrentState.Stopped)
                {
                    <Btn Variant="primary" Size="sm" OnClick="@(() => ResumeAsync(_detailsHash!))">
                        <DIcon Name="play" Size="14" /> @L["torrent_details.btn_resume"]
                    </Btn>
                }
                @if (live.State != TorrentState.Stopped)
                {
                    <Btn Variant="ghost" Size="sm" OnClick="@(() => StopAsync(_detailsHash!))">
                        <DIcon Name="x" Size="14" /> @L["torrent_details.btn_stop"]
                    </Btn>
                }
                <Btn Variant="danger" Size="sm" OnClick="@(() => AskDelete(_detailsHash!, live.Name))">
                    <DIcon Name="trash" Size="14" /> @L["torrent_details.btn_delete"]
                </Btn>
                <Btn Variant="danger" Size="sm" OnClick="@(() => AskDelete(_detailsHash!, live.Name, deleteFiles: true))">
                    <DIcon Name="trash" Size="14" /> @L["torrent_details.btn_delete_with_files"]
                </Btn>
            </div>
        }
        else
        {
            <div class="tor-details__empty">@L["torrent_details.stopped_or_removed"]</div>
        }
    </div>
</div>
}

<!-- =================== DELETE CONFIRM DIALOG =================== -->
@if (!_deleteHidden)
{
    <div class="tor-confirm__backdrop" @onclick="@(() => _deleteHidden = true)"></div>
    <div class="tor-confirm" role="dialog" aria-modal="true">
        <header class="tor-confirm__header">
            <h2 class="tor-confirm__title">@L["delete_torrent.title"]</h2>
            <button type="button" class="tor-confirm__close" @onclick="@(() => _deleteHidden = true)" aria-label="Close">
                <DIcon Name="x" Size="16" />
            </button>
        </header>
        <div class="tor-confirm__body">
            <p class="tor-confirm__msg">@L.Get("delete_torrent.body", _deleteName)</p>
            <div class="tor-confirm__toggle">
                <Toggle Checked="_deleteFiles" CheckedChanged="@((bool v) => _deleteFiles = v)" />
                <span>@L["delete_torrent.delete_files_switch"]</span>
            </div>
        </div>
        <footer class="tor-confirm__footer">
            <Btn Variant="danger" Size="md" OnClick="ConfirmDeleteAsync">@L["delete_torrent.btn_confirm"]</Btn>
            <Btn Variant="ghost" Size="md" OnClick="@(() => _deleteHidden = true)">@L["delete_torrent.btn_cancel"]</Btn>
        </footer>
    </div>
}

@code {
    // ---- Add panel state ----
    private bool _addPanelOpen;
    // "file" (default) | "magnet" — which source the add-torrent panel is
    // currently set to. Switching wipes the other input.
    private string _addSourceType = "file";
    private string _addMagnet = "";
    private byte[]? _torrentFileBytes;
    private string? _torrentFileName;
    private string _addFolderStr = "";
    private Guid? _addFolderWatcherId;
    private string _addCustomPath = "";
    private int _addDlLimit;
    private int _addUlLimit;
    private bool _addStartPaused;
    private bool _addStopAfterDownload;
    private bool _addSkipSubfolderStructure;
    private bool _addSuppressRootFolder;
    private string _addCustomRootFolderName = "";
    private bool _addBusy;
    private string? _addError;

    // ---- Subfolder creation state ----
    private bool _createSubfolderMode;
    private string _newSubfolderName = "";

    // ---- Folder list for combobox ----
    private List<FolderWatcher> _folders = [];
    // Phase 3.1 MVP: same list grouped by parent section for the optgroup-style picker.
    private record FolderGroup(FolderWatcher? Section, List<FolderWatcher> Children);
    private List<FolderGroup> _foldersBySection = [];
    // FolderWatcher.Id → identified title from MediaItems (when status is Identified
    // or Manual). Used as the display name in the picker so the user sees the
    // canonical "Bleach" instead of the on-disk folder name (which can still be a
    // ".Bleach.S01.1080p.…"-style raw download dir, or any user-chosen name).
    private Dictionary<Guid, string> _folderDisplayName = new();

    /// <summary>
    /// Display name for a folder in the picker. Priority:
    ///   1. User-customised Label (differs from on-disk basename) — explicit
    ///      "this is what I want to see" signal, e.g. after fixing a bad rename.
    ///   2. MediaItem.Title from a confident identification.
    ///   3. Label as-is (= on-disk basename for never-customised entries).
    /// </summary>
    private string DisplayFor(FolderWatcher f)
    {
        var basename = Path.GetFileName(f.Path.TrimEnd('/', '\\'));
        if (!string.Equals(f.Label, basename, StringComparison.Ordinal))
            return f.Label;
        if (_folderDisplayName.TryGetValue(f.Id, out var t))
            return t;
        return f.Label;
    }
    private bool _defaultStopAfterDownload;

    // ---- Add panel file list state ----
    private List<TorrentFileEntry> _addFileEntries = [];
    private Dictionary<string, int> _addFilePriorities = new();
    private List<(bool IsFolder, string Name, string? FullPath, long Length, int Depth)> _addFlatTree = [];
    private HashSet<string> _collapsedFolders = new();

    // ---- Details panel state ----
    private bool _detailsPanelOpen;
    private string? _detailsHash;
    private int _detailsDlLimit;
    private int _detailsUlLimit;
    private List<(bool IsFolder, string Name, string? FullPath, long Length, int Depth)> _detailsFlatTree = [];
    private HashSet<string> _detailsCollapsedFolders = new();

    // M-14: snapshot of live torrents, refreshed from OnTorrentStateChanged.
    private IReadOnlyList<TorrentLiveStats> _torrentSnapshot = [];

    // True after the first GetAll() resolves in OnInitializedAsync. Lets the
    // grid distinguish "empty session" from "still loading" so the inline
    // dots loader shows during the initial fetch instead of the empty copy.
    private bool _initialLoadComplete;

    // Phase 3.2: title of the MediaItem we auto-matched the new torrent to.
    private string? _suggestedMatch;

    // ---- Tabs + History state ----
    private string _activeTabId = "active";
    private List<TorrentRecord> _historyRecords = [];
    private bool _historyLoading;
    private bool _historyLoaded;
    private int _historyPageIndex;
    private const int _historyPageSize = 25;

    // ---- Delete dialog state ----
    private bool _deleteHidden = true;
    private string? _deleteHash;
    private string _deleteName = "";
    private bool _deleteFiles;

    protected override async Task OnInitializedAsync()
    {
        TorrentEngine.StateChanged += OnTorrentStateChanged;
        _torrentSnapshot = TorrentEngine.GetAll();
        // First GetAll() complete — the grid can now distinguish "empty"
        // from "still loading" (the InlineDots placeholder hides itself).
        _initialLoadComplete = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        // Exclude SingleFilePath entries — those are individual movie FILES inside
        // a flat section (e.g. "Movies/Inception (2010).mkv"). The picker is a
        // destination-FOLDER selector — saving a torrent into a single video file
        // doesn't make sense and would clobber the existing movie.
        // Identified-title folders — children of sections. The picker shows these
        // grouped under their section's optgroup.
        _folders = await db.FolderWatchers
            .Where(f => !f.IsSection && f.SingleFilePath == null)
            .OrderBy(f => f.Label)
            .ToListAsync();

        // Section roots are now ALSO selectable — see optgroup render below.
        // Append them to _folders so the post-submit lookup `_folders.FirstOrDefault(...)`
        // resolves a section ID correctly (otherwise the picked section would be
        // dropped on submit and the torrent would default to the engine's catch-all).
        var sections = await db.FolderWatchers
            .Where(f => f.IsSection)
            .OrderBy(f => f.Label)
            .ToListAsync();
        var sectionMap = sections.ToDictionary(s => s.Id);
        _folders.AddRange(sections);

        // Hide ghost entries whose on-disk path no longer exists. After the
        // historic auto-rename catastrophe the DB still references the renamed
        // paths (e.g. "/Anime/The Portal"); those folders can't actually receive
        // a torrent and just confuse the picker. Sections aren't filtered —
        // missing section roots are a separate "fix your config" problem.
        _folders = _folders.Where(f => Directory.Exists(f.Path)).ToList();

        // Load identified titles so the picker shows "Bleach" instead of the raw
        // disk name. Only Identified/Manual entries — for NeedsReview / Failed
        // the title might be a wrong match, so we fall back to the disk label.
        var folderIds = _folders.Select(f => f.Id).ToList();
        _folderDisplayName = await db.MediaItems
            .Where(m => folderIds.Contains(m.FolderId)
                        && !string.IsNullOrEmpty(m.Title)
                        && (m.IdentificationStatus == IdentificationStatus.Identified
                            || m.IdentificationStatus == IdentificationStatus.Manual))
            .ToDictionaryAsync(m => m.FolderId, m => m.Title!);

        _foldersBySection = sections
            .Select(s => new FolderGroup(s,
                _folders.Where(f => f.ParentSectionId == s.Id).OrderBy(DisplayFor).ToList()))
            .Where(g => g.Children.Count > 0)
            .Concat(new[]
            {
                new FolderGroup(null,
                    _folders.Where(f => !f.ParentSectionId.HasValue ||
                                        !sectionMap.ContainsKey(f.ParentSectionId.Value))
                            .OrderBy(DisplayFor).ToList())
            })
            .Where(g => g.Children.Count > 0)
            .ToList();
        var cfg = await db.TorrentConfig.FirstOrDefaultAsync(c => c.Id == 1);
        if (cfg is not null)
        {
            _defaultStopAfterDownload = cfg.DefaultStopAfterDownload;
            _addStopAfterDownload = _defaultStopAfterDownload;
        }
    }

    public void Dispose() => TorrentEngine.StateChanged -= OnTorrentStateChanged;

    private async Task OnTabIdChanged(string tabId)
    {
        _activeTabId = tabId;
        if (tabId == "history" && !_historyLoaded)
            await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        _historyLoading = true;
        StateHasChanged();
        await using var db = await DbFactory.CreateDbContextAsync();
        _historyRecords = await db.TorrentRecords
            .Where(r => r.State != TorrentRecordState.Downloading &&
                        r.State != TorrentRecordState.Hashing)
            .OrderByDescending(r => r.AddedAt)
            .ToListAsync();
        _historyLoading = false;
        _historyLoaded = true;
    }

    private static string HistoryStateColorClass(TorrentRecordState state) => state switch
    {
        TorrentRecordState.Seeding     => "success",
        TorrentRecordState.Stopped     => "neutral",
        TorrentRecordState.Error       => "error",
        TorrentRecordState.Hashing     => "warning",
        TorrentRecordState.Downloading => "informative",
        _                              => "neutral",
    };

    private string HistoryStateLabel(TorrentRecordState state) => state switch
    {
        TorrentRecordState.Seeding     => L["torrent_history.state_seeding"],
        TorrentRecordState.Stopped     => L["torrent_history.state_stopped"],
        TorrentRecordState.Error       => L["torrent_history.state_error"],
        TorrentRecordState.Paused      => L["torrent_history.state_paused"],
        TorrentRecordState.Hashing     => L["torrent_history.state_hashing"],
        TorrentRecordState.Downloading => L["torrent_history.state_downloading"],
        _                              => state.ToString(),
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F2} GB";
        if (bytes >= 1_048_576)     return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024)          return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }

    private void ToggleDetailsFolder(string fp)
    {
        if (_detailsCollapsedFolders.Contains(fp)) _detailsCollapsedFolders.Remove(fp);
        else _detailsCollapsedFolders.Add(fp);
        StateHasChanged();
    }

    private void OnTorrentStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            // M-14: refresh snapshot once per state-change instead of in markup.
            _torrentSnapshot = TorrentEngine.GetAll();
            if (_detailsHash is not null && _detailsFlatTree.Count == 0)
                BuildDetailsFlatTree(_detailsHash);
            StateHasChanged();
        });
    }

    private void OpenDetails(string infoHash)
    {
        _detailsHash = infoHash;
        _detailsPanelOpen = true;
        _detailsCollapsedFolders = new();
        var live = TorrentEngine.Get(infoHash);
        if (live is not null)
        {
            _detailsDlLimit = live.DownloadLimit / 125000;
            _detailsUlLimit = live.UploadLimit / 125000;
        }
        BuildDetailsFlatTree(infoHash);
        _addPanelOpen = false;
    }

    private void BuildDetailsFlatTree(string infoHash)
    {
        var files = TorrentEngine.GetFiles(infoHash);
        if (files is null || files.Count == 0) return;
        var entries = files.Select(f => new TorrentFileEntry(f.Path.Replace('\\', '/'), f.Length));
        _detailsFlatTree = TorrentFileTree.Flatten(TorrentFileTree.BuildTree(entries));
    }

    /// <summary>
    /// Switch between the "file" and "magnet" source inputs. Wipes the input
    /// that's about to be hidden so saving doesn't accidentally pull from both
    /// (the Add button looks at whichever side has data).
    /// </summary>
    private void SwitchAddSource(string source)
    {
        if (_addSourceType == source) return;
        _addSourceType = source;
        if (source == "file")
        {
            _addMagnet = "";
        }
        else
        {
            _torrentFileBytes = null;
            _torrentFileName  = null;
            _addFileEntries   = [];
            _addFilePriorities = new();
            _addFlatTree      = [];
            _collapsedFolders = new();
        }
    }

    private void CloseAddPanel()
    {
        _addPanelOpen = false;
        _addSourceType = "file";
        _addMagnet = "";
        _torrentFileBytes = null;
        _torrentFileName = null;
        _addFolderStr = "";
        _addFolderWatcherId = null;
        _addCustomPath = "";
        _addDlLimit = 0;
        _addUlLimit = 0;
        _addStartPaused = false;
        _addStopAfterDownload = _defaultStopAfterDownload;
        _addSkipSubfolderStructure = false;
        _addSuppressRootFolder = false;
        _addCustomRootFolderName = "";
        _createSubfolderMode = false;
        _newSubfolderName = "";
        _addFileEntries = [];
        _addFilePriorities = new();
        _addFlatTree = [];
        _collapsedFolders = new();
        _addError = null;
        _suggestedMatch = null;
    }

    private void OnFolderPicked(string id)
    {
        _addFolderStr = id;
        if (Guid.TryParse(id, out var guid))
        {
            _addFolderWatcherId = guid;
            _addCustomPath = string.Empty;
        }
        else
        {
            _addFolderWatcherId = null;
        }
        _createSubfolderMode = false;
        _suggestedMatch = null; // manual pick → no longer an auto-suggest
    }

    private async Task OnMagnetChangedAsync()
    {
        // Try to extract "dn=" from the magnet — it's the display name and is
        // the cleanest signal for matching against the library.
        if (string.IsNullOrWhiteSpace(_addMagnet)) return;
        var dn = System.Text.RegularExpressions.Regex.Match(_addMagnet, @"[?&]dn=([^&]+)");
        if (!dn.Success) return;
        var name = Uri.UnescapeDataString(dn.Groups[1].Value).Replace('+', ' ');
        await SuggestDestinationFromNameAsync(name);
    }

    private async Task OnTorrentFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        using var ms = new System.IO.MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10_000_000).CopyToAsync(ms);
        _torrentFileBytes = ms.ToArray();
        _torrentFileName = file.Name;
        _addMagnet = "";   // clear magnet if a file is selected

        // Parse file list for priority selection
        _addFileEntries = await TorrentEngineService.ParseTorrentFilesAsync(_torrentFileBytes);
        _addFilePriorities = _addFileEntries.ToDictionary(f => f.Path.Replace('\\', '/'), _ => 4); // default Normal, normalized path
        _addFlatTree = TorrentFileTree.Flatten(TorrentFileTree.BuildTree(_addFileEntries));
        _collapsedFolders = new();

        // Phase 3.1/3.2: auto-suggest destination based on torrent name.
        await SuggestDestinationFromNameAsync(Path.GetFileNameWithoutExtension(file.Name));
    }

    /// <summary>
    /// Phase 3.2: when the user picks a magnet or .torrent, fuzzy-match the
    /// release name against existing MediaItems and pre-select the matching
    /// folder so they don't have to dig through the dropdown.
    /// </summary>
    private async Task SuggestDestinationFromNameAsync(string sourceName)
    {
        // Don't override a manual pick.
        if (_addFolderWatcherId.HasValue || !string.IsNullOrWhiteSpace(_addCustomPath))
            return;
        if (string.IsNullOrWhiteSpace(sourceName)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var items = await db.MediaItems
            .Include(m => m.Folder)
            .Where(m => m.Folder != null && !m.Folder.IsSection)
            .Select(m => new { m.Title, m.OriginalTitle, m.FolderId, FolderPath = m.Folder!.Path })
            .ToListAsync();
        if (items.Count == 0) return;

        var needle = NormaliseForMatch(sourceName);
        var best   = items
            .Select(m => new
            {
                m.FolderId,
                m.FolderPath,
                m.Title,
                Score = Math.Max(
                    SubstringScore(needle, NormaliseForMatch(m.Title)),
                    SubstringScore(needle, NormaliseForMatch(m.OriginalTitle ?? "")))
            })
            .Where(x => x.Score >= 0.6)
            .OrderByDescending(x => x.Score)
            .FirstOrDefault();

        if (best is null) return;

        _addFolderWatcherId = best.FolderId;
        _addFolderStr       = best.FolderId.ToString();
        _suggestedMatch     = best.Title;
        StateHasChanged();
    }

    private static string NormaliseForMatch(string s)
    {
        var lower = s.ToLowerInvariant();
        var chars = lower.Select(c => char.IsLetterOrDigit(c) ? c : ' ').ToArray();
        return System.Text.RegularExpressions.Regex
            .Replace(new string(chars), @"\s+", " ").Trim();
    }

    /// <summary>Returns 1.0 if all words of <paramref name="title"/> appear in
    /// <paramref name="sourceName"/> in order, scaled by ratio of matched words.</summary>
    private static double SubstringScore(string sourceName, string title)
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(sourceName)) return 0;
        if (sourceName.Contains(title)) return 1.0;
        var titleWords = title.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (titleWords.Length == 0) return 0;
        int hit = titleWords.Count(w => w.Length >= 2 && sourceName.Contains(w));
        return (double)hit / titleWords.Length;
    }

    private bool IsItemVisible((bool IsFolder, string Name, string? FullPath, long Length, int Depth) item)
    {
        if (item.FullPath is null) return true;
        return !_collapsedFolders.Any(cf => item.FullPath.StartsWith(cf + "/"));
    }

    private bool IsFolderChecked(string folderPath)
    {
        var matches = _addFilePriorities.Where(kv => kv.Key.StartsWith(folderPath + "/") || kv.Key == folderPath).ToList();
        return matches.Count > 0 && matches.All(kv => kv.Value > 0);
    }

    private void ToggleFolderCheck(string folderPath)
    {
        bool allChecked = IsFolderChecked(folderPath);
        foreach (var key in _addFilePriorities.Keys.Where(k => k.StartsWith(folderPath + "/") || k == folderPath).ToList())
            _addFilePriorities[key] = allChecked ? 0 : 4;
        StateHasChanged();
    }

    private void ToggleFolderCollapse(string folderPath)
    {
        if (_collapsedFolders.Contains(folderPath)) _collapsedFolders.Remove(folderPath);
        else _collapsedFolders.Add(folderPath);
        StateHasChanged();
    }

    private async Task AddTorrentAsync()
    {
        _addError = null;
        var selectedFolder = _addFolderWatcherId.HasValue
            ? _folders.FirstOrDefault(f => f.Id == _addFolderWatcherId)
            : null;
        var savePath = !string.IsNullOrWhiteSpace(_addCustomPath) ? _addCustomPath : (selectedFolder?.Path ?? "");
        var autoRename = selectedFolder?.RenameEnabled ?? true;

        if (string.IsNullOrWhiteSpace(savePath))
        {
            _addError = L["add_torrent.error_select_folder"];
            return;
        }

        _addBusy = true;
        try
        {
            if (_torrentFileBytes is not null)
            {
                await TorrentEngine.AddTorrentFileAsync(
                    _torrentFileBytes, savePath, _addFolderWatcherId,
                    _addDlLimit * 125000, _addUlLimit * 125000, autoRename, _addStartPaused, _addStopAfterDownload,
                    _addFilePriorities.Count > 0 ? _addFilePriorities : null, _addSkipSubfolderStructure,
                    _addSuppressRootFolder, _addCustomRootFolderName);
            }
            else if (!string.IsNullOrWhiteSpace(_addMagnet))
            {
                await TorrentEngine.AddMagnetAsync(
                    _addMagnet.Trim(), savePath, _addFolderWatcherId,
                    _addDlLimit * 125000, _addUlLimit * 125000, autoRename, _addStartPaused, _addStopAfterDownload,
                    _addSkipSubfolderStructure, _addSuppressRootFolder, _addCustomRootFolderName);
            }
            ToastService.ShowToast(ToastIntent.Success, L["add_torrent.toast_added"]);
            CloseAddPanel();
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
        }
        finally
        {
            _addBusy = false;
        }
    }

