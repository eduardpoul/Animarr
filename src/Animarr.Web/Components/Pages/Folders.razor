@* Phase 2.1: /folders page is deprecated — its functionality (add/edit folder,
   toggle monitoring, identify-all, find subfolders) lives in Explorer. Kept as
   a thin redirect for any bookmarks/links pointing here. *@
@page "/folders"
@rendermode InteractiveServer
@inject NavigationManager Nav

@code {
    protected override void OnInitialized() => Nav.NavigateTo("/explorer", replace: true);
}
