@page "/catalog/{Id:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IToastService ToastService
@inject TmdbClient TmdbClient
@inject IAppConfigService AppConfig
@inject MetadataService MetadataService
@inject IPatternMatchService PatternMatch
@inject IJSRuntime JS
@inject ILogger<MediaDetail> Logger
@inject ILlmService Llm
@inject MediaCachePaths CachePaths
@inject IWatchStateService WatchSvc

<PageTitle>@(_item?.Title ?? "…") — Animarr</PageTitle>

@if (_loading)
{
    <div class="animarr-progress">
        <div class="animarr-progress__track">
            <div class="animarr-progress__fill animarr-progress__fill--indeterminate"></div>
        </div>
    </div>
}
else if (_item is null)
{
    <div class="md-not-found">
        <div class="md-not-found__text">@L["media_detail.not_found"]</div>
        <Btn Variant="solid" Size="md" OnClick="@(() => Nav.NavigateTo("/"))">
            <DIcon Name="chev-l" Size="14" /> @L["media_detail.btn_back"]
        </Btn>
    </div>
}
else
{

    @* ══ Design hero block (replaces the old Back+Title row + Poster+Meta layout) ══ *@
    <MediaDetailHero Item="@_item"
                     OnEditClick="OpenEditPanel"
                     Continue="@_continueAction"
                     OnContinueClick="HandleContinueClick" />

    @* ══ 3-column body: Synopsis · Details · Identification ════════════════
       Spec source: design_handoff_animarr/screens-v3.jsx::MediaDetailV3 lines 412-478.
       Synopsis owns the inline CTA row (Play / Edit metadata / Re-identify) — no
       separate action row above the body block. Tags render inline in Details,
       not as Pills under Synopsis (design intentionally treats them as dim text). *@
    <div class="md-body">
        @* Synopsis — overline + prose + action row (3 buttons per spec lines 424-428). *@
        <section class="md-body__col md-synopsis">
            <div class="md-overline">SYNOPSIS</div>
            @if (!string.IsNullOrEmpty(_item.Description))
            {
                <p class="md-prose">@_item.Description</p>
            }
            else
            {
                <p class="md-prose md-prose--empty">No synopsis available.</p>
            }
            @* Primary CTA moved into the hero (CHANGELOG §2). Secondary actions stay here. *@
            <div class="md-actions">
                <Btn Variant="solid" Size="md" OnClick="OpenEditPanel">
                    <DIcon Name="pencil" Size="14" /> Edit metadata
                </Btn>
                <Btn Variant="ghost" Size="md" OnClick="ReidentifyAsync">
                    <DIcon Name="refresh" Size="14" /> @L["catalog.btn_reidentify"]
                </Btn>
            </div>
        </section>

        @* Details — mono key/value table; tags inline as " · " separated text per spec lines 433-441. *@
        <section class="md-body__col md-details">
            <div class="md-overline">DETAILS</div>
            <dl class="md-kv">
                @if (!string.IsNullOrEmpty(_item.Studio)) { <dt>Studio</dt><dd>@_item.Studio</dd> }
                @if (!string.IsNullOrEmpty(_item.Language)) { <dt>Language</dt><dd>@_item.Language</dd> }
                @if (_item.Runtime is > 0) { <dt>Runtime</dt><dd>@_item.Runtime m</dd> }
                @if (_item.EpisodeCount is > 0) { <dt>Episodes</dt><dd>@_item.EpisodeCount</dd> }
                @if (!string.IsNullOrEmpty(_item.SeasonLabel)) { <dt>Season</dt><dd>@_item.SeasonLabel</dd> }
                @if (!string.IsNullOrEmpty(_item.Status)) { <dt>Status</dt><dd>@_item.Status</dd> }
                @if (!string.IsNullOrEmpty(_item.ContentRating)) { <dt>Rating</dt><dd>@_item.ContentRating</dd> }
                @if (_genres.Count > 0)
                {
                    <dt>Tags</dt>
                    <dd class="md-kv__tags">@string.Join(" · ", _genres)</dd>
                }
            </dl>
        </section>

        @* Identification — surface card with source rows (dashed bottom border)
           + ON DISK section below. Spec lines 451-477. *@
        <section class="md-body__col md-ident">
            <div class="md-overline md-overline--dim">IDENTIFICATION</div>

            @if (_item.TmdbId is not null)
            {
                <div class="md-id-row">
                    <span class="md-id-row__src">TMDB</span>
                    <a class="md-id-row__val"
                       href="https://www.themoviedb.org/@(_item.MediaType == MediaItemType.Movie ? "movie" : "tv")/@_item.TmdbId"
                       target="_blank" rel="noopener">#@_item.TmdbId</a>
                    @if (_item.TmdbConfidence is > 0)
                    {
                        <span class="@($"md-id-row__conf {ConfClass(_item.TmdbConfidence)}")">@($"{_item.TmdbConfidence:P0}")</span>
                    }
                </div>
            }
            @if (_item.MalId is not null)
            {
                <div class="md-id-row">
                    <span class="md-id-row__src">MAL</span>
                    <a class="md-id-row__val"
                       href="https://myanimelist.net/anime/@_item.MalId"
                       target="_blank" rel="noopener">#@_item.MalId</a>
                    @if (_item.MalConfidence is > 0)
                    {
                        <span class="@($"md-id-row__conf {ConfClass(_item.MalConfidence)}")">@($"{_item.MalConfidence:P0}")</span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_item.ImdbId))
            {
                <div class="md-id-row">
                    <span class="md-id-row__src">IMDb</span>
                    <a class="md-id-row__val"
                       href="https://www.imdb.com/title/@_item.ImdbId/"
                       target="_blank" rel="noopener">@_item.ImdbId</a>
                    @if (_item.ImdbConfidence is > 0)
                    {
                        <span class="@($"md-id-row__conf {ConfClass(_item.ImdbConfidence)}")">@($"{_item.ImdbConfidence:P0}")</span>
                    }
                </div>
            }
            @if (_item.TvdbId is not null)
            {
                <div class="md-id-row">
                    <span class="md-id-row__src">TVDB</span>
                    <span class="md-id-row__val">#@_item.TvdbId</span>
                </div>
            }

            <div class="md-overline md-overline--dim md-ident__on-disk-label">ON DISK</div>
            <code class="md-ident__path">@_item.Folder?.Path</code>
        </section>
    </div>

    @* CHANGELOG §3 — Movie file card. Renders after the body for type == Movie
       so the user gets a per-file action surface (play / mark watched / etc.)
       in lieu of the episode grid that series show. *@
    @if (_item.MediaType == MediaItemType.Movie)
    {
        var moviePath = _item.Folder?.SingleFilePath
            ?? (_subFiles.Count == 1 && IsVideo(_subFiles[0].Ext) ? _subFiles[0].FullPath : null);
        var movieHave = !string.IsNullOrEmpty(moviePath) && File.Exists(moviePath);
        var movieInfo = SniffMovieFile(moviePath);
        <section class="md-movie">
            <div class="md-overline">FILE</div>
            <MovieFileCard Title="@_item.Title"
                           FileName="@(moviePath != null ? Path.GetFileName(moviePath) : null)"
                           ThumbUrl="@_fanartUrl"
                           Runtime="@(_item.Runtime is > 0 ? $"{_item.Runtime} min" : null)"
                           Resolution="@movieInfo.Resolution"
                           Codec="@movieInfo.Codec"
                           Size="@movieInfo.Size"
                           Have="@movieHave"
                           WatchState="@_movieWatch"
                           PlayLabel="@(_continueAction?.Label ?? "Play movie")"
                           PlayIcon="@(_continueAction?.IconName ?? "play")"
                           OnPlayClick="@(() => _continueAction is null ? Task.CompletedTask : HandleContinueClick(_continueAction))"
                           OnToggleWatched="ToggleMovieWatchedAsync" />
        </section>
    }

    @* NeedsReview top-3 candidates — restyled per design's warn-tinted block.
       The full picker lives in the catalog NR modal; this is a quick-apply hint. *@
    @if (_item.IdentificationStatus == IdentificationStatus.NeedsReview && _candidateList.Count > 0)
    {
        <section class="md-nr">
            <div class="md-nr__head">
                <div class="md-nr__icon"><DIcon Name="warn" Size="16" /></div>
                <div class="md-nr__head-text">
                    <div class="md-overline md-overline--warn">NEEDS REVIEW</div>
                    <div class="md-nr__hint">@L["media_detail.review_hint"]</div>
                </div>
            </div>
            <div class="md-nr__list">
                @foreach (var c in _candidateList)
                {
                    var cand = c;
                    var sourceUrl = BuildSourceUrl(cand);
                    <div class="md-nr-card">
                        @if (!string.IsNullOrEmpty(cand.PosterUrl))
                        {
                            <img src="@cand.PosterUrl"
                                 alt="poster"
                                 loading="lazy"
                                 class="md-nr-card__poster"
                                 @onclick="@(() => OpenImagePreview(cand.PosterUrl!))" />
                        }
                        else
                        {
                            <div class="md-nr-card__poster md-nr-card__poster--empty">
                                <DIcon Name="video" Size="22" />
                            </div>
                        }
                        <div class="md-nr-card__body">
                            <div class="md-nr-card__title">@cand.Title @(cand.Year.HasValue ? $"({cand.Year})" : "")</div>
                            <div class="md-nr-card__type">@cand.Type</div>
                            @if (!string.IsNullOrEmpty(cand.Overview))
                            {
                                <div class="md-nr-card__overview">@cand.Overview</div>
                            }
                        </div>
                        <div class="md-nr-card__actions">
                            <Btn Variant="primary" Size="sm"
                                 Disabled="@_applyingCandidate"
                                 OnClick="@(() => ApplyCandidateAsync(cand))">
                                @L["media_detail.review_apply"]
                            </Btn>
                            @if (sourceUrl is not null)
                            {
                                <a class="md-nr-card__src" href="@sourceUrl" target="_blank" rel="noopener noreferrer">
                                    <DIcon Name="external" Size="11" /> @L["media_detail.review_open_source"]
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @* ══ Seasons / Episodes ══════════════════════════════════════════════
       Spec source: design_handoff_animarr/screens-v3.jsx::MediaDetailV3 lines 481-515.
       Overline EPISODES + SEASON 0N display heading + "N/M on disk" inline count.
       Season switcher is a row of buttons on the right (accent-soft when active). *@
    @if (_seasons.Count > 0)
    {
        var currentSeasonNum = int.TryParse(_activeSeason.TrimStart('s'), out var sn) ? sn : (_seasons.FirstOrDefault()?.Number ?? 1);
        var currentSeason = _seasons.FirstOrDefault(x => x.Number == currentSeasonNum) ?? _seasons.First();
        var currentEps = _episodesBySeason.TryGetValue(currentSeason.Number, out var loadedEps) ? loadedEps : null;
        var haveCount = currentEps?.Count(e => _episodeFileMap.ContainsKey((currentSeason.Number, e.Number))) ?? 0;
        var totalCount = currentEps?.Count ?? currentSeason.EpisodeCount;

        <section class="md-eps">
            <div class="md-eps__head">
                <div>
                    <div class="md-overline">EPISODES</div>
                    <h2 class="md-eps__title">
                        SEASON @currentSeason.Number.ToString("00")
                        @if (totalCount > 0)
                        {
                            <span class="md-eps__count">@haveCount/@totalCount on disk</span>
                        }
                    </h2>
                </div>
                @if (_seasons.Count > 1)
                {
                    <div class="md-eps__seasons">
                        @foreach (var s in _seasons)
                        {
                            var sNum = s.Number;
                            var isActive = sNum == currentSeason.Number;
                            <button type="button"
                                    class="@($"md-eps__season-btn {(isActive ? "md-eps__season-btn--active" : "")}")"
                                    @onclick="@(() => SetActiveSeasonAsync(sNum))">
                                SEASON @sNum.ToString("00")
                            </button>
                        }
                    </div>
                }
            </div>

            @if (currentEps is { Count: > 0 })
            {
                <div class="md-eps-grid">
                    @foreach (var ep in currentEps)
                    {
                        var seasonNum = currentSeason.Number;
                        var hasFile = _episodeFileMap.ContainsKey((seasonNum, ep.Number));
                        _watchByKey.TryGetValue((seasonNum, ep.Number), out var ws);
                        @* CHANGELOG §4 meta line — strictly "{runtime} · 1080p · H.265 · {size}"
                           for on-disk episodes, "{runtime} · Missing" for missing. NO
                           "Watched" / "Not downloaded" / "38% watched" status words. *@
                        var meta = hasFile ? BuildEpisodeMeta(ep) : BuildMissingMeta(ep);
                        var epNum = ep.Number;
                        var fileName = ep.FileName;
                        <div @onclick="@(() => { if (hasFile && fileName != null) OpenPlayer(fileName); })">
                            <EpisodeCard
                                Number="@epNum"
                                Title="@ep.Name"
                                ThumbUrl="@ep.StillUrl"
                                Meta="@meta"
                                Have="@hasFile"
                                WatchState="@ws"
                                OnToggleWatched="@(() => ToggleEpisodeWatchedAsync(seasonNum, epNum, fileName))" />
                        </div>
                    }
                </div>
            }
            else if (_item.TmdbId.HasValue)
            {
                <Btn Variant="solid" Size="md" OnClick="@(() => LoadSeasonEpisodesAsync(currentSeason.Number))">
                    @L["media_detail.btn_load_episodes"]
                </Btn>
            }
            else
            {
                <div class="md-eps__empty">@L.Get("media_detail.no_episodes_hint", currentSeason.EpisodeCount)</div>
            }
        </section>
    }

    @* ══ Files (only when there's no TMDB season metadata).
       Movies render their canonical MovieFileCard above — skip this section
       for type == Movie so the user doesn't see a duplicate generic file row. *@
    @if (_subFiles.Count > 0 && _seasons.Count == 0 && _item.MediaType != MediaItemType.Movie)
    {
        <section class="md-files">
            <div class="md-overline">FILES</div>
            <div class="md-files-grid">
                @foreach (var f in _subFiles)
                {
                    var isVid = IsVideo(f.Ext);
                    <div class="@($"md-file-card {(isVid ? "md-file-card--clickable" : "")}")"
                         @onclick="@(() => { if (isVid) OpenPlayer(f.FullPath); })">
                        <div class="md-file-art">
                            @if (isVid)
                            {
                                <DIcon Name="play" Size="28" />
                                <div class="md-file-play-overlay">
                                    <DIcon Name="play" Size="28" />
                                </div>
                            }
                            else
                            {
                                <DIcon Name="file" Size="24" />
                            }
                        </div>
                        <div class="md-file-label" title="@f.Name">@f.Name</div>
                        <div class="md-file-meta">@FormatSize(f.Size)</div>
                    </div>
                }
            </div>
        </section>
    }
}

@if (_playerPath is not null)
{
    <div class="vp-backdrop" @onclick="ClosePlayer">
        <div class="vp-shell" @onclick:stopPropagation>
            <div class="vp-header">
                <span class="vp-title" title="@_playerPath">@Path.GetFileName(_playerPath)</span>
                <button type="button" class="vp-close" @onclick="ClosePlayer" aria-label="Close">
                    <DIcon Name="x" Size="16" />
                </button>
            </div>
            <video controls autoplay class="vp-video"
                   src="@($"/api/video?path={Uri.EscapeDataString(_playerPath)}")">
            </video>
        </div>
    </div>
}

@if (_previewImageUrl is not null)
{
    <div class="md-img-backdrop" @onclick="CloseImagePreview">
        <button type="button" class="md-img-close" @onclick="CloseImagePreview" aria-label="Close">
            <DIcon Name="x" Size="18" />
        </button>
        <img src="@_previewImageUrl" alt="preview" class="md-img-preview" @onclick:stopPropagation />
    </div>
}

@if (_showEdit && _item?.Folder is not null)
{
    @* Pixel-perfect drawer per design_handoff_animarr/screens-v3.jsx (560px, 6 tabs).
       This is the only folder-level metadata editor now that Explorer is gone. *@
    <EditMetadataDrawer Item="_item"
                        OnClose="CloseEditPanel"
                        OnSaved="HandleEditSaved" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private MediaItem? _item;
    private bool _loading = true;
    private List<SeasonMeta> _seasons = [];
    private List<string> _genres = [];
    private Dictionary<int, List<EpisodeVm>> _episodesBySeason = [];
    private string _activeSeason = "s1";
    private bool _downloadThumbs;

    private string? _posterUrl;
    private string? _fanartUrl;
    private string? _logoUrl;
    private long    _imageVersion;

    // Backdrop
    private bool _backdropOwned; // true if WE called initBackdrop (so we should stop it)

    // (seasonNumber, episodeNumber) → full file path on disk
    private Dictionary<(int s, int ep), string> _episodeFileMap = [];

    // Phase 2.3: top-3 candidates parsed from MediaItem.CandidatesJson
    private record CandidateRow(int Id, string? StringId, string Title, int? Year, string Type, bool IsTv, string? Overview, string? PosterUrl);
    private List<CandidateRow> _candidateList = [];
    private bool _applyingCandidate;

    // Video player
    private string? _playerPath;

    // Image preview
    private string? _previewImageUrl;
    private void OpenImagePreview(string url) => _previewImageUrl = url;
    private void CloseImagePreview()          => _previewImageUrl = null;

    // Edit panel
    private bool _showEdit;

    // CHANGELOG §2 — dynamic Continue / Play CTA shown in the hero.
    private ContinueAction? _continueAction;

    // CHANGELOG §4 — (season, episode) → WatchState for the rendered series.
    // Looked up by EpisodeCard via the explicit Parameter — keeps the loop cheap.
    private Dictionary<(int s, int ep), WatchState> _watchByKey = new();
    // Movie watch state (single row, Season/Episode null).
    private WatchState? _movieWatch;

    // Filesystem content
    private List<SubDirEntry> _subDirs = [];
    private List<FileEntry>   _subFiles = [];
    private Dictionary<string, Guid> _subDirMediaIds = []; // path → MediaItem.Id

    private static readonly string[] MediaExtensions = [".mkv", ".mp4", ".avi", ".m4v", ".mov", ".wmv", ".ts", ".m2ts"];
    private static readonly string[] SubtitleExtensions = [".srt", ".ass", ".ssa", ".sub", ".vtt"];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _item = await db.MediaItems
            .Include(m => m.Folder)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (_item != null)
        {
            _genres  = ParseJson<List<string>>(_item.GenresJson) ?? [];
            _seasons = ParseJson<List<SeasonMeta>>(_item.SeasonsJson) ?? [];
            _activeSeason = $"s{_seasons.FirstOrDefault()?.Number ?? 1}";

            // Phase 2.3: parse top-3 candidates for the NeedsReview banner.
            _candidateList = ParseCandidates(_item.CandidatesJson);

            if (_item.Folder != null)
            {
                _imageVersion = _item.LastMetadataRefreshedAt?.Ticks ?? 0;
                _posterUrl = BuildUrl(_item.Folder.Path, _item.PosterPath, _imageVersion);
                _fanartUrl = BuildUrl(_item.Folder.Path, _item.FanartPath, _imageVersion);
                _logoUrl   = BuildUrl(_item.Folder.Path, _item.LogoPath,   _imageVersion);

                // SingleFilePath entries are individual movies stored as bare
                // files inside a flat section; the "containing folder" is the
                // section root shared with many other movies. Don't render the
                // entire section's file list — just this one file.
                if (_item.Folder.SingleFilePath is { Length: > 0 } single && File.Exists(single))
                {
                    var fi = new FileInfo(single);
                    _subDirs  = [];
                    _subFiles = [new FileEntry(
                        Name:     fi.Name,
                        FullPath: fi.FullName,
                        Size:     fi.Length,
                        Ext:      fi.Extension)];
                }
                else
                {
                    LoadFilesystem(_item.Folder.Path);
                    await LoadSubDirMediaIdsAsync(db, _item.Folder.Path);
                    await BuildEpisodeFileMapAsync(_item.Folder.Id, _item.Folder.Path, _item.Folder.FolderType);
                }
            }

            // Auto-load first season episodes
            if (_item.TmdbId.HasValue && _seasons.Count > 0)
                await LoadSeasonEpisodesAsync(_seasons[0].Number);
        }

        _downloadThumbs = await AppConfig.GetAsync<bool>(AppConfigKeys.DownloadEpisodeThumbs, false);

        await LoadWatchStatesAsync();
        await RecomputeContinueAsync();

        _loading = false;
        _backdropOwned = false; // reset on parameter change so backdrop restarts
    }

    protected override void OnInitialized()
    {
        // Refresh when MarkEpisodeAsync / MarkMovieAsync fires the change event.
        WatchSvc.WatchStateChanged += OnWatchStateChanged;
    }

    private async void OnWatchStateChanged(Guid mediaItemId)
    {
        if (_item is null || mediaItemId != _item.Id) return;
        await LoadWatchStatesAsync();
        await RecomputeContinueAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Refresh the (season, episode) → WatchState map after a toggle
    /// or on initial load. Movies use _movieWatch instead.</summary>
    private async Task LoadWatchStatesAsync()
    {
        _watchByKey = new();
        _movieWatch = null;
        if (_item is null) return;

        if (_item.MediaType == MediaItemType.Movie)
        {
            _movieWatch = await WatchSvc.GetForMovieAsync(_item.Id);
        }
        else
        {
            var states = await WatchSvc.GetForSeriesAsync(_item.Id);
            foreach (var s in states)
            {
                if (s.Season is null || s.Episode is null) continue;
                _watchByKey[(s.Season.Value, s.Episode.Value)] = s;
            }
        }
    }

    /// <summary>Recompute the hero CTA after a load / watch-state change.
    /// Movies use the single WatchState row; series builds a have-list from
    /// _episodeFileMap (whose key set IS the on-disk episodes).</summary>
    private async Task RecomputeContinueAsync()
    {
        if (_item is null) { _continueAction = null; return; }

        if (_item.MediaType == MediaItemType.Movie)
        {
            _continueAction = await ContinueResolver.ResolveAsync(WatchSvc, _item, Array.Empty<ContinueEpisode>());
            return;
        }

        // Series: have-list is (season, episode) pairs present in _episodeFileMap.
        var eps = _episodeFileMap.Keys
            .Select(k => new ContinueEpisode(k.s, k.ep, true))
            .ToList();
        _continueAction = await ContinueResolver.ResolveAsync(WatchSvc, _item, eps);
    }

    /// <summary>Resolves the file path the Continue/Play CTA should open, then
    /// hands it to the existing inline player overlay (`_playerPath` →
    /// `<video src="/api/video?path=…">`). Picks:
    ///   • Movie  → SingleFilePath, falling back to the lone video file in the folder.
    ///   • Series with (Season, Episode) hint → the matching file from _episodeFileMap.
    ///   • Series without hint (Play first / Replay) → the first on-disk episode by (season, episode).</summary>
    private Task HandleContinueClick(ContinueAction action)
    {
        if (_item is null) return Task.CompletedTask;

        string? path = null;
        if (_item.MediaType == MediaItemType.Movie)
        {
            path = _item.Folder?.SingleFilePath;
            if (string.IsNullOrEmpty(path))
            {
                var firstVid = _subFiles.FirstOrDefault(f => IsVideo(f.Ext));
                if (firstVid is not null) path = firstVid.FullPath;
            }
        }
        else if (action.SeasonHint is int s && action.EpisodeHint is int e
                 && _episodeFileMap.TryGetValue((s, e), out var hinted))
        {
            path = hinted;
        }
        else if (_episodeFileMap.Count > 0)
        {
            // No hint (Play first episode / Replay) → take the lowest (season, episode).
            var first = _episodeFileMap
                .OrderBy(kv => kv.Key.Item1).ThenBy(kv => kv.Key.Item2)
                .First();
            path = first.Value;
        }

        if (!string.IsNullOrEmpty(path) && File.Exists(path))
        {
            OpenPlayer(path);
        }
        else
        {
            ToastService.ShowWarning("No playable file found on disk for this title.");
        }
        return Task.CompletedTask;
    }

    /// <summary>Called by an EpisodeCard's watched-eye chip. Persists then
    /// the WatchStateChanged event refreshes us.</summary>
    private async Task ToggleEpisodeWatchedAsync(int season, int episode, string? filePath)
    {
        if (_item is null) return;
        _watchByKey.TryGetValue((season, episode), out var existing);
        var nextWatched = existing is null ? true : !existing.IsWatched;
        await WatchSvc.MarkEpisodeAsync(_item.Id, season, episode, nextWatched, filePath);
    }

    private async Task ToggleMovieWatchedAsync()
    {
        if (_item is null) return;
        var nextWatched = !(_movieWatch?.IsWatched ?? false);
        await WatchSvc.MarkMovieAsync(_item.Id, nextWatched);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_backdropOwned && _fanartUrl != null)
        {
            var enabled = await AppConfig.GetAsync<bool>(AppConfigKeys.BackdropEnabled, true);
            if (!enabled) return;

            var blur       = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBlurPx, 0);
            if (blur > 20) { blur = 0; await AppConfig.SetAsync<int>(AppConfigKeys.BackdropBlurPx, 0); }
            var brightness = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBrightness, 60);

            _backdropOwned = true;
            await JS.InvokeVoidAsync("initBackdrop", new[] { _fanartUrl }, 999, blur, brightness);
        }
    }

    public async ValueTask DisposeAsync()
    {
        WatchSvc.WatchStateChanged -= OnWatchStateChanged;
        if (_backdropOwned)
            try { await JS.InvokeVoidAsync("restoreGlobalBackdrop"); } catch { }
    }

    private static List<CandidateRow> ParseCandidates(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var list = new List<CandidateRow>();
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                int id        = el.TryGetProperty("Id",        out var pId)  ? pId.GetInt32()      : 0;
                var stringId  = el.TryGetProperty("StringId",  out var pSid) && pSid.ValueKind == System.Text.Json.JsonValueKind.String ? pSid.GetString() : null;
                var title     = el.TryGetProperty("Title",     out var pTit) ? pTit.GetString() ?? "" : "";
                int? year     = el.TryGetProperty("Year",      out var pYr)  && pYr.ValueKind == System.Text.Json.JsonValueKind.Number ? pYr.GetInt32() : null;
                var type      = el.TryGetProperty("Type",      out var pTy)  ? pTy.GetString() ?? "" : "";
                var isTv      = el.TryGetProperty("IsTv",      out var pIt)  && pIt.ValueKind == System.Text.Json.JsonValueKind.True;
                var ov        = el.TryGetProperty("Overview",  out var pOv)  && pOv.ValueKind == System.Text.Json.JsonValueKind.String ? pOv.GetString() : null;
                var posterUrl = el.TryGetProperty("PosterUrl", out var pPu)  && pPu.ValueKind == System.Text.Json.JsonValueKind.String ? pPu.GetString() : null;
                list.Add(new CandidateRow(id, stringId, title, year, type, isTv, ov, posterUrl));
            }
            return list;
        }
        catch { return []; }
    }

    /// <summary>Build a "view on source" external URL for a candidate, or null if unknown.</summary>
    private static string? BuildSourceUrl(CandidateRow c) => c.Type switch
    {
        "tmdb_tv"     => $"https://www.themoviedb.org/tv/{c.Id}",
        "tmdb_movie"  => $"https://www.themoviedb.org/movie/{c.Id}",
        "mal"         => $"https://myanimelist.net/anime/{c.Id}",
        "imdb_search" => !string.IsNullOrEmpty(c.StringId) ? $"https://www.imdb.com/title/{c.StringId}/" : null,
        _             => null,
    };

    private async Task ApplyCandidateAsync(CandidateRow cand)
    {
        if (_item is null) return;
        _applyingCandidate = true;
        try
        {
            // CandidateRow.Type is the source key from MetadataService (e.g. "tmdb_tv").
            // IMDb candidates carry their tt-id in StringId, not Id (Id is 0). The string
            // overload of ApplyManualAsync expects sources "imdb_tv" / "imdb_movie" — map
            // "imdb_search" using IsTv so the right TMDB FindByExternalId path is taken.
            if (cand.Type == "imdb_search")
            {
                if (string.IsNullOrEmpty(cand.StringId))
                    throw new InvalidOperationException("IMDb candidate is missing its tt-id.");
                var imdbSource = cand.IsTv ? "imdb_tv" : "imdb_movie";
                await MetadataService.ApplyManualAsync(_item.FolderId, imdbSource, cand.StringId);
            }
            else
            {
                await MetadataService.ApplyManualAsync(_item.FolderId, cand.Type, cand.Id);
            }
            ToastService.ShowToast(ToastIntent.Success, L["media_detail.review_applied"]);
            // Reload everything.
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ToastIntent.Error, ex.Message);
        }
        finally
        {
            _applyingCandidate = false;
        }
    }

    private async Task BuildEpisodeFileMapAsync(Guid folderId, string folderPath, FolderType folderType)
    {
        _episodeFileMap = [];
        if (!Directory.Exists(folderPath)) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var globalPatterns = await db.RenamePatterns
                .Where(p => p.Scope == PatternScope.Global)
                .ToListAsync();
            var fw = await db.FolderWatchers
                .Include(f => f.Patterns)
                .FirstOrDefaultAsync(f => f.Id == folderId);
            if (fw is null) return;

            var excludedIds = fw.Patterns
                .Where(p => p.IsExcluded && p.GlobalPatternId.HasValue)
                .Select(p => p.GlobalPatternId!.Value)
                .ToHashSet();
            var isMovie = folderType == FolderType.Movie;
            var effectivePatterns = globalPatterns
                .Where(p => !excludedIds.Contains(p.Id))
                .Concat(fw.Patterns.Where(p => !p.IsExcluded))
                .Where(p => p.ApplicableTo is null || (isMovie ? p.ApplicableTo == FolderType.Movie : p.ApplicableTo != FolderType.Movie))
                .OrderBy(p => p.Priority)
                .ToList();

            var videoExts = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
                { ".mkv", ".mp4", ".avi", ".m4v", ".mov", ".wmv", ".ts", ".m2ts" };

            // Pass 1 — pattern-based (precise).
            var unmatchedBySeason = new Dictionary<int, List<string>>();
            foreach (var filePath in Directory.EnumerateFiles(folderPath, "*", SearchOption.AllDirectories))
            {
                if (!videoExts.Contains(Path.GetExtension(filePath))) continue;
                var fileName = Path.GetFileName(filePath);
                var parse    = PatternMatch.ParseFileName(fileName, effectivePatterns);
                var fileDir  = Path.GetDirectoryName(filePath) ?? folderPath;

                // Resolution order for the season number:
                //   1. Explicit in filename (S02E03 → 2)
                //   2. "Season N" / "Сезон N" on any parent dir
                //   3. Fuzzy match of any parent dir name against TMDB season Names
                //      (so a folder named "Thousand Year War" maps to Bleach's
                //      Season 17 "The Thousand-Year Blood War")
                //   4. Single-TMDB-season fallback
                //   5. Default 1
                int? seasonGuess = parse.Season
                    ?? PatternMatch.DetectSeasonFromPath(fileDir, folderPath)
                    ?? FuzzyMatchSeasonFromDirNames(fileDir, folderPath);

                int seasonNum = seasonGuess ?? 1;

                if (parse.IsMatched)
                {
                    // If the detected season has no TMDB counterpart but the show has
                    // exactly one TMDB season (e.g. Chinese donghua named "Season 3"
                    // locally while TMDB lumps everything as Season 1), remap into
                    // that single TMDB season so files line up with episode tabs.
                    var effective = seasonNum;
                    if (_seasons.All(s => s.Number != seasonNum) && _seasons.Count == 1)
                        effective = _seasons[0].Number;

                    var key = (effective, parse.Episode);
                    if (!_episodeFileMap.ContainsKey(key))
                        _episodeFileMap[key] = filePath;
                }
                else
                {
                    // Phase 2.4: collect for fuzzy pass below.
                    if (!unmatchedBySeason.TryGetValue(seasonNum, out var list))
                        unmatchedBySeason[seasonNum] = list = new List<string>();
                    list.Add(filePath);
                }
            }

            // Pass 2 — fuzzy fallback (Phase 2.4):
            // For each season where pattern matching missed everything, if the number
            // of unmatched video files exactly matches the TMDB episode count of that
            // season, assume natural order = sequential episodes.
            foreach (var (season, files) in unmatchedBySeason)
            {
                if (files.Count == 0) continue;

                // Find the TMDB season this user-bucket maps to. If the detected
                // season number doesn't exist in TMDB's metadata (common for Chinese
                // donghua where TMDB lumps everything as Season 1 but the user names
                // local folders Season 2 / Season 3 by airing-block convention),
                // fall back to the show's only TMDB season.
                var seasonMeta = _seasons.FirstOrDefault(s => s.Number == season);
                int effectiveSeason = season;
                if (seasonMeta is null)
                {
                    if (_seasons.Count == 1)
                    {
                        seasonMeta = _seasons[0];
                        effectiveSeason = seasonMeta.Number;
                        Logger.LogInformation(
                            "Folder Season {Folder} not in TMDB metadata; mapping into the show's only TMDB season {Tmdb}.",
                            season, effectiveSeason);
                    }
                    else continue;
                }
                if (seasonMeta.EpisodeCount <= 0) continue;
                // Only run fuzzy when pattern matched none of the effective season's episodes —
                // otherwise we'd mis-align with partial pattern matches.
                bool anyPatternHit = _episodeFileMap.Keys.Any(k => k.s == effectiveSeason);
                if (anyPatternHit) continue;

                var ordered = files.OrderBy(p => p, NaturalStringComparer.Ordinal).ToList();
                if (ordered.Count == seasonMeta.EpisodeCount)
                {
                    for (int i = 0; i < ordered.Count; i++)
                    {
                        var key = (effectiveSeason, i + 1);
                        _episodeFileMap.TryAdd(key, ordered[i]);
                    }
                    Logger.LogInformation(
                        "Fuzzy episode mapping: season {S} matched {N} files by order in {Folder}",
                        effectiveSeason, ordered.Count, folderPath);
                }
                else
                {
                    // Counts don't match (e.g. user has 59 files but TMDB lists 200).
                    // Still show them — map by episode number parsed from filename
                    // (or natural order index) into the effective season's slots.
                    for (int i = 0; i < ordered.Count; i++)
                    {
                        var fileName = Path.GetFileName(ordered[i]);
                        var parse = PatternMatch.ParseFileName(fileName, effectivePatterns);
                        var ep = parse.IsMatched && parse.Episode > 0 ? parse.Episode : i + 1;
                        var key = (effectiveSeason, ep);
                        _episodeFileMap.TryAdd(key, ordered[i]);
                    }
                    Logger.LogInformation(
                        "Number-anchored mapping: season {S} mapped {N} files into TMDB slots (out of {Total}) in {Folder}",
                        effectiveSeason, ordered.Count, seasonMeta.EpisodeCount, folderPath);
                    if (await IsLlmMappingEnabledAsync())
                    {
                        // Phase 3.3: AI fallback when episode names matter (opt-in).
                        await TryLlmMapFilesToEpisodesAsync(effectiveSeason, files, seasonMeta);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            // Non-critical: if episode map fails, fall back to showing all episodes
            Logger.LogWarning(ex, "BuildEpisodeFileMap failed");
            _episodeFileMap = [];
        }
    }

    /// <summary>
    /// Walk up the path from <paramref name="fileDir"/> to <paramref name="folderRoot"/>
    /// (capped at 5 levels) and fuzzy-match each ancestor's name against the TMDB
    /// season Names. Returns the best-matching season Number when similarity is
    /// high enough, otherwise null. Lets a local folder "Thousand Year War" map
    /// to Bleach Season 17 "The Thousand-Year Blood War" without exact naming.
    /// </summary>
    private int? FuzzyMatchSeasonFromDirNames(string fileDir, string folderRoot)
    {
        if (_seasons.Count < 2) return null;  // ambiguity needs at least 2 seasons

        var namedSeasons = _seasons
            .Where(s => !string.IsNullOrWhiteSpace(s.Name))
            .Select(s => (s.Number, NormalisedName: NormaliseForSeasonMatch(s.Name!)))
            .Where(t => t.NormalisedName.Length > 2)
            .ToList();
        if (namedSeasons.Count == 0) return null;

        var rootNorm = folderRoot.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var dir = new DirectoryInfo(fileDir);
        for (int i = 0; i < 5 && dir != null; i++, dir = dir.Parent!)
        {
            var candidateName = NormaliseForSeasonMatch(dir.Name);
            if (candidateName.Length > 2)
            {
                var best = namedSeasons
                    .Select(t => (t.Number, Score: TitleWordOverlap(candidateName, t.NormalisedName)))
                    .OrderByDescending(t => t.Score)
                    .First();
                if (best.Score >= 0.5)
                    return best.Number;
            }
            if (string.Equals(dir.FullName.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                              rootNorm, StringComparison.OrdinalIgnoreCase))
                break;
        }
        return null;
    }

    private static string NormaliseForSeasonMatch(string s)
    {
        // Lowercase, strip non-alphanumeric, collapse common stopwords.
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var c in s)
            sb.Append(char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : ' ');
        var words = sb.ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var stopwords = new HashSet<string>(StringComparer.Ordinal)
            { "the", "of", "a", "an", "and", "season", "part", "arc", "saga" };
        return string.Join(' ', words.Where(w => !stopwords.Contains(w)));
    }

    private static double TitleWordOverlap(string a, string b)
    {
        var aw = a.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
        var bw = b.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
        if (aw.Count == 0 || bw.Count == 0) return 0;
        // Jaccard on word sets.
        var inter = aw.Intersect(bw).Count();
        var union = aw.Union(bw).Count();
        return (double)inter / union;
    }

    private async Task<bool> IsLlmMappingEnabledAsync()
    {
        // Two gates: LLM has to be enabled overall AND the episode-mapping fallback is opt-in.
        var llmOn = await AppConfig.GetAsync<bool>(AppConfigKeys.LlmEnabled, false);
        if (!llmOn) return false;
        return await AppConfig.GetAsync<bool>(AppConfigKeys.LlmEpisodeMapping, false);
    }

    private async Task TryLlmMapFilesToEpisodesAsync(int season, List<string> files, SeasonMeta seasonMeta)
    {
        // Need episode list from already-loaded _episodesBySeason or lazy-load.
        if (!_episodesBySeason.TryGetValue(season, out var eps) || eps.Count == 0)
        {
            if (_item?.TmdbId is null) return;
            await LoadSeasonEpisodesAsync(season);
            if (!_episodesBySeason.TryGetValue(season, out eps) || eps.Count == 0) return;
        }

        var fileNames = files.Select(Path.GetFileName).Where(n => n != null).Cast<string>().ToList();
        var epList    = eps.Select(e => (e.Number, e.Name ?? "")).ToList();
        try
        {
            var mapping = await Llm.MapFilesToEpisodesAsync(fileNames, epList);
            if (mapping is null || mapping.Count == 0)
            {
                Logger.LogDebug("LLM mapping returned nothing for season {S}", season);
                return;
            }
            foreach (var (fileIdx, epNum) in mapping)
            {
                var key = (season, epNum);
                _episodeFileMap.TryAdd(key, files[fileIdx]);
            }
            Logger.LogInformation("LLM episode mapping: season {S} matched {N} files in {Folder}",
                season, mapping.Count, _item?.Folder?.Path);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LLM file→episode mapping threw");
        }
    }

    private void LoadFilesystem(string folderPath)
    {
        _subDirs  = [];
        _subFiles = [];

        if (!Directory.Exists(folderPath)) return;

        try
        {
            _subDirs = Directory.EnumerateDirectories(folderPath)
                .Where(d => !Path.GetFileName(d).StartsWith('.'))
                .Select(d => new SubDirEntry(Path.GetFileName(d), d, FindSubPoster(d, folderPath)))
                .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch { /* directory not accessible */ }

        try
        {
            var allExts = MediaExtensions.Concat(SubtitleExtensions).ToHashSet();
            _subFiles = Directory.EnumerateFiles(folderPath)
                .Where(f => allExts.Contains(Path.GetExtension(f).ToLowerInvariant()))
                .Select(f =>
                {
                    var info = new FileInfo(f);
                    return new FileEntry(info.Name, info.Length, Path.GetExtension(f).ToLowerInvariant(), f);
                })
                .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch { /* directory not accessible */ }
    }

    private string? FindSubPoster(string subDir, string parentPath)
    {
        var candidates = new[]
        {
            (Path.Combine(".animarr", "poster.jpg"), Path.Combine(subDir, ".animarr", "poster.jpg")),
            (Path.Combine(".animarr", "poster.png"), Path.Combine(subDir, ".animarr", "poster.png")),
            ("poster.jpg",  Path.Combine(subDir, "poster.jpg")),
            ("poster.png",  Path.Combine(subDir, "poster.png")),
            ("folder.jpg",  Path.Combine(subDir, "folder.jpg")),
            ("cover.jpg",   Path.Combine(subDir, "cover.jpg")),
        };
        foreach (var (rel, full) in candidates)
        {
            if (File.Exists(full))
                return BuildUrl(parentPath, Path.Combine(Path.GetFileName(subDir), rel));
        }
        return null;
    }

