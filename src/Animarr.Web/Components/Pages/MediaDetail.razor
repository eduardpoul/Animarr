    private static string? BuildUrl(string folderPath, string? relativePath, long v = 0)
    {
        if (string.IsNullOrEmpty(relativePath)) return null;
        var full = Path.Combine(folderPath, relativePath);
        return $"/api/image?path={Uri.EscapeDataString(full)}&t={v}";
    }

    private static T? ParseJson<T>(string? json)
    {
        if (string.IsNullOrEmpty(json)) return default;
        try { return System.Text.Json.JsonSerializer.Deserialize<T>(json); }
        catch { return default; }
    }

    private static bool IsVideo(string ext) => MediaExtensions.Contains(ext);

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824.0:F1} GB",
        >= 1_048_576     => $"{bytes / 1_048_576.0:F0} MB",
        >= 1_024         => $"{bytes / 1_024.0:F0} KB",
        _                => $"{bytes} B",
    };

    private async Task LoadSeasonEpisodesAsync(int seasonNumber)
    {
        if (_item?.TmdbId is null || _item.Folder is null) return;
        var detail = await TmdbClient.GetSeasonDetailAsync(_item.TmdbId.Value, seasonNumber);
        if (detail is null) return;

        var vms = new List<EpisodeVm>();
        foreach (var ep in detail.Episodes)
        {
            // Show ALL episodes from TMDB. Whether the file is physically on
            // disk is communicated via a ✓ / download icon on the episode card.
            string? stillUrl = null;
            if (_downloadThumbs && ep.StillPath != null && _item.Folder != null)
            {
                // Episode stills live in the central image cache, not the media
                // tree — keeps Animarr from creating folders inside the user's
                // show directories.
                var fileName  = $"s{seasonNumber:D2}e{ep.EpisodeNumber:D2}_still.jpg";
                var cacheDir  = CachePaths.ForFolder(_item.Folder.Id);
                var localPath = Path.Combine(cacheDir, fileName);
                if (!File.Exists(localPath))
                    await TmdbClient.DownloadImageAsync(TmdbClient.StillUrl(ep.StillPath), localPath);
                stillUrl = BuildUrl(_item.Folder.Path, localPath);
            }
            else if (ep.StillPath != null)
            {
                stillUrl = TmdbClient.StillUrl(ep.StillPath, "w300");
            }

            _episodeFileMap.TryGetValue((seasonNumber, ep.EpisodeNumber), out var diskFileName);
            vms.Add(new EpisodeVm(ep.EpisodeNumber, ep.Name, ep.Overview, stillUrl, diskFileName));
        }
        _episodesBySeason[seasonNumber] = vms;
    }

    private async Task ReidentifyAsync()
    {
        if (_item is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.IdentificationQueues.AnyAsync(q =>
            q.FolderId == _item.FolderId && q.Status <= IdentificationQueueStatus.Processing))
        {
            db.IdentificationQueues.Add(new IdentificationQueue
            {
                Id           = Guid.NewGuid(),
                FolderId     = _item.FolderId,
                ForceRefresh = true,
                QueuedAt     = DateTime.UtcNow,
            });
            await db.SaveChangesAsync();
            ToastService.ShowToast(ToastIntent.Info, L["catalog.btn_reidentify"]);
        }
    }

    private record EpisodeVm(int Number, string Name, string? Overview, string? StillUrl, string? FileName = null);

    /// <summary>Surface-level format guess for a movie's file metadata cells.
    /// Resolution + codec are sniffed from the filename via regex (consistent
    /// with the per-episode meta builder). Size comes from FileInfo. No DB
    /// columns are persisted for this — CHANGELOG §3 explicitly says "Don't
    /// add new DB columns."
    /// TODO: Once ffprobe metadata lands on FolderWatcher/MediaItem, swap
    /// these sniffs for the persisted values. </summary>
    private record MovieFileInfo(string? Resolution, string? Codec, string? Size);

    private static MovieFileInfo SniffMovieFile(string? path)
    {
        if (string.IsNullOrEmpty(path)) return new MovieFileInfo(null, null, null);
        string? res = null, codec = null, size = null;
        var name = Path.GetFileName(path);
        var resMatch = System.Text.RegularExpressions.Regex.Match(name, @"\b(2160|1440|1080|720|480)p\b");
        if (resMatch.Success) res = resMatch.Value;
        var codecMatch = System.Text.RegularExpressions.Regex.Match(
            name, @"\b(H\.?265|H\.?264|HEVC|AVC|x264|x265|AV1)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (codecMatch.Success) codec = codecMatch.Value.ToUpperInvariant();
        try
        {
            if (File.Exists(path))
            {
                var bytes  = new FileInfo(path).Length;
                var sizeGb = bytes / 1024d / 1024d / 1024d;
                size = sizeGb >= 1 ? $"{sizeGb:F2} GB" : $"{bytes / 1024d / 1024d:F0} MB";
            }
        }
        catch { /* ignore */ }
        return new MovieFileInfo(res, codec, size);
    }

    /// <summary>
    /// Build the mono meta line under an on-disk episode title. CHANGELOG §4
    /// canonical form: "{runtime} · 1080p · H.265 · {size}". Each segment
    /// drops out gracefully when unparseable, so a low-info file just shows
    /// "{runtime} · {size}". No status words ("Watched", "Not downloaded",
    /// "38% watched") — visuals carry that load now.
    /// </summary>
    private string BuildEpisodeMeta(EpisodeVm ep)
    {
        var parts = new List<string>();
        if (_item?.Runtime is > 0) parts.Add($"{_item.Runtime}m");

        if (!string.IsNullOrEmpty(ep.FileName) && File.Exists(ep.FileName))
        {
            try
            {
                var size  = new FileInfo(ep.FileName).Length;
                var name  = Path.GetFileName(ep.FileName);
                var res   = System.Text.RegularExpressions.Regex.Match(name, @"\b(2160|1440|1080|720|480)p\b");
                if (res.Success) parts.Add(res.Value);
                var codec = System.Text.RegularExpressions.Regex.Match(name, @"\b(H\.?265|H\.?264|HEVC|AVC|x264|x265|AV1)\b",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (codec.Success) parts.Add(codec.Value.ToUpperInvariant());
                var sizeGb = size / 1024d / 1024d / 1024d;
                parts.Add(sizeGb >= 1
                    ? $"{sizeGb:F2} GB"
                    : $"{size / 1024d / 1024d:F0} MB");
            }
            catch { /* ignore — fall back to runtime-only */ }
        }
        return string.Join(" · ", parts);
    }

    /// <summary>Meta line for missing episodes — CHANGELOG §4 mandates
    /// "{runtime} · Missing" with no other status words.</summary>
    private string BuildMissingMeta(EpisodeVm _)
    {
        var runtime = _item?.Runtime is > 0 ? $"{_item.Runtime}m" : null;
        return runtime is not null ? $"{runtime} · Missing" : "Missing";
    }
    private record SubDirEntry(string Name, string Path, string? PosterUrl);
    private record FileEntry(string Name, long Size, string Ext, string FullPath = "");
}
