    private async Task LoadSubDirMediaIdsAsync(AppDbContext db, string parentFolderPath)
    {
        _subDirMediaIds = [];
        if (_subDirs.Count == 0) return;

        var subPaths = _subDirs.Select(d => d.Path).ToList();
        var matches = await db.FolderWatchers
            .Where(f => subPaths.Contains(f.Path))
            .Select(f => new { f.Path, f.Id })
            .ToListAsync();

        if (matches.Count == 0) return;

        var folderIds = matches.Select(m => m.Id).ToList();
        var mediaItems = await db.MediaItems
            .Where(m => folderIds.Contains(m.FolderId))
            .Select(m => new { m.FolderId, m.Id })
            .ToListAsync();

        var folderIdToPath = matches.ToDictionary(m => m.Id, m => m.Path);
        foreach (var mi in mediaItems)
        {
            if (folderIdToPath.TryGetValue(mi.FolderId, out var p))
                _subDirMediaIds[p] = mi.Id;
        }
    }

