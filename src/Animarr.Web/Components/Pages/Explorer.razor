}




@code {
    // ── Section management (DB state) ──────────────────────────────
    private List<FolderWatcher> _sections = [];
    private Dictionary<Guid, List<FolderWatcher>> _children = [];
    private List<FolderWatcher> _standalone = [];
    private bool _loading = true;

    // ── Navigation ─────────────────────────────────────────────────
    private record NavEntry(string Path, string Label);
    private List<NavEntry> _navStack = [];

    // Root grid
    private List<FolderWatcher> _allRootFolders = [];

    // Current folder contents
    private List<string>    _subDirs  = [];
    private List<FileEntry> _subFiles = [];
    private Dictionary<string, string> _posterUrls = [];
    private record FileEntry(string Path, string Name, long Size, DateTime Modified);

    private record SeasonInfo
    {
        public int     Number     { get; init; }
        public string? PosterPath { get; init; }
    }

    // Current folder header
    private FolderWatcher? _currentFolderWatcher;
    private string?        _currentFolderPosterUrl;
    private bool           _backdropOwned;
    private bool           _pendingBackdropUpdate;

    // File rename inline
    private FileEntry? _renameTarget;
    private string     _renameValue = "";

    // File delete dialog
    private bool       _fileDeleteHidden = true;
    private FileEntry? _fileDeleteTarget;

    // ── Section add/edit dialog ────────────────────────────────────
    private bool _sectionDialogHidden = true;
    private FolderWatcher? _sectionEditTarget;
    private string _formPath = "";
    private string _formLabel = "";
    private bool _formWatch = true;
    private bool _formRenameEnabled = true;
    private bool _formFlatSection = false;
    private string _formFolderTypeStr = "Auto";
    // Phase 1.4: derived master toggle.
    private bool _formActive => _formWatch && _formRenameEnabled;

    // Folder picker (embedded in add dialog)
    private List<DriveInfo> _drives = [];
    private string? _pickerCurrent;
    private List<string> _pickerChildren = [];
    private bool _pickerMode = false;

    // ── Edit folder panel ──────────────────────────────────────────
    private FolderWatcher? _editTarget;

    // ── Delete dialog ──────────────────────────────────────────────
    private bool _deleteHidden = true;
    private FolderWatcher? _deleteTarget;
    private bool _deleteIsSection;
    private bool _deleteGoBack;
    private bool _deleteFromDisk;

    // ── Init ───────────────────────────────────────────────────────

    [SupplyParameterFromQuery(Name = "path")]
    public string? InitPath { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // Deep-link: navigate directly into the given path
        if (!string.IsNullOrWhiteSpace(InitPath))
        {
            // Build navStack from InitPath — walk up from root until we find
            // the topmost registered FolderWatcher ancestor, then push remaining segments
            var target = Path.GetFullPath(InitPath);
            // Find the deepest registered root that is an ancestor of target
            var allRoots = _allRootFolders.Select(f =>
                Path.GetFullPath(f.Path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                .OrderByDescending(p => p.Length)
                .ToList();
            var root = allRoots.FirstOrDefault(r =>
                target.StartsWith(r + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase)
                || target.Equals(r, StringComparison.OrdinalIgnoreCase));
            if (root != null)
            {
                // Push ancestor crumbs
                var rootFolder = _allRootFolders.First(f =>
                    Path.GetFullPath(f.Path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                    .Equals(root, StringComparison.OrdinalIgnoreCase));
                _navStack.Add(new NavEntry(rootFolder.Path, rootFolder.Label));
                // Push intermediate segments
                var rel = target.Substring(root.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                if (!string.IsNullOrEmpty(rel))
                {
                    var current = root;
                    foreach (var seg in rel.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                    {
                        current = Path.Combine(current, seg);
                        _navStack.Add(new NavEntry(current, seg));
                    }
                }
                await LoadCurrentDirAsync();
            }
        }

        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.FolderWatchers.OrderBy(f => f.Label).ToListAsync();
        _sections   = all.Where(f => f.IsSection).ToList();
        _children   = all
            .Where(f => !f.IsSection && f.ParentSectionId.HasValue)
            .GroupBy(f => f.ParentSectionId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());
        _standalone = all.Where(f => !f.IsSection && !f.ParentSectionId.HasValue).ToList();

        _allRootFolders = _sections.Concat(_standalone).OrderBy(f => f.Label).ToList();

        // Load posters for root folder cards
        // For standalone folders: use their own poster.
        // For section folders: pick a random poster from child MediaItems.
        _posterUrls = [];

        // Standalone posters
        var standaloneIds = _standalone.Select(f => f.Id).ToList();
        if (standaloneIds.Count > 0)
        {
            var standalonePosters = await db.MediaItems
                .Where(m => standaloneIds.Contains(m.FolderId) && m.PosterPath != null)
                .Select(m => new { m.FolderId, m.PosterPath, FolderPath = m.Folder!.Path, m.LastMetadataRefreshedAt })
                .ToListAsync();
            foreach (var p in standalonePosters)
            {
                var t = p.LastMetadataRefreshedAt?.Ticks ?? 0;
                _posterUrls[p.FolderPath] = $"/api/image?path={Uri.EscapeDataString(Path.Combine(p.FolderPath, p.PosterPath!))}&t={t}";
            }
        }

        // Section posters — pick random from children
        foreach (var section in _sections)
        {
            var childIds = _children.TryGetValue(section.Id, out var ch) ? ch.Select(f => f.Id).ToList() : [];
            if (childIds.Count == 0) continue;
            var childPosters = await db.MediaItems
                .Where(m => childIds.Contains(m.FolderId) && m.PosterPath != null)
                .Select(m => new { m.FolderId, m.PosterPath, FolderPath = m.Folder!.Path, m.LastMetadataRefreshedAt })
                .ToListAsync();
            if (childPosters.Count == 0) continue;
            var pick = childPosters[Random.Shared.Next(childPosters.Count)];
            var pickT = pick.LastMetadataRefreshedAt?.Ticks ?? 0;
            _posterUrls[section.Path] = $"/api/image?path={Uri.EscapeDataString(Path.Combine(pick.FolderPath, pick.PosterPath!))}&t={pickT}&r={Random.Shared.Next()}";
        }

        _pendingBackdropUpdate = true;
    }

    // ── Navigation ─────────────────────────────────────────────────

    private async Task NavigateInto(string path, string label)
    {
        _loading = true;
        StateHasChanged();
        _navStack.Add(new NavEntry(path, label));
        await LoadCurrentDirAsync();
    }

    private async Task NavigateBack()
    {
        if (_navStack.Count == 0) return;
        _loading = true;
        StateHasChanged();
        _navStack.RemoveAt(_navStack.Count - 1);
        if (_navStack.Count == 0)
        {
            await LoadAsync();
            _loading = false;
        }
        else
        {
            await LoadCurrentDirAsync();
        }
    }

    private async Task NavigateRoot()
    {
        if (_navStack.Count == 0) return;
        _navStack.Clear();
        _loading = true;
        StateHasChanged();
        await LoadAsync();
        _loading = false;
    }

    private async Task NavigateToCrumb(int idx)
    {
        _navStack = [.._navStack.Take(idx + 1)];
        _loading = true;
        StateHasChanged();
        await LoadCurrentDirAsync();
    }

    private async Task LoadCurrentDirAsync()
    {
        var path = _navStack[^1].Path;
        _subDirs  = [];
        _subFiles = [];
        _posterUrls = [];
        _currentFolderWatcher   = null;
        _currentFolderPosterUrl = null;

        try
        {
            _subDirs = [..Directory.GetDirectories(path)
                .Select(d => d.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                .OrderBy(d => d, StringComparer.OrdinalIgnoreCase)];

            _subFiles = [..Directory.GetFiles(path)
                .Select(f => { var fi = new FileInfo(f); return new FileEntry(fi.FullName, fi.Name, fi.Length, fi.LastWriteTime); })
                .OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase)];
        }
        catch { /* access denied or path not found */ }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Find FolderWatcher for current path (case-insensitive for cross-platform compat)
        var normPath = path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var allWatchers = await db.FolderWatchers
            .Where(f => f.SingleFilePath == null)
            .Select(f => new { f.Id, f.Path, f.IsSection, f.ParentSectionId, f.FolderType,
                               f.WatchEnabled, f.RenameEnabled, f.IdentifyEnabled, f.Label,
                               f.FlatSection, f.CreatedAt })
            .ToListAsync();
        var matchedRow = allWatchers.FirstOrDefault(f =>
            string.Equals(f.Path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                          normPath, StringComparison.OrdinalIgnoreCase));
        if (matchedRow != null)
            _currentFolderWatcher = await db.FolderWatchers.FindAsync(matchedRow.Id);

        if (_currentFolderWatcher != null)
        {
            if (_currentFolderWatcher.IsSection)
            {
                // Section has no own MediaItem — pick a random poster from child folders
                var childIds = await db.FolderWatchers
                    .Where(f => f.ParentSectionId == _currentFolderWatcher.Id)
                    .Select(f => f.Id)
                    .ToListAsync();
                if (childIds.Count > 0)
                {
                    var childPosters = await db.MediaItems
                        .Where(m => childIds.Contains(m.FolderId) && m.PosterPath != null)
                        .Select(m => new { m.PosterPath, FolderPath = m.Folder!.Path, m.LastMetadataRefreshedAt })
                        .ToListAsync();
                    if (childPosters.Count > 0)
                    {
                        var pick = childPosters[Random.Shared.Next(childPosters.Count)];
                        var pickT = pick.LastMetadataRefreshedAt?.Ticks ?? 0;
                        _currentFolderPosterUrl = $"/api/image?path={Uri.EscapeDataString(Path.Combine(pick.FolderPath, pick.PosterPath!))}&t={pickT}&r={Random.Shared.Next()}";
                    }
                }
            }
            else
            {
                var mi = await db.MediaItems
                    .Where(m => m.FolderId == _currentFolderWatcher.Id && m.PosterPath != null)
                    .Select(m => new { m.PosterPath, m.LastMetadataRefreshedAt })
                    .FirstOrDefaultAsync();
                if (mi?.PosterPath != null)
                {
                    var t = mi.LastMetadataRefreshedAt?.Ticks ?? 0;
                    _currentFolderPosterUrl = $"/api/image?path={Uri.EscapeDataString(Path.Combine(normPath, mi.PosterPath))}&t={t}";
                }
            }
        }

        if (_subDirs.Count > 0)
        {
            var posters = await db.MediaItems
                .Include(m => m.Folder)
                .Where(m => _subDirs.Contains(m.Folder!.Path) && m.PosterPath != null)
                .Select(m => new { FolderPath = m.Folder!.Path, m.PosterPath, m.LastMetadataRefreshedAt })
                .ToListAsync();
            // Skip entries whose poster file actually doesn't exist — happens
            // after the image-cache relocation when old PosterPath values still
            // point at the deleted ".animarr/" cache. The folder icon shows up
            // for those cards instead of a broken-image black rectangle.
            _posterUrls = posters
                .Where(p => File.Exists(Path.Combine(p.FolderPath, p.PosterPath!)))
                .ToDictionary(
                    p => p.FolderPath,
                    p => $"/api/image?path={Uri.EscapeDataString(Path.Combine(p.FolderPath, p.PosterPath!))}&t={p.LastMetadataRefreshedAt?.Ticks ?? 0}");
        }

        // Season posters: if current folder's MediaItem has SeasonsJson, map subdir → season poster
        if (_currentFolderWatcher != null)
        {
            var currentMi = await db.MediaItems
                .Where(m => m.FolderId == _currentFolderWatcher.Id && m.SeasonsJson != null)
                .Select(m => new { m.SeasonsJson })
                .FirstOrDefaultAsync();
            if (currentMi?.SeasonsJson != null)
            {
                try
                {
                    var seasons = System.Text.Json.JsonSerializer.Deserialize<List<SeasonInfo>>(currentMi.SeasonsJson,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (seasons != null)
                    {
                        foreach (var season in seasons.Where(s => s.PosterPath != null))
                        {
                            // Match subdirs by season number: Season 01, S01, season1, etc.
                            var seasonDir = _subDirs.FirstOrDefault(d =>
                            {
                                var name = Path.GetFileName(d);
                                return System.Text.RegularExpressions.Regex.IsMatch(name,
                                    $@"(?i)^s(eason[\s._-]*)0*{season.Number}$");
                            });
                            if (seasonDir != null && !_posterUrls.ContainsKey(seasonDir))
                                _posterUrls[seasonDir] = $"/api/image?path={Uri.EscapeDataString(Path.Combine(normPath, season.PosterPath!))}";
                        }
                    }
                }
                catch { /* malformed JSON */ }
            }

            // Hide our own metadata cache dirs (".animarr" / ".metadata"), but DO show
            // real subfolders like "Season 1" / "Season 3" so the user can navigate
            // into them from Explorer (was previously hidden, leaving seasonal layouts
            // looking empty in Explorer even though MediaDetail had the episodes list).
            _subDirs = _subDirs
                .Where(d => Path.GetFileName(d) is { Length: > 0 } n
                            && !n.StartsWith('.')
                            && !string.Equals(n, ".animarr", StringComparison.OrdinalIgnoreCase)
                            && !string.Equals(n, ".metadata", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else if (_navStack.Count >= 2)
        {
            // Same dot-prefixed filtering when the parent is a registered section but
            // this folder isn't itself tracked.
            _subDirs = _subDirs
                .Where(d => Path.GetFileName(d) is { Length: > 0 } n && !n.StartsWith('.'))
                .ToList();
        }

        _loading = false;
        _pendingBackdropUpdate = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _pendingBackdropUpdate)
        {
            _pendingBackdropUpdate = false;
            await UpdateBackdropAsync();
        }
    }

    private void EditRootFolder(FolderWatcher folder)
    {
        if (folder.IsSection) OpenSectionDialog(folder);
        else OpenEditPanel(folder);
    }

    private static string FormatFileSize(long bytes) => bytes switch    {
        < 1024               => $"{bytes} B",
        < 1024 * 1024        => $"{bytes / 1024.0:F1} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        _                    => $"{bytes / (1024.0 * 1024 * 1024):F1} GB",
    };

    // ── File rename ────────────────────────────────────────────────

    private void StartRenameFile(FileEntry file)
    {
        _renameTarget = file;
        _renameValue  = file.Name;
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")  await ConfirmRenameFile();
        if (e.Key == "Escape") _renameTarget = null;
    }

    private async Task ConfirmRenameFile()
    {
        if (_renameTarget is null) return;
        var newName = _renameValue.Trim();
        if (string.IsNullOrEmpty(newName) || newName == _renameTarget.Name)
        {
            _renameTarget = null;
            return;
        }
        var dir     = Path.GetDirectoryName(_renameTarget.Path)!;
        var newPath = Path.Combine(dir, newName);
        try
        {
            File.Move(_renameTarget.Path, newPath);
            ToastService.ShowToast(ToastIntent.Success,
                L.Get("folder_files.toast_file_renamed", _renameTarget.Name, newName));
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ToastIntent.Error, L.Get("folder_files.toast_error", ex.Message));
        }
        _renameTarget = null;
        await LoadCurrentDirAsync();
    }

    // ── File delete ────────────────────────────────────────────────

    private void AskDeleteFile(FileEntry file)
    {
        _fileDeleteTarget = file;
        _fileDeleteHidden = false;
    }

    private async Task ConfirmDeleteFile()
    {
        _fileDeleteHidden = true;
        if (_fileDeleteTarget is null) return;
        var name = _fileDeleteTarget.Name;
        try
        {
            File.Delete(_fileDeleteTarget.Path);
            ToastService.ShowToast(ToastIntent.Success, L.Get("folder_files.toast_file_deleted", name));
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ToastIntent.Error, L.Get("folder_files.toast_error", ex.Message));
        }
        _fileDeleteTarget = null;
        await LoadCurrentDirAsync();
    }

    private static Icon GetFileIcon(string name)
    {
        return Path.GetExtension(name).ToLowerInvariant() switch
        {
            ".mkv" or ".mp4" or ".avi" or ".mov" or ".wmv" or ".flv" or ".webm" or ".m2ts" or ".ts" or ".m4v"
                => new Icons.Regular.Size20.VideoClip(),
            ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".bmp" or ".tiff"
                => new Icons.Regular.Size20.Image(),
            _ => new Icons.Regular.Size20.Document(),
        };
    }

    // ── Edit panel ─────────────────────────────────────────────────

    private string? _previewImageUrl;
    private void OpenImagePreview(string path) => _previewImageUrl = $"/api/image?path={Uri.EscapeDataString(path)}";
    private void CloseImagePreview()           => _previewImageUrl = null;

    private string? _playerPath;
    private void OpenVideoPlayer(string path)  => _playerPath = path;
    private void CloseVideoPlayer()            => _playerPath = null;

    private static bool IsImageFile(string name) => Path.GetExtension(name).ToLowerInvariant() is
        ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".bmp" or ".tiff";

    private static bool IsVideoFile(string name) => Path.GetExtension(name).ToLowerInvariant() is
        ".mp4" or ".webm" or ".mkv" or ".avi" or ".mov" or ".m4v" or ".wmv" or ".ts" or ".m2ts";

    private void OpenEditPanel(FolderWatcher folder) => _editTarget = folder;

    private async Task HandleEditSaved()
    {
        _editTarget = null;
        await LoadAsync();
    }

    private void CloseEditPanel() => _editTarget = null;


    // ── Section add/edit ───────────────────────────────────────────

    private void OpenPicker()
    {
        _drives = DriveInfo.GetDrives().Where(d => d.IsReady).ToList();
        _pickerCurrent = null;
        _pickerChildren = [];
        _pickerMode = true;
    }

    private void PickerSelectDrive(string rootPath)
    {
        _pickerCurrent = rootPath.TrimEnd(Path.DirectorySeparatorChar, '/');
        _pickerChildren = GetSafeChildren(_pickerCurrent);
    }

    private void PickerNavigateInto(string dir)
    {
        _pickerCurrent = dir;
        _pickerChildren = GetSafeChildren(dir);
    }

    private void PickerNavigateUp()
    {
        if (_pickerCurrent is null) return;
        var parent = Path.GetDirectoryName(_pickerCurrent);
        if (string.IsNullOrEmpty(parent))
        {
            _pickerCurrent = null;
            _pickerChildren = [];
        }
        else
        {
            _pickerCurrent = parent;
            _pickerChildren = GetSafeChildren(parent);
        }
    }

    private void PickerConfirm()
    {
        if (_pickerCurrent is not null)
        {
            _formPath = _pickerCurrent;
            if (string.IsNullOrWhiteSpace(_formLabel))
                _formLabel = Path.GetFileName(_pickerCurrent) ?? _pickerCurrent;
        }
        _pickerMode = false;
    }

    private static List<string> GetSafeChildren(string dir)
    {
        try { return [.. Directory.GetDirectories(dir).OrderBy(d => d)]; }
        catch { return []; }
    }

    private void OpenSectionDialog(FolderWatcher? section)
    {
        _sectionEditTarget   = section;
        _formPath            = section?.Path ?? "";
        _formLabel           = section?.Label ?? "";
        _formWatch           = section?.WatchEnabled ?? true;
        _formRenameEnabled   = section?.RenameEnabled ?? true;
        _formFlatSection     = section?.FlatSection ?? false;
        _formFolderTypeStr   = (section?.FolderType ?? FolderType.Auto).ToString();
        _pickerMode          = false;
        _sectionDialogHidden = false;
    }

    private async Task SaveSection()
    {
        if (string.IsNullOrWhiteSpace(_formPath) || string.IsNullOrWhiteSpace(_formLabel)) return;
        var folderType = Enum.TryParse<FolderType>(_formFolderTypeStr, out var ft) ? ft : FolderType.Auto;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (_sectionEditTarget is null)
        {
            var section = new FolderWatcher
            {
                Id              = Guid.NewGuid(),
                Path            = _formPath.Trim(),
                Label           = _formLabel.Trim(),
                WatchEnabled    = _formWatch,
                IdentifyEnabled = _formWatch,            // master "Active" → also auto-identify
                RenameEnabled   = _formRenameEnabled,
                FlatSection     = _formFlatSection,
                FolderType      = _formRenameEnabled ? folderType : FolderType.Auto,
                IsSection       = true,
                CreatedAt       = DateTime.UtcNow,
            };
            db.FolderWatchers.Add(section);
            await db.SaveChangesAsync();
            if (_formWatch) await WatcherService.StartWatcherAsync(section.Id);
            var count = await DiscoverChildrenAsync(db, section);
            ToastService.ShowToast(ToastIntent.Success, L.Get("explorer.toast_section_added", section.Label, count));
        }
        else
        {
            var entity = await db.FolderWatchers.FindAsync(_sectionEditTarget.Id);
            if (entity is null) return;
            var wasEnabled = entity.WatchEnabled;
            entity.Path            = _formPath.Trim();
            entity.Label           = _formLabel.Trim();
            entity.WatchEnabled    = _formWatch;
            entity.IdentifyEnabled = _formWatch;
            entity.RenameEnabled   = _formRenameEnabled;
            entity.FlatSection     = _formFlatSection;
            entity.FolderType      = _formRenameEnabled ? folderType : FolderType.Auto;
            await db.SaveChangesAsync();
            if (!wasEnabled && _formWatch) await WatcherService.StartWatcherAsync(entity.Id);
            else if (wasEnabled && !_formWatch) await WatcherService.StopWatcherAsync(entity.Id);
            ToastService.ShowToast(ToastIntent.Success, L.Get("explorer.toast_section_updated", entity.Label));
        }

        _sectionDialogHidden = true;
        await LoadAsync();
    }

    // ── Delete ─────────────────────────────────────────────────────

    private void AskDelete(FolderWatcher f, bool isSection)
    {
        _deleteTarget    = f;
        _deleteIsSection = isSection;
        _deleteGoBack    = false;
        _deleteFromDisk  = false;
        _deleteHidden    = false;
    }

    private void AskDeleteCurrent()
    {
        if (_currentFolderWatcher is null) return;
        _deleteTarget    = _currentFolderWatcher;
        _deleteIsSection = _currentFolderWatcher.IsSection;
        _deleteGoBack    = true;
        _deleteFromDisk  = false;
        _deleteHidden    = false;
    }

    private async Task IdentifyCurrentFolderAsync()
    {
        if (_currentFolderWatcher is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();

        // If this is a section, queue all child folders instead of the section itself
        if (_currentFolderWatcher.IsSection)
        {
            var children = await db.FolderWatchers
                .Where(f => f.ParentSectionId == _currentFolderWatcher.Id)
                .ToListAsync();

            if (children.Count == 0)
            {
                ToastService.ShowToast(ToastIntent.Info, L["explorer.section_no_children"]);
                return;
            }

            var childIds = children.Select(c => c.Id).ToList();

            // Remove old done/failed/queued jobs for children
            await db.IdentificationQueues
                .Where(q => childIds.Contains(q.FolderId) &&
                            (q.Status == IdentificationQueueStatus.Queued ||
                             q.Status == IdentificationQueueStatus.Failed ||
                             q.Status == IdentificationQueueStatus.Done))
                .ExecuteDeleteAsync();

            foreach (var child in children)
            {
                db.IdentificationQueues.Add(new IdentificationQueue
                {
                    Id           = Guid.NewGuid(),
                    FolderId     = child.Id,
                    ForceRefresh = true,
                    QueuedAt     = DateTime.UtcNow,
                });
            }
            await db.SaveChangesAsync();
            ToastService.ShowToast(ToastIntent.Success, L.Get("explorer.section_queued", children.Count));
            return;
        }

        var processing = await db.IdentificationQueues
            .AnyAsync(q => q.FolderId == _currentFolderWatcher.Id &&
                           q.Status == IdentificationQueueStatus.Processing);
        if (processing)
        {
            ToastService.ShowToast(ToastIntent.Info, L["folders.toast_already_queued"]);
            return;
        }

        await db.IdentificationQueues
            .Where(q => q.FolderId == _currentFolderWatcher.Id &&
                        (q.Status == IdentificationQueueStatus.Queued ||
                         q.Status == IdentificationQueueStatus.Failed ||
                         q.Status == IdentificationQueueStatus.Done))
            .ExecuteDeleteAsync();

        db.IdentificationQueues.Add(new IdentificationQueue
        {
            Id           = Guid.NewGuid(),
            FolderId     = _currentFolderWatcher.Id,
            ForceRefresh = true,
            QueuedAt     = DateTime.UtcNow,
        });
        await db.SaveChangesAsync();
        ToastService.ShowToast(ToastIntent.Success, L["folders.toast_queued"]);
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget is null) return;
        await WatcherService.StopWatcherAsync(_deleteTarget.Id);
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_deleteIsSection)
        {
            var childList = await db.FolderWatchers
                .Where(f => f.ParentSectionId == _deleteTarget.Id)
                .ToListAsync();
            foreach (var child in childList)
                await WatcherService.StopWatcherAsync(child.Id);
            db.FolderWatchers.RemoveRange(childList);
        }
        // Bug-fix "New Folder reappears": when deleting a child of a section, remember
        // its path so DiscoverChildrenAsync and FSW auto-register won't bring it back.
        var dismissTargetSection = _deleteTarget.ParentSectionId;
        var dismissTargetPath    = _deleteTarget.Path;
        var singleFilePath       = _deleteTarget.SingleFilePath;
        var entity = await db.FolderWatchers.FindAsync(_deleteTarget.Id);
        if (entity is not null) { db.FolderWatchers.Remove(entity); await db.SaveChangesAsync(); }
        if (dismissTargetSection.HasValue)
            await WatcherService.DismissChildPathAsync(dismissTargetSection.Value, dismissTargetPath);

        // ── Disk deletion (only when explicitly requested and target is not a section) ──
        // Sections represent root library folders configured by the user — disk-deleting
        // those would wipe entire libraries, so the checkbox is hidden in that case.
        var diskDeleted = false;
        string? diskError = null;
        if (_deleteFromDisk && !_deleteIsSection)
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(singleFilePath))
                {
                    // Flat-section single-file entry: delete just that one file.
                    if (File.Exists(singleFilePath))
                    {
                        File.Delete(singleFilePath);
                        diskDeleted = true;
                    }
                }
                else if (!string.IsNullOrWhiteSpace(dismissTargetPath))
                {
                    // Regular folder entry: recursively delete the directory.
                    if (Directory.Exists(dismissTargetPath))
                    {
                        Directory.Delete(dismissTargetPath, recursive: true);
                        diskDeleted = true;
                    }
                }
            }
            catch (Exception ex)
            {
                diskError = ex.Message;
            }
        }

        var label = _deleteTarget.Label;
        var goBack = _deleteGoBack;
        _deleteHidden   = true;
        _deleteTarget   = null;
        _deleteGoBack   = false;
        _deleteFromDisk = false;
        if (diskError != null)
            ToastService.ShowToast(ToastIntent.Error,
                L.Get("explorer.toast_disk_delete_failed", label, diskError));
        else if (diskDeleted)
            ToastService.ShowToast(ToastIntent.Success,
                L.Get("explorer.toast_deleted_with_disk", label));
        else
            ToastService.ShowToast(ToastIntent.Success, L.Get("explorer.toast_deleted", label));
        if (goBack)
            await NavigateBack();
        else
            await LoadAsync();
    }

    // ── Watcher toggle ─────────────────────────────────────────────

    private async Task ToggleWatcher(FolderWatcher folder, bool enabled)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.FolderWatchers.FindAsync(folder.Id);
        if (entity is null) return;
        entity.WatchEnabled = enabled;
        await db.SaveChangesAsync();
        folder.WatchEnabled = enabled;
        if (enabled) await WatcherService.StartWatcherAsync(folder.Id);
        else await WatcherService.StopWatcherAsync(folder.Id);
    }

    // ── Subfolder discovery ────────────────────────────────────────

    private async Task RefreshSection(FolderWatcher section)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var count = await DiscoverChildrenAsync(db, section);
        ToastService.ShowToast(count > 0 ? ToastIntent.Success : ToastIntent.Info,
            count > 0
                ? L.Get("explorer.toast_found_subfolders", count)
                : L["explorer.toast_no_subfolders"]);
        await LoadAsync();
    }

    /// <summary>
    /// Wipes the section's dismissed-paths list, re-discovers children, makes
    /// sure they all have IdentifyEnabled=true, drops any leftover queue rows,
    /// and (re-)queues identification for every child whose poster isn't on
    /// disk. One click brings folders back AND kicks off the work.
    /// </summary>
    private async Task RestoreDismissedAsync(FolderWatcher section)
    {
        await WatcherService.ClearDismissedAsync(section.Id);
        await using var db = await DbFactory.CreateDbContextAsync();
        var discovered = await DiscoverChildrenAsync(db, section);

        // Make sure every child of this section is identify-enabled. The user
        // explicitly asked to restore the catalog — if a folder was somehow
        // toggled off, this is the moment to re-arm it.
        await db.FolderWatchers
            .Where(f => f.ParentSectionId == section.Id && !f.IsSection && !f.IdentifyEnabled)
            .ExecuteUpdateAsync(s => s.SetProperty(f => f.IdentifyEnabled, true));

        // Gather all section children that need (re-)identification:
        //   - no MediaItem at all, OR
        //   - MediaItem isn't Identified/Manual (failed, needs-review, etc.), OR
        //   - PosterPath points at a missing file (leftover from the old
        //     ".animarr/" cache that the user nuked from disk).
        var childMedia = await db.FolderWatchers
            .Where(f => f.ParentSectionId == section.Id && !f.IsSection)
            .GroupJoin(db.MediaItems,
                f => f.Id,
                m => m.FolderId,
                (f, mGroup) => new
                {
                    FolderId   = f.Id,
                    FolderPath = f.Path,
                    Item       = mGroup.FirstOrDefault(),
                })
            .ToListAsync();

        var needsIdentify = childMedia
            .Where(x => x.Item is null
                        || (x.Item.IdentificationStatus != IdentificationStatus.Identified
                            && x.Item.IdentificationStatus != IdentificationStatus.Manual)
                        || (x.Item.PosterPath is not null
                            && !File.Exists(Path.Combine(x.FolderPath, x.Item.PosterPath))))
            .Select(x => x.FolderId)
            .ToList();

        // Drop any leftover queue rows for these folders so we start clean,
        // then queue every one with ForceRefresh=true (handles the case where
        // the item is already Identified but the cached image was deleted).
        await db.IdentificationQueues
            .Where(q => needsIdentify.Contains(q.FolderId)
                        && q.Status != IdentificationQueueStatus.Processing)
            .ExecuteDeleteAsync();
        foreach (var id in needsIdentify)
        {
            db.IdentificationQueues.Add(new IdentificationQueue
            {
                Id           = Guid.NewGuid(),
                FolderId     = id,
                ForceRefresh = true,
                QueuedAt     = DateTime.UtcNow,
            });
        }
        await db.SaveChangesAsync();

        ToastService.ShowToast(ToastIntent.Success,
            L.Get("explorer.toast_restored_dismissed_with_queue", discovered, needsIdentify.Count));
        await LoadAsync();
    }

    private bool _rescanningAll;

    /// <summary>
    /// Whole-library rescan: walks every section, picks up subfolders that
    /// appeared on disk while the watcher was off / before the upgrade, then
    /// queues identification for anything still un-identified.
    /// </summary>
    private async Task RescanAllAsync()
    {
        _rescanningAll = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var sections = await db.FolderWatchers
                .Where(f => f.IsSection)
                .ToListAsync();

            int discovered = 0;
            foreach (var s in sections)
                discovered += await DiscoverChildrenAsync(db, s);

            // Queue identification for every folder that hasn't been identified yet.
            var pendingFolderIds = await db.FolderWatchers
                .Where(f => !f.IsSection && f.IdentifyEnabled)
                .Where(f => !db.MediaItems.Any(m =>
                    m.FolderId == f.Id &&
                    (m.IdentificationStatus == IdentificationStatus.Identified ||
                     m.IdentificationStatus == IdentificationStatus.Manual)))
                .Select(f => f.Id)
                .ToListAsync();

            // Also re-queue Identified/Manual items whose poster file is gone
            // — happens after the image-cache relocation when old paths point at
            // the deleted ".animarr/" cache. Re-identification will write fresh
            // posters to the new central cache.
            var possiblyBroken = await db.MediaItems
                .Where(m => m.PosterPath != null
                            && (m.IdentificationStatus == IdentificationStatus.Identified
                                || m.IdentificationStatus == IdentificationStatus.Manual))
                .Select(m => new { m.FolderId, m.PosterPath, FolderPath = m.Folder!.Path })
                .ToListAsync();
            var brokenIds = possiblyBroken
                .Where(p => !File.Exists(Path.Combine(p.FolderPath, p.PosterPath!)))
                .Select(p => p.FolderId)
                .ToList();
            var brokenSet = brokenIds.ToHashSet();
            pendingFolderIds = pendingFolderIds.Concat(brokenIds).Distinct().ToList();

            int queued = 0;
            foreach (var id in pendingFolderIds)
            {
                var already = await db.IdentificationQueues.AnyAsync(q =>
                    q.FolderId == id &&
                    (q.Status == IdentificationQueueStatus.Queued ||
                     q.Status == IdentificationQueueStatus.Processing));
                if (already) continue;
                db.IdentificationQueues.Add(new IdentificationQueue
                {
                    Id           = Guid.NewGuid(),
                    FolderId     = id,
                    // Broken-poster items are already Identified → without
                    // ForceRefresh the processor would skip them. Force a refresh
                    // so they re-download images to the new cache location.
                    ForceRefresh = brokenSet.Contains(id),
                    QueuedAt     = DateTime.UtcNow,
                });
                queued++;
            }
            if (queued > 0) await db.SaveChangesAsync();

            ToastService.ShowToast(ToastIntent.Success,
                L.Get("explorer.toast_rescan_done", discovered, queued));
            await LoadAsync();
        }
        finally
        {
            _rescanningAll = false;
        }
    }

    private async Task<int> DiscoverChildrenAsync(AppDbContext db, FolderWatcher section)
    {
        if (!Directory.Exists(section.Path)) return 0;

        var existingPaths = await db.FolderWatchers
            .Where(f => f.ParentSectionId == section.Id)
            .Select(f => f.Path)
            .ToHashSetAsync();
        var existingSingleFiles = await db.FolderWatchers
            .Where(f => f.ParentSectionId == section.Id && f.SingleFilePath != null)
            .Select(f => f.SingleFilePath!)
            .ToHashSetAsync();

        // Bug-fix "New Folder reappears": load dismissed-paths set for this section.
        var dismissedKey = $"dismissed.section.{section.Id}";
        var dismissedRaw = await db.AppConfigs.FindAsync(dismissedKey);
        var dismissed = ParseDismissedPaths(dismissedRaw?.Value);

        var toAdd = new List<FolderWatcher>();
        foreach (var subDir in Directory.GetDirectories(section.Path))
        {
            var norm = subDir.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            if (existingPaths.Any(p =>
                    string.Equals(
                        p.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                        norm, StringComparison.OrdinalIgnoreCase)))
                continue;

            // Bug-fix: skip empty / junk-named subfolders that can never be identified.
            // This prevents "New Folder" (and similar accidents) from reappearing
            // every time the user deletes them from the catalog.
            if (!MediaFolderHeuristics.LooksLikeMediaFolder(norm)) continue;

            // Bug-fix: skip paths the user dismissed earlier.
            if (dismissed.Contains(norm)) continue;

            toAdd.Add(new FolderWatcher
            {
                Id              = Guid.NewGuid(),
                Path            = norm,
                Label           = Path.GetFileName(norm),
                WatchEnabled    = section.WatchEnabled,
                IdentifyEnabled = section.IdentifyEnabled,   // inherit from section so Rescan picks them up
                FolderType      = section.FolderType,
                RenameEnabled   = section.RenameEnabled,
                IsSection       = false,
                ParentSectionId = section.Id,
                CreatedAt       = DateTime.UtcNow,
            });
        }

        // Also pick up top-level video files as flat-section MediaItems. Always
        // run this so the user doesn't have to know about the FlatSection flag —
        // dismissed-paths handles the case where they want a file ignored.
        var videoExts = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { ".mkv", ".mp4", ".avi", ".m4v", ".mov", ".wmv", ".ts", ".m2ts" };
        foreach (var file in Directory.EnumerateFiles(section.Path))
        {
            if (!videoExts.Contains(Path.GetExtension(file))) continue;
            if (existingSingleFiles.Contains(file)) continue;
            if (dismissed.Contains(file)) continue;

            toAdd.Add(new FolderWatcher
            {
                Id              = Guid.NewGuid(),
                Path            = section.Path,          // logical "folder" is the section root
                SingleFilePath  = file,
                Label           = Path.GetFileNameWithoutExtension(file),
                WatchEnabled    = false,                  // flat entries don't need their own watcher
                IdentifyEnabled = section.IdentifyEnabled,
                FolderType      = FolderType.Movie,       // single-file entries are always movies
                RenameEnabled   = section.RenameEnabled,
                IsSection       = false,
                FlatSection     = false,
                ParentSectionId = section.Id,
                CreatedAt       = DateTime.UtcNow,
            });
        }

        if (toAdd.Count > 0)
        {
            db.FolderWatchers.AddRange(toAdd);
            await db.SaveChangesAsync();
            foreach (var child in toAdd.Where(c => c.WatchEnabled))
                await WatcherService.StartWatcherAsync(child.Id);

            // Phase 1.1: auto-queue identification — no "Identify" button needed.
            foreach (var child in toAdd.Where(c => c.IdentifyEnabled))
            {
                var already = await db.IdentificationQueues
                    .AnyAsync(q => q.FolderId == child.Id &&
                                   (q.Status == IdentificationQueueStatus.Queued ||
                                    q.Status == IdentificationQueueStatus.Processing));
                if (already) continue;
                db.IdentificationQueues.Add(new IdentificationQueue
                {
                    Id       = Guid.NewGuid(),
                    FolderId = child.Id,
                    QueuedAt = DateTime.UtcNow,
                });
            }
            await db.SaveChangesAsync();
        }

        return toAdd.Count;
    }

    /// <summary>Parses the JSON stored in <c>AppConfig["dismissed.section.{id}"]</c>.</summary>
    private static HashSet<string> ParseDismissedPaths(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        try
        {
            var arr = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json);
            return arr is null
                ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
                : new HashSet<string>(arr, StringComparer.OrdinalIgnoreCase);
        }
        catch { return new HashSet<string>(StringComparer.OrdinalIgnoreCase); }
    }

    // ── Backdrop ──────────────────────────────────────────────────

    private async Task UpdateBackdropAsync()
    {
        var enabled = await AppConfig.GetAsync<bool>(AppConfigKeys.BackdropEnabled, true);
        if (!enabled) return;

        var blur       = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBlurPx, 0);
        if (blur > 20) blur = 0;
        var brightness = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBrightness, 60);

        if (_navStack.Count == 0)
        {
            // Root level — restore global (all fanarts)
            if (_backdropOwned) { await JS.InvokeVoidAsync("restoreGlobalBackdrop"); _backdropOwned = false; }
            return;
        }

        if (_currentFolderWatcher is null)
        {
            if (_backdropOwned) { await JS.InvokeVoidAsync("restoreGlobalBackdrop"); _backdropOwned = false; }
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        string[]? urls = null;
        if (_currentFolderWatcher.IsSection)
        {
            // Section: random fanarts from children
            var childIds = await db.FolderWatchers
                .Where(f => f.ParentSectionId == _currentFolderWatcher.Id)
                .Select(f => f.Id)
                .ToListAsync();
            if (childIds.Count > 0)
            {
                var fanarts = await db.MediaItems
                    .Where(m => childIds.Contains(m.FolderId) && m.FanartPath != null)
                    .Select(m => new { m.FanartPath, FolderPath = m.Folder!.Path })
                    .ToListAsync();
                if (fanarts.Count > 0)
                    urls = fanarts
                        .Select(f => $"/api/image?path={Uri.EscapeDataString(Path.Combine(f.FolderPath, f.FanartPath!))}")
                        .ToArray();
            }
        }
        else
        {
            // Specific media folder: use only this item's fanart
            var mi = await db.MediaItems
                .Where(m => m.FolderId == _currentFolderWatcher.Id && m.FanartPath != null)
                .Select(m => new { m.FanartPath, FolderPath = m.Folder!.Path })
                .FirstOrDefaultAsync();
            if (mi?.FanartPath != null)
                urls = [$"/api/image?path={Uri.EscapeDataString(Path.Combine(mi.FolderPath, mi.FanartPath))}"];
        }

        if (urls is { Length: > 0 })
        {
            var interval = _currentFolderWatcher.IsSection
                ? await AppConfig.GetAsync<int>(AppConfigKeys.BackdropIntervalSec, 30)
                : 999;
            _backdropOwned = true;
            await JS.InvokeVoidAsync("initBackdrop", urls, interval, blur, brightness);
        }
        else if (_backdropOwned)
        {
            await JS.InvokeVoidAsync("restoreGlobalBackdrop");
            _backdropOwned = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_backdropOwned)
            try { await JS.InvokeVoidAsync("restoreGlobalBackdrop"); } catch { }
    }
}
