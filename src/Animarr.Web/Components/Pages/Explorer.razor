@page "/explorer"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FolderWatcherService WatcherService
@inject IToastService ToastService
@inject IJSRuntime JS
@inject IAppConfigService AppConfig

<style>
    .exp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
    }
    .exp-card {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--neutral-stroke-rest);
        background: var(--neutral-layer-2);
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
        user-select: none;
    }
    .exp-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
        border-color: var(--neutral-stroke-strong);
    }
    .exp-card-art {
        aspect-ratio: 2/3;
        overflow: hidden;
        background: var(--neutral-layer-3);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .exp-card-art img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .exp-card-label {
        padding: 6px 8px 7px;
        font-size: 12px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.3;
    }
    .exp-card-actions {
        position: absolute;
        top: 4px;
        right: 4px;
        display: none;
        gap: 2px;
        background: rgba(0,0,0,.60);
        border-radius: 5px;
        padding: 2px;
    }
    .exp-card:hover .exp-card-actions { display: flex; }
    .exp-file-list {
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 8px;
        overflow: hidden;
        margin-top: 16px;
    }
    .exp-file-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 12px;
        border-bottom: 1px solid var(--neutral-stroke-subtle);
        font-size: 13px;
    }
    .exp-file-row:last-child { border-bottom: none; }
    .exp-file-row:hover { background: var(--neutral-layer-3); }
    .exp-file-actions {
        display: flex;
        gap: 2px;
        align-items: center;
        flex-shrink: 0;
        opacity: 0.3;
        transition: opacity 0.15s;
    }
    .exp-file-row:hover .exp-file-actions { opacity: 1; }
    /* ── video player ── */
    .exp-vp-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9100;
        background: rgba(0,0,0,.92);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .exp-vp-shell {
        display: flex;
        flex-direction: column;
        background: #000;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0,0,0,.8);
        max-width: min(96vw, 1200px);
    }
    .exp-vp-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        background: #111;
    }
    .exp-vp-title {
        flex: 1;
        font-size: 13px;
        color: rgba(255,255,255,.7);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    /* ── image preview ── */
    .exp-img-preview-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9000;
        background: rgba(0,0,0,.88);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
    }
    .exp-img-preview-img {
        max-width: min(94vw, 1400px);
        max-height: 94vh;
        object-fit: contain;
        border-radius: 6px;
        box-shadow: 0 24px 80px rgba(0,0,0,.6);
        cursor: default;
    }
    .exp-img-preview-close {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 9001;
        opacity: 0.6;
    }
    .exp-img-preview-close:hover { opacity: 1; }
</style>

<PageTitle>Animarr</PageTitle>

<!-- ── TOP BAR ────────────────────────────────────────────────── -->
<div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;min-height:36px;">
    @if (_navStack.Count == 0)
    {
        <span style="font-size:22px;font-weight:700;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@L["explorer.title"]</span>
        @* Global: rescan every section for newly-arrived subfolders + queue identification
           for any unidentified library entries. Useful after upgrading the app or after
           adding folders on disk while the container was off. *@
        <FluentButton Appearance="Appearance.Outline"
                      IconStart="@(new Icons.Regular.Size20.ArrowSync())"
                      Disabled="@_rescanningAll"
                      OnClick="RescanAllAsync">
            @(_rescanningAll ? L["folders.btn_identifying"] : L["explorer.btn_rescan_all"])
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="@(() => OpenSectionDialog(null))">
            @L["explorer.add_section_button"]
        </FluentButton>
    }
    else
    {
        <FluentButton Appearance="Appearance.Stealth"
                      IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                      OnClick="NavigateBack"
                      Style="flex-shrink:0;" />
        <nav style="display:flex;align-items:center;flex-wrap:wrap;gap:0;flex:1;min-width:0;font-size:14px;">
            <span style="color:var(--accent-foreground-rest);cursor:pointer;" @onclick="NavigateRoot">@L["explorer.title"]</span>
            @for (int _bi = 0; _bi < _navStack.Count; _bi++)
            {
                var capturedI = _bi;
                var entry     = _navStack[capturedI];
                <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" Style="opacity:0.4;margin:0 3px;flex-shrink:0;" />
                @if (capturedI == _navStack.Count - 1)
                {
                    <span style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@entry.Label</span>
                }
                else
                {
                    <span style="color:var(--accent-foreground-rest);cursor:pointer;" @onclick="@(() => NavigateToCrumb(capturedI))">@entry.Label</span>
                }
            }
        </nav>
    }
</div>

<!-- ── CONTENT ─────────────────────────────────────────────────── -->
@if (_loading)
{
    <div style="display:flex;justify-content:center;align-items:center;padding:80px 0;">
        <FluentProgressRing />
    </div>
}
else if (_navStack.Count == 0)
{
    <!-- ROOT: grid of section / standalone cards -->
    @if (_allRootFolders.Count == 0)
    {
        <div style="text-align:center;padding:60px 20px;color:var(--neutral-foreground-hint);">
            <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.3;" />
            <div style="margin-top:16px;font-size:15px;">@L["explorer.empty"]</div>
        </div>
    }
    else
    {
        <div class="exp-grid">
            @foreach (var folder in _allRootFolders)
            {
                var f = folder;
                <div class="exp-card" @onclick="@(() => NavigateInto(f.Path, f.Label))">
                    <div class="exp-card-art">
                        @if (_posterUrls.TryGetValue(f.Path, out var pUrl))
                        {
                            <img src="@pUrl" alt="@f.Label" loading="lazy" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.4;" />
                        }
                    </div>
                    <div class="exp-card-label" title="@f.Label">@f.Label</div>
                    <div class="exp-card-actions" @onclick:stopPropagation>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Edit())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;color:white;"
                                      OnClick="@(() => EditRootFolder(f))" />
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;color:white;"
                                      OnClick="@(() => AskDelete(f, f.IsSection))" />
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <!-- INSIDE FOLDER: header (poster + actions) -->
    <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:18px;padding:14px 16px;background:var(--neutral-layer-2);border-radius:8px;border:1px solid var(--neutral-stroke-rest);">
        <!-- Poster or folder icon -->
        <div style="width:64px;height:96px;border-radius:6px;overflow:hidden;background:var(--neutral-layer-3);flex-shrink:0;display:flex;align-items:center;justify-content:center;">
            @if (_currentFolderPosterUrl != null)
            {
                <img src="@_currentFolderPosterUrl" alt="poster" style="width:100%;height:100%;object-fit:cover;display:block;" />
            }
            else
            {
                <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.4;" />
            }
        </div>
        <!-- Name + path + action buttons -->
        <div style="flex:1;min-width:0;">
            <div style="font-size:18px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px;">
                @_navStack[^1].Label
            </div>
            <div style="font-size:11px;color:var(--neutral-foreground-hint);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:12px;">
                @_navStack[^1].Path
            </div>
            @if (_currentFolderWatcher != null)
            {
                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    @if (_currentFolderWatcher.IsSection)
                    {
                        @* Re-scan section for new subfolders that appeared on disk
                           (e.g. added while the container was off, or pre-update). *@
                        <FluentButton Appearance="Appearance.Outline"
                                      IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                                      OnClick="@(() => RefreshSection(_currentFolderWatcher))">
                            @L["explorer.btn_refresh_tooltip"]
                        </FluentButton>
                        @* "Restore dismissed folders" — recovers child paths that
                           were previously removed from the catalog (via delete or
                           auto-rename accident) but still exist on disk. *@
                        <FluentButton Appearance="Appearance.Outline"
                                      IconStart="@(new Icons.Regular.Size16.ArrowUndo())"
                                      Title="@L["explorer.btn_restore_dismissed_title"]"
                                      OnClick="@(() => RestoreDismissedAsync(_currentFolderWatcher))">
                            @L["explorer.btn_restore_dismissed"]
                        </FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Outline"
                                  IconStart="@(new Icons.Regular.Size16.DocumentSearch())"
                                  OnClick="IdentifyCurrentFolderAsync">
                        @L["explorer.btn_identify"]
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Edit())"
                                  OnClick="@(() => OpenEditPanel(_currentFolderWatcher))">
                        @L["folders.btn_edit"]
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                  OnClick="AskDeleteCurrent">
                        @L["folders.btn_delete"]
                    </FluentButton>
                </div>
            }
        </div>
    </div>

    <!-- INSIDE FOLDER: subdirectory cards + file list -->
    @if (_subDirs.Count > 0)
    {
        <div class="exp-grid">
            @foreach (var dir in _subDirs)
            {
                var d    = dir;
                var name = Path.GetFileName(d) ?? d;
                <div class="exp-card" @onclick="@(() => NavigateInto(d, name))">
                    <div class="exp-card-art">
                        @if (_posterUrls.TryGetValue(d, out var dUrl))
                        {
                            <img src="@dUrl" alt="@name" loading="lazy" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.4;" />
                        }
                    </div>
                    <div class="exp-card-label" title="@name">@name</div>
                </div>
            }
        </div>
    }

    @if (_subFiles.Count > 0)
    {
        <div class="exp-file-list">
            @foreach (var file in _subFiles)
            {
                var f2 = file;
                var isImg = IsImageFile(f2.Name);
                var isVid = IsVideoFile(f2.Name);
                <div class="exp-file-row" style="@(isImg || isVid ? "cursor:pointer;" : "")" @onclick="@(() => { if (isImg) OpenImagePreview(f2.Path); else if (isVid) OpenVideoPlayer(f2.Path); })">
                    <FluentIcon Value="@GetFileIcon(f2.Name)" Style="flex-shrink:0;opacity:0.7;" />
                    <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@f2.Name">@f2.Name</span>
                    <span style="color:var(--neutral-foreground-hint);font-size:11px;flex-shrink:0;margin-right:4px;">@FormatFileSize(f2.Size)</span>
                    <div class="exp-file-actions" @onclick:stopPropagation>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Rename())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;"
                                      Title="@(L["folder_files.btn_rename"])"
                                      OnClick="@(() => StartRenameFile(f2))" />
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;color:var(--color-fluent-error);"
                                      Title="@(L["folder_files.btn_delete"])"
                                      OnClick="@(() => AskDeleteFile(f2))" />
                    </div>
                </div>
                @if (_renameTarget?.Path == f2.Path)
                {
                    <div style="display:flex;align-items:center;gap:6px;padding:4px 12px 8px;background:var(--neutral-layer-3);">
                        <FluentTextField @bind-Value="_renameValue" style="flex:1;" @onkeydown="OnRenameKeyDown" />
                        <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.Checkmark())" OnClick="ConfirmRenameFile" />
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="@(() => _renameTarget = null)" />
                    </div>
                }
            }
        </div>
    }

    @if (_subDirs.Count == 0 && _subFiles.Count == 0)
    {
        <div style="text-align:center;padding:60px 20px;color:var(--neutral-foreground-hint);">
            <FluentIcon Value="@(new Icons.Regular.Size24.FolderOpen())" Style="opacity:0.3;font-size:48px;" />
            <div style="margin-top:12px;font-size:14px;">@L["explorer.subfolder_empty"]</div>
        </div>
    }
}

<!-- ================================================================ -->
<!-- ADD / EDIT SECTION DIALOG -->
<!-- ================================================================ -->
<FluentDialog @bind-Hidden="_sectionDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true" Width="500px">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H6">
            @(_sectionEditTarget is null ? L["explorer.dialog_add_title"] : L["explorer.dialog_edit_title"])
        </FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" Style="gap:14px;">
            @if (!_pickerMode)
            {
                <div style="display:flex;align-items:flex-end;gap:6px;">
                    <FluentTextField @bind-Value="_formPath"
                                     Label="@(L["folders.field_path_label"])"
                                     Placeholder="@(L["folders.field_path_placeholder"])"
                                     style="flex:1;" />
                    <FluentButton Appearance="Appearance.Outline"
                                  IconStart="@(new Icons.Regular.Size20.FolderOpen())"
                                  Title="@(L["explorer.picker_browse"])"
                                  OnClick="OpenPicker" />
                </div>
            }
            else
            {
                <div>
                    <FluentLabel Style="font-size:13px;font-weight:600;margin-bottom:8px;display:block;">@L["explorer.picker_title"]</FluentLabel>

                    @if (_pickerCurrent is null)
                    {
                        <!-- Drive list -->
                        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
                            @foreach (var drive in _drives)
                            {
                                <FluentButton Appearance="Appearance.Outline"
                                              IconStart="@(new Icons.Regular.Size20.HardDrive())"
                                              OnClick="@(() => PickerSelectDrive(drive.RootDirectory.FullName))">
                                    @drive.Name
                                </FluentButton>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Breadcrumb + Up button -->
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;min-width:0;">
                            <FluentButton Appearance="Appearance.Stealth"
                                          IconStart="@(new Icons.Regular.Size20.ArrowUp())"
                                          OnClick="PickerNavigateUp"
                                          Title="@(L["explorer.picker_up"])" />
                            <span style="font-size:12px;color:var(--neutral-foreground-hint);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;"
                                  title="@_pickerCurrent">@_pickerCurrent</span>
                        </div>

                        <!-- Subdirectory list -->
                        <div style="max-height:180px;overflow-y:auto;border:1px solid var(--neutral-stroke-rest);border-radius:4px;">
                            @if (_pickerChildren.Count == 0)
                            {
                                <div style="padding:10px;font-size:12px;color:var(--neutral-foreground-hint);">@L["explorer.picker_empty"]</div>
                            }
                            else
                            {
                                @foreach (var dir in _pickerChildren)
                                {
                                    <div style="display:flex;align-items:center;gap:6px;padding:5px 10px;cursor:pointer;border-bottom:1px solid var(--neutral-stroke-subtle);"
                                         @onclick="@(() => PickerNavigateInto(dir))">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Folder())" />
                                        <span style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@Path.GetFileName(dir)</span>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Confirm current dir -->
                        <div style="display:flex;justify-content:flex-end;margin-top:8px;gap:6px;">
                            <span style="font-size:12px;color:var(--neutral-foreground-hint);align-self:center;overflow:hidden;text-overflow:ellipsis;max-width:250px;" title="@_pickerCurrent">
                                @L["explorer.picker_selected"] <b>@Path.GetFileName(_pickerCurrent)</b>
                            </span>
                            <FluentButton Appearance="Appearance.Accent" OnClick="PickerConfirm">@L["explorer.picker_select_btn"]</FluentButton>
                            <FluentButton OnClick="@(() => _pickerMode = false)">@L["folders.btn_cancel"]</FluentButton>
                        </div>
                    }
                </div>
            }
            <FluentTextField @bind-Value="_formLabel"
                             Label="@(L["folders.field_name_label"])"
                             Placeholder="@(L["folders.field_name_placeholder"])"
                             style="width:100%;" />
            @* Phase 1.4: one master "Active" toggle. *@
            <FluentSwitch Value="_formActive"
                          ValueChanged="@((bool v) => { _formWatch = v; _formRenameEnabled = v; })">
                @L["folders.switch_active"]
            </FluentSwitch>

            @* Phase 3.4: FolderType + low-level switches hidden behind Advanced.
               System auto-detects type via LLM/TMDB; users only override when needed. *@
            <details>
                <summary style="cursor:pointer;font-size:13px;color:var(--neutral-foreground-hint);user-select:none;">
                    @L["folders.advanced_section"]
                </summary>
                <div style="display:flex;flex-direction:column;gap:10px;padding:8px 0 0 8px;border-left:2px solid var(--neutral-stroke-rest);margin-top:8px;">
                    <FluentSwitch @bind-Value="_formWatch">@L["folders.switch_monitor"]</FluentSwitch>
                    <FluentSwitch @bind-Value="_formRenameEnabled">@L["folders.switch_rename"]</FluentSwitch>
                    @* Flat section: each file in the section root is its own media item (single-file movies).  *@
                    <FluentSwitch @bind-Value="_formFlatSection">@L["folders.switch_flat_section"]</FluentSwitch>
                    @if (_formRenameEnabled)
                    {
                        <FluentSelect TOption="string" @bind-Value="_formFolderTypeStr"
                                      Label="@(L["folders.content_type_label"])" style="width:100%;">
                            <FluentOption TOption="string" Value="Auto">@L["folders.content_type_auto"]</FluentOption>
                            <FluentOption TOption="string" Value="Series">@L["folders.content_type_series"]</FluentOption>
                            <FluentOption TOption="string" Value="Movie">@L["folders.content_type_movie"]</FluentOption>
                        </FluentSelect>
                    }
                </div>
            </details>
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="SaveSection"
                      Disabled="@(string.IsNullOrWhiteSpace(_formPath) || string.IsNullOrWhiteSpace(_formLabel))">
            @L["folders.btn_save"]
        </FluentButton>
        <FluentButton OnClick="@(() => _sectionDialogHidden = true)">@L["folders.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ================================================================ -->
<!-- DELETE CONFIRMATION -->
<!-- ================================================================ -->
<FluentDialog @bind-Hidden="_deleteHidden" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H6">@L["folders.delete_title"]</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        @if (_deleteIsSection)
        {
            <FluentLabel>@L.Get("explorer.delete_section_body", _deleteTarget?.Label)</FluentLabel>
        }
        else
        {
            <FluentLabel>@L.Get("folders.delete_body", _deleteTarget?.Label)</FluentLabel>
            <div style="margin-top:12px;display:flex;align-items:center;gap:8px;">
                <FluentCheckbox Value="@_deleteFromDisk"
                                ValueChanged="@((bool v) => _deleteFromDisk = v)" />
                <FluentLabel Style="font-size:13px;color:var(--accent-fill-rest);">
                    @L["explorer.delete_from_disk_label"]
                </FluentLabel>
            </div>
            @if (_deleteFromDisk)
            {
                <FluentLabel Style="margin-top:6px;font-size:12px;color:var(--error);">
                    @L["explorer.delete_from_disk_warning"]
                </FluentLabel>
            }
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmDelete">@L["folders.btn_delete_confirm"]</FluentButton>
        <FluentButton OnClick="@(() => _deleteHidden = true)">@L["folders.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ================================================================ -->
<!-- FILE DELETE CONFIRMATION -->
<!-- ================================================================ -->
<FluentDialog @bind-Hidden="_fileDeleteHidden" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H6">@L["explorer.file_delete_title"]</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentLabel>@L.Get("explorer.file_delete_body", _fileDeleteTarget?.Name)</FluentLabel>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmDeleteFile">@L["folders.btn_delete_confirm"]</FluentButton>
        <FluentButton OnClick="@(() => _fileDeleteHidden = true)">@L["folders.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@if (_editTarget is not null)
{
    <FolderEditPanel Folder="_editTarget" OnSaved="HandleEditSaved" OnClosed="CloseEditPanel" />
}

@if (_playerPath is not null)
{
    <div class="exp-vp-backdrop" @onclick="CloseVideoPlayer">
        <div class="exp-vp-shell" @onclick:stopPropagation>
            <div class="exp-vp-header">
                <span class="exp-vp-title" title="@_playerPath">@Path.GetFileName(_playerPath)</span>
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size20.Dismiss())"
                              Style="min-width:32px;width:32px;height:32px;padding:0;color:white;"
                              OnClick="CloseVideoPlayer" />
            </div>
            <video controls autoplay style="display:block;width:min(92vw,1100px);max-height:calc(90vh - 48px);background:#000;"
                   src="@($"/api/video?path={Uri.EscapeDataString(_playerPath)}")">
            </video>
        </div>
    </div>
}

