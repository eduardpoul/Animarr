@page "/explorer"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FolderWatcherService WatcherService
@inject IToastService ToastService

<style>
    .exp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
    }
    .exp-card {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--neutral-stroke-rest);
        background: var(--neutral-layer-2);
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
        user-select: none;
    }
    .exp-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
        border-color: var(--neutral-stroke-strong);
    }
    .exp-card-art {
        aspect-ratio: 2/3;
        overflow: hidden;
        background: var(--neutral-layer-3);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .exp-card-art img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .exp-card-label {
        padding: 6px 8px 7px;
        font-size: 12px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.3;
    }
    .exp-card-actions {
        position: absolute;
        top: 4px;
        right: 4px;
        display: none;
        gap: 2px;
        background: rgba(0,0,0,.60);
        border-radius: 5px;
        padding: 2px;
    }
    .exp-card:hover .exp-card-actions { display: flex; }
    .exp-file-list {
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 8px;
        overflow: hidden;
        margin-top: 16px;
    }
    .exp-file-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 12px;
        border-bottom: 1px solid var(--neutral-stroke-subtle);
        font-size: 13px;
    }
    .exp-file-row:last-child { border-bottom: none; }
    .exp-file-row:hover { background: var(--neutral-layer-3); }
    .exp-file-actions {
        display: flex;
        gap: 2px;
        align-items: center;
        flex-shrink: 0;
        opacity: 0.3;
        transition: opacity 0.15s;
    }
    .exp-file-row:hover .exp-file-actions { opacity: 1; }
    /* ── image preview ── */
    .exp-img-preview-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9000;
        background: rgba(0,0,0,.88);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
    }
    .exp-img-preview-img {
        max-width: min(94vw, 1400px);
        max-height: 94vh;
        object-fit: contain;
        border-radius: 6px;
        box-shadow: 0 24px 80px rgba(0,0,0,.6);
        cursor: default;
    }
    .exp-img-preview-close {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 9001;
        opacity: 0.6;
    }
    .exp-img-preview-close:hover { opacity: 1; }
</style>

<PageTitle>Animarr</PageTitle>

<!-- ── TOP BAR ────────────────────────────────────────────────── -->
<div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;min-height:36px;">
    @if (_navStack.Count == 0)
    {
        <span style="font-size:22px;font-weight:700;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@L["explorer.title"]</span>
        <FluentButton Appearance="Appearance.Accent"
                      IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="@(() => OpenSectionDialog(null))">
            @L["explorer.add_section_button"]
        </FluentButton>
    }
    else
    {
        <FluentButton Appearance="Appearance.Stealth"
                      IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                      OnClick="NavigateBack"
                      Style="flex-shrink:0;" />
        <nav style="display:flex;align-items:center;flex-wrap:wrap;gap:0;flex:1;min-width:0;font-size:14px;">
            <span style="color:var(--accent-foreground-rest);cursor:pointer;" @onclick="NavigateRoot">@L["explorer.title"]</span>
            @for (int _bi = 0; _bi < _navStack.Count; _bi++)
            {
                var capturedI = _bi;
                var entry     = _navStack[capturedI];
                <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" Style="opacity:0.4;margin:0 3px;flex-shrink:0;" />
                @if (capturedI == _navStack.Count - 1)
                {
                    <span style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@entry.Label</span>
                }
                else
                {
                    <span style="color:var(--accent-foreground-rest);cursor:pointer;" @onclick="@(() => NavigateToCrumb(capturedI))">@entry.Label</span>
                }
            }
        </nav>
    }
</div>

<!-- ── CONTENT ─────────────────────────────────────────────────── -->
@if (_loading)
{
    <div style="display:flex;justify-content:center;align-items:center;padding:80px 0;">
        <FluentProgressRing />
    </div>
}
else if (_navStack.Count == 0)
{
    <!-- ROOT: grid of section / standalone cards -->
    @if (_allRootFolders.Count == 0)
    {
        <div style="text-align:center;padding:60px 20px;color:var(--neutral-foreground-hint);">
            <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.3;" />
            <div style="margin-top:16px;font-size:15px;">@L["explorer.empty"]</div>
        </div>
    }
    else
    {
        <div class="exp-grid">
            @foreach (var folder in _allRootFolders)
            {
                var f = folder;
                <div class="exp-card" @onclick="@(() => NavigateInto(f.Path, f.Label))">
                    <div class="exp-card-art">
                        @if (_posterUrls.TryGetValue(f.Path, out var pUrl))
                        {
                            <img src="@pUrl" alt="@f.Label" loading="lazy" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.4;" />
                        }
                    </div>
                    <div class="exp-card-label" title="@f.Label">@f.Label</div>
                    <div class="exp-card-actions" @onclick:stopPropagation>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Edit())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;color:white;"
                                      OnClick="@(() => EditRootFolder(f))" />
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;color:white;"
                                      OnClick="@(() => AskDelete(f, f.IsSection))" />
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <!-- INSIDE FOLDER: header (poster + actions) -->
    <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:18px;padding:14px 16px;background:var(--neutral-layer-2);border-radius:8px;border:1px solid var(--neutral-stroke-rest);">
        <!-- Poster or folder icon -->
        <div style="width:64px;height:96px;border-radius:6px;overflow:hidden;background:var(--neutral-layer-3);flex-shrink:0;display:flex;align-items:center;justify-content:center;">
            @if (_currentFolderPosterUrl != null)
            {
                <img src="@_currentFolderPosterUrl" alt="poster" style="width:100%;height:100%;object-fit:cover;display:block;" />
            }
            else
            {
                <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.4;" />
            }
        </div>
        <!-- Name + path + action buttons -->
        <div style="flex:1;min-width:0;">
            <div style="font-size:18px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px;">
                @_navStack[^1].Label
            </div>
            <div style="font-size:11px;color:var(--neutral-foreground-hint);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:12px;">
                @_navStack[^1].Path
            </div>
            @if (_currentFolderWatcher != null)
            {
                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    <FluentButton Appearance="Appearance.Outline"
                                  IconStart="@(new Icons.Regular.Size16.DocumentSearch())"
                                  OnClick="IdentifyCurrentFolderAsync">
                        @L["explorer.btn_identify"]
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Edit())"
                                  OnClick="@(() => OpenEditPanel(_currentFolderWatcher))">
                        @L["folders.btn_edit"]
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                  OnClick="AskDeleteCurrent">
                        @L["folders.btn_delete"]
                    </FluentButton>
                </div>
            }
        </div>
    </div>

    <!-- INSIDE FOLDER: subdirectory cards + file list -->
    @if (_subDirs.Count > 0)
    {
        <div class="exp-grid">
            @foreach (var dir in _subDirs)
            {
                var d    = dir;
                var name = Path.GetFileName(d) ?? d;
                <div class="exp-card" @onclick="@(() => NavigateInto(d, name))">
                    <div class="exp-card-art">
                        @if (_posterUrls.TryGetValue(d, out var dUrl))
                        {
                            <img src="@dUrl" alt="@name" loading="lazy" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size48.Folder())" Style="opacity:0.4;" />
                        }
                    </div>
                    <div class="exp-card-label" title="@name">@name</div>
                </div>
            }
        </div>
    }

    @if (_subFiles.Count > 0)
    {
        <div class="exp-file-list">
            @foreach (var file in _subFiles)
            {
                var f2 = file;
                var isImg = IsImageFile(f2.Name);
                <div class="exp-file-row" style="@(isImg ? "cursor:pointer;" : "")" @onclick="@(() => { if (isImg) OpenImagePreview(f2.Path); })">
                    <FluentIcon Value="@GetFileIcon(f2.Name)" Style="flex-shrink:0;opacity:0.7;" />
                    <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@f2.Name">@f2.Name</span>
                    <span style="color:var(--neutral-foreground-hint);font-size:11px;flex-shrink:0;margin-right:4px;">@FormatFileSize(f2.Size)</span>
                    <div class="exp-file-actions" @onclick:stopPropagation>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Rename())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;"
                                      Title="Rename"
                                      OnClick="@(() => StartRenameFile(f2))" />
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                      Style="min-width:26px;width:26px;height:26px;padding:0;color:var(--color-fluent-error);"
                                      Title="Delete"
                                      OnClick="@(() => AskDeleteFile(f2))" />
                    </div>
                </div>
                @if (_renameTarget?.Path == f2.Path)
                {
                    <div style="display:flex;align-items:center;gap:6px;padding:4px 12px 8px;background:var(--neutral-layer-3);">
                        <FluentTextField @bind-Value="_renameValue" style="flex:1;" @onkeydown="OnRenameKeyDown" />
                        <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.Checkmark())" OnClick="ConfirmRenameFile" />
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="@(() => _renameTarget = null)" />
                    </div>
                }
            }
        </div>
    }

    @if (_subDirs.Count == 0 && _subFiles.Count == 0)
    {
        <div style="text-align:center;padding:60px 20px;color:var(--neutral-foreground-hint);">
            <FluentIcon Value="@(new Icons.Regular.Size24.FolderOpen())" Style="opacity:0.3;font-size:48px;" />
            <div style="margin-top:12px;font-size:14px;">@L["explorer.subfolder_empty"]</div>
        </div>
    }
}

<!-- ================================================================ -->
<!-- ADD / EDIT SECTION DIALOG -->
<!-- ================================================================ -->
<FluentDialog @bind-Hidden="_sectionDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true" Width="500px">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H6">
            @(_sectionEditTarget is null ? L["explorer.dialog_add_title"] : L["explorer.dialog_edit_title"])
        </FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" Style="gap:14px;">
            @if (!_pickerMode)
            {
                <div style="display:flex;align-items:flex-end;gap:6px;">
                    <FluentTextField @bind-Value="_formPath"
                                     Label="@(L["folders.field_path_label"])"
                                     Placeholder="@(L["folders.field_path_placeholder"])"
                                     style="flex:1;" />
                    <FluentButton Appearance="Appearance.Outline"
                                  IconStart="@(new Icons.Regular.Size20.FolderOpen())"
                                  Title="@(L["explorer.picker_browse"])"
                                  OnClick="OpenPicker" />
                </div>
            }
            else
            {
                <div>
                    <FluentLabel Style="font-size:13px;font-weight:600;margin-bottom:8px;display:block;">@L["explorer.picker_title"]</FluentLabel>

                    @if (_pickerCurrent is null)
                    {
                        <!-- Drive list -->
                        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
                            @foreach (var drive in _drives)
                            {
                                <FluentButton Appearance="Appearance.Outline"
                                              IconStart="@(new Icons.Regular.Size20.HardDrive())"
                                              OnClick="@(() => PickerSelectDrive(drive.RootDirectory.FullName))">
                                    @drive.Name
                                </FluentButton>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Breadcrumb + Up button -->
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;min-width:0;">
                            <FluentButton Appearance="Appearance.Stealth"
                                          IconStart="@(new Icons.Regular.Size20.ArrowUp())"
                                          OnClick="PickerNavigateUp"
                                          Title="@(L["explorer.picker_up"])" />
                            <span style="font-size:12px;color:var(--neutral-foreground-hint);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;"
                                  title="@_pickerCurrent">@_pickerCurrent</span>
                        </div>

                        <!-- Subdirectory list -->
                        <div style="max-height:180px;overflow-y:auto;border:1px solid var(--neutral-stroke-rest);border-radius:4px;">
                            @if (_pickerChildren.Count == 0)
                            {
                                <div style="padding:10px;font-size:12px;color:var(--neutral-foreground-hint);">@L["explorer.picker_empty"]</div>
                            }
                            else
                            {
                                @foreach (var dir in _pickerChildren)
                                {
                                    <div style="display:flex;align-items:center;gap:6px;padding:5px 10px;cursor:pointer;border-bottom:1px solid var(--neutral-stroke-subtle);"
                                         @onclick="@(() => PickerNavigateInto(dir))">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Folder())" />
                                        <span style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@Path.GetFileName(dir)</span>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Confirm current dir -->
                        <div style="display:flex;justify-content:flex-end;margin-top:8px;gap:6px;">
                            <span style="font-size:12px;color:var(--neutral-foreground-hint);align-self:center;overflow:hidden;text-overflow:ellipsis;max-width:250px;" title="@_pickerCurrent">
                                @L["explorer.picker_selected"] <b>@Path.GetFileName(_pickerCurrent)</b>
                            </span>
                            <FluentButton Appearance="Appearance.Accent" OnClick="PickerConfirm">@L["explorer.picker_select_btn"]</FluentButton>
                            <FluentButton OnClick="@(() => _pickerMode = false)">@L["folders.btn_cancel"]</FluentButton>
                        </div>
                    }
                </div>
            }
            <FluentTextField @bind-Value="_formLabel"
                             Label="@(L["folders.field_name_label"])"
                             Placeholder="@(L["folders.field_name_placeholder"])"
                             style="width:100%;" />
            <FluentSwitch @bind-Value="_formWatch">@L["folders.switch_monitor"]</FluentSwitch>
            <FluentSwitch @bind-Value="_formRenameEnabled">@L["folders.switch_rename"]</FluentSwitch>
            @if (_formRenameEnabled)
            {
                <FluentSelect TOption="string" @bind-Value="_formFolderTypeStr"
                              Label="@(L["folders.content_type_label"])" style="width:100%;">
                    <FluentOption TOption="string" Value="Auto">@L["folders.content_type_auto"]</FluentOption>
                    <FluentOption TOption="string" Value="Series">@L["folders.content_type_series"]</FluentOption>
                    <FluentOption TOption="string" Value="Movie">@L["folders.content_type_movie"]</FluentOption>
                </FluentSelect>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="SaveSection"
                      Disabled="@(string.IsNullOrWhiteSpace(_formPath) || string.IsNullOrWhiteSpace(_formLabel))">
            @L["folders.btn_save"]
        </FluentButton>
        <FluentButton OnClick="@(() => _sectionDialogHidden = true)">@L["folders.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ================================================================ -->
<!-- DELETE CONFIRMATION -->
<!-- ================================================================ -->
<FluentDialog @bind-Hidden="_deleteHidden" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H6">@L["folders.delete_title"]</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        @if (_deleteIsSection)
        {
            <FluentLabel>@L.Get("explorer.delete_section_body", _deleteTarget?.Label)</FluentLabel>
        }
        else
        {
            <FluentLabel>@L.Get("folders.delete_body", _deleteTarget?.Label)</FluentLabel>
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmDelete">@L["folders.btn_delete_confirm"]</FluentButton>
        <FluentButton OnClick="@(() => _deleteHidden = true)">@L["folders.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<!-- ================================================================ -->
<!-- FILE DELETE CONFIRMATION -->
<!-- ================================================================ -->
<FluentDialog @bind-Hidden="_fileDeleteHidden" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader ShowDismiss="true">
        <FluentLabel Typo="Typography.H6">@L["explorer.file_delete_title"]</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentLabel>@L.Get("explorer.file_delete_body", _fileDeleteTarget?.Name)</FluentLabel>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmDeleteFile">@L["folders.btn_delete_confirm"]</FluentButton>
        <FluentButton OnClick="@(() => _fileDeleteHidden = true)">@L["folders.btn_cancel"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@if (_editTarget is not null)
{
    <FolderEditPanel Folder="_editTarget" OnSaved="HandleEditSaved" OnClosed="CloseEditPanel" />
}

@if (_previewImageUrl is not null)
{
    <div class="exp-img-preview-backdrop" @onclick="CloseImagePreview">
        <FluentButton class="exp-img-preview-close"
                      Appearance="Appearance.Stealth"
                      IconStart="@(new Icons.Regular.Size20.Dismiss())"
                      Style="min-width:36px;width:36px;height:36px;padding:0;color:white;background:rgba(0,0,0,.5);border-radius:50%;"
                      OnClick="CloseImagePreview" />
        <img src="@_previewImageUrl" alt="preview" class="exp-img-preview-img" @onclick:stopPropagation />
    </div>
}




@code {
    // ── Section management (DB state) ──────────────────────────────
    private List<FolderWatcher> _sections = [];
    private Dictionary<Guid, List<FolderWatcher>> _children = [];
    private List<FolderWatcher> _standalone = [];
    private bool _loading = true;

    // ── Navigation ─────────────────────────────────────────────────
    private record NavEntry(string Path, string Label);
    private List<NavEntry> _navStack = [];

    // Root grid
    private List<FolderWatcher> _allRootFolders = [];

    // Current folder contents
    private List<string>    _subDirs  = [];
    private List<FileEntry> _subFiles = [];
    private Dictionary<string, string> _posterUrls = [];
    private record FileEntry(string Path, string Name, long Size, DateTime Modified);

    private record SeasonInfo
    {
        public int     Number     { get; init; }
        public string? PosterPath { get; init; }
    }

    // Current folder header
    private FolderWatcher? _currentFolderWatcher;
    private string?        _currentFolderPosterUrl;

    // File rename inline
    private FileEntry? _renameTarget;
    private string     _renameValue = "";

    // File delete dialog
    private bool       _fileDeleteHidden = true;
    private FileEntry? _fileDeleteTarget;

    // ── Section add/edit dialog ────────────────────────────────────
    private bool _sectionDialogHidden = true;
    private FolderWatcher? _sectionEditTarget;
    private string _formPath = "";
    private string _formLabel = "";
    private bool _formWatch = true;
    private bool _formRenameEnabled = true;
    private string _formFolderTypeStr = "Auto";

    // Folder picker (embedded in add dialog)
    private List<DriveInfo> _drives = [];
    private string? _pickerCurrent;
    private List<string> _pickerChildren = [];
    private bool _pickerMode = false;

    // ── Edit folder panel ──────────────────────────────────────────
    private FolderWatcher? _editTarget;

    // ── Delete dialog ──────────────────────────────────────────────
    private bool _deleteHidden = true;
    private FolderWatcher? _deleteTarget;
    private bool _deleteIsSection;
    private bool _deleteGoBack;

    // ── Init ───────────────────────────────────────────────────────

    [SupplyParameterFromQuery(Name = "path")]
    public string? InitPath { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // Deep-link: navigate directly into the given path
        if (!string.IsNullOrWhiteSpace(InitPath))
        {
            // Build navStack from InitPath — walk up from root until we find
            // the topmost registered FolderWatcher ancestor, then push remaining segments
            var target = Path.GetFullPath(InitPath);
            // Find the deepest registered root that is an ancestor of target
            var allRoots = _allRootFolders.Select(f =>
                Path.GetFullPath(f.Path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                .OrderByDescending(p => p.Length)
                .ToList();
            var root = allRoots.FirstOrDefault(r =>
                target.StartsWith(r + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase)
                || target.Equals(r, StringComparison.OrdinalIgnoreCase));
            if (root != null)
            {
                // Push ancestor crumbs
                var rootFolder = _allRootFolders.First(f =>
                    Path.GetFullPath(f.Path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                    .Equals(root, StringComparison.OrdinalIgnoreCase));
                _navStack.Add(new NavEntry(rootFolder.Path, rootFolder.Label));
                // Push intermediate segments
                var rel = target.Substring(root.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                if (!string.IsNullOrEmpty(rel))
                {
                    var current = root;
                    foreach (var seg in rel.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                    {
                        current = Path.Combine(current, seg);
                        _navStack.Add(new NavEntry(current, seg));
                    }
                }
                await LoadCurrentDirAsync();
            }
        }

        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.FolderWatchers.OrderBy(f => f.Label).ToListAsync();
        _sections   = all.Where(f => f.IsSection).ToList();
        _children   = all
            .Where(f => !f.IsSection && f.ParentSectionId.HasValue)
            .GroupBy(f => f.ParentSectionId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());
        _standalone = all.Where(f => !f.IsSection && !f.ParentSectionId.HasValue).ToList();

        _allRootFolders = _sections.Concat(_standalone).OrderBy(f => f.Label).ToList();

        // Load posters for root folder cards
        // For standalone folders: use their own poster.
        // For section folders: pick a random poster from child MediaItems.
        _posterUrls = [];

        // Standalone posters
        var standaloneIds = _standalone.Select(f => f.Id).ToList();
        if (standaloneIds.Count > 0)
        {
            var standalonePosters = await db.MediaItems
                .Where(m => standaloneIds.Contains(m.FolderId) && m.PosterPath != null)
                .Select(m => new { m.FolderId, m.PosterPath, FolderPath = m.Folder!.Path, m.LastMetadataRefreshedAt })
                .ToListAsync();
            foreach (var p in standalonePosters)
            {
                var t = p.LastMetadataRefreshedAt?.Ticks ?? 0;
                _posterUrls[p.FolderPath] = $"/api/image?path={Uri.EscapeDataString(Path.Combine(p.FolderPath, p.PosterPath!))}&t={t}";
            }
        }

        // Section posters — pick random from children
        foreach (var section in _sections)
        {
            var childIds = _children.TryGetValue(section.Id, out var ch) ? ch.Select(f => f.Id).ToList() : [];
            if (childIds.Count == 0) continue;
            var childPosters = await db.MediaItems
                .Where(m => childIds.Contains(m.FolderId) && m.PosterPath != null)
                .Select(m => new { m.FolderId, m.PosterPath, FolderPath = m.Folder!.Path, m.LastMetadataRefreshedAt })
                .ToListAsync();
            if (childPosters.Count == 0) continue;
            var pick = childPosters[Random.Shared.Next(childPosters.Count)];
            var pickT = pick.LastMetadataRefreshedAt?.Ticks ?? 0;
            _posterUrls[section.Path] = $"/api/image?path={Uri.EscapeDataString(Path.Combine(pick.FolderPath, pick.PosterPath!))}&t={pickT}";
        }
    }

    // ── Navigation ─────────────────────────────────────────────────

    private async Task NavigateInto(string path, string label)
    {
        _loading = true;
        StateHasChanged();
        _navStack.Add(new NavEntry(path, label));
        await LoadCurrentDirAsync();
    }

    private async Task NavigateBack()
    {
        if (_navStack.Count == 0) return;
        _loading = true;
        StateHasChanged();
        _navStack.RemoveAt(_navStack.Count - 1);
        if (_navStack.Count == 0)
        {
            await LoadAsync();
            _loading = false;
        }
        else
        {
            await LoadCurrentDirAsync();
        }
    }

    private async Task NavigateRoot()
    {
        if (_navStack.Count == 0) return;
        _navStack.Clear();
        _loading = true;
        StateHasChanged();
        await LoadAsync();
        _loading = false;
    }

    private async Task NavigateToCrumb(int idx)
    {
        _navStack = [.._navStack.Take(idx + 1)];
        _loading = true;
        StateHasChanged();
        await LoadCurrentDirAsync();
    }

    private async Task LoadCurrentDirAsync()
    {
        var path = _navStack[^1].Path;
        _subDirs  = [];
        _subFiles = [];
        _posterUrls = [];
        _currentFolderWatcher   = null;
        _currentFolderPosterUrl = null;

        try
        {
            _subDirs = [..Directory.GetDirectories(path)
                .Select(d => d.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                .OrderBy(d => d, StringComparer.OrdinalIgnoreCase)];

            _subFiles = [..Directory.GetFiles(path)
                .Select(f => { var fi = new FileInfo(f); return new FileEntry(fi.FullName, fi.Name, fi.Length, fi.LastWriteTime); })
                .OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase)];
        }
        catch { /* access denied or path not found */ }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Find FolderWatcher for current path
        var normPath = path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        _currentFolderWatcher = await db.FolderWatchers
            .FirstOrDefaultAsync(f => f.Path == normPath);

        if (_currentFolderWatcher != null)
        {
            var mi = await db.MediaItems
                .Where(m => m.FolderId == _currentFolderWatcher.Id && m.PosterPath != null)
                .Select(m => new { m.PosterPath, m.LastMetadataRefreshedAt })
                .FirstOrDefaultAsync();
            if (mi?.PosterPath != null)
            {
                var t = mi.LastMetadataRefreshedAt?.Ticks ?? 0;
                _currentFolderPosterUrl = $"/api/image?path={Uri.EscapeDataString(Path.Combine(normPath, mi.PosterPath))}&t={t}";
            }
        }

        if (_subDirs.Count > 0)
        {
            var posters = await db.MediaItems
                .Include(m => m.Folder)
                .Where(m => _subDirs.Contains(m.Folder!.Path) && m.PosterPath != null)
                .Select(m => new { FolderPath = m.Folder!.Path, m.PosterPath, m.LastMetadataRefreshedAt })
                .ToListAsync();
            _posterUrls = posters.ToDictionary(
                p => p.FolderPath,
                p => $"/api/image?path={Uri.EscapeDataString(Path.Combine(p.FolderPath, p.PosterPath!))}&t={p.LastMetadataRefreshedAt?.Ticks ?? 0}");
        }

        // Season posters: if current folder's MediaItem has SeasonsJson, map subdir → season poster
        if (_currentFolderWatcher != null)
        {
            var currentMi = await db.MediaItems
                .Where(m => m.FolderId == _currentFolderWatcher.Id && m.SeasonsJson != null)
                .Select(m => new { m.SeasonsJson })
                .FirstOrDefaultAsync();
            if (currentMi?.SeasonsJson != null)
            {
                try
                {
                    var seasons = System.Text.Json.JsonSerializer.Deserialize<List<SeasonInfo>>(currentMi.SeasonsJson,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (seasons != null)
                    {
                        foreach (var season in seasons.Where(s => s.PosterPath != null))
                        {
                            // Match subdirs by season number: Season 01, S01, season1, etc.
                            var seasonDir = _subDirs.FirstOrDefault(d =>
                            {
                                var name = Path.GetFileName(d);
                                return System.Text.RegularExpressions.Regex.IsMatch(name,
                                    $@"(?i)^s(eason[\s._-]*)0*{season.Number}$");
                            });
                            if (seasonDir != null && !_posterUrls.ContainsKey(seasonDir))
                                _posterUrls[seasonDir] = $"/api/image?path={Uri.EscapeDataString(Path.Combine(normPath, season.PosterPath!))}";
                        }
                    }
                }
                catch { /* malformed JSON */ }
            }
        }

        _loading = false;
    }

