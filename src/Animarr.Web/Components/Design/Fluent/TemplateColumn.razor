@namespace Microsoft.FluentUI.AspNetCore.Components
@typeparam TGridItem
@implements IFluentColumn<TGridItem>

@code {
    [CascadingParameter] public FluentDataGrid<TGridItem>? Grid { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public Align Align { get; set; } = Align.Start;
    [Parameter] public bool Sortable { get; set; }
    [Parameter] public RenderFragment<TGridItem>? ChildContent { get; set; }

    Align IFluentColumn<TGridItem>.Align => Align;

    protected override void OnInitialized() => Grid?.Register(this);

    public RenderFragment Render(TGridItem item)
    {
        var content = ChildContent;
        return builder =>
        {
            if (content is not null) builder.AddContent(0, content(item));
        };
    }
}
