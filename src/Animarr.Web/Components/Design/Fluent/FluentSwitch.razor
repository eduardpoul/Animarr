@namespace Microsoft.FluentUI.AspNetCore.Components

<label class="fswitch @(Disabled ? "fswitch--disabled" : "")" style="@Style">
    <input type="checkbox" class="fswitch__cb"
           checked="@Value"
           disabled="@Disabled"
           @onchange="OnChange" />
    <span class="fswitch__track"><span class="fswitch__thumb"></span></span>
    @if (ChildContent is not null)
    {
        <span class="fswitch__label">@ChildContent</span>
    }
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Style { get; set; }

    private Task OnChange(ChangeEventArgs e)
        => ValueChanged.InvokeAsync(e.Value is bool b && b);
}
