@namespace Microsoft.FluentUI.AspNetCore.Components
@typeparam TOption

<label class="ffield">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="ffield__label">@Label</span>
    }
    <div class="fselect">
        <select class="ffield__input fselect__field"
                value="@Value?.ToString()"
                disabled="@Disabled"
                style="@Style"
                @onchange="OnChange"
                @attributes="Extra">
            @ChildContent
        </select>
        <span class="fselect__chev"><DIcon Name="chev-d" Size="14" /></span>
    </div>
</label>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public TOption? Value { get; set; }
    [Parameter] public EventCallback<TOption?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool    Disabled { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Extra { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (typeof(TOption) == typeof(string)) { await ValueChanged.InvokeAsync((TOption?)(object?)raw); return; }
        try
        {
            var t = Nullable.GetUnderlyingType(typeof(TOption)) ?? typeof(TOption);
            var converted = (TOption?)(raw is null ? default : Convert.ChangeType(raw, t));
            await ValueChanged.InvokeAsync(converted);
        }
        catch { await ValueChanged.InvokeAsync(default); }
    }
}
