@namespace Microsoft.FluentUI.AspNetCore.Components
@implements IDisposable

@if (State is not null)
{
    <div class="fpag">
        <button type="button" class="fpag__btn" disabled="@(State.Page == 0)"
                @onclick="@(() => State.Go(State.Page - 1))">
            <DIcon Name="chev-l" Size="14" />
        </button>
        <span class="fpag__info">
            @(State.TotalItems == 0 ? 0 : State.Page * State.PageSize + 1)–@(Math.Min(State.TotalItems, (State.Page + 1) * State.PageSize)) / @State.TotalItems
        </span>
        <button type="button" class="fpag__btn" disabled="@((State.Page + 1) * State.PageSize >= State.TotalItems)"
                @onclick="@(() => State.Go(State.Page + 1))">
            <DIcon Name="chev-r" Size="14" />
        </button>
    </div>
}

@code {
    [Parameter] public PaginationState? State { get; set; }

    protected override void OnInitialized()
    {
        if (State is not null) State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() { if (State is not null) State.Changed -= OnChanged; }
}
