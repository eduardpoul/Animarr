@*
    Drop-in for FluentDialog. Usage:
      <FluentDialog @bind-Hidden="_hidden" Modal="true" Width="500px">
        <FluentDialogHeader> ... </FluentDialogHeader>
        <FluentDialogBody>   ... </FluentDialogBody>
        <FluentDialogFooter> ... </FluentDialogFooter>
      </FluentDialog>
*@
@namespace Microsoft.FluentUI.AspNetCore.Components

@if (!Hidden)
{
    <div class="fdlg-overlay" @onclick="OnOverlayClick"></div>
    <div class="fdlg" style="--w:@Width;" role="dialog" aria-modal="true">
        @ChildContent
    </div>
}

@code {
    [Parameter] public bool   Hidden { get; set; } = true;
    [Parameter] public EventCallback<bool> HiddenChanged { get; set; }
    [Parameter] public bool   Modal { get; set; } = true;
    [Parameter] public bool   TrapFocus { get; set; } = true;
    [Parameter] public bool   PreventScroll { get; set; }
    [Parameter] public bool   PreventDismissOnOverlayClick { get; set; }
    [Parameter] public string? Width { get; set; } = "480px";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task OnOverlayClick()
    {
        if (PreventDismissOnOverlayClick) return;
        Hidden = true;
        await HiddenChanged.InvokeAsync(true);
    }
}
