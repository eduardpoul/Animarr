@namespace Microsoft.FluentUI.AspNetCore.Components

<label class="fchk">
    <input type="checkbox" class="fchk__cb"
           checked="@Value"
           disabled="@Disabled"
           @onchange="OnChange" />
    <span class="fchk__box"><DIcon Name="check" Size="10" /></span>
    @if (ChildContent is not null) { <span class="fchk__label">@ChildContent</span> }
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is bool b && b);
}
