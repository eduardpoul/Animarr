@*
    Custom toast container — listens to ToastService.OnShow events and renders
    stacked notifications in the bottom-right corner with auto-dismiss.
*@
@namespace Microsoft.FluentUI.AspNetCore.Components

@implements IDisposable
@inject IToastService Toasts

<div class="ftoast-stack">
    @foreach (var t in _live)
    {
        <div class="@($"ftoast ftoast--{t.Intent.ToString().ToLowerInvariant()}")">
            <span class="ftoast__msg">@t.Message</span>
            <button type="button" class="ftoast__close" @onclick="@(() => _live.Remove(t))">
                <DIcon Name="x" Size="13" />
            </button>
        </div>
    }
</div>

@code {
    private readonly List<ToastInfo> _live = [];
    private const int AutoDismissMs = 4000;

    protected override void OnInitialized()
    {
        Toasts.OnShow += OnShow;
    }

    private void OnShow(ToastInfo info) => InvokeAsync(async () =>
    {
        _live.Add(info);
        StateHasChanged();
        await Task.Delay(AutoDismissMs);
        _live.Remove(info);
        StateHasChanged();
    });

    public void Dispose() { Toasts.OnShow -= OnShow; }
}
