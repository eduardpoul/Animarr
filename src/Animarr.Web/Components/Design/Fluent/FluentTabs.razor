@*
    Drop-in for FluentTabs / FluentTab.
    Callsites use @bind-ActiveTabId="..." and place FluentTab children with Id+Label.
    Orientation: Horizontal (default) or Vertical.
*@
@namespace Microsoft.FluentUI.AspNetCore.Components

<CascadingValue Value="this" IsFixed="false">
    <div class="@($"ftabs ftabs--{Orientation.ToString().ToLowerInvariant()}")"
         style="@Style"
         data-active="@ActiveTabId">
        <nav class="ftabs__nav">
            @foreach (var t in _tabs)
            {
                var id = t.Id;
                <button type="button"
                        class="@($"ftabs__tab {(ActiveTabId == id ? "ftabs__tab--active" : "")}")"
                        @onclick="@(() => SetActive(id))">@t.Label</button>
            }
        </nav>
        <div class="ftabs__panel">
            @ChildContent
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ActiveTabId { get; set; }
    [Parameter] public EventCallback<string?> ActiveTabIdChanged { get; set; }
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public EventCallback<FluentTab> OnTabChange { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Width { get; set; }

    private readonly List<FluentTab> _tabs = [];

    internal void Register(FluentTab tab)
    {
        if (_tabs.All(t => t.Id != tab.Id))
        {
            _tabs.Add(tab);
            if (string.IsNullOrEmpty(ActiveTabId)) ActiveTabId = tab.Id;
            StateHasChanged();
        }
    }

    internal bool IsActive(string? id) => ActiveTabId == id;

    private async Task SetActive(string id)
    {
        ActiveTabId = id;
        await ActiveTabIdChanged.InvokeAsync(id);
        var t = _tabs.FirstOrDefault(t => t.Id == id);
        if (t is not null) await OnTabChange.InvokeAsync(t);
    }
}
