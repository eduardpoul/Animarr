@*
    Drop-in for FluentDataGrid (single-table use case the project actually uses).
    Children: PropertyColumn<TGridItem,TProp> + TemplateColumn<TGridItem> via
    CascadingValue. Pagination param optional.
*@
@namespace Microsoft.FluentUI.AspNetCore.Components
@typeparam TGridItem
@attribute [CascadingTypeParameter(nameof(TGridItem))]

<CascadingValue Value="this" IsFixed="false">
    <div class="fgrid-shell" style="@Style">
        @* invisible: collect columns *@
        <div style="display:none;">@ChildContent</div>

        <div class="fgrid">
            <div class="fgrid__head" style="@GridTemplate()">
                @foreach (var c in _columns)
                {
                    <div class="fgrid__head-cell @CellAlignClass(c)" style="@WidthStyle(c)">@c.Title</div>
                }
            </div>
            @foreach (var row in PaginatedItems())
            {
                <div class="fgrid__row" style="@GridTemplate()">
                    @foreach (var c in _columns)
                    {
                        <div class="fgrid__cell @CellAlignClass(c)" style="@WidthStyle(c)">
                            @c.Render(row)
                        </div>
                    }
                </div>
            }
            @if (!Items.Any())
            {
                <div class="fgrid__empty">No rows.</div>
            }
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public IQueryable<TGridItem> Items { get; set; } = Enumerable.Empty<TGridItem>().AsQueryable();
    [Parameter] public bool ShowHover { get; set; } = true;
    [Parameter] public bool ResizableColumns { get; set; }
    [Parameter] public DataGridRowSize RowSize { get; set; } = DataGridRowSize.Small;
    [Parameter] public string? Style { get; set; }
    [Parameter] public object? Pagination { get; set; }

    private readonly List<IFluentColumn<TGridItem>> _columns = new();

    public void Register(IFluentColumn<TGridItem> col)
    {
        if (!_columns.Contains(col))
        {
            _columns.Add(col);
            StateHasChanged();
        }
    }

    private IEnumerable<TGridItem> PaginatedItems()
    {
        if (Pagination is PaginationState p)
        {
            return Items.Skip(p.Page * p.PageSize).Take(p.PageSize);
        }
        return Items;
    }

    private string GridTemplate()
    {
        var parts = _columns.Select(c => string.IsNullOrEmpty(c.Width) ? "1fr" : c.Width);
        return $"display:grid;grid-template-columns:{string.Join(" ", parts)};";
    }

    private string WidthStyle(IFluentColumn<TGridItem> c) =>
        string.IsNullOrEmpty(c.Width) ? "" : "";

    private string CellAlignClass(IFluentColumn<TGridItem> c) => c.Align switch
    {
        Align.Center => "fgrid__cell--center",
        Align.End    => "fgrid__cell--end",
        _            => "",
    };
}
