@*
    Drop-in for FluentLabel. Renders a semantic h1-h6 or span based on Typo.
    Common callsites: Typo="Typography.H3/H4/H5", optional Style.
*@
@namespace Microsoft.FluentUI.AspNetCore.Components

@switch (Typo)
{
    case Typography.H1: <h1 class="fl fl--h1" style="@Style" @attributes="Extra">@ChildContent</h1> break;
    case Typography.H2: <h2 class="fl fl--h2" style="@Style" @attributes="Extra">@ChildContent</h2> break;
    case Typography.H3: <h3 class="fl fl--h3" style="@Style" @attributes="Extra">@ChildContent</h3> break;
    case Typography.H4: <h4 class="fl fl--h4" style="@Style" @attributes="Extra">@ChildContent</h4> break;
    case Typography.H5: <h5 class="fl fl--h5" style="@Style" @attributes="Extra">@ChildContent</h5> break;
    case Typography.H6: <h6 class="fl fl--h6" style="@Style" @attributes="Extra">@ChildContent</h6> break;
    case Typography.PageTitle: <h1 class="fl fl--pagetitle" style="@Style" @attributes="Extra">@ChildContent</h1> break;
    case Typography.HeroTitle: <h1 class="fl fl--herotitle" style="@Style" @attributes="Extra">@ChildContent</h1> break;
    case Typography.Subject:   <strong class="fl fl--subject" style="@Style" @attributes="Extra">@ChildContent</strong> break;
    default: <span class="fl fl--body" style="@Style" @attributes="Extra">@ChildContent</span> break;
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Typography Typo { get; set; } = Typography.Body;
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Extra { get; set; }
}
