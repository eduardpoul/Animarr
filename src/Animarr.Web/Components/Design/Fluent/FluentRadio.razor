@namespace Microsoft.FluentUI.AspNetCore.Components
@typeparam TValue

<label class="fradio">
    <input type="radio" class="fradio__cb"
           checked="@(Group?.IsSelected(Value) ?? false)"
           @onchange="OnChange" />
    <span class="fradio__dot"></span>
    @if (ChildContent is not null) { <span class="fradio__label">@ChildContent</span> }
</label>

@code {
    [CascadingParameter] public FluentRadioGroup<TValue>? Group { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        if (e.Value is bool checkd && checkd && Group is not null)
            await Group.SetAsync(Value);
    }
}
