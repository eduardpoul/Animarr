@*
    Movie file card — per CHANGELOG_FOR_CLAUDE_CODE.md §3.
    Sits after the body on MediaDetail when type == Movie.

    Layout (desktop):
      ┌─────────────────────────────────────────────────────┐
      │ 16:9 thumb (360px wide)  │  TITLE                   │
      │  ┌─────────────────────┐ │  filename.mkv            │
      │  │ 04 (etc)   [✓ chip] │ │  ┌──────┬──────┬───┬───┐ │
      │  │                     │ │  │ RT   │ RES  │ C │ S │ │
      │  │             [👁 chip]│ │  └──────┴──────┴───┴───┘ │
      │  │ ── progress ────────│ │  [Continue · 38%] [👁 Toggle]
      │  └─────────────────────┘ │                          │
      └─────────────────────────────────────────────────────┘

    Visual language matches EpisodeCard:
      • Left edge strip (3px green) on the wrapping card
      • 30×30 chips top-right (disk-status) and bottom-right (watched-eye)
      • 4px progress bar at thumb bottom
      • Watched-state modifier drops opacity, saturates thumb, etc.

    Mobile: stacks vertically (thumb on top), action buttons collapse to icon-only.
*@

<div class="@CssClass">
    <div class="d-mfc__strip"></div>

    <div class="d-mfc__art">
        @if (!string.IsNullOrEmpty(ThumbUrl))
        {
            <img src="@ThumbUrl" alt="" loading="lazy" class="d-mfc__img" />
        }
        else
        {
            <div class="d-mfc__placeholder"><DIcon Name="video" Size="32" /></div>
        }

        @* TOP-RIGHT — disk-status chip (30×30 on movie card per §4 sizing). *@
        @if (Have)
        {
            <div class="d-mfc__chip d-mfc__chip--ok" title="On disk">
                <DIcon Name="check" Size="14" />
            </div>
        }
        else
        {
            <div class="d-mfc__chip d-mfc__chip--miss" title="Missing — not downloaded">
                <DIcon Name="warn" Size="14" />
            </div>
        }

        @* BOTTOM-RIGHT — watched-eye chip. Same 30×30 box. *@
        @if (Have)
        {
            <button type="button"
                    class="@EyeClass"
                    title="@(IsWatched ? "Mark as unwatched" : "Mark as watched")"
                    @onclick="OnEyeClick"
                    @onclick:stopPropagation="true">
                <DIcon Name="@(IsWatched ? "eye-off" : "eye")" Size="14" />
            </button>
        }

        @* Progress bar — 4px on movie card per CHANGELOG §4. *@
        @if (Have && (IsWatched || ProgressPct > 0))
        {
            <div class="d-mfc__pb">
                <div class="@ProgressFillClass" style="width: @(IsWatched ? 100 : ProgressPct)%"></div>
            </div>
        }
    </div>

    <div class="d-mfc__info">
        <div class="d-mfc__overline">FILE · ON DISK</div>
        <div class="d-mfc__title">@Title</div>
        @if (!string.IsNullOrEmpty(FileName))
        {
            <div class="d-mfc__filename" title="@FileName">@FileName</div>
        }

        @* Four key/value cells — RUNTIME / RES / CODEC / SIZE. CHANGELOG §3. *@
        <div class="d-mfc__cells">
            <div class="d-mfc__cell">
                <span class="d-mfc__cell-k">RUNTIME</span>
                <span class="d-mfc__cell-v">@(Runtime ?? "—")</span>
            </div>
            <div class="d-mfc__cell">
                <span class="d-mfc__cell-k">RES</span>
                <span class="d-mfc__cell-v">@(Resolution ?? "—")</span>
            </div>
            <div class="d-mfc__cell">
                <span class="d-mfc__cell-k">CODEC</span>
                <span class="d-mfc__cell-v">@(Codec ?? "—")</span>
            </div>
            <div class="d-mfc__cell">
                <span class="d-mfc__cell-k">SIZE</span>
                <span class="d-mfc__cell-v">@(Size ?? "—")</span>
            </div>
        </div>

        <div class="d-mfc__actions">
            @* Primary CTA — label matches the hero's "Continue / Play movie / Rewatch from start" CTA. *@
            <Btn Variant="primary" Size="md" OnClick="OnPlay">
                <DIcon Name="@PlayIcon" Size="14" />
                <span class="d-mfc__action-label">@PlayLabel</span>
            </Btn>
            @if (Have)
            {
                <Btn Variant="solid" Size="md" OnClick="OnEyeClick">
                    <DIcon Name="@(IsWatched ? "eye-off" : "eye")" Size="14" />
                    <span class="d-mfc__action-label">@(IsWatched ? "Mark as unwatched" : "Mark as watched")</span>
                </Btn>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title    { get; set; } = "";
    [Parameter] public string?  FileName   { get; set; }
    [Parameter] public string?  ThumbUrl   { get; set; }
    [Parameter] public string?  Runtime    { get; set; }
    [Parameter] public string?  Resolution { get; set; }
    [Parameter] public string?  Codec      { get; set; }
    [Parameter] public string?  Size       { get; set; }
    [Parameter] public bool     Have       { get; set; } = true;

    /// <summary>Per-movie WatchState. Null = untouched.</summary>
    [Parameter] public WatchState? WatchState { get; set; }

    /// <summary>Primary CTA label resolved by the parent via ContinueResolver
    /// (keeps button text consistent with the hero).</summary>
    [Parameter] public string PlayLabel { get; set; } = "Play movie";
    [Parameter] public string PlayIcon  { get; set; } = "play";

    [Parameter] public EventCallback OnPlayClick      { get; set; }
    [Parameter] public EventCallback OnToggleWatched  { get; set; }

    private bool IsWatched => WatchState?.IsWatched == true;

    private int ProgressPct
    {
        get
        {
            if (WatchState is { ProgressMs: > 0, RuntimeMs: > 0 } w)
            {
                var pct = (int)Math.Round(100.0 * w.ProgressMs!.Value / w.RuntimeMs!.Value);
                return Math.Clamp(pct, 1, 99);
            }
            return 0;
        }
    }

    private string CssClass
    {
        get
        {
            var cls = Have ? "d-mfc d-mfc--have" : "d-mfc d-mfc--miss";
            if (Have && IsWatched) cls += " d-mfc--watched";
            return cls;
        }
    }

    private string EyeClass => IsWatched
        ? "d-mfc__chip d-mfc__chip--eye d-mfc__chip--eye-on"
        : "d-mfc__chip d-mfc__chip--eye d-mfc__chip--eye-off";

    private string ProgressFillClass => IsWatched
        ? "d-mfc__pb-fill d-mfc__pb-fill--done"
        : "d-mfc__pb-fill d-mfc__pb-fill--inprog";

    private Task OnPlay()     => OnPlayClick.InvokeAsync();
    private Task OnEyeClick() => OnToggleWatched.InvokeAsync();
}
