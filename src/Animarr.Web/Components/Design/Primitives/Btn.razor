@*
    Design button. Variants:
      primary  — solid accent fill, white text. Hero CTA.
      solid    — surface-3 background, regular text. Toolbar default.
      ghost    — transparent, border. Secondary actions.
      flat     — no background, no border. Inline links / tertiary actions.
      danger   — warn-accent fill. Delete confirms.
    Sizes: sm (28px), md (32px), lg (40px).

    Loading:
      Set Loading=true while an async op runs. Per design loaders.html §04
      the button replaces leading content with a Spinner, gains an animated
      bottom-edge bar, and becomes disabled+wait-cursor so the user doesn't
      double-click. The button keeps its width so the layout stays put.
*@

<button type="@Type" class="@CssClass" @attributes="Extra"
        disabled="@(Disabled || Loading)"
        @onclick="OnClick">
    @if (Loading)
    {
        <Spinner Size="sm" Tone="@(Variant == "primary" ? "light" : "accent")" />
    }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string   Variant  { get; set; } = "solid";
    [Parameter] public string   Size     { get; set; } = "md";
    [Parameter] public string   Type     { get; set; } = "button";
    [Parameter] public bool     Disabled { get; set; }
    /// <summary>True while the button's onClick handler is running an async op.
    /// Loaders spec §04 — adds spinner + bottom bar + disabled cursor.</summary>
    [Parameter] public bool     Loading  { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Extra { get; set; }

    private string CssClass
    {
        get
        {
            var c = $"d-btn d-btn--{Variant} d-btn--{Size}";
            if (Loading) c += " d-btn--loading";
            return c;
        }
    }
}
