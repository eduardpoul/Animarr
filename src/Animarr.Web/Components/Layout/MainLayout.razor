@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ThemeService ThemeService
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAppConfigService AppConfig

<FluentDesignTheme @bind-Mode="_themeMode" OfficeColor="@_accentColor" StorageName="animarr-theme" />

<!-- Global backdrop: used by JS initBackdrop from any page -->
<div id="backdrop-container" style="position:fixed;inset:0;z-index:0;pointer-events:none;">
    <div id="backdrop-slide-a" class="backdrop-slide"></div>
    <div id="backdrop-slide-b" class="backdrop-slide"></div>
</div>

<FluentLayout class="h-screen flex flex-col">
    <div class="flex-1 min-h-0 flex flex-row overflow-hidden" style="position:relative;z-index:1;">
        <!-- Sidebar: logo pinned above nav links (outside FluentNavMenu so it appears before the hamburger) -->
        <div class="animarr-sidebar">
            <!-- ── Logo / brand ────────────────────────────────── -->
            <a href="/" style="padding:14px 14px 10px;display:flex;align-items:center;gap:10px;border-bottom:1px solid rgba(128,128,128,0.18);margin-bottom:4px;flex-shrink:0;text-decoration:none;color:inherit;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="28" height="28" style="flex-shrink:0;">
                    <rect width="32" height="32" rx="6" fill="currentColor" fill-opacity="0.15"/>
                    <text x="16" y="24" font-family="Arial, sans-serif" font-size="26" font-weight="900"
                          text-anchor="middle" fill="currentColor" letter-spacing="-1">A</text>
                    <line x1="22" y1="9" x2="22" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <polyline points="19.5,14 22,17.5 24.5,14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    <line x1="19.5" y1="19.5" x2="24.5" y2="19.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span style="font-weight:700;font-size:15px;letter-spacing:0.01em;">Animarr</span>
            </a>
            <!-- ── Nav links ──────────────────────────────────── -->
            <FluentNavMenu Width="220">
                <FluentNavLink Href="/" Icon="@(new Icons.Regular.Size20.VideoClip())" Match="NavLinkMatch.All">
                    @L["nav.catalog"]
                </FluentNavLink>
                <FluentNavLink Href="/torrents" Icon="@(new Icons.Regular.Size20.ArrowDownload())" Match="NavLinkMatch.All">
                    @L["nav.torrents"]
                </FluentNavLink>
                <FluentNavLink Href="/explorer" Icon="@(new Icons.Regular.Size20.FolderOpen())" Match="NavLinkMatch.Prefix">
                    @L["nav.explorer"]
                </FluentNavLink>
                <FluentNavLink Href="/history" Icon="@(new Icons.Regular.Size20.History())" Match="NavLinkMatch.Prefix">
                    @L["nav.rename_history"]
                </FluentNavLink>
                <FluentNavLink Href="/settings" Icon="@(new Icons.Regular.Size20.Settings())" Match="NavLinkMatch.Prefix">
                    @L["nav.settings"]
                </FluentNavLink>
            </FluentNavMenu>
        </div>

        <div class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden main-content" style="padding:20px 24px 24px;">
            @Body
        </div>
    </div>
</FluentLayout>

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />

@code {
    private DesignThemeModes _themeMode = DesignThemeModes.System;
    private OfficeColor? _accentColor;
    private const string AccentStorageKey = "animarr-accent";
    private bool _everywhereBackdropStarted;

    protected override void OnInitialized()
    {
        _themeMode = ThemeService.Mode;
        _accentColor = ThemeService.AccentColor;
        ThemeService.OnChange += OnThemeChanged;
        L.LanguageChanged += OnLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", AccentStorageKey);
            if (!string.IsNullOrEmpty(stored) && Enum.TryParse<OfficeColor>(stored, out var color))
            {
                ThemeService.SetAccentColor(color);
                _accentColor = color;
                StateHasChanged();
            }

            // Global backdrop: always on when enabled, manages all pages
            var enabled = await AppConfig.GetAsync<bool>(AppConfigKeys.BackdropEnabled, true);
            if (enabled)
            {
                var interval   = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropIntervalSec, 30);
                var blur       = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBlurPx, 0);
                if (blur > 20) { blur = 0; await AppConfig.SetAsync<int>(AppConfigKeys.BackdropBlurPx, 0); }
                var brightness = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBrightness, 60);

                await using var db = await DbFactory.CreateDbContextAsync();
                var fanarts = await db.MediaItems
                    .Where(m => m.FanartPath != null && m.Folder != null)
                    .Select(m => new { m.Folder!.Path, m.FanartPath })
                    .ToListAsync();

                var urls = fanarts
                    .Select(m => $"/api/image?path={Uri.EscapeDataString(Path.Combine(m.Path, m.FanartPath!))}")
                    .ToArray();

                if (urls.Length > 0)
                {
                    _everywhereBackdropStarted = true;
                    await JS.InvokeVoidAsync("initGlobalBackdrop", urls, interval, blur, brightness);
                }
            }
        }
    }

    private void OnThemeChanged()
    {
        _themeMode = ThemeService.Mode;
        _accentColor = ThemeService.AccentColor;
        InvokeAsync(SaveAccentColorAsync);
    }

    private async Task SaveAccentColorAsync()
    {
        if (_accentColor.HasValue)
            await JS.InvokeVoidAsync("localStorage.setItem", AccentStorageKey, _accentColor.Value.ToString());
        else
            await JS.InvokeVoidAsync("localStorage.removeItem", AccentStorageKey);
        StateHasChanged();
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnChange -= OnThemeChanged;
        L.LanguageChanged -= OnLanguageChanged;
        if (_everywhereBackdropStarted)
            try { await JS.InvokeVoidAsync("stopBackdrop"); } catch { }
    }

    private string HeaderStyle() =>
        _themeMode == DesignThemeModes.Dark ? "background-color:var(--colorBrandBackground2);display:flex;align-items:center;" : "display:flex;align-items:center;";
}
