@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ThemeService ThemeService
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAppConfigService AppConfig
@inject TorrentEngineService TorrentEngine
@inject IToastService Toasts

@* Dark mode is locked at the token level (tokens.css). No theme provider needed. *@

<div class="animarr-shell">

    @* Always-on backdrop layer (cross-fades managed by backdrop.js).
       Sits at z-index 0 under both the sidebar and main column.
       Stack from bottom to top: slide A / slide B → vignette → hue tint. *@
    <div class="animarr-backdrop">
        <div id="backdrop-container">
            <div id="backdrop-slide-a" class="backdrop-slide"></div>
            <div id="backdrop-slide-b" class="backdrop-slide"></div>
        </div>
        @* CANVAS §01.6.8: radial vignette darkens edges, hue tint pulls everything
           into the current accent palette. Pure CSS — no JS coupling. *@
        <div class="animarr-backdrop__vignette" aria-hidden="true"></div>
        <div class="animarr-backdrop__hue-tint" aria-hidden="true"></div>
    </div>

    @* Film-grain overlay sits above the backdrop, below content. *@
    <div class="film-grain"></div>

    @* Mobile-only top navbar (visible < 960px via components.css §14).
       Renders unconditionally; the @media query hides it on desktop. *@
    <nav class="d-mobile-nav" aria-label="Top navigation">
        <a href="/" class="d-mobile-nav__brand">
            <span class="animarr-brand-mark">A</span>
            <span class="animarr-brand-name">ANIMARR</span>
        </a>
        <span class="d-mobile-nav__spacer"></span>
        @if (_activeDownloads > 0)
        {
            <span class="sb-live" title="@_activeDownloads active">
                <span class="sb-live__dot"></span>@_activeDownloads LIVE
            </span>
        }
    </nav>

    <div class="animarr-body">
        <aside class="animarr-sidebar">
            <a href="/" class="animarr-brand">
                @* Gradient mark per CANVAS §01.6.6: 28×28, 6px radius,
                   135° accent→darker-accent gradient, Archivo Black "A" centered. *@
                <span class="animarr-brand-mark">A</span>
                <div>
                    <div class="animarr-brand-name">ANIMARR</div>
                    <div class="animarr-brand-build">v0.2 · LOCAL</div>
                </div>
            </a>

            @* Design collapses 5 sidebar entries → 3. Explorer is deleted entirely
               (its functions moved into Catalog + Settings → Root folders), and
               History moves under Settings. The /history route still resolves so
               deep links keep working. *@
            <FluentNavMenu Width="220">
                <FluentNavLink Href="/" Icon="@(new Icons.Regular.Size20.VideoClip())" Match="NavLinkMatch.All">
                    <ChildContent>@L["nav.catalog"]</ChildContent>
                    <Trailing>
                        @if (_catalogCount is int n && n > 0)
                        {
                            <span class="sb-count">@n</span>
                        }
                    </Trailing>
                </FluentNavLink>
                <FluentNavLink Href="/torrents" Icon="@(new Icons.Regular.Size20.ArrowDownload())" Match="NavLinkMatch.All">
                    <ChildContent>@L["nav.torrents"]</ChildContent>
                    <Trailing>
                        @* LIVE only when there are torrents actively moving bytes.
                           Polled every 3s by _liveTimer below. *@
                        @if (_activeDownloads > 0)
                        {
                            <span class="sb-live"><span class="sb-live__dot"></span>@_activeDownloads LIVE</span>
                        }
                    </Trailing>
                </FluentNavLink>
                <FluentNavLink Href="/settings" Icon="@(new Icons.Regular.Size20.Settings())" Match="NavLinkMatch.Prefix">
                    @L["nav.settings"]
                </FluentNavLink>
            </FluentNavMenu>

            <SidebarLlmStatus />
        </aside>

        <main class="animarr-main">
            @Body
        </main>
    </div>

    @* Mobile bottom tab bar — visible below 960px (display: none above).
       Mirrors the three sidebar nav items. *@
    <nav class="d-tabbar" aria-label="Primary mobile navigation">
        <NavLink class="d-tabbar__item" Match="NavLinkMatch.All" href="/" ActiveClass="d-tabbar__item--active">
            <DIcon Name="catalog" Size="22" />
            <span class="d-tabbar__label">@L["nav.catalog"]</span>
        </NavLink>
        <NavLink class="d-tabbar__item" Match="NavLinkMatch.All" href="/torrents" ActiveClass="d-tabbar__item--active">
            <DIcon Name="torrent" Size="22" />
            <span class="d-tabbar__label">@L["nav.torrents"]</span>
        </NavLink>
        <NavLink class="d-tabbar__item" Match="NavLinkMatch.Prefix" href="/settings" ActiveClass="d-tabbar__item--active">
            <DIcon Name="settings" Size="22" />
            <span class="d-tabbar__label">@L["nav.settings"]</span>
        </NavLink>
    </nav>
</div>

@* Inline toast container — replaces FluentToastProvider. Listens for
   ToastService.OnShow events and renders auto-dismissing toasts in the
   bottom-right corner. Styles are scoped to MainLayout.razor.css. *@
<div class="ml-toast-stack">
    @foreach (var t in _toasts)
    {
        <div class="@($"ml-toast ml-toast--{t.Intent.ToString().ToLowerInvariant()}")">
            <span class="ml-toast__msg">@t.Message</span>
            <button type="button" class="ml-toast__close" @onclick="@(() => _toasts.Remove(t))" aria-label="Close">
                <DIcon Name="x" Size="13" />
            </button>
        </div>
    }
</div>

@code {
    private OfficeColor? _accentColor;
    private const string AccentStorageKey = "animarr-accent";
    private bool _everywhereBackdropStarted;
    private int? _catalogCount;
    private int _activeDownloads;
    private System.Threading.Timer? _liveTimer;

    // ── Toast state (inline replacement for FluentToastProvider) ──
    private readonly List<ToastInfo> _toasts = [];
    private const int ToastAutoDismissMs = 4000;

    protected override void OnInitialized()
    {
        _accentColor = ThemeService.AccentColor;
        ThemeService.OnChange += OnThemeChanged;
        L.LanguageChanged += OnLanguageChanged;
        Toasts.OnShow += OnToastShown;

        // LIVE badge polls the in-memory torrent snapshot every 3 seconds.
        // Cheap — _liveStats is a ConcurrentDictionary already in RAM, no I/O.
        _liveTimer = new System.Threading.Timer(_ => RefreshLive(), null,
            TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(3));
    }

    private void OnToastShown(ToastInfo info) => InvokeAsync(async () =>
    {
        _toasts.Add(info);
        StateHasChanged();
        await Task.Delay(ToastAutoDismissMs);
        _toasts.Remove(info);
        StateHasChanged();
    });

    private void RefreshLive()
    {
        try
        {
            // "Live" = state Downloading OR actively moving bytes either direction.
            var n = TorrentEngine.GetAll().Count(s =>
                s.State == MonoTorrent.Client.TorrentState.Downloading ||
                s.DownloadRate > 0 ||
                s.UploadRate > 0);
            if (n != _activeDownloads)
            {
                _activeDownloads = n;
                InvokeAsync(StateHasChanged);
            }
        }
        catch { /* engine may be mid-startup; tick again next interval */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Accent restoration: prefer an integer hue (new format), fall back
            // to the legacy OfficeColor enum string. Either way push the hue
            // into the DOM so every oklch(... var(--accent-hue)) rule recomputes.
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", AccentStorageKey);
            if (!string.IsNullOrEmpty(stored))
            {
                if (int.TryParse(stored, out var hue))
                {
                    ThemeService.SetAccentHue(hue);
                }
                else if (Enum.TryParse<OfficeColor>(stored, out var color))
                {
                    ThemeService.SetAccentColor(color);
                    _accentColor = color;
                }
                StateHasChanged();
            }
            await ApplyAccentHueToDomAsync(ThemeService.AccentHue);

            // Catalog count for the sidebar nav badge — design §01.6.6.
            try
            {
                await using var countDb = await DbFactory.CreateDbContextAsync();
                _catalogCount = await countDb.MediaItems.CountAsync();
                StateHasChanged();
            }
            catch { /* sidebar count is decorative; ignore DB hiccup */ }

            // Global backdrop: always on when enabled, manages all pages
            var enabled = await AppConfig.GetAsync<bool>(AppConfigKeys.BackdropEnabled, true);
            if (enabled)
            {
                // CANVAS §01.6.8 design defaults: blur=14, brightness=38. User
                // can still override via Settings → Appearance.
                var interval   = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropIntervalSec, 30);
                var blur       = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBlurPx, 14);
                if (blur > 30) { blur = 14; await AppConfig.SetAsync<int>(AppConfigKeys.BackdropBlurPx, 14); }
                var brightness = await AppConfig.GetAsync<int>(AppConfigKeys.BackdropBrightness, 38);

                await using var db = await DbFactory.CreateDbContextAsync();
                var fanarts = await db.MediaItems
                    .Where(m => m.FanartPath != null && m.Folder != null)
                    .Select(m => new { m.Folder!.Path, m.FanartPath, m.LastMetadataRefreshedAt })
                    .ToListAsync();

                // Cache-buster: re-identification overwrites the file at the same path,
                // so the browser needs a fresh URL to pick up the new backdrop.
                var urls = fanarts
                    .Select(m => $"/api/image?path={Uri.EscapeDataString(Path.Combine(m.Path, m.FanartPath!))}&t={m.LastMetadataRefreshedAt?.Ticks ?? 0}")
                    .ToArray();

                if (urls.Length > 0)
                {
                    _everywhereBackdropStarted = true;
                    await JS.InvokeVoidAsync("initGlobalBackdrop", urls, interval, blur, brightness);
                }
            }
        }
    }

    private void OnThemeChanged()
    {
        _accentColor = ThemeService.AccentColor;
        InvokeAsync(SaveAccentColorAsync);
        InvokeAsync(() => ApplyAccentHueToDomAsync(ThemeService.AccentHue));
    }

    /// <summary>Push the active hue into the `--accent-hue` CSS custom property
    /// on document.documentElement so every oklch(... var(--accent-hue)) rule
    /// in the stylesheet picks up the new value without a reload.</summary>
    private async Task ApplyAccentHueToDomAsync(int hue)
    {
        try { await JS.InvokeVoidAsync("animarr_setAccentHue", hue); }
        catch { /* JS interop may not be ready on the very first tick */ }
    }

    private async Task SaveAccentColorAsync()
    {
        // Persist as the raw hue degree — Settings page reads this back and
        // restores the swatch on next mount. Old OfficeColor enum strings are
        // still parsed in OnAfterRenderAsync for back-compat with stale storage.
        await JS.InvokeVoidAsync("localStorage.setItem", AccentStorageKey, ThemeService.AccentHue.ToString());
        StateHasChanged();
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnChange -= OnThemeChanged;
        L.LanguageChanged -= OnLanguageChanged;
        Toasts.OnShow -= OnToastShown;
        if (_liveTimer is not null) await _liveTimer.DisposeAsync();
        if (_everywhereBackdropStarted)
            try { await JS.InvokeVoidAsync("stopBackdrop"); } catch { }
    }
}
