@*
    Franchise watch-order rail (MediaDetail). Cards come pre-sorted in release
    order; library members are clickable posters with a watched tick, the
    current title gets an accent outline + "вы здесь", missing members render
    dashed with an AniList cover and a Want button (watchlist by AniList id).
    Spec: design feat-detail.jsx (FranchiseRail/FranchiseNode).
*@
@inject IAnimarrApiClient Api
@inject NavigationManager Nav

@if (Franchise is { Cards.Count: > 1 } fr)
{
    <section class="frail">
        <div class="frail__head">
            <div>
                <div class="frail__overline">@L["franchise.overline"]</div>
                <h2 class="frail__title">@fr.Title</h2>
            </div>
            <span class="frail__progress">@L.Get("franchise.progress", fr.WatchedCount, fr.Total)</span>
        </div>
        <div class="frail__row">
            @for (var i = 0; i < fr.Cards.Count; i++)
            {
                var card = fr.Cards[i];
                var order = i + 1;
                <div class="frail__cell">
                    <div class="@($"frail__art-wrap {(card.IsCurrent ? "is-current" : "")}")">
                        <span class="frail__order">@order</span>
                        @if (card.InLibrary && card.MediaItemId is Guid mid)
                        {
                            <a class="frail__poster tv-focus" href="/catalog/@mid" title="@card.Title">
                                @if (!string.IsNullOrEmpty(card.CoverUrl))
                                {
                                    <img loading="lazy" src="@card.CoverUrl" alt="@card.Title" class="frail__img" />
                                }
                                else
                                {
                                    <div class="frail__ph"><DIcon Name="video" Size="28" /></div>
                                }
                                @if (card.Watched)
                                {
                                    <span class="frail__watched" title="@L["home.continue_watching"]">✓</span>
                                }
                            </a>
                        }
                        else
                        {
                            <div class="frail__ext" title="@card.Title">
                                @if (!string.IsNullOrEmpty(card.CoverUrl))
                                {
                                    <img loading="lazy" src="@card.CoverUrl" alt="@card.Title" class="frail__img frail__img--dim" />
                                }
                                else
                                {
                                    <div class="frail__ph"><DIcon Name="video" Size="28" /></div>
                                }
                                <span class="frail__ext-badge">@L["recs.not_in_library"]</span>
                                <button type="button"
                                        class="@($"frail__want tv-focus {(_wanted.Contains(card.AniListId) ? "is-on" : "")}")"
                                        @onclick="@(() => WantAsync(card))">
                                    @(_wanted.Contains(card.AniListId) ? L["recs.in_list"] : L["recs.want"])
                                </button>
                            </div>
                        }
                        @if (card.IsCurrent)
                        {
                            <span class="frail__here">@L["franchise.you_are_here"]</span>
                        }
                    </div>
                    <div class="frail__name">@card.Title</div>
                    <div class="frail__meta">
                        @if (card.Year is int y) { <span>@y</span> <span class="frail__dot">·</span> }
                        <span>@FormatLabel(card.Format)</span>
                        @if (card.SpanCount > 1) { <span class="frail__dot">·</span> <span>S1–S@(card.SpanCount)</span> }
                        else if (card.Episodes is > 1) { <span class="frail__dot">·</span> <span>@card.Episodes EP</span> }
                    </div>
                    @if (RelationLabel(card.Relation) is string rel)
                    {
                        <span class="frail__rel">@rel</span>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public FranchiseDto? Franchise { get; set; }

    private readonly HashSet<int> _wanted = new();

    private async Task WantAsync(FranchiseCardDto card)
    {
        if (_wanted.Contains(card.AniListId)) return;
        _wanted.Add(card.AniListId);
        try
        {
            await Api.AddWatchlistAsync(new WatchlistAddRequest(
                null, null, card.Title, card.Year, card.CoverUrl,
                card.Format == "MOVIE" ? "movie" : "tv",
                AniListId: card.AniListId));
        }
        catch { _wanted.Remove(card.AniListId); }
        StateHasChanged();
    }

    private static string FormatLabel(string? format) => format?.ToUpperInvariant() switch
    {
        "MOVIE"    => "Movie",
        "OVA"      => "OVA",
        "ONA"      => "ONA",
        "SPECIAL"  => "Special",
        "TV_SHORT" => "TV",
        _          => "TV",
    };

    private string? RelationLabel(string? relation) => relation?.ToUpperInvariant() switch
    {
        "SIDE_STORY"  => L["franchise.rel_side_story"],
        "SPIN_OFF"    => L["franchise.rel_spin_off"],
        "ALTERNATIVE" => L["franchise.rel_alternative"],
        "SUMMARY"     => L["franchise.rel_summary"],
        _             => null,
    };
}
