@*
    Catalog poster card. Procedural background from MediaItemDto.FanartPath
    served via /api/image, washed with hue tint, CJK watermark corner,
    type ribbon + confidence chip.

    Click navigates to /catalog/{Id}.
*@

<a class="d-poster" href="/catalog/@Item.Id" title="@Item.Title"
   style="--hue: @(Item.Hue ?? 0)">
    <div class="d-poster__art">
        @if (!string.IsNullOrEmpty(Item.PosterPath) || !string.IsNullOrEmpty(Item.FanartPath))
        {
            <img loading="lazy"
                 src="@ImageUrl"
                 alt="@Item.Title"
                 class="d-poster__img" />
        }
        else
        {
            <div class="d-poster__placeholder">
                <DIcon Name="video" Size="36" />
            </div>
        }

        <div class="d-poster__wash"></div>

        @if (!string.IsNullOrEmpty(Item.CjkTitle))
        {
            <div class="d-poster__cjk">@Item.CjkTitle</div>
        }

        @* CANVAS §01.6.4: type ribbon top-left — dark glass, smaller than a pill,
           dedicated to the genre/type. Distinct from regular Pill tones. *@
        <div class="d-poster__ribbon">@TypeLabel(Item.MediaType)</div>

        @if ((Item.LlmConfidence ?? 1) < 0.85 && Item.IdentificationStatus != IdentificationStatus.Manual)
        {
            <div class="d-poster__conf">
                <Pill Tone="warn" Dense="true">@($"{(Item.LlmConfidence ?? 0):P0}")</Pill>
            </div>
        }

        <div class="d-poster__overlay">
            <div class="d-poster__title">@Item.Title</div>
            <div class="d-poster__meta">
                @if (Item.Year is not null) { <span>@Item.Year</span> }
                @if (Item.EpisodeCount is > 0) { <span class="d-poster__dot">·</span><span>@L.Get("common.episode_count_fmt", Item.EpisodeCount)</span> }
                @if (Item.Rating is > 0) { <span class="d-poster__dot">·</span><span>★ @($"{Item.Rating:F1}")</span> }
            </div>
        </div>
    </div>
</a>

@implements IDisposable
@code {
    [Parameter, EditorRequired] public MediaItemDto Item { get; set; } = null!;

    private string ImageUrl
    {
        get
        {
            var path = Item.PosterPath ?? Item.FanartPath;
            if (string.IsNullOrEmpty(path)) return "";
            // Cache-buster: re-identification overwrites the file at the same path,
            // so without this the browser keeps serving the stale image even after
            // a rescan downloads a new poster.
            var v = Item.LastMetadataRefreshedAt?.Ticks ?? 0;
            // Cap to ~card width (grid track ≈ 220px, ×1.5 for sharpness) so the
            // client decodes a ~330px bitmap instead of the full w500 poster —
            // the catalog's 240 cards otherwise thrash GPU texture memory on
            // weak TV boxes. Server caches the resized variant per (path,width).
            return Animarr.UI.Services.MediaUrl.Image(path, v, 330);
        }
    }

    // Re-render whenever the active server URL flips so the <img src> picks up
    // the new authority. Without this, the very first render of a cookie-
    // restored MAUI boot bakes the wrong host into src and never updates.
    protected override void OnInitialized()
    {
        Animarr.UI.Services.MediaUrl.OnBaseChanged += OnBaseChanged;
        _rendered = RenderInputs();   // what the first render (always runs) shows
    }
    public void Dispose()
        => Animarr.UI.Services.MediaUrl.OnBaseChanged -= OnBaseChanged;
    private void OnBaseChanged() => InvokeAsync(StateHasChanged);

    // ── Render gate ───────────────────────────────────────────────────────
    // Item is a record, which Blazor's parameter diff always treats as "maybe
    // changed" — so every parent render (Home filter / prefs changes, each
    // Search keystroke over up to 240 cards) re-rendered every poster. The card
    // only shows the Item instance (records are replaced, never mutated), the
    // media base + token baked into the image URL, and localized labels — so
    // re-render only when one of those changed.
    private (object? Item, string Base, string? Token, string Lang) _rendered;

    private (object? Item, string Base, string? Token, string Lang) RenderInputs() =>
        (Item, Animarr.UI.Services.MediaUrl.Base, Animarr.UI.Services.MediaUrl.Token, L.CurrentLanguage);

    protected override bool ShouldRender()
    {
        var now = RenderInputs();
        if (ReferenceEquals(now.Item, _rendered.Item)
            && now.Base  == _rendered.Base
            && now.Token == _rendered.Token
            && now.Lang  == _rendered.Lang)
            return false;
        _rendered = now;
        return true;
    }

    private string TypeLabel(MediaItemType t) => t switch
    {
        MediaItemType.Anime       => L["poster.type_anime"],
        MediaItemType.Movie       => L["poster.type_movie"],
        MediaItemType.Series      => L["poster.type_series"],
        MediaItemType.Multserials => L["poster.type_multi"],
        _                         => L["poster.type_media"],
    };
}
