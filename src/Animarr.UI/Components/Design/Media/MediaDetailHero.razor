@*
    MediaDetail hero — full-bleed fanart, Back glass chip, poster + title +
    meta strip, then ONE action row: primary Play / Continue, Watched toggle
    (movies), Favorite and Edit. Pushes Item.FanartPath into the global
    backdrop on mount.

    Layout: 68vh / min 580px hero, bottom row "260px poster | flex 1 title block".
*@

@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<section class="d-mdhero" style="--hue: @(Item.Hue ?? 0)">
    <div class="d-mdhero__bg">
        @if (!string.IsNullOrEmpty(Item.FanartPath))
        {
            @* Cache-buster on LastMetadataRefreshedAt — rescan overwrites the file at the same path. *@
            <img src="@Animarr.UI.Services.MediaUrl.Image(Item.FanartPath, Item.LastMetadataRefreshedAt?.Ticks ?? 0)"
                 alt="" class="d-mdhero__bg-img" />
        }
        <div class="d-mdhero__wash"></div>
    </div>

    @if (!string.IsNullOrEmpty(Item.CjkTitle))
    {
        <div class="d-mdhero__cjk">@Item.CjkTitle</div>
    }

    @* Unified back affordance — the SAME <PageBack> used on /search, Downloads
       and Server settings, so "back" looks and behaves identically everywhere
       (arrow-only glass square, top-left, history.back with a "/" fallback).
       Positioned over the fanart via .d-mdhero__backwrap; shows on web AND
       mobile. *@
    <div class="d-mdhero__backwrap">
        <PageBack Fallback="@BackHref" />
    </div>

    <div class="d-mdhero__content">
        @if (!string.IsNullOrEmpty(Item.PosterPath))
        {
            @* Cache-buster on LastMetadataRefreshedAt — rescan overwrites the file at the same path. *@
            <img src="@Animarr.UI.Services.MediaUrl.Image(Item.PosterPath, Item.LastMetadataRefreshedAt?.Ticks ?? 0)"
                 alt="@Item.Title" class="d-mdhero__poster" />
        }
        else
        {
            <div class="d-mdhero__poster d-mdhero__poster--placeholder">
                <DIcon Name="video" Size="48" />
            </div>
        }

        <div class="d-mdhero__title-block">
            @* Title leads — pills + meta sit BELOW it so a long anime name
               can't push the tag chips up under the TopBar's brand row.
               Matches CatalogContinueHero's order: brand mark, title, then
               the secondary chip strip. *@
            <h1 class="d-mdhero__title">@Item.Title</h1>
            @if (!string.IsNullOrEmpty(Item.EnglishTitle) && Item.EnglishTitle != Item.Title)
            {
                <div class="d-mdhero__alt">@Item.EnglishTitle</div>
            }

            <div class="d-mdhero__pills">
                <Pill Tone="accent">@TypeLabel(Item.MediaType)</Pill>
                @if (Item.IdentificationStatus == IdentificationStatus.Manual) { <Pill Tone="info">@L["media_detail_hero.pill_manual"]</Pill> }
                @if (Item.IdentificationStatus == IdentificationStatus.NeedsReview) { <Pill Tone="warn">@L["media_detail_hero.pill_needs_review"]</Pill> }
                @foreach (var tag in TagPreview(Item))
                {
                    <Pill>@tag</Pill>
                }
            </div>

            <div class="d-mdhero__meta">
                @if (Item.Rating is > 0) { <span>★ @($"{Item.Rating:F1}")</span><span class="d-mdhero__dot">·</span> }
                @if (Item.Year is not null) { <span>@Item.Year</span><span class="d-mdhero__dot">·</span> }
                @if (!string.IsNullOrEmpty(Item.Studio)) { <span>@Item.Studio</span><span class="d-mdhero__dot">·</span> }
                @if (Item.Runtime is > 0) { <span>@Item.Runtime @L["media_detail_hero.runtime_unit"]</span><span class="d-mdhero__dot">·</span> }
                @if (Item.EpisodeCount is > 0) { <span>@Item.EpisodeCount @L["media_detail_hero.episode_count_fmt_short"]</span><span class="d-mdhero__dot">·</span> }
                @if (!string.IsNullOrEmpty(Item.Language)) { <span>@Item.Language</span><span class="d-mdhero__dot">·</span> }
                @if (BestConfidence is > 0)
                {
                    <span class="d-mdhero__conf">@($"{BestConfidence:P0}") @L["media_detail_hero.match_suffix"]</span>
                }
            </div>

            @* Action row — Fluent command pattern: one primary button, then
               secondary actions as glass buttons (icon + label, or icon-only
               with a tooltip). Primary = the server-resolved Continue action
               (7-state matrix), else the parent's fallback Play (movies with
               no watch state yet). data-tv-autofocus parks the TV remote on
               the primary; without one, focus falls through to Favorite. *@
            <div class="d-mdhero__cta">
                @if (Continue is not null)
                {
                    <Btn Variant="primary" Size="lg" OnClick="OnContinue" data-tv-autofocus="true">
                        <DIcon Name="@Continue.IconName" Size="16" />
                        @ContinueLabel(Continue)
                    </Btn>
                }
                else if (!string.IsNullOrEmpty(PlayLabel) && OnPlayClick.HasDelegate)
                {
                    <Btn Variant="primary" Size="lg" OnClick="@(() => OnPlayClick.InvokeAsync())" data-tv-autofocus="true">
                        <DIcon Name="@PlayIcon" Size="16" />
                        @PlayLabel
                    </Btn>
                }

                @if (Watched is bool watched)
                {
                    <button type="button" class="@($"d-mdhero__act tv-focus {(watched ? "is-on" : "")}")"
                            aria-pressed="@(watched ? "true" : "false")"
                            title="@(watched ? L["movie_file_card.tooltip_mark_unwatched"] : L["movie_file_card.tooltip_mark_watched"])"
                            @onclick="@(() => OnToggleWatchedClick.InvokeAsync())">
                        <DIcon Name="@(watched ? "check" : "eye")" Size="16" />
                        <span>@(watched ? L["media_detail_hero.btn_watched"] : L["media_detail_hero.btn_mark_watched"])</span>
                    </button>
                }

                <button type="button"
                        class="@($"d-mdhero__act d-mdhero__act--icon tv-focus {(Item.IsFavorite ? "is-fav" : "")}")"
                        aria-pressed="@(Item.IsFavorite ? "true" : "false")"
                        aria-label="@(Item.IsFavorite ? L["media_detail_hero.fav_remove"] : L["media_detail_hero.fav_add"])"
                        title="@(Item.IsFavorite ? L["media_detail_hero.fav_remove"] : L["media_detail_hero.fav_add"])"
                        @onclick="OnFavorite">
                    <DIcon Name="@(Item.IsFavorite ? "bookmark-f" : "bookmark")" Size="20" />
                </button>
                @* Metadata editing is admin-only server-side — hide it otherwise. *@
                @if (ShowEdit)
                {
                    <button type="button" class="d-mdhero__act d-mdhero__act--icon tv-focus" @onclick="OnEdit"
                            aria-label="@L["media_detail_hero.edit_metadata_tooltip"]"
                            title="@L["media_detail_hero.edit_metadata_tooltip"]">
                        <DIcon Name="pencil" Size="20" />
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public MediaItemDto Item { get; set; } = null!;
    [Parameter] public string BackHref { get; set; } = "/";
    [Parameter] public EventCallback OnEditClick { get; set; }
    /// <summary>False hides the Edit chip — metadata editing is admin-only server-side.</summary>
    [Parameter] public bool ShowEdit { get; set; } = true;
    /// <summary>Resolved per CHANGELOG §2. Null → no CTA row rendered.</summary>
    [Parameter] public ContinueAction? Continue { get; set; }
    [Parameter] public EventCallback<ContinueAction> OnContinueClick { get; set; }
    /// <summary>Fallback primary when <see cref="Continue"/> is null (e.g. a
    /// movie nobody has started) — label + icon + handler from the parent.</summary>
    [Parameter] public string? PlayLabel { get; set; }
    [Parameter] public string PlayIcon { get; set; } = "play";
    [Parameter] public EventCallback OnPlayClick { get; set; }
    /// <summary>Movie watched state; null hides the toggle (series track
    /// watched per episode).</summary>
    [Parameter] public bool? Watched { get; set; }
    [Parameter] public EventCallback OnToggleWatchedClick { get; set; }

    /// <summary>Localised caption for the primary CTA, rebuilt from the
    /// server's Kind + episode hint so it reads in the UI language. Falls back
    /// to the server-supplied English Label for any unmapped Kind.</summary>
    private string ContinueLabel(ContinueAction c) => c.Kind switch
    {
        "continue" or "next" when c.EpisodeHint is int ep => L.Get("continue.continue_ep_fmt", ep.ToString("D2")),
        "continue"                                        => L["continue.resume"],
        "first" when c.EpisodeHint is int                 => L["continue.play_first_episode"],
        "first"                                           => L["continue.play_movie"],
        "rewatch"                                         => L["continue.rewatch_from_start"],
        _                                                 => c.Label,
    };
    /// <summary>Fired when ★ Favorite button is clicked. Parent flips
    /// the IsFavorite flag and calls Api.Add/RemoveFavoriteAsync.</summary>
    [Parameter] public EventCallback OnFavoriteClick { get; set; }

    private double BestConfidence
    {
        get
        {
            // Pick the highest confidence we have. UI shows ONE number.
            double[] vals = [
                Item.TmdbConfidence ?? 0,
                Item.MalConfidence  ?? 0,
                Item.ImdbConfidence ?? 0,
                Item.LlmConfidence  ?? 0,
            ];
            return vals.Max();
        }
    }

    protected override void OnInitialized()
    {
        // Re-render when the active server URL flips so the fanart/poster
        // <img src>'s rebase to the user's chosen server. Without this, a
        // cookie-restored MAUI boot bakes the wrong host into src on first
        // render and never updates.
        Animarr.UI.Services.MediaUrl.OnBaseChanged += OnBaseChanged;
    }

    private void OnBaseChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(Item.FanartPath))
        {
            // Width-capped: the layer sits under blur(12px) brightness(50%), so
            // a 480 px variant looks the same as the full fanart the sharp hero
            // <img> above shows, at a fraction of the decode.
            var url = Animarr.UI.Services.MediaUrl.Image(Item.FanartPath, Item.LastMetadataRefreshedAt?.Ticks ?? 0,
                Animarr.UI.Services.MediaUrl.BlurredBackdropWidth);
            try { await JS.InvokeVoidAsync("initBackdrop", new[] { url }, 0, 12, 50); } catch { }
        }
    }

    private Task OnEdit() => OnEditClick.InvokeAsync();
    private Task OnFavorite() => OnFavoriteClick.InvokeAsync();

    private Task OnContinue()
    {
        // Parent (MediaDetail) owns the player lifecycle — it decides whether
        // Continue means "resume at progress" or "start fresh" based on the
        // resolved action that came in via the Continue parameter.
        return Continue is null ? Task.CompletedTask : OnContinueClick.InvokeAsync(Continue);
    }

    private string TypeLabel(MediaItemType t) => t switch
    {
        MediaItemType.Anime       => L["media_detail_hero.type_anime"],
        MediaItemType.Movie       => L["media_detail_hero.type_movie"],
        MediaItemType.Series      => L["media_detail_hero.type_series"],
        MediaItemType.Multserials => L["media_detail_hero.type_multi"],
        _                         => L["media_detail_hero.type_media"],
    };

    private static IEnumerable<string> TagPreview(MediaItemDto item)
    {
        // Themes that want UPPERCASE labels handle it via CSS
        // (`text-transform: var(--label-casing)`). Don't force case here.
        foreach (var t in item.Tags.Take(3)) yield return t;
    }

    public void Dispose()
    {
        Animarr.UI.Services.MediaUrl.OnBaseChanged -= OnBaseChanged;
        /* JS layer owns the backdrop lifecycle */
    }
}
