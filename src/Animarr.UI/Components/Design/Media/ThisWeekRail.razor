@*
    "На этой неделе" — Home rail of this week's airing events (compact
    calendar cards). Header links to the full /calendar page; cards click
    into the title. Rendered by Home only when the week has events.
*@
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Items.Length > 0)
{
    <section class="twr">
        @* No header link — the calendar has its own topbar icon; a second
           entry point here read as clutter (user feedback). *@
        <div class="twr__head">
            <h2 class="twr__title">@L["home.this_week"]</h2>
        </div>
        <div class="twr__viewport">
        @if (_canLeft)
        {
            <button type="button" class="twr__nav twr__nav--l tv-focus" aria-label="‹"
                    @onclick="@(() => ScrollRailAsync(-1))">‹</button>
        }
        @if (_canRight)
        {
            <button type="button" class="twr__nav twr__nav--r tv-focus" aria-label="›"
                    @onclick="@(() => ScrollRailAsync(1))">›</button>
        }
        <div class="twr__row" @ref="_rowRef">
            @foreach (var ev in Items)
            {
                var e = ev;
                var local = e.AiringAtUtc.ToLocalTime();
                <button type="button" class="twr__card tv-focus" title="@e.Title"
                        @onclick="@(() => Nav.NavigateTo($"/catalog/{e.MediaItemId}"))">
                    <span class="twr__art" style="@ArtStyle(e)">
                        <span class="twr__when">@DayLabel(local) · @local.ToString("HH:mm")</span>
                        <span class="twr__name">@e.Title</span>
                    </span>
                    <span class="twr__meta">
                        <span class="twr__ep">EP @e.Episode</span>
                        <span class="@($"cal-chip cal-chip--{e.Status} twr__chip")">@StatusLabel(e.Status)</span>
                    </span>
                </button>
            }
        </div>
        </div>
    </section>
}

@code {
    [Parameter] public CalendarEventDto[] Items { get; set; } = Array.Empty<CalendarEventDto>();

    // Drag-to-scroll + ‹ › paging, shared module with the other rails. Home
    // mounts this rail before the week's events arrive, so init keys off the
    // first render that actually has cards, not firstRender.
    private ElementReference _rowRef;
    private IJSObjectReference? _js;
    private DotNetObjectReference<ThisWeekRail>? _selfRef;
    private bool _canLeft, _canRight, _railInit;

    protected override void OnInitialized()
    {
        // Re-render when the active server URL flips — the MAUI hybrid boot
        // hydrates it after the first render, and the art URLs bake the base.
        Animarr.UI.Services.MediaUrl.OnBaseChanged += OnBaseChanged;
    }

    private void OnBaseChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_railInit || Items.Length == 0) return;
        _railInit = true;
        try
        {
            _js = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Animarr.UI/Components/Design/Media/RecRail.razor.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _js.InvokeVoidAsync("init", _rowRef, _selfRef);
        }
        catch { /* drag/arrows are enhancement — wheel scroll still works */ }
    }

    [JSInvokable]
    public void OnRailScrollState(bool canLeft, bool canRight)
    {
        if (_canLeft == canLeft && _canRight == canRight) return;
        _canLeft = canLeft;
        _canRight = canRight;
        StateHasChanged();
    }

    private async Task ScrollRailAsync(int dir)
    {
        if (_js is null) return;
        try { await _js.InvokeVoidAsync("scrollRail", _rowRef, dir); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        Animarr.UI.Services.MediaUrl.OnBaseChanged -= OnBaseChanged;
        try
        {
            if (_js is not null)
            {
                await _js.InvokeVoidAsync("destroy", _rowRef);
                await _js.DisposeAsync();
            }
        }
        catch { /* circuit teardown */ }
        _selfRef?.Dispose();
    }

    private string DayLabel(DateTime local)
    {
        var today = DateTime.Now.Date;
        if (local.Date == today) return L["calendar.today"];
        if (local.Date == today.AddDays(1)) return L["calendar.tomorrow"];
        // Lang-pack names — WASM's sharded ICU quietly anglicises CultureInfo.
        var parts = L["calendar.weekdays_short"].Split(',');
        return parts.Length == 7 ? parts[(int)local.DayOfWeek] : local.DayOfWeek.ToString()[..3];
    }

    private string StatusLabel(string status) => status switch
    {
        "in-library"    => L["calendar.in_library"],
        "aired-waiting" => L["calendar.aired_waiting"],
        _               => L["calendar.upcoming"],
    };

    private static string ArtStyle(CalendarEventDto e)
    {
        // Rebase the server-relative art URL for the MAUI hybrid (see MediaUrl).
        var raw = e.BackdropUrl ?? e.PosterUrl;
        if (string.IsNullOrEmpty(raw)) return "";
        var abs = Animarr.UI.Services.MediaUrl.Absolute(raw);
        return $"background-image:url('{abs.Replace("'", "%27")}')";
    }
}
