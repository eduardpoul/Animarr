@*
    Native <select> styled with tokens. Replaces FluentSelect/Combobox.
    Use ChildContent to nest <option> elements.
*@
@typeparam T

<div class="d-select">
    <select class="d-select__field"
            value="@(Value?.ToString() ?? "")"
            @onchange="OnChange"
            @attributes="Extra">
        @ChildContent
    </select>
    <span class="d-select__chev"><DIcon Name="chev-d" Size="14" /></span>
</div>

@code {
    [Parameter] public T?      Value         { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Extra { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (typeof(T) == typeof(string))      await ValueChanged.InvokeAsync((T?)(object?)raw);
        else if (typeof(T) == typeof(Guid))   await ValueChanged.InvokeAsync(Guid.TryParse(raw, out var g) ? (T?)(object)g : default);
        else if (typeof(T) == typeof(int))    await ValueChanged.InvokeAsync(int.TryParse(raw, out var i) ? (T?)(object)i : default);
        else if (typeof(T).IsEnum && raw is not null && Enum.TryParse(typeof(T), raw, out var en))
            await ValueChanged.InvokeAsync((T?)en);
        else                                  await ValueChanged.InvokeAsync(default);
    }
}
