@*
    Inline three-dot loader for tables / lists / row-level pending states.
    Spec: design_handoff_animarr/pages/loaders.html §06.

    Use as a placeholder row at the bottom of an infinite-scroll list, or
    inside an empty section that's still resolving.
*@

<div class="d-dots-host">
    <span class="d-dots"><span></span><span></span><span></span></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="d-dots__label">@Label</span>
    }
    @ChildContent
</div>

@code {
    /// <summary>Optional inline caption (e.g. "Loading torrents from session").</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
