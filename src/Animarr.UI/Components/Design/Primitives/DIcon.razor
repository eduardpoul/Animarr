@*
    Inline stroke-based icon (Design Icon — DIcon to avoid name clash with
    Microsoft.FluentUI.AspNetCore.Components.Icon used in legacy pages).
    Source-of-truth = design_handoff_animarr/components.jsx::Icon.
    Stroke uses currentColor — color via CSS, not parameter.

    Use:  <DIcon Name="search" Size="16" />
*@

@switch (Name)
{
    case "catalog":   <svg @attributes="@P"><rect x="3" y="3" width="7" height="9" /><rect x="14" y="3" width="7" height="5" /><rect x="14" y="12" width="7" height="9" /><rect x="3" y="16" width="7" height="5" /></svg> break;
    @* Episode-view toggle glyphs: 2×2 grid vs detailed list (thumb + lines). *@
    case "grid":      <svg @attributes="@P"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5" /><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" /><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" /><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" /></svg> break;
    case "list":      <svg @attributes="@P"><rect x="3" y="4" width="6" height="6" rx="1.2" /><rect x="3" y="14" width="6" height="6" rx="1.2" /><path d="M12 6h9" /><path d="M12 9h6" /><path d="M12 16h9" /><path d="M12 19h6" /></svg> break;
    case "torrent":   <svg @attributes="@P"><path d="M12 4v12" /><path d="m6 10 6 6 6-6" /><path d="M5 20h14" /></svg> break;
    case "folder":    <svg @attributes="@P"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg> break;
    case "clock":     <svg @attributes="@P"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg> break;
    case "settings":  <svg @attributes="@P"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg> break;
    case "search":    <svg @attributes="@P"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg> break;
    case "play":      <svg @attributes="@P"><path d="M6 4l14 8-14 8z" /></svg> break;
    case "plus":      <svg @attributes="@P"><path d="M12 5v14M5 12h14" /></svg> break;
    case "x":         <svg @attributes="@P"><path d="M6 6l12 12M18 6l-12 12" /></svg> break;
    case "check":     <svg @attributes="@P"><path d="M5 12l5 5 9-12" /></svg> break;
    case "warn":      <svg @attributes="@P"><path d="M12 9v4" /><circle cx="12" cy="17" r=".5" fill="currentColor" /><path d="M10.6 3.7 1.7 18.4A2 2 0 0 0 3.4 21h17.2a2 2 0 0 0 1.7-2.6L13.4 3.7a2 2 0 0 0-2.8 0z" /></svg> break;
    case "info":      <svg @attributes="@P"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg> break;
    case "magic":     <svg @attributes="@P"><path d="m13 4 1 3 3 1-3 1-1 3-1-3-3-1 3-1z" /><path d="m4 14 .8 2.2L7 17l-2.2.8L4 20l-.8-2.2L1 17l2.2-.8z" /><path d="m17 14 .8 2.2L20 17l-2.2.8L17 20l-.8-2.2L14 17l2.2-.8z" /></svg> break;
    case "chev-r":    <svg @attributes="@P"><path d="m9 6 6 6-6 6" /></svg> break;
    case "chev-d":    <svg @attributes="@P"><path d="m6 9 6 6 6-6" /></svg> break;
    case "chev-l":    <svg @attributes="@P"><path d="m15 6-6 6 6 6" /></svg> break;
    case "undo":      <svg @attributes="@P"><path d="M9 14 4 9l5-5" /><path d="M4 9h11a5 5 0 0 1 0 10h-4" /></svg> break;
    case "pencil":    <svg @attributes="@P"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg> break;
    case "trash":     <svg @attributes="@P"><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M19 6 18 20a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg> break;
    case "refresh":   <svg @attributes="@P"><path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 4v5h-5" /></svg> break;
    case "pause":     <svg @attributes="@P"><rect x="6" y="4" width="4" height="16" /><rect x="14" y="4" width="4" height="16" /></svg> break;
    case "download":  <svg @attributes="@P"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg> break;
    case "upload":    <svg @attributes="@P"><path d="M12 21V9" /><path d="m7 14 5-5 5 5" /><path d="M5 3h14" /></svg> break;
    case "video":     <svg @attributes="@P"><rect x="3" y="6" width="13" height="12" rx="2" /><path d="m22 8-6 4 6 4z" /></svg> break;
    case "image":     <svg @attributes="@P"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg> break;
    case "file":      <svg @attributes="@P"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><path d="M14 3v6h6" /></svg> break;
    case "link":      <svg @attributes="@P"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg> break;
    case "external":  <svg @attributes="@P"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" /></svg> break;
    case "filter":    <svg @attributes="@P"><path d="M3 5h18l-7 9v6l-4-2v-4z" /></svg> break;
    case "sparkle":   <svg @attributes="@P"><path d="M12 3v6m0 6v6m9-9h-6m-6 0H3" /><path d="m18 6-3 3M6 18l3-3m9 3-3-3M6 6l3 3" /></svg> break;
    @* TV with three signal arcs in the corner — universal "cast" glyph. *@
    case "cast":      <svg @attributes="@P"><path d="M2 17a3 3 0 0 1 3 3" /><path d="M2 13a7 7 0 0 1 7 7" /><path d="M2 9a11 11 0 0 1 11 11" /><path d="M2 5h17a2 2 0 0 1 2 2v9" /></svg> break;
    @* Eye open = unwatched. Stroked outline + iris circle. *@
    case "eye":       <svg @attributes="@P"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg> break;
    @* Eye closed/off = watched. Diagonal slash through an open eye. *@
    case "eye-off":   <svg @attributes="@P"><path d="m3 3 18 18" /><path d="M10.6 10.6a3 3 0 0 0 4.2 4.2" /><path d="M9.4 5.2a10.4 10.4 0 0 1 2.6-.2c6.5 0 10 7 10 7a17 17 0 0 1-2.4 3.3" /><path d="M6.1 6.1A17 17 0 0 0 2 12s3.5 7 10 7a10.4 10.4 0 0 0 5-1.3" /></svg> break;
    @* "Expand to fill" — four arrows shooting outwards from corners.
       Used by the player Fill-mode button when it's currently in Fit mode. *@
    case "expand":    <svg @attributes="@P"><path d="M3 9V3h6" /><path d="M21 9V3h-6" /><path d="M3 15v6h6" /><path d="M21 15v6h-6" /></svg> break;
    @* "Compress back" — arrows pointing inwards. Shown when Fill mode is on. *@
    case "compress":  <svg @attributes="@P"><path d="M9 3v6H3" /><path d="M15 3v6h6" /><path d="M9 21v-6H3" /><path d="M15 21v-6h6" /></svg> break;
    @* v4-additions for TopBar / Welcome / ProfilePanel. *@
    case "arrow-r":   <svg @attributes="@P"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg> break;
    case "arrow-l":   <svg @attributes="@P"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg> break;
    case "github":    <svg @attributes="@P"><path d="M9 19c-5 1.5-5-2.5-7-3" /><path d="M15 22v-3.9a3.4 3.4 0 0 0-.9-2.6c3 0 6-2 6-5.5a4 4 0 0 0-1.2-3 4 4 0 0 0-.1-3s-1-.3-3.4 1.3a11 11 0 0 0-6 0C7 3.7 6 4 6 4a4 4 0 0 0-.1 3 4 4 0 0 0-1.2 3c0 3.5 3 5.5 6 5.5a3.4 3.4 0 0 0-.9 2.6V22" /></svg> break;
    case "server":    <svg @attributes="@P"><rect x="3" y="3" width="18" height="7" rx="2" /><rect x="3" y="14" width="18" height="7" rx="2" /><path d="M7 7h.01M7 17h.01" /></svg> break;
    case "user":      <svg @attributes="@P"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg> break;
    case "users":     <svg @attributes="@P"><circle cx="9" cy="8" r="4" /><path d="M3 21a6 6 0 0 1 12 0" /><circle cx="17" cy="6" r="3" /><path d="M21 17a4 4 0 0 0-4-4" /></svg> break;
    case "logout":    <svg @attributes="@P"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /></svg> break;
    case "tv":        <svg @attributes="@P"><rect x="3" y="5" width="18" height="13" rx="2" /><path d="m8 22 4-4 4 4" /></svg> break;
    case "globe":     <svg @attributes="@P"><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18" /><path d="M12 3a14 14 0 0 0 0 18" /></svg> break;
    case "shield":    <svg @attributes="@P"><path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z" /></svg> break;
    case "key":       <svg @attributes="@P"><circle cx="7.5" cy="15.5" r="3.5" /><path d="m10 13 11-11" /><path d="m17 6 3 3" /><path d="m14 9 3 3" /></svg> break;
    @* QR code — three position markers + a few inner modules. Drawn so it
       still reads at the tiny 14px size used by the Login → "Scan QR" link. *@
    case "qr-code":   <svg @attributes="@P"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><path d="M14 14h3v3" /><path d="M21 14v3" /><path d="M14 21h3" /><path d="M17 17v4" /><path d="M21 21h-2" /></svg> break;
    case "audio":     <svg @attributes="@P"><path d="M4 9v6" /><path d="M8 5v14" /><path d="M12 8v8" /><path d="M16 4v16" /><path d="M20 7v10" /></svg> break;
    case "lock":      <svg @attributes="@P"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg> break;
    case "bookmark":  <svg @attributes="@P"><path d="M19 21 12 16 5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg> break;
    case "calendar":  <svg @attributes="@P"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5" /><path d="M3 9.5h18" /><path d="M8 2.5v4" /><path d="M16 2.5v4" /></svg> break;
    default:          <span class="design-icon-missing" title="Unknown icon: @Name">?</span> break;
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int    Size { get; set; } = 16;
    [Parameter] public double Stroke { get; set; } = 1.6;
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Extra { get; set; }

    private Dictionary<string, object> P
    {
        get
        {
            var d = new Dictionary<string, object>
            {
                ["xmlns"]            = "http://www.w3.org/2000/svg",
                ["width"]            = Size,
                ["height"]           = Size,
                ["viewBox"]          = "0 0 24 24",
                ["fill"]             = "none",
                ["stroke"]           = "currentColor",
                ["stroke-width"]     = Stroke,
                ["stroke-linecap"]   = "round",
                ["stroke-linejoin"]  = "round",
            };
            if (Extra is not null) foreach (var kv in Extra) d[kv.Key] = kv.Value;
            return d;
        }
    }
}
