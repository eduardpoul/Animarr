@*
    Discovery — v5 multi-server "find your library" screen. Three UI states:

      • Scanning            (8s auto-timeout)
      • Found N servers     (list of cards → click → Switch + go to /login)
      • No servers / Manual (URL field + Add → probe → register)

    mDNS broadcast is server-side (Animarr.Web publishes _animarr._tcp.local
    via MdnsPublisherService). Discovery on the CLIENT depends on platform:

      • WASM in a browser:  no LAN socket access. We skip the scan UI and
                            land directly on the manual-add form.
      • MAUI Hybrid:        best-effort scan via window.animarrMdnsScan() if
                            the host exposes it; otherwise manual only.

    Either way the manual add path is always available so the user can paste
    an IP or Tailscale magic-DNS hostname when broadcast can't reach them.

    Layout: AuthLayout (no TopBar, no sidebar). Matches Login / Welcome
    aesthetic — backdrop + film grain + centered card.
*@

@page "/discovery"
@layout AuthLayout
@implements IDisposable
@inject NavigationManager Nav
@inject ServerRegistryState ServerReg
@inject UserContextState UserCtx
@inject IJSRuntime JS

<PageTitle>Animarr — Find your library</PageTitle>

<div class="d-discovery">
    <button type="button" class="d-discovery__back tv-focus" @onclick="@(() => Nav.NavigateTo("/welcome"))">
        <DIcon Name="arrow-l" Size="13" /> BACK
    </button>

    <div class="d-discovery__card" role="dialog" aria-label="Find your library">
        <header class="d-discovery__brand">
            <BrandMark Size="38" ExtraClass="d-discovery__brand-mark" />
            <div>
                <div class="d-discovery__brand-name">Animarr</div>
                <div class="d-discovery__brand-sub">Find your library</div>
            </div>
        </header>

        @if (_state == State.Scanning)
        {
            <div class="d-discovery__scanning">
                <Spinner Size="sm" />
                <span class="d-discovery__scanning-label">
                    Looking for Animarr servers on your network<span class="d-discovery__dots">@_dots</span>
                </span>
            </div>
            <div class="d-discovery__scan-hint">SCANNING · @_elapsedSec s</div>
        }
        else if (_state == State.Found)
        {
            <div class="d-discovery__found-label">@_found.Count server@(_found.Count == 1 ? "" : "s") found · pick one to sign in</div>
            <div class="d-discovery__server-list">
                @foreach (var s in _found)
                {
                    var server = s;
                    <button type="button" class="d-discovery__server tv-focus"
                            @onclick="@(() => OnPickServer(server))">
                        <span class="d-discovery__server-ic">
                            <DIcon Name="server" Size="16" />
                        </span>
                        <span class="d-discovery__server-body">
                            <span class="d-discovery__server-name">@server.Name</span>
                            <span class="d-discovery__server-meta">
                                <span class="d-discovery__server-dot"></span>
                                @server.BaseUrl · @server.TitleCount title@(server.TitleCount == 1 ? "" : "s") · v@(server.Version)
                            </span>
                        </span>
                        <span class="d-discovery__server-right">connect</span>
                    </button>
                }
            </div>
            <div class="d-discovery__actions">
                <Btn Variant="ghost" Size="md" OnClick="OpenManualAdd">
                    <DIcon Name="plus" Size="13" /> Add manually
                </Btn>
                <Btn Variant="ghost" Size="md" OnClick="Rescan">
                    <DIcon Name="refresh" Size="13" /> Rescan
                </Btn>
            </div>
        }
        else if (_state == State.Empty)
        {
            <div class="d-discovery__empty-ic">
                <DIcon Name="globe" Size="22" />
            </div>
            <div class="d-discovery__empty-title">No servers found</div>
            <p class="d-discovery__empty-body">
                Make sure your Animarr server is running on the same network. You
                can also enter the URL manually if you know it (IP, hostname, or
                Tailscale magic DNS).
            </p>
            <div class="d-discovery__actions d-discovery__actions--centered">
                <Btn Variant="primary" Size="md" OnClick="OpenManualAdd">
                    <DIcon Name="plus" Size="13" /> Add manually
                </Btn>
                @if (_canScan)
                {
                    <Btn Variant="ghost" Size="md" OnClick="Rescan">
                        <DIcon Name="refresh" Size="13" /> Scan again
                    </Btn>
                }
            </div>
            <a href="https://github.com/eduardpoul/Animarr/issues" target="_blank" rel="noopener" class="d-discovery__gh" aria-label="Animarr issues on GitHub">
                github · issues
            </a>
        }

        @if (_manualOpen)
        {
            <div class="d-discovery__manual">
                <div class="d-discovery__manual-label">Server URL</div>
                <input type="text"
                       class="d-discovery__manual-input"
                       placeholder="http://192.168.1.50:8080 or https://animarr.tailnet.ts.net"
                       value="@_manualUrl"
                       @oninput="@((ChangeEventArgs e) => _manualUrl = e.Value?.ToString() ?? "")"
                       @onkeypress="OnManualKeyPress" />
                @if (!string.IsNullOrEmpty(_manualError))
                {
                    <div class="d-discovery__manual-error">@_manualError</div>
                }
                <div class="d-discovery__manual-row">
                    <Btn Variant="primary" Size="md" Loading="@_manualProbing"
                         OnClick="OnManualProbe"
                         Disabled="@(string.IsNullOrWhiteSpace(_manualUrl))">
                        <DIcon Name="link" Size="13" /> Probe & add
                    </Btn>
                    <Btn Variant="flat" Size="md" OnClick="@(() => _manualOpen = false)">
                        Cancel
                    </Btn>
                </div>
            </div>
        }
    </div>

    <footer class="d-discovery__footer">
        <a href="https://github.com/eduardpoul/Animarr" target="_blank" rel="noopener" class="d-discovery__footer-link tv-focus" aria-label="Animarr on GitHub">
            github
        </a>
    </footer>
</div>

@code {
    private enum State { Scanning, Found, Empty }
    // Start in Scanning so the very first frame after navigation shows the
    // searching UI instead of a "No servers found" flash. OnAfterRenderAsync
    // either confirms (StartScanAsync) or flips to Found / Empty once it has
    // an honest answer.
    private State _state = State.Scanning;

    private List<RegisteredServerDto> _found = new();
    private int _elapsedSec;
    private string _dots = "";
    private System.Threading.Timer? _scanTimer;
    private CancellationTokenSource? _scanCts;
    /// <summary>True if this host can attempt an mDNS-style scan via JS. Pure
    /// WASM in a browser is false (no socket access); MAUI Hybrid is true
    /// when window.animarrMdnsScan is defined.</summary>
    private bool _canScan;

    private bool _manualOpen;
    private string _manualUrl = "";
    private string _manualError = "";
    private bool _manualProbing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await ServerReg.LoadAsync();

        // If the user is already signed into a server and the registry has
        // entries, skip Discovery entirely — they've been here before.
        if (UserCtx.Loaded && UserCtx.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        // Probe path is available outside the pure-WASM browser context.
        // OperatingSystem.IsBrowser() is true ONLY in the Blazor WASM runtime
        // — false in MAUI, server-side rendering, desktop hosts, etc. We used
        // to do a JS typeof check here, but on Android that first eval() can
        // fail with a transient JSInterop error (DotNet bootstrap race after
        // a hard reload), leaving _canScan=false → Discovery skipped the
        // scan entirely → "No servers found" with no NSD lookup ever fired.
        _canScan = !OperatingSystem.IsBrowser();

        // If the registry already holds servers, render them as "Found" and
        // skip the empty-state animation entirely.
        if (ServerReg.Count > 0)
        {
            _found = ServerReg.Servers.OrderByDescending(s => s.LastSeenUtc).ToList();
            _state = State.Found;
            StateHasChanged();
            // Still kick off a background scan to surface NEW servers, but
            // don't block the UI on it.
            if (_canScan) _ = StartScanAsync();
            return;
        }

        // First-run path. Show the Scanning UI WHILE the mDNS browse
        // actually runs — the previous "show Empty immediately" was a
        // jarring flash of "No servers found" before the search had even
        // started, then it flipped to Scanning, then back to Empty when
        // the timeout fired. Awaiting the scan keeps the user on a single
        // honest state until results (or no-results) are real.
        //
        // When mDNS isn't available (pure WASM browser) jump straight to
        // Empty with the manual form open — there's nothing to wait on.
        if (_canScan)
        {
            await StartScanAsync();
            // StartScanAsync sets _state to Found if anything turned up.
            // If it returned with Empty + no manual still open, surface
            // the manual input alongside the empty state so the user
            // doesn't have to hunt for the "Add manually" button.
            if (_state == State.Empty) _manualOpen = true;
            StateHasChanged();
        }
        else
        {
            _state = State.Empty;
            _manualOpen = true;
            StateHasChanged();
        }
    }

    /// <summary>True for origins that can't be a real Animarr server — the
    /// MAUI BlazorWebView virtual host, or about: pages. Stops us probing
    /// `https://0.0.0.0/api/server/info` on mobile and eating ~2s on the
    /// inevitable connect failure.</summary>
    private static bool IsPlaceholderOrigin(string origin)
    {
        if (origin.StartsWith("https://0.0.0.0", StringComparison.OrdinalIgnoreCase) ||
            origin.StartsWith("http://0.0.0.0",  StringComparison.OrdinalIgnoreCase)) return true;
        if (origin.StartsWith("about:",          StringComparison.OrdinalIgnoreCase)) return true;
        if (origin.StartsWith("file:",           StringComparison.OrdinalIgnoreCase)) return true;
        // Common MAUI WebView origin patterns across platforms (Android uses
        // 0.0.0.0; Windows uses an arbitrary id host under app://).
        if (origin.StartsWith("app://",          StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task StartScanAsync()
    {
        _scanCts?.Cancel();
        _scanCts = new CancellationTokenSource();
        var ct = _scanCts.Token;

        _state = State.Scanning;
        _elapsedSec = 0;
        _dots = "";
        _found.Clear();
        StateHasChanged();

        // Animate the elapsed counter + dot loader every 250ms so the user
        // sees the scan is actively doing something.
        _scanTimer?.Dispose();
        _scanTimer = new System.Threading.Timer(_ =>
        {
            if (ct.IsCancellationRequested) return;
            _elapsedSec++;
            _dots = (_elapsedSec % 4) switch { 0 => "", 1 => ".", 2 => "..", _ => "..." };
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        // Race mDNS + TCP subnet probe in parallel. mDNS is faster when the
        // network allows multicast across the wired/wireless boundary; subnet
        // probe is the reliable fallback that just enumerates hosts on the
        // local /24 and asks each for /api/server/info. Whichever returns
        // results first wins — no point making the user wait 8s for mDNS
        // before kicking off the probe that finds the server in 3s anyway.
        try
        {
            var mdnsTask = JS.InvokeAsync<JsServer[]?>("animarrMdnsScan").AsTask();

            // Only available under MAUI — pure WASM doesn't ship the bridge.
            // Skip the typeof check to save a JS round-trip; an undefined
            // method just throws, which we swallow alongside the cancellation
            // path below.
            var probeTask = TryStartSubnetProbeAsync(ct);

            var overallTimeout = Task.Delay(TimeSpan.FromSeconds(15), ct);

            // Drain whichever path finishes first (and isn't empty). Subnet
            // probe always returns something when the server is reachable, so
            // mDNS is allowed to lose the race.
            while (_found.Count == 0)
            {
                var winner = await Task.WhenAny(mdnsTask, probeTask, overallTimeout);
                if (winner == overallTimeout) break;

                JsServer[]? hits = null;
                try
                {
                    if (winner == mdnsTask)        hits = await mdnsTask;
                    else if (winner == probeTask)  hits = await probeTask;
                }
                catch { /* one path failed — keep waiting on the other */ }

                if (hits is { Length: > 0 })
                {
                    var resolved = await Task.WhenAll(hits.Select(h => RegisterOrSurfaceAsync(h, ct)));
                    foreach (var r in resolved)
                        if (r is not null && _found.All(f => f.ServerId != r.ServerId))
                            _found.Add(r);
                    if (_found.Count > 0) break;
                }

                // Both tasks completed empty → bail.
                if (mdnsTask.IsCompleted && probeTask.IsCompleted) break;
            }
        }
        catch (OperationCanceledException) { /* user navigated away */ }
        catch { /* JS hook errored — fall through to empty */ }

        _scanTimer?.Dispose();
        _scanTimer = null;

        // Also surface any pre-existing registry entries — re-finding the
        // same server twice is fine, the dedupe on ServerId handles it.
        foreach (var s in ServerReg.Servers)
            if (_found.All(f => f.ServerId != s.ServerId))
                _found.Add(s);

        _state = _found.Count > 0 ? State.Found : State.Empty;
        if (_state == State.Empty) _manualOpen = true;
        StateHasChanged();
    }

    /// <summary>Turn a JsServer (raw scan hit) into a RegisteredServerDto and
    /// add it to the registry. Two paths:
    ///
    ///   • Hit already carries ServerId — trust the scanner (mDNS resolved
    ///     the SRV/TXT records, subnet probe parsed /api/server/info). Build
    ///     a registry entry directly. Skips the HTTP re-probe that was
    ///     silently failing on Android MAUI for hosts the platform-level
    ///     daemon could still reach.
    ///   • No ServerId — fall back to <see cref="ServerRegistryState.AddServerAsync"/>
    ///     which probes /api/server/info itself. This is the pure-WASM
    ///     manual-add path.</summary>
    private async Task<RegisteredServerDto?> RegisterOrSurfaceAsync(JsServer hit, CancellationToken ct)
    {
        if (!string.IsNullOrWhiteSpace(hit.ServerId))
        {
            var entry = new RegisteredServerDto(
                ServerId:    hit.ServerId,
                Name:        string.IsNullOrWhiteSpace(hit.Name) ? "Animarr" : hit.Name,
                BaseUrl:     hit.BaseUrl,
                LastSeenUtc: DateTime.UtcNow,
                Version:     hit.Version,
                TitleCount:  null);
            await ServerReg.UpsertAsync(entry, ct);
            return entry;
        }
        return await ServerReg.AddServerAsync(hit.BaseUrl, ct);
    }

    /// <summary>Wrapper around <c>window.animarrSubnetScan</c> that returns
    /// empty instead of throwing when the bridge isn't registered (pure WASM
    /// in a browser). Lets the race loop in <c>StartScanAsync</c> Task.WhenAny
    /// against the mDNS task without a separate typeof probe.</summary>
    private async Task<JsServer[]?> TryStartSubnetProbeAsync(CancellationToken ct)
    {
        try
        {
            return await JS.InvokeAsync<JsServer[]?>("animarrSubnetScan").AsTask().WaitAsync(ct);
        }
        catch
        {
            // Bridge missing or threw — return empty so the race loop ignores
            // this path. mDNS still has a chance to deliver.
            return Array.Empty<JsServer>();
        }
    }

    private Task Rescan() => StartScanAsync();

    private void OpenManualAdd()
    {
        _manualOpen = true;
        _manualError = "";
        StateHasChanged();
    }

    private async Task OnManualProbe()
    {
        _manualError = "";
        var url = _manualUrl.Trim();
        if (string.IsNullOrEmpty(url))
        {
            _manualError = "Enter a URL.";
            return;
        }
        // Default to http:// when the user types a bare host. They can paste a
        // full URL with scheme if they want HTTPS.
        if (!url.Contains("://", StringComparison.Ordinal))
            url = "http://" + url;

        _manualProbing = true;
        StateHasChanged();
        try
        {
            var entry = await ServerReg.AddServerAsync(url);
            if (entry is null)
            {
                _manualError = "Couldn't reach an Animarr server at that URL.";
                return;
            }
            _manualUrl  = "";
            _manualOpen = false;
            _found = ServerReg.Servers.OrderByDescending(s => s.LastSeenUtc).ToList();
            _state = State.Found;
        }
        catch (Exception ex)
        {
            _manualError = $"Probe failed: {ex.Message}";
        }
        finally
        {
            _manualProbing = false;
            StateHasChanged();
        }
    }

    private async Task OnManualKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_manualProbing) await OnManualProbe();
    }

    private async Task OnPickServer(RegisteredServerDto server)
    {
        // SetCurrentAsync now also swaps HttpClient.BaseAddress to the chosen
        // server, so all subsequent /api/* calls land on the right origin.
        await ServerReg.SetCurrentAsync(server.ServerId);

        // Routing strategy differs by host:
        //
        //   • MAUI Hybrid (BlazorWebView): the WebView never reloads — it owns
        //     a single in-memory Blazor app for the process lifetime. Using
        //     `forceLoad: true` against an external origin triggers the native
        //     shell's URL-loading handler, which kicks the URL out to the
        //     system browser (Edge/Chrome). That's exactly the bug we just
        //     hit: clicking a discovered server opened http://192.168.x:8080
        //     in Edge instead of staying inside Animarr. Internal navigation
        //     to "/login" is correct here; HttpClient is already pointed at
        //     the new origin.
        //
        //   • WASM in a browser: each Animarr server origin serves its own
        //     bundle and cookies are domain-scoped, so switching servers
        //     means we genuinely want a hard page load on the new origin.
        //     Same-origin case stays a soft route to /login.
        //
        // Detection: OperatingSystem.IsBrowser() is true *only* in the WASM
        // runtime — false in MAUI, server-side rendering, console hosts, etc.
        if (OperatingSystem.IsBrowser())
        {
            var sameOrigin = string.Equals(
                new Uri(server.BaseUrl).GetLeftPart(UriPartial.Authority),
                new Uri(Nav.Uri).GetLeftPart(UriPartial.Authority),
                StringComparison.OrdinalIgnoreCase);

            if (sameOrigin)
                Nav.NavigateTo("/login", replace: true);
            else
                Nav.NavigateTo(server.BaseUrl.TrimEnd('/') + "/login", forceLoad: true);
        }
        else
        {
            // MAUI / native shell — stay inside the WebView. HttpClient
            // BaseAddress was already swapped by SetCurrentAsync.
            Nav.NavigateTo("/login", replace: true);
        }
    }

    public void Dispose()
    {
        _scanCts?.Cancel();
        _scanCts?.Dispose();
        _scanTimer?.Dispose();
    }

    /// <summary>Shape returned by window.animarrMdnsScan() / animarrSubnetScan.
    /// Carries everything the registry card needs — ServerId + Version come
    /// directly from the mDNS TXT record (or the subnet probe's GET response)
    /// so we don't have to re-do the HTTP probe to surface a card. The probe
    /// route used to re-fetch /api/server/info before adding to the registry,
    /// but Android MAUI's HttpClient sometimes can't reach the same host the
    /// platform-level mDNS daemon just resolved (cleartext policy, IPv6
    /// preference, etc.), so we'd silently drop a perfectly good server.</summary>
    private sealed record JsServer(string Name, string BaseUrl, string? ServerId = null, string? Version = null);
}
