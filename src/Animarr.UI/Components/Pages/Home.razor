@page "/"
@implements IDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject CategoryNavService CategoryNav
@inject FolderJumpService FolderJump
@inject Animarr.UI.Services.ServerRegistryState ServerReg

<PageTitle>Animarr — @L["catalog.title"]</PageTitle>

<div class="catalog-page">

    @* ── Hero — Continue Watching takes priority over Featured. v5
       design board ships this as the default top-of-page experience; if
       the user has nothing in progress, the older Featured-by-rating
       carousel takes over so the slot doesn't go blank.
       Both bind to the section-filtered slice (_filteredContinue /
       _filteredFeatured) so a TopBar folder pill narrows the hero to
       that folder's items, not the global library. *@
    @if (_filteredContinue.Length > 0)
    {
        <CatalogContinueHero Items="@_filteredContinue" IntervalSec="@_heroInterval" />
    }
    else if (_filteredFeatured.Count > 0)
    {
        <CatalogHero Items="@_filteredFeatured" IntervalSec="@_heroInterval" />
    }

    @* NeedsReview pulse-chip — surfaces when titles are below confidence.
       Free-text search now lives on /search (magnifier in TopBar); the bulky
       Filter-by-title input + N/M counter that used to sit here are gone. *@
    <NeedsReviewChip />

    @* ── Category chip strip (replaces v3 type tabs + folder chips) ────── *@
    @* Categories come from /api/categories (admin manages them in
       Server Settings → Categories). Items are auto-classified by the LLM
       at identification time. Hide chips that have zero matching items
       so the strip doesn't accumulate empty filters as the library
       evolves. *@
    @if (_categories.Count > 0)
    {
        <div class="catalog-folders">
            <button type="button"
                    class="@($"catalog-chip {(_activeCategory is null ? "catalog-chip--active" : "")}")"
                    @onclick="@(() => SetActiveCategory(null))">All</button>
            @foreach (var cat in _categories.Where(c => c.Enabled && c.ItemCount > 0).OrderBy(c => c.SortOrder))
            {
                var name = cat.Name;
                <button type="button"
                        class="@($"catalog-chip {(_activeCategory == name ? "catalog-chip--active" : "")}")"
                        @onclick="@(() => SetActiveCategory(name))">
                    @name
                    <span class="catalog-chip__count">@cat.ItemCount</span>
                </button>
            }
        </div>
    }
    else if (_sections.Count > 0)
    {
        @* Fallback: until categories exist (fresh install before the
           first identification batch lands), keep the v3 folder strip so
           the catalog isn't a flat list. *@
        <div class="catalog-folders">
            <button type="button"
                    class="@($"catalog-chip {(_activeSection is null ? "catalog-chip--active" : "")}")"
                    @onclick="@(() => SetActiveSection(null))">@L["catalog.tab_all"]</button>
            @foreach (var sec in _sections)
            {
                var id = sec.Id;
                <button type="button"
                        class="@($"catalog-chip {(_activeSection == id ? "catalog-chip--active" : "")}")"
                        @onclick="@(() => SetActiveSection(id))">@sec.Label</button>
            }
        </div>
    }

    @* ── Grid ─────────────────────────────────────────────────────────── *@
    @if (_loading)
    {
        @* Centered loading screen with branded ring spinner — the previous
           thin indeterminate bar at the top of the catalog let the page
           look like "empty library" while the data was still in flight
           (user reported this as "после деплоя всегда каталог пустой
           пишет"). A foreground spinner is unmistakably a transient state. *@
        <div class="catalog-loading">
            <div class="catalog-loading__ring"></div>
            <div class="catalog-loading__label">@L["catalog.loading"]</div>
        </div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="catalog-empty">
            <DIcon Name="video" Size="48" />
            <div class="catalog-empty__text">@L["catalog.empty"]</div>
        </div>
    }
    else
    {
        <div class="catalog-grid">
            @* H-7: cap rendered items to 240 so the catalog stays snappy at 1000+ entries. *@
            @foreach (var item in _filtered.Take(240))
            {
                <Poster Item="@item" />
            }
        </div>
        @if (_filtered.Count > 240)
        {
            <div class="catalog-more">
                @L.Get("catalog.shown_of_total", 240, _filtered.Count)
            </div>
        }
    }
</div>

@code {
    private List<MediaItemDto>      _allItems   = new();
    private List<MediaItemDto>      _filtered   = new();
    private List<MediaItemDto>      _featured   = new();
    private List<FolderWatcherDto>  _sections   = new();
    private List<CategoryDto>       _categories = new();
    private ContinueWatchItemDto[]  _continueItems = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Continue-watching slice after section + category filters.
    /// Hero binds to this so a TopBar folder pill narrows the hero alongside
    /// the grid below. Falls back to the full list when no filter is set.</summary>
    private ContinueWatchItemDto[]  _filteredContinue = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Featured-by-rating slice after section + category filters.
    /// Same rationale as <see cref="_filteredContinue"/>.</summary>
    private List<MediaItemDto>      _filteredFeatured = new();
    private bool   _loading = true;
    private Guid?  _activeSection;     // legacy v3 folder filter (fallback)
    // v5: source of truth for catalog filter is CategoryNavService.ActiveCategoryName
    // (TopBar tabs write to it; Home reads it via the property below). Computed
    // straight off the shared service so a TopBar click → ApplyFilter loop sees
    // the freshly-set value without an intermediate local field.
    private string? _activeCategory => CategoryNav.ActiveCategoryName;
    private int    _heroInterval = 30;

    protected override async Task OnInitializedAsync()
    {
        // Re-render whenever TopBar (or anyone) changes the active category.
        CategoryNav.OnChange += OnCategoryChanged;
        // TopBar folder pills write to FolderJump. Resolve name → section Id
        // via _sections lookup and reapply the same chip-style filter the
        // legacy v3 strip uses, so hero + grid both narrow to that folder.
        FolderJump.OnChange  += OnFolderJumpChanged;

        // Hydrate the server registry FIRST. Without this, a cold-start
        // that lands on /home directly (cookie-restored boot bypasses
        // Welcome + Discovery) leaves ServerAddressProvider pointed at the
        // compile-time placeholder URL — every Api.* call below fires
        // against tower.one and times out. ServerReg.LoadAsync is
        // idempotent (early-returns when already loaded) so this is safe
        // to call from any page that fetches at boot, and it sequences
        // BEFORE MainLayout.OnAfterRender because OnInitializedAsync runs
        // on the child render pass.
        try { await ServerReg.LoadAsync(); } catch { /* localStorage hiccup — fall through */ }

        try
        {
            // Categories — drive the chip strip. Admin manages them in
            // Server Settings → Categories; the LLM classifier auto-tags
            // items on identification.
            try
            {
                var cats = await Api.GetCategoriesAsync();
                _categories = cats.ToList();
            }
            catch { _categories.Clear(); }

            // Continue Watching — v5 hero source of truth. Returns at most 5
            // in-progress titles for the current user; empty array if the
            // user hasn't started anything (Home falls back to Featured).
            try { _continueItems = await Api.GetContinueWatchingAsync(take: 5); }
            catch { _continueItems = Array.Empty<ContinueWatchItemDto>(); }

            // One wide fetch — server query is a single SELECT with eager
            // Tags include; client-side filtering is cheap on the resulting
            // DTOs since they're already projections.
            var sections = await Api.GetSectionFoldersAsync();
            _sections = sections.OrderBy(f => f.Label).ToList();

            // Build the section → child-folder-id map HERE, right after _sections
            // loads — NOT in OnAfterRenderAsync. OnAfterRenderAsync(firstRender)
            // fires after the FIRST (loading-state) render, which happens at the
            // first await in this method — long before _sections is populated. So
            // the old code looped an empty _sections and left the map empty
            // forever, which made every TopBar folder pill filter the grid down
            // to ZERO items (the lookup fell back to an empty set). Populating it
            // inline removes that lifecycle race. Defensive: include the section's
            // own Id too, so an item filed directly under the section root (not a
            // child folder) still matches.
            try
            {
                var allFolders = await Api.GetFoldersAsync();
                foreach (var sec in _sections)
                {
                    var ids = allFolders
                        .Where(f => f.ParentSectionId == sec.Id)
                        .Select(f => f.Id)
                        .ToHashSet();
                    ids.Add(sec.Id);
                    _childFolderIdsBySection[sec.Id] = ids;
                }
            }
            catch { /* section filter degrades to no-op */ }

            var items = await Api.GetMediaItemsAsync(new MediaListQuery { Take = 10000, Sort = "title" });
            // Hide rows whose Folder is itself a section (those are containers,
            // not catalog entries). The /api/media endpoint already filters out
            // section-roots; this is belt-and-braces.
            //
            // De-duplication: two MediaItems can legitimately share the same
            // Title/Year if the same movie lives in two folders (e.g. user
            // moved a file but the old folder still has it). For visual
            // catalog purposes that's a duplicate — collapse by Id first
            // (defensive), then by (lowercased trimmed Title, Year) so the
            // grid never shows the same logical title twice.
            _allItems = items
                .GroupBy(m => m.Id)
                .Select(g => g.First())
                .GroupBy(m => (m.Title?.Trim().ToLowerInvariant() ?? "", m.Year))
                .Select(g => g.First())
                .ToList();

            // Featured hero: top 5 rated ≥ 8.0 with a fanart path.
            _featured = _allItems
                .Where(m => (m.Rating ?? 0) >= 8.0 && !string.IsNullOrEmpty(m.FanartPath))
                .OrderByDescending(m => m.Rating ?? 0)
                .ThenByDescending(m => m.RatingCount ?? 0)
                .Take(5)
                .ToList();

            // Carousel cadence from server config.
            var intStr = await Api.GetAppConfigValueAsync(AppConfigKeys.BackdropIntervalSec);
            if (int.TryParse(intStr?.Value, out var iv)) _heroInterval = iv;
        }
        catch { /* offline — empty grid */ }

        _loading = false;
        ApplyFilter();
    }

    private void SetActiveCategory(string? name)
    {
        // Delegates to the shared service so TopBar and the page chip strip
        // stay in lockstep — clicking either updates both displays.
        CategoryNav.SetActiveCategory(name);
        // No explicit ApplyFilter() here: OnCategoryChanged handles it.
    }

    private void OnCategoryChanged()
    {
        ApplyFilter();
        StateHasChanged();
    }

    private void SetActiveSection(Guid? sectionId)
    {
        _activeSection = sectionId;
        ApplyFilter();
    }

    /// <summary>Reconcile <see cref="_activeSection"/> with the new value of
    /// <see cref="FolderJumpService.ActiveFolderName"/>. TopBar writes a label
    /// (the section's display name), not a GUID, so we resolve through the
    /// <see cref="_sections"/> list we already loaded. Unknown / empty names
    /// clear the filter back to "all sections".</summary>
    private void OnFolderJumpChanged()
    {
        var name = FolderJump.ActiveFolderName;
        Guid? newSection = null;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var match = _sections.FirstOrDefault(s =>
                string.Equals(s.Label, name, StringComparison.OrdinalIgnoreCase));
            if (match is not null) newSection = match.Id;
        }
        if (newSection == _activeSection) return;
        _activeSection = newSection;
        ApplyFilter();
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        IEnumerable<MediaItemDto> src = _allItems;

        // Category chip — match by CategoryNames on the DTO (server-projected
        // from MediaItemCategory join). Read straight from the shared
        // CategoryNavService so a TopBar click is reflected here without
        // depending on Blazor re-rendering Home first. Case-insensitive so
        // chip clicks match category names regardless of capitalisation.
        var activeCat = CategoryNav.ActiveCategoryName;
        if (!string.IsNullOrWhiteSpace(activeCat))
        {
            src = src.Where(m => m.CategoryNames is { Length: > 0 }
                              && m.CategoryNames.Any(n => string.Equals(n, activeCat, StringComparison.OrdinalIgnoreCase)));
        }

        // Section filter — items whose Folder is under the chosen section.
        // The lookup set is precomputed by OnAfterRenderAsync's /api/folders
        // walk into _childFolderIdsBySection. Was a stray `var childIds = ...`
        // declaration above that shadowed the later `out var childIds` in
        // the hero-slice branch — both useless here because the actual
        // membership test reads from _childFolderIdsBySection directly.
        if (_activeSection.HasValue)
        {
            src = src.Where(m => _childFolderIdsBySection
                .GetValueOrDefault(_activeSection.Value, new HashSet<Guid>())
                .Contains(m.FolderId));
        }

        // Free-text search moved to /search — Home only filters by category +
        // section now. Hide hero items unless one of those filters is active.
        var hasActiveFilter = !string.IsNullOrWhiteSpace(activeCat)
                          || _activeSection.HasValue;
        if (!hasActiveFilter && _featured.Count > 0)
        {
            var featuredIds = _featured.Select(f => f.Id).ToHashSet();
            src = src.Where(m => !featuredIds.Contains(m.Id));
        }

        // Belt-and-braces dedup: if the API ever returns the same MediaItem
        // twice (rare, but folder rescans during the request can race), keep
        // the first occurrence so the grid doesn't show visible duplicates.
        _filtered = src
            .GroupBy(m => m.Id)
            .Select(g => g.First())
            .ToList();

        // ── Hero slices follow the same section filter ────────────────────
        // Featured is a MediaItemDto[] subset of _allItems — apply the same
        // section-membership predicate so the rotating fanart matches the
        // chosen folder. Category filter would also narrow this; for now
        // we keep featured drawn from the cross-category top-rated pool, only
        // intersected with the folder filter (matches user expectation that
        // "this folder's best titles" still rotate when filtering by folder).
        if (_activeSection.HasValue && _childFolderIdsBySection.TryGetValue(_activeSection.Value, out var secChildIds))
        {
            _filteredFeatured = _featured.Where(m => secChildIds.Contains(m.FolderId)).ToList();

            // Continue items don't carry FolderId on the DTO, so resolve via
            // _allItems by mediaId (fast — _allItems is already in memory and
            // dictionary-friendly by Id).
            var folderByMediaId = _allItems.ToDictionary(m => m.Id, m => m.FolderId);
            _filteredContinue = _continueItems
                .Where(c => folderByMediaId.TryGetValue(c.MediaItemId, out var fid) && secChildIds.Contains(fid))
                .ToArray();
        }
        else
        {
            _filteredFeatured = _featured;
            _filteredContinue = _continueItems;
        }
    }

    // Section → set of child FolderWatcher Ids. Built eagerly in
    // OnInitializedAsync (right after _sections loads) — see the note there for
    // why this must NOT live in OnAfterRenderAsync.
    private readonly Dictionary<Guid, HashSet<Guid>> _childFolderIdsBySection = new();

    public void Dispose()
    {
        CategoryNav.OnChange -= OnCategoryChanged;
        FolderJump.OnChange  -= OnFolderJumpChanged;
    }
}
