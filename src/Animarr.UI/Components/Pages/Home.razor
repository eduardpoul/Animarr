@page "/"
@implements IDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject CategoryNavService CategoryNav

<PageTitle>Animarr — @L["catalog.title"]</PageTitle>

<div class="catalog-page">

    @* ── Hero — Continue Watching takes priority over Featured. v5
       design board ships this as the default top-of-page experience; if
       the user has nothing in progress, the older Featured-by-rating
       carousel takes over so the slot doesn't go blank. *@
    @if (_continueItems.Length > 0)
    {
        <CatalogContinueHero Items="@_continueItems" IntervalSec="@_heroInterval" />
    }
    else if (_featured.Count > 0)
    {
        <CatalogHero Items="@_featured" IntervalSec="@_heroInterval" />
    }

    @* ── Filter bar ──────────────────────────────────────────────────────── *@
    <div class="catalog-filter">
        <Input Value="@_searchFilter"
               ValueChanged="@OnSearchChanged"
               Placeholder="@(L["catalog.search_placeholder"])"
               IconBefore="search"
               Clearable="true" />

        <NeedsReviewChip />

        <div class="catalog-count">
            @_filtered.Count<span class="catalog-count__sep">/</span>@_allItems.Count
            <span class="catalog-count__label">TITLES</span>
        </div>
    </div>

    @* ── Category chip strip (replaces v3 type tabs + folder chips) ────── *@
    @* Categories come from /api/categories (admin manages them in
       Server Settings → Categories). Items are auto-classified by the LLM
       at identification time. Hide chips that have zero matching items
       so the strip doesn't accumulate empty filters as the library
       evolves. *@
    @if (_categories.Count > 0)
    {
        <div class="catalog-folders">
            <button type="button"
                    class="@($"catalog-chip {(_activeCategory is null ? "catalog-chip--active" : "")}")"
                    @onclick="@(() => SetActiveCategory(null))">All</button>
            @foreach (var cat in _categories.Where(c => c.Enabled && c.ItemCount > 0).OrderBy(c => c.SortOrder))
            {
                var name = cat.Name;
                <button type="button"
                        class="@($"catalog-chip {(_activeCategory == name ? "catalog-chip--active" : "")}")"
                        @onclick="@(() => SetActiveCategory(name))">
                    @name
                    <span class="catalog-chip__count">@cat.ItemCount</span>
                </button>
            }
        </div>
    }
    else if (_sections.Count > 0)
    {
        @* Fallback: until categories exist (fresh install before the
           first identification batch lands), keep the v3 folder strip so
           the catalog isn't a flat list. *@
        <div class="catalog-folders">
            <button type="button"
                    class="@($"catalog-chip {(_activeSection is null ? "catalog-chip--active" : "")}")"
                    @onclick="@(() => SetActiveSection(null))">@L["catalog.tab_all"]</button>
            @foreach (var sec in _sections)
            {
                var id = sec.Id;
                <button type="button"
                        class="@($"catalog-chip {(_activeSection == id ? "catalog-chip--active" : "")}")"
                        @onclick="@(() => SetActiveSection(id))">@sec.Label</button>
            }
        </div>
    }

    @* ── Grid ─────────────────────────────────────────────────────────── *@
    @if (_loading)
    {
        <div class="catalog-grid">
            @for (int i = 0; i < 12; i++)
            {
                <Skeleton Variant="poster" />
            }
        </div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="catalog-empty">
            <DIcon Name="video" Size="48" />
            <div class="catalog-empty__text">@L["catalog.empty"]</div>
        </div>
    }
    else
    {
        <div class="catalog-grid">
            @* H-7: cap rendered items to 240 so the catalog stays snappy at 1000+ entries. *@
            @foreach (var item in _filtered.Take(240))
            {
                <Poster Item="@item" />
            }
        </div>
        @if (_filtered.Count > 240)
        {
            <div class="catalog-more">
                @L.Get("catalog.shown_of_total", 240, _filtered.Count)
            </div>
        }
    }
</div>

@code {
    private List<MediaItemDto>      _allItems   = new();
    private List<MediaItemDto>      _filtered   = new();
    private List<MediaItemDto>      _featured   = new();
    private List<FolderWatcherDto>  _sections   = new();
    private List<CategoryDto>       _categories = new();
    private ContinueWatchItemDto[]  _continueItems = Array.Empty<ContinueWatchItemDto>();
    private bool   _loading = true;
    private Guid?  _activeSection;     // legacy v3 folder filter (fallback)
    // v5: source of truth for catalog filter is CategoryNavService.ActiveCategoryName
    // (TopBar tabs write to it; Home reads it via the property below). Computed
    // straight off the shared service so a TopBar click → ApplyFilter loop sees
    // the freshly-set value without an intermediate local field.
    private string? _activeCategory => CategoryNav.ActiveCategoryName;
    private string _searchFilter = "";
    private int    _heroInterval = 30;

    protected override async Task OnInitializedAsync()
    {
        // Re-render whenever TopBar (or anyone) changes the active category.
        CategoryNav.OnChange += OnCategoryChanged;
        try
        {
            // Categories — drive the chip strip. Admin manages them in
            // Server Settings → Categories; the LLM classifier auto-tags
            // items on identification.
            try
            {
                var cats = await Api.GetCategoriesAsync();
                _categories = cats.ToList();
            }
            catch { _categories.Clear(); }

            // Continue Watching — v5 hero source of truth. Returns at most 5
            // in-progress titles for the current user; empty array if the
            // user hasn't started anything (Home falls back to Featured).
            try { _continueItems = await Api.GetContinueWatchingAsync(take: 5); }
            catch { _continueItems = Array.Empty<ContinueWatchItemDto>(); }

            // One wide fetch — server query is a single SELECT with eager
            // Tags include; client-side filtering is cheap on the resulting
            // DTOs since they're already projections.
            var sections = await Api.GetSectionFoldersAsync();
            _sections = sections.OrderBy(f => f.Label).ToList();

            var items = await Api.GetMediaItemsAsync(new MediaListQuery { Take = 10000, Sort = "title" });
            // Hide rows whose Folder is itself a section (those are containers,
            // not catalog entries). The /api/media endpoint already filters out
            // section-roots; this is belt-and-braces.
            //
            // De-duplication: two MediaItems can legitimately share the same
            // Title/Year if the same movie lives in two folders (e.g. user
            // moved a file but the old folder still has it). For visual
            // catalog purposes that's a duplicate — collapse by Id first
            // (defensive), then by (lowercased trimmed Title, Year) so the
            // grid never shows the same logical title twice.
            _allItems = items
                .GroupBy(m => m.Id)
                .Select(g => g.First())
                .GroupBy(m => (m.Title?.Trim().ToLowerInvariant() ?? "", m.Year))
                .Select(g => g.First())
                .ToList();

            // Featured hero: top 5 rated ≥ 8.0 with a fanart path.
            _featured = _allItems
                .Where(m => (m.Rating ?? 0) >= 8.0 && !string.IsNullOrEmpty(m.FanartPath))
                .OrderByDescending(m => m.Rating ?? 0)
                .ThenByDescending(m => m.RatingCount ?? 0)
                .Take(5)
                .ToList();

            // Carousel cadence from server config.
            var intStr = await Api.GetAppConfigValueAsync(AppConfigKeys.BackdropIntervalSec);
            if (int.TryParse(intStr?.Value, out var iv)) _heroInterval = iv;
        }
        catch { /* offline — empty grid */ }

        _loading = false;
        ApplyFilter();
    }

    private void OnSearchChanged(string? v)
    {
        _searchFilter = v ?? "";
        ApplyFilter();
    }

    private void SetActiveCategory(string? name)
    {
        // Delegates to the shared service so TopBar and the page chip strip
        // stay in lockstep — clicking either updates both displays.
        CategoryNav.SetActiveCategory(name);
        // No explicit ApplyFilter() here: OnCategoryChanged handles it.
    }

    private void OnCategoryChanged()
    {
        ApplyFilter();
        StateHasChanged();
    }

    private void SetActiveSection(Guid? sectionId)
    {
        _activeSection = sectionId;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<MediaItemDto> src = _allItems;

        // Category chip — match by CategoryNames on the DTO (server-projected
        // from MediaItemCategory join). Read straight from the shared
        // CategoryNavService so a TopBar click is reflected here without
        // depending on Blazor re-rendering Home first. Case-insensitive so
        // chip clicks match category names regardless of capitalisation.
        var activeCat = CategoryNav.ActiveCategoryName;
        if (!string.IsNullOrWhiteSpace(activeCat))
        {
            src = src.Where(m => m.CategoryNames is { Length: > 0 }
                              && m.CategoryNames.Any(n => string.Equals(n, activeCat, StringComparison.OrdinalIgnoreCase)));
        }

        // Section filter — match items whose Folder is under the chosen
        // section. The DTO carries FolderId; we resolve the parent section
        // via the folder list fetched alongside.
        if (_activeSection.HasValue)
        {
            var childIds = _sections
                .Where(s => s.Id == _activeSection.Value)
                .Select(s => s.Id)
                .ToHashSet();
            // Children-of-section are returned as their own folders; we need to
            // include items whose folder's parent matches OR whose folder IS
            // the section (rare for flat sections).
            // For simplicity: match where FolderId is in the set of children
            // of the active section. That set is computed via a separate API
            // call — folded into _allFolders below for one round trip.
            src = src.Where(m => _childFolderIdsBySection
                .GetValueOrDefault(_activeSection.Value, new HashSet<Guid>())
                .Contains(m.FolderId));
        }

        if (!string.IsNullOrWhiteSpace(_searchFilter))
        {
            var q = _searchFilter;
            src = src.Where(m =>
                m.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (m.OriginalTitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.EnglishTitle?.Contains(q, StringComparison.OrdinalIgnoreCase)  ?? false) ||
                (m.CjkTitle?.Contains(q, StringComparison.OrdinalIgnoreCase)      ?? false));
        }

        // Hide items that are currently rotating in the CatalogHero — they're
        // big and visible at the top, no need to duplicate them in the grid
        // below. When the user starts filtering (category / section / search)
        // we SHOW them again because the filter changes the meaning of "featured".
        var hasActiveFilter = !string.IsNullOrWhiteSpace(activeCat)
                          || _activeSection.HasValue
                          || !string.IsNullOrWhiteSpace(_searchFilter);
        if (!hasActiveFilter && _featured.Count > 0)
        {
            var featuredIds = _featured.Select(f => f.Id).ToHashSet();
            src = src.Where(m => !featuredIds.Contains(m.Id));
        }

        // Belt-and-braces dedup: if the API ever returns the same MediaItem
        // twice (rare, but folder rescans during the request can race), keep
        // the first occurrence so the grid doesn't show visible duplicates.
        _filtered = src
            .GroupBy(m => m.Id)
            .Select(g => g.First())
            .ToList();
    }

    // Section → set of child FolderWatcher Ids. Populated lazily when the
    // user clicks a section chip (avoids fetching N folders eagerly).
    private readonly Dictionary<Guid, HashSet<Guid>> _childFolderIdsBySection = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Resolve every section's child folder set so the chip-filter is instant.
        try
        {
            var folders = await Api.GetFoldersAsync();
            foreach (var sec in _sections)
            {
                _childFolderIdsBySection[sec.Id] = folders
                    .Where(f => f.ParentSectionId == sec.Id)
                    .Select(f => f.Id)
                    .ToHashSet();
            }
        }
        catch { /* section filter degrades to no-op */ }
    }

    public void Dispose()
    {
        CategoryNav.OnChange -= OnCategoryChanged;
    }
}
