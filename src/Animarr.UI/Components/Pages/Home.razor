@page "/"
@implements IDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject CategoryNavService CategoryNav
@inject FolderJumpService FolderJump
@inject UserContextState UserCtx
@inject IJSRuntime JS
@inject Animarr.UI.Services.ServerRegistryState ServerReg
@inject Animarr.UI.Services.HomeFeedCache FeedCache

<PageTitle>Animarr</PageTitle>

@if (_loading)
{
    @* First load: the boot screen (index.html), continued — same mark, bar
       and caption in the same spot, so splash → boot → Home reads as one
       screen until the feed lands. A full-screen brand state, not an in-page
       one: a thin bar inside the empty catalog looked like "empty library"
       ("после деплоя всегда каталог пустой пишет"). Outside .catalog-page,
       whose z-index would keep it under the tab bar. Later visits paint from
       HomeFeedCache and skip this. *@
    <div class="catalog-boot" role="status">
        <BrandMark Size="88" AColor="oklch(0.75 0.14 50)" ExtraClass="catalog-boot__mark" />
        <div class="catalog-boot__bar" aria-hidden="true"></div>
        <div class="catalog-boot__label">@L["catalog.loading"]</div>
    </div>
}

<div class="catalog-page">

    @if (!_loading)
    {
        @* ── Section stack ─────────────────────────────────────────────
           Home is a stack of per-user reorderable sections (ProfilePanel →
           Appearance → "Home screen"): order + visibility come from
           UserPreferences.HomeSectionsJson via the shared HomeSections
           schema. Keys the schema knows but the app hasn't shipped yet
           (thisweek / foryou / discover) are skipped silently — they'll
           light up here when those features land.
           Sections that follow the folder filter are keyed by (section,
           folder) so a folder switch re-creates them. The section name keeps
           the keys unique: keyed by the folder alone, the hero and the
           this-week rail were two siblings with the same key, and Blazor threw
           ("more than one sibling … same key") as soon as a folder was picked. *@
        @foreach (var section in _homeSections)
        {
            @switch (section)
            {
                case "continue":
                    @* Hero — Continue Watching takes priority over Featured. If the
                       user has nothing in progress, the Featured-by-rating carousel
                       takes over so the slot doesn't go blank. Both bind to the
                       section-filtered slice so a TopBar folder pill narrows the
                       hero to that folder's items. *@
                    @if (_heroItems.Length > 0)
                    {
                        <CatalogContinueHero @key="(section, _activeSection)" Items="@_heroItems" IntervalSec="@_heroInterval" />
                    }
                    else if (_filteredFeatured.Count > 0)
                    {
                        <CatalogHero @key="(section, _activeSection)" Items="@_filteredFeatured" IntervalSec="@_heroInterval" />
                    }
                    break;

                case "nextup":
                    @if (_filteredNextUp.Length > 0)
                    {
                        <NextUpRail Items="@_filteredNextUp" />
                    }
                    break;

                case "thisweek":
                    @* Follows the folder filter like the hero and the library block. *@
                    <ThisWeekRail @key="(section, _activeSection)" Items="@_filteredThisWeek" />
                    break;

                case "foryou":
                    @* Heuristic recommendations: unwatched library titles scored
                       against the user's watch-time genre profile, TMDB backfill
                       for the free slots (dashed cards with a Want button).
                       Dismiss ✕ persists per user. *@
                    @* Library-wide by nature — only on the unfiltered Home, not
                       inside a folder view. *@
                    @if (_forYou.Length > 0 && !_activeSection.HasValue)
                    {
                        <RecRail Title="@L["home.for_you"]"
                                 Hint="@L["recs.foryou_hint"]"
                                 Items="@_forYou"
                                 Dismissable="true" />
                    }
                    break;

                case "library":
                    @* Compact library block — a poster grid capped to two rows on
                       desktop (four on phones) with a "view all" tile as the last
                       cell. The full chip-filtered catalog lives on /library now;
                       this block still follows the TopBar folder pill filter so
                       the two stay consistent. Row capping is pure CSS: fixed
                       column counts per breakpoint + nth-child hides, so the tile
                       always lands right after the last visible poster. *@
                    <section class="home-lib">
                        @* Header link removed per feedback — the poster-shaped
                           "view all" tile at the end of the grid is the single
                           entry into /library. *@
                        <div class="home-lib__head">
                            <h2 class="home-lib__title">@L["home.library_title"]</h2>
                            <span class="home-lib__count">@_filtered.Count</span>
                        </div>
                        @if (_filtered.Count == 0)
                        {
                            <div class="catalog-empty">
                                <DIcon Name="video" Size="48" />
                                <div class="catalog-empty__text">@L["catalog.empty"]</div>
                            </div>
                        }
                        else
                        {
                            @* Render with headroom (41 covers ~21 columns × 2
                               rows); the collocated JS trims to the exact slot
                               count for the current width. @key keeps a card
                               with its title across filter changes (Ids are
                               unique — de-duplicated by Id). *@
                            <div class="home-lib__grid" @ref="_libGridRef">
                                @foreach (var item in _filtered.Take(41))
                                {
                                    <Poster @key="item.Id" Item="@item" />
                                }
                                <a class="home-lib__more tv-focus" href="/library" aria-label="@L["home.view_all"]">
                                    <span class="home-lib__more-icon"><DIcon Name="grid" Size="26" /></span>
                                    <span class="home-lib__more-label">@L["home.view_all"]</span>
                                    <span class="home-lib__more-count">@_filtered.Count</span>
                                </a>
                            </div>
                        }
                    </section>
                    break;
            }
        }
    }
</div>

@code {
    private List<MediaItemDto>      _allItems   = new();
    private List<MediaItemDto>      _filtered   = new();
    /// <summary>Every title with fanart, best-rated first — the Featured
    /// hero picks its top slice per folder in <see cref="ApplyFilter"/>.</summary>
    private List<MediaItemDto>      _featuredPool = new();
    private List<FolderWatcherDto>  _sections   = new();
    private ContinueWatchItemDto[]  _continueItems = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Continue-watching slice after the section filter. Hero binds to
    /// this so a TopBar folder pill narrows the hero alongside the library block.</summary>
    private ContinueWatchItemDto[]  _filteredContinue = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Featured-by-rating slice after the section filter.</summary>
    private List<MediaItemDto>      _filteredFeatured = new();
    /// <summary>Next-up feed (next episode per engaged series) — raw, then the
    /// section-filtered rail slice.</summary>
    private ContinueWatchItemDto[]  _nextUpItems    = Array.Empty<ContinueWatchItemDto>();
    private ContinueWatchItemDto[]  _filteredNextUp = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Hero feed = in-progress continue items + freshly-landed episodes
    /// (IsNew next-up). What <see cref="CatalogContinueHero"/> rotates through.</summary>
    private ContinueWatchItemDto[]  _heroItems      = Array.Empty<ContinueWatchItemDto>();
    private bool   _loading = true;
    private Guid?  _activeSection;     // TopBar folder pill filter
    private int    _heroInterval = 30;
    /// <summary>Enabled + implemented section keys in the user's order —
    /// drives the render stack above. Recomputed whenever preferences change
    /// (saving the editor in ProfilePanel reorders Home live).</summary>
    private List<string> _homeSections = new();
    private RecCardDto[] _forYou = Array.Empty<RecCardDto>();
    private CalendarEventDto[] _thisWeek = Array.Empty<CalendarEventDto>();
    private CalendarEventDto[] _filteredThisWeek = Array.Empty<CalendarEventDto>();

    protected override async Task OnInitializedAsync()
    {
        RebuildHomeSections();
        // v5: catalog category filter is shared state (Library page chips /
        // anything else may set it) — hero + library block follow it here.
        CategoryNav.OnChange += OnCategoryChanged;
        // TopBar folder pills write to FolderJump. Resolve name → section Id
        // via _sections lookup so hero + block both narrow to that folder.
        FolderJump.OnChange  += OnFolderJumpChanged;
        // Preferences changes (section order editor) re-stack Home live.
        UserCtx.OnChange     += OnUserChanged;

        // Hydrate the server registry FIRST. Without this, a cold-start
        // that lands on /home directly (cookie-restored boot bypasses
        // Welcome + Discovery) leaves ServerAddressProvider pointed at the
        // compile-time placeholder URL — every Api.* call below fires
        // against tower.one and times out. ServerReg.LoadAsync is
        // idempotent (early-returns when already loaded) so this is safe
        // to call from any page that fetches at boot.
        try { await ServerReg.LoadAsync(); } catch { /* localStorage hiccup — fall through */ }

        // Back on Home within the session (from Settings, a title, …): paint
        // the last feed at once and refresh it quietly. Re-running the whole
        // load (the full library among it) behind a spinner on every visit
        // made the app look like it restarted.
        if (FeedCache.TryGet(UserCtx.Me?.User.Id, Animarr.UI.Services.MediaUrl.Base) is { } cached)
        {
            ApplySnapshot(cached);
            _ = RefreshAsync();
            if (_homeSections.Contains("foryou")) _ = LoadForYouAsync();
            return;
        }

        var snapshot = await FetchAsync();
        FeedCache.Store(snapshot);
        ApplySnapshot(snapshot);
        if (_homeSections.Contains("foryou")) _ = LoadForYouAsync();
    }

    /// <summary>"For you" rail — loaded on its own so a cold TMDB backfill
    /// doesn't hold the rest of Home; renders when it arrives, and the cached
    /// feed keeps it for the next visit.</summary>
    private async Task LoadForYouAsync()
    {
        try { _forYou = await Api.GetForYouAsync(); }
        catch { return; }
        if (_cts.IsCancellationRequested) return;
        if (_snapshot is not null) FeedCache.Store(_snapshot = _snapshot with { ForYou = _forYou });
        await InvokeAsync(StateHasChanged);
    }

    private readonly CancellationTokenSource _cts = new();

    /// <summary>Re-fetch behind a cached paint. An incomplete fetch (offline,
    /// server hiccup) keeps what's on screen instead of blanking it.</summary>
    private async Task RefreshAsync()
    {
        try
        {
            var fresh = await FetchAsync();
            if (_cts.IsCancellationRequested || !fresh.Complete) return;
            FeedCache.Store(fresh);
            await InvokeAsync(() =>
            {
                if (_cts.IsCancellationRequested) return;
                ApplySnapshot(fresh);
                StateHasChanged();
            });
        }
        catch { /* keep the cached feed */ }
    }

    /// <summary>The feed on screen — "For you" lands into it later.</summary>
    private HomeFeedSnapshot? _snapshot;

    private void ApplySnapshot(HomeFeedSnapshot s)
    {
        _snapshot = s;
        _continueItems = s.Continue;
        _nextUpItems   = s.NextUp;
        // "For you" loads on its own (LoadForYouAsync); a feed fetched before
        // it landed mustn't put the older list back.
        if (_forYou.Length == 0) _forYou = s.ForYou;
        _thisWeek      = s.ThisWeek;
        _sections      = s.Sections;
        _childFolderIdsBySection.Clear();
        foreach (var (k, v) in s.ChildFolderIdsBySection) _childFolderIdsBySection[k] = v;
        _allItems      = s.AllItems;
        _featuredPool  = s.FeaturedPool;
        _heroInterval  = s.HeroInterval;

        // A NavPane folder picked on another page (SetActiveFolder, then
        // navigate here) or while this load ran fired OnChange before
        // _sections existed — so it never resolved. Pick it up now, as Library
        // does.
        _activeSection = ResolveActiveSection();
        _loading = false;
        ApplyFilter();
    }

    /// <summary>Load everything Home shows. The requests are independent, so
    /// they run side by side (they used to go one after another).</summary>
    private async Task<HomeFeedSnapshot> FetchAsync()
    {
        var userId = UserCtx.Me?.User.Id;
        var complete = true;

        async Task<T> Safe<T>(Func<Task<T>> call, T fallback, bool required = false)
        {
            try { return await call(); }
            catch
            {
                if (required) complete = false;
                return fallback;
            }
        }

        // Continue Watching — v5 hero source of truth. At most 5 in-progress
        // titles for the current user; empty when nothing's started (Home
        // falls back to Featured).
        var continueTask = Safe(() => Api.GetContinueWatchingAsync(take: 5), Array.Empty<ContinueWatchItemDto>());
        // Next Up — next episode per engaged series. Folds "new episode"
        // items into the hero and fills the rail under it.
        var nextUpTask = Safe(() => Api.GetNextUpAsync(take: 12), Array.Empty<ContinueWatchItemDto>());
        // "This week" — airing events for the current week (rail collapses
        // when the week is empty).
        var calendarTask = _homeSections.Contains("thisweek")
            ? Safe(() => Api.GetCalendarAsync(back: 1, ahead: 7), Array.Empty<CalendarEventDto>())
            : Task.FromResult(Array.Empty<CalendarEventDto>());
        var sectionsTask = Safe(() => Api.GetSectionFoldersAsync(), Array.Empty<FolderWatcherDto>(), required: true);
        var foldersTask  = Safe(() => Api.GetFoldersAsync(), Array.Empty<FolderWatcherDto>());
        var itemsTask    = Safe(() => Api.GetMediaItemsAsync(new MediaListQuery { Take = 10000, Sort = "title", View = MediaListQuery.CardView }),
                                Array.Empty<MediaItemDto>(), required: true);
        // Carousel cadence from server config.
        var intervalTask = Safe(() => Api.GetAppConfigValueAsync(AppConfigKeys.BackdropIntervalSec), (AppConfigEntryDto?)null);

        await Task.WhenAll(continueTask, nextUpTask, calendarTask,
                           sectionsTask, foldersTask, itemsTask, intervalTask);

        var weekEnd  = DateTime.Now.Date.AddDays(7);
        var thisWeek = calendarTask.Result
            .Where(e => e.AiringAtUtc.ToLocalTime().Date < weekEnd)
            .OrderBy(e => e.AiringAtUtc)
            .ToArray();

        var sections = sectionsTask.Result.OrderBy(f => f.Label).ToList();

        // Section → child-folder-id map, built right with the sections — NOT
        // in OnAfterRenderAsync (see git history: lifecycle race left the map
        // empty forever and folder pills filtered to zero). A failed folder
        // load degrades the section filter to a no-op.
        var childIds = new Dictionary<Guid, HashSet<Guid>>();
        if (foldersTask.Result.Length > 0)
        {
            foreach (var sec in sections)
            {
                var ids = foldersTask.Result
                    .Where(f => f.ParentSectionId == sec.Id)
                    .Select(f => f.Id)
                    .ToHashSet();
                ids.Add(sec.Id);
                childIds[sec.Id] = ids;
            }
        }

        // De-duplication: collapse by Id first (defensive), then by
        // (lowercased trimmed Title, Year) so the block never shows the
        // same logical title twice.
        var allItems = itemsTask.Result
            .GroupBy(m => m.Id)
            .Select(g => g.First())
            .GroupBy(m => (m.Title?.Trim().ToLowerInvariant() ?? "", m.Year))
            .Select(g => g.First())
            .ToList();

        // Featured hero pool: everything with fanart, best-rated first.
        // The top-5 cut happens per folder in ApplyFilter — cutting here
        // (library-wide) left most folder views without a hero.
        var featuredPool = allItems
            .Where(m => !string.IsNullOrEmpty(m.FanartPath))
            .OrderByDescending(m => m.Rating ?? 0)
            .ThenByDescending(m => m.RatingCount ?? 0)
            .ToList();

        var heroInterval = int.TryParse(intervalTask.Result?.Value, out var iv) ? iv : _heroInterval;

        // A profile switch mid-load would tag one user's feed with another's id.
        if (userId != UserCtx.Me?.User.Id) complete = false;

        return new HomeFeedSnapshot(
            userId, Animarr.UI.Services.MediaUrl.Base, complete,
            continueTask.Result, nextUpTask.Result, _forYou, thisWeek,
            sections, childIds, allItems, featuredPool, heroInterval);
    }

    /// <summary>Recompute the render stack from the stored preference —
    /// enabled entries only, filtered down to sections the app actually ships.</summary>
    private void RebuildHomeSections()
    {
        _homeSections = HomeSections.Parse(UserCtx.Preferences?.HomeSectionsJson)
            .Where(e => e.Enabled && HomeSections.ImplementedKeys.Contains(e.Key))
            .Select(e => e.Key)
            .ToList();
    }

    private void OnUserChanged()
    {
        RebuildHomeSections();
        StateHasChanged();
    }

    private void OnCategoryChanged()
    {
        ApplyFilter();
        StateHasChanged();
    }

    /// <summary>Reconcile <see cref="_activeSection"/> with the new value of
    /// <see cref="FolderJumpService.ActiveFolderName"/>. TopBar writes a label
    /// (the section's display name), not a GUID, so we resolve through the
    /// <see cref="_sections"/> list we already loaded. Unknown / empty names
    /// clear the filter back to "all sections".</summary>
    private void OnFolderJumpChanged()
    {
        var newSection = ResolveActiveSection();
        if (newSection == _activeSection) return;
        _activeSection = newSection;
        ApplyFilter();
        StateHasChanged();
    }

    private Guid? ResolveActiveSection()
    {
        var name = FolderJump.ActiveFolderName;
        if (string.IsNullOrWhiteSpace(name)) return null;
        return _sections.FirstOrDefault(s =>
            string.Equals(s.Label, name, StringComparison.OrdinalIgnoreCase))?.Id;
    }

    private void ApplyFilter()
    {
        IEnumerable<MediaItemDto> src = _allItems;

        // Category filter — shared state set by the Library page chips (and
        // deep links). Case-insensitive match on the DTO's CategoryNames.
        var activeCat = CategoryNav.ActiveCategoryName;
        if (!string.IsNullOrWhiteSpace(activeCat))
        {
            src = src.Where(m => m.CategoryNames is { Length: > 0 }
                              && m.CategoryNames.Any(n => string.Equals(n, activeCat, StringComparison.OrdinalIgnoreCase)));
        }

        // Section filter — items whose Folder is under the chosen section.
        if (_activeSection.HasValue)
        {
            src = src.Where(m => _childFolderIdsBySection
                .GetValueOrDefault(_activeSection.Value, new HashSet<Guid>())
                .Contains(m.FolderId));
        }

        // Belt-and-braces dedup — keep the first occurrence so the block
        // doesn't show visible duplicates if the API races a rescan.
        _filtered = src
            .GroupBy(m => m.Id)
            .Select(g => g.First())
            .ToList();

        // ── Hero slices follow the same section filter ────────────────────
        IEnumerable<MediaItemDto> featuredPool = _featuredPool;
        if (_activeSection.HasValue && _childFolderIdsBySection.TryGetValue(_activeSection.Value, out var secChildIds))
        {
            featuredPool = _featuredPool.Where(m => secChildIds.Contains(m.FolderId));

            var folderByMediaId = _allItems.ToDictionary(m => m.Id, m => m.FolderId);
            bool InSection(Guid mediaItemId) =>
                folderByMediaId.TryGetValue(mediaItemId, out var fid) && secChildIds.Contains(fid);
            _filteredContinue = _continueItems.Where(c => InSection(c.MediaItemId)).ToArray();
            _filteredNextUp   = _nextUpItems.Where(c => InSection(c.MediaItemId)).ToArray();
            _filteredThisWeek = _thisWeek.Where(e => InSection(e.MediaItemId)).ToArray();
        }
        else
        {
            _filteredContinue = _continueItems;
            _filteredNextUp   = _nextUpItems;
            _filteredThisWeek = _thisWeek;
        }

        // Featured = the folder's top 5 rated ≥ 8.0; a folder without such
        // titles still gets its best five so every view has a hero.
        var pool = featuredPool.ToList();
        _filteredFeatured = pool.Where(m => (m.Rating ?? 0) >= 8.0).Take(5).ToList();
        if (_filteredFeatured.Count == 0)
            _filteredFeatured = pool.Take(5).ToList();

        // One merged feed drives BOTH the hero (rotates through it) and the
        // rail below (lists it) so the two always show the SAME titles in the
        // SAME order. In-progress "continue" items come first and win on dedup;
        // next-up items (next-in-line / freshly-landed) follow.
        const int feedCap = 12;
        var feed     = new List<ContinueWatchItemDto>();
        var seenFeed = new HashSet<Guid>();
        foreach (var c in _filteredContinue)
            if (seenFeed.Add(c.MediaItemId)) feed.Add(c);
        foreach (var n in _filteredNextUp)
            if (seenFeed.Add(n.MediaItemId)) feed.Add(n);

        var feedArr     = feed.Take(feedCap).ToArray();
        _heroItems      = feedArr;   // hero rotates the same list…
        _filteredNextUp = feedArr;   // …the rail shows it.
    }

    // Section → set of child FolderWatcher Ids. Built eagerly in
    // OnInitializedAsync (right after _sections loads).
    private readonly Dictionary<Guid, HashSet<Guid>> _childFolderIdsBySection = new();

    // ── library-block fill (see Home.razor.js) ────────────────────────────
    private ElementReference _libGridRef;
    private IJSObjectReference? _libJs;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Init is idempotent (the JS guards on a per-element flag; a repeat
        // call just re-trims), and the grid element can be re-created by a
        // section re-order or its @key'ed posters re-ordered by a filter
        // change — so re-run it on every render while the grid exists.
        if (_loading || _libGridRef.Id is null) return;
        try
        {
            _libJs ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Animarr.UI/Components/Pages/Home.razor.js");
            await _libJs.InvokeVoidAsync("initLibGrid", _libGridRef);
        }
        catch { /* fill trim is an enhancement — the CSS clamp still holds */ }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        CategoryNav.OnChange -= OnCategoryChanged;
        FolderJump.OnChange  -= OnFolderJumpChanged;
        UserCtx.OnChange     -= OnUserChanged;
        if (_libJs is not null)
        {
            // Sync Dispose — fire-and-forget the JS teardown; the observer
            // dies with the element anyway on full page teardown.
            _ = SafeDisposeJsAsync(_libJs, _libGridRef);
            _libJs = null;
        }
    }

    private static async Task SafeDisposeJsAsync(IJSObjectReference js, ElementReference grid)
    {
        try
        {
            await js.InvokeVoidAsync("destroyLibGrid", grid);
            await js.DisposeAsync();
        }
        catch { /* circuit teardown */ }
    }
}
