@page "/"
@implements IDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject CategoryNavService CategoryNav
@inject FolderJumpService FolderJump
@inject UserContextState UserCtx
@inject Animarr.UI.Services.ServerRegistryState ServerReg

<PageTitle>Animarr</PageTitle>

<div class="catalog-page">

    @if (_loading)
    {
        @* Centered loading screen with branded ring spinner — the previous
           thin indeterminate bar at the top of the catalog let the page
           look like "empty library" while the data was still in flight
           (user reported this as "после деплоя всегда каталог пустой
           пишет"). A foreground spinner is unmistakably a transient state. *@
        <div class="catalog-loading">
            <div class="catalog-loading__ring"></div>
            <div class="catalog-loading__label">@L["catalog.loading"]</div>
        </div>
    }
    else
    {
        @* ── Section stack ─────────────────────────────────────────────
           Home is a stack of per-user reorderable sections (ProfilePanel →
           Appearance → "Home screen"): order + visibility come from
           UserPreferences.HomeSectionsJson via the shared HomeSections
           schema. Keys the schema knows but the app hasn't shipped yet
           (thisweek / foryou / discover) are skipped silently — they'll
           light up here when those features land. *@
        @foreach (var section in _homeSections)
        {
            @switch (section)
            {
                case "continue":
                    @* Hero — Continue Watching takes priority over Featured. If the
                       user has nothing in progress, the Featured-by-rating carousel
                       takes over so the slot doesn't go blank. Both bind to the
                       section-filtered slice so a TopBar folder pill narrows the
                       hero to that folder's items. *@
                    @if (_heroItems.Length > 0)
                    {
                        <CatalogContinueHero Items="@_heroItems" IntervalSec="@_heroInterval" />
                    }
                    else if (_filteredFeatured.Count > 0)
                    {
                        <CatalogHero Items="@_filteredFeatured" IntervalSec="@_heroInterval" />
                    }
                    break;

                case "nextup":
                    @if (_filteredNextUp.Length > 0)
                    {
                        <NextUpRail Items="@_filteredNextUp" />
                    }
                    break;

                case "foryou":
                    @* Heuristic recommendations: unwatched library titles scored
                       against the user's watch-time genre profile, TMDB backfill
                       for the free slots (dashed cards with a Want button).
                       Dismiss ✕ persists per user. *@
                    @if (_forYou.Length > 0)
                    {
                        <RecRail Title="@L["home.for_you"]"
                                 Hint="@L["recs.foryou_hint"]"
                                 Items="@_forYou"
                                 Dismissable="true" />
                    }
                    break;

                case "library":
                    @* Compact library block — a poster grid capped to two rows on
                       desktop (four on phones) with a "view all" tile as the last
                       cell. The full chip-filtered catalog lives on /library now;
                       this block still follows the TopBar folder pill filter so
                       the two stay consistent. Row capping is pure CSS: fixed
                       column counts per breakpoint + nth-child hides, so the tile
                       always lands right after the last visible poster. *@
                    <section class="home-lib">
                        <div class="home-lib__head">
                            <h2 class="home-lib__title">@L["home.library_title"]</h2>
                            <span class="home-lib__count">@_filtered.Count</span>
                            <a class="home-lib__all tv-focus" href="/library">@L["home.view_all"] →</a>
                        </div>
                        @if (_filtered.Count == 0)
                        {
                            <div class="catalog-empty">
                                <DIcon Name="video" Size="48" />
                                <div class="catalog-empty__text">@L["catalog.empty"]</div>
                            </div>
                        }
                        else
                        {
                            <div class="home-lib__grid">
                                @foreach (var item in _filtered.Take(17))
                                {
                                    <Poster Item="@item" />
                                }
                                <a class="home-lib__more tv-focus" href="/library" aria-label="@L["home.view_all"]">
                                    <span class="home-lib__more-icon"><DIcon Name="grid" Size="26" /></span>
                                    <span class="home-lib__more-label">@L["home.view_all"]</span>
                                    <span class="home-lib__more-count">@_filtered.Count</span>
                                </a>
                            </div>
                        }
                    </section>
                    break;
            }
        }
    }
</div>

@code {
    private List<MediaItemDto>      _allItems   = new();
    private List<MediaItemDto>      _filtered   = new();
    private List<MediaItemDto>      _featured   = new();
    private List<FolderWatcherDto>  _sections   = new();
    private ContinueWatchItemDto[]  _continueItems = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Continue-watching slice after the section filter. Hero binds to
    /// this so a TopBar folder pill narrows the hero alongside the library block.</summary>
    private ContinueWatchItemDto[]  _filteredContinue = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Featured-by-rating slice after the section filter.</summary>
    private List<MediaItemDto>      _filteredFeatured = new();
    /// <summary>Next-up feed (next episode per engaged series) — raw, then the
    /// section-filtered rail slice.</summary>
    private ContinueWatchItemDto[]  _nextUpItems    = Array.Empty<ContinueWatchItemDto>();
    private ContinueWatchItemDto[]  _filteredNextUp = Array.Empty<ContinueWatchItemDto>();
    /// <summary>Hero feed = in-progress continue items + freshly-landed episodes
    /// (IsNew next-up). What <see cref="CatalogContinueHero"/> rotates through.</summary>
    private ContinueWatchItemDto[]  _heroItems      = Array.Empty<ContinueWatchItemDto>();
    private bool   _loading = true;
    private Guid?  _activeSection;     // TopBar folder pill filter
    private int    _heroInterval = 30;
    /// <summary>Enabled + implemented section keys in the user's order —
    /// drives the render stack above. Recomputed whenever preferences change
    /// (saving the editor in ProfilePanel reorders Home live).</summary>
    private List<string> _homeSections = new();
    private RecCardDto[] _forYou = Array.Empty<RecCardDto>();

    protected override async Task OnInitializedAsync()
    {
        RebuildHomeSections();
        // v5: catalog category filter is shared state (Library page chips /
        // anything else may set it) — hero + library block follow it here.
        CategoryNav.OnChange += OnCategoryChanged;
        // TopBar folder pills write to FolderJump. Resolve name → section Id
        // via _sections lookup so hero + block both narrow to that folder.
        FolderJump.OnChange  += OnFolderJumpChanged;
        // Preferences changes (section order editor) re-stack Home live.
        UserCtx.OnChange     += OnUserChanged;

        // Hydrate the server registry FIRST. Without this, a cold-start
        // that lands on /home directly (cookie-restored boot bypasses
        // Welcome + Discovery) leaves ServerAddressProvider pointed at the
        // compile-time placeholder URL — every Api.* call below fires
        // against tower.one and times out. ServerReg.LoadAsync is
        // idempotent (early-returns when already loaded) so this is safe
        // to call from any page that fetches at boot.
        try { await ServerReg.LoadAsync(); } catch { /* localStorage hiccup — fall through */ }

        try
        {
            // Continue Watching — v5 hero source of truth. Returns at most 5
            // in-progress titles for the current user; empty array if the
            // user hasn't started anything (Home falls back to Featured).
            try { _continueItems = await Api.GetContinueWatchingAsync(take: 5); }
            catch { _continueItems = Array.Empty<ContinueWatchItemDto>(); }

            // Next Up — next episode per engaged series. Folds "new episode"
            // items into the hero and fills the rail under it.
            try { _nextUpItems = await Api.GetNextUpAsync(take: 12); }
            catch { _nextUpItems = Array.Empty<ContinueWatchItemDto>(); }

            // "For you" — heuristic recommendations (skipped entirely when the
            // user hid the section, so no wasted TMDB round-trips).
            if (_homeSections.Contains("foryou"))
            {
                try { _forYou = await Api.GetForYouAsync(); }
                catch { _forYou = Array.Empty<RecCardDto>(); }
            }

            var sections = await Api.GetSectionFoldersAsync();
            _sections = sections.OrderBy(f => f.Label).ToList();

            // Build the section → child-folder-id map HERE, right after _sections
            // loads — NOT in OnAfterRenderAsync (see git history: lifecycle race
            // left the map empty forever and folder pills filtered to zero).
            try
            {
                var allFolders = await Api.GetFoldersAsync();
                foreach (var sec in _sections)
                {
                    var ids = allFolders
                        .Where(f => f.ParentSectionId == sec.Id)
                        .Select(f => f.Id)
                        .ToHashSet();
                    ids.Add(sec.Id);
                    _childFolderIdsBySection[sec.Id] = ids;
                }
            }
            catch { /* section filter degrades to no-op */ }

            var items = await Api.GetMediaItemsAsync(new MediaListQuery { Take = 10000, Sort = "title" });
            // De-duplication: collapse by Id first (defensive), then by
            // (lowercased trimmed Title, Year) so the block never shows the
            // same logical title twice.
            _allItems = items
                .GroupBy(m => m.Id)
                .Select(g => g.First())
                .GroupBy(m => (m.Title?.Trim().ToLowerInvariant() ?? "", m.Year))
                .Select(g => g.First())
                .ToList();

            // Featured hero: top 5 rated ≥ 8.0 with a fanart path.
            _featured = _allItems
                .Where(m => (m.Rating ?? 0) >= 8.0 && !string.IsNullOrEmpty(m.FanartPath))
                .OrderByDescending(m => m.Rating ?? 0)
                .ThenByDescending(m => m.RatingCount ?? 0)
                .Take(5)
                .ToList();

            // Carousel cadence from server config.
            var intStr = await Api.GetAppConfigValueAsync(AppConfigKeys.BackdropIntervalSec);
            if (int.TryParse(intStr?.Value, out var iv)) _heroInterval = iv;
        }
        catch { /* offline — empty sections */ }

        _loading = false;
        ApplyFilter();
    }

    /// <summary>Recompute the render stack from the stored preference —
    /// enabled entries only, filtered down to sections the app actually ships.</summary>
    private void RebuildHomeSections()
    {
        _homeSections = HomeSections.Parse(UserCtx.Preferences?.HomeSectionsJson)
            .Where(e => e.Enabled && HomeSections.ImplementedKeys.Contains(e.Key))
            .Select(e => e.Key)
            .ToList();
    }

    private void OnUserChanged()
    {
        RebuildHomeSections();
        StateHasChanged();
    }

    private void OnCategoryChanged()
    {
        ApplyFilter();
        StateHasChanged();
    }

    /// <summary>Reconcile <see cref="_activeSection"/> with the new value of
    /// <see cref="FolderJumpService.ActiveFolderName"/>. TopBar writes a label
    /// (the section's display name), not a GUID, so we resolve through the
    /// <see cref="_sections"/> list we already loaded. Unknown / empty names
    /// clear the filter back to "all sections".</summary>
    private void OnFolderJumpChanged()
    {
        var name = FolderJump.ActiveFolderName;
        Guid? newSection = null;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var match = _sections.FirstOrDefault(s =>
                string.Equals(s.Label, name, StringComparison.OrdinalIgnoreCase));
            if (match is not null) newSection = match.Id;
        }
        if (newSection == _activeSection) return;
        _activeSection = newSection;
        ApplyFilter();
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        IEnumerable<MediaItemDto> src = _allItems;

        // Category filter — shared state set by the Library page chips (and
        // deep links). Case-insensitive match on the DTO's CategoryNames.
        var activeCat = CategoryNav.ActiveCategoryName;
        if (!string.IsNullOrWhiteSpace(activeCat))
        {
            src = src.Where(m => m.CategoryNames is { Length: > 0 }
                              && m.CategoryNames.Any(n => string.Equals(n, activeCat, StringComparison.OrdinalIgnoreCase)));
        }

        // Section filter — items whose Folder is under the chosen section.
        if (_activeSection.HasValue)
        {
            src = src.Where(m => _childFolderIdsBySection
                .GetValueOrDefault(_activeSection.Value, new HashSet<Guid>())
                .Contains(m.FolderId));
        }

        // Belt-and-braces dedup — keep the first occurrence so the block
        // doesn't show visible duplicates if the API races a rescan.
        _filtered = src
            .GroupBy(m => m.Id)
            .Select(g => g.First())
            .ToList();

        // ── Hero slices follow the same section filter ────────────────────
        if (_activeSection.HasValue && _childFolderIdsBySection.TryGetValue(_activeSection.Value, out var secChildIds))
        {
            _filteredFeatured = _featured.Where(m => secChildIds.Contains(m.FolderId)).ToList();

            var folderByMediaId = _allItems.ToDictionary(m => m.Id, m => m.FolderId);
            bool InSection(ContinueWatchItemDto c) =>
                folderByMediaId.TryGetValue(c.MediaItemId, out var fid) && secChildIds.Contains(fid);
            _filteredContinue = _continueItems.Where(InSection).ToArray();
            _filteredNextUp   = _nextUpItems.Where(InSection).ToArray();
        }
        else
        {
            _filteredFeatured = _featured;
            _filteredContinue = _continueItems;
            _filteredNextUp   = _nextUpItems;
        }

        // One merged feed drives BOTH the hero (rotates through it) and the
        // rail below (lists it) so the two always show the SAME titles in the
        // SAME order. In-progress "continue" items come first and win on dedup;
        // next-up items (next-in-line / freshly-landed) follow.
        const int feedCap = 12;
        var feed     = new List<ContinueWatchItemDto>();
        var seenFeed = new HashSet<Guid>();
        foreach (var c in _filteredContinue)
            if (seenFeed.Add(c.MediaItemId)) feed.Add(c);
        foreach (var n in _filteredNextUp)
            if (seenFeed.Add(n.MediaItemId)) feed.Add(n);

        var feedArr     = feed.Take(feedCap).ToArray();
        _heroItems      = feedArr;   // hero rotates the same list…
        _filteredNextUp = feedArr;   // …the rail shows it.
    }

    // Section → set of child FolderWatcher Ids. Built eagerly in
    // OnInitializedAsync (right after _sections loads).
    private readonly Dictionary<Guid, HashSet<Guid>> _childFolderIdsBySection = new();

    public void Dispose()
    {
        CategoryNav.OnChange -= OnCategoryChanged;
        FolderJump.OnChange  -= OnFolderJumpChanged;
        UserCtx.OnChange     -= OnUserChanged;
    }
}
