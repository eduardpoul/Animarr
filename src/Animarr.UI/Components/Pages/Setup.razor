@*
    First-run Setup wizard. Only reachable when /api/auth/status returns
    SetupRequired=true. Creates the initial Master user, then auto-signs
    them in and redirects to /catalog.

    Once the first user exists this route hard-redirects to /login.
*@

@page "/setup"
@layout AuthLayout
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject UserContextState UserCtx
@inject DeviceProfilesState DeviceProfiles

<PageTitle>Animarr</PageTitle>

<div class="d-setup">
    <PageBack Href="/welcome" Class="d-page-back--float" />

    <div class="d-setup__card" role="dialog" aria-label="@L["setup.aria_first_run"]">
        <header class="d-setup__brand">
            <BrandMark Size="40" ExtraClass="d-setup__brand-mark" />
            <div>
                <div class="d-setup__brand-name">Animarr</div>
                <div class="d-setup__brand-sub">@L["setup.brand_sub"]</div>
            </div>
        </header>

        <form class="d-setup__form" @onsubmit="OnSubmit" @onsubmit:preventDefault>
            <div class="d-setup__row">
                <Input @bind-Value="_name"     Placeholder="@L["setup.field_name_placeholder"]"     Label="@L["setup.field_name_label"]"     Disabled="@_loading" />
                <Input @bind-Value="_username" Placeholder="@L["setup.field_username_placeholder"]"  Label="@L["setup.field_username_label"]" Disabled="@_loading" Autocomplete="username" />
            </div>
            <Input @bind-Value="_email" Placeholder="@L["setup.field_email_placeholder"]" Label="@L["setup.field_email_label"]" Type="email" Disabled="@_loading" />
            <div class="d-setup__row">
                <Input @bind-Value="_password"        Placeholder="@L["setup.field_password_placeholder"]" Label="@L["setup.field_password_label"]"  Type="password" Disabled="@_loading" Autocomplete="new-password" />
                <Input @bind-Value="_passwordConfirm" Placeholder="@L["setup.field_repeat_placeholder"]"    Label="@L["setup.field_repeat_label"]"    Type="password" Disabled="@_loading" Autocomplete="new-password" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="fs-msgbar fs-msgbar--error" role="alert">
                    <span class="fs-msgbar__ic"><DIcon Name="warn" Size="16" /></span>
                    <span>@_error</span>
                </div>
            }

            <div class="fs-msgbar fs-msgbar--info">
                <span class="fs-msgbar__ic"><DIcon Name="info" Size="16" /></span>
                <span>@L["setup.hint"]</span>
            </div>

            <div class="d-setup__actions">
                <Btn Variant="primary" Size="lg" Type="submit" Disabled="@(_loading || !CanSubmit)">
                    @if (_loading) { <Spinner Size="sm" Tone="light" /><text>@L["setup.btn_creating"]</text> }
                    else
                    {
                        <text>@L["setup.btn_create_master"]</text>
                    }
                </Btn>
            </div>
        </form>
    </div>
</div>

@code {
    private string _name             = "";
    private string _username         = "";
    private string _email            = "";
    private string _password         = "";
    private string _passwordConfirm  = "";
    private string? _error;
    private bool _loading;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_name)
        && !string.IsNullOrWhiteSpace(_username)
        && _password.Length >= 6
        && _password == _passwordConfirm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!UserCtx.Loaded) await UserCtx.LoadAsync();
        // Setup is only reachable while Users table is empty.
        if (UserCtx.AuthStatus is not null && !UserCtx.AuthStatus.SetupRequired)
        {
            Nav.NavigateTo(UserCtx.IsAuthenticated ? "/" : "/login", replace: true);
        }
    }

    private async Task OnSubmit()
    {
        if (_loading || !CanSubmit) return;
        _error = null;
        _loading = true;
        try
        {
            var req = new SetupRequest(
                Name: _name.Trim(),
                Username: _username.Trim(),
                Email: string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                Password: _password,
                PasswordConfirm: _passwordConfirm);
            var created = await Api.SetupInitialMasterAsync(req);
            if (created is null)
            {
                _error = L["setup.error_failed_check_fields"];
                _loading = false;
                return;
            }
            await UserCtx.RefreshMeAsync();
            // First account, first device: the mandatory "Set a PIN" step.
            await DeviceProfiles.RefreshAsync();
            await DeviceProfiles.MarkGatePassedAsync();
            Nav.NavigateTo(DeviceProfiles.CurrentUserNeedsPin ? "/set-pin" : "/", replace: true);
        }
        catch (Exception ex)
        {
            _error = L.Get("setup.error_failed_fmt", ex.Message);
            _loading = false;
        }
    }
}
