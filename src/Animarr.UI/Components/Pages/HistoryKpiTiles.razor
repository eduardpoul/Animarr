@*
    KPI tiles for the rename-history page. Server returns the history rows
    via REST; we count locally to stay endpoint-light. Pattern count comes
    from the patterns endpoint.
*@

@inject IAnimarrApiClient Api

<div class="hkpi">
    <div class="hkpi__tile">
        <div class="hkpi__label">TOTAL RENAMES</div>
        <div class="hkpi__value" style="color:var(--text)">@_total</div>
    </div>
    <div class="hkpi__tile">
        <div class="hkpi__label">TODAY</div>
        <div class="hkpi__value" style="color:var(--accent-hi)">@_today</div>
    </div>
    <div class="hkpi__tile">
        <div class="hkpi__label">REVERTED</div>
        <div class="hkpi__value" style="color:var(--warn)">@_reverted</div>
    </div>
    <div class="hkpi__tile">
        <div class="hkpi__label">PATTERNS USED</div>
        <div class="hkpi__value" style="color:var(--success)">@_patterns</div>
    </div>
</div>

@code {
    private int _total, _today, _reverted, _patterns;

    protected override async Task OnInitializedAsync()
    {
        var hist = await Api.GetRenameHistoryAsync(take: 5000);
        var patterns = await Api.GetPatternsAsync();

        var today = DateTime.UtcNow.Date;
        _total    = hist.Length;
        _today    = hist.Count(h => h.ProcessedAt >= today);
        _reverted = hist.Count(h => h.IsReverted);
        _patterns = patterns.Length;
    }
}
