@page "/catalog/{Id:guid}"
@implements IAsyncDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UserContextState UserCtx

@*
    Media detail (v3 design — reused unchanged in v4 per CHANGELOG_3 §3).

    Composition:
      • <MediaDetailHero> — full-bleed fanart, BACK + EDIT METADATA glass
        chips, 260px poster + flex title block, CJK watermark, Continue CTA.
      • 3-column body: Synopsis 2.2fr · Details 1fr · Identification 320px.
      • Series / Anime: season tabs + episode grid (repeat(auto-fill,
        minmax(260px, 1fr))) using <EpisodeCard>.
      • Movies: <MovieFileCard> with 360px thumb panel + info panel.
      • Player overlay mounts Artplayer.
      • EditMetadataDrawer slides in from the right.
*@

<PageTitle>@(_item?.Title ?? "…") — Animarr</PageTitle>

@if (_loading)
{
    <div class="animarr-progress">
        <div class="animarr-progress__track">
            <div class="animarr-progress__fill animarr-progress__fill--indeterminate"></div>
        </div>
    </div>
}
else if (_item is null)
{
    <div class="md-not-found">
        <div class="md-not-found__text">@L["media_detail.not_found"]</div>
        <Btn Variant="solid" Size="md" OnClick="@(() => Nav.NavigateTo("/"))">
            <DIcon Name="chev-l" Size="14" /> @L["media_detail.btn_back"]
        </Btn>
    </div>
}
else
{
    var item = _item;

    @* Hero with full-bleed fanart, BACK / EDIT chips, poster + title row. *@
    <MediaDetailHero Item="@item"
                     BackHref="/"
                     Continue="@_continueAction"
                     OnContinueClick="OnHeroContinue"
                     OnEditClick="OpenEditPanel"
                     OnFavoriteClick="ToggleFavoriteAsync" />

    @* ── 3-column body — Synopsis · Details · Identification ────────────── *@
    <div class="md-body">
        <section class="md-body__col md-synopsis">
            <div class="md-overline">SYNOPSIS</div>
            @if (!string.IsNullOrEmpty(item.Description))
            {
                <p class="md-prose">@item.Description</p>
            }
            else
            {
                <p class="md-prose md-prose--empty">No synopsis available.</p>
            }
            <div class="md-actions">
                <Btn Variant="ghost" Size="md" OnClick="ReidentifyAsync">
                    <DIcon Name="refresh" Size="14" /> @L["catalog.btn_reidentify"]
                </Btn>
            </div>
        </section>

        <section class="md-body__col md-details">
            <div class="md-overline">DETAILS</div>
            <dl class="md-kv">
                @if (!string.IsNullOrEmpty(item.Studio)) { <dt>Studio</dt><dd>@item.Studio</dd> }
                @if (!string.IsNullOrEmpty(item.Language)) { <dt>Language</dt><dd>@item.Language</dd> }
                @if (item.Runtime is > 0) { <dt>Runtime</dt><dd>@item.Runtime m</dd> }
                @if (item.EpisodeCount is > 0) { <dt>Episodes</dt><dd>@item.EpisodeCount</dd> }
                @if (!string.IsNullOrEmpty(item.SeasonLabel)) { <dt>Season</dt><dd>@item.SeasonLabel</dd> }
                @if (!string.IsNullOrEmpty(item.Status)) { <dt>Status</dt><dd>@item.Status</dd> }
                @if (!string.IsNullOrEmpty(item.ContentRating)) { <dt>Rating</dt><dd>@item.ContentRating</dd> }
                @if (item.Genres.Length > 0)
                {
                    <dt>Tags</dt>
                    <dd class="md-kv__tags">@string.Join(" · ", item.Genres)</dd>
                }
            </dl>
        </section>

        <section class="md-body__col md-ident">
            <div class="md-overline md-overline--dim">IDENTIFICATION</div>
            @if (item.TmdbId is not null)
            {
                <div class="md-id-row">
                    <span class="md-id-row__src">TMDB</span>
                    <a class="md-id-row__link"
                       target="_blank" rel="noopener"
                       href="@($"https://www.themoviedb.org/{(item.MediaType == MediaItemType.Movie ? "movie" : "tv")}/{item.TmdbId}")">
                        @item.TmdbId
                        <DIcon Name="external" Size="10" />
                    </a>
                </div>
            }
            @if (item.MalId is not null)
            {
                <div class="md-id-row">
                    <span class="md-id-row__src">MAL</span>
                    <a class="md-id-row__link"
                       target="_blank" rel="noopener"
                       href="@($"https://myanimelist.net/anime/{item.MalId}")">
                        @item.MalId
                        <DIcon Name="external" Size="10" />
                    </a>
                </div>
            }
            @if (!string.IsNullOrEmpty(item.ImdbId))
            {
                <div class="md-id-row">
                    <span class="md-id-row__src">IMDb</span>
                    <a class="md-id-row__link"
                       target="_blank" rel="noopener"
                       href="@($"https://www.imdb.com/title/{item.ImdbId}")">
                        @item.ImdbId
                        <DIcon Name="external" Size="10" />
                    </a>
                </div>
            }
        </section>
    </div>

    @* ── Episodes (series/anime) ──────────────────────────
         v5 fix: previously this branch only fired when Item.Seasons came back
         non-empty AND active.EpisodeCount > 0. Two regressions fell out of
         that:
           1. Series/Anime items that hadn't been TMDB-identified yet (or
              whose SeasonsJson was lost during a migration) had Seasons.Length
              == 0 and the page rendered NOTHING — neither episode grid nor
              movie card — so the user just saw the hero on its own.
           2. When _files came back empty (cold load, brief API hiccup), every
              card got Have=false → .d-ep--miss → 48% opacity. On the new
              Quietude dark-navy bg that reads as "blank shimmery cards".

         The new logic: render the episode grid whenever there are seasons
         OR there are files but the type is a series/anime. The episode
         count for the active season falls back to whichever of {seasons
         metadata, max file episode, 1} is highest, so we always show at
         least one row. *@
    var isMultiEpisode = item.MediaType == MediaItemType.Series
                      || item.MediaType == MediaItemType.Anime
                      || item.MediaType == MediaItemType.Multserials;
    // Trust the stored season list ONLY when a real season source backs it
    // (TMDB or MAL — the only providers that give a season/episode breakdown).
    // Without one, item.Seasons is unreliable: switching a title to an IMDb-only
    // id (imdbapi.dev carries no seasons) leaves the OLD match's season list
    // behind, and the manual-apply "clean slate" doesn't wipe SeasonsJson. So a
    // TMDB/MAL-less title ignores those stale seasons and falls back to the
    // file-derived grid below (or, for unmatched files, the "Unmatched files"
    // section). Normal series keep a TMDB/MAL id, so this never touches them.
    var hasMetaSeasonSource = item.TmdbId is not null || item.MalId is not null;
    var hasSeasonMeta  = hasMetaSeasonSource && item.Seasons.Length > 0;
    // Fallback "synthetic" season list built from on-disk files when no
    // metadata seasons are available (anime OVAs identified without TMDB).
    // Treat a file's season as 1 when the parser found an episode number but no
    // season (flat folders like "Show/01.mkv" → S?? E1). Without this, episodic
    // files with a null season fell through every branch — no grid (fileSeasons
    // was empty) and the "Unmatched files" section only catches null-EPISODE
    // files — so they rendered nowhere.
    var fileSeasons    = _files
        .Where(f => f.Season is not null || f.Episode is not null)
        .Select(f => f.Season ?? 1)
        .Distinct()
        .OrderBy(n => n)
        .ToArray();
    var showEpisodeGrid = hasSeasonMeta
                      || (isMultiEpisode && fileSeasons.Length > 0);
    if (showEpisodeGrid)
    {
        <section class="md-seasons">
            <nav class="md-season-tabs" aria-label="Seasons">
                @if (hasSeasonMeta)
                {
                    @foreach (var s in item.Seasons.OrderBy(s => s.Number))
                    {
                        var n = s.Number;
                        <button type="button"
                                class="@($"md-season-tab tv-focus {(_activeSeason == n ? "md-season-tab--active" : "")}")"
                                @onclick="@(() => _activeSeason = n)">
                            @($"Season {n}") <span class="md-season-tab__count">@s.EpisodeCount</span>
                        </button>
                    }
                    @* Disk-only seasons TMDB metadata doesn't list — chiefly
                       Specials (season 0). Without a tab they'd stay hidden. *@
                    @foreach (var n in fileSeasons.Where(fs => !item.Seasons.Any(s => s.Number == fs)))
                    {
                        var nn = n;
                        var epCount = _files.Count(f => (f.Season ?? 1) == nn);
                        <button type="button"
                                class="@($"md-season-tab tv-focus {(_activeSeason == nn ? "md-season-tab--active" : "")}")"
                                @onclick="@(() => _activeSeason = nn)">
                            @(nn == 0 ? "Specials" : $"Season {nn}") <span class="md-season-tab__count">@epCount</span>
                        </button>
                    }
                }
                else
                {
                    @foreach (var n in fileSeasons)
                    {
                        var nn = n;
                        var epCount = _files.Count(f => (f.Season ?? 1) == nn);
                        <button type="button"
                                class="@($"md-season-tab tv-focus {(_activeSeason == nn ? "md-season-tab--active" : "")}")"
                                @onclick="@(() => _activeSeason = nn)">
                            @(nn == 0 ? "Specials" : $"Season {nn}") <span class="md-season-tab__count">@epCount</span>
                        </button>
                    }
                }
            </nav>

            @{
                var active = hasSeasonMeta ? item.Seasons.FirstOrDefault(s => s.Number == _activeSeason) : null;
                // Episode count for the loop. Prefer the metadata's count, but
                // fall back to whichever is larger of (metadata count, max
                // on-disk file episode for this season) so cards aren't lost
                // when TMDB underreports the season length (common for ongoing
                // donghua / continuing series).
                var maxFileEp = _files.Where(f => (f.Season ?? 1) == _activeSeason)
                                       .Max(f => (int?)f.Episode) ?? 0;
                var loopEpCount = Math.Max(active?.EpisodeCount ?? 0, maxFileEp);
                if (loopEpCount == 0) loopEpCount = 1;
                // Per-season poster URL (used as the per-episode thumb fallback
                // so the grid isn't a wall of placeholder DIcons). Cache-buster
                // ticks come from Item.LastMetadataRefreshedAt — rescans
                // overwrite the same path. Falls back to the main FanartPath
                // when no season-poster was downloaded.
                var seasonPoster = active?.PosterPath ?? item.FanartPath ?? item.PosterPath;
                var seasonThumb = !string.IsNullOrEmpty(seasonPoster)
                    ? Animarr.UI.Services.MediaUrl.Image(seasonPoster, item.LastMetadataRefreshedAt?.Ticks ?? 0)
                    : null;
            }
            @if (active is not null && !string.IsNullOrEmpty(active.Overview))
            {
                <p class="md-season-overview">@active.Overview</p>
            }

            @{ var didMarkAutofocusEp = false; }
            <div class="md-episode-grid">
                @for (int i = 1; i <= loopEpCount; i++)
                {
                    var ep        = i;
                    var epFile    = _files.FirstOrDefault(f => (f.Season ?? 1) == _activeSeason && f.Episode == ep);
                    var hasFile   = epFile is not null;
                    var watchDto  = _watchStates.FirstOrDefault(w => w.Season == _activeSeason && w.Episode == ep);
                    // Season 0 = Specials; a donghua season-offset surfaces the
                    // TMDB absolute number so the user sees which TMDB episode
                    // their disk file maps to ("Episode 1 · TMDB #107").
                    var epTitle   = _activeSeason == 0
                        ? $"Special {ep}"
                        : epFile?.AbsoluteEpisode is int absEp
                            ? $"Episode {ep} · TMDB #{absEp}"
                            : $"Episode {ep}";
                    // First on-disk episode becomes the default-focus target
                    // when the hero has no Continue CTA (i.e. nothing in
                    // progress yet). Series like Death's Game where every
                    // episode is missing → no card gets the marker, focus
                    // falls back to first-focusable-in-main (Back chip).
                    var markEpAutofocus = hasFile && !didMarkAutofocusEp;
                    if (markEpAutofocus) didMarkAutofocusEp = true;
                    // Design spec: on-disk shows runtime/codec/size; missing shows
                    // "Not downloaded" in warn color (the .d-ep--miss .d-ep__meta
                    // rule already tints it). Was hard-coded to runtime regardless,
                    // so missing episodes showed e.g. "53m" in warn color — looks
                    // like the file IS there with broken styling. Bug surfaced on
                    // Death's Game where every episode is missing.
                    var epMeta    = hasFile
                        ? (item.Runtime is > 0 ? $"{item.Runtime}m" : "")
                        : L["episode_card.meta_missing"];

                    @* On TV the card itself MUST be focusable — without it, the
                       D-pad has nothing to land on inside the episode grid and
                       OK can't trigger Play. The wrapper was a plain <div> with
                       click handler, which mouse + touch handle fine but the
                       remote treats as un-targetable. tabindex+role+keydown
                       turns it into a proper interactive widget that
                       tv-nav.js's spatial scan picks up and that the OK key
                       (Enter) activates. Disabled episodes (file missing)
                       still render but tabindex=-1 so the remote skips over
                       them — matches the visual --miss dim. *@
                    <div class="md-episode-card tv-focus"
                         tabindex="@(hasFile ? "0" : "-1")"
                         role="button"
                         aria-label="@($"Play episode {ep}")"
                         aria-disabled="@(hasFile ? "false" : "true")"
                         data-tv-autofocus="@(markEpAutofocus ? "true" : null)"
                         @onclick="@(() => hasFile ? PlayEpisodeAsync(_activeSeason, ep) : Task.CompletedTask)"
                         @onkeydown="@(async (KeyboardEventArgs e) => { if (hasFile && (e.Key == "Enter" || e.Key == " ")) await PlayEpisodeAsync(_activeSeason, ep); })">
                        <EpisodeCard Number="ep"
                                     Title="@epTitle"
                                     ThumbUrl="@(hasFile ? Animarr.UI.Services.MediaUrl.EpisodeThumb(Id, _activeSeason, ep) : seasonThumb)"
                                     Meta="@epMeta"
                                     Have="hasFile"
                                     WatchStateDto="@watchDto"
                                     OnToggleWatched="@(() => ToggleEpisodeWatched(_activeSeason, ep, !(watchDto?.IsWatched == true)))" />
                    </div>
                }
            </div>
        </section>
    }
    else if (item.MediaType == MediaItemType.Movie
          || (item.Seasons.Length == 0 && _files.Length > 0))
    {
        @* Movie OR flat-folder anime (e.g. one-shot OVA) with no Seasons.
           Renders the same MovieFileCard recipe. *@
        var movieFile     = _files.FirstOrDefault();
        var movieWatchDto = _watchStates.FirstOrDefault(w => w.Season is null && w.Episode is null);
        var thumbUrl      = !string.IsNullOrEmpty(item.FanartPath)
            ? Animarr.UI.Services.MediaUrl.Image(item.FanartPath!, item.LastMetadataRefreshedAt?.Ticks ?? 0)
            : (!string.IsNullOrEmpty(item.PosterPath)
                ? Animarr.UI.Services.MediaUrl.Image(item.PosterPath!, item.LastMetadataRefreshedAt?.Ticks ?? 0)
                : null);
        var runtimeLabel  = item.Runtime is > 0 ? $"{item.Runtime} min" : null;

        <section class="md-movie-section">
            <MovieFileCard Title="@item.Title"
                           FileName="@(movieFile?.FileName)"
                           ThumbUrl="@thumbUrl"
                           Runtime="@runtimeLabel"
                           Have="@(movieFile is not null)"
                           WatchStateDto="@movieWatchDto"
                           PlayLabel="@(MovieCtaLabel(movieWatchDto))"
                           PlayIcon="@(MovieCtaIcon(movieWatchDto))"
                           OnPlayClick="OnMoviePlayClick"
                           OnToggleWatched="OnMovieToggleWatched" />
        </section>
    }

    @* ── Unmatched files ───────────────────────────────────────────────
         Series files on disk that the deterministic parser couldn't place
         (Episode == null). They're invisible in the episode grid above, so
         surface them here: set (season, episode) by hand — Tier 2 manual
         override — or hit "Resolve with AI" to run the LLM (Tier 1). *@
    @if (item.MediaType == MediaItemType.Series && _files.Any(f => f.Episode is null))
    {
        var unmatched = _files.Where(f => f.Episode is null)
                              .OrderBy(f => f.FileName, StringComparer.OrdinalIgnoreCase)
                              .ToList();
        <section class="md-unmatched">
            <div class="md-unmatched__head">
                <h3 class="md-unmatched__title">
                    Unmatched files <span class="md-unmatched__count">@unmatched.Count</span>
                </h3>
                <button class="md-unmatched__ai tv-focus" disabled="@_aiBusy" @onclick="ResolveWithAiAsync">
                    @(_aiBusy ? "Resolving…" : "✨ Resolve with AI")
                </button>
            </div>
            <p class="md-unmatched__hint">
                On disk, but no season/episode could be read from the name. Set them
                by hand, or let the AI match against the episode list.
            </p>
            @if (_aiStatus is not null)
            {
                <p class="md-unmatched__status">@_aiStatus</p>
            }
            @foreach (var f in unmatched)
            {
                var path = f.FilePath;
                <div class="md-unmatched__row">
                    <span class="md-unmatched__name" title="@path">@f.FileName</span>
                    <label class="md-unmatched__field">S
                        <input type="number" min="1" class="md-unmatched__num"
                               value="@EditSeason(path, f)"
                               @onchange="@(e => SetEditSeason(path, e.Value?.ToString()))" />
                    </label>
                    <label class="md-unmatched__field">E
                        <input type="number" min="1" class="md-unmatched__num"
                               value="@EditEpisode(path, f)"
                               @onchange="@(e => SetEditEpisode(path, e.Value?.ToString()))" />
                    </label>
                    <button class="md-unmatched__save tv-focus" @onclick="@(() => SaveMappingAsync(path, f))">Save</button>
                </div>
            }
        </section>
    }
}

@* Player overlay — Artplayer mounts into the .vp-art container. *@
@if (_playerPath is not null)
{
    <div class="vp-backdrop" @onclick="ClosePlayer">
        <div class="vp-shell" @onclick:stopPropagation>
            <div id="@_playerElementId" class="vp-art"></div>
        </div>
    </div>
}

@* Edit metadata drawer *@
@if (_editOpen && _item is not null)
{
    <EditMetadataDrawer Item="_item" OnClose="@(() => _editOpen = false)" OnSaved="OnEditSaved" />
}

@* "Mark earlier episodes watched too?" confirm — fired from the episode grid. *@
@if (_showMarkPrev)
{
    <MarkPreviousDialog Count="_markPrevTargets.Count"
                        OnConfirm="ConfirmMarkPrevious"
                        OnCancel="CancelMarkPrevious" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    // Auto-play target from the Home "Up next" rail. ?s=&e= opens the player
    // straight on that episode; ?play=1 resumes/plays a movie. One-shot
    // (guarded by _autoPlayHandled) so closing the player doesn't replay it.
    [Parameter, SupplyParameterFromQuery(Name = "s")]    public int? AutoPlaySeason  { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "e")]    public int? AutoPlayEpisode { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "play")] public int? AutoPlayMovie  { get; set; }
    private bool _autoPlayHandled;

    private MediaItemDto? _item;
    private MediaFileDto[] _files = Array.Empty<MediaFileDto>();
    private bool _loading = true;
    private ContinueWatchDto? _continue;
    private ContinueAction?   _continueAction;
    private List<WatchStateDto> _watchStates = new();
    private int _activeSeason = 1;
    private bool _movieWatched;
    private bool _editOpen;

    // "Mark previous episodes watched" popup — set when the user marks an
    // episode watched and earlier on-disk episodes are still unwatched.
    private bool _showMarkPrev;
    private List<(int Season, int Episode)> _markPrevTargets = new();

    // ─── Unmatched-file resolution (episode-resolution Tiers 1–2) ─────────
    // Pending per-file edits keyed by absolute path; falls back to the file's
    // current (deterministic) values until the user types something.
    private bool _aiBusy;
    private string? _aiStatus;
    private readonly Dictionary<string, (int? Season, int? Episode)> _edit = new();

    private int? EditSeason(string path, MediaFileDto f)
        => _edit.TryGetValue(path, out var e) ? e.Season : f.Season;
    private int? EditEpisode(string path, MediaFileDto f)
        => _edit.TryGetValue(path, out var e) ? e.Episode : f.Episode;

    private void SetEditSeason(string path, string? raw)
    {
        var cur = _edit.TryGetValue(path, out var e) ? e : default;
        _edit[path] = (ParseNum(raw), cur.Episode);
    }

    private void SetEditEpisode(string path, string? raw)
    {
        var cur = _edit.TryGetValue(path, out var e) ? e : default;
        _edit[path] = (cur.Season, ParseNum(raw));
    }

    private static int? ParseNum(string? raw)
        => int.TryParse(raw, out var n) && n > 0 ? n : null;

    private async Task SaveMappingAsync(string path, MediaFileDto f)
    {
        await Api.SetEpisodeMappingAsync(Id, new EpisodeMappingRequest(path, EditSeason(path, f), EditEpisode(path, f)));
        _edit.Remove(path);
        await ReloadFilesAsync();
    }

    private async Task ResolveWithAiAsync()
    {
        if (_aiBusy) return;
        _aiBusy = true; _aiStatus = null; StateHasChanged();
        try
        {
            var n = await Api.ResolveEpisodesWithLlmAsync(Id);
            _aiStatus = n > 0
                ? $"AI matched {n} file(s)."
                : "AI matched nothing (LLM off, or no confident match).";
            await ReloadFilesAsync();
        }
        catch (Exception ex) { _aiStatus = $"AI error: {ex.Message}"; }
        finally { _aiBusy = false; StateHasChanged(); }
    }

    private async Task ReloadFilesAsync()
    {
        _files = await Api.GetMediaFilesAsync(Id);
        StateHasChanged();
    }
    /// <summary>True once we've pushed default-focus to the hero CTA /
    /// first episode after the initial async load. Subsequent re-renders
    /// (toggled watched, edited metadata) skip the auto-focus so the
    /// user's current focus doesn't get yanked back to the top.</summary>
    private bool _didAutoFocus;

    /// <summary>True once the title's theme music has been started for this page
    /// mount. Reset on player close so the theme resumes when the user returns to
    /// the detail view from playback.</summary>
    private bool _themeStarted;

    // Player state — _playerPath drives the overlay render; _playerSelfRef
    // is the DotNetObjectReference passed to animarrPlayer.attach so the JS
    // module can call back into our JSInvokable methods.
    private string? _playerPath;
    private string  _playerElementId = $"vp-{Guid.NewGuid():N}";
    private int?    _playerSeason;
    private int?    _playerEpisode;
    private DotNetObjectReference<MediaDetail>? _playerSelfRef;
    private DateTime _lastProgressWrite = DateTime.MinValue;

    protected override async Task OnInitializedAsync()
    {
        // Rebase any <img src> built off MediaUrl when the active server URL
        // flips (cookie-restored MAUI boot resolves the registry after the
        // page first renders).
        Animarr.UI.Services.MediaUrl.OnBaseChanged += OnBaseChanged;
        await LoadAsync();
    }

    /// <summary>Honour the Home rail's auto-play query params once the item +
    /// files have loaded. Episode → open the player on it; play=1 → resume/play
    /// the movie via the same path the hero Continue CTA uses. Runs once, from
    /// OnAfterRenderAsync so JS interop (player attach) is guaranteed live.</summary>
    private async Task MaybeAutoPlayAsync()
    {
        if (_autoPlayHandled || _item is null) return;
        if (AutoPlaySeason is int s && AutoPlayEpisode is int e)
        {
            _autoPlayHandled = true;
            await PlayEpisodeAsync(s, e);
        }
        else if (AutoPlayMovie is 1)
        {
            _autoPlayHandled = true;
            await HandleContinueClick();
        }
    }

    private void OnBaseChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _item     = await Api.GetMediaItemAsync(Id);
            _continue = await Api.GetContinueAsync(Id);
            _continueAction = _continue is null ? null : ContinueAction.FromDto(_continue);
            var states = await Api.GetWatchStatesAsync(Id);
            _watchStates = states.ToList();
            _movieWatched = states.Any(w => w.Season is null && w.Episode is null && w.IsWatched);
            _files = await Api.GetMediaFilesAsync(Id);

            // Mirror the render's gate: only seed the active season from the
            // stored Seasons list when a real source (TMDB/MAL) backs it —
            // otherwise prefer on-disk file seasons so a stale list left over
            // from a removed match doesn't pin the tab to a phantom season.
            var hasMetaSeasonSource = _item is not null
                && (_item.TmdbId is not null || _item.MalId is not null);
            if (hasMetaSeasonSource && _item!.Seasons.Length > 0)
            {
                _activeSeason = _item.Seasons.OrderBy(s => s.Number).First().Number;
            }
            else if (_files.Length > 0)
            {
                // No metadata season source — focus the lowest file-derived
                // season. Null-season files (flat folders) count as Season 1, so
                // a numbered-but-seasonless folder still lands on a real tab.
                // Pairs with the `fileSeasons` (Season ?? 1) branch in render.
                _activeSeason = _files.Min(f => f.Season ?? 1);
            }
        }
        catch { _item = null; }
        _loading = false;
        StateHasChanged();
    }

    private Task OnHeroContinue(ContinueAction action) => HandleContinueClick();

    private async Task HandleContinueClick()
    {
        if (_item is null || _continue is null) return;
        // Prefer the file path the server resolved (the next-unwatched episode),
        // then fall back to a (season, episode) lookup, then the first file.
        string? path = _continue.FilePath;
        if (path is null && _continue.Season is int s && _continue.Episode is int ep)
        {
            var f = _files.FirstOrDefault(x => (x.Season ?? 1) == s && x.Episode == ep);
            path = f?.FilePath;
        }
        path ??= _files.FirstOrDefault()?.FilePath;
        if (path is null) return;
        await PlayPathAsync(path, _continue.Season, _continue.Episode);
    }

    private Task OnMoviePlayClick()
    {
        var movieFile = _files.FirstOrDefault();
        return movieFile is null ? Task.CompletedTask : PlayPathAsync(movieFile.FilePath);
    }

    private Task OnMovieToggleWatched() => ToggleMovieWatched(!_movieWatched);

    private async Task PlayEpisodeAsync(int season, int episode)
    {
        // (f.Season ?? 1) so a null-season-but-numbered file (flat folder) is
        // found when the grid plays it under its effective Season 1.
        var file = _files.FirstOrDefault(f => (f.Season ?? 1) == season && f.Episode == episode);
        if (file is null) return;
        await PlayPathAsync(file.FilePath, season, episode);
    }

    private async Task PlayPathAsync(string path, int? season = null, int? episode = null)
    {
        // The real player is taking over — silence the theme.
        await StopThemeAsync();

        if (_playerSelfRef is not null)
        {
            try { await JS.InvokeVoidAsync("animarrPlayer.flush",  _playerElementId); } catch { }
            try { await JS.InvokeVoidAsync("animarrPlayer.detach", _playerElementId); } catch { }
            _playerSelfRef.Dispose();
            _playerSelfRef = null;
        }

        _playerPath      = path;
        _playerSeason    = season;
        _playerEpisode   = episode;
        _playerElementId = $"vp-{Guid.NewGuid():N}";
        _lastProgressWrite = DateTime.MinValue;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Push default-focus to the hero Continue CTA (or first available
        // episode card, or MovieFileCard's Play — whichever is the
        // headline data-tv-autofocus target on this item) once the async
        // load completes. Only runs once per page mount so subsequent
        // toggles (mark watched, save edit) don't yank focus away from
        // wherever the user is now.
        if (!_loading && _item is not null && !_didAutoFocus)
        {
            _didAutoFocus = true;
            try { await JS.InvokeVoidAsync("animarrTvNav.refocusAutofocus"); }
            catch { /* non-tv host — no-op */ }

            // Reset scroll to the page top now that the REAL (tall) content has
            // rendered. Blazor preserves scroll position across SPA navigation,
            // so opening a movie from a scrolled-down catalog otherwise lands
            // mid-hero with the Back / Favorite / Edit chrome above the fold
            // ("hero flew off / favorite+edit buttons gone"). The JS reset that
            // fires at navigation time runs BEFORE this async load completes, so
            // we re-assert it here — the reliable moment, post-render.
            try { await JS.InvokeVoidAsync("animarrTvNav.scrollToTop"); }
            catch { /* host without tv-nav.js — no-op */ }
        }

        // Honour the Home "Up next" rail's auto-play query params (?s=&e= /
        // ?play=1) once loaded. Post-render so the player JS attach is live.
        if (!_autoPlayHandled && !_loading && _item is not null && _playerPath is null)
        {
            await MaybeAutoPlayAsync();
        }

        // Soft-autoplay the title's theme music once per mount — only when the
        // user opted in and no real playback is active. Anime only (the endpoint
        // 404s otherwise). Stopped when a video starts (PlayPathAsync) and resumed
        // when the player closes (ClosePlayer resets _themeStarted).
        // Guard on Preferences being loaded — otherwise a first render that beats
        // the boot-time prefs fetch would latch _themeStarted=true and never start.
        if (!_themeStarted && !_loading && _item is not null && _playerPath is null
            && UserCtx.Preferences is not null)
        {
            _themeStarted = true;
            await StartThemeAsync();
        }

        if (_playerPath is not null && _playerSelfRef is null)
        {
            _playerSelfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("animarrPlayer.attach",
                    _playerElementId, _playerSelfRef, _playerPath);

                // Push Now-Playing metadata so the OS lock screen / Control
                // Centre / Bluetooth-stack media buttons show the right title
                // + poster instead of the default WebView favicon. Pairs with
                // [JSInvokable] InvokePrev/InvokeNext below for prev/next track.
                if (_item is not null)
                {
                    var titleParts = new List<string>();
                    if (_playerSeason is > 0) titleParts.Add($"S{_playerSeason:D2}");
                    if (_playerEpisode is > 0) titleParts.Add($"E{_playerEpisode:D2}");
                    var episodeLabel = string.Join(' ', titleParts);
                    var title = string.IsNullOrEmpty(episodeLabel)
                        ? _item.Title
                        : $"{_item.Title} — {episodeLabel}";
                    var artist = _item.Studio ?? _item.Language ?? string.Empty;
                    var album  = _item.Title;
                    // Poster path comes as a relative `/api/image/...` URL —
                    // browser resolves it against the page origin which is
                    // exactly what MediaSession's artwork field needs.
                    var artwork = _item.PosterPath ?? _item.FanartPath ?? string.Empty;
                    // Accurate adjacency: only offer prev/next when a real file
                    // for that episode exists on disk (rolls across season
                    // boundaries). Drives the lock-screen buttons AND the
                    // end-of-episode auto-advance overlay's `nextAvailable` gate.
                    var nextEp  = NextEpisodeOnDisk(_playerSeason, _playerEpisode);
                    var prevEp  = PrevEpisodeOnDisk(_playerSeason, _playerEpisode);
                    var hasNext = nextEp is not null;
                    var hasPrev = prevEp is not null;
                    // Up-next card label, e.g. "S1 · EP 6" (season hidden for
                    // flat/seasonless items where it's 0).
                    var upNextName = "";
                    if (nextEp is { } ne)
                    {
                        var neBits = new List<string>();
                        if (ne.Season > 0) neBits.Add($"S{ne.Season}");
                        neBits.Add($"EP {ne.Episode}");
                        upNextName = string.Join(" · ", neBits);
                    }
                    // HUD-specific kicker. Design (§T-03 in 04-tv.html) shows
                    // "Now playing · S1 · EP 5" — no zero-pad, space before
                    // the episode number. Plain "Now playing" for movies.
                    var hudKickerBits = new List<string> { "Now playing" };
                    if (_playerSeason is > 0)  hudKickerBits.Add($"S{_playerSeason}");
                    if (_playerEpisode is > 0) hudKickerBits.Add($"EP {_playerEpisode}");
                    var hudKicker = string.Join(" · ", hudKickerBits);

                    // Skip-intro/credits times for the player. Best-effort: null →
                    // the player hides Skip Intro and uses its 95% next-up fallback.
                    // The server lazily detects (AniSkip) on a first-watch miss.
                    object? segments = null;
                    if (_playerEpisode is > 0)
                    {
                        try
                        {
                            var seg = await Api.GetEpisodeSegmentsAsync(_item.Id, _playerSeason ?? 1, _playerEpisode.Value);
                            if (seg is not null)
                                segments = new {
                                    introStart   = seg.IntroStart,
                                    introEnd     = seg.IntroEnd,
                                    creditsStart = seg.CreditsStart,
                                    creditsEnd   = seg.CreditsEnd,
                                };
                        }
                        catch { /* segments are optional decoration */ }
                    }

                    var meta = new {
                        title,
                        artist,
                        album,
                        artworkUrl    = artwork,
                        prevAvailable = hasPrev,
                        nextAvailable = hasNext,
                        // HUD overlay (variant B) reads these to render the
                        // top-bar title block. Falls back to `title` if absent.
                        hudKicker,
                        hudName       = _item.Title,
                        // End-of-episode "Up next" autoplay card labels.
                        upNextEyebrow = L["player.up_next"],
                        upNextName,
                        upNextPlay    = L["player.up_next_play"],
                        upNextDismiss = L["player.up_next_dismiss"],
                        // Skip-intro/credits segment times (seconds) for the player.
                        segments,
                    };
                    try
                    {
                        await JS.InvokeVoidAsync("animarrPlayer.setMediaSession",
                            _playerElementId, meta, new { dotnetRef = _playerSelfRef });
                    }
                    catch { /* metadata is decoration, not playback — never throw */ }

                    // Watch Next / Google-TV "Continue watching" carousel.
                    // The bridge inside animarr-player.js mirrors every
                    // progress tick to MAUI's WatchNextService → no-op on
                    // non-Android-TV hosts. Posting the meta here (not at
                    // attach()) means we have the resolved title and episode
                    // labels, not just the raw media item.
                    try
                    {
                        var watchNextMeta = new
                        {
                            mediaId   = _item.Id.ToString(),
                            title,
                            posterUrl = string.IsNullOrEmpty(artwork)
                                ? string.Empty
                                : new Uri(new Uri(Nav.BaseUri), artwork).ToString(),
                        };
                        await JS.InvokeVoidAsync("animarrPlayer.setWatchNextMeta",
                            _playerElementId, watchNextMeta);
                    }
                    catch { /* host doesn't speak Watch Next — silent */ }
                }
            }
            catch (Exception ex)
            {
                _playerSelfRef?.Dispose();
                _playerSelfRef = null;
                Console.Error.WriteLine($"animarrPlayer.attach failed: {ex.Message}");
            }
        }
    }

    /// <summary>"Previous episode" — lock-screen / Bluetooth prev-track, the HUD
    /// Prev button, and the MediaTrackPrevious remote key. Jumps to the nearest
    /// EARLIER on-disk episode (rolls back across a season boundary). No-op for
    /// movies or when nothing precedes the current episode.</summary>
    [JSInvokable]
    public Task InvokePrev()
    {
        if (_item is null) return Task.CompletedTask;
        var prev = PrevEpisodeOnDisk(_playerSeason, _playerEpisode);
        return prev is { } p ? PlayEpisodeAsync(p.Season, p.Episode) : Task.CompletedTask;
    }

    /// <summary>"Next episode" — lock-screen / Bluetooth next-track, the HUD Next
    /// button, the MediaTrackNext remote key, AND the end-of-episode auto-advance
    /// overlay. Jumps to the nearest LATER on-disk episode (rolls forward into
    /// the next season). No-op for movies or at the last available episode.</summary>
    [JSInvokable]
    public Task InvokeNext()
    {
        if (_item is null) return Task.CompletedTask;
        var next = NextEpisodeOnDisk(_playerSeason, _playerEpisode);
        return next is { } n ? PlayEpisodeAsync(n.Season, n.Episode) : Task.CompletedTask;
    }

    /// <summary>Nearest on-disk episode AFTER (season, episode), ordered by
    /// (season, episode) so it rolls into the next season's first file. Null when
    /// the current item is a movie (episode == null) or this is the last file.
    /// A file's null season counts as season 1 to match the episode grid.</summary>
    private (int Season, int Episode)? NextEpisodeOnDisk(int? season, int? episode)
    {
        if (episode is null) return null;
        var curS = season ?? 1;
        var curE = episode.Value;
        return _files
            .Where(f => f.Episode is not null)
            .Select(f => (Season: f.Season ?? 1, Episode: f.Episode!.Value))
            .Where(x => x.Season > curS || (x.Season == curS && x.Episode > curE))
            .OrderBy(x => x.Season).ThenBy(x => x.Episode)
            .Select(x => ((int Season, int Episode)?)x)
            .FirstOrDefault();
    }

    /// <summary>Nearest on-disk episode BEFORE (season, episode). Mirror of
    /// <see cref="NextEpisodeOnDisk"/> for the Prev action.</summary>
    private (int Season, int Episode)? PrevEpisodeOnDisk(int? season, int? episode)
    {
        if (episode is null) return null;
        var curS = season ?? 1;
        var curE = episode.Value;
        return _files
            .Where(f => f.Episode is not null)
            .Select(f => (Season: f.Season ?? 1, Episode: f.Episode!.Value))
            .Where(x => x.Season < curS || (x.Season == curS && x.Episode < curE))
            .OrderByDescending(x => x.Season).ThenByDescending(x => x.Episode)
            .Select(x => ((int Season, int Episode)?)x)
            .FirstOrDefault();
    }

    private async Task ClosePlayer()
    {
        try { await JS.InvokeVoidAsync("animarrPlayer.flush",  _playerElementId); } catch { }
        try { await JS.InvokeVoidAsync("animarrPlayer.detach", _playerElementId); } catch { }
        _playerSelfRef?.Dispose();
        _playerSelfRef = null;
        _playerPath = null;
        _playerSeason = null;
        _playerEpisode = null;
        _themeStarted = false;   // resume theme music on return to the detail view

        // Playback may have auto-marked an episode watched (≥90%) or moved the
        // resume point — refresh so the episode grid eyes + hero Continue CTA
        // reflect it without a full page reload.
        try { _watchStates = (await Api.GetWatchStatesAsync(Id)).ToList(); } catch { }
        try
        {
            _continue       = await Api.GetContinueAsync(Id);
            _continueAction = _continue is null ? null : ContinueAction.FromDto(_continue);
        }
        catch { }

        StateHasChanged();
    }

    [JSInvokable]
    public Task<double?> GetResumePositionSec()
    {
        if (_item is null) return Task.FromResult<double?>(null);
        var match = _watchStates.FirstOrDefault(w =>
            w.Season == _playerSeason && w.Episode == _playerEpisode);
        if (match?.ProgressMs is not > 0) return Task.FromResult<double?>(null);
        return Task.FromResult<double?>(match.ProgressMs.Value / 1000.0);
    }

    [JSInvokable]
    public async Task OnPlayerProgress(double positionSec, double durationSec, int playedDeltaSec)
    {
        if (_item is null || _playerPath is null) return;
        var now = DateTime.UtcNow;
        if ((now - _lastProgressWrite).TotalSeconds < 2) return;
        _lastProgressWrite = now;
        try
        {
            await Api.RecordProgressAsync(new RecordProgressRequest(
                MediaItemId: _item.Id,
                Season:      _playerSeason,
                Episode:     _playerEpisode,
                FilePath:    _playerPath,
                ProgressMs:  (long)(positionSec * 1000),
                RuntimeMs:   durationSec > 0 ? (long)(durationSec * 1000) : null));
        }
        catch { }
    }

    [JSInvokable] public async Task ClosePlayerFromJs() => await InvokeAsync(ClosePlayer);
    [JSInvokable] public Task ToggleCastMenuFromJs() => Task.CompletedTask;
    [JSInvokable] public Task<string> GetMpvDeepLink() =>
        Task.FromResult($"mpv://{ApiRoutes.File}?path={Uri.EscapeDataString(_playerPath ?? "")}");
    [JSInvokable] public Task ReceiveMediaInfo(System.Text.Json.JsonElement info) => Task.CompletedTask;

