    /// <summary>Hero ★ Favorite button — optimistic flip + server PATCH.
    /// Re-fetches the item afterwards so any per-user fields derived from
    /// favorites (e.g. category cards) stay in sync.</summary>
    private async Task ToggleFavoriteAsync()
    {
        if (_item is null) return;
        var nextState = !_item.IsFavorite;
        // Optimistic update — flip locally first so the star animates
        // instantly while the network round-trip happens.
        _item = _item with { IsFavorite = nextState };
        StateHasChanged();
        try
        {
            if (nextState) await Api.AddFavoriteAsync(_item.Id);
            else           await Api.RemoveFavoriteAsync(_item.Id);
        }
        catch
        {
            // Rollback on failure so the UI matches server reality.
            _item = _item with { IsFavorite = !nextState };
            StateHasChanged();
        }
    }

    private async Task ToggleEpisodeWatched(int season, int episode, bool watched)
    {
        if (_item is null) return;
        try
        {
            var updated = await Api.ToggleWatchedAsync(new ToggleWatchedRequest(
                MediaItemId: _item.Id,
                Season:      season,
                Episode:     episode,
                FilePath:    null,
                IsWatched:   watched));
            _watchStates.RemoveAll(w => w.Season == season && w.Episode == episode);
            _watchStates.Add(updated);

            // Marking an episode watched while earlier on-disk episodes are still
            // unwatched is almost always "I watched up to here" — offer to mark
            // the gap. Only on mark-watched (not un-mark), and only when there's
            // actually a gap to fill.
            if (watched)
            {
                _markPrevTargets = PreviousUnwatchedOnDisk(season, episode);
                _showMarkPrev    = _markPrevTargets.Count > 0;
            }
        }
        catch { }
        StateHasChanged();
    }

    /// <summary>Earlier on-disk episodes (across ALL seasons) that have no
    /// watched row yet, relative to the just-watched (season, episode). Ordered
    /// by (season, episode). Drives the "mark previous too?" popup. A file's
    /// null season counts as season 1 to match the episode grid's grouping.</summary>
    private List<(int Season, int Episode)> PreviousUnwatchedOnDisk(int season, int episode)
    {
        bool IsBefore(int s, int e) => s < season || (s == season && e < episode);

        var watched = _watchStates
            .Where(w => w.IsWatched && w.Episode is not null)
            .Select(w => (Season: w.Season ?? 1, Episode: w.Episode!.Value))
            .ToHashSet();

        return _files
            .Where(f => f.Episode is not null)
            .Select(f => (Season: f.Season ?? 1, Episode: f.Episode!.Value))
            .Where(x => IsBefore(x.Season, x.Episode) && !watched.Contains(x))
            .Distinct()
            .OrderBy(x => x.Season).ThenBy(x => x.Episode)
            .ToList();
    }

    private async Task ConfirmMarkPrevious()
    {
        if (_item is null || _markPrevTargets.Count == 0) { CancelMarkPrevious(); return; }
        try
        {
            var updated = await Api.MarkBulkWatchedAsync(new MarkBulkWatchedRequest(
                MediaItemId: _item.Id,
                Episodes:    _markPrevTargets.Select(t => new EpisodeRef(t.Season, t.Episode)).ToArray(),
                IsWatched:   true));
            foreach (var u in updated)
            {
                _watchStates.RemoveAll(w => w.Season == u.Season && w.Episode == u.Episode);
                _watchStates.Add(u);
            }
        }
        catch { }
        _showMarkPrev    = false;
        _markPrevTargets = new();
        StateHasChanged();
    }

    private void CancelMarkPrevious()
    {
        _showMarkPrev    = false;
        _markPrevTargets = new();
    }

    /// <summary>Primary-CTA label for the MovieFileCard.</summary>
    private static string MovieCtaLabel(WatchStateDto? w)
    {
        if (w is null) return "Play movie";
        if (w.IsWatched) return "Rewatch from start";
        if (w.ProgressMs is > 0) return "Continue";
        return "Play movie";
    }

    private static string MovieCtaIcon(WatchStateDto? w)
        => w?.IsWatched == true ? "refresh" : "play";

    private async Task ToggleMovieWatched(bool watched)
    {
        if (_item is null) return;
        try
        {
            var updated = await Api.ToggleWatchedAsync(new ToggleWatchedRequest(
                MediaItemId: _item.Id,
                Season:      null,
                Episode:     null,
                FilePath:    null,
                IsWatched:   watched));
            // Patch the movie's WatchState row so the card's eye + CTA label
            // reflect the new state immediately. The card binds to the row from
            // _watchStates (movieWatchDto), NOT _movieWatched — updating only the
            // latter left the button visually inert ("doesn't click").
            _watchStates.RemoveAll(w => w.Season is null && w.Episode is null);
            _watchStates.Add(updated);
            _movieWatched = watched;
        }
        catch { }
        StateHasChanged();
    }

    /// <summary>Start the soft theme-music autoplay when the user opted in and the
    /// title is anime (the only kind that resolves a theme). Silent no-op otherwise,
    /// including when autoplay is blocked until a user gesture — animarrTheme retries
    /// on the next pointerdown/keydown.</summary>
    private async Task StartThemeAsync()
    {
        if (_item is null) return;
        var prefs = UserCtx.Preferences;
        if (prefs is null || !prefs.ThemeMusicEnabled) return;
        bool animeLike = _item.MediaType == MediaItemType.Anime
            || _item.Genres.Any(g => string.Equals(g, "Animation", StringComparison.OrdinalIgnoreCase));
        if (!animeLike) return;
        var url = Animarr.UI.Services.MediaUrl.Theme(_item.Id);
        try { await JS.InvokeVoidAsync("animarrTheme.play", url, prefs.ThemeMusicVolume); }
        catch { /* host without animarrTheme — no-op */ }
    }

    private async Task StopThemeAsync()
    {
        try { await JS.InvokeVoidAsync("animarrTheme.stop"); }
        catch { /* no-op */ }
    }

    public async ValueTask DisposeAsync()
    {
        Animarr.UI.Services.MediaUrl.OnBaseChanged -= OnBaseChanged;
        await StopThemeAsync();
        if (_playerSelfRef is not null)
        {
            try { await JS.InvokeVoidAsync("animarrPlayer.detach", _playerElementId); } catch { }
            _playerSelfRef.Dispose();
        }
    }
}
