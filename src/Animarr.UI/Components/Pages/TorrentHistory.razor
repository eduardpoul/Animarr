@page "/torrents/history"
@inject IAnimarrApiClient Api
@inject NavigationManager Nav

<PageTitle>Animarr</PageTitle>

<div class="th-page">
@* Header + Active | History pivot are 1:1 with the Downloads page
   (Torrents.razor) so the two pages read as one surface. PageBack gives the
   same back button every other page has; the right-side button (and the
   pivot) jump to the active list. *@
<header class="th-head">
    <PageBack />
    <div class="th-head__main">
        <h1 class="th-head__title">@L["torrent_history.title"]</h1>
        <div class="th-head__sub">@L["torrent_history.page_sub"]</div>
    </div>
    @* The back_link label already starts with "←", so no extra chevron. *@
    <div class="th-head__actions">
        <Btn Variant="solid" Size="md" OnClick="@(() => Nav.NavigateTo("/torrents"))">
            @L["torrent_history.back_link"]
        </Btn>
    </div>
</header>

<nav class="th-pivot" aria-label="@L["torrents.page_title"]">
    <a href="torrents" class="th-pivot__item tv-focus">@L["torrents.tab_active"]</a>
    <a href="torrents/history" class="th-pivot__item is-active tv-focus" aria-current="page">@L["torrents.tab_history"]</a>
</nav>

@if (_loading)
{
    <div class="th-loading"><InlineDots Label="@L["torrent_history.loading_inline"]" /></div>
}
else if (_records.Count == 0)
{
    <div class="th-empty">
        <span class="th-empty__ic"><DIcon Name="history" Size="24" /></span>
        <div class="th-empty__text">@L["torrent_history.empty"]</div>
    </div>
}
else
{
    var paged = _records.Skip(_pageIndex * _pageSize).Take(_pageSize).ToList();
    var pageCount = (int)Math.Ceiling(_records.Count / (double)_pageSize);
    <div class="th-table-wrap">
        <table class="th-table">
            <thead>
                <tr>
                    <th>@L["torrent_history.col_name"]</th>
                    <th class="th-col-folder">@L["torrent_history.col_folder"]</th>
                    <th class="th-col-num">@L["torrent_history.col_size"]</th>
                    <th class="th-col-speed">@L["torrent_history.col_speed"]</th>
                    <th class="th-col-date">@L["torrent_history.col_added"]</th>
                    <th class="th-col-date">@L["torrent_history.col_completed"]</th>
                    <th class="th-col-status">@L["torrent_history.col_status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in paged)
                {
                    <tr>
                        <td class="th-name" title="@r.Name">@r.Name</td>
                        <td class="th-cell" title="@r.SavePath">
                            @System.IO.Path.GetFileName(r.SavePath.TrimEnd('/', '\\'))
                        </td>
                        <td class="th-cell th-cell--num">@FormatBytes(r.TotalSize)</td>
                        <td class="th-cell th-cell--num">@FormatBytes(r.Downloaded) / @FormatBytes(r.Uploaded)</td>
                        <td class="th-cell th-cell--num">@r.AddedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="th-cell th-cell--num">
                            @(r.CompletedAt.HasValue ? r.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")
                        </td>
                        <td class="th-col-status">
                            <span class="@($"th-badge th-badge--{StateColorClass(r.State)}")">@StateLabel(r.State)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pageCount > 1)
    {
        <div class="th-paginator">
            <Btn Variant="ghost" Size="sm" Disabled="@(_pageIndex == 0)" OnClick="@(() => { _pageIndex--; StateHasChanged(); })">
                <DIcon Name="chev-l" Size="16" />
            </Btn>
            <span class="th-paginator__label">@(_pageIndex + 1) / @pageCount</span>
            <Btn Variant="ghost" Size="sm" Disabled="@(_pageIndex >= pageCount - 1)" OnClick="@(() => { _pageIndex++; StateHasChanged(); })">
                <DIcon Name="chev-r" Size="16" />
            </Btn>
        </div>
    }
}
</div>

@code {
    private List<TorrentRecordDto> _records = new();
    private bool _loading = true;
    private int  _pageIndex;
    private const int _pageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Api.GetTorrentsAsync();
            _records = all
                .Where(r => r.State != TorrentRecordState.Downloading
                         && r.State != TorrentRecordState.Hashing)
                .OrderByDescending(r => r.AddedAt)
                .ToList();
        }
        catch { /* network blip */ }
        _loading = false;
    }

    private static string StateColorClass(TorrentRecordState state) => state switch
    {
        TorrentRecordState.Seeding     => "success",
        TorrentRecordState.Stopped     => "neutral",
        TorrentRecordState.Error       => "error",
        TorrentRecordState.Hashing     => "warning",
        TorrentRecordState.Downloading => "info",
        _                              => "neutral",
    };

    private string StateLabel(TorrentRecordState state) => state switch
    {
        TorrentRecordState.Seeding     => L["torrent_history.state_seeding"],
        TorrentRecordState.Stopped     => L["torrent_history.state_stopped"],
        TorrentRecordState.Error       => L["torrent_history.state_error"],
        TorrentRecordState.Paused      => L["torrent_history.state_paused"],
        TorrentRecordState.Hashing     => L["torrent_history.state_hashing"],
        TorrentRecordState.Downloading => L["torrent_history.state_downloading"],
        _                              => state.ToString(),
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F2} GB";
        if (bytes >= 1_048_576)     return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024)          return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }
}
