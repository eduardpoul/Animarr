@*
    TorrentEdit — right-edge SettingsEditDrawer (v5 panel refactor).

    Was a full /torrents/{hash}/edit page with a 2-column layout (file
    tree | sidebar cards). The @page directive is gone; the Torrents
    list now opens this component as a drawer instead of navigating.

    Body is a vertical stack at 560px drawer width:
      • Stats card  (progress bar, downloaded/total, live speed, peers, path)
      • Files       (priority list with Skip / Normal / High)
      • Speed       (DL / UL limits in MB/s)
      • Options     (toggles)

    Footer has the canonical Save + Cancel pair, with the danger Remove
    pushed to the right so it's separated from the affirmative actions.
*@

@implements IAsyncDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject Animarr.UI.Services.ServerAddressProvider ServerAddr

@using Microsoft.AspNetCore.SignalR.Client
@using Animarr.UI.Components.Design.Layout

<SettingsEditDrawer IsOpen="true"
                    Title="@(_record?.Name ?? Hash)"
                    Overline="TORRENT"
                    Hint="@(_live?.State is { } s ? $"State · {s}" : "Loading state…")"
                    Icon="torrent"
                    OnClose="OnCloseAsync">
    <Body>
        @if (_loading)
        {
            <div class="te-loading"><InlineDots Label="Loading torrent" /></div>
        }
        else if (_record is null)
        {
            <div class="te-empty">@L["torrent_edit.not_found"]</div>
        }
        else
        {
            var rec = _record!;

            @* ── STATS CARD ────────────────────────────────────────── *@
            <div class="te-card">
                <h3 class="te-card__title">@L["torrent_edit.stats_title"]</h3>
                <div class="te-stats">
                    @if (_live is not null)
                    {
                        <div class="te-stats__row">
                            <span class="te-stats__label">State</span>
                            <span class="te-stats__state">
                                <span class="@($"tor-dot tor-dot--{StateColorClass()}")"></span>
                                @_live.State
                            </span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(rec.ErrorMessage))
                    {
                        <div class="te-stats__error" title="@rec.ErrorMessage">
                            <DIcon Name="x" Size="12" /> @rec.ErrorMessage
                        </div>
                    }
                    <div class="te-stats__row">
                        <span class="te-stats__label">@L["torrent_edit.stat_progress"]</span>
                        <b>@(Progress.ToString("F1"))%</b>
                    </div>
                    <div class="animarr-progress te-stats__bar">
                        <div class="animarr-progress__track">
                            <div class="animarr-progress__fill"
                                 style="width:@(Progress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </div>
                    </div>
                    <div class="te-stats__row">
                        <span class="te-stats__label">@L["torrent_edit.stat_downloaded"]</span>
                        <span>@FormatBytes(rec.Downloaded) / @FormatBytes(rec.TotalSize)</span>
                    </div>
                    @if (_live is not null)
                    {
                        <div class="te-stats__row">
                            <span class="te-stats__label">@L["torrent_edit.stat_dl_speed"]</span>
                            <span>@FormatSpeed(_live.DownloadRate)</span>
                        </div>
                        <div class="te-stats__row">
                            <span class="te-stats__label">@L["torrent_edit.stat_ul_speed"]</span>
                            <span>@FormatSpeed(_live.UploadRate)</span>
                        </div>
                        <div class="te-stats__row">
                            <span class="te-stats__label">@L["torrent_edit.stat_peers"]</span>
                            <span>@L["torrent_details.seeds_label"] @_live.Seeds &nbsp; @L["torrent_details.peers_label"] @_live.Peers</span>
                        </div>
                    }
                    <hr class="te-hr" />
                    <div class="te-stats__path">
                        <div>@L["torrent_edit.path_label"] @rec.SavePath</div>
                        <div class="te-stats__hash">@L["torrent_edit.hash_label"] @rec.InfoHash[..Math.Min(20, rec.InfoHash.Length)]…</div>
                    </div>
                </div>
            </div>

            @* ── FILE SELECTIONS ───────────────────────────────────── *@
            <div class="te-card">
                <h3 class="te-card__title">
                    @L["torrent_edit.files_title"] (@_files.Count)
                </h3>
                @if (_files.Count == 0)
                {
                    <div class="te-files-empty">
                        Files will appear here once the torrent's metadata has downloaded.
                    </div>
                }
                else
                {
                    <div class="te-tree">
                        <TorrentFileTreeEditor Files="@_fileItems"
                                               Priorities="@_priorities"
                                               Progress="@_fileProgress"
                                               OnChanged="StateHasChanged" />
                    </div>
                }
            </div>

            @* ── SPEED LIMITS ──────────────────────────────────────── *@
            <div class="te-card">
                <h3 class="te-card__title">@L["torrent_edit.speed_title"]</h3>
                <label class="te-field">
                    <span class="te-field__label">@L["torrent_edit.dl_limit_label"]</span>
                    <input type="number" min="0" class="te-input"
                           value="@_dlLimit"
                           @onchange="@(e => int.TryParse(e.Value?.ToString(), out _dlLimit))" />
                </label>
                <label class="te-field">
                    <span class="te-field__label">@L["torrent_edit.ul_limit_label"]</span>
                    <input type="number" min="0" class="te-input"
                           value="@_ulLimit"
                           @onchange="@(e => int.TryParse(e.Value?.ToString(), out _ulLimit))" />
                </label>
            </div>

            @* ── OPTIONS ───────────────────────────────────────────── *@
            <div class="te-card">
                <h3 class="te-card__title">@L["torrent_edit.options_title"]</h3>
                <div class="te-toggle-row">
                    <Toggle Checked="@_stopAfterDownload"
                            CheckedChanged="@((bool v) => { _stopAfterDownload = v; })" />
                    <span class="te-toggle-row__label">@L["torrent_edit.stop_after_download"]</span>
                </div>
                <div class="te-toggle-row te-toggle-row--disabled">
                    <Toggle Checked="@_skipSubfolderStructure" Disabled="true"
                            CheckedChanged="@((bool _) => {})" />
                    <span class="te-toggle-row__label">@L["torrent_edit.flatten_subfolders"]</span>
                </div>
            </div>
        }
    </Body>
    <Footer>
        <Btn Variant="primary" Size="md" Disabled="@(_saving || _record is null)" OnClick="SaveAllAsync">
            <DIcon Name="check" Size="13" />
            @(_saving ? L["torrent_edit.btn_saving"] : L["torrent_edit.btn_save"])
        </Btn>
        <Btn Variant="ghost" Size="md" OnClick="OnCloseAsync">Cancel</Btn>
        <div class="te-footer__spacer"></div>
        @if (_record is not null)
        {
            <Btn Variant="ghost" Size="md" Loading="@_rechecking" OnClick="RecheckTorrentAsync">
                <DIcon Name="refresh" Size="13" /> Recheck
            </Btn>
            <Btn Variant="danger" Size="md" OnClick="DeleteAsync">
                <DIcon Name="trash" Size="13" /> Remove
            </Btn>
        }
    </Footer>
</SettingsEditDrawer>

@code {
    /// <summary>InfoHash of the torrent to edit. Drawer reloads when this
    /// parameter changes so the parent can swap between torrents without
    /// remounting.</summary>
    [Parameter, EditorRequired] public string Hash { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Fired after a successful Remove. Parent uses this to refresh
    /// the torrent list and close the drawer.</summary>
    [Parameter] public EventCallback OnDeleted { get; set; }

    private TorrentRecordDto? _record;
    private TorrentLiveStatsDto? _live;
    private bool _loading = true;
    private bool _saving;
    private bool _rechecking;
    private bool _stopAfterDownload;
    private bool _skipSubfolderStructure;
    private int _dlLimit;
    private int _ulLimit;
    private Dictionary<string, int> _priorities = new();
    private List<TorrentFileNodeDto> _files = new();
    private List<TorrentFileTreeEditor.FileItem> _fileItems = new();
    private Dictionary<string, double> _fileProgress = new();
    private bool _refreshingProgress;
    private HubConnection? _hub;
    private string? _loadedHash;

    private double Progress => _live?.Progress * 100
        ?? (_record is { TotalSize: > 0 } r ? 100.0 * r.Downloaded / r.TotalSize : 0);

    protected override async Task OnInitializedAsync()
    {
        // Load the record + file tree FIRST. The live-stats hub connects in the
        // background — never block the drawer on it. (Under MAUI the hub could
        // hang/slow on a bad origin; the drawer must still open + show data.)
        await LoadAsync();
        _loadedHash = Hash;
        _ = ConnectHubAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload when the parent swaps the Hash without remounting us.
        if (_loadedHash is not null && _loadedHash != Hash)
        {
            _loadedHash = Hash;
            _record = null;
            _live = null;
            _loading = true;
            StateHasChanged();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            // The Hash param uses InfoHash; resolve via the torrent list so we
            // get the Guid + persisted settings + file selections in one call.
            var torrents = await Api.GetTorrentsAsync();
            _record = torrents.FirstOrDefault(t => string.Equals(t.InfoHash, Hash, StringComparison.OrdinalIgnoreCase));
            if (_record is not null)
            {
                _stopAfterDownload       = _record.StopAfterDownload;
                _skipSubfolderStructure  = _record.SkipSubfolderStructure;
                _dlLimit                 = _record.DownloadLimit / 125_000;
                _ulLimit                 = _record.UploadLimit / 125_000;
                // Load the FULL file list (every file + size + current priority)
                // from the file-tree endpoint. _record.FileSelections only holds
                // files with a persisted non-default selection — empty for most
                // torrents — which is why the list used to show nothing.
                try
                {
                    var tree = await Api.GetTorrentFileTreeAsync(_record.Id);
                    _files = tree.Children ?? new();
                }
                catch { _files = new(); }
                _priorities   = _files.ToDictionary(f => f.Path, f => f.Priority);
                _fileItems    = _files.Select(f => new TorrentFileTreeEditor.FileItem(f.Path, f.Size)).ToList();
                _fileProgress = _files.ToDictionary(f => f.Path, f => f.Progress);
            }
        }
        catch { /* offline */ }
        _loading = false;
        StateHasChanged();
    }

    /// <summary>Re-pull just the per-file progress while a torrent downloads.
    /// Touches ONLY <see cref="_fileProgress"/> so the user's unsaved priority
    /// edits in the tree survive each live tick. Guarded against overlap.</summary>
    private async Task RefreshFileProgressAsync()
    {
        if (_refreshingProgress || _record is null) return;
        _refreshingProgress = true;
        try
        {
            var tree = await Api.GetTorrentFileTreeAsync(_record.Id);
            var map = (tree.Children ?? new()).ToDictionary(f => f.Path, f => f.Progress);
            if (map.Count > 0)
            {
                _fileProgress = map;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* transient — keep the last good progress */ }
        finally { _refreshingProgress = false; }
    }

    private async Task ConnectHubAsync()
    {
        // Build from the REAL server authority (ServerAddressProvider), not
        // Nav.BaseUri — under MAUI the BlazorWebView origin is https://0.0.0.0/
        // (Android) / 0.0.0.1 (Windows) and never reaches the hub, so StartAsync
        // would hang/fail there. Fall back to the current page authority on WASM.
        var authority = ServerAddr.Current?.GetLeftPart(UriPartial.Authority);
        if (string.IsNullOrEmpty(authority))
            authority = new Uri(Nav.Uri).GetLeftPart(UriPartial.Authority);
        var hubUri = new Uri(authority.TrimEnd('/') + ApiRoutes.HubTorrents);
        _hub = new HubConnectionBuilder().WithUrl(hubUri).WithAutomaticReconnect().Build();
        _hub.On<TorrentSnapshotEnvelope>(TorrentHubMethods.LiveSnapshot, env =>
        {
            var live = env.Items.FirstOrDefault(s =>
                string.Equals(s.InfoHash, Hash, StringComparison.OrdinalIgnoreCase));
            if (live is not null)
            {
                _live = live;
                InvokeAsync(StateHasChanged);
                // Live per-file progress while downloading. Updates ONLY the
                // progress map (not _priorities/_fileItems) so unsaved priority
                // edits survive the tick.
                if (live.State is "Downloading" or "Metadata")
                    _ = RefreshFileProgressAsync();
            }
        });
        try { await _hub.StartAsync(); } catch { /* hub unavailable */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }

    /// <summary>Single Save that commits file priorities AND speed limits in
    /// one go — the drawer footer collapses the two old separate "Save"
    /// buttons (priorities vs. apply) into one affirmative action.</summary>
    private async Task SaveAllAsync()
    {
        if (_record is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var updates = _priorities
                .Select(kv => new TorrentFileSelectionUpdate(kv.Key, kv.Value))
                .ToArray();
            await Api.UpdateTorrentFileSelectionsAsync(_record.Id, new UpdateFileSelectionsRequest(updates));

            await Api.UpdateTorrentAsync(_record.Id, new UpdateTorrentRequest(
                FolderWatcherId:        _record.FolderWatcherId,
                StopAfterDownload:      _stopAfterDownload,
                DownloadLimit:          _dlLimit * 125_000,
                UploadLimit:            _ulLimit * 125_000,
                StopSeedingRatio:       _record.StopSeedingRatio,
                SkipSubfolderStructure: _skipSubfolderStructure,
                SuppressRootFolder:     _record.SuppressRootFolder,
                CustomRootFolderName:   _record.CustomRootFolderName));
            await LoadAsync();
        }
        catch { /* swallow */ }
        finally { _saving = false; StateHasChanged(); }
    }

    private async Task RecheckTorrentAsync()
    {
        if (_record is null) return;
        _rechecking = true;
        StateHasChanged();
        try
        {
            // Re-hash against on-disk data + resume. Fixes a stuck Error torrent
            // and corrects stale per-file progress.
            await Api.RecheckTorrentAsync(_record.Id);
            await LoadAsync();
        }
        catch { /* swallow — state will refresh from the hub */ }
        finally { _rechecking = false; StateHasChanged(); }
    }

    private async Task DeleteAsync()
    {
        if (_record is null) return;
        try
        {
            await Api.DeleteTorrentAsync(_record.Id, deleteFiles: false);
            await OnDeleted.InvokeAsync();
        }
        catch { /* swallow */ }
    }

    private string StateColorClass() => _live?.State switch
    {
        "Downloading" => "info",
        "Metadata"    => "info",
        "Seeding"     => "success",
        "Paused"      => "warning",
        "Stopped"     => "neutral",
        "Error"       => "error",
        "Hashing"     => "info",
        _             => "neutral",
    };

    private static string FormatSpeed(long bps)
    {
        if (bps >= 1_048_576) return $"{bps / 1_048_576.0:F1} MB/s";
        if (bps >= 1024)      return $"{bps / 1024.0:F0} KB/s";
        return $"{bps} B/s";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F2} GB";
        if (bytes >= 1_048_576)     return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024)          return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }

    private async Task OnCloseAsync() => await OnClose.InvokeAsync();
}
