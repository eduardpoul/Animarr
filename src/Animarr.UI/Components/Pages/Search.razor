@*
    /search — full-page library search. Free-text input at the top filters
    the catalog grid below in real time as the user types. Replaces the
    cramped "Filter by title" input that used to live at the bottom of the
    Catalog page.

    Same de-dup + multi-language title matching the Home page used to do
    (Title / OriginalTitle / EnglishTitle / CjkTitle). Posters and the
    visual treatment are the same primitives so the grid feels continuous
    with the Catalog.

    The page fetches the full library once on mount (10k cap, same as
    Home). All filtering happens client-side — no per-keystroke API call.
*@

@page "/search"
@implements IDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Animarr</PageTitle>

<div class="search-page d-page">
    <PageHeader Title="@L["search.title"]" />
    <header class="search-page__head">

        <div class="search-page__input-wrap">
            <DIcon Name="search" Size="16" />
            <input id="search-page-input"
                   class="search-page__input"
                   type="search"
                   value="@_query"
                   placeholder="@L["search.placeholder"]"
                   autocomplete="off"
                   spellcheck="false"
                   @oninput="OnQueryInput"
                   @ref="_inputRef" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button type="button" class="search-page__clear tv-focus"
                        @onclick="ClearQuery" aria-label="@L["search.btn_clear"]">
                    <DIcon Name="x" Size="14" />
                </button>
            }
        </div>

        <div class="search-page__count">
            @if (!string.IsNullOrWhiteSpace(_appliedQuery))
            {
                @_filtered.Count<span class="search-page__count-sep">/</span>@_allItems.Count
            }
            else
            {
                @_allItems.Count
            }
            <span class="search-page__count-label">@L["search.results_label"]</span>
        </div>
    </header>

    @if (_loading)
    {
        @* Same indeterminate-stripe loader as /home — the poster grid skeleton
           used to read like an empty library while items were still in flight. *@
        <div class="animarr-progress">
            <div class="animarr-progress__track">
                <div class="animarr-progress__fill animarr-progress__fill--indeterminate"></div>
            </div>
        </div>
    }
    else if (_allItems.Count == 0)
    {
        <div class="catalog-empty">
            <DIcon Name="video" Size="48" />
            <div class="catalog-empty__text">@L["search.empty_library"]</div>
        </div>
    }
    else if (_filtered.Count == 0 && !string.IsNullOrWhiteSpace(_appliedQuery))
    {
        <div class="catalog-empty">
            <DIcon Name="search" Size="48" />
            <div class="catalog-empty__text">@L.Get("search.no_matches", _appliedQuery)</div>
        </div>
    }
    else
    {
        <div class="catalog-grid">
            @* Cap to 240 like Home — typing narrows it well before the cap.
               @key (Ids unique — _allItems is de-duplicated by Id) so a narrowed
               result keeps its cards instead of re-feeding every position. *@
            @foreach (var item in _filtered.Take(240))
            {
                <Poster @key="item.Id" Item="@item" />
            }
        </div>
        @if (_filtered.Count > 240)
        {
            <div class="catalog-more">
                @L.Get("catalog.shown_of_total", 240, _filtered.Count)
            </div>
        }
    }
</div>

@code {
    private List<MediaItemDto> _allItems = new();
    private List<MediaItemDto> _filtered = new();
    private bool _loading = true;
    private string _query = "";
    /// <summary>The query <see cref="_filtered"/> (and the count / "no
    /// matches" line) reflects — trails <see cref="_query"/> by the debounce
    /// while the user types.</summary>
    private string _appliedQuery = "";
    private CancellationTokenSource? _debounce;
    private const int DebounceMs = 250;
    private ElementReference _inputRef;
    private bool _inputFocused;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await Api.GetMediaItemsAsync(new MediaListQuery { Take = 10000, Sort = "title", View = MediaListQuery.CardView });
            // Same de-dup ladder as Home — by Id first, then by (title, year)
            // so a duplicate folder doesn't render twice in the result list.
            _allItems = items
                .GroupBy(m => m.Id)
                .Select(g => g.First())
                .GroupBy(m => (m.Title?.Trim().ToLowerInvariant() ?? "", m.Year))
                .Select(g => g.First())
                .ToList();
            // Not `_filtered = _allItems`: the input is live (and autofocused)
            // while this loads — keep whatever the user already typed.
            Refilter();
        }
        catch { /* offline — empty grid */ }
        _loading = false;
    }

    /// <summary>Auto-focus the input on first paint so the user can start
    /// typing immediately. Only runs once — subsequent renders (from query
    /// changes) shouldn't steal focus while the user is typing.
    ///
    /// Skip the auto-focus when html.tv-mode is on: the spatial navigator
    /// (tv-nav.js) bails inside <input> elements so it can leave arrow keys
    /// to cursor movement, which means a TV-remote user auto-focused into
    /// the search box can't D-pad out — they're stuck unless they happen
    /// to know Esc / Back closes the surrounding nothing. On TV the user
    /// arrows down to the input on purpose, hits OK, then the platform IME
    /// (Android TV's leanback keyboard, webOS's on-screen kbd) takes
    /// over.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_inputFocused)
        {
            _inputFocused = true;
            bool isTv = false;
            try
            {
                isTv = await JS.InvokeAsync<bool>("eval",
                    "document.documentElement.classList.contains('tv-mode')");
            }
            catch { }
            if (!isTv)
            {
                try { await _inputRef.FocusAsync(); } catch { /* ref not yet bound — let the user click */ }
            }
        }
    }

    /// <summary>Keystrokes are debounced: each one used to refilter the whole
    /// library and re-render up to 240 cards. The typed text is kept in
    /// <see cref="_query"/> immediately — so the post-load Refilter (input is
    /// live while the catalog loads) and any re-render never drop it — and
    /// the grid follows once typing pauses for <see cref="DebounceMs"/>.</summary>
    private void OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        _ = RefilterAfterPauseAsync(_debounce.Token);
    }

    private async Task RefilterAfterPauseAsync(CancellationToken ct)
    {
        try { await Task.Delay(DebounceMs, ct); }
        catch (OperationCanceledException) { return; }
        await InvokeAsync(() =>
        {
            Refilter();   // reads the latest _query, whatever was typed meanwhile
            StateHasChanged();
        });
    }

    private void ClearQuery()
    {
        _debounce?.Cancel();
        _query = "";
        Refilter();
        InvokeAsync(async () =>
        {
            try { await _inputRef.FocusAsync(); } catch { }
        });
    }

    private void Refilter()
    {
        _appliedQuery = _query;
        if (string.IsNullOrWhiteSpace(_query))
        {
            _filtered = _allItems;
            return;
        }
        var q = _query.Trim();
        _filtered = _allItems
            .Where(m =>
                m.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (m.OriginalTitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.EnglishTitle?.Contains(q, StringComparison.OrdinalIgnoreCase)  ?? false) ||
                (m.CjkTitle?.Contains(q, StringComparison.OrdinalIgnoreCase)      ?? false))
            .ToList();
    }

    public void Dispose()
    {
        // No subscriptions — just a pending debounced refilter to drop.
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
