@implements IAsyncDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject Animarr.UI.Services.ServerAddressProvider ServerAddr

@using Microsoft.AspNetCore.SignalR.Client

@*
    Catalog filter-bar chip that opens the NeedsReview modal inline.

    Server-side equivalent used IdentificationQueueProcessorService.ItemIdentified
    to refresh the count whenever an item was identified. The WASM/MAUI version
    subscribes to the IdentificationHub which forwards the same event, plus
    listens for the NeedsReviewCountChanged push for direct count updates.
*@

@if (_count > 0)
{
    <button type="button" class="@($"nr-chip {(Compact ? "nr-chip--compact" : "")}")" @onclick="@(() => _open = true)" title="@L.Get("needs_review.chip_title_fmt", _count)">
        <DIcon Name="warn" Size="16" />
        <span class="nr-chip__label">@L["needs_review.overline"] ·</span>
        <span class="nr-chip__count">@_count</span>
        <span class="nr-chip__dot"></span>
    </button>
}

<NeedsReviewDialog IsOpen="_open" OnClose="OnDialogClose" />

@code {
    /// <summary>Compact topbar variant — hides the "Needs review" label + corner
    /// dot and renders as a small amber pill (warn icon + count) so it can sit
    /// next to the LLM pill. Default false = the full labelled chip.</summary>
    [Parameter] public bool Compact { get; set; }

    private int  _count;
    private bool _open;
    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCountAsync();
        await ConnectHubAsync();
    }

    private async Task RefreshCountAsync()
    {
        try
        {
            // Count only — the dialog loads the items (with candidates) itself.
            _count = await Api.GetNeedsReviewCountAsync();
        }
        catch { /* network blip — keep last value */ }
    }

    private async Task ConnectHubAsync()
    {
        var hubUri = ServerAddr.HubUri(Nav.Uri, ApiRoutes.HubIdentification);
        _hub = Animarr.UI.Services.AnimarrHub.Build(hubUri);

        _hub.On<NeedsReviewCountEnvelope>(
            IdentificationHubMethods.NeedsReviewCountChanged,
            env => InvokeAsync(() =>
            {
                _count = env.Count;
                StateHasChanged();
                return Task.CompletedTask;
            }));

        try { await _hub.StartAsync(); }
        catch { /* hub not available — chip still works on next OnInitialized */ }
    }

    private async Task OnDialogClose()
    {
        _open = false;
        await RefreshCountAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
