@*
    Section folder Add / Edit dialog — inline modal used by Settings → Root folders.

    The server-side version included a filesystem picker that called
    Directory.GetDirectories — that won't work in WASM/MAUI where the
    client has no access to the server's filesystem. This trimmed version
    keeps the text input + Save / Cancel — folder browsing can land later
    as a server-side endpoint (GET /api/folders/browse?path=...).
*@

@inject IAnimarrApiClient Api

<div class="sfd-overlay" @onclick="CancelAsync"></div>
<div class="sfd" role="dialog" aria-modal="true" @onclick:stopPropagation>
    <header class="sfd__header">
        <div class="sfd__header-text">
            <div class="sfd__overline">SETTINGS</div>
            <h2 class="sfd__title">@(Existing is null ? L["settings.root_folders.add_title"] : L["settings.root_folders.edit_title"])</h2>
            <div class="sfd__sub">@L["settings.root_folders.dialog_sub"]</div>
        </div>
        <button type="button" class="sfd__close" @onclick="CancelAsync" aria-label="Close">
            <DIcon Name="x" Size="18" />
        </button>
    </header>

    <div class="sfd__body">
        <label class="settings-field">
            <span class="settings-field__label">@L["settings.root_folders.field_title"]</span>
            <input class="settings-field__input"
                   placeholder="@L["settings.root_folders.field_title_placeholder"]"
                   value="@_title"
                   @oninput="@(e => _title = e.Value?.ToString() ?? "")" />
        </label>

        <label class="settings-field">
            <span class="settings-field__label">@L["settings.root_folders.field_path"]</span>
            <input class="settings-field__input settings-field__input--mono"
                   placeholder="@L["settings.root_folders.field_path_placeholder"]"
                   value="@_path"
                   @oninput="@(e => _path = e.Value?.ToString() ?? "")" />
        </label>

        <label class="settings-field settings-field--240">
            <span class="settings-field__label">@L["settings.root_folders.field_type"]</span>
            <select class="settings-field__select"
                    value="@_typeStr"
                    @onchange="@(e => _typeStr = e.Value?.ToString() ?? "Auto")">
                <option value="Auto">@L["settings.root_folders.type_auto"]</option>
                <option value="Series">@L["settings.root_folders.type_series"]</option>
                <option value="Movie">@L["settings.root_folders.type_movie"]</option>
            </select>
        </label>
    </div>

    <footer class="sfd__footer">
        <Btn Variant="primary" Size="md" OnClick="SaveAsync"
             Loading="@_saving"
             Disabled="@(string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_path))">
            @L["settings.root_folders.btn_save"]
        </Btn>
        <Btn Variant="ghost" Size="md" OnClick="CancelAsync">
            @L["settings.root_folders.btn_cancel"]
        </Btn>
    </footer>
</div>

@code {
    [Parameter] public FolderWatcherDto? Existing { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCanceled { get; set; }

    private string _title = "";
    private string _path = "";
    private string _typeStr = "Auto";
    private bool _saving;

    protected override void OnParametersSet()
    {
        if (Existing is not null)
        {
            _title   = Existing.Label;
            _path    = Existing.Path;
            _typeStr = Existing.FolderType.ToString();
        }
        else
        {
            _title   = "";
            _path    = "";
            _typeStr = "Auto";
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_path)) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var folderType = Enum.TryParse<FolderType>(_typeStr, out var ft) ? ft : FolderType.Auto;

            if (Existing is null)
            {
                await Api.CreateFolderAsync(new CreateFolderRequest(
                    Path:            _path.Trim(),
                    Label:           _title.Trim(),
                    FolderType:      folderType,
                    IsSection:       true,
                    FlatSection:     false,
                    WatchEnabled:    true,
                    RenameEnabled:   true,
                    IdentifyEnabled: true,
                    Hue:             HueHash.For(_title.Trim()),
                    BackdropPath:    null));
            }
            else
            {
                await Api.UpdateFolderAsync(Existing.Id, new UpdateFolderRequest(
                    Label:           _title.Trim(),
                    FolderType:      folderType,
                    WatchEnabled:    Existing.WatchEnabled,
                    RenameEnabled:   Existing.RenameEnabled,
                    IdentifyEnabled: Existing.IdentifyEnabled,
                    Hue:             Existing.Hue,
                    BackdropPath:    Existing.BackdropPath));
            }
            await OnSaved.InvokeAsync();
        }
        catch { /* TODO: surface via toast once that's wired up */ }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task CancelAsync() => await OnCanceled.InvokeAsync();
}
