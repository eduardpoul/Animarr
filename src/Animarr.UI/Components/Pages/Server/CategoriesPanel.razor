@*
    Settings → Categories (Fluent 2 settings page).

    User-curated taxonomy for the catalog chip strip. Seven built-in
    categories ship by default (Movies / Serials / Anime / Donghua / Dorama /
    Multi / Kids). Built-in entries cannot have their Name changed and cannot
    be deleted, but the Enabled flag and SortOrder can be toggled.

    Custom categories: admin enters a Name + Description + Hint, the LLM
    classifier uses the Hint at identification time to decide which items
    belong to the category. After adding a new category the admin should
    click "Rescan all" to back-fill existing media.
*@

@inject IAnimarrApiClient Api
@inject ToastService Toasts

<SettingsGroup Description="@L["categories.subtitle"]">
    <Actions>
        <Btn Variant="solid" OnClick="RescanAsync" Loading="@_rescanning">
            @if (!_rescanning) { <DIcon Name="refresh" Size="16" /> }
            @(_rescanning ? L["categories.btn_rescanning"] : L["categories.btn_rescan_all"])
        </Btn>
        <Btn Variant="primary" OnClick="StartAdd">
            <DIcon Name="plus" Size="16" /> @L["categories.btn_new"]
        </Btn>
    </Actions>
    <ChildContent>
        @if (_loading)
        {
            <div class="cat-loading"><Spinner Size="md" /></div>
        }
        else
        {
            @foreach (var c in _categories.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
            {
                var cat = c;
                <SettingsCard Icon="tag" Title="@cat.Name" Description="@cat.Description"
                              Tone="@(cat.Enabled ? null : "muted")">
                    <Extra>
                        @if (!string.IsNullOrEmpty(cat.Hint))
                        {
                            <span class="cat-hint" title="@($"{L["categories.hint_tooltip"]}: {cat.Hint}")">
                                <DIcon Name="sparkle" Size="12" /> @cat.Hint
                            </span>
                        }
                    </Extra>
                    <ChildContent>
                        <span class="cat-count">@L.Get("categories.item_count_fmt", cat.ItemCount)</span>
                        @if (cat.BuiltIn)
                        {
                            <Pill Tone="default">@L["categories.badge_builtin"]</Pill>
                        }
                        <button type="button" class="fs-icon-btn tv-focus"
                                title="@L["categories.action_edit"]" aria-label="@L["categories.action_edit"]"
                                @onclick="@(() => StartEdit(cat))">
                            <DIcon Name="pencil" Size="16" />
                        </button>
                        @if (!cat.BuiltIn)
                        {
                            <button type="button" class="fs-icon-btn fs-icon-btn--danger tv-focus"
                                    title="@L["categories.action_delete"]" aria-label="@L["categories.action_delete"]"
                                    @onclick="@(() => DeleteAsync(cat.Id))">
                                <DIcon Name="trash" Size="16" />
                            </button>
                        }
                        <Toggle Checked="cat.Enabled"
                                CheckedChanged="@(v => ToggleEnabledAsync(cat, v))" />
                    </ChildContent>
                </SettingsCard>
            }
        }
    </ChildContent>
</SettingsGroup>

<div class="fs-msgbar fs-msgbar--info cat-note">
    <span class="fs-msgbar__ic"><DIcon Name="info" Size="16" /></span>
    <span>@L["categories.rescan_hint"]</span>
</div>

<SettingsEditDrawer IsOpen="@_drawerOpen"
                    Title="@(_editingId is null ? L["categories.drawer_title_create"] : L.Get("categories.drawer_title_edit", _editName))"
                    Overline="@L["categories.drawer_overline"]"
                    Hint="@(_editingId is null
                            ? L["categories.drawer_hint_create"]
                            : L["categories.drawer_hint_edit"])"
                    Icon="tag"
                    OnClose="CancelEdit">
    <Body>
        <div class="cat-form">
            <div class="cat-form__row">
                <Input Value="@_editName" ValueChanged="@(v => _editName = v ?? "")"
                       Label="@L["categories.field_name"]" Placeholder="@L["categories.field_name_placeholder"]"
                       Disabled="@(_editingId is not null && _categories.FirstOrDefault(c => c.Id == _editingId)?.BuiltIn == true)" />
                <Input Value="@_editSortOrder.ToString()"
                       ValueChanged="@(v => int.TryParse(v, out _editSortOrder))"
                       Label="@L["categories.field_sort_order"]" Type="number" />
            </div>
            <Input Value="@_editDescription" ValueChanged="@(v => _editDescription = v ?? "")"
                   Label="@L["categories.field_description"]" Placeholder="@L["categories.field_description_placeholder"]" />
            <label class="d-input-group">
                <span class="d-input-group__label">@L["categories.field_hint"]</span>
                <textarea class="fs-input cat-textarea" rows="6"
                          @bind="_editHint"
                          placeholder="@L["categories.field_hint_placeholder"]"></textarea>
            </label>
        </div>
    </Body>
    <Footer>
        <Btn Variant="primary" Size="md" OnClick="SaveAsync">
            @(_editingId is null ? L["categories.btn_create"] : L["categories.btn_save_changes"])
        </Btn>
        <Btn Variant="ghost" Size="md" OnClick="CancelEdit">@L["common.btn_cancel"]</Btn>
    </Footer>
</SettingsEditDrawer>

@code {
    private CategoryDto[] _categories = Array.Empty<CategoryDto>();
    private bool _loading = true;
    private bool _rescanning;

    private Guid? _editingId;
    private string _editName = "";
    private string _editDescription = "";
    private string _editHint = "";
    private int    _editSortOrder = 100;
    /// <summary>True while the SettingsEditDrawer is visible. Decoupled from
    /// <c>_adding</c> so a closed-drawer-but-half-typed state can't accidentally
    /// show stale form values when the user clicks New again.</summary>
    private bool   _drawerOpen;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _categories = await Api.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(L.Get("categories.toast_load_failed", ex.Message));
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task ToggleEnabledAsync(CategoryDto cat, bool enabled)
    {
        try
        {
            await Api.UpdateCategoryAsync(cat.Id, new UpdateCategoryRequest(
                null, null, null, null, Enabled: enabled));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(L.Get("categories.toast_toggle_failed", ex.Message));
        }
    }

    private void StartAdd()
    {
        _editingId = null;
        _editName = "";
        _editDescription = "";
        _editHint = "";
        _editSortOrder = (_categories.Length + 1) * 10;
        _drawerOpen = true;
    }

    private void StartEdit(CategoryDto cat)
    {
        _editingId = cat.Id;
        _editName = cat.Name;
        _editDescription = cat.Description ?? "";
        _editHint = cat.Hint ?? "";
        _editSortOrder = cat.SortOrder;
        _drawerOpen = true;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _drawerOpen = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName))
        {
            Toasts.ShowWarning(L["categories.toast_name_required"]);
            return;
        }
        try
        {
            if (_editingId is Guid id)
            {
                await Api.UpdateCategoryAsync(id, new UpdateCategoryRequest(
                    Name: _editName.Trim(),
                    Description: _editDescription,
                    Hint: _editHint,
                    SortOrder: _editSortOrder,
                    Enabled: null));
                Toasts.ShowSuccess(L["categories.toast_updated"]);
            }
            else
            {
                await Api.CreateCategoryAsync(new CreateCategoryRequest(
                    Name: _editName.Trim(),
                    Description: _editDescription,
                    Hint: _editHint,
                    SortOrder: _editSortOrder));
                Toasts.ShowSuccess(L["categories.toast_created"]);
            }
            CancelEdit();
            _drawerOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(L.Get("categories.toast_save_failed", ex.Message));
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await Api.DeleteCategoryAsync(id);
            Toasts.ShowSuccess(L["categories.toast_deleted"]);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError(L.Get("categories.toast_delete_failed", ex.Message));
        }
    }

    private async Task RescanAsync()
    {
        if (_rescanning) return;
        _rescanning = true;
        StateHasChanged();
        try
        {
            await Api.RescanCategoriesAsync();
            Toasts.ShowSuccess(L["categories.toast_rescan_started"]);
        }
        catch (Exception ex)
        {
            Toasts.ShowError(L.Get("categories.toast_rescan_failed", ex.Message));
        }
        _rescanning = false;
        StateHasChanged();
    }
}
