@*
    Settings → About (Fluent 2, Windows 11 "System › About" layout).

    Version (with the build's commit) and the server's name come from
    /api/server/info on the bound server, not from hardcoded constants —
    admins moving between builds shouldn't have to grep the source to know
    what's running.
*@

@inject IAnimarrApiClient Api
@inject NavigationManager Nav

<div class="ab-head">
    <BrandMark Size="48" />
    <div class="ab-head__text">
        <div class="ab-head__name">Animarr</div>
        <div class="ab-head__sub">@L["about.subtitle"]</div>
    </div>
</div>

<SettingsGroup>
    <SettingsCard Icon="info" Title="@L["about.specs_title"]" Description="@VersionLabel"
                  Expandable="true" Expanded="true" Body="@Specs()" />
</SettingsGroup>

<SettingsGroup Title="@L["about.integrations_title"]">
    <SettingsCard Icon="key" Title="@L["about.dashboard_key_title"]"
                  Description="@L["about.dashboard_key_desc"]"
                  Body="@DashboardKeyBody()">
        <Btn Variant="@(_dashKey is null ? "primary" : "solid")" Loading="_dashBusy" OnClick="RegenerateDashboardKeyAsync">
            @(_dashKey is null ? L["about.dashboard_key_generate"] : L["about.dashboard_key_regenerate"])
        </Btn>
    </SettingsCard>
</SettingsGroup>

<SettingsGroup Title="@L["about.links_title"]">
    <SettingsCard Icon="github" Title="@L["about.btn_view_github"]" Description="github.com/eduardpoul/Animarr"
                  Href="https://github.com/eduardpoul/Animarr" External="true" />
    <SettingsCard Icon="file" Title="@L["about.btn_docs"]"
                  Href="https://github.com/eduardpoul/Animarr#readme" External="true" />
    <SettingsCard Icon="warn" Title="@L["about.btn_report_issue"]"
                  Href="https://github.com/eduardpoul/Animarr/issues" External="true" />
</SettingsGroup>

<p class="fs-hint ab-footer">@L["about.footer"]</p>

@code {
    private ServerInfoDto? _info;

    // ── External dashboard API key (gethomepage etc.) ─────────────────
    private string? _dashKey;
    private bool _dashBusy;

    /// <summary>Origin the dashboard should poll — the server this panel talks
    /// to (MediaUrl.Base under MAUI, the page origin in the browser).</summary>
    private string ServerOrigin =>
        (string.IsNullOrEmpty(Animarr.UI.Services.MediaUrl.Base)
            ? Nav.BaseUri
            : Animarr.UI.Services.MediaUrl.Base).TrimEnd('/');

    private string DashboardUrl => $"{ServerOrigin}{ApiRoutes.ServerDashboard}?key={_dashKey}";

    private RenderFragment DashboardKeyBody() => __builder =>
    {
        @if (_dashKey is null)
        {
            <p class="fs-hint">@L["about.dashboard_key_none"]</p>
        }
        else
        {
            <div class="ab-key">
                <label class="fs-field">
                    <span class="fs-field__label">@L["about.dashboard_key_label"]</span>
                    <input class="fs-input fs-input--code fs-input--wide" readonly value="@_dashKey"
                           onfocus="this.select()" spellcheck="false" />
                </label>
                <label class="fs-field">
                    <span class="fs-field__label">@L["about.dashboard_url_label"]</span>
                    <input class="fs-input fs-input--code fs-input--wide" readonly value="@DashboardUrl"
                           onfocus="this.select()" spellcheck="false" />
                </label>
                <p class="fs-hint">@((MarkupString)L["about.dashboard_header_hint_html"])</p>
                <div class="fs-row">
                    <Btn Variant="ghost" Size="sm" Disabled="_dashBusy" OnClick="RevokeDashboardKeyAsync">@L["about.dashboard_key_revoke"]</Btn>
                </div>
            </div>
        }
    };

    private async Task LoadDashboardKeyAsync()
    {
        try { _dashKey = (await Api.GetDashboardKeyAsync()).Key; }
        catch { _dashKey = null; }
    }

    private async Task RegenerateDashboardKeyAsync()
    {
        _dashBusy = true;
        try { _dashKey = (await Api.RegenerateDashboardKeyAsync()).Key; }
        catch { /* keep the current state */ }
        finally { _dashBusy = false; }
    }

    private async Task RevokeDashboardKeyAsync()
    {
        _dashBusy = true;
        try { await Api.RevokeDashboardKeyAsync(); _dashKey = null; }
        catch { /* keep the current state */ }
        finally { _dashBusy = false; }
    }

    private RenderFragment Specs() => __builder =>
    {
        <dl class="ab-kv">
            <dt>@L["about.key_version"]</dt> <dd>@VersionLabel</dd>
            <dt>@L["about.key_server"]</dt>  <dd>@ServerLabel</dd>
            <dt>@L["about.key_runtime"]</dt> <dd>@RuntimeLabel</dd>
            <dt>@L["about.key_license"]</dt> <dd>GPL-3.0</dd>
        </dl>
    };

    /// <summary>Version label.

    /// Shows the assembly InformationalVersion the server reports
    /// (e.g. "5.0.0+abc123"), falling back to a dash while in-flight or
    /// on a probe failure so the row never collapses to empty.</summary>
    private string VersionLabel => _info?.Version is { Length: > 0 } v ? $"v{ShortVersion(v)}" : "—";

    /// <summary>"1.0.0+10d14c8c41e8…" → "1.0.0 (10d14c8)" — the full SHA is
    /// noise in a settings row.</summary>
    private static string ShortVersion(string v)
    {
        var plus = v.IndexOf('+');
        if (plus < 0) return v;
        var sha = v[(plus + 1)..];
        return $"{v[..plus]} ({(sha.Length > 7 ? sha[..7] : sha)})";
    }

    /// <summary>The bound server's display name + ServerId prefix, so admins
    /// managing several servers can tell which one this panel is talking to.
    /// (It was labelled "Build"; the build's commit is in the version now.)</summary>
    private string ServerLabel
    {
        get
        {
            if (_info is null) return "—";
            var idShort = string.IsNullOrEmpty(_info.ServerId)
                ? ""
                : " · " + _info.ServerId.Replace("-", "").AsSpan(0, Math.Min(8, _info.ServerId.Replace("-", "").Length)).ToString();
            return $"{_info.Name}{idShort}";
        }
    }

    /// <summary>Runtime hint — fixed string ".NET 10" plus a host
    /// detector. WASM and MAUI both run identical Razor code, so the
    /// component itself can't tell them apart with `RuntimeInformation`.
    /// We probe `OperatingSystem.IsBrowser()` (true only in WASM) to
    /// label the actual host.</summary>
    private static string RuntimeLabel =>
        OperatingSystem.IsBrowser() ? ".NET 10 · WASM" : ".NET 10 · Native";

    protected override async Task OnInitializedAsync()
    {
        // Probe the bound server. Origin defaults to the NavigationManager
        // base URI (the same host the WASM bundle came from). If the
        // request fails we keep the dash placeholders rather than throwing
        // — the About panel stays renderable when offline.
        try
        {
            var origin = Nav.BaseUri.TrimEnd('/');
            _info = await Api.GetServerInfoAsync(origin);
        }
        catch
        {
            _info = null;
        }
        await LoadDashboardKeyAsync();
    }
}
