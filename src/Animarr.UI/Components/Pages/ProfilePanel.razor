                 plays on Home/catalog. *@
            <div class="d-profile__toggle-row d-profile__field--full">
                <div class="d-profile__toggle-text">
                    <div class="d-profile__toggle-title">@L["profile.theme_music_title"]</div>
                    <div class="d-profile__toggle-hint">@L["profile.theme_music_hint"]</div>
                </div>
                <Toggle Checked="@_themeMusic" CheckedChanged="OnThemeMusicToggle" />
