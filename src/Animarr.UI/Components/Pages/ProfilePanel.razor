    private record SwatchDef(int Hue, double L, double C, string Label);
    private static readonly SwatchDef[] AccentSwatches =
    {
        new(25,  0.66, 0.20, "Crimson"),
        new(60,  0.72, 0.17, "Amber"),
        new(150, 0.74, 0.15, "Green"),
        new(240, 0.66, 0.16, "Blue"),
        new(290, 0.66, 0.20, "Violet"),
    };

    private async Task OnSelectAccent(int hue)
    {
        // Optimistic update — set local state + DOM accent variable, then
        // PATCH. The DOM update is immediate so the user sees the new accent
        // before the server confirms.
        try { await JS.InvokeVoidAsync("animarr_setAccentHue", hue); } catch { }
        await PatchAsync(new UpdatePreferencesRequest(
            AccentHue: hue, null, null, null, null, null, null, null, null, null, null, null, null));
        StateHasChanged();
    }
}
