@*
    ProfilePanel — 480px right-edge drawer per-user settings.
    Spec: screens-v4.jsx lines 453-637.

    4 tabs:
      • Identity   — readonly key/value + change password + edit profile + SIGN OUT
      • Appearance — 5 accent swatches + animated backdrop toggle + TV mode toggle
      • Audio      — preferred audio/sub langs + sub size + default volume +
                     audio passthrough + normalize loudness
      • Language   — interface language dropdown

    State: tab held locally; preferences edited locally for visual review,
    Phase B will PATCH them through /api/me/preferences.
*@

@inject UserContextState UserCtx
@inject NavigationManager Nav
@inject IAnimarrApiClient Api
@inject IJSRuntime JS
@inject LocalizationService Loc
@inject ServerRegistryState ServerReg
@inject ToastService Toasts
@inject DeviceProfilesState DeviceProfiles

@if (_keypadOpen && _keypadTarget is { } kt)
{
    @* ── PIN keypad overlay (v5 fast switch) ──
         Full-screen shell at z-index 211 — ABOVE the drawer + its backdrop
         (200/201) so the keypad isn't tinted out or click-blocked. Clicking
         the shell's empty area cancels; the card wrapper stops propagation so
         taps on the digits keep the dialog open.
         We use stopPropagation (NOT a pointer-events trick) on purpose: the
         keypad is a CHILD component, so a scoped `pointer-events:auto` rule
         can't reach into its element — which is exactly why mouse taps used
         to fall through to the backdrop and close the dialog. *@
    <div class="d-pin-shell" @onclick="OnKeypadCancel">
        <div class="d-pin-card" @onclick:stopPropagation="true"
             role="dialog" aria-modal="true" aria-label="@L["pin.enter_aria"]">
            <PinKeypad UserName="@kt.Name"
                       Error="@_keypadError"
                       OnSubmit="OnKeypadSubmit"
                       OnCancel="OnKeypadCancel" />
        </div>
    </div>
}

@if (IsOpen && UserCtx.Me is { } me)
{
    <div class="d-profile__backdrop" @onclick="Close" aria-hidden="true"></div>
    <aside class="d-profile" role="dialog" aria-label="@L["profile.dialog_aria"]" data-mobile-detail="@(_mobileShowingDetail ? "true" : "false")">

        @* ── Header — on mobile + detail mode the close icon turns into a
             back arrow so the user can return to the category list without
             closing the whole drawer. ────────────────────────────────── *@
        <header class="d-profile__head">
            @if (_mobileShowingDetail)
            {
                <button type="button" class="d-profile__back tv-focus"
                        @onclick="@(() => _mobileShowingDetail = false)"
                        aria-label="@L["profile.back_to_list_aria"]">
                    <DIcon Name="chev-l" Size="18" />
                </button>
            }
            else
            {
                @* Root-level back arrow (phone only — hidden on desktop via
                   .d-profile__back--home). Mirrors the sub-screen back button
                   and every page's left-back so the profile root isn't the one
                   place without it. Closes the drawer → back to the main grid. *@
                <button type="button" class="d-profile__back d-profile__back--home tv-focus"
                        @onclick="Close"
                        aria-label="@L["common.back"]">
                    <DIcon Name="chev-l" Size="18" />
                </button>
                <Avatar Name="@me.User.Name" HueOverride="me.User.AvatarHue"
                        ImagePath="@me.User.AvatarPath" Size="lg" />
            }
            <div class="d-profile__head-text">
                <div class="d-profile__head-name">
                    @(_mobileShowingDetail ? CurrentTabLabel : me.User.Name)
                </div>
                @if (!_mobileShowingDetail)
                {
                    <div class="d-profile__head-sub">
                        @me.User.Username@(string.IsNullOrEmpty(me.User.Email) ? "" : " · " + me.User.Email)
                    </div>
                }
            </div>
            <button type="button" class="d-profile__close tv-focus" @onclick="Close" aria-label="@L["common.btn_close"]">
                <DIcon Name="x" Size="14" />
            </button>
        </header>

        @* ── Desktop tabs — hidden on mobile via .d-profile__tabs--desktop
             media query. Mobile users see the drilldown list below instead. *@
        <nav class="d-profile__tabs d-profile__tabs--desktop" aria-label="@L["profile.sections_aria"]">
            @foreach (var t in Tabs)
            {
                var key = t.Key;
                var active = _activeTab == key;
                <button type="button"
                        class="@($"d-profile__tab tv-focus {(active ? "is-active" : "")}")"
                        @onclick="@(() => _activeTab = key)">
                    <DIcon Name="@t.Icon" Size="12" />
                    @L[t.Label]
                </button>
            }
        </nav>

        @* ── Mobile drilldown list — vertical list of category rows.
             Click → set _activeTab + flip to detail mode. CSS hides this on
             desktop and when already drilled into a detail. Two flat-nav
             entries (Pair a TV, Server settings) are hoisted out of the
             Identity tab and live alongside the tab categories on phone —
             on a small screen those two actions deserve top-level surface
             instead of being buried two screens deep. ────────────────── *@
        <nav class="d-profile__mlist" aria-label="@L["profile.categories_aria"]">
            @foreach (var t in Tabs)
            {
                var key = t.Key;
                <button type="button" class="d-profile__mlist-row tv-focus"
                        @onclick="@(() => { _activeTab = key; _mobileShowingDetail = true; })">
                    <span class="d-profile__mlist-ic">
                        <DIcon Name="@t.Icon" Size="14" />
                    </span>
                    <span class="d-profile__mlist-label">@L[t.Label]</span>
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }

            @* Hoisted "Downloads" — the bottom-tabbar that used to host
               the Torrents tab is gone on phone, so the entry point moves
               into the root settings list. Gated by uploadContent so
               viewer-only users don't see a button they can't open. *@
            @if (UserCtx.Can(p => p.UploadContent))
            {
                <button type="button" class="d-profile__mlist-row tv-focus"
                        @onclick="OnDownloadsClick">
                    <span class="d-profile__mlist-ic">
                        <DIcon Name="torrent" Size="14" />
                    </span>
                    <span class="d-profile__mlist-label">@L["profile.downloads"]</span>
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }

            @* Hoisted "Pair a TV" — runs the same handler the Identity tab's
               in-body button uses. Lives in the root list on phone so it's
               one tap away (not three). MAUI-app only: in a plain browser
               (OperatingSystem.IsBrowser()) there's no TV-pairing host flow,
               so the entry is hidden there. *@
            @if (!OperatingSystem.IsBrowser())
            {
                <button type="button" class="d-profile__mlist-row tv-focus"
                        @onclick="OnPairTvClick">
                    <span class="d-profile__mlist-ic">
                        <DIcon Name="qr-code" Size="14" />
                    </span>
                    <span class="d-profile__mlist-label">@L["profile.pair_tv"]</span>
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }

            @* Server settings — same hoist, gated by the systemSettings
               permission so non-admin users don't see a row they can't open. *@
            @if (UserCtx.Can(p => p.SystemSettings))
            {
                <button type="button" class="d-profile__mlist-row tv-focus"
                        @onclick="OnServerSettingsClick">
                    <span class="d-profile__mlist-ic">
                        <DIcon Name="settings" Size="14" />
                    </span>
                    <span class="d-profile__mlist-label">@L["profile.server_settings_title"]</span>
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }

            @* Sign out lives at the bottom of the root list — last item, danger
               accent — so the destructive action stays last-touchable on
               every screen size. *@
            <button type="button" class="d-profile__mlist-row d-profile__mlist-row--danger tv-focus"
                    @onclick="SignOut">
                <span class="d-profile__mlist-ic d-profile__mlist-ic--danger">
                    <DIcon Name="logout" Size="14" />
                </span>
                <span class="d-profile__mlist-label">@L["profile.sign_out"]</span>
            </button>
        </nav>

        @* ── Body — visible when desktop OR mobile-detail mode. Hidden when
             mobile + list mode (the .d-profile__mlist takes its place). *@
        <div class="d-profile__body">
            @switch (_activeTab)
            {
                case "identity":
                    @RenderIdentity(me);
                    break;
                case "servers":
                    @RenderServers();
                    break;
                case "appearance":
                    @RenderAppearance();
                    break;
                case "audio":
                    @RenderAudio();
                    break;
            }
        </div>
    </aside>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnCloseEvent { get; set; }
    /// <summary>v5: hint from the caller for which tab to open initially.
    /// Currently only "server" is recognised — opens the Identity tab where
    /// the Server section sits. Pass null for the regular default.</summary>
    [Parameter] public string? InitialTab { get; set; }

    // Label holds a localization KEY (resolved via L[...] at each render site)
    // rather than an English literal — the array is static so it can't call the
    // injected LocalizationService directly.
    private record TabDef(string Key, string Label, string Icon);
    private static readonly TabDef[] Tabs =
    {
        new("identity",   "profile.tab_identity",   "user"),
        new("servers",    "profile.tab_servers",    "server"),
        new("appearance", "profile.tab_appearance", "sparkle"),
        new("audio",      "profile.tab_audio",      "audio"),
        // Language used to be its own tab; it now lives at the bottom of the
        // Appearance tab (it's a display preference like theme / accent, and
        // a standalone tab for one dropdown was overkill on mobile drilldown).
    };

    private string _activeTab = "identity";

    /// <summary>Mobile drilldown state. False = show vertical list of
    /// categories (default for phones), true = show the selected tab's
    /// body with a back arrow. Desktop ignores this — the horizontal tab
    /// strip is always visible there.</summary>
    private bool _mobileShowingDetail;

    /// <summary>Human-readable label of the currently-active tab — shown
    /// in the mobile detail header so the user knows where they are.</summary>
    private string CurrentTabLabel
    {
        get
        {
            foreach (var t in Tabs)
                if (t.Key == _activeTab) return L[t.Label];
            return L["nav.settings"];
        }
    }

    // Local edit state mirrors UserContextState.Preferences. On every change
    // we PATCH /api/me/preferences and update the global state so any other
    // subscriber (MainLayout's backdrop, accent hue applier) re-renders.
    private int _accentHue => UserCtx.Preferences?.AccentHue ?? 25;
    private bool _backdropEnabled = true;
    private bool _tvMode          = false;
    private string _audioPref     = "Japanese";
    private string _subPref       = "Russian";
    private int _subSize          = 18;
    private int _volume           = 78;
    private bool _passthrough     = false;
    private bool _normalize       = true;
    private bool _themeMusic       = false;
    private int  _themeMusicVolume = 40;
    private string _language      = "en";
    private string _theme         = "quietude";
    /// <summary>F / G / H — see <see cref="PagerOptions"/>. Default "g"
    /// (Chevrons) — the hover-revealed prev/next chevrons + dash pager.</summary>
    private string _heroPagerStyle = "g";
    /// <summary>Default episode-list layout on a title's detail page —
    /// "grid" (poster cards) or "list" (detailed rows). The page's grid⇄list
    /// toggle writes the same preference, so this is the shared default.</summary>
    private string _episodeListView = "grid";

    /// <summary>Player HUD style: "full" (icons + text + glass background)
    /// or "icons" (just icons, no background, no labels). Device-local only —
    /// stored in localStorage by animarr-player.js, not persisted server-side.
    /// Set in OnAfterRenderAsync once JS is available.</summary>
    private string _playerStyle = "full";

    // ─── Edit-profile + Change-password inline form state ──────────────
    private bool   _editProfileOpen;
    private bool   _editProfileBusy;
    private string _editProfileError = "";
    private string _editName   = "";
    private string _editEmail  = "";
    private int    _editAvatarHue;

    private bool   _changePwOpen;
    private bool   _changePwBusy;
    private string _changePwError = "";
    private string _pwCurrent = "";
    private string _pwNew     = "";
    private string _pwRepeat  = "";

    // ─── Set / change / remove a DEVICE-LOCAL PIN ─────────────────────
    // The PIN locks fast-switching INTO this profile on THIS device. It's
    // stored + verified locally (DeviceProfilesState), never on the server —
    // so a PIN set here doesn't follow the account onto other devices.
    private bool   _pinOpen;
    private bool   _pinBusy;
    private string _pinError = "";
    private string _pinValue = "";      // the new 4-digit PIN (device-local)
    private bool   _myHasDevicePin;     // does the CURRENT user have a device-local PIN here?

    private Task Close() => OnCloseEvent.InvokeAsync();

    protected override void OnParametersSet()
    {
        // v5: caller may pre-focus a tab (server pill click → "server"). The
        // server section lives inside the Identity tab; "server" is treated as
        // a synonym so the user sees server cards immediately.
        if (!string.IsNullOrEmpty(InitialTab))
        {
            _activeTab = InitialTab switch
            {
                // Caller may pass legacy "server" (singular) — route to the
                // new dedicated Servers tab. v5 moved server management out
                // of the Identity tab to its own pane.
                "server"  => "servers",
                _         => Tabs.Any(t => t.Key == InitialTab) ? InitialTab : _activeTab,
            };
        }

        var p = UserCtx.Preferences;
        if (p is null) return;
        _backdropEnabled = p.BackdropEnabled;
        _tvMode          = p.TvMode;
        _audioPref       = p.AudioPreferredLanguage;
        _subPref         = p.SubtitlePreferredLanguage;
        _subSize         = p.SubtitleSize;
        _volume          = p.DefaultVolume;
        _passthrough     = p.AudioPassthrough;
        _normalize       = p.NormalizeVolume;
        _themeMusic       = p.ThemeMusicEnabled;
        _themeMusicVolume = p.ThemeMusicVolume;
        _language        = p.Language;
        _theme           = string.IsNullOrEmpty(p.Theme) ? "quietude" : p.Theme;
        _heroPagerStyle  = string.IsNullOrEmpty(p.HeroPagerStyle) ? "g" : p.HeroPagerStyle.ToLowerInvariant();
        _episodeListView = string.IsNullOrEmpty(p.EpisodeListView) ? "grid" : p.EpisodeListView.ToLowerInvariant();
    }

    // ─── Edit profile / change password handlers ───────────────────────

    private void ToggleEditProfile()
    {
        if (_editProfileOpen)
        {
            _editProfileOpen = false;
            return;
        }
        // Reset form when opening so a previous abandoned edit doesn't leak in.
        if (UserCtx.Me is { } me)
        {
            _editName       = me.User.Name;
            _editEmail      = me.User.Email ?? "";
            _editAvatarHue  = me.User.AvatarHue;
        }
        _editProfileError = "";
        _editProfileOpen = true;
        // Mutually exclusive with the password form to keep the drawer tidy.
        _changePwOpen = false;
    }

    private void ToggleChangePassword()
    {
        _changePwOpen = !_changePwOpen;
        if (_changePwOpen)
        {
            _pwCurrent = _pwNew = _pwRepeat = "";
            _changePwError = "";
            _editProfileOpen = false;
            _pinOpen = false;
        }
    }

    private void ToggleSetPin()
    {
        _pinOpen = !_pinOpen;
        if (_pinOpen)
        {
            _pinValue = ""; _pinError = "";
            _editProfileOpen = false;
            _changePwOpen = false;
        }
    }

    /// <summary>Keep only the first <paramref name="max"/> digits of raw input —
    /// the PIN is numeric and fixed-length (matches the switch-user keypad).</summary>
    private static string DigitsOnly(string? raw, int max)
    {
        if (string.IsNullOrEmpty(raw)) return "";
        var sb = new System.Text.StringBuilder(max);
        foreach (var ch in raw)
        {
            if (ch is >= '0' and <= '9') { sb.Append(ch); if (sb.Length >= max) break; }
        }
        return sb.ToString();
    }

    private async Task SubmitSetPinAsync()
    {
        _pinError = "";
        if (_pinValue.Length < 4) { _pinError = L["profile.pin_err_len"]; return; }
        if (UserCtx.Me is not { } me) return;
        _pinBusy = true; StateHasChanged();
        try
        {
            // Device-local: store the hashed PIN on THIS device only.
            await DeviceProfiles.SetPinAsync(me.User.Id, _pinValue);
            _myHasDevicePin = true;
            await LoadProfilesAsync();        // refresh the strip's lock badge
            _pinOpen = false; _pinValue = "";
            Toasts.ShowSuccess(L["profile.pin_toast_saved"]);
        }
        catch (Exception ex) { _pinError = L.Get("profile.pin_err_save", ex.Message); }
        finally { _pinBusy = false; StateHasChanged(); }
    }

    private async Task RemovePinAsync()
    {
        _pinError = "";
        if (UserCtx.Me is not { } me) return;
        _pinBusy = true; StateHasChanged();
        try
        {
            await DeviceProfiles.SetPinAsync(me.User.Id, null);
            _myHasDevicePin = false;
            await LoadProfilesAsync();
            _pinOpen = false; _pinValue = "";
            Toasts.ShowSuccess(L["profile.pin_toast_removed"]);
        }
        catch (Exception ex) { _pinError = L.Get("profile.pin_err_remove", ex.Message); }
        finally { _pinBusy = false; StateHasChanged(); }
    }

    private async Task SubmitEditProfileAsync()
    {
        _editProfileError = "";
        var trimmedName = _editName.Trim();
        if (string.IsNullOrEmpty(trimmedName))
        {
            _editProfileError = L["profile.err_name_empty"];
            return;
        }
        _editProfileBusy = true;
        StateHasChanged();
        try
        {
            var updated = await Api.UpdateMyProfileAsync(new UpdateMyProfileRequest(
                Name:      trimmedName,
                Email:     string.IsNullOrWhiteSpace(_editEmail) ? null : _editEmail.Trim(),
                AvatarHue: _editAvatarHue));
            // Refresh global Me cache so the topbar avatar chip + sidebar
            // pick up the new values without a full reload. RefreshMeAsync
            // re-pulls /api/me which carries the freshly-saved Name/Email/Hue.
            await UserCtx.RefreshMeAsync();
            _editProfileOpen = false;
            Toasts.ShowSuccess(L["profile.toast_updated"]);
        }
        catch (Exception ex)
        {
            _editProfileError = L.Get("profile.err_save_failed", ex.Message);
        }
        finally
        {
            _editProfileBusy = false;
            StateHasChanged();
        }
    }

    private async Task SubmitChangePasswordAsync()
    {
        _changePwError = "";
        if (string.IsNullOrEmpty(_pwCurrent))
        {
            _changePwError = L["profile.err_pw_current_required"];
            return;
        }
        if (_pwNew.Length < 6)
        {
            _changePwError = L["profile.err_pw_min"];
            return;
        }
        if (_pwNew != _pwRepeat)
        {
            _changePwError = L["profile.err_pw_mismatch"];
            return;
        }
        _changePwBusy = true;
        StateHasChanged();
        try
        {
            await Api.ChangeMyPasswordAsync(new ChangePasswordRequest(_pwCurrent, _pwNew));
            _changePwOpen = false;
            _pwCurrent = _pwNew = _pwRepeat = "";
            Toasts.ShowSuccess(L["profile.toast_pw_changed"]);
        }
        catch (Exception ex)
        {
            // The server returns 400 with {error} JSON for the "current password is
            // incorrect" + min-length cases. Surface the underlying message when we
            // can, otherwise the generic message keeps the form open.
            _changePwError = L.Get("profile.err_update_failed", ex.Message);
        }
        finally
        {
            _changePwBusy = false;
            StateHasChanged();
        }
    }

    /// <summary>Read the device-local player-style preference from localStorage
    /// once JS is available. localStorage holds the source of truth — there
    /// is no server-side mirror because the choice (icons-only vs full) is
    /// often per-device (e.g. icons-only on living-room TV, full on phone).
    /// Merged with the user-roster fetch (second pre-merge block had a
    /// duplicate OnAfterRenderAsync override that broke the build).</summary>
    private async Task LoadPlayerStyleAsync()
    {
        try
        {
            var v = await JS.InvokeAsync<string?>(
                "eval", "localStorage.getItem('animarr_player_style')");
            if (v == "icons" || v == "full")
            {
                _playerStyle = v;
                StateHasChanged();
            }
        }
        catch { /* localStorage unavailable — keep default */ }
    }

    private async Task OnPlayerStyleSelect(string style)
    {
        if (style != "full" && style != "icons") return;
        _playerStyle = style;
        try
        {
            // animarrPlayer.setStyle writes to localStorage AND updates any
            // live HUD via data-style attribute swap, so the change is live
            // even when the user toggles while the player is open.
            await JS.InvokeVoidAsync("animarrPlayer.setStyle", style);
        }
        catch { /* JS unavailable — preference is still set in _playerStyle */ }
        StateHasChanged();
    }

    /// <summary>PATCH /api/me/preferences with the diff this tab cares about,
    /// store the new payload in UserContextState so accent/backdrop/etc.
    /// re-apply globally. Errors are swallowed — UI still reflects the local
    /// change while the server retry happens; next LoadAsync converges.</summary>
    private async Task PatchAsync(UpdatePreferencesRequest req)
    {
        try
        {
            var updated = await Api.UpdateMyPreferencesAsync(req);
            UserCtx.SetPreferences(updated);
        }
        catch { }
    }

    private async Task OnBackdropToggle(bool v)
    {
        _backdropEnabled = v;
        await PatchAsync(new UpdatePreferencesRequest(
            null, BackdropEnabled: v, null, null, null, null, null, null, null, null, null, null, null));
    }

    private async Task OnTvModeToggle(bool v)
    {
        _tvMode = v;
        try
        {
            // Reflect the toggle in the DOM immediately so .tv-focus heavier
            // rings and the larger base font-size kick in without a reload.
            // Mirror to localStorage too — the boot resolver in index.html
            // reads `animarr_tv_mode` on first paint, before MainLayout has
            // had a chance to fetch /api/me/preferences, so persisting here
            // keeps the bootstrap class application aligned with the user's
            // explicit choice (no flash of wrong layout on next launch).
            await JS.InvokeVoidAsync("eval",
                v ? "document.documentElement.classList.add('tv-mode');" +
                    "try{localStorage.setItem('animarr_tv_mode','1');}catch(_){};"
                  : "document.documentElement.classList.remove('tv-mode');" +
                    "try{localStorage.setItem('animarr_tv_mode','0');}catch(_){};");
        }
        catch { }
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, TvMode: v, null, null, null, null, null, null, null));
    }

    private async Task OnPassthroughToggle(bool v)
    {
        _passthrough = v;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, AudioPassthrough: v, null, null));
    }

    private async Task OnNormalizeToggle(bool v)
    {
        _normalize = v;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, NormalizeVolume: v, null));
    }

    private async Task OnThemeMusicToggle(bool v)
    {
        _themeMusic = v;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, null, null,
            ThemeMusicEnabled: v));
    }

    private async Task OnThemeMusicVolumeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            _themeMusicVolume = n;
            await PatchAsync(new UpdatePreferencesRequest(
                null, null, null, null, null, null, null, null, null, null, null, null, null,
                ThemeMusicVolume: n));
        }
    }

    private async Task OnAudioPrefChanged(ChangeEventArgs e)
    {
        _audioPref = e.Value?.ToString() ?? _audioPref;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, AudioPreferredLanguage: _audioPref, null, null, null, null, null, null));
    }

    private async Task OnSubPrefChanged(ChangeEventArgs e)
    {
        _subPref = e.Value?.ToString() ?? _subPref;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, SubtitlePreferredLanguage: _subPref, null, null, null, null, null));
    }

    private async Task OnSubSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            _subSize = n;
            await PatchAsync(new UpdatePreferencesRequest(
                null, null, null, null, null, null, null, null, SubtitleSize: n, null, null, null, null));
        }
    }

    private async Task OnVolumeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            _volume = n;
            await PatchAsync(new UpdatePreferencesRequest(
                null, null, null, null, null, null, null, null, null, DefaultVolume: n, null, null, null));
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        _language = e.Value?.ToString() ?? _language;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, null, Language: _language));
        // Hot-swap the pack so subscribers (MainLayout) see the new dict
        // immediately — but most page-level components don't subscribe to
        // L.LanguageChanged and would keep rendering English strings.
        // The honest fix: a hard reload of the current URL. UserCtx.Loaded
        // re-runs, prefs come back from the server with the new language,
        // and MainLayout calls Loc.LoadAsync(prefLang) at boot. Every L[...]
        // lookup across the app now resolves against the new dict. Losing
        // current-page state (filter chip, scroll position) is acceptable —
        // language changes are rare and the user just asked for one.
        try { await Loc.LoadAsync(_language); } catch { /* fallback handled in Loc */ }
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task SignOut()
    {
        await UserCtx.SignOutAsync();
        await Close();
        Nav.NavigateTo("/welcome", forceLoad: false);
    }

