@*
    ProfilePanel — 480px right-edge drawer per-user settings.
    Spec: screens-v4.jsx lines 453-637.

    4 tabs:
      • Identity   — readonly key/value + change password + edit profile + SIGN OUT
      • Appearance — 5 accent swatches + animated backdrop toggle + TV mode toggle
      • Audio      — preferred audio/sub langs + sub size + default volume +
                     audio passthrough + normalize loudness
      • Language   — interface language dropdown

    State: tab held locally; preferences edited locally for visual review,
    Phase B will PATCH them through /api/me/preferences.
*@

@inject UserContextState UserCtx
@inject NavigationManager Nav
@inject IAnimarrApiClient Api
@inject IJSRuntime JS
@inject LocalizationService Loc
@inject ServerRegistryState ServerReg
@inject ToastService Toasts

@if (_keypadOpen && _keypadTarget is { } kt)
{
    @* ── PIN keypad overlay (v5 fast switch) ──
         Rendered above the drawer so it captures focus + obscures the user
         strip while the dialog is open. Same backdrop tint as the drawer
         itself, sits on z-index 32 (drawer is 31). *@
    <div class="d-pin-overlay" @onclick="OnKeypadCancel" aria-hidden="true"></div>
    <div class="d-pin-shell" role="dialog" aria-modal="true" aria-label="Enter PIN">
        <PinKeypad UserName="@kt.Name"
                   Error="@_keypadError"
                   OnSubmit="OnKeypadSubmit"
                   OnCancel="OnKeypadCancel" />
    </div>
}

@if (IsOpen && UserCtx.Me is { } me)
{
    <div class="d-profile__backdrop" @onclick="Close" aria-hidden="true"></div>
    <aside class="d-profile" role="dialog" aria-label="Profile" data-mobile-detail="@(_mobileShowingDetail ? "true" : "false")">

        @* ── Header — on mobile + detail mode the close icon turns into a
             back arrow so the user can return to the category list without
             closing the whole drawer. ────────────────────────────────── *@>
        <header class="d-profile__head">
            @if (_mobileShowingDetail)
            {
                <button type="button" class="d-profile__back tv-focus"
                        @onclick="@(() => _mobileShowingDetail = false)"
                        aria-label="Back to settings list">
                    <DIcon Name="arrow-l" Size="14" />
                </button>
            }
            else
            {
                <Avatar Name="@me.User.Name" HueOverride="me.User.AvatarHue"
                        ImagePath="@me.User.AvatarPath" Size="lg" />
            }
            <div class="d-profile__head-text">
                <div class="d-profile__head-name">
                    @(_mobileShowingDetail ? CurrentTabLabel : me.User.Name)
                </div>
                @if (!_mobileShowingDetail)
                {
                    <div class="d-profile__head-sub">
                        @me.User.Username@(string.IsNullOrEmpty(me.User.Email) ? "" : " · " + me.User.Email)
                    </div>
                }
            </div>
            <button type="button" class="d-profile__close tv-focus" @onclick="Close" aria-label="Close">
                <DIcon Name="x" Size="14" />
            </button>
        </header>

        @* ── Desktop tabs — hidden on mobile via .d-profile__tabs--desktop
             media query. Mobile users see the drilldown list below instead. *@
        <nav class="d-profile__tabs d-profile__tabs--desktop" aria-label="Profile sections">
            @foreach (var t in Tabs)
            {
                var key = t.Key;
                var active = _activeTab == key;
                <button type="button"
                        class="@($"d-profile__tab tv-focus {(active ? "is-active" : "")}")"
                        @onclick="@(() => _activeTab = key)">
                    <DIcon Name="@t.Icon" Size="12" />
                    @t.Label
                </button>
            }
        </nav>

        @* ── Mobile drilldown list — vertical list of category rows.
             Click → set _activeTab + flip to detail mode. CSS hides this on
             desktop and when already drilled into a detail. Two flat-nav
             entries (Pair a TV, Server settings) are hoisted out of the
             Identity tab and live alongside the tab categories on phone —
             on a small screen those two actions deserve top-level surface
             instead of being buried two screens deep. ────────────────── *@
        <nav class="d-profile__mlist" aria-label="Settings categories">
            @foreach (var t in Tabs)
            {
                var key = t.Key;
                <button type="button" class="d-profile__mlist-row tv-focus"
                        @onclick="@(() => { _activeTab = key; _mobileShowingDetail = true; })">
                    <span class="d-profile__mlist-ic">
                        <DIcon Name="@t.Icon" Size="14" />
                    </span>
                    <span class="d-profile__mlist-label">@t.Label</span>
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }

            @* Hoisted "Downloads" — the bottom-tabbar that used to host
               the Torrents tab is gone on phone, so the entry point moves
               into the root settings list. Gated by uploadContent so
               viewer-only users don't see a button they can't open. *@
            @if (UserCtx.Can(p => p.UploadContent))
            {
                <button type="button" class="d-profile__mlist-row tv-focus"
                        @onclick="OnDownloadsClick">
                    <span class="d-profile__mlist-ic">
                        <DIcon Name="torrent" Size="14" />
                    </span>
                    <span class="d-profile__mlist-label">Downloads</span>
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }

            @* Hoisted "Pair a TV" — runs the same handler the Identity tab's
               in-body button uses. Lives in the root list on phone so it's
               one tap away (not three). *@
            <button type="button" class="d-profile__mlist-row tv-focus"
                    @onclick="OnPairTvClick">
                <span class="d-profile__mlist-ic">
                    <DIcon Name="qr-code" Size="14" />
                </span>
                <span class="d-profile__mlist-label">Pair a TV</span>
                <DIcon Name="chev-r" Size="13" />
            </button>

            @* Server settings — same hoist, gated by the systemSettings
               permission so non-admin users don't see a row they can't open. *@
            @if (UserCtx.Can(p => p.SystemSettings))
            {
                <button type="button" class="d-profile__mlist-row tv-focus"
                        @onclick="OnServerSettingsClick">
                    <span class="d-profile__mlist-ic">
                        <DIcon Name="settings" Size="14" />
                    </span>
                    <span class="d-profile__mlist-label">@L["profile.server_settings_title"]</span>
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }

            @* Sign out lives at the bottom of the root list — last item, danger
               accent — so the destructive action stays last-touchable on
               every screen size. *@
            <button type="button" class="d-profile__mlist-row d-profile__mlist-row--danger tv-focus"
                    @onclick="SignOut">
                <span class="d-profile__mlist-ic d-profile__mlist-ic--danger">
                    <DIcon Name="logout" Size="14" />
                </span>
                <span class="d-profile__mlist-label">SIGN OUT</span>
            </button>
        </nav>

        @* ── Body — visible when desktop OR mobile-detail mode. Hidden when
             mobile + list mode (the .d-profile__mlist takes its place). *@
        <div class="d-profile__body">
            @switch (_activeTab)
            {
                case "identity":
                    @RenderIdentity(me);
                    break;
                case "servers":
                    @RenderServers();
                    break;
                case "appearance":
                    @RenderAppearance();
                    break;
                case "audio":
                    @RenderAudio();
                    break;
                case "language":
                    @RenderLanguage();
                    break;
            }
        </div>
    </aside>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnCloseEvent { get; set; }
    /// <summary>v5: hint from the caller for which tab to open initially.
    /// Currently only "server" is recognised — opens the Identity tab where
    /// the Server section sits. Pass null for the regular default.</summary>
    [Parameter] public string? InitialTab { get; set; }

    private record TabDef(string Key, string Label, string Icon);
    private static readonly TabDef[] Tabs =
    {
        new("identity",   "Identity",   "user"),
        new("servers",    "Servers",    "server"),
        new("appearance", "Appearance", "sparkle"),
        new("audio",      "Audio",      "audio"),
        new("language",   "Language",   "globe"),
    };

    private string _activeTab = "identity";

    /// <summary>Mobile drilldown state. False = show vertical list of
    /// categories (default for phones), true = show the selected tab's
    /// body with a back arrow. Desktop ignores this — the horizontal tab
    /// strip is always visible there.</summary>
    private bool _mobileShowingDetail;

    /// <summary>Human-readable label of the currently-active tab — shown
    /// in the mobile detail header so the user knows where they are.</summary>
    private string CurrentTabLabel
    {
        get
        {
            foreach (var t in Tabs)
                if (t.Key == _activeTab) return t.Label;
            return "Settings";
        }
    }

    // Local edit state mirrors UserContextState.Preferences. On every change
    // we PATCH /api/me/preferences and update the global state so any other
    // subscriber (MainLayout's backdrop, accent hue applier) re-renders.
    private int _accentHue => UserCtx.Preferences?.AccentHue ?? 25;
    private bool _backdropEnabled = true;
    private bool _tvMode          = false;
    private string _audioPref     = "Japanese";
    private string _subPref       = "Russian";
    private int _subSize          = 18;
    private int _volume           = 78;
    private bool _passthrough     = false;
    private bool _normalize       = true;
    private string _language      = "en";
    private string _theme         = "quietude";
    /// <summary>F / G / H — see <see cref="PagerOptions"/>. Default "f"
    /// matches the transparent named pager that ships with v5.</summary>
    private string _heroPagerStyle = "f";

    /// <summary>Player HUD style: "full" (icons + text + glass background)
    /// or "icons" (just icons, no background, no labels). Device-local only —
    /// stored in localStorage by animarr-player.js, not persisted server-side.
    /// Set in OnAfterRenderAsync once JS is available.</summary>
    private string _playerStyle = "full";

    // ─── Edit-profile + Change-password inline form state ──────────────
    private bool   _editProfileOpen;
    private bool   _editProfileBusy;
    private string _editProfileError = "";
    private string _editName   = "";
    private string _editEmail  = "";
    private int    _editAvatarHue;

    private bool   _changePwOpen;
    private bool   _changePwBusy;
    private string _changePwError = "";
    private string _pwCurrent = "";
    private string _pwNew     = "";
    private string _pwRepeat  = "";

    private Task Close() => OnCloseEvent.InvokeAsync();

    protected override void OnParametersSet()
    {
        // v5: caller may pre-focus a tab (server pill click → "server"). The
        // server section lives inside the Identity tab; "server" is treated as
        // a synonym so the user sees server cards immediately.
        if (!string.IsNullOrEmpty(InitialTab))
        {
            _activeTab = InitialTab switch
            {
                // Caller may pass legacy "server" (singular) — route to the
                // new dedicated Servers tab. v5 moved server management out
                // of the Identity tab to its own pane.
                "server"  => "servers",
                _         => Tabs.Any(t => t.Key == InitialTab) ? InitialTab : _activeTab,
            };
        }

        var p = UserCtx.Preferences;
        if (p is null) return;
        _backdropEnabled = p.BackdropEnabled;
        _tvMode          = p.TvMode;
        _audioPref       = p.AudioPreferredLanguage;
        _subPref         = p.SubtitlePreferredLanguage;
        _subSize         = p.SubtitleSize;
        _volume          = p.DefaultVolume;
        _passthrough     = p.AudioPassthrough;
        _normalize       = p.NormalizeVolume;
        _language        = p.Language;
        _theme           = string.IsNullOrEmpty(p.Theme) ? "quietude" : p.Theme;
        _heroPagerStyle  = string.IsNullOrEmpty(p.HeroPagerStyle) ? "f" : p.HeroPagerStyle.ToLowerInvariant();
    }

    // ─── Edit profile / change password handlers ───────────────────────

    private void ToggleEditProfile()
    {
        if (_editProfileOpen)
        {
            _editProfileOpen = false;
            return;
        }
        // Reset form when opening so a previous abandoned edit doesn't leak in.
        if (UserCtx.Me is { } me)
        {
            _editName       = me.User.Name;
            _editEmail      = me.User.Email ?? "";
            _editAvatarHue  = me.User.AvatarHue;
        }
        _editProfileError = "";
        _editProfileOpen = true;
        // Mutually exclusive with the password form to keep the drawer tidy.
        _changePwOpen = false;
    }

    private void ToggleChangePassword()
    {
        _changePwOpen = !_changePwOpen;
        if (_changePwOpen)
        {
            _pwCurrent = _pwNew = _pwRepeat = "";
            _changePwError = "";
            _editProfileOpen = false;
        }
    }

    private async Task SubmitEditProfileAsync()
    {
        _editProfileError = "";
        var trimmedName = _editName.Trim();
        if (string.IsNullOrEmpty(trimmedName))
        {
            _editProfileError = "Name cannot be empty.";
            return;
        }
        _editProfileBusy = true;
        StateHasChanged();
        try
        {
            var updated = await Api.UpdateMyProfileAsync(new UpdateMyProfileRequest(
                Name:      trimmedName,
                Email:     string.IsNullOrWhiteSpace(_editEmail) ? null : _editEmail.Trim(),
                AvatarHue: _editAvatarHue));
            // Refresh global Me cache so the topbar avatar chip + sidebar
            // pick up the new values without a full reload. RefreshMeAsync
            // re-pulls /api/me which carries the freshly-saved Name/Email/Hue.
            await UserCtx.RefreshMeAsync();
            _editProfileOpen = false;
            Toasts.ShowSuccess("Profile updated");
        }
        catch (Exception ex)
        {
            _editProfileError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _editProfileBusy = false;
            StateHasChanged();
        }
    }

    private async Task SubmitChangePasswordAsync()
    {
        _changePwError = "";
        if (string.IsNullOrEmpty(_pwCurrent))
        {
            _changePwError = "Current password is required.";
            return;
        }
        if (_pwNew.Length < 6)
        {
            _changePwError = "New password must be at least 6 characters.";
            return;
        }
        if (_pwNew != _pwRepeat)
        {
            _changePwError = "Passwords don't match.";
            return;
        }
        _changePwBusy = true;
        StateHasChanged();
        try
        {
            await Api.ChangeMyPasswordAsync(new ChangePasswordRequest(_pwCurrent, _pwNew));
            _changePwOpen = false;
            _pwCurrent = _pwNew = _pwRepeat = "";
            Toasts.ShowSuccess("Password changed");
        }
        catch (Exception ex)
        {
            // The server returns 400 with {error} JSON for the "current password is
            // incorrect" + min-length cases. Surface the underlying message when we
            // can, otherwise the generic message keeps the form open.
            _changePwError = $"Update failed: {ex.Message}";
        }
        finally
        {
            _changePwBusy = false;
            StateHasChanged();
        }
    }

    /// <summary>Read the device-local player-style preference from localStorage
    /// once JS is available. localStorage holds the source of truth — there
    /// is no server-side mirror because the choice (icons-only vs full) is
    /// often per-device (e.g. icons-only on living-room TV, full on phone).
    /// Merged with the user-roster fetch (second pre-merge block had a
    /// duplicate OnAfterRenderAsync override that broke the build).</summary>
    private async Task LoadPlayerStyleAsync()
    {
        try
        {
            var v = await JS.InvokeAsync<string?>(
                "eval", "localStorage.getItem('animarr_player_style')");
            if (v == "icons" || v == "full")
            {
                _playerStyle = v;
                StateHasChanged();
            }
        }
        catch { /* localStorage unavailable — keep default */ }
    }

    private async Task OnPlayerStyleSelect(string style)
    {
        if (style != "full" && style != "icons") return;
        _playerStyle = style;
        try
        {
            // animarrPlayer.setStyle writes to localStorage AND updates any
            // live HUD via data-style attribute swap, so the change is live
            // even when the user toggles while the player is open.
            await JS.InvokeVoidAsync("animarrPlayer.setStyle", style);
        }
        catch { /* JS unavailable — preference is still set in _playerStyle */ }
        StateHasChanged();
    }

    /// <summary>PATCH /api/me/preferences with the diff this tab cares about,
    /// store the new payload in UserContextState so accent/backdrop/etc.
    /// re-apply globally. Errors are swallowed — UI still reflects the local
    /// change while the server retry happens; next LoadAsync converges.</summary>
    private async Task PatchAsync(UpdatePreferencesRequest req)
    {
        try
        {
            var updated = await Api.UpdateMyPreferencesAsync(req);
            UserCtx.SetPreferences(updated);
        }
        catch { }
    }

    private async Task OnBackdropToggle(bool v)
    {
        _backdropEnabled = v;
        await PatchAsync(new UpdatePreferencesRequest(
            null, BackdropEnabled: v, null, null, null, null, null, null, null, null, null, null, null));
    }

    private async Task OnTvModeToggle(bool v)
    {
        _tvMode = v;
        try
        {
            // Reflect the toggle in the DOM immediately so .tv-focus heavier
            // rings and the larger base font-size kick in without a reload.
            await JS.InvokeVoidAsync("eval",
                v ? "document.documentElement.classList.add('tv-mode')"
                  : "document.documentElement.classList.remove('tv-mode')");
        }
        catch { }
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, TvMode: v, null, null, null, null, null, null, null));
    }

    private async Task OnPassthroughToggle(bool v)
    {
        _passthrough = v;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, AudioPassthrough: v, null, null));
    }

    private async Task OnNormalizeToggle(bool v)
    {
        _normalize = v;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, NormalizeVolume: v, null));
    }

    private async Task OnAudioPrefChanged(ChangeEventArgs e)
    {
        _audioPref = e.Value?.ToString() ?? _audioPref;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, AudioPreferredLanguage: _audioPref, null, null, null, null, null, null));
    }

    private async Task OnSubPrefChanged(ChangeEventArgs e)
    {
        _subPref = e.Value?.ToString() ?? _subPref;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, SubtitlePreferredLanguage: _subPref, null, null, null, null, null));
    }

    private async Task OnSubSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            _subSize = n;
            await PatchAsync(new UpdatePreferencesRequest(
                null, null, null, null, null, null, null, null, SubtitleSize: n, null, null, null, null));
        }
    }

    private async Task OnVolumeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            _volume = n;
            await PatchAsync(new UpdatePreferencesRequest(
                null, null, null, null, null, null, null, null, null, DefaultVolume: n, null, null, null));
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        _language = e.Value?.ToString() ?? _language;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, null, Language: _language));
        // Hot-swap the pack so subscribers (MainLayout) see the new dict
        // immediately — but most page-level components don't subscribe to
        // L.LanguageChanged and would keep rendering English strings.
        // The honest fix: a hard reload of the current URL. UserCtx.Loaded
        // re-runs, prefs come back from the server with the new language,
        // and MainLayout calls Loc.LoadAsync(prefLang) at boot. Every L[...]
        // lookup across the app now resolves against the new dict. Losing
        // current-page state (filter chip, scroll position) is acceptable —
        // language changes are rare and the user just asked for one.
        try { await Loc.LoadAsync(_language); } catch { /* fallback handled in Loc */ }
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task SignOut()
    {
        await UserCtx.SignOutAsync();
        await Close();
        Nav.NavigateTo("/welcome", forceLoad: false);
    }

    // ─── Tab body renderers ────────────────────────────────────

    private RenderFragment RenderIdentity(MeDto me) => __builder =>
    {
        <div class="d-profile__identity">
            @* v5: server management moved to its own "Servers" tab so the
               Identity tab is purely user-focused (current user header +
               switch-user roster + edit profile / change password). *@

            @* ── SWITCH USER block (v5 PIN per-user-per-device) ──
                 Lists every user that exists on this server. Tapping a card:
                   • current user → no-op
                   • no PIN       → POST /api/auth/switch-user with null pin
                   • has PIN      → opens the keypad dialog
                 The strip is hidden entirely if GetUsersAsync fails (403 for
                 non-admin viewers — only Master sees the roster).  *@
            @if (_users.Length > 0)
            {
                <div class="d-profile__users-block">
                    <div class="d-profile__field-label">
                        @(string.Format(L["profile.switch_user_label"], ServerReg.Current?.Name ?? "this server"))
                    </div>
                    <div class="d-profile__users-strip" role="list">
                        @foreach (var u in _users)
                        {
                            var user = u;
                            var isMe = user.Id == me.User.Id;
                            <button type="button"
                                    class="@($"d-profile__user-card tv-focus {(isMe ? "is-me" : "")}")"
                                    role="listitem"
                                    title="@user.Name"
                                    disabled="@(_switchBusy || isMe)"
                                    @onclick="@(() => OnUserCardClick(user))">
                                <span class="d-profile__user-card-avatar">
                                    <Avatar Name="@user.Name" HueOverride="user.AvatarHue"
                                            ImagePath="@user.AvatarPath" Size="md" />
                                    @if (user.HasPin)
                                    {
                                        <span class="d-profile__user-card-pin-badge" aria-label="PIN required">
                                            <DIcon Name="lock" Size="9" />
                                        </span>
                                    }
                                </span>
                                <span class="d-profile__user-card-name">@user.Name</span>
                                <span class="d-profile__user-card-meta">
                                    @if (isMe)
                                    {
                                        <span>you</span>
                                    }
                                    else
                                    {
                                        @user.RoleName
                                    }
                                </span>
                            </button>
                        }
                        @if (UserCtx.Can(p => p.ManageUsers))
                        {
                            <button type="button"
                                    class="d-profile__user-card d-profile__user-card--add tv-focus"
                                    @onclick="OnAddUserClick">
                                <span class="d-profile__user-card-avatar d-profile__user-card-avatar--dashed">+</span>
                                <span class="d-profile__user-card-name d-profile__user-card-name--dim">
                                    @L["profile.add_user"]
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="d-profile__kv">
                <span class="d-profile__kv-key">USERNAME</span>
                <span class="d-profile__kv-val">@me.User.Username</span>
                <span class="d-profile__kv-key">ROLE</span>
                <span class="d-profile__kv-val d-profile__kv-val--accent">@me.User.RoleName.ToUpperInvariant()</span>
                <span class="d-profile__kv-key">EMAIL</span>
                <span class="d-profile__kv-val">@(string.IsNullOrEmpty(me.User.Email) ? "—" : me.User.Email)</span>
                <span class="d-profile__kv-key">CREATED</span>
                <span class="d-profile__kv-val d-profile__kv-val--dim">@me.User.CreatedAt.ToString("yyyy-MM-dd")</span>
            </div>

            @* ── Edit profile inline form ────────────────────────
                 Toggles open below the button row. Empty Name is rejected
                 server-side; Email is optional. AvatarHue is currently
                 derived from name-hash on first sign-in — letting the user
                 nudge it here means their card colour persists across
                 device migrations (server stores the override). *@
            <button type="button" class="d-profile__inline-btn tv-focus"
                    @onclick="@(() => ToggleEditProfile())">
                <DIcon Name="pencil" Size="13" /> @(_editProfileOpen ? "Cancel" : "Edit profile")
            </button>
            @if (_editProfileOpen)
            {
                <div class="d-profile__inline-form">
                    @if (!string.IsNullOrEmpty(_editProfileError))
                    {
                        <div class="d-profile__inline-error">@_editProfileError</div>
                    }
                    <label class="d-profile__field">
                        <span class="d-profile__field-label">DISPLAY NAME</span>
                        <input class="d-profile__inline-input" type="text"
                               value="@_editName"
                               @oninput="@((ChangeEventArgs e) => _editName = e.Value?.ToString() ?? "")" />
                    </label>
                    <label class="d-profile__field">
                        <span class="d-profile__field-label">EMAIL (OPTIONAL)</span>
                        <input class="d-profile__inline-input" type="email"
                               value="@_editEmail"
                               @oninput="@((ChangeEventArgs e) => _editEmail = e.Value?.ToString() ?? "")" />
                    </label>
                    <label class="d-profile__field">
                        <span class="d-profile__field-label">AVATAR HUE · @_editAvatarHue°</span>
                        <input class="d-profile__range" type="range" min="0" max="359" step="1"
                               value="@_editAvatarHue"
                               @oninput="@((ChangeEventArgs e) => { if (int.TryParse(e.Value?.ToString(), out var n)) _editAvatarHue = n; })" />
                    </label>
                    <div class="d-profile__inline-actions">
                        <Btn Variant="primary" Size="sm" Loading="@_editProfileBusy"
                             OnClick="SubmitEditProfileAsync">Save changes</Btn>
                        <Btn Variant="ghost" Size="sm" OnClick="@(() => _editProfileOpen = false)">Cancel</Btn>
                    </div>
                </div>
            }

            @* ── Change password inline form ─────────────────────
                 Three inputs (current / new / repeat). Submits to
                 POST /api/me/password — server validates the current
                 password and enforces a 6-char minimum on the new value. *@
            <button type="button" class="d-profile__inline-btn tv-focus"
                    @onclick="@(() => ToggleChangePassword())">
                <DIcon Name="key" Size="13" /> @(_changePwOpen ? "Cancel" : "Change password")
            </button>
            @if (_changePwOpen)
            {
                <div class="d-profile__inline-form">
                    @if (!string.IsNullOrEmpty(_changePwError))
                    {
                        <div class="d-profile__inline-error">@_changePwError</div>
                    }
                    <label class="d-profile__field">
                        <span class="d-profile__field-label">CURRENT PASSWORD</span>
                        <input class="d-profile__inline-input" type="password"
                               value="@_pwCurrent"
                               @oninput="@((ChangeEventArgs e) => _pwCurrent = e.Value?.ToString() ?? "")" />
                    </label>
                    <label class="d-profile__field">
                        <span class="d-profile__field-label">NEW PASSWORD (min 6)</span>
                        <input class="d-profile__inline-input" type="password"
                               value="@_pwNew"
                               @oninput="@((ChangeEventArgs e) => _pwNew = e.Value?.ToString() ?? "")" />
                    </label>
                    <label class="d-profile__field">
                        <span class="d-profile__field-label">REPEAT NEW PASSWORD</span>
                        <input class="d-profile__inline-input" type="password"
                               value="@_pwRepeat"
                               @oninput="@((ChangeEventArgs e) => _pwRepeat = e.Value?.ToString() ?? "")" />
                    </label>
                    <div class="d-profile__inline-actions">
                        <Btn Variant="primary" Size="sm" Loading="@_changePwBusy"
                             OnClick="SubmitChangePasswordAsync">Update password</Btn>
                        <Btn Variant="ghost" Size="sm" OnClick="@(() => _changePwOpen = false)">Cancel</Btn>
                    </div>
                </div>
            }

            <div class="d-profile__spacer"></div>

            @* ── Desktop-only nav rows — these duplicate the entries that
                 sit at the root of the mobile drilldown list (Pair a TV,
                 Server settings, Sign out), so on phone we hide this whole
                 block via CSS and let the root list be the single source of
                 truth. On desktop there's no root list (horizontal tabs
                 instead), so the rows stay visible inside the Identity tab. *@
            <div class="d-profile__desktop-actions">
                @* ── Pair a TV — opens /login (the host page for the QR scanner
                     modal). The button has nothing to do with admin
                     capabilities; any signed-in user can pair their own TV. *@
                <button type="button" class="d-profile__nav-row tv-focus"
                        @onclick="OnPairTvClick">
                    <span class="d-profile__nav-row__ic">
                        <DIcon Name="qr-code" Size="14" />
                    </span>
                    <span class="d-profile__nav-row__body">
                        <span class="d-profile__nav-row__name">Pair a TV</span>
                        <span class="d-profile__nav-row__meta">Scan the QR shown on your TV's pairing screen.</span>
                    </span>
                    <DIcon Name="chev-r" Size="13" />
                </button>

                @* ── Server settings deep-link (gated by systemSettings).
                     Sits directly above SIGN OUT so admins can reach
                     LLM / patterns / folders / downloads config without
                     hunting for a separate route. *@
                @if (UserCtx.Can(p => p.SystemSettings))
                {
                    <button type="button" class="d-profile__nav-row tv-focus"
                            @onclick="OnServerSettingsClick">
                        <span class="d-profile__nav-row__ic">
                            <DIcon Name="settings" Size="14" />
                        </span>
                        <span class="d-profile__nav-row__body">
                            <span class="d-profile__nav-row__name">@L["profile.server_settings_title"]</span>
                            <span class="d-profile__nav-row__meta">@L["profile.server_settings_sub"]</span>
                        </span>
                        <DIcon Name="chev-r" Size="13" />
                    </button>
                }

                <button type="button" class="d-profile__signout tv-focus" @onclick="SignOut">
                    <DIcon Name="logout" Size="13" /> SIGN OUT
                </button>
            </div>
        </div>
    };

    private async Task OnPairTvClick()
    {
        // Close the drawer first so the user lands on a dedicated pairing
        // screen — /pair-confirm offers tabs for QR scan and manual 6-digit
        // code entry, both wired to POST /api/auth/pair/confirm.
        await Close();
        Nav.NavigateTo("/pair-confirm");
    }

    private async Task OnDownloadsClick()
    {
        // Phone replaces the bottom tabbar with this drilldown list, so the
        // Downloads tab moved here. /downloads is the v4 alias that renders
        // the same Torrents page — easier-to-read URL for the user.
        await Close();
        Nav.NavigateTo("/downloads");
    }

    private async Task OnServerSettingsClick()
    {
        await Close();
        Nav.NavigateTo("/server");
    }

    // ─── v5 multi-server: switch / add server helpers ─────────────────

    private bool _addServerOpen;
    private string _addUrl = "";
    private string _addError = "";
    private bool _adding;

    /// <summary>Switch the active server. SetCurrentAsync already flipped the
    /// shared HttpClient's BaseAddress to the new origin, so subsequent calls
    /// resolve correctly. WASM still wants a hard navigate when origins differ
    /// (cookies + bundle origin are domain-scoped); MAUI keeps a soft nav
    /// because the WebView never reloads and forceLoad on an external host
    /// gets bounced to the system browser.</summary>
    private async Task OnSwitchServer(RegisteredServerDto target)
    {
        await ServerReg.SetCurrentAsync(target.ServerId);
        await Close();

        if (OperatingSystem.IsBrowser())
        {
            var sameOrigin = string.Equals(
                new Uri(target.BaseUrl).GetLeftPart(UriPartial.Authority),
                new Uri(Nav.Uri).GetLeftPart(UriPartial.Authority),
                StringComparison.OrdinalIgnoreCase);

            if (sameOrigin)
                Nav.NavigateTo("/login", replace: true);
            else
                Nav.NavigateTo(target.BaseUrl.TrimEnd('/') + "/login", forceLoad: true);
        }
        else
        {
            // MAUI / native shell — HttpClient is already pointed at the new
            // origin; stay inside the WebView and let /login mount fresh.
            Nav.NavigateTo("/login", replace: true);
        }
    }

    private async Task OnAddServer()
    {
        _addError = "";
        var url = _addUrl.Trim();
        if (string.IsNullOrEmpty(url)) { _addError = "Enter a URL."; return; }
        if (!url.Contains("://", StringComparison.Ordinal)) url = "http://" + url;

        _adding = true;
        StateHasChanged();
        try
        {
            var entry = await ServerReg.AddServerAsync(url);
            if (entry is null)
            {
                _addError = "Couldn't reach an Animarr server at that URL.";
                return;
            }
            _addUrl = "";
            _addServerOpen = false;
        }
        catch (Exception ex)
        {
            _addError = $"Probe failed: {ex.Message}";
        }
        finally
        {
            _adding = false;
            StateHasChanged();
        }
    }

    private async Task OnAddKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_adding) await OnAddServer();
    }

    // ─── v5 PIN per-user-per-device: switch-user helpers ──────────────
    //
    // Lifecycle:
    //   • drawer opens → OnAfterRender fetches /api/users (no-op if 403).
    //   • user taps card →
    //         current user → ignored (button is disabled but defence in depth)
    //         no PIN       → SwitchUserAsync(target, null) directly
    //         has PIN      → opens keypad dialog
    //   • keypad submits → SwitchUserAsync(target, pin); null result = wrong
    //                       PIN, set _keypadError and let the keypad shake.
    //   • success → UserCtx.RefreshMeAsync + close drawer + reload root.
    //
    // We keep _users locally rather than calling GetUsersAsync each click —
    // the roster doesn't churn while the drawer is open. Reloaded on every
    // drawer open via OnParametersSet so a freshly-created user appears
    // after the admin returns from /server.

    private UserDto[] _users = Array.Empty<UserDto>();
    private bool _usersLoaded;
    private bool _switchBusy;

    private bool _keypadOpen;
    private UserDto? _keypadTarget;
    private string? _keypadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // On first render: pull device-local player-style from localStorage
        // so the Appearance tab's preview reflects the saved choice.
        if (firstRender) await LoadPlayerStyleAsync();

        // Refresh the roster every time the drawer opens (not just first
        // render). The cheap branch — already loaded and drawer wasn't
        // re-opened — is the common case.
        if (IsOpen && !_usersLoaded)
        {
            _usersLoaded = true;
            try
            {
                _users = await Api.GetUsersAsync();
            }
            catch
            {
                // 403 from non-admin viewers, or transport failure — hide
                // the strip entirely rather than show a broken card. Stays
                // empty until the drawer is closed and re-opened.
                _users = Array.Empty<UserDto>();
            }
            StateHasChanged();
        }
        else if (!IsOpen && _usersLoaded)
        {
            // Reset so the next open re-fetches.
            _usersLoaded = false;
        }
    }

    private async Task OnUserCardClick(UserDto target)
    {
        if (UserCtx.Me is not { } me || target.Id == me.User.Id) return;
        if (_switchBusy) return;

        if (target.HasPin)
        {
            _keypadTarget = target;
            _keypadError = null;
            _keypadOpen  = true;
            return;
        }

        // No PIN configured on the target — switch immediately.
        await TrySwitchAsync(target, pin: null);
    }

    private async Task OnKeypadSubmit(string pin)
    {
        if (_keypadTarget is null) return;
        await TrySwitchAsync(_keypadTarget, pin);
    }

    private void OnKeypadCancel()
    {
        _keypadOpen = false;
        _keypadTarget = null;
        _keypadError = null;
    }

    private async Task TrySwitchAsync(UserDto target, string? pin)
    {
        _switchBusy = true;
        StateHasChanged();
        try
        {
            var newMe = await Api.SwitchUserAsync(new SwitchUserRequest(target.Id, pin));
            if (newMe is null)
            {
                // Wrong PIN — the keypad shakes via OnParametersSet reading
                // a fresh Error value. Stay on the dialog so the user can
                // retype without dismissing.
                _keypadError = L["pin.invalid"];
                _switchBusy = false;
                StateHasChanged();
                return;
            }

            // Success: refresh the global me cache so the topbar + sidebar
            // re-paint with the new identity. Drop the registered users
            // cache so the next open reflects updated LastSeenAt etc.
            await UserCtx.RefreshMeAsync();
            _keypadOpen = false;
            _keypadTarget = null;
            _keypadError = null;
            _users = Array.Empty<UserDto>();
            _usersLoaded = false;
            await Close();
            // Force a hard nav to / so any page-scoped state (folder scope,
            // hue, language pack) re-resolves against the new user's
            // preferences. forceLoad:false keeps WASM happy.
            Nav.NavigateTo("/", replace: true);
        }
        catch
        {
            _keypadError = L["pin.invalid"];
        }
        finally
        {
            _switchBusy = false;
            StateHasChanged();
        }
    }

    /// <summary>v5 fix: previously this just routed to /server which landed
    /// the admin on the Server Settings landing page (Users & Roles tab open
    /// but in "list" view). To actually CREATE a user they had to click
    /// "+ New user" again. The "+ Add user" affordance in the profile drawer
    /// implies "I want to add a user right now" — so we deep-link with
    /// ?panel=users&openForm=user and let ServerSettings + UsersRolesPanel
    /// jump straight to the inline builder form. ServerSettings reads the
    /// query string on first render to pick the active tab + forward
    /// OpenCreateForm=true into UsersRolesPanel.</summary>
    private async Task OnAddUserClick()
    {
        await Close();
        Nav.NavigateTo("/server?panel=users&openForm=user");
    }

    // ─── Servers tab ────────────────────────────────────────────────
    //
    // v5: server management lives in its own tab (was tucked at the top of
    // the Identity tab and crowded the user info). Beyond switch / add, the
    // tab also lets the user rename a registered server in the local
    // registry — useful when two boxes both call themselves "Animarr" or
    // when a Tailscale alias is more memorable than the LAN IP. Pure
    // client-side rename — see ServerRegistryState.RenameAsync for the
    // "why we don't push it to the server" rationale.

    /// <summary>ServerId of the row currently in rename mode (null = none).
    /// We allow only one active edit at a time to keep keyboard focus sane.</summary>
    private string? _renameServerId;
    /// <summary>Working buffer for the rename field.</summary>
    private string  _renameDraft = "";

    private void StartRename(RegisteredServerDto s)
    {
        _renameServerId = s.ServerId;
        _renameDraft    = s.Name;
    }

    private async Task CommitRename()
    {
        if (_renameServerId is null) return;
        var id = _renameServerId;
        var name = _renameDraft;
        _renameServerId = null;
        _renameDraft    = "";
        await ServerReg.RenameAsync(id, name);
    }

    private void CancelRename()
    {
        _renameServerId = null;
        _renameDraft    = "";
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")      await CommitRename();
        else if (e.Key == "Escape") CancelRename();
    }

    private RenderFragment RenderServers() => __builder =>
    {
        <div class="d-profile__section">
            <div class="d-profile__server-block">
                <div class="d-profile__field-label">Servers</div>

                @if (ServerReg.Count == 0)
                {
                    <div class="d-profile__server-empty">
                        No servers registered yet. Add one below — manual IP, hostname or Tailscale name all work.
                    </div>
                }

                @if (ServerReg.Current is { } current)
                {
                    @ServerRow(current, isCurrent: true)
                }

                @foreach (var other in ServerReg.Servers.Where(s =>
                    ServerReg.Current is null || s.ServerId != ServerReg.Current.ServerId))
                {
                    @ServerRow(other, isCurrent: false)
                }

                <button type="button" class="d-profile__server-row d-profile__server-row--add tv-focus"
                        @onclick="@(() => _addServerOpen = !_addServerOpen)">
                    <span class="d-profile__server-row__ic d-profile__server-row__ic--dashed">+</span>
                    <span class="d-profile__server-row__body">
                        <span class="d-profile__server-row__name d-profile__server-row__name--dim">Add server</span>
                        <span class="d-profile__server-row__meta">manual IP / Tailscale</span>
                    </span>
                </button>

                @if (_addServerOpen)
                {
                    <div class="d-profile__server-add">
                        <input type="text"
                               class="d-profile__server-add__input"
                               placeholder="http://192.168.1.50:8080"
                               value="@_addUrl"
                               @oninput="@((ChangeEventArgs e) => _addUrl = e.Value?.ToString() ?? "")"
                               @onkeypress="OnAddKeyPress" />
                        @if (!string.IsNullOrEmpty(_addError))
                        {
                            <div class="d-profile__server-add__error">@_addError</div>
                        }
                        <div class="d-profile__server-add__row">
                            <Btn Variant="primary" Size="sm" Loading="@_adding"
                                 OnClick="OnAddServer"
                                 Disabled="@(string.IsNullOrWhiteSpace(_addUrl))">
                                Probe
                            </Btn>
                            <Btn Variant="flat" Size="sm" OnClick="@(() => { _addServerOpen = false; _addError = ""; })">
                                Cancel
                            </Btn>
                        </div>
                    </div>
                }
            </div>
        </div>
    };

    /// <summary>One row in the servers list. Renders either the static
    /// name + meta, OR the inline rename input when the user clicked the
    /// pencil. Current row also gets the "current" right-side label;
    /// other rows get a "switch" action button.</summary>
    private RenderFragment ServerRow(RegisteredServerDto s, bool isCurrent) => __builder =>
    {
        var srv = s;
        var editing = _renameServerId == srv.ServerId;
        var rowClass = isCurrent
            ? "d-profile__server-row d-profile__server-row--current"
            : "d-profile__server-row";

        <div class="@rowClass">
            <span class="d-profile__server-row__ic @(isCurrent ? "" : "d-profile__server-row__ic--dim")">
                <DIcon Name="server" Size="14" />
            </span>

            <span class="d-profile__server-row__body">
                @if (editing)
                {
                    <input type="text"
                           class="d-profile__server-rename"
                           value="@_renameDraft"
                           @oninput="@((ChangeEventArgs e) => _renameDraft = e.Value?.ToString() ?? "")"
                           @onkeydown="OnRenameKey"
                           @onblur="CommitRename"
                           autofocus />
                    <span class="d-profile__server-row__meta">
                        Enter to save · Esc to cancel
                    </span>
                }
                else
                {
                    <span class="d-profile__server-row__name">@srv.Name</span>
                    <span class="d-profile__server-row__meta">
                        @srv.BaseUrl@(srv.TitleCount is int c ? $" · {c} titles" : "")
                    </span>
                }
            </span>

            @* Right cluster. Editing shows only ✓ + ✕; otherwise a pencil +
               the current-label or switch-button. Pencil is always
               available so non-current servers can be renamed without
               switching to them first. *@
            <span class="d-profile__server-row__actions">
                @if (editing)
                {
                    <button type="button" class="d-profile__server-row__btn tv-focus"
                            @onclick="CommitRename" aria-label="Save name">
                        <DIcon Name="check" Size="13" />
                    </button>
                    <button type="button" class="d-profile__server-row__btn tv-focus"
                            @onclick="CancelRename" aria-label="Cancel rename">
                        <DIcon Name="x" Size="13" />
                    </button>
                }
                else
                {
                    <button type="button" class="d-profile__server-row__btn tv-focus"
                            @onclick="@(() => StartRename(srv))"
                            aria-label="Rename server">
                        <DIcon Name="pencil" Size="13" />
                    </button>
                    @if (isCurrent)
                    {
                        <span class="d-profile__server-row__right">current</span>
                    }
                    else
                    {
                        <button type="button" class="d-profile__server-row__btn d-profile__server-row__btn--switch tv-focus"
                                @onclick="@(() => OnSwitchServer(srv))">
                            switch
                        </button>
                    }
                }
            </span>
        </div>
    };

    private RenderFragment RenderAppearance() => __builder =>
    {
        <div class="d-profile__section">
            @* All Appearance sections share the same "title + hint then
               control" header shape so they read as a single column of
               settings rather than mixing tiny mono labels and big toggle
               titles — earlier the THEME block looked like a different
               type of control than TV mode. Now they all use d-profile__
               section-head + body. *@

            <div class="d-profile__section-block">
                <div class="d-profile__section-head">
                    <div class="d-profile__section-title">Theme</div>
                    <div class="d-profile__section-hint">Pick the personality palette and typography.</div>
                </div>
                <div class="d-profile__theme-grid">
                    @foreach (var th in Themes)
                    {
                        var t = th;
                        var active = string.Equals(_theme, t.Slug, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="@($"d-profile__theme-card tv-focus {(active ? "is-active" : "")}")"
                                title="@t.Description"
                                @onclick="@(() => OnSelectTheme(t.Slug))">
                            <span class="d-profile__theme-card__preview"
                                  style="@($"--th-bg: {t.PreviewBg}; --th-accent: {t.PreviewAccent}; --th-text: {t.PreviewText};")">
                                <span class="d-profile__theme-card__sample">Aa</span>
                            </span>
                            <span class="d-profile__theme-card__name">@t.Name</span>
                        </button>
                    }
                </div>
            </div>

            <div class="d-profile__section-block">
                <div class="d-profile__section-head">
                    <div class="d-profile__section-title">Accent color</div>
                    <div class="d-profile__section-hint">Tints buttons, links, hero highlights and the brand mark.</div>
                </div>
                <div class="d-profile__swatches">
                    @foreach (var sw in AccentSwatches)
                    {
                        var s = sw;
                        var active = _accentHue == s.Hue;
                        <button type="button"
                                class="@($"d-profile__swatch tv-focus {(active ? "is-active" : "")}")"
                                style="@($"--swatch-color: oklch({s.L} {s.C} {s.Hue});")"
                                title="@s.Label"
                                @onclick="@(() => OnSelectAccent(s.Hue))"></button>
                    }
                </div>
            </div>

            <div class="d-profile__toggle-row">
                <div class="d-profile__toggle-text">
                    <div class="d-profile__toggle-title">Animated backdrop</div>
                    <div class="d-profile__toggle-hint">Fanart slideshow behind every page.</div>
                </div>
                <Toggle Checked="@_backdropEnabled" CheckedChanged="OnBackdropToggle" />
            </div>

            <div class="d-profile__toggle-row">
                <div class="d-profile__toggle-text">
                    <div class="d-profile__toggle-title">TV mode</div>
                    <div class="d-profile__toggle-hint">Larger focus rings + bigger hit targets for remote-control navigation.</div>
                </div>
                <Toggle Checked="@_tvMode" CheckedChanged="OnTvModeToggle" />
            </div>

            @* ── Player HUD style ─────────────────────────────────────
                 Device-local preference (localStorage) for how the
                 in-player HUD renders: "full" with text labels + glass
                 chip background, or "icons" — naked icon hit-targets,
                 no background, no labels. *@
            <div class="d-profile__section-block">
                <div class="d-profile__section-head">
                    <div class="d-profile__section-title">Player style</div>
                    <div class="d-profile__section-hint">
                        How the in-player controls render. Saved per device — set
                        this differently on a TV vs phone if you like.
                    </div>
                </div>
                <div class="d-profile__pager-grid">
                    @{
                        var fullActive  = string.Equals(_playerStyle, "full",  StringComparison.OrdinalIgnoreCase);
                        var iconsActive = string.Equals(_playerStyle, "icons", StringComparison.OrdinalIgnoreCase);
                    }
                    <button type="button"
                            class="@($"d-profile__pager-card tv-focus {(fullActive ? "is-active" : "")}")"
                            title="Glass buttons with icons and labels"
                            @onclick="@(() => OnPlayerStyleSelect("full"))">
                        <span class="d-profile__pager-card__preview">
                            <span class="d-profile__player-style-preview d-profile__player-style-preview--full">
                                <span class="d-profile__player-style-chip is-primary">▶ Play</span>
                                <span class="d-profile__player-style-chip">Next</span>
                                <span class="d-profile__player-style-chip">CC</span>
                            </span>
                        </span>
                        <span class="d-profile__pager-card__name">Full</span>
                    </button>
                    <button type="button"
                            class="@($"d-profile__pager-card tv-focus {(iconsActive ? "is-active" : "")}")"
                            title="Just the icons, no labels, no background"
                            @onclick="@(() => OnPlayerStyleSelect("icons"))">
                        <span class="d-profile__pager-card__preview">
                            <span class="d-profile__player-style-preview d-profile__player-style-preview--icons">
                                <span class="d-profile__player-style-icon is-primary">▶</span>
                                <span class="d-profile__player-style-icon">⏵</span>
                                <span class="d-profile__player-style-icon">CC</span>
                            </span>
                        </span>
                        <span class="d-profile__pager-card__name">Icons only</span>
                    </button>
                </div>
            </div>

            @* ── Hero pager style (v5 design board variants F/G/H) ──
                 The Continue Watching hero on Home rotates through up to
                 5 in-progress titles. Three pager styles ship; the user
                 picks which fits their vibe. Preview swatches mimic the
                 actual pager markup so a glance is enough to pick. *@
            <div class="d-profile__section-block">
                <div class="d-profile__section-head">
                    <div class="d-profile__section-title">Hero pager style</div>
                    <div class="d-profile__section-hint">
                        Layout of the Continue Watching slot pager. Only visible
                        when you have in-progress titles — the Featured hero
                        below uses its own numbered side rail.
                    </div>
                </div>
                <div class="d-profile__pager-grid">
                    @foreach (var p in PagerOptions)
                    {
                        var opt = p;
                        var active = string.Equals(_heroPagerStyle, opt.Key, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="@($"d-profile__pager-card tv-focus {(active ? "is-active" : "")}")"
                                title="@opt.Hint"
                                @onclick="@(() => OnSelectPagerStyle(opt.Key))">
                            <span class="d-profile__pager-card__preview">
                                @switch (opt.Key)
                                {
                                    case "f":
                                        @* F: 4 transparent strokes — all dim, one accent *@
                                        <span class="d-profile__pager-card__strokes">
                                            <span class="d-profile__pager-card__stroke is-active"></span>
                                            <span class="d-profile__pager-card__stroke"></span>
                                            <span class="d-profile__pager-card__stroke"></span>
                                            <span class="d-profile__pager-card__stroke"></span>
                                        </span>
                                        break;
                                    case "g":
                                        @* G: 4 dashes flanked by hover chevrons *@
                                        <span class="d-profile__pager-card__chevrows">
                                            <span class="d-profile__pager-card__chev">&lsaquo;</span>
                                            <span class="d-profile__pager-card__dashes">
                                                <span class="d-profile__pager-card__dash is-active"></span>
                                                <span class="d-profile__pager-card__dash"></span>
                                                <span class="d-profile__pager-card__dash"></span>
                                                <span class="d-profile__pager-card__dash"></span>
                                            </span>
                                            <span class="d-profile__pager-card__chev">&rsaquo;</span>
                                        </span>
                                        break;
                                    case "h":
                                        @* H: 4 numbered pills + chevrons *@
                                        <span class="d-profile__pager-card__chevrows">
                                            <span class="d-profile__pager-card__chev">&lsaquo;</span>
                                            <span class="d-profile__pager-card__pills">
                                                <span class="d-profile__pager-card__pill is-active">1</span>
                                                <span class="d-profile__pager-card__pill">2</span>
                                                <span class="d-profile__pager-card__pill">3</span>
                                                <span class="d-profile__pager-card__pill">4</span>
                                            </span>
                                            <span class="d-profile__pager-card__chev">&rsaquo;</span>
                                        </span>
                                        break;
                                }
                            </span>
                            <span class="d-profile__pager-card__name">@opt.Label</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    };

    /// <summary>F / G / H pager variants offered in the Appearance tab.
    /// The Key matches what the server validates against in
    /// <c>AuthEndpoints.ValidatePagerStyle</c>; <c>CatalogContinueHero</c>
    /// reads the same string from <c>UserCtx.Preferences.HeroPagerStyle</c>
    /// to pick which markup branch to render.</summary>
    private sealed record PagerOption(string Key, string Label, string Hint);
    private static readonly PagerOption[] PagerOptions = new[]
    {
        new PagerOption("f", "Transparent", "Long strokes with title underneath each slot."),
        new PagerOption("g", "Chevrons",    "Hover-revealed prev/next chevrons + dash pager."),
        new PagerOption("h", "Numbered",    "Numbered pills with chevrons — best for many slots."),
    };

    private async Task OnSelectPagerStyle(string key)
    {
        _heroPagerStyle = key;
        // PATCH first, then mirror into UserCtx so CatalogContinueHero (which
        // subscribes to OnChange via UserCtx) re-renders without an extra
        // round-trip. Optimistic update: failing the PATCH leaves the local
        // state slightly out of sync until the next load — acceptable.
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, null, null,
            Theme: null, HeroPagerStyle: key));
        StateHasChanged();
    }

    // 10 personality themes. PreviewBg / PreviewAccent / PreviewText are tiny
