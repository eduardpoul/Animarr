                <select class="d-profile__select" value="@_audioPref" @onchange="OnAudioPrefChanged">
                    <option>Japanese</option>
                    <option>Mandarin</option>
                    <option>English</option>
                    <option>Russian</option>
                    <option>Korean</option>
