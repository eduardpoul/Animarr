@*
    Edit Metadata drawer — slimmed for the API-driven client.

    Tabs covered:
      • Source IDs  — TMDB / MAL / IMDb links, "paste URL" parser, per-source
        Apply buttons that route through Api.ResolveMediaCandidateAsync
      • Basics      — title / english / cjk / year / type / language / studio /
                      runtime / hue
      • Tags        — chip list + suggested presets
      • Manage      — Re-identify + Delete from catalog

    Skipped relative to Animarr.Web:
      • Poster/Backdrop galleries — server-side MetadataService.GetAvailableImagesAsync
        isn't exposed via the API yet (returns empty from the placeholder
        endpoints). When the metadata client grows that surface, the tabs land
        here as a follow-up.
      • In-drawer rename preview/apply (uses RenameService which doesn't have
        a clean REST surface). Use the History page / Rescan instead.
*@

@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject ToastService Toasts

@if (Item is not null)
{
    <div class="emd-overlay" @onclick="OnCloseAsync"></div>
    <div class="emd">
        <header class="emd__header">
            <div class="emd__header-icon"><DIcon Name="pencil" Size="18" /></div>
            <div class="emd__header-text">
                <div class="emd__overline">EDIT METADATA</div>
                <div class="emd__title">@Item.Title</div>
                <div class="emd__hint">SQLite metadata only — folders on disk stay untouched</div>
            </div>
            <button type="button" class="emd__close" @onclick="OnCloseAsync" aria-label="Close">
                <DIcon Name="x" Size="20" />
            </button>
        </header>

        <nav class="emd__tabs">
            @foreach (var t in _tabDefs)
            {
                var key = t.Key;
                var label = t.Value;
                <button type="button"
                        class="@($"emd__tab {(_tab == key ? "emd__tab--active" : "")}")"
                        @onclick="@(() => SwitchTabAsync(key))">
                    @label
                </button>
            }
        </nav>

        <div class="emd__body">
            @if      (_tab == "ids")        { @SourceIdsTab()   }
            else if  (_tab == "basics")     { @BasicsTab()      }
            else if  (_tab == "poster")     { @PosterTab()      }
            else if  (_tab == "backdrop")   { @BackdropTab()    }
            else if  (_tab == "tags")       { @TagsTab()        }
            else if  (_tab == "categories") { @CategoriesTab()  }
            else if  (_tab == "manage")     { @ManageTab()      }
        </div>

        <footer class="emd__footer">
            <button type="button" class="@($"emd__btn emd__btn--primary {(_saving ? "emd__btn--loading" : "")}")"
                    @onclick="SaveAsync" disabled="@_saving">
                @if (_saving) { <Spinner Size="sm" Tone="light" /> }
                else          { <DIcon Name="check" Size="14" /> }
                @(_saving ? "Saving…" : "Save changes")
            </button>
            <button type="button" class="emd__btn emd__btn--ghost" @onclick="OnCloseAsync">Cancel</button>
            <div class="emd__footer-spacer"></div>
            <button type="button" class="emd__btn emd__btn--flat emd__btn--xs" @onclick="ReidentifyAsync">
                <DIcon Name="magic" Size="13" /> Re-run LLM
            </button>
        </footer>
    </div>
}

@code {
    [Parameter, EditorRequired] public MediaItemDto? Item { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _tab = "ids";
    private bool _saving;

    private static readonly KeyValuePair<string, string>[] _tabDefs =
    [
        new("ids",        "Source IDs"),
        new("basics",     "Basics"),
        new("poster",     "Poster"),
        new("backdrop",   "Backdrop"),
        new("tags",       "Tags"),
        new("categories", "Categories"),
        new("manage",     "Manage"),
    ];

    // ── Image gallery state (Poster / Backdrop tabs) ──
    // One-shot lazy fetch on first visit per tab. Apply is per-candidate so
    // the user can compare and pick. Each candidate carries the URL plus
    // pixel width/height when the source reports them (TMDB does; MAL
    // doesn't and ships 0/0 — the dimension badge hides itself in that case).
    private ImageCandidateDto[]? _posterCandidates;
    private ImageCandidateDto[]? _backdropCandidates;
    private bool _postersLoading;
    private bool _backdropsLoading;
    private string? _applyingImageUrl;

    // ── Basics state ──
    private string  _bTitle = "";
    private string? _bEnglish;
    private string? _bCjk;
    private int?    _bYear;
    private MediaItemType _bType;
    private string? _bLanguage;
    private string? _bStudio;
    private int?    _bRuntime;
    private int?    _bHue;

    // ── Tags ──
    private List<string> _tags = new();
    private string _newTag = "";

    // ── Categories (manual override) ──
    // _allCategories — fetched once on first visit to the Categories tab.
    // _selectedCategoryIds — drawer-local set; PUT'd to /api/media/{id}/categories on Save.
    private CategoryDto[]? _allCategories;
    private bool _categoriesLoading;
    private bool _categoriesDirty;
    private readonly HashSet<Guid> _selectedCategoryIds = new();

    // ── Source IDs ──
    private string? _tmdbIdInput;
    private string? _malIdInput;
    private string? _imdbIdInput;
    private string  _pasteUrl = "";
    private bool _tmdbIsTv = true;

    private static readonly string[] _suggestedTags =
    [
        "Cultivation", "Donghua", "Action", "Romance", "Fantasy",
        "Mecha", "Slice of Life", "Mystery", "Shonen", "Adventure",
    ];

    // ── Manage state ──
    private bool _confirmDelete;

    protected override void OnParametersSet()
    {
        if (Item is null) return;
        _bTitle      = Item.Title;
        _bEnglish    = Item.EnglishTitle;
        _bCjk        = Item.CjkTitle;
        _bYear       = Item.Year;
        _bType       = Item.MediaType;
        _bLanguage   = Item.Language;
        _bStudio     = Item.Studio;
        _bRuntime    = Item.Runtime;
        _bHue        = Item.Hue;
        _tmdbIdInput = Item.TmdbId?.ToString();
        _malIdInput  = Item.MalId?.ToString();
        _imdbIdInput = Item.ImdbId;
        _tmdbIsTv    = Item.MediaType != MediaItemType.Movie;
        _tags        = Item.Tags?.ToList() ?? new();

        // Seed selected categories from the DTO's current set so the checkbox
        // state mirrors what's actually persisted. _categoriesDirty stays
        // false until the user toggles something — keeps Save from PUT'ing
        // an unchanged set every time.
        _selectedCategoryIds.Clear();
        if (Item.CategoryIds is { Length: > 0 } ids)
            foreach (var id in ids) _selectedCategoryIds.Add(id);
        _categoriesDirty = false;
    }

    private async Task OnCloseAsync() => await OnClose.InvokeAsync();

    /// <summary>Switch tab + lazy-fetch the image gallery the first time the
    /// Poster / Backdrop tab is opened.</summary>
    private async Task SwitchTabAsync(string key)
    {
        _tab = key;
        if (Item is null) return;
        if (key == "poster" && _posterCandidates is null && !_postersLoading)
            _ = LoadPosterCandidatesAsync();
        else if (key == "backdrop" && _backdropCandidates is null && !_backdropsLoading)
            _ = LoadBackdropCandidatesAsync();
        else if (key == "categories" && _allCategories is null && !_categoriesLoading)
            _ = LoadCategoriesAsync();
        await Task.CompletedTask;
    }

    private async Task LoadCategoriesAsync()
    {
        _categoriesLoading = true;
        StateHasChanged();
        try { _allCategories = await Api.GetCategoriesAsync(); }
        catch { _allCategories = Array.Empty<CategoryDto>(); }
        _categoriesLoading = false;
        StateHasChanged();
    }

    private void ToggleCategory(Guid id, bool on)
    {
        if (on) _selectedCategoryIds.Add(id);
        else    _selectedCategoryIds.Remove(id);
        _categoriesDirty = true;
    }

    private async Task LoadPosterCandidatesAsync()
    {
        if (Item is null) return;
        _postersLoading = true;
        StateHasChanged();
        try { _posterCandidates = await Api.GetPosterAlternativesAsync(Item.Id); }
        catch { _posterCandidates = Array.Empty<ImageCandidateDto>(); }
        _postersLoading = false;
        StateHasChanged();
    }

    private async Task LoadBackdropCandidatesAsync()
    {
        if (Item is null) return;
        _backdropsLoading = true;
        StateHasChanged();
        try { _backdropCandidates = await Api.GetBackdropAlternativesAsync(Item.Id); }
        catch { _backdropCandidates = Array.Empty<ImageCandidateDto>(); }
        _backdropsLoading = false;
        StateHasChanged();
    }

    private async Task ApplyImageAsync(string imageType, string url)
    {
        if (Item is null) return;
        _applyingImageUrl = url;
        StateHasChanged();
        try
        {
            await Api.ApplyImageAsync(Item.Id, new ApplyImageRequest(imageType, url));
            await OnSaved.InvokeAsync();
        }
        catch { /* swallow */ }
        _applyingImageUrl = null;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (Item is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var request = new UpdateMediaItemRequest(
                Title:         _bTitle.Trim(),
                OriginalTitle: null,
                CjkTitle:      string.IsNullOrWhiteSpace(_bCjk)     ? null : _bCjk.Trim(),
                EnglishTitle:  string.IsNullOrWhiteSpace(_bEnglish) ? null : _bEnglish.Trim(),
                Year:          _bYear,
                MediaType:     _bType,
                Description:   null,
                Tagline:       null,
                Genres:        null,
                Tags:          _tags.ToArray(),
                Status:        null,
                ContentRating: null,
                Runtime:       _bRuntime,
                Language:      string.IsNullOrWhiteSpace(_bLanguage) ? null : _bLanguage.Trim(),
                Studio:        string.IsNullOrWhiteSpace(_bStudio)   ? null : _bStudio.Trim(),
                SeasonLabel:   null,
                Hue:           _bHue,
                TagIds:        null,
                PosterPath:    null,
                FanartPath:    null,
                LogoPath:      null);

            await Api.UpdateMediaItemAsync(Item.Id, request);

            // Categories — only PUT if user actually toggled something in this
            // session. Avoids stomping LLM/heuristic rows with manual=[] when
            // user never visited the Categories tab.
            if (_categoriesDirty)
            {
                try
                {
                    await Api.SetMediaCategoriesAsync(Item.Id, _selectedCategoryIds.ToArray());
                }
                catch { /* swallow — main metadata save already succeeded */ }
            }

            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) { Toasts.ShowError($"Save failed: {ex.Message}"); }
        finally { _saving = false; StateHasChanged(); }
    }

    private async Task ReidentifyAsync()
    {
        if (Item is null) return;
        try { await Api.EnqueueIdentificationAsync(Item.FolderId, forceRefresh: true); }
        catch { /* swallow */ }
    }

    // ── Tag handlers ──
    private void AddTag()
    {
        var t = _newTag.Trim();
        if (string.IsNullOrEmpty(t)) return;
        if (!_tags.Any(x => string.Equals(x, t, StringComparison.OrdinalIgnoreCase)))
            _tags.Add(t);
        _newTag = "";
    }

    private void RemoveTag(string t) =>
        _tags.RemoveAll(x => string.Equals(x, t, StringComparison.OrdinalIgnoreCase));

    private void OnTagKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddTag(); }

    // ── Source-ID handlers ──
    private async Task ApplySourceAsync(string source, string externalId)
    {
        if (Item is null || string.IsNullOrWhiteSpace(externalId)) return;
        try
        {
            await Api.ResolveMediaCandidateAsync(Item.Id,
                new ResolveCandidateRequest(source, externalId.Trim()));
            await OnSaved.InvokeAsync();
        }
        catch { /* swallow */ }
    }

    private Task ApplyTmdbAsync() => ApplySourceAsync(_tmdbIsTv ? "tmdb_tv" : "tmdb_movie", _tmdbIdInput ?? "");
    private Task ApplyMalAsync()  => ApplySourceAsync("mal", _malIdInput ?? "");
    private Task ApplyImdbAsync() => ApplySourceAsync("imdb_tv", _imdbIdInput ?? "");

    private void ParsePastedUrl()
    {
        var u = _pasteUrl.Trim();
        if (u.Length == 0) return;
        var tmdb = System.Text.RegularExpressions.Regex.Match(u, @"themoviedb\.org/(tv|movie)/(\d+)");
        if (tmdb.Success)
        {
            _tmdbIdInput = tmdb.Groups[2].Value;
            _tmdbIsTv    = tmdb.Groups[1].Value == "tv";
            _pasteUrl    = "";
            return;
        }
        var mal = System.Text.RegularExpressions.Regex.Match(u, @"myanimelist\.net/anime/(\d+)");
        if (mal.Success) { _malIdInput = mal.Groups[1].Value; _pasteUrl = ""; return; }
        var imdb = System.Text.RegularExpressions.Regex.Match(u, @"imdb\.com/title/(tt\d+)");
        if (imdb.Success) { _imdbIdInput = imdb.Groups[1].Value; _pasteUrl = ""; return; }
    }

    private async Task DeleteAsync()
    {
        if (Item is null) return;
        try
        {
            await Api.DeleteMediaItemAsync(Item.Id);
            Nav.NavigateTo("/");
            await OnClose.InvokeAsync();
        }
        catch { /* swallow */ }
    }

    // ── Render fragments ──

    private RenderFragment SourceIdsTab() => @<div class="emd-form">
        <div class="emd-automatch">
            <div class="emd-automatch__icon"><DIcon Name="sparkle" Size="14" /></div>
            <div>
                <div class="emd-automatch__title">Auto-match · @($"{(Item!.LlmConfidence ?? 0):P0}")</div>
                <div class="emd-automatch__hint">@(Item.LlmIdentifiedTitle ?? Item.Title) → @Item.Title</div>
            </div>
        </div>

        <div class="emd-idfield">
            <div class="emd-idfield__head">
                <span class="emd-idfield__label">TMDB ID</span>
                @if (Item.TmdbId is not null)
                {
                    var url = $"https://www.themoviedb.org/{(Item.MediaType == MediaItemType.Movie ? "movie" : "tv")}/{Item.TmdbId}";
                    <a href="@url" target="_blank" rel="noopener" class="emd-idfield__link"><DIcon Name="external" Size="10" /> open source</a>
                }
            </div>
            <div class="emd-idfield__row">
                <input class="emd-input emd-input--mono" placeholder="(not linked)"
                       value="@(_tmdbIdInput ?? "")"
                       @oninput="@(e => _tmdbIdInput = e.Value?.ToString())" />
                <div class="emd-segmented" role="group" aria-label="TMDB kind">
                    <button type="button" class="@($"emd-segmented__btn {(_tmdbIsTv ? "emd-segmented__btn--active" : "")}")"
                            @onclick="@(() => _tmdbIsTv = true)">TV</button>
                    <button type="button" class="@($"emd-segmented__btn {(!_tmdbIsTv ? "emd-segmented__btn--active" : "")}")"
                            @onclick="@(() => _tmdbIsTv = false)">Movie</button>
                </div>
                <button class="emd__btn emd__btn--solid" @onclick="ApplyTmdbAsync"><DIcon Name="refresh" Size="13" /> Apply</button>
            </div>
        </div>

        <div class="emd-idfield">
            <div class="emd-idfield__head">
                <span class="emd-idfield__label">MAL ID</span>
                @if (Item.MalId is not null)
                {
                    <a href="@($"https://myanimelist.net/anime/{Item.MalId}")" target="_blank" rel="noopener" class="emd-idfield__link"><DIcon Name="external" Size="10" /> open source</a>
                }
            </div>
            <div class="emd-idfield__row">
                <input class="emd-input emd-input--mono" placeholder="(not linked)"
                       value="@(_malIdInput ?? "")"
                       @oninput="@(e => _malIdInput = e.Value?.ToString())" />
                <button class="emd__btn emd__btn--solid" @onclick="ApplyMalAsync"><DIcon Name="refresh" Size="13" /> Apply</button>
            </div>
        </div>

        <div class="emd-idfield">
            <div class="emd-idfield__head">
                <span class="emd-idfield__label">IMDb ID</span>
                @if (!string.IsNullOrEmpty(Item.ImdbId))
                {
                    <a href="@($"https://www.imdb.com/title/{Item.ImdbId}")" target="_blank" rel="noopener" class="emd-idfield__link"><DIcon Name="external" Size="10" /> open source</a>
                }
            </div>
            <div class="emd-idfield__row">
                <input class="emd-input emd-input--mono" placeholder="(not linked)"
                       value="@(_imdbIdInput ?? "")"
                       @oninput="@(e => _imdbIdInput = e.Value?.ToString())" />
                <button class="emd__btn emd__btn--solid" @onclick="ApplyImdbAsync"><DIcon Name="refresh" Size="13" /> Apply</button>
            </div>
        </div>

        <div class="emd-idfield">
            <div class="emd-idfield__head">
                <span class="emd-idfield__label">Paste URL</span>
            </div>
            <div class="emd-idfield__row">
                <input class="emd-input" placeholder="https://www.themoviedb.org/tv/12345"
                       value="@_pasteUrl"
                       @oninput="@(e => _pasteUrl = e.Value?.ToString() ?? "")" />
                <button class="emd__btn emd__btn--solid" @onclick="ParsePastedUrl">Parse</button>
            </div>
        </div>
    </div>;

    private RenderFragment BasicsTab() => @<div class="emd-form">
        <label class="emd-field">
            <span class="emd-field__label">Title</span>
            <input class="emd-input" value="@_bTitle" @oninput="@(e => _bTitle = e.Value?.ToString() ?? "")" />
        </label>
        <label class="emd-field">
            <span class="emd-field__label">English title</span>
            <input class="emd-input" value="@(_bEnglish ?? "")" @oninput="@(e => _bEnglish = e.Value?.ToString())" />
        </label>
        <label class="emd-field">
            <span class="emd-field__label">Original / CJK title</span>
            <input class="emd-input" value="@(_bCjk ?? "")" @oninput="@(e => _bCjk = e.Value?.ToString())" />
        </label>
        <div class="emd-grid-2">
            <label class="emd-field">
                <span class="emd-field__label">Year</span>
                <input class="emd-input emd-input--narrow" type="number" value="@(_bYear?.ToString() ?? "")"
                       @oninput="@(e => _bYear = int.TryParse(e.Value?.ToString(), out var y) ? y : null)" />
            </label>
            <label class="emd-field">
                <span class="emd-field__label">Type</span>
                <select class="emd-input" value="@_bType.ToString()"
                        @onchange="@(e => _bType = Enum.TryParse<MediaItemType>(e.Value?.ToString(), out var t) ? t : MediaItemType.Unknown)">
                    <option value="Unknown">Unknown</option>
                    <option value="Anime">Anime</option>
                    <option value="Series">Series</option>
                    <option value="Movie">Movie</option>
                    <option value="Multserials">Multserials</option>
                </select>
            </label>
        </div>
        <div class="emd-grid-2">
            <label class="emd-field">
                <span class="emd-field__label">Language</span>
                <input class="emd-input" value="@(_bLanguage ?? "")" @oninput="@(e => _bLanguage = e.Value?.ToString())" />
            </label>
            <label class="emd-field">
                <span class="emd-field__label">Studio</span>
                <input class="emd-input" value="@(_bStudio ?? "")" @oninput="@(e => _bStudio = e.Value?.ToString())" />
            </label>
        </div>
        <div class="emd-grid-2">
            <label class="emd-field">
                <span class="emd-field__label">Runtime (min)</span>
                <input class="emd-input emd-input--narrow" type="number" value="@(_bRuntime?.ToString() ?? "")"
                       @oninput="@(e => _bRuntime = int.TryParse(e.Value?.ToString(), out var r) ? r : null)" />
            </label>
            <label class="emd-field">
                <span class="emd-field__label">Hue (0–360)</span>
                <input class="emd-input emd-input--narrow" type="number" min="0" max="360"
                       value="@(_bHue?.ToString() ?? "")"
                       @oninput="@(e => _bHue = int.TryParse(e.Value?.ToString(), out var h) ? h : null)" />
            </label>
        </div>
    </div>;

    private RenderFragment CategoriesTab() => @<div class="emd-form">
        <div class="emd-field__label">CATEGORIES — manual override</div>
        <p class="emd__hint" style="margin: 2px 0 12px;">
            Ticked categories pin this item to those chips on Home regardless of
            what the LLM classifier decides. Untick all to let the auto-classifier
            decide. Changes save with the rest of the metadata.
        </p>
        @if (_categoriesLoading)
        {
            <div class="emd-gallery-loading"><InlineDots Label="Loading categories" /></div>
        }
        else if (_allCategories is null || _allCategories.Length == 0)
        {
            <div class="emd-gallery-empty">
                No categories defined. Admin can create them in Server Settings → Categories.
            </div>
        }
        else
        {
            <div class="emd-chips emd-chips--vertical">
                @foreach (var cat in _allCategories.Where(c => c.Enabled).OrderBy(c => c.SortOrder).ThenBy(c => c.Name))
                {
                    var c = cat;
                    var selected = _selectedCategoryIds.Contains(c.Id);
                    <label class="@($"emd-cat-row {(selected ? "is-selected" : "")}")">
                        <input type="checkbox" checked="@selected"
                               @onchange="@(e => ToggleCategory(c.Id, (bool)e.Value!))" />
                        <span class="emd-cat-row__text">
                            <span class="emd-cat-row__name">@c.Name</span>
                            @if (!string.IsNullOrEmpty(c.Description))
                            {
                                <span class="emd-cat-row__desc">@c.Description</span>
                            }
                        </span>
                        @if (c.BuiltIn)
                        {
                            <span class="emd-cat-row__builtin">BUILT-IN</span>
                        }
                    </label>
                }
            </div>
        }
    </div>;

    private RenderFragment TagsTab() => @<div class="emd-form">
        <div class="emd-chips">
            @foreach (var t in _tags)
            {
                var tag = t;
                <button type="button" class="emd-chip emd-chip--active" @onclick="@(() => RemoveTag(tag))">
                    @tag <DIcon Name="x" Size="10" />
                </button>
            }
        </div>
        <div class="emd-idfield__row">
            <input class="emd-input" placeholder="Add tag…"
                   value="@_newTag"
                   @oninput="@(e => _newTag = e.Value?.ToString() ?? "")"
                   @onkeydown="OnTagKeyDown" />
            <button class="emd__btn emd__btn--solid" @onclick="AddTag">Add</button>
        </div>
        <div class="emd-field__label" style="margin-top:8px">SUGGESTED</div>
        <div class="emd-chips">
            @foreach (var t in _suggestedTags.Where(s => !_tags.Contains(s, StringComparer.OrdinalIgnoreCase)))
            {
                var tag = t;
                <button type="button" class="emd-chip" @onclick="@(() => { _tags.Add(tag); })">
                    + @tag
                </button>
            }
        </div>
    </div>;

    private RenderFragment PosterTab() => @<div class="emd-form">
        @if (_postersLoading)
        {
            <div class="emd-gallery-loading"><InlineDots Label="Fetching posters" /></div>
        }
        else if (_posterCandidates is null || _posterCandidates.Length == 0)
        {
            <div class="emd-gallery-empty">No alternative posters available — TMDB / MAL haven't surfaced any for this title.</div>
        }
        else
        {
            <div class="emd-gallery emd-gallery--posters">
                @foreach (var cand in _posterCandidates)
                {
                    var c = cand;
                    var busy = _applyingImageUrl == c.Url;
                    <button type="button" class="@($"emd-gallery__card {(busy ? "emd-gallery__card--busy" : "")}")"
                            disabled="@busy"
                            @onclick="@(() => ApplyImageAsync("poster", c.Url))">
                        <img loading="lazy" src="@c.Url" alt="poster candidate" />
                        @if (c.Width > 0 && c.Height > 0)
                        {
                            <span class="emd-gallery__dim">@c.Width&times;@c.Height</span>
                        }
                        @if (busy) { <div class="emd-gallery__overlay"><Spinner Size="md" Tone="light" /></div> }
                    </button>
                }
            </div>
        }
    </div>;

    private RenderFragment BackdropTab() => @<div class="emd-form">
        @if (_backdropsLoading)
        {
            <div class="emd-gallery-loading"><InlineDots Label="Fetching backdrops" /></div>
        }
        else if (_backdropCandidates is null || _backdropCandidates.Length == 0)
        {
            <div class="emd-gallery-empty">No alternative backdrops available.</div>
        }
        else
        {
            <div class="emd-gallery emd-gallery--backdrops">
                @foreach (var cand in _backdropCandidates)
                {
                    var c = cand;
                    var busy = _applyingImageUrl == c.Url;
                    <button type="button" class="@($"emd-gallery__card {(busy ? "emd-gallery__card--busy" : "")}")"
                            disabled="@busy"
                            @onclick="@(() => ApplyImageAsync("fanart", c.Url))">
                        <img loading="lazy" src="@c.Url" alt="backdrop candidate" />
                        @if (c.Width > 0 && c.Height > 0)
                        {
                            <span class="emd-gallery__dim">@c.Width&times;@c.Height</span>
                        }
                        @if (busy) { <div class="emd-gallery__overlay"><Spinner Size="md" Tone="light" /></div> }
                    </button>
                }
            </div>
        }
    </div>;

    private RenderFragment ManageTab() => @<div class="emd-form">
        <div class="emd-manage-block">
            <h4>Re-identify</h4>
            <p>Queue this folder for a fresh LLM + TMDB/MAL/IMDb lookup, ignoring any
               prior match. Useful when an automatic identification picked the wrong show.</p>
            <button class="emd__btn emd__btn--solid" @onclick="ReidentifyAsync">
                <DIcon Name="magic" Size="13" /> Queue re-identify
            </button>
        </div>

        <div class="emd-manage-block emd-manage-block--danger">
            <h4>Delete from catalog</h4>
            <p>Removes the item from Animarr's SQLite catalog. Files on disk are
               <strong>preserved</strong>. This action cannot be undone from the UI.</p>
            <label class="emd-manage-block__confirm">
                <input type="checkbox" checked="@_confirmDelete"
                       @onchange="@(e => _confirmDelete = e.Value is bool b && b)" />
                <span class="emd-manage-block__confirm-box" aria-hidden="true"></span>
                <span class="emd-manage-block__confirm-label">I understand</span>
            </label>
            <button class="emd__btn emd__btn--danger" disabled="@(!_confirmDelete)" @onclick="DeleteAsync">
                <DIcon Name="trash" Size="13" /> Delete from catalog
            </button>
        </div>
    </div>;
}
