@page "/torrents"
@implements IAsyncDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav

@using Microsoft.AspNetCore.SignalR.Client

@*
    Torrents list with add-magnet form + pause/resume/delete + per-row link
    to TorrentEdit. SignalR live snapshots merge over the persistent record
    by InfoHash for download/upload rates.

    The full .torrent file upload UX still lives in Animarr.Web (uses
    InputFile + JS interop for drag-and-drop). Magnet-add covers most of
    the day-to-day need and lands here first.
*@

<header class="d-page-header">
    <div class="d-page-header__main">
        <div class="d-page-header__overline">TRANSFERS</div>
        <h1 class="d-page-header__title">TORRENTS</h1>
        <div class="d-page-header__sub">Live status pulled every 500ms via SignalR.</div>
    </div>
    @* v5 fix: was .d-page-header__actions which doesn't exist (the page-header
       partial in components.css defines .d-page-header__right + flex helpers).
       The old class collapsed to display:block, stacking the buttons under the
       header instead of pinning them top-right. *@
    <div class="d-page-header__right">
        <Btn Variant="ghost" Size="md" OnClick="@(() => Nav.NavigateTo("/torrents/history"))">
            <DIcon Name="archive" Size="13" /> History
        </Btn>
        <Btn Variant="primary" Size="md" OnClick="OpenAdd">
            <DIcon Name="plus" Size="14" /> Add
        </Btn>
    </div>
</header>

@* Add Torrent / Magnet / File drawer — slides in from the right and
   shares chrome with every other admin drawer (SettingsEditDrawer:
   header + Body + Footer). Source picker at the top of the body
   swaps between Magnet URI input and .torrent file picker. *@
<SettingsEditDrawer IsOpen="@_addOpen"
                    Title="Add torrent"
                    Overline="TRANSFERS"
                    Hint="Paste a magnet link or drop a .torrent file. Save destination + post-processing flags below."
                    Icon="torrent"
                    OnClose="CloseAdd">
    <Body>
        <div class="d-srv-users__segment-bar">
            <div class="d-srv-users__segment" role="tablist">
                @foreach (var (key, label) in new[] { ("magnet", "Magnet"), ("file", ".torrent file") })
                {
                    var k = key;
                    var l = label;
                    var active = _addSource == k;
                    <button type="button"
                            class="@($"d-srv-users__seg-item tv-focus {(active ? "is-active" : "")}")"
                            @onclick="@(() => _addSource = k)">@l</button>
                }
            </div>
        </div>

        <div class="tor-add__form">
            @if (_addSource == "magnet")
            {
                <label class="d-input-group">
                    <span class="d-input-group__label">Magnet URI</span>
                    <input class="settings-field__input" placeholder="magnet:?xt=urn:btih:…"
                           value="@_addMagnet"
                           @oninput="@(e => _addMagnet = e.Value?.ToString() ?? "")" />
                </label>
            }
            else
            {
                <label class="d-input-group">
                    <span class="d-input-group__label">.torrent file</span>
                    <InputFile OnChange="OnTorrentFilePicked" accept=".torrent" />
                    @if (_addFileName is not null)
                    {
                        <div class="tor-add__filehint">
                            <DIcon Name="paperclip" Size="12" /> @_addFileName (@FormatBytesShort(_addFileSize))
                        </div>
                    }
                </label>
            }

            <label class="d-input-group">
                <span class="d-input-group__label">Save to folder</span>
                <select class="d-profile__select"
                        value="@(_addFolderId?.ToString() ?? "")"
                        @onchange="@(e => _addFolderId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                    <option value="">— default —</option>
                    @foreach (var f in _folders ?? Array.Empty<FolderWatcherDto>())
                    {
                        <option value="@f.Id">@f.Label — @f.Path</option>
                    }
                </select>
            </label>

            <label class="tor-add__check">
                <input type="checkbox" checked="@_addAutoRename"
                       @onchange="@(e => _addAutoRename = (bool)e.Value!)" />
                <span>Auto-rename when finished</span>
            </label>
            <label class="tor-add__check">
                <input type="checkbox" checked="@_addStopAfter"
                       @onchange="@(e => _addStopAfter = (bool)e.Value!)" />
                <span>Stop after download</span>
            </label>
        </div>
    </Body>
    <Footer>
        <Btn Variant="primary" Size="md" Loading="@_adding"
             Disabled="@(!CanAdd || _adding)"
             OnClick="AddTorrentAsync">
            <DIcon Name="plus" Size="13" /> Add torrent
        </Btn>
        <Btn Variant="ghost" Size="md" OnClick="CloseAdd">Cancel</Btn>
    </Footer>
</SettingsEditDrawer>

@if (_records is null)
{
    <div class="torrents-loading"><InlineDots /></div>
}
else if (_records.Length == 0)
{
    @* v5 fix: was .torrent-empty (no matching rule); .torrents-empty already
       exists in Torrents.razor.css with the right token-based styling. *@
    <div class="torrents-empty">No torrents yet — paste a magnet above to start one.</div>
}
else
{
    @* v5 fix: was <table class="torrent-table">. The scoped CSS defines
       .tor-table with full row/cell styles + responsive grid layout for
       mobile — rename to pick that up. .bar/.bar-fill/.bar-pct were
       page-local ad-hoc helpers; switched to the global .animarr-progress
       primitive so the bar tracks the accent token instead of staying
       Cinematic-era crimson. *@
    <div class="torrents-grid-wrap">
        <table class="tor-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>State</th>
                    <th style="width:140px">Progress</th>
                    <th style="width:110px;text-align:right">Down</th>
                    <th style="width:110px;text-align:right">Up</th>
                    <th class="tor-col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _records.OrderByDescending(r => r.AddedAt))
                {
                    _live.TryGetValue(t.InfoHash, out var live);
                    var progress = live?.Progress ?? (t.TotalSize > 0 ? (double)t.Downloaded / t.TotalSize : 0);
                    var state = live?.State ?? t.State.ToString();
                    var paused = t.State == TorrentRecordState.Paused;
                    <tr>
                        <td class="tor-name">
                            <button type="button" class="tor-name__text"
                                    @onclick="@(() => OpenEdit(t.InfoHash))">@t.Name</button>
                        </td>
                        <td class="tor-cell tor-cell--dim">@state</td>
                        <td>
                            <div class="tor-progress tor-progress--info">
                                <div class="animarr-progress">
                                    <div class="animarr-progress__track">
                                        <div class="animarr-progress__fill" style="width:@(progress*100)%"></div>
                                    </div>
                                </div>
                                <span class="tor-progress__pct">@($"{progress * 100:F1}%")</span>
                            </div>
                        </td>
                        <td class="tor-cell tor-cell--mono" style="text-align:right">@FormatRate(live?.DownloadRate ?? 0)</td>
                        <td class="tor-cell tor-cell--mono" style="text-align:right">@FormatRate(live?.UploadRate ?? 0)</td>
                        <td class="tor-col-actions">
                            <div class="tor-actions">
                                @if (paused)
                                {
                                    <button class="tor-iconbtn" title="Resume" @onclick="@(() => ResumeAsync(t.Id))">
                                        <DIcon Name="play" Size="13" />
                                    </button>
                                }
                                else
                                {
                                    <button class="tor-iconbtn" title="Pause" @onclick="@(() => PauseAsync(t.Id))">
                                        <DIcon Name="pause" Size="13" />
                                    </button>
                                }
                                <button class="tor-iconbtn tor-iconbtn--danger" title="Remove" @onclick="@(() => DeleteAsync(t.Id))">
                                    <DIcon Name="trash" Size="13" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_editHash is not null)
{
    <TorrentEdit Hash="@_editHash"
                 OnClose="CloseEdit"
                 OnDeleted="OnTorrentDeleted" />
}

@code {
    private TorrentRecordDto[]? _records;
    private FolderWatcherDto[]? _folders;
    private readonly Dictionary<string, TorrentLiveStatsDto> _live = new();
    private HubConnection? _hub;

    private bool   _addOpen;
    private string _addSource = "magnet";
    private string _addMagnet = "";
    private string? _addFileName;
    private byte[]? _addFileBytes;
    private long   _addFileSize;
    private Guid?  _addFolderId;
    private bool   _addAutoRename = true;
    private bool   _addStopAfter;
    private bool   _adding;

    /// <summary>InfoHash of the torrent the right-edge edit drawer is bound
    /// to. Null = drawer closed. Set by clicking a torrent name; cleared by
    /// the drawer's Cancel button or after a successful Remove.</summary>
    private string? _editHash;

    private void OpenEdit(string infoHash) => _editHash = infoHash;

    private void CloseEdit() => _editHash = null;

    /// <summary>Open the Add Torrent drawer — resets the form so a previous
    /// cancelled session doesn't bleed into the next attempt.</summary>
    private void OpenAdd()
    {
        _addSource     = "magnet";
        _addMagnet     = "";
        _addFileName   = null;
        _addFileBytes  = null;
        _addFileSize   = 0;
        _addFolderId   = null;
        _addAutoRename = true;
        _addStopAfter  = false;
        _addOpen       = true;
    }

    private void CloseAdd() => _addOpen = false;

    private async Task OnTorrentDeleted()
    {
        _editHash = null;
        await LoadAsync();
    }

    private bool CanAdd => _addSource switch
    {
        "magnet" => !string.IsNullOrWhiteSpace(_addMagnet),
        "file"   => _addFileBytes is { Length: > 0 },
        _        => false,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        var hubUri = new Uri(new Uri(Nav.BaseUri), ApiRoutes.HubTorrents);
        _hub = new HubConnectionBuilder()
            .WithUrl(hubUri)
            .WithAutomaticReconnect()
            .Build();
        _hub.On<TorrentSnapshotEnvelope>(TorrentHubMethods.LiveSnapshot, env =>
        {
            _live.Clear();
            foreach (var s in env.Items) _live[s.InfoHash] = s;
            InvokeAsync(StateHasChanged);
        });
        try { await _hub.StartAsync(); }
        catch { /* hub unavailable — list still renders from REST */ }
    }

    private async Task LoadAsync()
    {
        try
        {
            _records = await Api.GetTorrentsAsync();
            _folders = await Api.GetFoldersAsync();
        }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task OnTorrentFilePicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        // .torrent files top out around 100KB — small enough to keep in
        // memory and ship as Base64 in the request body.
        const long MaxBytes = 5 * 1024 * 1024;
        if (file.Size > MaxBytes) return;
        using var ms = new System.IO.MemoryStream();
        await file.OpenReadStream(MaxBytes).CopyToAsync(ms);
        _addFileBytes = ms.ToArray();
        _addFileName  = file.Name;
        _addFileSize  = file.Size;
        StateHasChanged();
    }

    private async Task AddTorrentAsync()
    {
        if (!CanAdd) return;
        _adding = true;
        StateHasChanged();
        try
        {
            if (_addSource == "magnet")
            {
                await Api.AddMagnetAsync(new AddMagnetRequest(
                    MagnetLink:             _addMagnet.Trim(),
                    FolderWatcherId:        _addFolderId,
                    AutoRename:             _addAutoRename,
                    StopAfterDownload:      _addStopAfter,
                    SkipSubfolderStructure: false,
                    SuppressRootFolder:     false,
                    CustomRootFolderName:   null));
            }
            else if (_addFileBytes is not null)
            {
                await Api.AddTorrentFileAsync(new AddTorrentFileRequest(
                    Filename:               _addFileName ?? "torrent.torrent",
                    Base64Content:          Convert.ToBase64String(_addFileBytes),
                    FolderWatcherId:        _addFolderId,
                    AutoRename:             _addAutoRename,
                    StopAfterDownload:      _addStopAfter,
                    SkipSubfolderStructure: false,
                    SuppressRootFolder:     false,
                    CustomRootFolderName:   null));
            }
            _addMagnet = "";
            _addFileBytes = null;
            _addFileName  = null;
            _addOpen = false;
            await LoadAsync();
        }
        catch { /* swallow */ }
        finally { _adding = false; StateHasChanged(); }
    }

    private static string FormatBytesShort(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024)      return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }

    private async Task PauseAsync(Guid id)
    {
        try { await Api.PauseTorrentAsync(id); await LoadAsync(); }
        catch { /* swallow */ }
    }

    private async Task ResumeAsync(Guid id)
    {
        try { await Api.ResumeTorrentAsync(id); await LoadAsync(); }
        catch { /* swallow */ }
    }

    private async Task DeleteAsync(Guid id)
    {
        try { await Api.DeleteTorrentAsync(id, deleteFiles: false); await LoadAsync(); }
        catch { /* swallow */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }

    private static string FormatRate(long bps)
    {
        if (bps <= 0) return "0";
        var units = new[] { "B/s", "KB/s", "MB/s", "GB/s" };
        double v = bps;
        int i = 0;
        while (v >= 1024 && i < units.Length - 1) { v /= 1024; i++; }
        return $"{v:F1} {units[i]}";
    }
}
