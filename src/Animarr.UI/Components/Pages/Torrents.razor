@page "/torrents"
@implements IAsyncDisposable
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@inject Animarr.UI.Services.ServerAddressProvider ServerAddr

@using Microsoft.AspNetCore.SignalR.Client

@*
    Downloads page (Fluent 2). Page header (title + History / Add), live stat
    tiles summed from the SignalR snapshots, an Active | History pivot, and the
    torrent list (name + folder/size meta, state badge, 4px progress bar,
    rates, row actions). SignalR live snapshots merge over the persistent
    record by InfoHash for progress, state and rates.

    Add flow lives in the right-side SettingsEditDrawer below: .torrent file /
    magnet / plain upload → destination + subfolder (DestinationFolderPicker)
    → rate caps → post-processing toggles.
*@

<div class="tor-page">
<header class="tor-head">
    <PageBack />
    <div class="tor-head__main">
        <h1 class="tor-head__title">@L["torrents.page_title"]</h1>
        <div class="tor-head__sub">@L["torrents.page_sub"]</div>
    </div>
    @* Hidden below 960px — the Add action becomes the floating FAB there and
       History is reachable through the Active | History pivot. *@
    <div class="tor-head__actions">
        <Btn Variant="solid" Size="md" OnClick="@(() => Nav.NavigateTo("/torrents/history"))">
            <DIcon Name="history" Size="16" /> @L["torrents.btn_history"]
        </Btn>
        <Btn Variant="primary" Size="md" OnClick="OpenAdd">
            <DIcon Name="plus" Size="16" /> @L["torrents.btn_add"]
        </Btn>
    </div>
</header>

@* Mobile-only floating action button — pinned bottom-right above the
   safe-area inset. Desktop and TV hide it via CSS in favour of the header
   button above. *@
<button type="button" class="tor-fab tv-focus" @onclick="OpenAdd"
        aria-label="@L["torrents.add_download_aria"]">
    <DIcon Name="plus" Size="24" />
</button>

@* Add Torrent drawer — slides in from the right (SettingsEditDrawer
   shell): source tabs → source-specific input → destination + subfolder →
   rate caps → post-processing toggles. *@
<SettingsEditDrawer IsOpen="@_addOpen"
                    Title="@L["torrents.add_drawer_title"]"
                    Overline="@L["torrents.add_drawer_overline"]"
                    Hint="@L["torrents.add_drawer_hint"]"
                    Icon="torrent"
                    OnClose="CloseAdd">
    <Body>
        @* ── 1. SOURCE — .torrent file / Magnet / Upload files (Fluent TabList).
              The third tab drops arbitrary local files (mkv / mp4 / srt /…)
              straight into a registered folder, bypassing the torrent engine. *@
        <div class="tor-add__segment" role="tablist">
            @foreach (var (key, label, icon) in new[]
                {
                    ("file",   L["torrents.source_torrent_file"], "torrent"),
                    ("magnet", L["torrents.source_magnet_link"],  "link"),
                    ("upload", L["torrents.source_upload_files"], "upload"),
                })
            {
                var k = key;
                var l = label;
                var ic = icon;
                var active = _addSource == k;
                <button type="button"
                        class="@($"tor-add__seg-item tv-focus {(active ? "is-active" : "")}")"
                        role="tab"
                        aria-selected="@active"
                        @onclick="@(() => _addSource = k)">
                    <DIcon Name="@ic" Size="16" />
                    @l
                </button>
            }
        </div>

        @* ── 2. SOURCE-SPECIFIC INPUT. *@
        @if (_addSource == "magnet")
        {
            <label class="d-input-group tor-add__field">
                <span class="d-input-group__label">@L["torrents.magnet_uri_label"]</span>
                <input class="fs-input fs-input--code"
                       placeholder="magnet:?xt=urn:btih:…"
                       value="@_addMagnet"
                       @oninput="@(e => _addMagnet = e.Value?.ToString() ?? "")" />
            </label>
        }
        else if (_addSource == "file")
        {
            <div class="tor-add__field">
                <span class="tor-add__field-label">@L["torrents.torrent_file_label"]</span>
                <div class="@($"tor-add__dropzone {(_addFileName is not null ? "tor-add__dropzone--loaded" : "")}")">
                    @* InputFile invisibly fills the dropzone — click anywhere
                       opens the picker. Visual prompt sits behind via CSS. *@
                    <InputFile OnChange="OnTorrentFilePicked" accept=".torrent" class="tor-add__dropzone-input" />
                    <div class="tor-add__dropzone-content">
                        @if (_addFileName is null)
                        {
                            <DIcon Name="torrent" Size="24" />
                            <div class="tor-add__dropzone-prompt">
                                @L["torrents.dropzone_torrent_prompt"] <span class="tor-add__dropzone-browse">@L["torrents.dropzone_browse"]</span>
                            </div>
                            <div class="tor-add__dropzone-hint">@L["torrents.dropzone_torrent_hint"]</div>
                        }
                        else
                        {
                            <DIcon Name="check" Size="20" />
                            <div class="tor-add__dropzone-prompt">
                                @_addFileName · @FormatBytesShort(_addFileSize)
                            </div>
                            <div class="tor-add__dropzone-hint">@L["torrents.dropzone_click_swap"]</div>
                        }
                    </div>
                </div>
            </div>

            @* Parsed-manifest preview: POST /api/torrents/parse returns the file
               list inside the .torrent so the user sees what they're about to
               download (and how big) before committing. *@
            @if (_parsed is not null)
            {
                <div class="tor-add__field">
                    <div class="tor-tree__head">
                        <span class="tor-add__field-label">
                            @L.Get("torrents.contents_count_fmt", SelectedCount, _parsed.Files.Length, FormatBytesShort(SelectedSize))
                        </span>
                        @if (_treeRoot is not null && _parsed.Files.Length > 1)
                        {
                            <div class="tor-tree__head-actions">
                                <Btn Variant="flat" Size="sm" OnClick="SelectAllFiles">@L["torrents.tree_all"]</Btn>
                                <Btn Variant="flat" Size="sm" OnClick="SelectNoneFiles">@L["torrents.tree_none"]</Btn>
                            </div>
                        }
                    </div>

                    @* Folder TREE with per-node checkboxes. Checking/clearing a
                       folder cascades to every file under it; a folder shows a
                       dash when only some of its children are selected. Unchecked
                       files are sent as ExcludedFiles → engine stamps them
                       DoNotDownload before the torrent starts. *@
                    <div class="tor-tree">
                        @foreach (var row in FlattenTree())
                        {
                            var node  = row.Node;
                            var stateN = NodeCheckState(node);
                            @* @key by node identity — without it Blazor diffs the
                               rows by position and can bind a row's checkbox /
                               @onclick delegate to the wrong node after a cascade
                               toggle. Keying to the node object (stable across
                               renders) makes each row track its own state. *@
                            <div @key="node" class="@($"tor-tree__row {(node.IsFile ? "tor-tree__row--file" : "")}")" style="--depth:@row.Depth">
                                @if (!node.IsFile)
                                {
                                    <button type="button"
                                            class="@($"tor-tree__caret {(node.Expanded ? "is-open" : "")}")"
                                            @onclick="@(() => ToggleExpand(node))"
                                            aria-label="@L["torrents.tree_expand_folder_aria"]">
                                        <DIcon Name="chev-r" Size="12" />
                                    </button>
                                }
                                else
                                {
                                    <span class="tor-tree__caret tor-tree__caret--leaf"></span>
                                }

                                <button type="button"
                                        class="@($"tor-tree__check {(stateN == 1 ? "is-on" : stateN == 2 ? "is-partial" : "")}")"
                                        @onclick="@(() => ToggleNode(node))"
                                        aria-label="@L["torrents.tree_select_aria"]">
                                    @if (stateN == 1)
                                    {
                                        <DIcon Name="check" Size="12" />
                                    }
                                    else if (stateN == 2)
                                    {
                                        <span class="tor-tree__dash"></span>
                                    }
                                </button>

                                <span class="tor-tree__ficon">
                                    <DIcon Name="@(node.IsFile ? "file" : "folder")" Size="16" />
                                </span>
                                <span class="tor-tree__name" title="@node.Name">@node.Name</span>
                                <span class="tor-tree__size">@FormatBytesShort(node.Size)</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_parseError is not null)
            {
                <div class="fs-msgbar fs-msgbar--error tor-add__field">
                    <span class="fs-msgbar__ic"><DIcon Name="warn" Size="16" /></span>
                    <span>@_parseError</span>
                </div>
            }
        }
        else
        {
            @* ── Upload files tab — multiple local files into a chosen folder.
                 No torrent / magnet involved. Server endpoint is
                 POST /api/folders/{watcherId}/upload (multipart). *@
            <div class="tor-add__field">
                <span class="tor-add__field-label">@L["torrents.local_files_label"]</span>
                <div class="@($"tor-add__dropzone {(_uploadFiles.Count > 0 ? "tor-add__dropzone--loaded" : "")}")">
                    <InputFile OnChange="OnUploadFilesPicked" multiple class="tor-add__dropzone-input" />
                    <div class="tor-add__dropzone-content">
                        @if (_uploadFiles.Count == 0)
                        {
                            <DIcon Name="upload" Size="24" />
                            <div class="tor-add__dropzone-prompt">
                                @L["torrents.dropzone_files_prompt"] <span class="tor-add__dropzone-browse">@L["torrents.dropzone_browse"]</span>
                            </div>
                            <div class="tor-add__dropzone-hint">@L["torrents.dropzone_multiple_hint"]</div>
                        }
                        else
                        {
                            <DIcon Name="check" Size="20" />
                            <div class="tor-add__dropzone-prompt">
                                @L.Get("torrents.files_count_fmt", _uploadFiles.Count) · @FormatBytesShort(_uploadFiles.Sum(f => f.Content.LongLength))
                            </div>
                            <div class="tor-add__dropzone-hint">@L["torrents.dropzone_click_swap"]</div>
                        }
                    </div>
                </div>
            </div>

            @if (_uploadFiles.Count > 0)
            {
                <div class="tor-add__field">
                    <span class="tor-add__field-label">@L["torrents.picked_label"]</span>
                    <div class="tor-add__filelist">
                        @foreach (var f in _uploadFiles)
                        {
                            <div class="tor-add__filelist-row">
                                <span class="tor-add__filelist-path">@f.FileName</span>
                                <span class="tor-add__filelist-size">@FormatBytesShort(f.Content.LongLength)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        @* ── 3. DESTINATION (root folder) + subfolder. Subfolder maps to
              CustomRootFolderName on the add request (subPath for uploads) —
              the server creates that directory under the chosen root and the
              download's contents land straight in it.
              Filter: skip flat-section LEAF entries (SingleFilePath != null).
              Those rows point at individual video files inside a flat section,
              not at folders — selecting them as a download target made no
              sense and the picker rendered them as if they were folders. *@
        <label class="d-input-group tor-add__field">
            <span class="d-input-group__label">@L["torrents.save_to_folder_label"]</span>
            <select class="fs-select fs-select--wide"
                    value="@(_addFolderId?.ToString() ?? "")"
                    @onchange="OnAddFolderChanged">
                <option value="">@L["torrents.default_download_folder_option"]</option>
                @foreach (var f in FolderOptions())
                {
                    <option value="@f.Id">@f.Label — @f.Path</option>
                }
            </select>
        </label>

        @* Subfolder: a button opening DestinationFolderPicker (explorer-style
           tree of what's already inside the destination + "New folder")
           instead of a free-text field you had to type a path into blind. *@
        <div class="d-input-group tor-add__field">
            <span class="d-input-group__label">@L["torrents.create_subfolder_label"]</span>
            <div class="tor-add__subfolder">
                <button type="button"
                        class="@($"tor-add__subfolder-btn tv-focus {(_addSubfolder is null ? "is-empty" : "")}")"
                        @onclick="@(() => _subfolderPickerOpen = true)">
                    <span class="tor-add__subfolder-ic"><DIcon Name="folder" Size="16" /></span>
                    <span class="tor-add__subfolder-text">
                        @if (_addSubfolder is null)
                        {
                            @L["torrents.subfolder_none"]
                        }
                        else
                        {
                            @string.Join(" / ", SubfolderPath.Split(_addSubfolder))
                        }
                    </span>
                    <span class="tor-add__subfolder-action">@L["torrents.subfolder_btn_browse"]</span>
                </button>
                @if (_addSubfolder is not null)
                {
                    <button type="button" class="fs-icon-btn tor-add__subfolder-clear tv-focus"
                            @onclick="@(() => _addSubfolder = null)"
                            title="@L["torrents.subfolder_clear"]"
                            aria-label="@L["torrents.subfolder_clear"]">
                        <DIcon Name="x" Size="16" />
                    </button>
                }
            </div>
        </div>

        @* ── 4. Bandwidth caps — per-torrent rate limits in KB/s. Zero = no
              limit. Only meaningful for magnet/.torrent — the upload-files
              tab doesn't go through the engine. *@
        @if (_addSource != "upload")
        {
            <div class="fs-grid-2 tor-add__limits">
                <label class="d-input-group tor-add__field">
                    <span class="d-input-group__label">@L["torrents.dl_limit_kbps_label"]</span>
                    <input type="number" min="0" step="50"
                           class="fs-input"
                           placeholder="0"
                           value="@_addDownloadKBps"
                           @oninput="@(e => _addDownloadKBps = int.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0)" />
                </label>
                <label class="d-input-group tor-add__field">
                    <span class="d-input-group__label">@L["torrents.ul_limit_kbps_label"]</span>
                    <input type="number" min="0" step="50"
                           class="fs-input"
                           placeholder="0"
                           value="@_addUploadKBps"
                           @oninput="@(e => _addUploadKBps = int.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0)" />
                </label>
            </div>
        }

        @* ── 5. POST-PROCESSING TOGGLES. Hidden in the Upload tab: the toggles
              only make sense for torrents (seeding, root-folder stripping…). *@
        @if (_addSource != "upload")
        {
            <div class="tor-add__toggles">
                <div class="tor-add__toggle-row">
                    <div class="tor-add__toggle-text">
                        <div class="tor-add__toggle-title">@L["torrents.toggle_stop_after_title"]</div>
                        <div class="tor-add__toggle-hint">@L["torrents.toggle_stop_after_hint"]</div>
                    </div>
                    <Toggle Checked="@_addStopAfter" CheckedChanged="@((bool v) => _addStopAfter = v)" />
                </div>
                <div class="tor-add__toggle-row">
                    <div class="tor-add__toggle-text">
                        <div class="tor-add__toggle-title">@L["torrents.toggle_flatten_title"]</div>
                        <div class="tor-add__toggle-hint">@L["torrents.toggle_flatten_hint"]</div>
                    </div>
                    <Toggle Checked="@_addFlatten" CheckedChanged="@((bool v) => _addFlatten = v)" />
                </div>
                <div class="tor-add__toggle-row">
                    <div class="tor-add__toggle-text">
                        <div class="tor-add__toggle-title">@L["torrents.toggle_strip_root_title"]</div>
                        <div class="tor-add__toggle-hint">@L["torrents.toggle_strip_root_hint"]</div>
                    </div>
                    <Toggle Checked="@_addStripRoot" CheckedChanged="@((bool v) => _addStripRoot = v)" />
                </div>
            </div>
        }
        else
        {
            <div class="fs-msgbar fs-msgbar--info tor-add__upload-note">
                <span class="fs-msgbar__ic"><DIcon Name="info" Size="16" /></span>
                <span>@L["torrents.upload_note"]</span>
            </div>
        }
    </Body>
    <Footer>
        <Btn Variant="primary" Size="md" Loading="@_adding"
             Disabled="@(!CanAdd || _adding)"
             OnClick="AddTorrentAsync">
            <DIcon Name="download" Size="16" /> @L["torrents.btn_start_download"]
        </Btn>
        <Btn Variant="ghost" Size="md" OnClick="CloseAdd">@L["common.btn_cancel"]</Btn>
    </Footer>
</SettingsEditDrawer>

@* Outside the drawer on purpose: the drawer's slide-in transform would make
   it the containing block of the picker's position:fixed. *@
<DestinationFolderPicker IsOpen="@(_addOpen && _subfolderPickerOpen)"
                         FolderId="@_addFolderId"
                         RootLabel="@SubfolderRootLabel"
                         Value="@_addSubfolder"
                         OnPick="OnSubfolderPicked"
                         OnClose="@(() => _subfolderPickerOpen = false)" />

@* ── Stat tiles — summed from the live SignalR snapshots of the listed
      torrents (same TryGetValue merge the table rows use). *@
@if (_records is { Length: > 0 } recs)
{
    long sumDown = 0;
    long sumUp = 0;
    int sumPeers = 0;
    int downloading = 0;
    foreach (var r in recs)
    {
        if (_live.TryGetValue(r.InfoHash, out var s))
        {
            sumDown  += s.DownloadRate;
            sumUp    += s.UploadRate;
            sumPeers += s.Peers;
            if (s.State is "Downloading" or "Metadata") downloading++;
        }
    }
    <div class="tor-stats">
        <div class="tor-stat">
            <span class="tor-stat__ic tor-stat__ic--accent"><DIcon Name="download" Size="20" /></span>
            <div class="tor-stat__text">
                <div class="tor-stat__label">@L["torrents.stat_download"]</div>
                <div class="tor-stat__value">@FormatRate(sumDown)</div>
            </div>
        </div>
        <div class="tor-stat">
            <span class="tor-stat__ic tor-stat__ic--success"><DIcon Name="upload" Size="20" /></span>
            <div class="tor-stat__text">
                <div class="tor-stat__label">@L["torrents.stat_upload"]</div>
                <div class="tor-stat__value">@FormatRate(sumUp)</div>
            </div>
        </div>
        <div class="tor-stat">
            <span class="tor-stat__ic"><DIcon Name="flash" Size="20" /></span>
            <div class="tor-stat__text">
                <div class="tor-stat__label">@L["torrent_history.state_downloading"]</div>
                <div class="tor-stat__value">@downloading / @recs.Length</div>
            </div>
        </div>
        <div class="tor-stat">
            <span class="tor-stat__ic"><DIcon Name="users" Size="20" /></span>
            <div class="tor-stat__text">
                <div class="tor-stat__label">@L["torrent_edit.stat_peers"]</div>
                <div class="tor-stat__value">@sumPeers</div>
            </div>
        </div>
    </div>
}

@* Active | History pivot (Fluent TabList, 3px indicator). History is a
   sibling page, so the tabs are links. *@
<nav class="tor-pivot" aria-label="@L["torrents.page_title"]">
    <a href="torrents" class="tor-pivot__item is-active tv-focus" aria-current="page">@L["torrents.tab_active"]</a>
    <a href="torrents/history" class="tor-pivot__item tv-focus">@L["torrents.tab_history"]</a>
</nav>

@if (_records is null)
{
    <div class="torrents-loading"><InlineDots /></div>
}
else if (_records.Length == 0)
{
    <div class="tor-empty">
        <span class="tor-empty__ic"><DIcon Name="download" Size="24" /></span>
        <div class="tor-empty__text">@L["torrents.empty"]</div>
        <Btn Variant="primary" Size="md" OnClick="OpenAdd">
            <DIcon Name="plus" Size="16" /> @L["torrents.btn_add"]
        </Btn>
    </div>
}
else
{
    @* Fluent list: card on --surface, 1px border; rows hover --surface-2.
       Column widths come from the .tor-col-* classes. Below 960px each row
       turns into its own card (see the media queries). *@
    <div class="tor-list">
        <table class="tor-table">
            <thead>
                <tr>
                    <th>@L["torrents.col_name"]</th>
                    <th class="tor-col-status">@L["torrents.col_state"]</th>
                    <th class="tor-col-progress">@L["torrents.col_progress"]</th>
                    <th class="tor-col-rate tor-col--right">@L["torrents.col_down"]</th>
                    <th class="tor-col-rate tor-col--right">@L["torrents.col_up"]</th>
                    <th class="tor-col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _records.OrderByDescending(r => r.AddedAt))
                {
                    _live.TryGetValue(t.InfoHash, out var live);
                    var progressRaw = live?.Progress ?? (t.TotalSize > 0 ? (double)t.Downloaded / t.TotalSize : 0);
                    // Clamp: MonoTorrent can report a hair over 1.0 once a torrent
                    // finishes (it counts a little padding/overhead), which surfaced
                    // as a nonsensical "100.2%". Keep the bar + label in [0,100].
                    var progress = Math.Clamp(progressRaw, 0d, 1d);
                    var state = live?.State ?? t.State.ToString();
                    var stateKey = state.ToLowerInvariant();
                    var paused = t.State == TorrentRecordState.Paused;
                    var folderName = System.IO.Path.GetFileName(t.SavePath.TrimEnd('/', '\\'));
                    <tr class="@($"tor-row tor-st--{stateKey}")">
                        <td class="tor-name">
                            <button type="button" class="tor-name__text"
                                    @onclick="@(() => OpenEdit(t.InfoHash))">@t.Name</button>
                            <span class="tor-name__meta" title="@t.SavePath">
                                @if (!string.IsNullOrEmpty(folderName))
                                {
                                    @($"{folderName} · ")
                                }
                                @FormatBytesShort(t.TotalSize)
                            </span>
                        </td>
                        <td class="tor-cell-state"><span class="tor-badge">@state</span></td>
                        <td>
                            <div class="tor-progress">
                                <div class="tor-bar">
                                    <div class="tor-bar__fill" style="@(System.FormattableString.Invariant($"width:{progress * 100:F1}%"))"></div>
                                </div>
                                <span class="tor-progress__pct">@($"{progress * 100:F1}%")</span>
                            </div>
                        </td>
                        <td class="tor-num tor-col--right">@FormatRate(live?.DownloadRate ?? 0)</td>
                        <td class="tor-num tor-col--right">@FormatRate(live?.UploadRate ?? 0)</td>
                        <td class="tor-col-actions">
                            <div class="tor-actions">
                                @* Edit (settings drawer): folder, file selection,
                                   rate limits, etc. Clicking the name opens the
                                   same drawer. *@
                                <button class="fs-icon-btn" title="@L["torrents.btn_edit"]" aria-label="@L["torrents.btn_edit"]" @onclick="@(() => OpenEdit(t.InfoHash))">
                                    <DIcon Name="pencil" Size="16" />
                                </button>
                                @if (paused)
                                {
                                    <button class="fs-icon-btn" title="@L["torrents.btn_resume"]" aria-label="@L["torrents.btn_resume"]" @onclick="@(() => ResumeAsync(t.Id))">
                                        <DIcon Name="play" Size="16" />
                                    </button>
                                }
                                else
                                {
                                    <button class="fs-icon-btn" title="@L["torrents.btn_pause"]" aria-label="@L["torrents.btn_pause"]" @onclick="@(() => PauseAsync(t.Id))">
                                        <DIcon Name="pause" Size="16" />
                                    </button>
                                }
                                <button class="fs-icon-btn tor-act--danger" title="@L["common.btn_remove"]" aria-label="@L["common.btn_remove"]" @onclick="@(() => _deleteTarget = t)">
                                    <DIcon Name="trash" Size="16" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@if (_editHash is not null)
{
    <TorrentEdit Hash="@_editHash"
                 OnClose="CloseEdit"
                 OnDeleted="OnTorrentDeleted" />
}

@* Delete confirmation — the trash button no longer deletes instantly; it asks
   whether to keep or wipe the downloaded files. *@
@if (_deleteTarget is { } del)
{
    <SettingsEditDrawer IsOpen="true"
                        Title="@L.Get("torrents.remove_confirm_title_fmt", del.Name)"
                        Overline="@L["torrents.remove_confirm_overline"]"
                        Hint="@L["torrents.remove_confirm_hint"]"
                        Icon="warn"
                        Tone="warn"
                        OnClose="@(() => _deleteTarget = null)">
        <Body>
            <div class="tor-del">
                <p class="tor-del__copy">@L["torrents.remove_confirm_copy"]</p>
                <ul class="tor-del__effects">
                    <li><span class="tor-del__ic"><DIcon Name="check" Size="16" /></span>
                        <span>@((MarkupString)L["torrents.remove_effect_torrent_only_html"])</span></li>
                    <li><span class="tor-del__ic tor-del__ic--danger"><DIcon Name="trash" Size="16" /></span>
                        <span>@((MarkupString)L["torrents.remove_effect_torrent_files_html"])</span></li>
                </ul>
            </div>
        </Body>
        <Footer>
            <Btn Variant="danger" Size="md" Loading="@_deleting" OnClick="@(() => ConfirmDeleteAsync(true))">
                <DIcon Name="trash" Size="16" /> @L["torrents.btn_torrent_and_files"]
            </Btn>
            <Btn Variant="primary" Size="md" Disabled="@_deleting" OnClick="@(() => ConfirmDeleteAsync(false))">
                @L["torrents.btn_torrent_only"]
            </Btn>
            <Btn Variant="ghost" Size="md" Disabled="@_deleting" OnClick="@(() => _deleteTarget = null)">
                @L["common.btn_cancel"]
            </Btn>
        </Footer>
    </SettingsEditDrawer>
}

@code {
    private TorrentRecordDto[]? _records;
    private FolderWatcherDto[]? _folders;
    /// <summary>FolderWatcher ids whose media item is a MOVIE. Used to keep the
    /// "Save to folder" picker free of movie destinations (you add a torrent to
    /// a series folder or a source root, never "into" a single movie). Single
    /// movie FILES are already excluded via SingleFilePath; this also catches
    /// the rarer movie-stored-as-a-folder case, which SingleFilePath misses.</summary>
    private HashSet<Guid> _movieFolderIds = new();
    private readonly Dictionary<string, TorrentLiveStatsDto> _live = new();
    private HubConnection? _hub;

    private bool   _addOpen;
    private string _addSource = "file";   // .torrent tab is first / default
    private string _addMagnet = "";
    private string? _addFileName;
    private byte[]? _addFileBytes;
    private long   _addFileSize;
    private Guid?  _addFolderId;
    private string? _addSubfolder;        // "Show/Season 2" → CustomRootFolderName / upload subPath
    private bool   _subfolderPickerOpen;
    private bool   _addStopAfter;
    private bool   _addFlatten;           // → SkipSubfolderStructure
    private bool   _addStripRoot;         // → SuppressRootFolder
    private int    _addDownloadKBps;       // v5: per-torrent dl cap (0 = unlimited)
    private int    _addUploadKBps;         // v5: per-torrent ul cap (0 = unlimited)
    private bool   _adding;

    // v5 parse preview — populated after OnTorrentFilePicked succeeds.
    private ParsedTorrentDto? _parsed;
    private string?           _parseError;

    // ── File-selection tree (built from _parsed.Files) ──
    // _treeRoot's Children are the top-level nodes; the root itself isn't drawn.
    // _deselected holds the FullPath of every UNCHECKED file — sent to the
    // server as ExcludedFiles so the engine skips them before download starts.
    private TorNode? _treeRoot;
    private readonly HashSet<string> _deselected = new(StringComparer.Ordinal);

    // v5 upload-tab state — list of staged files waiting for "Start upload".
    private readonly List<UploadFilePart> _uploadFiles = new();

    /// <summary>InfoHash of the torrent the right-edge edit drawer is bound
    /// to. Null = drawer closed. Set by clicking a torrent name; cleared by
    /// the drawer's Cancel button or after a successful Remove.</summary>
    private string? _editHash;

    private void OpenEdit(string infoHash) => _editHash = infoHash;

    private void CloseEdit() => _editHash = null;

    /// <summary>Open the Add Torrent drawer — resets the form so a previous
    /// cancelled session doesn't bleed into the next attempt.</summary>
    private void OpenAdd()
    {
        _addSource     = "file";
        _addMagnet     = "";
        _addFileName   = null;
        _addFileBytes  = null;
        _addFileSize   = 0;
        _addFolderId   = null;
        _addSubfolder  = null;
        _subfolderPickerOpen = false;
        _addStopAfter  = false;
        _addFlatten    = false;
        _addStripRoot  = false;
        _addDownloadKBps = 0;
        _addUploadKBps   = 0;
        _parsed        = null;
        _parseError    = null;
        _treeRoot      = null;
        _deselected.Clear();
        _uploadFiles.Clear();
        _addOpen       = true;
    }

    private void CloseAdd()
    {
        _addOpen = false;
        _subfolderPickerOpen = false;
    }

    /// <summary>The subfolder is relative to the destination, so switching
    /// destination drops it — "Season 2" under one show means nothing under
    /// another.</summary>
    private void OnAddFolderChanged(ChangeEventArgs e)
    {
        var id = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        if (id != _addFolderId) _addSubfolder = null;
        _addFolderId = id;
    }

    private void OnSubfolderPicked(string? path)
    {
        _addSubfolder = SubfolderPath.Normalize(path);
        _subfolderPickerOpen = false;
    }

    /// <summary>Root row label in the picker — the destination's name.</summary>
    private string SubfolderRootLabel
        => _addFolderId is Guid id && _folders?.FirstOrDefault(f => f.Id == id) is { } f
            ? f.Label
            : L["torrents.subfolder_default_root"];

    private async Task OnTorrentDeleted()
    {
        _editHash = null;
        await LoadAsync();
    }

    private bool CanAdd => _addSource switch
    {
        "magnet" => !string.IsNullOrWhiteSpace(_addMagnet),
        // A .torrent is ready once bytes are loaded — but if we parsed a
        // manifest and the user unchecked EVERYTHING, there's nothing to
        // download, so block Start until at least one file is selected.
        "file"   => _addFileBytes is { Length: > 0 } && (_parsed is null || SelectedCount > 0),
        // Upload tab needs at least one file AND a destination folder
        // chosen — files have to land somewhere, no "default" makes sense.
        "upload" => _uploadFiles.Count > 0 && _addFolderId is not null,
        _        => false,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // NavPane's "+" next to Downloads lands here as ?add=1 — open the
        // Add drawer straight away (it slides in from the right).
        if (WantsAdd(Nav.Uri)) OpenAdd();
        Nav.LocationChanged += OnLocationChangedForAdd;

        var hubUri = ServerAddr.HubUri(Nav.Uri, ApiRoutes.HubTorrents);
        _hub = Animarr.UI.Services.AnimarrHub.Build(hubUri);
        // Mutate on the renderer's context: under MAUI hub callbacks arrive on a
        // pool thread while the render loop enumerates _live.
        _hub.On<TorrentSnapshotEnvelope>(TorrentHubMethods.LiveSnapshot, env => InvokeAsync(() =>
        {
            _live.Clear();
            foreach (var s in env.Items) _live[s.InfoHash] = s;
            StateHasChanged();
        }));
        try { await _hub.StartAsync(); }
        catch { /* hub unavailable — list still renders from REST */ }
    }

    private async Task LoadAsync()
    {
        try
        {
            _records = await Api.GetTorrentsAsync();
            _folders = await Api.GetFoldersAsync();

            // Movie folder ids — so FolderOptions() can drop movie destinations.
            // FolderType is unreliable here (some series folders are tagged
            // Movie), so we use the identified MediaItemType as ground truth.
            try
            {
                var movies = await Api.GetMediaItemsAsync(
                    new MediaListQuery { Type = MediaItemType.Movie, Take = 10000 });
                _movieFolderIds = movies.Select(m => m.FolderId).ToHashSet();
            }
            catch { _movieFolderIds = new HashSet<Guid>(); }
        }
        catch { /* offline */ }
        StateHasChanged();
    }

    /// <summary>Folders offered as download targets in the Add-Torrent drawer.
    /// Per the user's spec: SOURCE folders (section roots) + every SERIES folder,
    /// but NO movies. Rationale:
    ///   • Section roots (IsSection) are the "source folders" — drop a download
    ///     here and the optional "Create subfolder" field carves out a leaf.
    ///   • Series folders (a real directory, SingleFilePath == null) are valid
    ///     targets — e.g. adding a new season to an existing show.
    ///   • Movies are excluded two ways: single video FILES (SingleFilePath set)
    ///     and movie-stored-as-folder rows (_movieFolderIds, by MediaItemType).
    /// Ordered source-roots-first, then series folders alphabetically.</summary>
    private IEnumerable<FolderWatcherDto> FolderOptions()
        => (_folders ?? Array.Empty<FolderWatcherDto>())
            .Where(f => f.IsSection
                     || (f.SingleFilePath is null && !_movieFolderIds.Contains(f.Id)))
            .OrderByDescending(f => f.IsSection)
            .ThenBy(f => f.Label, StringComparer.OrdinalIgnoreCase);

    private async Task OnTorrentFilePicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        // .torrent files top out around 100KB — small enough to keep in
        // memory and ship as Base64 in the request body.
        const long MaxBytes = 5 * 1024 * 1024;
        if (file.Size > MaxBytes) return;
        using var ms = new System.IO.MemoryStream();
        await file.OpenReadStream(MaxBytes).CopyToAsync(ms);
        _addFileBytes = ms.ToArray();
        _addFileName  = file.Name;
        _addFileSize  = file.Size;
        _parsed       = null;
        _parseError   = null;
        _treeRoot     = null;
        _deselected.Clear();
        StateHasChanged();

        // v5: ask the server for the file manifest so the dropzone can
        // preview what's inside the .torrent. Fire-and-forget UX — if the
        // call fails the user still sees the filename + size and Start
        // download still works, just without the preview.
        try
        {
            var b64 = Convert.ToBase64String(_addFileBytes);
            _parsed = await Api.ParseTorrentAsync(new ParseTorrentRequest(b64));
            if (_parsed is null) _parseError = "Couldn't read the .torrent file.";
            else BuildTree();
        }
        catch (Exception ex)
        {
            _parseError = $"Parse failed: {ex.Message}";
        }
        StateHasChanged();
    }

    /// <summary>Stage files for the Upload-files tab. Multiple files come in
    /// via InputFile's `multiple` attribute; we buffer them all in memory
    /// (capped per-file at 4 GiB to match the server endpoint).</summary>
    private async Task OnUploadFilesPicked(InputFileChangeEventArgs e)
    {
        _uploadFiles.Clear();
        // Hard cap to keep one ridiculous file from OOM-ing the WebView.
        const long PerFileMax = 4L * 1024 * 1024 * 1024;
        // GetMultipleFiles caps how many entries InputFile yields at once;
        // bump it from the default (10) so a season's worth of episodes
        // doesn't get truncated silently.
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 200))
        {
            if (file.Size <= 0 || file.Size > PerFileMax) continue;
            using var ms = new System.IO.MemoryStream();
            await file.OpenReadStream(PerFileMax).CopyToAsync(ms);
            _uploadFiles.Add(new UploadFilePart(file.Name, ms.ToArray()));
        }
        StateHasChanged();
    }

    private async Task AddTorrentAsync()
    {
        if (!CanAdd) return;
        _adding = true;
        StateHasChanged();
        try
        {
            var subfolder = SubfolderPath.Normalize(_addSubfolder);
            if (_addSource == "magnet")
            {
                await Api.AddMagnetAsync(new AddMagnetRequest(
                    MagnetLink:             _addMagnet.Trim(),
                    FolderWatcherId:        _addFolderId,
                    StopAfterDownload:      _addStopAfter,
                    SkipSubfolderStructure: _addFlatten,
                    SuppressRootFolder:     _addStripRoot,
                    CustomRootFolderName:   subfolder,
                    DownloadLimitKBps:      _addDownloadKBps,
                    UploadLimitKBps:        _addUploadKBps));
            }
            else if (_addSource == "file" && _addFileBytes is not null)
            {
                await Api.AddTorrentFileAsync(new AddTorrentFileRequest(
                    Filename:               _addFileName ?? "torrent.torrent",
                    Base64Content:          Convert.ToBase64String(_addFileBytes),
                    FolderWatcherId:        _addFolderId,
                    StopAfterDownload:      _addStopAfter,
                    SkipSubfolderStructure: _addFlatten,
                    SuppressRootFolder:     _addStripRoot,
                    CustomRootFolderName:   subfolder,
                    DownloadLimitKBps:      _addDownloadKBps,
                    UploadLimitKBps:        _addUploadKBps,
                    // Unchecked files in the tree → engine skips them at add.
                    ExcludedFiles:          _deselected.Count > 0 ? _deselected.ToArray() : null));
            }
            else if (_addSource == "upload" && _addFolderId is Guid folder && _uploadFiles.Count > 0)
            {
                await Api.UploadFilesToFolderAsync(folder, _uploadFiles, subfolder);
            }

            _addMagnet = "";
            _addFileBytes = null;
            _addFileName  = null;
            _parsed       = null;
            _parseError   = null;
            _treeRoot     = null;
            _deselected.Clear();
            _uploadFiles.Clear();
            _addOpen = false;
            await LoadAsync();
        }
        catch { /* swallow */ }
        finally { _adding = false; StateHasChanged(); }
    }

    private static string FormatBytesShort(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F2} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024)      return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }

    // ─── File-selection tree ──────────────────────────────────────────────

    /// <summary>One node in the .torrent contents tree — a folder (Children)
    /// or a file (IsFile). FilePaths holds every descendant file path so a
    /// folder can cascade-select and report its check state in O(1)-ish.</summary>
    private sealed class TorNode
    {
        public string Name = "";
        public string FullPath = "";          // manifest path (files only)
        public bool   IsFile;
        public long   Size;                   // file size, or folder aggregate
        public bool   Expanded = true;
        public List<TorNode> Children = new();
        public List<string>  FilePaths = new();
    }

    /// <summary>Turn the flat manifest (paths with '/' or '\' separators) into a
    /// nested folder tree. Re-runs whenever a new .torrent is parsed.</summary>
    private void BuildTree()
    {
        _deselected.Clear();
        var root = new TorNode();
        if (_parsed is null) { _treeRoot = root; return; }

        foreach (var f in _parsed.Files)
        {
            var parts = f.Path.Split('/', '\\').Where(p => p.Length > 0).ToArray();
            if (parts.Length == 0) continue;
            var cur = root;
            for (var i = 0; i < parts.Length; i++)
            {
                if (i == parts.Length - 1)
                {
                    cur.Children.Add(new TorNode
                    {
                        Name = parts[i], FullPath = f.Path, IsFile = true, Size = f.Length,
                    });
                }
                else
                {
                    var next = cur.Children.FirstOrDefault(c => !c.IsFile && c.Name == parts[i]);
                    if (next is null)
                    {
                        next = new TorNode { Name = parts[i] };
                        cur.Children.Add(next);
                    }
                    cur = next;
                }
            }
        }

        ComputeAndSort(root);

        // If the torrent has NO single wrapping folder — multiple entries at the
        // top level, e.g. a "RUS Subs" folder sitting NEXT TO the episode files —
        // there's no one folder the user can uncheck to skip the whole download.
        // Unchecking "RUS Subs" then only clears the subs (correct: the episodes
        // are its siblings, not its children), which reads as a cascade bug.
        // Synthesize a root named after the torrent so everything nests under one
        // parent; unchecking it cascades to every file. A torrent that already
        // has one natural top folder is left untouched.
        if (root.Children.Count > 1)
        {
            var wrap = new TorNode
            {
                Name      = string.IsNullOrWhiteSpace(_parsed.Name) ? "(torrent)" : _parsed.Name,
                Size      = root.Size,
                FilePaths = root.FilePaths,
                Children  = root.Children,
                Expanded  = true,
            };
            var wrappedRoot = new TorNode { Size = root.Size, FilePaths = root.FilePaths };
            wrappedRoot.Children.Add(wrap);
            _treeRoot = wrappedRoot;
        }
        else
        {
            _treeRoot = root;
        }
    }

    /// <summary>Bottom-up: aggregate folder sizes + descendant file paths, then
    /// order each level folders-first, name-ascending.</summary>
    private static void ComputeAndSort(TorNode node)
    {
        if (node.IsFile) { node.FilePaths = new List<string> { node.FullPath }; return; }
        foreach (var c in node.Children) ComputeAndSort(c);
        node.Size      = node.Children.Sum(c => c.Size);
        node.FilePaths = node.Children.SelectMany(c => c.FilePaths).ToList();
        node.Children  = node.Children
            .OrderByDescending(c => !c.IsFile)
            .ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>Depth-first list of VISIBLE nodes (children of collapsed folders
    /// are omitted) with their indent depth — drives the flat render loop.</summary>
    private IEnumerable<(TorNode Node, int Depth)> FlattenTree()
    {
        var list = new List<(TorNode, int)>();
        if (_treeRoot is null) return list;
        void Walk(TorNode n, int depth)
        {
            foreach (var c in n.Children)
            {
                list.Add((c, depth));
                if (!c.IsFile && c.Expanded) Walk(c, depth + 1);
            }
        }
        Walk(_treeRoot, 0);
        return list;
    }

    /// <summary>0 = none of this node's files selected, 1 = all, 2 = partial.</summary>
    private int NodeCheckState(TorNode n)
    {
        if (n.IsFile) return _deselected.Contains(n.FullPath) ? 0 : 1;
        var total = n.FilePaths.Count;
        if (total == 0) return 1;
        var selected = n.FilePaths.Count(p => !_deselected.Contains(p));
        return selected == 0 ? 0 : selected == total ? 1 : 2;
    }

    /// <summary>Toggle a node: a fully-selected node clears; a partial/empty
    /// node selects. Cascades to every descendant file.</summary>
    private void ToggleNode(TorNode n)
    {
        var turnOn = NodeCheckState(n) != 1;
        foreach (var p in n.FilePaths)
        {
            if (turnOn) _deselected.Remove(p);
            else        _deselected.Add(p);
        }
    }

    private void ToggleExpand(TorNode n) => n.Expanded = !n.Expanded;

    private void SelectAllFiles() => _deselected.Clear();

    private void SelectNoneFiles()
    {
        if (_parsed is null) return;
        foreach (var f in _parsed.Files) _deselected.Add(f.Path);
    }

    private int  SelectedCount => (_parsed?.Files.Length ?? 0) - _deselected.Count;
    private long SelectedSize  => _parsed?.Files.Where(f => !_deselected.Contains(f.Path)).Sum(f => f.Length) ?? 0;

    private async Task PauseAsync(Guid id)
    {
        try { await Api.PauseTorrentAsync(id); await LoadAsync(); }
        catch { /* swallow */ }
    }

    private async Task ResumeAsync(Guid id)
    {
        try { await Api.ResumeTorrentAsync(id); await LoadAsync(); }
        catch { /* swallow */ }
    }

    // Torrent the delete-confirmation drawer is bound to. Null = closed.
    private TorrentRecordDto? _deleteTarget;
    private bool _deleting;

    /// <summary>Commit the delete chosen in the confirm drawer. deleteFiles=false
    /// keeps the downloaded media on disk (just drops the torrent + record);
    /// true also wipes the files. Either way the row leaves the list (the server
    /// hard-deletes the record).</summary>
    private async Task ConfirmDeleteAsync(bool deleteFiles)
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        StateHasChanged();
        try
        {
            await Api.DeleteTorrentAsync(_deleteTarget.Id, deleteFiles);
            _deleteTarget = null;
            await LoadAsync();
        }
        catch { /* swallow — drawer stays open so the user can retry */ }
        finally { _deleting = false; StateHasChanged(); }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChangedForAdd;
        if (_hub is not null) await _hub.DisposeAsync();
    }

    private static bool WantsAdd(string uri)
        => new Uri(uri).Query.Contains("add=1", StringComparison.Ordinal);

    // Same-page navigation (already on /downloads) doesn't re-init the
    // component, so the NavPane quick-add is picked up here too.
    private void OnLocationChangedForAdd(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!WantsAdd(e.Location) || _addOpen) return;
        InvokeAsync(() => { OpenAdd(); StateHasChanged(); });
    }

    private static string FormatRate(long bps)
    {
        if (bps <= 0) return "0";
        var units = new[] { "B/s", "KB/s", "MB/s", "GB/s" };
        double v = bps;
        int i = 0;
        while (v >= 1024 && i < units.Length - 1) { v /= 1024; i++; }
        return $"{v:F1} {units[i]}";
    }
}
