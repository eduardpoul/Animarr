    private RenderFragment HwCard(string name, string vendor, EncoderStatusDto s) => __builder =>
    {
        <SettingsCard Icon="flash" Title="@name" Description="@(s.Available ? StatusLine(s) : (s.Detail ?? vendor))">
            <span class="@($"fs-status {(s.Available ? "fs-status--ok" : "")}")">
                @(s.Available ? L["settings.hw_status_available"] : L["settings.hw_status_unavailable"])
            </span>
        </SettingsCard>
    };

    private async Task LoadPlayerAuxAsync()
    {
        if (_segStatus is null) await LoadSegStatusAsync();
        if (_hw is null) await LoadHardwareAsync();
    }

    private async Task LoadSegStatusAsync()
    {
        try { _segStatus = await Api.GetSegmentScanStatusAsync(); }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task RescanSegmentsAsync()
    {
        try
        {
            await Api.RescanSegmentsAsync();
            _segStatus = await Api.GetSegmentScanStatusAsync();
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private async Task LoadHardwareAsync(bool rescan = false)
    {
        try { _hw = await Api.GetHardwareReportAsync(rescan); }
        catch { /* offline */ }
        StateHasChanged();
    }

    // Instance method (not static) so it can localise the fallback strings.
    private string StatusLine(EncoderStatusDto s)
    {
        if (!s.Available) return s.Detail ?? L["settings.hw_status_unavailable"];
        var bits = new List<string>();
        if (!string.IsNullOrEmpty(s.Vendor))     bits.Add(s.Vendor);
        if (!string.IsNullOrEmpty(s.DeviceName)) bits.Add(s.DeviceName);
        return bits.Count == 0 ? L["settings.hw_status_available"] : string.Join(" — ", bits);
    }
