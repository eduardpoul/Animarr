    // ─── Metadata sources — enable flags ─────────────────────────────
    // Backend MetadataService.GatherCandidatesAsync reads
    // metadata.search_source_order as a JSON array of {Id, Enabled}.
    // We mirror that schema here verbatim instead of inventing parallel
    // boolean keys so the UI and server stay in lockstep.
    private sealed record SourceFlag(string Id, bool Enabled);

    /// <summary>Default flags applied when the AppConfig value is missing or
    /// malformed — kept in sync with MetadataService.ParseSourceOrder's
    /// defaults so a fresh install behaves identically with or without
    /// the row.</summary>
    private static readonly SourceFlag[] DefaultSourceFlags =
    {
        new("tmdb_tv",     true),
        new("tmdb_movie",  true),
        new("mal",         false),
        new("imdb_search", true),
    };

    private List<SourceFlag> ReadSourceFlags()
    {
        var json = _config.GetValueOrDefault(AppConfigKeys.SearchSourceOrder);
        if (string.IsNullOrWhiteSpace(json)) return DefaultSourceFlags.ToList();
        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<List<SourceFlag>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            return parsed is { Count: > 0 } ? parsed : DefaultSourceFlags.ToList();
        }
        catch { return DefaultSourceFlags.ToList(); }
    }

    private bool _sourceEnabled(string id)
        => ReadSourceFlags().FirstOrDefault(f =>
            string.Equals(f.Id, id, StringComparison.OrdinalIgnoreCase))?.Enabled ?? false;

    private async Task SetSourceEnabledAsync(string id, bool enabled)
    {
        var flags = ReadSourceFlags();
        var idx = flags.FindIndex(f => string.Equals(f.Id, id, StringComparison.OrdinalIgnoreCase));
        if (idx >= 0) flags[idx] = flags[idx] with { Enabled = enabled };
        else          flags.Add(new SourceFlag(id, enabled));
        var json = System.Text.Json.JsonSerializer.Serialize(flags);
        await SetConfigAsync(AppConfigKeys.SearchSourceOrder, json);
    }

    /// <summary>TMDb is stored as two separate source IDs on the server
    /// (tmdb_tv + tmdb_movie). The Settings UI hides that under one toggle
    /// for clarity — flipping it touches both flags at once.</summary>
    private async Task ToggleTmdbAsync(bool enabled)
    {
        await SetSourceEnabledAsync("tmdb_tv", enabled);
        await SetSourceEnabledAsync("tmdb_movie", enabled);
    }

    private Task ToggleMalAsync(bool enabled)  => SetSourceEnabledAsync("mal",         enabled);
    private Task ToggleImdbAsync(bool enabled) => SetSourceEnabledAsync("imdb_search", enabled);

    private async Task TestLlmAsync()
    {
        if (_llmTesting) return;
        _llmTesting = true;
        _llmTestResult = null;
        StateHasChanged();
        try { _llmTestResult = await Api.TestLlmAsync(); }
        catch (Exception ex)
        {
            // Transport-level failure (DelegatingHandler couldn't resolve,
            // server unreachable, etc.) — synthesise an error response so
            // the result card path is unified.
            _llmTestResult = new LlmTestResponse(
                Ok: false, LatencyMs: 0, Sample: null, Error: ex.Message);
        }
        _llmTesting = false;
        StateHasChanged();
    }

    // ── Patterns tab ──
    private RenderFragment PatternsTab() => @<section class="settings-section">
        <div class="settings-section-head">
