            <h3>@L["settings.ext_player_title"]</h3>
            <label class="settings-field">
                <span class="settings-field__label">@L["settings.ext_player_label"]</span>
                <select class="settings-field__select" value="@extPlay"
                        @onchange="@(e => SetConfigAsync(AppConfigKeys.ExternalPlayer, e.Value?.ToString()))">
                    <option value="mpv">mpv</option>
                    <option value="iina">IINA (macOS)</option>
                    <option value="infuse">Infuse (iOS / Apple TV)</option>
                    <option value="vlc_ios">VLC (iOS)</option>
                    <option value="m3u">@L["settings.ext_player_m3u"]</option>
                    <option value="custom">@L["settings.ext_player_custom_opt"]</option>
                </select>
            </label>
            @if (extPlay == "custom")
            {
                <label class="settings-field">
                    <span class="settings-field__label">@((MarkupString)L["settings.ext_player_custom_label_html"])</span>
                    <input class="settings-field__input" placeholder="potplayer://{url}"
                           value="@extCust"
                           @onchange="@(e => SetConfigAsync(AppConfigKeys.ExternalPlayerCustom, e.Value?.ToString()))" />
                </label>
            }

            <h3>@L["settings.skip_intro_title"]</h3>
            <p class="settings-hint">
                @L["settings.skip_intro_intro"]
            </p>
            <label class="settings-field settings-field--inline">
                <Toggle Checked="@segAniSkip"
                        CheckedChanged="@((bool v) => SetConfigAsync(AppConfigKeys.SegmentsAniSkipEnabled, v ? "true" : "false"))" />
                <span class="settings-field__label">@L["settings.seg_aniskip_label"]</span>
            </label>
            <label class="settings-field settings-field--inline">
                <Toggle Checked="@segChapters"
                        CheckedChanged="@((bool v) => SetConfigAsync(AppConfigKeys.SegmentsChaptersEnabled, v ? "true" : "false"))" />
                <span class="settings-field__label">@L["settings.seg_chapters_label"]</span>
            </label>
            <label class="settings-field settings-field--inline">
                <Toggle Checked="@segChroma"
                        CheckedChanged="@((bool v) => SetConfigAsync(AppConfigKeys.SegmentsChromaprintEnabled, v ? "true" : "false"))" />
                <span class="settings-field__label">@L["settings.seg_chroma_label"]</span>
            </label>
            <label class="settings-field settings-field--inline">
                <Toggle Checked="@segBlackFrame"
                        CheckedChanged="@((bool v) => SetConfigAsync(AppConfigKeys.SegmentsBlackFrameEnabled, v ? "true" : "false"))" />
                <span class="settings-field__label">@L["settings.seg_blackframe_label"]</span>
            </label>
            <div class="settings-field settings-field--inline" style="justify-content: space-between; gap: 12px;">
                <span class="settings-hint">
                    @if (_segStatus is { } seg)
                    {
                        @L.Get("settings.seg_analysed_fmt", seg.ScannedTitles, seg.TotalTitles, seg.TitlesWithSegments)
                    }
                    else
                    {
                        @L["settings.seg_analysis_progress"]
                    }
                </span>
                <button type="button" class="settings-section-head__new tv-focus" @onclick="RescanSegmentsAsync">@L["settings.btn_rescan_all"]</button>
            </div>
        </section>;
    }

    // ── Helpers ──
    // Instance method (not static) so it can localise the fallback strings
    // through the injected LocalizationService.
    private string StatusLine(EncoderStatusDto s)
    {
        if (!s.Available) return s.Detail ?? L["settings.hw_status_unavailable"];
        var bits = new List<string>();
        if (!string.IsNullOrEmpty(s.Vendor))     bits.Add(s.Vendor);
        if (!string.IsNullOrEmpty(s.DeviceName)) bits.Add(s.DeviceName);
        return bits.Count == 0 ? L["settings.hw_status_available"] : string.Join(" — ", bits);
    }
}
