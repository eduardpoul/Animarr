@*
    Settings — the "Server" group bodies of the /settings hub, drawn as
    Fluent 2 settings cards. Embedded only: <Settings EmbeddedTab="..." />
    with EmbeddedTab = root_folders | ai | torrent | metadata | player.
    (The old standalone tabs — general / appearance / audio / hardware /
    parsing — are gone; appearance + audio live in PersonalSettings, the
    hardware report moved under "player".)
*@
@inject IAnimarrApiClient Api
@implements IDisposable

@switch (_activeTab)
{
    case "root_folders":
        @RootFoldersTab()
        break;
    case "ai":
        @AiTab()
        break;
    case "torrent":
        @TorrentTab()
        break;
    case "metadata":
        @MetadataTab()
        break;
    case "player":
        @PlayerTab()
        break;
}

@if (_folderDialogOpen)
{
    <SectionFolderDialog Existing="@_folderDialogTarget"
                         OnSaved="OnFolderSaved"
                         OnCanceled="@(() => _folderDialogOpen = false)" />
}
@if (_folderDeleteOpen && _folderDeleteTarget is not null)
{
    <SectionFolderDeleteDialog Section="@_folderDeleteTarget"
                               OnRemoved="OnFolderDeleted"
                               OnCanceled="@(() => _folderDeleteOpen = false)" />
}

@code {
    /// <summary>Which server section to render (see file header).</summary>
    [Parameter] public string? EmbeddedTab { get; set; }

    private string _activeTab = "root_folders";
    /// <summary>The tab we last loaded data for — Blazor reuses this
    /// instance when the hub switches EmbeddedTab, so the per-tab fetch has
    /// to re-fire from OnParametersSetAsync.</summary>
    private string? _lastLoadedTab;

    // ── Tab state (lazy, per tab) ────────────────────────────────────
    private Dictionary<string, string?> _config = new();
    private bool _configLoaded;
    private HardwareReportDto? _hw;
    private TorrentConfigDto? _torrentCfg;
    private SegmentScanStatusDto? _segStatus;
    private MetadataLanguageStatusDto? _langStatus;

    // ── Folder dialogs ──
    private bool _folderDialogOpen;
    private FolderWatcherDto? _folderDialogTarget;
    private bool _folderDeleteOpen;
    private FolderWatcherDto? _folderDeleteTarget;
    private int _foldersReloadToken;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(EmbeddedTab)) _activeTab = EmbeddedTab;

        if (!_configLoaded)
        {
            _configLoaded = true;
            try
            {
                var pairs = await Api.GetAppConfigAsync();
                _config = pairs.ToDictionary(p => p.Key, p => p.Value);
            }
            catch { /* offline — config dict stays empty */ }
        }

        if (_activeTab != _lastLoadedTab)
        {
            _lastLoadedTab = _activeTab;
            await EnsureTabDataAsync(_activeTab);
        }
    }

    private async Task EnsureTabDataAsync(string key) => await (key switch
    {
        "torrent"  when _torrentCfg is null => LoadTorrentAsync(),
        "ai"       when _catalog is null    => LoadEmbeddedAsync(),
        "metadata"                          => LoadLangStatusAsync(),
        "player"                            => LoadPlayerAuxAsync(),
        _ => Task.CompletedTask,
    });

    private bool Flag(string key, bool dflt)
    {
        var v = _config.GetValueOrDefault(key);
        return v is null ? dflt : v == "true";
    }

    private async Task SetConfigAsync(string key, string? value)
    {
        try
        {
            await Api.SetAppConfigValueAsync(key, value);
            _config[key] = value;
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private Task SetFlagAsync(string key, bool v) => SetConfigAsync(key, v ? "true" : "false");

    public void Dispose()
    {
        try { _pollCts?.Cancel(); _pollCts?.Dispose(); } catch { /* ignore */ }
        try { _langPollCts?.Cancel(); _langPollCts?.Dispose(); } catch { /* ignore */ }
    }

    // ══ Root folders ═══════════════════════════════════════════════
    private RenderFragment RootFoldersTab() => __builder =>
    {
        <SettingsGroup Description="@L["settings.root_folders_desc"]">
            <Actions>
                <Btn Variant="primary" OnClick="@(() => { _folderDialogTarget = null; _folderDialogOpen = true; })">
                    <DIcon Name="plus" Size="16" /> @L["settings.btn_add_section"]
                </Btn>
            </Actions>
            <ChildContent>
                <RootFoldersList ReloadToken="_foldersReloadToken"
                                 OnEdit="OnFolderEdit"
                                 OnDelete="OnFolderDelete" />
            </ChildContent>
        </SettingsGroup>
    };

    private void OnFolderEdit(FolderWatcherDto f)   { _folderDialogTarget = f; _folderDialogOpen = true; }
    private void OnFolderDelete(FolderWatcherDto f) { _folderDeleteTarget = f; _folderDeleteOpen = true; }

    private void OnFolderSaved()
    {
        _folderDialogOpen = false;
        _foldersReloadToken++;
        StateHasChanged();
    }
    private void OnFolderDeleted()
    {
        _folderDeleteOpen = false;
        _foldersReloadToken++;
        StateHasChanged();
    }

    // ══ AI / LLM ═══════════════════════════════════════════════════
    private RenderFragment AiTab() => __builder =>
    {
        var enabled  = Flag(AppConfigKeys.LlmEnabled, false);
        var provider = _config.GetValueOrDefault(AppConfigKeys.LlmProvider) ?? "openai";
        var epMap    = Flag(AppConfigKeys.LlmEpisodeMapping, false);

        <SettingsGroup Title="@L["settings.ai_group_identify"]">
            <SettingsCard Icon="sparkle" Title="@L["settings.llm_use_during_id"]" Description="@L["settings.llm_use_desc"]">
                <Toggle Checked="@enabled" CheckedChanged="@((bool v) => SetFlagAsync(AppConfigKeys.LlmEnabled, v))" />
            </SettingsCard>
            <SettingsCard Icon="list" Title="@L["settings.llm_episode_mapping_switch"]" Description="@L["settings.llm_episode_mapping_desc"]">
                <Toggle Checked="@epMap" CheckedChanged="@((bool v) => SetFlagAsync(AppConfigKeys.LlmEpisodeMapping, v))" />
            </SettingsCard>
        </SettingsGroup>

        <SettingsGroup Title="@L["settings.ai_group_model"]">
            <SettingsCard Icon="bot" Title="@L["settings.llm_provider_label"]" Description="@L["settings.llm_provider_desc"]">
                <ChildContent>
                    <select class="fs-select" value="@provider"
                            @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmProvider, e.Value?.ToString()))">
                        <option value="embedded">@L["settings.llm_provider_opt_embedded"]</option>
                        <option value="compatible">@L["settings.llm_provider_opt_compatible"]</option>
                        <option value="openai">@L["settings.llm_provider_opt_openai"]</option>
                    </select>
                </ChildContent>
                <Body>
                    @if (provider == "embedded")
                    {
                        @EmbeddedBlock()
                    }
                    else
                    {
                        @RemoteBlock()
                    }
                </Body>
            </SettingsCard>

            @* Test connection — one small ping against the saved config. *@
            <SettingsCard Icon="flash" Title="@L["settings.llm_test_title"]" Description="@L["settings.llm_test_desc"]"
                          Body="@(_llmTestResult is null ? null : LlmTestResult())">
                <Btn Variant="solid" Loading="@_llmTesting" OnClick="TestLlmAsync">
                    @(_llmTesting ? L["settings.llm_hero_btn_testing"] : L["settings.llm_hero_btn_test"])
                </Btn>
            </SettingsCard>
        </SettingsGroup>

        <SettingsGroup Title="@L["settings.ai_group_help"]">
            <SettingsCard Icon="info" Title="@L["settings.llm_docs_title"]" Description="@L["settings.llm_docs_desc"]" Expandable="true">
                <Body>
                    <ul class="set-docs">
                        <li>@((MarkupString)L["settings.llm_docs_li_cpu_html"])</li>
                        <li>@((MarkupString)L["settings.llm_docs_li_gpu_html"])</li>
                        <li>@((MarkupString)L["settings.llm_docs_li_compatible_html"])</li>
                        <li>@((MarkupString)L["settings.llm_docs_li_openai_html"])</li>
                    </ul>
                    <p class="fs-hint">@((MarkupString)L["settings.llm_docs_footer_html"])</p>
                </Body>
            </SettingsCard>
        </SettingsGroup>
    };

    private RenderFragment RemoteBlock() => __builder =>
    {
        var baseUrl = _config.GetValueOrDefault(AppConfigKeys.LlmBaseUrl) ?? "";
        var apiKey  = _config.GetValueOrDefault(AppConfigKeys.LlmApiKey) ?? "";
        var model   = _config.GetValueOrDefault(AppConfigKeys.LlmModel) ?? "";
        <label class="fs-field">
            <span class="fs-field__label">@L["settings.llm_base_url_label"]</span>
            <input class="fs-input fs-input--wide" placeholder="http://ollama:11434/v1"
                   value="@baseUrl"
                   @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmBaseUrl, e.Value?.ToString()))" />
        </label>
        <div class="fs-grid-2">
            <label class="fs-field">
                <span class="fs-field__label">@L["settings.llm_api_key_label"]</span>
                <input class="fs-input fs-input--wide" type="password" placeholder="sk-…"
                       value="@apiKey"
                       @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmApiKey, e.Value?.ToString()))" />
            </label>
            <label class="fs-field">
                <span class="fs-field__label">@L["settings.llm_model_label"]</span>
                <input class="fs-input fs-input--wide" placeholder="qwen2.5:1.5b"
                       value="@model"
                       @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmModel, e.Value?.ToString()))" />
            </label>
        </div>
    };

    private RenderFragment LlmTestResult() => __builder =>
    {
        if (_llmTestResult is not { } r) return;
        <div class="@($"fs-msgbar {(r.Ok ? "fs-msgbar--success" : "fs-msgbar--error")}")">
            <span class="fs-msgbar__ic"><DIcon Name="@(r.Ok ? "check" : "warn")" Size="16" /></span>
            <div>
                @if (r.Ok)
                {
                    <div><strong>@L["settings.llm_test_connected"]</strong> @L.Get("settings.llm_test_latency_fmt", r.LatencyMs)</div>
                    @if (!string.IsNullOrEmpty(r.Sample))
                    {
                        <div class="fs-hint">@L["settings.llm_test_sample_label"] <code>@r.Sample</code></div>
                    }
                }
                else
                {
                    <div><strong>@L["settings.llm_test_failed"]</strong> @L.Get("settings.llm_test_after_fmt", r.LatencyMs)</div>
                    @if (!string.IsNullOrEmpty(r.Error))
                    {
                        <div class="fs-hint">@r.Error</div>
                    }
                }
            </div>
        </div>
    };

    private bool _llmTesting;
    private LlmTestResponse? _llmTestResult;

    private async Task TestLlmAsync()
    {
        if (_llmTesting) return;
        _llmTesting = true;
        _llmTestResult = null;
        StateHasChanged();
        try { _llmTestResult = await Api.TestLlmAsync(); }
        catch (Exception ex)
        {
            // Transport-level failure — synthesise an error so the result
            // card path is unified.
            _llmTestResult = new LlmTestResponse(Ok: false, LatencyMs: 0, Sample: null, Error: ex.Message);
        }
        _llmTesting = false;
        StateHasChanged();
    }

    // ── Embedded llama.cpp (provider = "embedded") ──────────────────────────
    private LlamaCatalogResponse? _catalog;
    private EmbeddedStatusDto?    _embeddedStatus;
    private DownloadProgressDto?  _download;
    private string _customRepo = "";
    private string _customFile = "";
    private bool   _embeddedBusy;
    private CancellationTokenSource? _pollCts;
    private CancellationTokenSource? _langPollCts;

    private async Task LoadEmbeddedAsync()
    {
        try
        {
            _catalog        = await Api.GetLlamaCatalogAsync();
            _embeddedStatus = await Api.GetEmbeddedStatusAsync();
            _download       = await Api.GetLlamaDownloadStatusAsync();
            if (_download is { Phase: "downloading" }) _ = PollDownloadAsync();
        }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task StartDownloadAsync()
    {
        if (_embeddedBusy) return;
        var id = _config.GetValueOrDefault(AppConfigKeys.LlmEmbeddedModelId) ?? "";
        if (string.IsNullOrEmpty(id)) return;
        _embeddedBusy = true; StateHasChanged();
        try
        {
            await Api.StartLlamaDownloadAsync(new StartDownloadRequest(id, _customRepo, _customFile));
            _ = PollDownloadAsync();
        }
        catch (Exception ex)
        {
            _download = new DownloadProgressDto(id, null, 0, null, 0, "error", ex.Message);
        }
        finally { _embeddedBusy = false; StateHasChanged(); }
    }

    private async Task PollDownloadAsync()
    {
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        var ct = _pollCts.Token;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(750, ct);
                _download = await Api.GetLlamaDownloadStatusAsync();
                await InvokeAsync(StateHasChanged);
                if (_download is null || _download.Phase != "downloading")
                {
                    _catalog        = await Api.GetLlamaCatalogAsync();
                    _embeddedStatus = await Api.GetEmbeddedStatusAsync();
                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }
        }
        catch (OperationCanceledException) { /* navigated away / superseded */ }
        catch { /* swallow */ }
    }

    private async Task CancelDownloadAsync()
    {
        try { await Api.CancelLlamaDownloadAsync(); } catch { /* swallow */ }
    }

    private async Task DeleteModelAsync(string file)
    {
        try
        {
            await Api.DeleteLlamaModelAsync(file);
            _catalog = await Api.GetLlamaCatalogAsync();
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private async Task RestartEmbeddedAsync()
    {
        if (_embeddedBusy) return;
        _embeddedBusy = true; StateHasChanged();
        try { _embeddedStatus = await Api.RestartEmbeddedAsync(); }
        catch { /* swallow */ }
        finally { _embeddedBusy = false; StateHasChanged(); }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "—";
        double mb = bytes / 1024d / 1024d;
        return mb >= 1024 ? $"{mb / 1024:F1} GB" : $"{mb:F0} MB";
    }

    private static string StateTone(string? state) => (state ?? "").ToLowerInvariant() switch
    {
        "running" or "ready" or "started" => "fs-status--ok",
        "error" or "failed"               => "fs-status--err",
        _                                 => "fs-status--warn",
    };

    // Runtime status, model picker (curated + custom HF), download progress,
    // installed-model management.
    private RenderFragment EmbeddedBlock() => __builder =>
    {
        var selId       = _config.GetValueOrDefault(AppConfigKeys.LlmEmbeddedModelId) ?? "";
        var selCurated  = _catalog?.Curated.FirstOrDefault(c => c.Id == selId);
        var dl          = _download;
        var downloading = dl is { Phase: "downloading" };

        if (_embeddedStatus is { } st)
        {
            <div class="fs-row set-status-row">
                <span class="@($"fs-status {StateTone(st.State)}")">@st.State</span>
                <span class="fs-hint">llama-server · @(st.GpuActive ? $"GPU · {st.GpuMode}" : "CPU")@(string.IsNullOrEmpty(st.ModelFile) ? "" : " · " + st.ModelFile)</span>
                <span class="set-spacer"></span>
                <Btn Variant="solid" Loading="@_embeddedBusy" OnClick="RestartEmbeddedAsync">
                    <DIcon Name="refresh" Size="16" /> @L["settings.embedded_btn_restart"]
                </Btn>
            </div>
            if (!string.IsNullOrEmpty(st.Error))
            {
                <div class="fs-msgbar fs-msgbar--error"><span class="fs-msgbar__ic"><DIcon Name="warn" Size="16" /></span>@st.Error</div>
            }
        }

        <label class="fs-field">
            <span class="fs-field__label">@L["settings.llm_model_label"]</span>
            <select class="fs-select fs-select--wide" value="@selId"
                    @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmEmbeddedModelId, e.Value?.ToString()))">
                <option value="">@L["settings.embedded_select_model"]</option>
                @if (_catalog is { } cat)
                {
                    @foreach (var m in cat.Curated)
                    {
                        <option value="@m.Id">@m.DisplayName · @FormatBytes(m.ApproxBytes) @(m.GpuRecommended ? "· GPU" : "· CPU")@(m.Installed ? " ✓" : "")</option>
                    }
                }
                <option value="custom">@L["settings.embedded_custom_hf"]</option>
            </select>
            @if (selCurated is { } sc)
            {
                <span class="fs-hint">@sc.Notes @L.Get("settings.embedded_ram_fmt", sc.RecommendedRamMb)</span>
            }
        </label>

        if (selId == "custom")
        {
            <div class="fs-grid-2">
                <label class="fs-field">
                    <span class="fs-field__label">@L["settings.embedded_hf_repo_label"]</span>
                    <input class="fs-input fs-input--wide" placeholder="Qwen/Qwen2.5-1.5B-Instruct-GGUF"
                           value="@_customRepo" @oninput="@(e => _customRepo = e.Value?.ToString() ?? "")" />
                </label>
                <label class="fs-field">
                    <span class="fs-field__label">@L["settings.embedded_gguf_file_label"]</span>
                    <input class="fs-input fs-input--wide" placeholder="qwen2.5-1.5b-instruct-q4_k_m.gguf"
                           value="@_customFile" @oninput="@(e => _customFile = e.Value?.ToString() ?? "")" />
                </label>
            </div>
            <p class="fs-hint">@((MarkupString)L["settings.embedded_custom_hint_html"])</p>
        }

        <div class="fs-row">
            <Btn Variant="primary" Disabled="@(_embeddedBusy || string.IsNullOrEmpty(selId) || downloading)" OnClick="StartDownloadAsync">
                <DIcon Name="download" Size="16" />
                @(downloading ? L["settings.embedded_downloading"] : L["settings.embedded_download_model"])
            </Btn>
        </div>

        if (dl is { } d && d.Phase != "idle")
        {
            <div class="set-progress">
                <div class="set-progress__bar"><div class="set-progress__fill" style="width:@((int)d.Percent)%"></div></div>
                <div class="set-progress__text">
                    @if (d.Phase == "downloading")
                    {
                        <span>@FormatBytes(d.BytesReceived) / @(d.TotalBytes is { } t ? FormatBytes(t) : "?") (@((int)d.Percent)%)</span>
                        <Btn Variant="flat" Size="sm" OnClick="CancelDownloadAsync">@L["common.btn_cancel"]</Btn>
                    }
                    else if (d.Phase == "done")      { <span class="is-ok">@L["settings.embedded_done"]</span> }
                    else if (d.Phase == "cancelled") { <span class="is-warn">@L["settings.embedded_cancelled"]</span> }
                    else if (d.Phase == "error")     { <span class="is-err">@L.Get("folder_files.toast_error", d.Error ?? "")</span> }
                </div>
            </div>
        }

        if (_catalog is { Installed.Length: > 0 } c2)
        {
            <div class="fs-field">
                <span class="fs-field__label">@L["settings.embedded_installed_label"]</span>
                <div class="fs-list">
                    @foreach (var m in c2.Installed)
                    {
                        var file = m.FileName;
                        <div class="fs-list__row">
                            <DIcon Name="@(m.IsActive ? "check" : "file")" Size="16" />
                            <span class="fs-list__main">
                                <span class="fs-list__title set-mono">@m.FileName</span>
                                <span class="fs-list__meta">@FormatBytes(m.Bytes)@(m.IsActive ? " · " + L["settings.embedded_active_suffix"] : "")</span>
                            </span>
                            <button type="button" class="fs-icon-btn fs-icon-btn--danger tv-focus"
                                    disabled="@m.IsActive" @onclick="@(() => DeleteModelAsync(file))"
                                    title="@(m.IsActive ? L["settings.embedded_active_tooltip"] : L["settings.btn_delete_tooltip"])"
                                    aria-label="@L["settings.btn_delete_tooltip"]">
                                <DIcon Name="trash" Size="16" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    };

    // ══ Downloads (torrent engine) ═════════════════════════════════
    private RenderFragment TorrentTab() => __builder =>
    {
        if (_torrentCfg is not { } cfg)
        {
            <div class="fs-msgbar fs-msgbar--info">
                <span class="fs-msgbar__ic"><Spinner Size="sm" /></span>
                @L["common.loading"]
            </div>
            return;
        }

        <SettingsGroup Title="@L["settings.torrent_group_speed"]" Description="@L["settings.torrent_limit_desc"]">
            <SettingsCard Icon="download" Title="@L["settings.torrent_dl_limit_mbs"]">
                <input class="fs-input fs-input--num" type="number" min="0"
                       aria-label="@L["settings.torrent_dl_limit_mbs"]"
                       value="@(cfg.GlobalDownloadLimit / 125_000)"
                       @onchange="@(e => UpdateTorrentDownload(int.TryParse(e.Value?.ToString(), out var v) ? v : 0))" />
            </SettingsCard>
            <SettingsCard Icon="upload" Title="@L["settings.torrent_ul_limit_mbs"]">
                <input class="fs-input fs-input--num" type="number" min="0"
                       aria-label="@L["settings.torrent_ul_limit_mbs"]"
                       value="@(cfg.GlobalUploadLimit / 125_000)"
                       @onchange="@(e => UpdateTorrentUpload(int.TryParse(e.Value?.ToString(), out var v) ? v : 0))" />
            </SettingsCard>
        </SettingsGroup>

        <SettingsGroup Title="@L["settings.torrent_group_network"]">
            <SettingsCard Icon="link" Title="@L["settings.torrent_port_label"]" Description="@L["settings.torrent_port_desc"]">
                <input class="fs-input fs-input--num" type="number" min="1" max="65535"
                       aria-label="@L["settings.torrent_port_label"]"
                       value="@cfg.ListenPort"
                       @onchange="@(e => UpdateTorrentField(c => c with { ListenPort = int.TryParse(e.Value?.ToString(), out var v) ? v : c.ListenPort }))" />
            </SettingsCard>
            <SettingsCard Icon="globe" Title="@L["settings.torrent_dht_short"]" Description="@L["settings.torrent_dht_desc"]">
                <Toggle Checked="@cfg.EnableDHT" CheckedChanged="@((bool v) => UpdateTorrentField(c => c with { EnableDHT = v }))" />
            </SettingsCard>
            <SettingsCard Icon="server" Title="@L["settings.torrent_lsd_full"]" Description="@L["settings.torrent_lsd_desc"]">
                <Toggle Checked="@cfg.EnableLSD" CheckedChanged="@((bool v) => UpdateTorrentField(c => c with { EnableLSD = v }))" />
            </SettingsCard>
            <SettingsCard Icon="shield" Title="@L["settings.torrent_upnp_short"]" Description="@L["settings.torrent_upnp_desc"]">
                <Toggle Checked="@cfg.EnableUPnP" CheckedChanged="@((bool v) => UpdateTorrentField(c => c with { EnableUPnP = v }))" />
            </SettingsCard>
        </SettingsGroup>
    };

    private async Task LoadTorrentAsync()
    {
        try { _torrentCfg = await Api.GetTorrentConfigAsync(); }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task UpdateTorrentField(Func<TorrentConfigDto, TorrentConfigDto> mutate)
    {
        if (_torrentCfg is null) return;
        _torrentCfg = mutate(_torrentCfg);
        try { _torrentCfg = await Api.UpdateTorrentConfigAsync(_torrentCfg); }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private Task UpdateTorrentDownload(int mbps)
        => UpdateTorrentField(c => c with { GlobalDownloadLimit = mbps * 125_000 });

    private Task UpdateTorrentUpload(int mbps)
        => UpdateTorrentField(c => c with { GlobalUploadLimit = mbps * 125_000 });

    // ══ Metadata ═══════════════════════════════════════════════════
    // Source enable flags live in metadata.search_source_order as a JSON
    // array of {Id, Enabled} — MetadataService.GatherCandidatesAsync reads
    // that format, so the UI mirrors it verbatim.
    private sealed record SourceFlag(string Id, bool Enabled);

    /// <summary>Defaults when the AppConfig value is missing or malformed —
    /// kept in sync with MetadataService.ParseSourceOrder.</summary>
    private static readonly SourceFlag[] DefaultSourceFlags =
    {
        new("tmdb_tv",     true),
        new("tmdb_movie",  true),
        new("mal",         false),
        new("imdb_search", true),
    };

    private List<SourceFlag> ReadSourceFlags()
    {
        var json = _config.GetValueOrDefault(AppConfigKeys.SearchSourceOrder);
        if (string.IsNullOrWhiteSpace(json)) return DefaultSourceFlags.ToList();
        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<List<SourceFlag>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            return parsed is { Count: > 0 } ? parsed : DefaultSourceFlags.ToList();
        }
        catch { return DefaultSourceFlags.ToList(); }
    }

    private bool SourceEnabled(string id)
        => ReadSourceFlags().FirstOrDefault(f =>
            string.Equals(f.Id, id, StringComparison.OrdinalIgnoreCase))?.Enabled ?? false;

    private async Task SetSourceEnabledAsync(string id, bool enabled)
    {
        var flags = ReadSourceFlags();
        var idx = flags.FindIndex(f => string.Equals(f.Id, id, StringComparison.OrdinalIgnoreCase));
        if (idx >= 0) flags[idx] = flags[idx] with { Enabled = enabled };
        else          flags.Add(new SourceFlag(id, enabled));
        await SetConfigAsync(AppConfigKeys.SearchSourceOrder, System.Text.Json.JsonSerializer.Serialize(flags));
    }

    /// <summary>TMDb is two source IDs on the server (tv + movie) behind one switch.</summary>
