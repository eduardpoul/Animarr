@*
    Settings — component-only after v4 cleanup. The standalone /settings route
    is gone; this body is embedded inside ServerSettings.razor's admin shell
    via <Settings EmbeddedTab="..." />. Setting EmbeddedTab forces a single
    tab body to render without the page header / tab bar.
*@
@inject IAnimarrApiClient Api
@inject NavigationManager Nav
@implements IDisposable

@*
    Settings — 11-tab layout mirroring Animarr.Web's structure.

    Each tab fetches its own slice via IAnimarrApiClient. Heavy operations
    (folder picker, audio sync test playback, LLM model probe) are skipped
    relative to the server-side page — those need additional API surface
    or interop. Everything users edit on a day-to-day basis is here.
*@

@if (string.IsNullOrEmpty(EmbeddedTab))
{
    <PageTitle>Animarr</PageTitle>

    <header class="d-page-header">
        <div class="d-page-header__main">
            <div class="d-page-header__overline">@L["settings.page_overline"]</div>
            <h1 class="d-page-header__title">@L["settings.page_title"]</h1>
            <div class="d-page-header__sub">@L["settings.header_sub_sqlite"]</div>
        </div>
    </header>

    <nav class="settings-tabs">
        @foreach (var (key, label) in _settingsTabs)
        {
            var k = key;
            <button type="button"
                    class="@($"settings-tab {(_activeTab == k ? "settings-tab--active" : "")}")"
                    @onclick="@(() => SwitchTabAsync(k))">
                @L[label]
            </button>
        }
    </nav>
}

@if      (_activeTab == "general")        { @GeneralTab()       }
else if  (_activeTab == "root_folders")   { @RootFoldersTab()   }
else if  (_activeTab == "appearance")     { @AppearanceTab()    }
else if  (_activeTab == "audio")          { @AudioTab()         }
else if  (_activeTab == "hardware")       { @HardwareTab()      }
else if  (_activeTab == "ai")             { @AiTab()            }
else if  (_activeTab == "patterns")       { @PatternsTab()      }
else if  (_activeTab == "torrent")        { @TorrentTab()       }
else if  (_activeTab == "metadata")       { @MetadataTab()      }

@if (_folderDialogOpen)
{
    <SectionFolderDialog Existing="@_folderDialogTarget"
                         OnSaved="OnFolderSaved"
                         OnCanceled="@(() => _folderDialogOpen = false)" />
}
@if (_folderDeleteOpen && _folderDeleteTarget is not null)
{
    <SectionFolderDeleteDialog Section="@_folderDeleteTarget"
                               OnRemoved="OnFolderDeleted"
                               OnCanceled="@(() => _folderDeleteOpen = false)" />
}

@code {
    /// <summary>When set, the component renders as a single tab body without
    /// its own page header / tab bar. Used by ServerSettings to embed each
    /// v3 tab inside the v4 admin shell. Allowed values mirror the
    /// <c>_settingsTabs</c> keys (e.g. "root_folders", "ai", "patterns").</summary>
    [Parameter] public string? EmbeddedTab { get; set; }

    private string _activeTab = "general";
    /// <summary>Tracks the tab we last loaded data for so flipping
    /// <see cref="EmbeddedTab"/> from "rules" to "torrent" (which Blazor
    /// services by reusing the Settings instance, not re-mounting) still
    /// kicks off the per-tab fetch. Previously this only ran inside
    /// OnInitializedAsync and embedded panels stayed stuck on "Loading…". </summary>
    private string? _lastLoadedTab;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(EmbeddedTab))
            _activeTab = EmbeddedTab;
        // When the parent re-renders us with a different EmbeddedTab the
        // OnInitializedAsync hook has long since run, so the per-tab fetch
        // is skipped. Re-fire EnsureTabDataAsync here whenever the tab
        // identity differs from what we last loaded. Cheap branch (no
        // fetch) for tabs that read straight from the _config dict.
        if (_activeTab != _lastLoadedTab)
        {
            _lastLoadedTab = _activeTab;
            await EnsureTabDataAsync(_activeTab);
        }
    }

    // Label holds an i18n key resolved through L at render time (@L[label]).
    private static readonly (string Key, string Label)[] _settingsTabs =
    [
        ("general",        "settings.tab_general"),
        ("root_folders",   "settings.tab_root_folders"),
        ("appearance",     "settings.tab_appearance"),
        ("audio",          "settings.tab_audio"),
        ("hardware",       "settings.tab_hardware"),
        ("ai",             "settings.tab_ai"),
        ("patterns",       "settings.tab_parsing"),
        ("torrent",        "settings.tab_torrent"),
        ("metadata",       "settings.tab_metadata"),
    ];

    // ── Tab-state (lazy-initialised on first tab visit) ──────────────
    private Dictionary<string, string?> _config = new();
    private HardwareReportDto? _hw;
    private RenamePatternDto[]? _patterns;
    private TorrentConfigDto? _torrentCfg;
    private SegmentScanStatusDto? _segStatus;
    private MetadataLanguageStatusDto? _langStatus;

    // ── Dialog state ──
    private bool _folderDialogOpen;
    private FolderWatcherDto? _folderDialogTarget;
    private bool _folderDeleteOpen;
    private FolderWatcherDto? _folderDeleteTarget;
    private int _foldersReloadToken;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pairs = await Api.GetAppConfigAsync();
            _config = pairs.ToDictionary(p => p.Key, p => p.Value);
        }
        catch { /* offline — config dict stays empty */ }

        // Deep-link via ?tab= — e.g. /settings?tab=patterns (legacy Patterns
        // redirect). Skip when we're embedded inside ServerSettings so a
        // ?panel=… query string for that page doesn't accidentally clobber
        // the EmbeddedTab the parent picked for us.
        if (string.IsNullOrEmpty(EmbeddedTab))
        {
            var uri = new Uri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var requestedTab = query["tab"];
            if (!string.IsNullOrEmpty(requestedTab) && _settingsTabs.Any(t => t.Key == requestedTab))
                _activeTab = requestedTab;
        }

        _lastLoadedTab = _activeTab;
        await EnsureTabDataAsync(_activeTab);
    }

    /// <summary>Lazy-fetch the per-tab data the first time the tab is opened.
    /// Tabs that just read from the pre-loaded <c>_config</c> dict don't need
    /// extra work — those are no-ops here.</summary>
    private async Task SwitchTabAsync(string key)
    {
        _activeTab = key;
        await EnsureTabDataAsync(key);
        StateHasChanged();
    }

    private async Task EnsureTabDataAsync(string key) => await (key switch
    {
        "hardware" when _hw is null         => LoadHardwareAsync(),
        "patterns" when _patterns is null   => LoadPatternsAsync(),
        "torrent"  when _torrentCfg is null => LoadTorrentAsync(),
        "ai"       when _catalog is null    => LoadEmbeddedAsync(),
        "metadata"                          => LoadMetadataAuxAsync(),
        _ => Task.CompletedTask,
    });

    private async Task SetConfigAsync(string key, string? value)
    {
        try
        {
            await Api.SetAppConfigValueAsync(key, value);
            _config[key] = value;
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private async Task LoadSegStatusAsync()
    {
        try { _segStatus = await Api.GetSegmentScanStatusAsync(); }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task RescanSegmentsAsync()
    {
        try
        {
            await Api.RescanSegmentsAsync();
            _segStatus = await Api.GetSegmentScanStatusAsync();
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private async Task LoadMetadataAuxAsync()
    {
        if (_segStatus is null) await LoadSegStatusAsync();
        await LoadLangStatusAsync();
    }

    private async Task LoadLangStatusAsync()
    {
        try
        {
            _langStatus = await Api.GetMetadataLanguageStatusAsync();
            // Resume the progress poll if a pass is still running (e.g. tab re-opened mid-run).
            if (_langStatus is { Phase: "running" }) _ = PollLangAsync();
        }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task SetMetadataLanguageAsync(string code)
    {
        try
        {
            await Api.SetMetadataLanguageAsync(code);
            _config[AppConfigKeys.MetadataLanguage] = code;
            _langStatus = await Api.GetMetadataLanguageStatusAsync();
            _ = PollLangAsync();
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private async Task PollLangAsync()
    {
        _langPollCts?.Cancel();
        _langPollCts = new CancellationTokenSource();
        var ct = _langPollCts.Token;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(750, ct);
                _langStatus = await Api.GetMetadataLanguageStatusAsync();
                await InvokeAsync(StateHasChanged);
                if (_langStatus is null || _langStatus.Phase != "running")
                    break;
            }
        }
        catch (OperationCanceledException) { /* navigated away / superseded */ }
        catch { /* swallow */ }
    }

    // ── General tab ──
    private RenderFragment GeneralTab() => @<section class="settings-section">
        <h2>@L["settings.tab_general"]</h2>
        <label class="settings-field">
            <span class="settings-field__label">@L["settings.section_language"]</span>
            <select class="settings-field__select"
                    value="@(_config.GetValueOrDefault(AppConfigKeys.Language) ?? "en")"
                    @onchange="@(e => SetConfigAsync(AppConfigKeys.Language, e.Value?.ToString()))">
                <option value="en">English</option>
                <option value="ru">Русский</option>
                <option value="uk">Українська</option>
                <option value="de">Deutsch</option>
                <option value="es">Español</option>
            </select>
        </label>
        <p class="settings-hint">@L["settings.general_language_hint"]</p>
    </section>;

    // ── Root folders tab ──
    private RenderFragment RootFoldersTab() => @<section class="settings-section">
        <div class="settings-section-head">
            <h2>@L["settings.tab_root_folders"]</h2>
            @* Use the same compact accent CTA the v5 panels use elsewhere
               (Users/Roles, Categories). The old Btn Size="sm" was visually
               undersized next to the heading and looked cramped on wide
               viewports. *@
            <button type="button" class="settings-section-head__new tv-focus"
                    @onclick="@(() => { _folderDialogTarget = null; _folderDialogOpen = true; })">
                <DIcon Name="plus" Size="13" /> @L["settings.btn_add_section"]
            </button>
        </div>
        <RootFoldersList ReloadToken="_foldersReloadToken"
                         OnEdit="OnFolderEdit"
                         OnDelete="OnFolderDelete" />
    </section>;

    private void OnFolderEdit(FolderWatcherDto f)   { _folderDialogTarget = f; _folderDialogOpen = true; }
    private void OnFolderDelete(FolderWatcherDto f) { _folderDeleteTarget = f; _folderDeleteOpen = true; }

    private void OnFolderSaved()
    {
        _folderDialogOpen = false;
        _foldersReloadToken++;
        StateHasChanged();
    }
    private void OnFolderDeleted()
    {
        _folderDeleteOpen = false;
        _foldersReloadToken++;
        StateHasChanged();
    }

    // ── Appearance tab ──
    private RenderFragment AppearanceTab()
    {
        var hueStr   = _config.GetValueOrDefault(AppConfigKeys.AccentColor) ?? "25";
        var enabled  = (_config.GetValueOrDefault(AppConfigKeys.BackdropEnabled) ?? "true") != "false";
        var blurStr  = _config.GetValueOrDefault(AppConfigKeys.BackdropBlurPx) ?? "30";
        return @<section class="settings-section">
            <h2>@L["settings.tab_appearance"]</h2>
            <div class="settings-field">
                <span class="settings-field__label">@L["settings.accent_hue_label"]</span>
                <div class="accent-swatches">
                    @foreach (var preset in new[] { ("settings.accent_crimson", 25), ("settings.accent_amber", 75), ("settings.accent_green", 150), ("settings.accent_blue", 240), ("settings.accent_violet", 300) })
                    {
                        var hue = preset.Item2;
                        var name = L[preset.Item1];
                        var isActive = int.TryParse(hueStr, out var current) && current == hue;
                        <button type="button"
                                class="@($"accent-swatch {(isActive ? "accent-swatch--active" : "")}")"
                                style="--accent-hue:@hue"
                                title="@name"
                                aria-label="@name"
                                @onclick="@(() => SetConfigAsync(AppConfigKeys.AccentColor, hue.ToString()))">
                            @if (isActive)
                            {
                                <DIcon Name="check" Size="14" />
                            }
                        </button>
                    }
                </div>
                <span class="settings-hint">@L.Get("settings.accent_current_fmt", hueStr)</span>
            </div>

            <label class="settings-field settings-field--inline">
                <Toggle Checked="@enabled"
                        CheckedChanged="@((bool v) => SetConfigAsync(AppConfigKeys.BackdropEnabled, v ? "true" : "false"))" />
                <span class="settings-field__label">@L["settings.backdrop_on_catalog_label"]</span>
            </label>

            <label class="settings-field">
                <span class="settings-field__label">@L["settings.backdrop_blur_px_label"]</span>
                <input class="settings-field__input" type="number" min="0" max="80"
                       value="@blurStr"
                       @onchange="@(e => SetConfigAsync(AppConfigKeys.BackdropBlurPx, e.Value?.ToString()))" />
            </label>
        </section>;
    }

    // ── Audio tab ──
    // The audio-offset values are localStorage-backed (per-browser) and the
    // canonical store is window.animarrCalibrate, defined in
    // animarr-calibrate.js. Sliders read the cached value on init via
    // getCached() and write back through setManual().
    private RenderFragment AudioTab() => @<section class="settings-section settings-audio">
        <h2>@L["settings.audio_sync_title"]</h2>
        <p class="settings-hint">
            @((MarkupString)L["settings.audio_sync_hint_html"])
        </p>

        <div class="audio-sync-slider">
            <label class="settings-field">
                <span class="settings-field__label">
                    @L["settings.audio_hw_label"] ·
                    <strong id="animarr-sync-hw-value">70</strong> ms
                </span>
                <input type="range" min="-200" max="300" step="5"
                       id="animarr-sync-hw-range" class="settings-range" value="70"
                       oninput="(function(el){var v=parseInt(el.value,10);document.getElementById('animarr-sync-hw-value').innerText=v;window.animarrCalibrate&&window.animarrCalibrate.setManual('hw',v);})(this)" />
            </label>
        </div>

        <div class="audio-sync-slider">
            <label class="settings-field">
                <span class="settings-field__label">
                    @L["settings.audio_sw_label"] ·
                    <strong id="animarr-sync-sw-value">0</strong> ms
                </span>
                <input type="range" min="-200" max="700" step="5"
                       id="animarr-sync-sw-range" class="settings-range" value="0"
                       oninput="(function(el){var v=parseInt(el.value,10);document.getElementById('animarr-sync-sw-value').innerText=v;window.animarrCalibrate&&window.animarrCalibrate.setManual('sw',v);})(this)" />
            </label>
        </div>

        <script suppress-error="BL9992">
            // Pull current values out of localStorage so the sliders show the
            // actual stored offsets when the tab opens.
            (function syncSlidersInitial() {
                if (!window.animarrCalibrate) return;
                var init = function (rangeId, labelId, channel, dflt) {
                    var range = document.getElementById(rangeId);
                    var label = document.getElementById(labelId);
                    if (!range || !label) return;
                    var stored = window.animarrCalibrate.getCached(channel);
                    var v = (stored === null || stored === undefined) ? dflt : stored;
                    range.value = v;
                    label.innerText = v;
                };
                init('animarr-sync-hw-range', 'animarr-sync-hw-value', 'hw', 70);
                init('animarr-sync-sw-range', 'animarr-sync-sw-value', 'sw', 0);
            })();
        </script>
    </section>;

    // ── Hardware tab ──
    private RenderFragment HardwareTab() => @<section class="settings-section">
        <h2>@L["settings.hw_title"]</h2>
        @if (_hw is null)
        {
            <p>@L["settings.hw_probing"] <Btn Variant="ghost" Size="sm" OnClick="@(() => LoadHardwareAsync())">@L["settings.hw_probe_now"]</Btn></p>
        }
        else
        {
            <ul class="hw-list">
                <li><strong>VAAPI:</strong> @StatusLine(_hw.Vaapi)</li>
                <li><strong>NVENC:</strong> @StatusLine(_hw.Nvenc)</li>
                <li><strong>QSV:</strong> @StatusLine(_hw.Qsv)</li>
            </ul>
            <Btn Variant="primary" Size="sm" OnClick="@(() => LoadHardwareAsync(rescan: true))">@L["settings.hw_btn_rescan"]</Btn>
        }
    </section>;

    private async Task LoadHardwareAsync(bool rescan = false)
    {
        try { _hw = await Api.GetHardwareReportAsync(rescan); }
        catch { /* offline */ }
        StateHasChanged();
    }

    // ── AI tab ──
    private RenderFragment AiTab()
    {
        var enabled  = (_config.GetValueOrDefault(AppConfigKeys.LlmEnabled) ?? "false") == "true";
        var provider = _config.GetValueOrDefault(AppConfigKeys.LlmProvider) ?? "openai";
        var baseUrl  = _config.GetValueOrDefault(AppConfigKeys.LlmBaseUrl) ?? "";
        var apiKey   = _config.GetValueOrDefault(AppConfigKeys.LlmApiKey) ?? "";
        var model    = _config.GetValueOrDefault(AppConfigKeys.LlmModel) ?? "";
        var epMap    = (_config.GetValueOrDefault(AppConfigKeys.LlmEpisodeMapping) ?? "false") == "true";
        return @<section class="settings-section">
            <h2>@L["settings.tab_ai"]</h2>
            <label class="settings-field settings-field--inline">
                <Toggle Checked="@enabled"
                        CheckedChanged="@((bool v) => SetConfigAsync(AppConfigKeys.LlmEnabled, v ? "true" : "false"))" />
                <span class="settings-field__label">@L["settings.llm_use_during_id"]</span>
            </label>
            <label class="settings-field">
                <span class="settings-field__label">@L["settings.llm_provider_label"]</span>
                <select class="settings-field__select" value="@provider"
                        @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmProvider, e.Value?.ToString()))">
                    <option value="openai">@L["settings.llm_provider_opt_openai"]</option>
                    <option value="compatible">@L["settings.llm_provider_opt_compatible"]</option>
                    <option value="embedded">@L["settings.llm_provider_opt_embedded"]</option>
                </select>
            </label>
            @if (provider != "embedded")
            {
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.llm_base_url_label"]</span>
                    <input class="settings-field__input" placeholder="http://ollama:11434/v1"
                           value="@baseUrl"
                           @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmBaseUrl, e.Value?.ToString()))" />
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.llm_api_key_label"]</span>
                    <input class="settings-field__input" type="password" placeholder="sk-…"
                           value="@apiKey"
                           @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmApiKey, e.Value?.ToString()))" />
                </label>
                <label class="settings-field">
                    <span class="settings-field__label">@L["settings.llm_model_label"]</span>
                    <input class="settings-field__input" placeholder="qwen2.5:1.5b"
                           value="@model"
                           @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmModel, e.Value?.ToString()))" />
                </label>
            }
            else
            {
                @EmbeddedBlock()
            }
            <label class="settings-field settings-field--inline">
                <Toggle Checked="@epMap"
                        CheckedChanged="@((bool v) => SetConfigAsync(AppConfigKeys.LlmEpisodeMapping, v ? "true" : "false"))" />
                <span class="settings-field__label">@L["settings.llm_episode_mapping_switch"]</span>
            </label>

            @* ── Test connection card ──────────────────────────────────
               Runs a single small ping against the configured LLM and
               surfaces { latency, sample, error } so the admin can
               confirm the provider works without queuing a real
               identification job. Uses saved AppConfig — admin must
               Save changes (input @onchange already does that
               per-field) before hitting Test. *@
            <div class="settings-llm-test">
                <button type="button" class="settings-section-head__new tv-focus"
                        @onclick="TestLlmAsync"
                        disabled="@_llmTesting">
                    <DIcon Name="@(_llmTesting ? "refresh" : "magic")" Size="13" />
                    @(_llmTesting ? L["settings.llm_hero_btn_testing"] : L["settings.llm_hero_btn_test"])
                </button>
                @if (_llmTestResult is { } r)
                {
                    <div class="@($"settings-llm-test__result {(r.Ok ? "is-ok" : "is-err")}")">
                        @if (r.Ok)
                        {
                            <div class="settings-llm-test__line">
                                <strong>@L["settings.llm_test_connected"]</strong> @L.Get("settings.llm_test_latency_fmt", r.LatencyMs)
                            </div>
                            @if (!string.IsNullOrEmpty(r.Sample))
                            {
                                <div class="settings-llm-test__sample">
                                    @L["settings.llm_test_sample_label"] <code>@r.Sample</code>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="settings-llm-test__line">
                                <strong>@L["settings.llm_test_failed"]</strong> @L.Get("settings.llm_test_after_fmt", r.LatencyMs)
                            </div>
                            @if (!string.IsNullOrEmpty(r.Error))
                            {
                                <div class="settings-llm-test__sample">@r.Error</div>
                            }
                        }
                    </div>
                }
            </div>

            @LlmDocs()
        </section>;
    }

    private bool _llmTesting;
    private LlmTestResponse? _llmTestResult;

    // ── Embedded llama.cpp (provider = "embedded") ──────────────────────────
    private LlamaCatalogResponse? _catalog;
    private EmbeddedStatusDto?    _embeddedStatus;
    private DownloadProgressDto?  _download;
    private string _customRepo = "";
    private string _customFile = "";
    private bool   _embeddedBusy;
    private CancellationTokenSource? _pollCts;
    private CancellationTokenSource? _langPollCts;

    private async Task LoadEmbeddedAsync()
    {
        try
        {
            _catalog        = await Api.GetLlamaCatalogAsync();
            _embeddedStatus = await Api.GetEmbeddedStatusAsync();
            _download       = await Api.GetLlamaDownloadStatusAsync();
            if (_download is { Phase: "downloading" }) _ = PollDownloadAsync();
        }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task StartDownloadAsync()
    {
        if (_embeddedBusy) return;
        var id = _config.GetValueOrDefault(AppConfigKeys.LlmEmbeddedModelId) ?? "";
        if (string.IsNullOrEmpty(id)) return;
        _embeddedBusy = true; StateHasChanged();
        try
        {
            await Api.StartLlamaDownloadAsync(new StartDownloadRequest(id, _customRepo, _customFile));
            _ = PollDownloadAsync();
        }
        catch (Exception ex)
        {
            _download = new DownloadProgressDto(id, null, 0, null, 0, "error", ex.Message);
        }
        finally { _embeddedBusy = false; StateHasChanged(); }
    }

    private async Task PollDownloadAsync()
    {
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        var ct = _pollCts.Token;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(750, ct);
                _download = await Api.GetLlamaDownloadStatusAsync();
                await InvokeAsync(StateHasChanged);
                if (_download is null || _download.Phase != "downloading")
                {
                    _catalog        = await Api.GetLlamaCatalogAsync();
                    _embeddedStatus = await Api.GetEmbeddedStatusAsync();
                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }
        }
        catch (OperationCanceledException) { /* navigated away / superseded */ }
        catch { /* swallow */ }
    }

    private async Task CancelDownloadAsync()
    {
        try { await Api.CancelLlamaDownloadAsync(); } catch { /* swallow */ }
    }

    private async Task DeleteModelAsync(string file)
    {
        try
        {
            await Api.DeleteLlamaModelAsync(file);
            _catalog = await Api.GetLlamaCatalogAsync();
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private async Task RestartEmbeddedAsync()
    {
        if (_embeddedBusy) return;
        _embeddedBusy = true; StateHasChanged();
        try { _embeddedStatus = await Api.RestartEmbeddedAsync(); }
        catch { /* swallow */ }
        finally { _embeddedBusy = false; StateHasChanged(); }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "—";
        double mb = bytes / 1024d / 1024d;
        return mb >= 1024 ? $"{mb / 1024:F1} GB" : $"{mb:F0} MB";
    }

    public void Dispose()
    {
        try { _pollCts?.Cancel(); _pollCts?.Dispose(); } catch { /* ignore */ }
        try { _langPollCts?.Cancel(); _langPollCts?.Dispose(); } catch { /* ignore */ }
    }

    // The embedded-provider panel: runtime status, model picker (curated +
    // custom HF), download progress, and installed-model management.
    private RenderFragment EmbeddedBlock() => @<div class="settings-llm-embedded">
        @{
            var selId       = _config.GetValueOrDefault(AppConfigKeys.LlmEmbeddedModelId) ?? "";
            var selCurated  = _catalog?.Curated.FirstOrDefault(c => c.Id == selId);
            var dl          = _download;
            var downloading = dl is { Phase: "downloading" };
        }

        @if (_embeddedStatus is { } st)
        {
            <div class="settings-llm-gpu">
                <span class="settings-llm-gpu__badge">@st.State</span>
                @if (!string.IsNullOrEmpty(st.ModelFile)) { <span class="settings-llm-gpu__meta">@st.ModelFile</span> }
                <span class="settings-llm-gpu__meta">@(st.GpuActive ? $"GPU · {st.GpuMode}" : "CPU")</span>
                <button type="button" class="settings-llm-gpu__restart tv-focus"
                        @onclick="RestartEmbeddedAsync" disabled="@_embeddedBusy">
                    <DIcon Name="refresh" Size="12" /> @L["settings.embedded_btn_restart"]
                </button>
                @if (!string.IsNullOrEmpty(st.Error))
                {
                    <div class="settings-llm-gpu__err">@st.Error</div>
                }
            </div>
        }

        <label class="settings-field">
            <span class="settings-field__label">@L["settings.llm_model_label"]</span>
            <select class="settings-field__select" value="@selId"
                    @onchange="@(e => SetConfigAsync(AppConfigKeys.LlmEmbeddedModelId, e.Value?.ToString()))">
                <option value="">@L["settings.embedded_select_model"]</option>
                @if (_catalog is { } cat)
                {
                    @foreach (var m in cat.Curated)
                    {
                        <option value="@m.Id">@m.DisplayName · @FormatBytes(m.ApproxBytes) @(m.GpuRecommended ? "· GPU" : "· CPU")@(m.Installed ? " ✓" : "")</option>
                    }
                }
                <option value="custom">@L["settings.embedded_custom_hf"]</option>
            </select>
        </label>

        @if (selId == "custom")
        {
            <label class="settings-field">
                <span class="settings-field__label">@L["settings.embedded_hf_repo_label"]</span>
                <input class="settings-field__input" placeholder="Qwen/Qwen2.5-1.5B-Instruct-GGUF"
                       value="@_customRepo" @oninput="@(e => _customRepo = e.Value?.ToString() ?? "")" />
            </label>
            <label class="settings-field">
                <span class="settings-field__label">@L["settings.embedded_gguf_file_label"]</span>
                <input class="settings-field__input" placeholder="qwen2.5-1.5b-instruct-q4_k_m.gguf"
                       value="@_customFile" @oninput="@(e => _customFile = e.Value?.ToString() ?? "")" />
            </label>
            <p class="settings-hint">@((MarkupString)L["settings.embedded_custom_hint_html"])</p>
        }
        else if (selCurated is { } sc)
        {
            <p class="settings-hint">@sc.Notes @L.Get("settings.embedded_ram_fmt", sc.RecommendedRamMb)</p>
        }

        <div class="settings-llm-test">
            <button type="button" class="settings-section-head__new tv-focus"
                    @onclick="StartDownloadAsync"
                    disabled="@(_embeddedBusy || string.IsNullOrEmpty(selId) || downloading)">
                <DIcon Name="download" Size="13" />
                @(downloading ? L["settings.embedded_downloading"] : L["settings.embedded_download_model"])
            </button>

            @if (dl is { } d && d.Phase != "idle")
            {
                <div class="settings-llm-progress">
                    <div class="settings-llm-progress__bar">
                        <div class="settings-llm-progress__fill" style="width:@((int)d.Percent)%"></div>
                    </div>
                    <div class="settings-llm-progress__text">
                        @if (d.Phase == "downloading")
                        {
                            <span>@FormatBytes(d.BytesReceived) / @(d.TotalBytes is { } t ? FormatBytes(t) : "?") (@((int)d.Percent)%)</span>
                            <button type="button" class="settings-llm-progress__cancel tv-focus" @onclick="CancelDownloadAsync">@L["common.btn_cancel"]</button>
                        }
                        else if (d.Phase == "done")      { <span class="is-ok">@L["settings.embedded_done"]</span> }
                        else if (d.Phase == "cancelled") { <span class="is-warn">@L["settings.embedded_cancelled"]</span> }
                        else if (d.Phase == "error")     { <span class="is-err">@L.Get("folder_files.toast_error", d.Error)</span> }
                    </div>
                </div>
            }
        </div>

        @if (_catalog is { Installed.Length: > 0 } c2)
        {
            <div class="settings-llm-models">
                <div class="settings-llm-models__label">@L["settings.embedded_installed_label"]</div>
                @foreach (var m in c2.Installed)
                {
                    <div class="settings-llm-models__row">
                        <span class="settings-llm-models__name">@m.FileName @(m.IsActive ? L["settings.embedded_active_suffix"] : "")</span>
                        <span class="settings-llm-models__size">@FormatBytes(m.Bytes)</span>
                        <button type="button" class="settings-llm-models__del tv-focus"
                                disabled="@m.IsActive" @onclick="@(() => DeleteModelAsync(m.FileName))"
                                title="@(m.IsActive ? L["settings.embedded_active_tooltip"] : L["settings.btn_delete_tooltip"])">
                            <DIcon Name="trash" Size="12" />
                        </button>
                    </div>
                }
            </div>
        }
    </div>;

