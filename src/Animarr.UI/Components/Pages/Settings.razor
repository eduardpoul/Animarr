        else if (_patterns.Length == 0)
        {
            <p>@L["settings.patterns_empty"]</p>
        }
        else
        {
            <table class="d-table">
                <thead><tr><th>@L["settings.patterns_th_name"]</th><th>@L["settings.patterns_th_pattern"]</th><th>@L["settings.patterns_th_scope"]</th><th>@L["settings.patterns_th_priority"]</th><th>@L["settings.patterns_th_builtin"]</th></tr></thead>
                <tbody>
                    @foreach (var p in _patterns.OrderBy(p => p.Priority))
                    {
