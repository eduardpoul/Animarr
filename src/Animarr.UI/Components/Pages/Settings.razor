    private RenderFragment LangProgress(MetadataLanguageStatusDto ls) => __builder =>
    {
        var pct = ls.Total > 0 ? ls.Done * 100 / ls.Total : (ls.Phase == "done" ? 100 : 0);
        <div class="set-progress">
            <div class="set-progress__bar"><div class="set-progress__fill" style="width:@(pct)%"></div></div>
            <div class="set-progress__text">
                @if (ls.Phase == "running")   { <span>@L.Get("settings.meta_lang_progress_fmt", ls.Done, ls.Total, pct)</span> }
                else if (ls.Phase == "done")  { <span class="is-ok">@L.Get("settings.meta_lang_done_fmt", ls.Done, ls.Total)</span> }
                else if (ls.Phase == "error") { <span class="is-err">@L.Get("folder_files.toast_error", ls.Error ?? "")</span> }
            </div>
        </div>
    };

    private async Task LoadLangStatusAsync()
    {
        try
        {
            _langStatus = await Api.GetMetadataLanguageStatusAsync();
            // Resume the progress poll if a pass is still running.
            if (_langStatus is { Phase: "running" }) _ = PollLangAsync();
        }
        catch { /* offline */ }
        StateHasChanged();
    }

    private async Task SetMetadataLanguageAsync(string code)
    {
        try
        {
            await Api.SetMetadataLanguageAsync(code);
            _config[AppConfigKeys.MetadataLanguage] = code;
            _langStatus = await Api.GetMetadataLanguageStatusAsync();
            _ = PollLangAsync();
        }
        catch { /* swallow */ }
        StateHasChanged();
    }

    private async Task PollLangAsync()
    {
        _langPollCts?.Cancel();
        _langPollCts = new CancellationTokenSource();
        var ct = _langPollCts.Token;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(750, ct);
                _langStatus = await Api.GetMetadataLanguageStatusAsync();
                await InvokeAsync(StateHasChanged);
                if (_langStatus is null || _langStatus.Phase != "running")
                    break;
            }
        }
        catch (OperationCanceledException) { /* navigated away / superseded */ }
        catch { /* swallow */ }
    }

