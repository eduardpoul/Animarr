        var segChapters   = (_config.GetValueOrDefault(AppConfigKeys.SegmentsChaptersEnabled)    ?? "true")  != "false";
        var segChroma     = (_config.GetValueOrDefault(AppConfigKeys.SegmentsChromaprintEnabled) ?? "true")  != "false";
        var segBlackFrame = (_config.GetValueOrDefault(AppConfigKeys.SegmentsBlackFrameEnabled)  ?? "false") == "true";
        // Source enable flags live in metadata.search_source_order as a JSON
        // array — MetadataService.GatherCandidatesAsync already reads that
        // format. _sourceEnabled parses it once per render; SetSourceEnabledAsync
        // mutates one flag and re-serialises.
        var tmdbOn = _sourceEnabled("tmdb_tv") || _sourceEnabled("tmdb_movie");
        var malOn  = _sourceEnabled("mal");
        var imdbOn = _sourceEnabled("imdb_search");
        var tmdbKey = _config.GetValueOrDefault(AppConfigKeys.TmdbApiKey) ?? "";
        var malKey  = _config.GetValueOrDefault(AppConfigKeys.MalClientId) ?? "";
        var metaLang = _config.GetValueOrDefault(AppConfigKeys.MetadataLanguage) ?? "en";
        return @<section class="settings-section">
            <h2>@L["settings.meta_sources_title"]</h2>
            <p class="settings-hint">
                @L["settings.meta_sources_intro"]
            </p>
            <div class="settings-providers">

                <div class="settings-provider">
                    <div class="settings-provider__head">
                        <Toggle Checked="@tmdbOn"
                                CheckedChanged="@((bool v) => ToggleTmdbAsync(v))" />
                        <div class="settings-provider__name">
                            TMDb
                            <span class="settings-provider__hint">@L["settings.meta_tmdb_hint"]</span>
                        </div>
                    </div>
                    <input class="settings-field__input" type="password"
                           placeholder="@L["settings.meta_tmdb_key_placeholder"]"
                           value="@tmdbKey"
                           @onchange="@(e => SetConfigAsync(AppConfigKeys.TmdbApiKey, e.Value?.ToString()))" />
                </div>

                <div class="settings-provider">
                    <div class="settings-provider__head">
                        <Toggle Checked="@malOn"
                                CheckedChanged="@((bool v) => ToggleMalAsync(v))" />
                        <div class="settings-provider__name">
                            MAL
                            <span class="settings-provider__hint">@L["settings.meta_mal_hint"]</span>
                        </div>
                    </div>
                    <input class="settings-field__input" type="password"
                           placeholder="@L["settings.meta_mal_key_placeholder"]"
                           value="@malKey"
                           @onchange="@(e => SetConfigAsync(AppConfigKeys.MalClientId, e.Value?.ToString()))" />
                </div>

                <div class="settings-provider">
                    <div class="settings-provider__head">
                        <Toggle Checked="@imdbOn"
                                CheckedChanged="@((bool v) => ToggleImdbAsync(v))" />
                        <div class="settings-provider__name">
                            IMDb
                            <span class="settings-provider__hint">@L["settings.meta_imdb_hint"]</span>
                        </div>
                    </div>
                </div>

            </div>

            <h3>@L["settings.meta_language_title"]</h3>
            <p class="settings-hint">
                @L["settings.meta_language_intro"]
            </p>
            <label class="settings-field">
                <span class="settings-field__label">@L["settings.meta_language_label"]</span>
                <select class="settings-field__select" value="@metaLang"
                        @onchange="@(e => SetMetadataLanguageAsync(e.Value?.ToString() ?? "en"))">
                    <option value="en">English</option>
                    <option value="ru">Русский</option>
                    <option value="uk">Українська</option>
                    <option value="de">Deutsch</option>
                    <option value="es">Español</option>
                </select>
            </label>
            @if (_langStatus is { } ls && ls.Phase != "idle")
            {
                var pct = ls.Total > 0 ? ls.Done * 100 / ls.Total : (ls.Phase == "done" ? 100 : 0);
                <div class="settings-llm-progress">
                    <div class="settings-llm-progress__bar">
                        <div class="settings-llm-progress__fill" style="width:@(pct)%"></div>
                    </div>
                    <div class="settings-llm-progress__text">
                        @if (ls.Phase == "running")   { <span>@L.Get("settings.meta_lang_progress_fmt", ls.Done, ls.Total, pct)</span> }
                        else if (ls.Phase == "done")  { <span class="is-ok">@L.Get("settings.meta_lang_done_fmt", ls.Done, ls.Total)</span> }
                        else if (ls.Phase == "error") { <span class="is-err">@L.Get("folder_files.toast_error", ls.Error)</span> }
                    </div>
                </div>
