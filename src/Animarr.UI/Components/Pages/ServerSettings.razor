@*
    ServerSettingsScreen — admin-only /server route.

    Phase A stub: shell + 240px vertical tab rail + content card. The tab
    bodies (Users & Roles, Folders, LLM, Parsing, Downloads-config,
    Metadata, About) get filled in over the next iterations. Tab buttons
    switch the active tab in local state — no persistence, no real data yet.

    Spec: screens-v4.jsx → ServerSettingsScreen lines 651-704.
*@

@page "/server"
@inject NavigationManager Nav

<PageTitle>Animarr</PageTitle>

<div class="d-server" data-mobile-detail="@(_mobileShowingDetail ? "true" : "false")">
    <header class="d-page-header">
        @if (_mobileShowingDetail)
        {
            <button type="button" class="d-server__mback tv-focus"
                    @onclick="@(() => _mobileShowingDetail = false)"
                    aria-label="@L["server_settings.aria_back_list"]">
                <DIcon Name="chev-l" Size="18" />
            </button>
        }
        @* Desktop/web back-arrow (hidden <960px, where the mobile drilldown
           mback above + the mobile nav handle navigation). *@
        <PageBack />
        <div class="d-page-header__main">
            <div class="d-page-header__overline">@L["server_settings.overline"]</div>
            <h1 class="d-page-header__title">@(_mobileShowingDetail ? L[CurrentTab.LabelKey] : L["server_settings.title"])</h1>
            @if (!_mobileShowingDetail)
            {
                <div class="d-page-header__sub">
                    @L["server_settings.sub"]
                </div>
            }
        </div>
    </header>

    <div class="d-server__body">
        @* Desktop rail — vertical list pinned next to the content. Hidden
           on phone in favour of the drilldown list below. *@
        <nav class="d-server__rail" aria-label="@L["server_settings.aria_sections"]">
            @foreach (var t in Tabs)
            {
                var key = t.Key;
                var active = _active == key;
                <button type="button"
                        class="@($"d-server__rail-item tv-focus {(active ? "is-active" : "")}")"
                        @onclick="@(() => _active = key)">
                    <span class="d-server__rail-icon"><DIcon Name="@t.Icon" Size="16" /></span>
                    <span class="d-server__rail-label">@L[t.LabelKey]</span>
                    @if (t.New)
                    {
                        <span class="d-server__rail-new">@L["server_settings.badge_new"]</span>
                    }
                </button>
            }
        </nav>

        @* Mobile drilldown list — full-width vertical cards. Click → set
           the active tab + flip to detail mode. CSS toggles list ⇄ body
           via the parent's data-mobile-detail attribute. *@
        <nav class="d-server__mlist" aria-label="@L["server_settings.aria_categories"]">
            @foreach (var t in Tabs)
            {
                var key = t.Key;
                <button type="button" class="d-server__mlist-row tv-focus"
                        @onclick="@(() => { _active = key; _mobileShowingDetail = true; })">
                    <span class="d-server__mlist-ic">
                        <DIcon Name="@t.Icon" Size="14" />
                    </span>
                    <span class="d-server__mlist-body">
                        <span class="d-server__mlist-label">@L[t.LabelKey]</span>
                        <span class="d-server__mlist-meta">@L[t.DescKey]</span>
                    </span>
                    @if (t.New)
                    {
                        <span class="d-server__mlist-new">@L["server_settings.badge_new"]</span>
                    }
                    <DIcon Name="chev-r" Size="13" />
                </button>
            }
        </nav>

        <section class="d-server__content">
            @* Embed the matching v3 Settings tab body when the admin tab maps
               to one. The legacy /settings page exposes each tab as a
               separate RenderFragment; Settings.razor now accepts an
               EmbeddedTab parameter so it renders that body without its
               own page header / tab bar. *@
            @switch (_active)
            {
                case "users":
                    @* v5 deep-link: ProfilePanel's "+ Add user" lands here with
                       ?openForm=user so the inline UserBuilder is open out of
                       the gate. _openCreateUserForm is consumed once and then
                       cleared by UsersRolesPanel via the OnFormOpened callback. *@
                    <UsersRolesPanel OpenCreateForm="@_openCreateUserForm" />
                    break;
                case "categories":
                    <CategoriesPanel />
                    break;
                case "about":
                    <AboutPanel />
                    break;
                case "folders":
                    <Settings EmbeddedTab="root_folders" />
                    break;
                case "llm":
                    <Settings EmbeddedTab="ai" />
                    break;
                case "patterns":
                    <Settings EmbeddedTab="patterns" />
                    break;
                case "downloads":
                    <Settings EmbeddedTab="torrent" />
                    break;
                case "meta":
                    <Settings EmbeddedTab="metadata" />
                    break;
                default:
                    <div class="d-server__placeholder">
                        <DIcon Name="@CurrentTab.Icon" Size="48" />
                        <h2 class="d-server__placeholder-title">@L[CurrentTab.LabelKey]</h2>
                        <p class="d-server__placeholder-body">@L[CurrentTab.DescKey]</p>
                    </div>
                    break;
            }
        </section>
    </div>
</div>

@code {
    private record TabDef(string Key, string LabelKey, string Icon, string DescKey, bool New = false);

    private static readonly TabDef[] Tabs =
    {
        new("users",      "server_settings.tab_users_label",      "users",    "server_settings.tab_users_desc"),
        new("categories", "server_settings.tab_categories_label", "sparkle",  "server_settings.tab_categories_desc"),
        new("folders",    "server_settings.tab_folders_label",    "folder",   "server_settings.tab_folders_desc"),
        new("llm",        "server_settings.tab_llm_label",        "magic",    "server_settings.tab_llm_desc"),
        new("patterns",   "server_settings.tab_patterns_label",   "pencil",   "server_settings.tab_patterns_desc"),
        new("downloads",  "server_settings.tab_downloads_label",  "download", "server_settings.tab_downloads_desc"),
        new("meta",       "server_settings.tab_meta_label",       "external", "server_settings.tab_meta_desc"),
        new("about",      "server_settings.tab_about_label",      "info",     "server_settings.tab_about_desc"),
    };

    private string _active = "users";

    /// <summary>Mobile drilldown state. False = show vertical list of
    /// categories (default for phones), true = show the selected panel
    /// with a back button. Desktop ignores this — the rail is always
    /// visible there.</summary>
    private bool _mobileShowingDetail;

    /// <summary>v5 deep-link: set true when the query string says
    /// ?openForm=user (ProfilePanel's "+ Add user" path). Forwarded into
    /// UsersRolesPanel once, then cleared. Default tab + form state stay
    /// untouched for users arriving via the regular Server Settings nav. *
    /// </summary>
    private bool _openCreateUserForm;

    private TabDef CurrentTab => Tabs.FirstOrDefault(t => t.Key == _active) ?? Tabs[0];

    protected override void OnInitialized()
    {
        // Parse ?panel=&openForm= once on page mount. Browsing between
        // tabs after mount uses local state (_active) — we don't keep
        // re-reading the query string. URL is left alone so the user can
        // back/forward without the deep-link re-firing.
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var panel = query["panel"];
        if (!string.IsNullOrEmpty(panel) && Tabs.Any(t => t.Key == panel))
            _active = panel;
        var openForm = query["openForm"];
        if (string.Equals(openForm, "user", StringComparison.OrdinalIgnoreCase))
            _openCreateUserForm = true;
    }
}
