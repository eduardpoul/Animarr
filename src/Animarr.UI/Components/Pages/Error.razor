@page "/error"
@using System.Diagnostics

@*
    Generic error fallback. The WASM/MAUI runtimes don't expose an
    HttpContext, so we drop the Request ID block from the server-side
    version and rely on Activity.Current for a correlation hint.
*@

<PageTitle>Animarr</PageTitle>

<div class="d-status-page">
    <div class="d-status-page__ic d-status-page__ic--danger" aria-hidden="true"><DIcon Name="warn" Size="24" /></div>
    <h1 class="d-status-page__title">@L["error.title"]</h1>
    <h2 class="d-status-page__subtitle">@L["error.subtitle"]</h2>

    @if (!string.IsNullOrEmpty(_activityId))
    {
        <p class="d-status-page__trace">
            <strong>@L["error.trace_id_label"]</strong> <code>@_activityId</code>
        </p>
    }

    <p class="d-status-page__body">
        @L["error.body"]
    </p>
</div>

@code {
    private string? _activityId;

    protected override void OnInitialized()
        => _activityId = Activity.Current?.Id;
}
