@*
    Welcome — public landing for anonymous users.

    Stripped-down v5: vertically + horizontally centered stack. Icon,
    name, one-line tagline, single "Get started" CTA. Feature cards and
    long lede paragraph were noise — the user only ever clicks the CTA
    from this screen, so anything else is decoration competing with it.
*@

@page "/welcome"
@layout AuthLayout
@inject NavigationManager Nav
@inject UserContextState UserCtx
@inject ServerRegistryState ServerReg
@inject IJSRuntime JS

<PageTitle>Animarr — Your library, understood.</PageTitle>

<div class="d-welcome">
    <div class="d-welcome__cjk" aria-hidden="true">动画</div>

    <div class="d-welcome__stack">
        <div class="d-welcome__mark">a</div>

        <h1 class="d-welcome__name">Animarr</h1>

        <p class="d-welcome__tagline">
            Self-hosted anime &amp; movie library, understood by an LLM.
        </p>

        <Btn Variant="primary" Size="lg" OnClick="StartFlow">
            Get started <DIcon Name="arrow-r" Size="13" />
        </Btn>
    </div>

    <a href="@GithubUrl" target="_blank" rel="noopener" class="d-welcome__gh tv-focus" aria-label="Animarr on GitHub">
        github
    </a>
</div>

@code {
    private const string GithubUrl = "https://github.com/eduardpoul/Animarr";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!UserCtx.Loaded) await UserCtx.LoadAsync();
        if (!ServerReg.Loaded) await ServerReg.LoadAsync();
        if (UserCtx.IsAuthenticated)
        {
            string? deepLinkId = null;
            try { deepLinkId = await JS.InvokeAsync<string?>("animarrConsumePendingDeepLink"); }
            catch { /* shim absent (browser WASM) — no deep link path */ }

            Nav.NavigateTo(
                !string.IsNullOrEmpty(deepLinkId) ? $"/media/{deepLinkId}" : "/",
                replace: true);
        }
    }

    private void StartFlow()
    {
        if (UserCtx.AuthStatus is { SetupRequired: true })
            Nav.NavigateTo("/setup");
        else
            Nav.NavigateTo("/discovery");
    }
}
