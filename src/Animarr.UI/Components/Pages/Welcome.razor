@*
    WelcomeScreen — public landing for anonymous users.
    Spec: screens-v4.jsx lines 7-124.
*@

@page "/welcome"
@layout AuthLayout
@inject NavigationManager Nav
@inject UserContextState UserCtx
@inject ServerRegistryState ServerReg

<PageTitle>Animarr — Your library, understood.</PageTitle>

<div class="d-welcome">
    <div class="d-welcome__cjk" aria-hidden="true">动画</div>

    <div class="d-welcome__content">
        <header class="d-welcome__brand">
            <span class="d-welcome__brand-mark">a</span>
            <div>
                <h2 class="d-welcome__brand-name">Animarr</h2>
                <div class="d-welcome__brand-sub">v5 · local · llm-driven</div>
            </div>
        </header>

        <h1 class="d-welcome__title">Your library, understood.</h1>

        <p class="d-welcome__lede">
            Self-hosted anime and movie organiser. LLM-driven identification,
            per-user watch state, and a built-in player that direct-plays your
            files when the browser can, falls back to on-the-fly remux when it can't.
        </p>

        <div class="d-welcome__cta">
            <Btn Variant="primary" Size="lg" OnClick="StartFlow">
                Get started <DIcon Name="arrow-r" Size="13" />
            </Btn>
        </div>

        <div class="d-welcome__features">
            <div class="d-welcome__feature">
                <div class="d-welcome__feature-overline">LLM-FIRST</div>
                <div class="d-welcome__feature-title">Identifies every title automatically</div>
                <p class="d-welcome__feature-body">
                    Files dropped into a watched folder are matched against TMDB,
                    MAL, IMDb and an on-host LLM that picks the best candidate
                    when the metadata sources disagree.
                </p>
            </div>
            <div class="d-welcome__feature">
                <div class="d-welcome__feature-overline">SAFE BY DEFAULT</div>
                <div class="d-welcome__feature-title">Your files stay where they are</div>
                <p class="d-welcome__feature-body">
                    Nothing is moved without your approval. Rename suggestions
                    are queued, previewable, and reversible. Originals never
                    leave your storage.
                </p>
            </div>
            <div class="d-welcome__feature">
                <div class="d-welcome__feature-overline">MULTI-USER</div>
                <div class="d-welcome__feature-title">One server, many viewers</div>
                <p class="d-welcome__feature-body">
                    Per-user watch state, favorites and preferences. Custom
                    roles can scope folder access — e.g. an Uploader role
                    limited to specific source folders.
                </p>
            </div>
        </div>

        <footer class="d-welcome__footer">
            <a href="@GithubUrl" target="_blank" rel="noopener" class="d-welcome__footer-link tv-focus">
                github.com / eduardpoul / animarr
            </a>
        </footer>
    </div>
</div>

@code {
    private const string GithubUrl = "https://github.com/eduardpoul/Animarr";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Probe auth state. If the user is already signed in, jump straight
        // to the catalog — there's no point staring at the marketing copy.
        // For anonymous + SetupRequired we stay here on purpose so the user
        // sees the brand, features and START button before being asked to
        // create the master account.
        if (!UserCtx.Loaded) await UserCtx.LoadAsync();
        // v5: hydrate the server registry so StartFlow can decide between
        // /discovery (first-run, no known servers) and /login (returning).
        if (!ServerReg.Loaded) await ServerReg.LoadAsync();
        if (UserCtx.IsAuthenticated)
            Nav.NavigateTo("/", replace: true);
    }

    private void StartFlow()
    {
        // v5 routing matrix:
        //   • Setup required on this server → /setup (first-run wizard;
        //     server-side state beats anything client-side).
        //   • Otherwise → /discovery. The discovery page itself handles both
        //     cases:
        //       — empty registry: shows the scan / manual-add UI
        //       — populated:      lists known servers with a "connect"
        //         button each so the user can pick one (or rescan).
        //     Routing straight to /login when the registry already has an
        //     entry used to feel "smart" but breaks the back-from-Discovery
        //     loop: the user clicks Back from /discovery (intending to
        //     reconsider), hits Get Started again, and we'd skip past the
        //     screen they just left. Letting Discovery be the single
        //     entrypoint keeps that interaction symmetric.
        if (UserCtx.AuthStatus is { SetupRequired: true })
            Nav.NavigateTo("/setup");
        else
            Nav.NavigateTo("/discovery");
    }
}
