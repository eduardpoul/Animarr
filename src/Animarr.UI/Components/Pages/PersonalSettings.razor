    // ─── Home sections editor (order + visibility) ─────────────────────
    // Works on the FULL HomeSections list (including keys the app hasn't
    // shipped yet) so a future section keeps its saved slot; the markup only
    // shows ImplementedKeys. Drag reorders live (dragover moves the row under
    // the cursor), dragend / arrows / toggles persist through PatchAsync —
    // which mirrors into UserCtx, so the Home page restacks behind the drawer
    // immediately.
    private List<HomeSections.Entry> _homeSections = HomeSections.Defaults();
    private string? _hsDragKey;

    private static string HsLabelKey(string key) => key switch
    {
        "continue" => "home.continue_watching",
        "nextup"   => "home.next_up",
        "thisweek" => "home.this_week",
        "foryou"   => "home.for_you",
        "library"  => "home.library_title",
        _          => $"home.section_{key}",
    };

    private void OnHsDragStart(string key) => _hsDragKey = key;

    private void OnHsDragOver(string overKey)
    {
        if (_hsDragKey is null || _hsDragKey == overKey) return;
        MoveHsEntry(_hsDragKey, overKey);
        StateHasChanged();
    }

    private async Task OnHsDragEnd()
    {
        if (_hsDragKey is null) return;
        _hsDragKey = null;
        await SaveHomeSectionsAsync();
    }

    private async Task OnHsMove(string key, int dir)
    {
        var visible = _homeSections.Where(e => HomeSections.ImplementedKeys.Contains(e.Key)).ToList();
        var i = visible.FindIndex(e => e.Key == key);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= visible.Count) return;
        MoveHsEntry(key, visible[j].Key);
        await SaveHomeSectionsAsync();
    }

    private void MoveHsEntry(string key, string targetKey)
    {
        var from = _homeSections.FindIndex(e => e.Key == key);
        var to   = _homeSections.FindIndex(e => e.Key == targetKey);
        if (from < 0 || to < 0 || from == to) return;
        var item = _homeSections[from];
        _homeSections.RemoveAt(from);
        _homeSections.Insert(to, item);
    }

    private async Task OnHsToggle(string key, bool on)
    {
        var i = _homeSections.FindIndex(e => e.Key == key);
        if (i < 0) return;
        _homeSections[i] = _homeSections[i] with { Enabled = on };
        await SaveHomeSectionsAsync();
    }

    private async Task SaveHomeSectionsAsync()
    {
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, null, null,
            HomeSectionsJson: HomeSections.Serialize(_homeSections)));
        StateHasChanged();
    }

    // ─── Recommendation scope (everywhere / library-only) ──────────────
    private string _recsScope = "everywhere";

    private async Task OnRecsScopeSelect(string key)
    {
        if (_recsScope == key) return;
        _recsScope = key;
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, null, null,
            RecsScope: key));
        StateHasChanged();
