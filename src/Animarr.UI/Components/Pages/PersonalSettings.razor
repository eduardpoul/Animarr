    // ─── v5 multi-server: switch / add server helpers ─────────────────

    private bool _addServerOpen;
    private string _addUrl = "";
    private string _addError = "";
    private bool _adding;

    /// <summary>Switch the active server. SetCurrentAsync already flipped the
    /// shared HttpClient's BaseAddress to the new origin, so subsequent calls
    /// resolve correctly. WASM still wants a hard navigate when origins differ
    /// (cookies + bundle origin are domain-scoped); MAUI keeps a soft nav
    /// because the WebView never reloads and forceLoad on an external host
    /// gets bounced to the system browser.</summary>
    private async Task OnSwitchServer(RegisteredServerDto target)
    {
        await ServerReg.SetCurrentAsync(target.ServerId);
        await Close();

        if (OperatingSystem.IsBrowser())
        {
            var sameOrigin = string.Equals(
                new Uri(target.BaseUrl).GetLeftPart(UriPartial.Authority),
                new Uri(Nav.Uri).GetLeftPart(UriPartial.Authority),
                StringComparison.OrdinalIgnoreCase);

            if (sameOrigin)
                Nav.NavigateTo("/login", replace: true);
            else
                Nav.NavigateTo(target.BaseUrl.TrimEnd('/') + "/login", forceLoad: true);
        }
        else
        {
            // MAUI / native shell — HttpClient is already pointed at the new
            // origin; stay inside the WebView and let /login mount fresh.
            Nav.NavigateTo("/login", replace: true);
        }
    }

    private async Task OnAddServer()
    {
        _addError = "";
        var url = _addUrl.Trim();
        if (string.IsNullOrEmpty(url)) { _addError = L["profile.err_enter_url"]; return; }
        if (!url.Contains("://", StringComparison.Ordinal)) url = "http://" + url;

        _adding = true;
        StateHasChanged();
        try
        {
            var entry = await ServerReg.AddServerAsync(url);
            if (entry is null)
            {
                _addError = L["profile.err_server_unreachable"];
                return;
            }
            _addUrl = "";
            _addServerOpen = false;
        }
        catch (Exception ex)
        {
            _addError = L.Get("profile.err_probe_failed", ex.Message);
        }
        finally
        {
            _adding = false;
            StateHasChanged();
        }
    }

    private async Task OnAddKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_adding) await OnAddServer();
    }

    // ─── v5 PIN per-user-per-device: switch-user helpers ──────────────
    //
    // Lifecycle:
    //   • drawer opens → OnAfterRender fetches /api/auth/roster (any user).
    //   • user taps card →
    //         current user → ignored (button is disabled but defence in depth)
    //         no PIN       → SwitchUserAsync(target, null) directly
    //         has PIN      → opens keypad dialog
    //   • keypad submits → SwitchUserAsync(target, pin); null result = wrong
    //                       PIN, set _keypadError and let the keypad shake.
    //   • success → UserCtx.RefreshMeAsync + close drawer + reload root.
    //
    // Device-local switch strip: the server roster intersected with the
    // profiles that have signed in on THIS device. Reloaded when the page
    // mounts. The PIN lives on the device (DeviceProfilesState), not the account.
    private sealed record Prof(RosterUserDto User, bool HasPin);
    private List<Prof> _profiles = new();
    private bool _switchBusy;

    private bool _keypadOpen;
    private RosterUserDto? _keypadTarget;
    private string? _keypadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Device-local player style (localStorage) + the switch-user strip.
        await LoadPlayerStyleAsync();
        await LoadProfilesAsync();
        StateHasChanged();
    }

    /// <summary>Build the strip = server roster ∩ this device's profiles, with
    /// the device-local PIN flag attached to each.</summary>
    private async Task LoadProfilesAsync()
    {
        try
        {
            if (UserCtx.Me is { } cur) await DeviceProfiles.EnsureAsync(cur.User.Id);
            var deviceIds = await DeviceProfiles.GetIdsAsync();
            var roster = await Api.GetRosterAsync();
            var list = new List<Prof>();
            foreach (var u in roster)
            {
                if (!deviceIds.Contains(u.Id)) continue;
                list.Add(new Prof(u, await DeviceProfiles.HasPinAsync(u.Id)));
            }
            _profiles = list;
            _myHasDevicePin = UserCtx.Me is { } m && await DeviceProfiles.HasPinAsync(m.User.Id);
        }
        catch
        {
            // Transport failure — leave whatever we had rather than blanking.
        }
    }

    private async Task OnUserCardClick(Prof prof)
    {
        if (UserCtx.Me is not { } me || prof.User.Id == me.User.Id) return;
        if (_switchBusy) return;

        if (prof.HasPin)
        {
            // Device-local PIN — prompt + verify on the CLIENT before switching.
            _keypadTarget = prof.User;
            _keypadError = null;
            _keypadOpen  = true;
            return;
        }
        await TrySwitchAsync(prof.User);
    }

    private async Task OnKeypadSubmit(string pin)
    {
        if (_keypadTarget is not { } t) return;
        if (!await DeviceProfiles.VerifyPinAsync(t.Id, pin))
        {
            // Wrong PIN — keypad shakes + clears via its OnParametersSet.
            _keypadError = L["pin.invalid"];
            StateHasChanged();
            return;
        }
        await TrySwitchAsync(t);
    }

    private void OnKeypadCancel()
    {
        _keypadOpen = false;
        _keypadTarget = null;
        _keypadError = null;
    }

    private async Task TrySwitchAsync(RosterUserDto target)
    {
        _switchBusy = true;
        StateHasChanged();
        try
        {
            // Server no longer gates by PIN — the device verified it above.
            var newMe = await Api.SwitchUserAsync(new SwitchUserRequest(target.Id, null));
            if (newMe is null)
            {
                _keypadError = L["profile.err_switch_failed"];
                _switchBusy = false;
                StateHasChanged();
                return;
            }

            // Success: refresh the global me cache so the topbar + sidebar
            // re-paint with the new identity; ensure the target is registered
            // on this device.
            await UserCtx.RefreshMeAsync();
            await DeviceProfiles.EnsureAsync(target.Id);
            UserCtx.SwitchGatePassed = true;
            _keypadOpen = false;
            _keypadTarget = null;
            _keypadError = null;
            _profiles = new();
            await Close();
            // Soft nav to / so page-scoped state re-resolves for the new user.
            Nav.NavigateTo("/", replace: true);
        }
        catch
        {
            _keypadError = L["profile.err_switch_failed"];
        }
        finally
        {
            _switchBusy = false;
            StateHasChanged();
        }
    }

    /// <summary>v5 fix: previously this just routed to /server which landed
    /// the admin on the Server Settings landing page (Users & Roles tab open
    /// but in "list" view). To actually CREATE a user they had to click
    /// "+ New user" again. The "+ Add user" affordance in the profile drawer
    /// implies "I want to add a user right now" — so we deep-link with
    /// ?panel=users&openForm=user and let ServerSettings + UsersRolesPanel
    /// jump straight to the inline builder form. ServerSettings reads the
    /// query string on first render to pick the active tab + forward
    /// OpenCreateForm=true into UsersRolesPanel.</summary>
    private async Task OnAddUserClick()
    {
        await Close();
        Nav.NavigateTo("/server?panel=users&openForm=user");
    }

    /// <summary>Add another EXISTING account to this device by signing in with
    /// its own credentials. Available to everyone (you prove the account's
    /// password). After login that account joins this device's profile strip,
    /// so you can fast-switch into it later (with its device-local PIN if set).
    /// This is distinct from <see cref="OnAddUserClick"/>, which is the admin
    /// "create a brand-new account" deep-link.</summary>
    private async Task OnAddAccountClick()
    {
