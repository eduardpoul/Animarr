    // Fluent 2: two themes. Name is a localization KEY; Preview* are the
    // literal page / accent / text colors drawn in the little "Aa" tile.
    private static readonly ThemeOption[] Themes = new[]
    {
        new ThemeOption("dark",  "profile.theme_dark",  "#202020", "oklch(0.75 0.14 var(--accent-hue))", "#ffffff"),
        new ThemeOption("light", "profile.theme_light", "#f3f3f3", "oklch(0.48 0.15 var(--accent-hue))", "#1f1f1f"),
    };

    private sealed record ThemeOption(
        string Slug, string Name,
        string PreviewBg, string PreviewAccent, string PreviewText);

    private async Task OnSelectTheme(string slug)
    {
        _theme = slug;
        // Live-apply via JS so the cascade swaps instantly — Razor doesn't
        // need to re-render before the user sees the result.
        try { await JS.InvokeVoidAsync("animarr_setTheme", slug); } catch { }
        await PatchAsync(new UpdatePreferencesRequest(
            null, null, null, null, null, null, null, null, null, null, null, null, null,
            Theme: slug));
    }

    private RenderFragment RenderAudio() => __builder =>
    {
        <SettingsGroup Title="@L["profile.group_language"]">
            @* Changing the interface language reloads the app so every screen
               re-renders in the new locale. *@
            <SettingsCard Icon="language" Title="@L["profile.language_title"]"
                          Description="@StripTags(L["profile.language_hint_html"])">
                <select class="fs-select" value="@_language" @onchange="OnLanguageChanged">
                    <option value="en">English</option>
                    <option value="ru">Русский</option>
                    <option value="uk">Українська</option>
                    <option value="de">Deutsch</option>
                    <option value="es">Español</option>
                </select>
            </SettingsCard>
        </SettingsGroup>

        <SettingsGroup Title="@L["profile.group_audio"]">
            <SettingsCard Icon="audio" Title="@L["profile.audio_preferred_label"]" Description="@L["profile.audio_preferred_desc"]">
                <select class="fs-select" value="@_audioPref" @onchange="OnAudioPrefChanged">
                    <option value="Japanese">@L["edit_metadata.basics_lang_japanese"]</option>
                    <option value="Mandarin">@L["edit_metadata.basics_lang_mandarin"]</option>
                    <option value="English">@L["edit_metadata.basics_lang_english"]</option>
                    <option value="Russian">@L["edit_metadata.basics_lang_russian"]</option>
                    <option value="Korean">@L["edit_metadata.basics_lang_korean"]</option>
                </select>
            </SettingsCard>
            <SettingsCard Icon="cc" Title="@L["profile.subtitle_lang_label"]" Description="@L["profile.subtitle_lang_desc"]">
                <select class="fs-select" value="@_subPref" @onchange="OnSubPrefChanged">
                    <option value="Russian">@L["edit_metadata.basics_lang_russian"]</option>
                    <option value="English">@L["edit_metadata.basics_lang_english"]</option>
                    <option value="Off">@L["profile.subtitle_off"]</option>
                    <option value="Japanese">@L["edit_metadata.basics_lang_japanese"]</option>
                </select>
            </SettingsCard>
            <SettingsCard Icon="cc" Title="@L["profile.subtitle_size_label"]" Description="@($"{_subSize} px")">
                <input type="range" min="12" max="32" step="1" class="fs-range"
                       aria-label="@L["profile.subtitle_size_label"]"
                       value="@_subSize" @onchange="OnSubSizeChanged" />
            </SettingsCard>
        </SettingsGroup>

        <SettingsGroup Title="@L["profile.theme_music_title"]">
            @* Theme music (anime OP/ED) — soft autoplay on a title's page. *@
            <SettingsCard Icon="music" Title="@L["profile.theme_music_title"]" Description="@L["profile.theme_music_hint"]"
                          Body="@(_themeMusic ? ThemeVolumeBody() : null)">
                <Toggle Checked="@_themeMusic" CheckedChanged="OnThemeMusicToggle" />
            </SettingsCard>
        </SettingsGroup>
    };

    private RenderFragment ThemeVolumeBody() => __builder =>
    {
        <label class="fs-field">
            <span class="fs-field__label">@L["profile.theme_volume_label"] · @_themeMusicVolume %</span>
            <input type="range" min="0" max="100" step="1" class="fs-range"
                   value="@_themeMusicVolume" @onchange="OnThemeMusicVolumeChanged" />
        </label>
    };

    private static string StripTags(string html)
        => System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", "");

    // Label holds an existing localization KEY (settings.accent_*) resolved via
    // L[...] at the swatch render site — reuses the palette names already
    // translated for the admin Settings page.
    private record SwatchDef(int Hue, double L, double C, string Label);
    // Preset "primary colors" — swatch dots drawn at a mid lightness so they
    // read on both themes; the actual UI shades come from tokens.css.
    private static readonly SwatchDef[] AccentSwatches =
    {
        new(25,  0.62, 0.19, "settings.accent_crimson"),
        new(50,  0.68, 0.17, "settings.accent_orange"),
        new(80,  0.76, 0.15, "settings.accent_amber"),
        new(150, 0.66, 0.15, "settings.accent_green"),
        new(195, 0.66, 0.11, "settings.accent_teal"),
        new(250, 0.60, 0.16, "settings.accent_blue"),
        new(295, 0.60, 0.18, "settings.accent_violet"),
        new(350, 0.64, 0.18, "settings.accent_pink"),
    };

    /// <summary>Inline style for an accent swatch. Built with InvariantCulture
    /// so a comma-decimal device locale (ru / uk) doesn't emit
    /// <c>oklch(0,66 0,20 25)</c> — invalid CSS that makes the swatch
    /// transparent (reported as "кружочки цветов не видно"). The default
    /// interpolation uses the current culture, which is the bug.</summary>
    private static string SwatchStyle(SwatchDef s) =>
        System.FormattableString.Invariant($"--swatch-color: oklch({s.L} {s.C} {s.Hue});");

    private int? _huePreview;

    private async Task OnHuePreview(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var hue)) return;
        _huePreview = hue;
        try { await JS.InvokeVoidAsync("animarr_setAccentHue", hue); } catch { }
    }

    private async Task OnHueCommit(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var hue)) return;
        _huePreview = null;
        await OnSelectAccent(hue);
    }

    private async Task OnSelectAccent(int hue)
    {
        // Optimistic update — set local state + DOM accent variable, then
        // PATCH. The DOM update is immediate so the user sees the new accent
        // before the server confirms.
        try { await JS.InvokeVoidAsync("animarr_setAccentHue", hue); } catch { }
        await PatchAsync(new UpdatePreferencesRequest(
            AccentHue: hue, null, null, null, null, null, null, null, null, null, null, null, null));
        StateHasChanged();
    }
}
