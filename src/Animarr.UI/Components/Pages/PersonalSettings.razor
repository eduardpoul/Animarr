    }

    // ─── Servers tab ────────────────────────────────────────────────
    //
    // v5: server management lives in its own tab (was tucked at the top of
    // the Identity tab and crowded the user info). Beyond switch / add, the
    // tab also lets the user rename a registered server in the local
    // registry — useful when two boxes both call themselves "Animarr" or
    // when a Tailscale alias is more memorable than the LAN IP. Pure
    // client-side rename — see ServerRegistryState.RenameAsync for the
    // "why we don't push it to the server" rationale.

    /// <summary>ServerId of the row currently in rename mode (null = none).
    /// We allow only one active edit at a time to keep keyboard focus sane.</summary>
    private string? _renameServerId;
    /// <summary>Working buffer for the rename field.</summary>
    private string  _renameDraft = "";

    private void StartRename(RegisteredServerDto s)
    {
        _renameServerId = s.ServerId;
        _renameDraft    = s.Name;
    }

    private async Task CommitRename()
    {
        if (_renameServerId is null) return;
        var id = _renameServerId;
        var name = _renameDraft;
        _renameServerId = null;
        _renameDraft    = "";
        await ServerReg.RenameAsync(id, name);
    }

    private void CancelRename()
    {
        _renameServerId = null;
        _renameDraft    = "";
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")      await CommitRename();
        else if (e.Key == "Escape") CancelRename();
    }

    private RenderFragment RenderServers() => __builder =>
    {
        <SettingsGroup Title="@L["profile.servers_label"]">
            @if (ServerReg.Count == 0)
            {
                <div class="fs-msgbar fs-msgbar--info"><span class="fs-msgbar__ic"><DIcon Name="info" Size="16" /></span>@L["profile.servers_empty"]</div>
            }

            @if (ServerReg.Current is { } current)
            {
                @ServerRow(current, isCurrent: true)
            }

            @foreach (var other in ServerReg.Servers.Where(s =>
                ServerReg.Current is null || s.ServerId != ServerReg.Current.ServerId))
            {
                @ServerRow(other, isCurrent: false)
            }

            <SettingsCard Icon="plus" Title="@L["profile.add_server"]" Description="@L["profile.add_server_sub"]"
                          Expandable="true" Expanded="@_addServerOpen"
                          ExpandedChanged="@((bool v) => { _addServerOpen = v; if (!v) _addError = ""; })">
                <Body>
                    <div class="fs-row">
                        <input type="text"
                               class="fs-input ps-grow"
                               placeholder="http://192.168.1.50:8080"
                               value="@_addUrl"
                               @oninput="@((ChangeEventArgs e) => _addUrl = e.Value?.ToString() ?? "")"
                               @onkeypress="OnAddKeyPress" />
                        <Btn Variant="primary" Loading="@_adding" OnClick="OnAddServer"
                             Disabled="@(string.IsNullOrWhiteSpace(_addUrl))">@L["profile.btn_probe"]</Btn>
                    </div>
                    @if (!string.IsNullOrEmpty(_addError))
                    {
                        <div class="fs-msgbar fs-msgbar--error"><span class="fs-msgbar__ic"><DIcon Name="warn" Size="16" /></span>@_addError</div>
                    }
                </Body>
            </SettingsCard>
        </SettingsGroup>
    };

    /// <summary>One registered server as a settings card. Current server shows
    /// a "current" badge; others a Switch button. Rename opens the card body.</summary>
    private RenderFragment ServerRow(RegisteredServerDto s, bool isCurrent) => __builder =>
    {
        var srv = s;
        var editing = _renameServerId == srv.ServerId;
        var meta = srv.BaseUrl + (srv.TitleCount is int c ? L.Get("profile.server_titles_suffix_fmt", c) : "");

        <SettingsCard Icon="server" Title="@srv.Name" Description="@meta"
                      Body="@(editing ? RenameBody() : null)">
            @if (isCurrent)
            {
                <span class="fs-status fs-status--ok">@L["profile.server_current"]</span>
            }
            <button type="button" class="fs-icon-btn tv-focus"
                    @onclick="@(() => StartRename(srv))"
                    title="@L["profile.aria_rename_server"]"
                    aria-label="@L["profile.aria_rename_server"]">
                <DIcon Name="pencil" Size="16" />
            </button>
            @if (!isCurrent)
            {
                <Btn Variant="solid" OnClick="@(() => OnSwitchServer(srv))">@L["profile.server_switch"]</Btn>
            }
        </SettingsCard>
    };

    private RenderFragment RenameBody() => __builder =>
    {
        <div class="fs-row">
            <input type="text"
                   class="fs-input ps-grow"
                   value="@_renameDraft"
                   @oninput="@((ChangeEventArgs e) => _renameDraft = e.Value?.ToString() ?? "")"
                   @onkeydown="OnRenameKey"
                   autofocus />
            <Btn Variant="primary" OnClick="CommitRename">@L["profile.aria_save_name"]</Btn>
            <Btn Variant="solid" OnClick="CancelRename">@L["common.btn_cancel"]</Btn>
        </div>
        <p class="fs-hint">@L["profile.rename_hint"]</p>
    };

