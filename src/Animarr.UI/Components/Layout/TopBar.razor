@*
    TopBarV4 — 60px fixed header that replaces the v3 sidebar. Holds:

      [A] ANIMARR  All|Anime|Movies|...  ●17/25  [↓2]  [⚙]  [@Yuri · master]

    - Brand → /catalog
    - Folder strip → filters Home page by folder (writes to FolderJump state)
    - LLM pill → opens LLMStatusPopup anchored top-right
    - Downloads button → /downloads (visible only if uploadContent)
    - Admin button → /server (visible only if systemSettings)
    - Profile chip → opens ProfilePanel drawer

    v5 update: server pill removed from the bar — server switching lives in
    ProfilePanel → Server tab. The pill duplicated the brand name on
    single-server installs (default server name is "Animarr"), and a proper
    multi-server picker belongs in the profile drawer alongside identity /
    devices / pairing.

    Spec: screens-v4.jsx lines 237-366.

    Wired to UserContextState for current user + permissions, and to
    FolderJumpService for cross-page folder selection.
*@

@inject NavigationManager Nav
@inject UserContextState UserCtx
@inject FolderJumpService FolderJump
@inject CategoryNavService CategoryNav
@inject IAnimarrApiClient Api
@implements IDisposable

<header class="d-topbar @ExtraClass">
    <button type="button" class="d-topbar__brand tv-focus" @onclick="GoHome" aria-label="@L["topbar.brand_aria"]">
        <BrandMark Size="30" ExtraClass="d-topbar__brand-mark" />
        <span class="d-topbar__brand-name">Animarr</span>
    </button>

    <nav class="d-topbar__nav d-scroll-x" aria-label="@L["topbar.folder_nav_aria"]">
        @* v5 update: TopBar pills are ROOT FOLDER pills (Movies / Anime /
           Donghua / …), not category chips. Folders are the admin-managed
           sections from Server Settings → Folders; clicking one filters the
           catalog grid AND the hero strip to items inside that section.
           Category chips live below the hero on the Home page itself and
           cross-cut folders (an Anime category might span the "Anime" folder
           and a misclassified item from "Movies" — categories are a soft
           taxonomy, folders are hard storage roots). Home subscribes to
           FolderJumpService.OnChange and reapplies its section filter. *@
        @foreach (var name in _folderNames)
        {
            var n = name;
            var active = IsFolderActive(n);
            <button type="button"
                    class="@($"d-topbar__pill tv-focus {(active ? "d-topbar__pill--active" : "")}")"
                    @onclick="@(() => OnPickFolder(n))">@n</button>
        }
    </nav>

    @* Needs-review pill — top-right cluster, just left of the AI/LLM pill.
       Renders only when there are items below the confidence threshold;
       opens the same NeedsReview modal it did on Home. *@
    <NeedsReviewChip Compact="true" />

    @* LLM status pill — sits LEFT of the search button (swapped per request). *@
    <button type="button" class="d-topbar__llm tv-focus" @onclick="ToggleLlm" aria-label="@L["sidebar_llm.popup_aria"]">
        <span class="d-topbar__llm-dot"></span>
        <DIcon Name="magic" Size="13" />
        <span class="d-topbar__llm-count">@_llmCount</span>
    </button>

    @* Search shortcut — goes to a dedicated /search page with realtime
       filtering of the entire library. Replaces the bulky "Filter by title"
       input + counter that used to live on the catalog. *@
    <button type="button"
            class="@($"d-topbar__icon-btn tv-focus {(IsRoute("/search") ? "d-topbar__icon-btn--active" : "")}")"
            @onclick="@(() => Nav.NavigateTo("/search"))"
            title="@L["search.title"]"
            aria-label="@L["search.title"]">
        <DIcon Name="search" Size="15" />
    </button>

    @* Airing calendar — when the next episodes of the library's ongoings drop. *@
    <button type="button"
            class="@($"d-topbar__icon-btn tv-focus {(IsRoute("/calendar") ? "d-topbar__icon-btn--active" : "")}")"
            @onclick="@(() => Nav.NavigateTo("/calendar"))"
            title="@L["calendar.title"]"
            aria-label="@L["calendar.title"]">
        <DIcon Name="calendar" Size="15" />
    </button>

    @* Watchlist — "Хочу посмотреть". Fed by the Want buttons on the
       recommendation rails (and, later, franchises). *@
    <button type="button"
            class="@($"d-topbar__icon-btn tv-focus {(IsRoute("/watchlist") ? "d-topbar__icon-btn--active" : "")}")"
            @onclick="@(() => Nav.NavigateTo("/watchlist"))"
            title="@L["watchlist.title"]"
            aria-label="@L["watchlist.title"]">
        <DIcon Name="bookmark" Size="15" />
    </button>

    @if (UserCtx.Can(p => p.UploadContent))
    {
        <button type="button"
                class="@($"d-topbar__icon-btn tv-focus {(IsRoute("/downloads") ? "d-topbar__icon-btn--active" : "")}")"
                @onclick="@(() => Nav.NavigateTo("/downloads"))"
                title="@L["topbar.downloads"]">
            <DIcon Name="torrent" Size="15" />
            @if (_activeDownloads > 0)
            {
                <span class="d-topbar__badge">@_activeDownloads</span>
            }
        </button>
    }

    @if (UserCtx.Can(p => p.SystemSettings))
    {
        <button type="button"
                class="@($"d-topbar__icon-btn tv-focus {(IsRoute("/server") ? "d-topbar__icon-btn--active" : "")}")"
                @onclick="@(() => Nav.NavigateTo("/server"))"
                title="@L["profile.server_settings_title"]">
            <DIcon Name="settings" Size="15" />
        </button>
    }

    @if (UserCtx.Me is { } me)
    {
        @* Avatar only — the name + role text beside it was visual noise; the
           avatar alone opens the profile drawer where identity lives. *@
        <button type="button" class="d-topbar__profile d-topbar__profile--icon-only tv-focus" @onclick="OnProfileClick" aria-label="@L["topbar.open_profile"]">
            <Avatar Name="@me.User.Name" HueOverride="me.User.AvatarHue" ImagePath="@me.User.AvatarPath" Size="sm" />
        </button>
    }
</header>

@code {
    [Parameter] public string? ExtraClass { get; set; }
    [Parameter] public int ActiveDownloads { get; set; }
    [Parameter] public int LlmDone { get; set; }
    [Parameter] public int LlmTotal { get; set; }
    [Parameter] public EventCallback OnProfileClickEvent { get; set; }
    [Parameter] public EventCallback OnLlmClickEvent { get; set; }
    /// <summary>Folder section labels — passed in from MainLayout because the
    /// fetch lives there to dedupe with the catalog's own folder fetch.</summary>
    [Parameter] public IReadOnlyList<string>? FolderNames { get; set; }

    private int _activeDownloads => ActiveDownloads;
    private string _llmCount => $"{LlmDone}/{LlmTotal}";

    private string[] _folderNames =>
        FolderNames is { Count: > 0 } list
            ? list.Prepend("All").ToArray()
            : new[] { "All" };

    // v5: category strip data. Fetched once on first render — categories
    // change rarely so we don't need a SignalR push.
    private CategoryDto[] _categories = Array.Empty<CategoryDto>();

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to nav-state change events so the active-pill highlight
        // reflects clicks from anywhere (Home chip strip, deep links, etc.).
        CategoryNav.OnChange += StateHasChanged;
        FolderJump.OnChange  += StateHasChanged;

        try
        {
            var all = await Api.GetCategoriesAsync();
            _categories = all
                .Where(c => c.Enabled && c.ItemCount > 0)
                .OrderBy(c => c.SortOrder)
                .ThenBy(c => c.Name)
                .ToArray();
        }
        catch { _categories = Array.Empty<CategoryDto>(); }
    }

    public void Dispose()
    {
        CategoryNav.OnChange -= StateHasChanged;
        FolderJump.OnChange  -= StateHasChanged;
    }

    private void GoHome()
    {
        FolderJump.SetActiveFolder(null);
        CategoryNav.SetActiveCategory(null);
        Nav.NavigateTo("/");
    }

    private bool IsCategoryActive(string? name)
    {
        if (!IsCatalogRoute()) return false;
        return name is null
            ? CategoryNav.ActiveCategoryName is null
            : string.Equals(CategoryNav.ActiveCategoryName, name, StringComparison.OrdinalIgnoreCase);
    }

    private void OnPickCategory(string? name)
    {
        CategoryNav.SetActiveCategory(name);
        if (!IsCatalogRoute()) Nav.NavigateTo("/");
    }

    private bool IsFolderActive(string name)
    {
        // Only the catalog page reflects folder state. On other routes the
        // strip shows the last-known selection in case the user goes back.
        if (!IsCatalogRoute()) return false;
        return name == "All"
            ? FolderJump.ActiveFolderName is null
            : string.Equals(FolderJump.ActiveFolderName, name, StringComparison.OrdinalIgnoreCase);
    }

    private void OnPickFolder(string name)
    {
        FolderJump.SetActiveFolder(name == "All" ? null : name);
        if (!IsCatalogRoute()) Nav.NavigateTo("/");
    }

    private bool IsCatalogRoute()
    {
        // Home ("/") and the full Library page share the folder/category
        // filter state, so pills highlight — and filter in place — on both.
        var path = new Uri(Nav.Uri).AbsolutePath;
        return string.IsNullOrEmpty(path) || path == "/" || path == "/catalog" || path == "/library";
    }

    private bool IsRoute(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath;
        return current.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    private Task OnProfileClick() => OnProfileClickEvent.InvokeAsync();
    private Task ToggleLlm()      => OnLlmClickEvent.InvokeAsync();
}
