@*
    MainLayout (v4) — default layout for authenticated routes.

    Composition:
      • Backdrop layer (fanart slideshow + vignette + hue tint) — the
        Fluent "Mica" the NavPane and pages sit on
      • NavPane.razor (desktop ≥ 960px) — Fluent nav drawer; owns search,
        sections, folders, downloads, server settings, AI status + profile
      • MobileShell.razor (< 960px, top strip + bottom tabbar)
      • <main> body
      • Settings live on the /settings page (SettingsPage) — the profile
        item at the bottom of the NavPane / the mobile avatar open it
      • LLMStatusPopup (anchored bottom-left next to the NavPane AI item)
      • Toast stack (bottom-right)

    Boots /api/auth/status + /api/me on first render through
    UserContextState. Redirects anonymous users to /welcome or /setup as
    needed — those routes have their own AuthLayout that skips this shell.
    Before that, the device gates (RunDeviceGatesAsync) apply this device's
    "Sign in by default" profile, the once-per-session "Who's watching"
    picker (/switch) and the mandatory per-device PIN (/set-pin).
*@

@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject UserContextState UserCtx
@inject IJSRuntime JS
@inject IAnimarrApiClient Api
@inject HttpClient Http
@inject ToastService Toasts
@inject NavigationManager Nav
@inject ThemeService ThemeService
@inject LocalizationService Loc
@inject ServerAddressProvider ServerAddr
@inject ServerRegistryState ServerReg
@inject DeviceProfilesState DeviceProfiles

@using Microsoft.AspNetCore.SignalR.Client

<div class="animarr-shell">

    @* Backdrop: fixed under everything. backdrop.js paints the slides;
       vignette + hue tint are pure CSS. *@
    <div class="animarr-backdrop">
        <div id="backdrop-container">
            <div id="backdrop-slide-a" class="backdrop-slide"></div>
            <div id="backdrop-slide-b" class="backdrop-slide"></div>
        </div>
        <div class="animarr-backdrop__vignette" aria-hidden="true"></div>
        <div class="animarr-backdrop__hue-tint" aria-hidden="true"></div>
    </div>

    @if (UserCtx.Loaded && UserCtx.IsAuthenticated)
    {
        <NavPane ActiveDownloads="_activeDownloads"
                 DrawerOpen="_navDrawerOpen"
                 OnRequestClose="@(() => _navDrawerOpen = false)"
                 LlmDone="_llmDone" LlmTotal="_llmTotal"
                 FolderNames="@_folderNames"
                 OnProfileClickEvent="@(() => OpenSettings("account"))"
                 OnLlmClickEvent="@(() => _llmOpen = !_llmOpen)" />

        <MobileShell ActiveDownloads="_activeDownloads"
                     MoreOpen="_navDrawerOpen"
                     OnMoreClickEvent="@(() => _navDrawerOpen = !_navDrawerOpen)" />

        @* Phone nav drawer scrim — tap outside the drawer to close it. *@
        @if (_navDrawerOpen)
        {
            <div class="ml-nav-scrim" @onclick="@(() => _navDrawerOpen = false)" aria-hidden="true"></div>
        }
    }

    <main class="animarr-main">
        @Body
    </main>


    <LLMStatusPopup Open="_llmOpen"
                    Done="_llmDone" Total="_llmTotal"
                    AvgMs="480" HitRate="99.2"
                    Recent="_recentIdentifications"
                    Paused="_llmPaused"
                    OnTogglePause="OnToggleIdentPauseAsync"
                    OnClose="@(() => _llmOpen = false)" />
</div>

<div class="ml-toast-stack">
    @foreach (var t in _toasts)
    {
        <div class="@($"ml-toast ml-toast--{t.Intent.ToString().ToLowerInvariant()}")">
            <span class="ml-toast__msg">@t.Message</span>
            <button type="button" class="ml-toast__close" @onclick="@(() => _toasts.Remove(t))" aria-label="Close">
                <DIcon Name="x" Size="13" />
            </button>
        </div>
    }
</div>

@code {
    private const string AccentStorageKey = "animarr-accent";

    private int _activeDownloads;
    private int _llmDone;
    private int _llmTotal;
    private bool _llmPaused;
    /// <summary>Open the settings hub. Phones land on its section list
    /// (section null); desktop callers name the section to show.</summary>
    private void OpenSettings(string? section)
        => Nav.NavigateTo(section is null ? "/settings" : $"/settings?section={section}");

    private bool _llmOpen;
    /// <summary>Phone NavPane drawer (tab bar "More"); closes on navigation.</summary>
    private bool _navDrawerOpen;
    private bool _everywhereBackdropStarted;
    private HubConnection? _hub;
    private HubConnection? _identHub;
    private string[] _folderNames = Array.Empty<string>();
    private readonly List<ToastInfo> _toasts = new();
    private const int ToastAutoDismissMs = 4000;
    private IReadOnlyList<LLMStatusPopup.RecentItem> _recentIdentifications = Array.Empty<LLMStatusPopup.RecentItem>();

    protected override void OnInitialized()
    {
        // Same-origin browser → cookie; anything else needs the media token on
        // byte URLs (see MediaUrl.NeedsToken).
        Animarr.UI.Services.MediaUrl.SetPageOrigin(Nav.BaseUri);
        Animarr.UI.Services.MediaUrl.OnBaseChanged += OnMediaUrlChanged;
        UserCtx.OnChange += OnUserCtxChanged;
        ThemeService.OnChange += OnThemeChanged;
        L.LanguageChanged += OnLanguageChanged;
        Toasts.OnShow += OnToastShown;
        Nav.LocationChanged += OnLocationChangedCloseDrawer;
        // Default-focus on navigation lives in tv-nav.js — it hooks
        // history.pushState/replaceState so every Blazor NavigateTo fires
        // an Animarr:navigated window event. Hooking the JS layer means
        // AuthLayout-hosted routes (Welcome / Login / Setup / Pair /
        // Discovery — the entire first-time TV flow) work too, which a
        // LocationChanged subscription here would miss because MainLayout
        // isn't instantiated on those routes.
    }

    private void OnUserCtxChanged() => InvokeAsync(async () =>
    {
        // Sign-out drops the token; a profile switch needs the new user's token
        // (it is bound to the user, so role folders follow the profile).
        if (!UserCtx.IsAuthenticated) Animarr.UI.Services.MediaUrl.ClearToken();
        else await RefreshMediaTokenAsync();
        StateHasChanged();
    });

    // ── Media token (MAUI / cross-origin hosts) ───────────────────────────
    private System.Threading.Timer? _mediaTokenTimer;

    /// <summary>Fetch / refresh the session media token for the signed-in user
    /// and hand it to the player JS. No-op for the same-origin web client.</summary>
    private async Task RefreshMediaTokenAsync()
    {
        if (!Animarr.UI.Services.MediaUrl.NeedsToken || !UserCtx.IsAuthenticated) return;
        await Animarr.UI.Services.MediaUrl.EnsureTokenAsync(Api, UserCtx.Me?.User.Id);
        await PushMediaTokenToJsAsync();
    }

    private async Task PushMediaTokenToJsAsync()
    {
        var t = Animarr.UI.Services.MediaUrl.NeedsToken ? Animarr.UI.Services.MediaUrl.Token : null;
        try { await JS.InvokeVoidAsync("animarrSetMediaToken", t); }
        catch { /* player script not loaded yet — apiUrl reads it on the next call */ }
    }

    /// <summary>Base or token changed — re-render (image URLs) and keep JS in sync.</summary>
    private void OnMediaUrlChanged() => InvokeAsync(async () =>
    {
        // A server switch drops the old server's token — fetch the new one
        // (no loop: a failed fetch leaves the token null without re-firing).
        if (Animarr.UI.Services.MediaUrl.NeedsToken && UserCtx.IsAuthenticated
            && Animarr.UI.Services.MediaUrl.Token is null)
            await Animarr.UI.Services.MediaUrl.EnsureTokenAsync(Api, UserCtx.Me?.User.Id);
        await PushMediaTokenToJsAsync();
        StateHasChanged();
    });
    private void OnThemeChanged()   => InvokeAsync(ApplyAccentHueToDomAsync);
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void OnToastShown(ToastInfo info) => InvokeAsync(async () =>
    {
        _toasts.Add(info);
        StateHasChanged();
        await Task.Delay(ToastAutoDismissMs);
        _toasts.Remove(info);
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 1. Bridge active server URL to JS + MediaUrl helper.
        //    HttpClient.BaseAddress is a placeholder (set once at boot for
        //    PrepareRequestMessage's relative-URI check); the *real* server is
        //    in ServerAddressProvider.Current — that's what gets swapped when
        //    the user picks a server in Discovery / ProfilePanel. Reading from
        //    there means a server switch immediately rebases <img src>'s too.
        try
        {
            // Hook server-pick + login flows so MediaUrl/JS pick up the new
            // base address without a full reload.
            ServerReg.OnChange += ApplyServerBase;

            // CRITICAL: hydrate the persisted registry FIRST. Without this,
            // a cookie-restored boot that lands straight on /home (skipping
            // Welcome + Discovery, which are the only other call sites for
            // LoadAsync) leaves ServerAddressProvider on the compile-time
            // DefaultServerUrl. Every <img src> then resolves against
            // tower.one and DNS-fails on LAN-only deployments. LoadAsync
            // calls ApplyCurrentToHttp() internally, which writes
            // ServerAddr.Current and fires OnChange — that triggers our
            // ApplyServerBase via the subscription above.
            await ServerReg.LoadAsync();
            ApplyServerBase();
        }
        catch { }

        // 2. Boot auth probe — /api/auth/status (anonymous-safe), /api/me and
        //    preferences (UserContextState fires them together). The device
        //    state the gates below need is cookie-scoped server-side and
        //    independent of the client-side auth state, so fetch it in the
        //    same round trip instead of after.
        var deviceStateTask = DeviceProfiles.RefreshAsync();
        await UserCtx.LoadAsync();

        // 2-pre. Device gates (default profile / "Who's watching" picker /
        //    mandatory PIN). May sign in as the device default, or leave for
        //    an AuthLayout page — then nothing below runs for this layout.
        if (!await RunDeviceGatesAsync(deviceStateTask)) return;

        // 2-. Media token: in the MAUI WebView every <img>/<video> loads the
        //     remote server cross-origin, where the auth cookie isn't sent —
        //     fetch the session token BEFORE the hubs / backdrop start, and keep
        //     it fresh (tokens live 6–12 h; the server returns the same value
        //     within a 6 h window, so this is cheap and URLs stay cache-stable).
        //     The language pack (2a) and the appearance reconcile (2b/2c) don't
        //     depend on it — they run alongside; all three are awaited before
        //     the route guard, as before.
        var tokenTask      = RefreshMediaTokenAsync();
        var languageTask   = ApplyLanguageAsync();
        var appearanceTask = ApplyAppearancePrefsAsync();
        await Task.WhenAll(tokenTask, languageTask, appearanceTask);
        _mediaTokenTimer ??= new System.Threading.Timer(
            _ => InvokeAsync(RefreshMediaTokenAsync), null,
            TimeSpan.FromMinutes(30), TimeSpan.FromMinutes(30));

        // 3. Route guard. Pages with @layout AuthLayout (Welcome / Login /
        //    Setup) skip this whole block — they're rendered by the router
        //    against AuthLayout, not MainLayout. Anyone hitting an
        //    auth-required route while anonymous gets bounced to /welcome,
        //    which acts as the public landing page. Welcome itself routes
        //    the user onward to /setup (first-run) or /login (returning) via
        //    its START button — we don't short-circuit straight to /setup
        //    here so the marketing copy is always shown at least once.
        if (!UserCtx.IsAuthenticated)
        {
            Nav.NavigateTo("/welcome", replace: true);
            return;
        }

        if (UserCtx.IsAuthenticated)
        {
            // A launcher card / Continue-watching tile (animarr://play/{id},
            // the phone app): open the title now that auth is known — a
            // signed-in start lands here, never on Welcome.
            await RegisterDeepLinksAsync();
            // Independent of each other (each owns its error handling) —
            // start them together instead of six serial round trips.
            var tasks = new List<Task>
            {
                ApplyAccentHueToDomAsync(),
                StartBackdropAsync(),
                LoadFolderNamesAsync(),
                StartIdentificationHubAsync(),
                RefreshIdentificationStatusAsync(),
            };
            // The torrent hub carries the torrent REST gate (UploadContent) —
            // don't knock on it without the permission.
            if (UserCtx.Can(p => p.UploadContent))
                tasks.Add(StartTorrentHubAsync());
            await Task.WhenAll(tasks);
            StateHasChanged();
        }

        // First render of MainLayout — Blazor's router doesn't push the
        // initial URL, so tv-nav.js's history-API hook never sees it.
        // Dispatch the synthetic nav event so the page's
        // [data-tv-autofocus] target gets focused without the user
        // having to press an arrow first.
        try { await JS.InvokeVoidAsync("eval",
            "window.dispatchEvent(new Event('Animarr:navigated'));"); }
        catch { }
    }

    /// <summary>Boot step 2a — apply the user's interface language.</summary>
    private async Task ApplyLanguageAsync()
    {
        // 2a. Apply user's saved interface language. Web.Client preloads "en"
        //     at boot in its own Program.cs; Animarr.App (MAUI) does NOT,
        //     so on MAUI the dict is empty for the first render and any
        //     L["nav.catalog"] returns the raw key. Always seed with "en"
        //     here so MAUI gets readable labels even when the user's pref
        //     is null/"en". Loc.LoadAsync transparently falls back to
        //     en.json if a non-English pack file is missing.
        // The client Program.cs already booted the pack cached from last
        // session; only (re)load when the server's stored pref differs — e.g.
        // changed on another device, or a first-ever boot with an empty cache
        // (LoadAsync falls back to en.json for missing packs, so English is
        // still the floor). Then cache the resolved language so the NEXT boot
        // paints it directly, with no English flash.
        var prefLang = UserCtx.Preferences?.Language;
        var wantLang = string.IsNullOrEmpty(prefLang) ? "en" : prefLang;
        if (Loc.CurrentLanguage != wantLang)
        {
            try { await Loc.LoadAsync(wantLang); } catch { /* keys-as-values fallback */ }
        }
        try { await JS.InvokeVoidAsync("localStorage.setItem", "animarr-lang", Loc.CurrentLanguage); } catch { }
    }

    /// <summary>Boot steps 2b/2c — reconcile theme, accent hue and tv-mode
    /// with the server-stored preferences.</summary>
    private async Task ApplyAppearancePrefsAsync()
    {
        // 2b. Apply user's chosen personality theme. index.html paints a
        //     bootstrap data-theme from localStorage so first paint matches
        //     last session; this call reconciles with the server-stored
        //     preference in case the user switched theme on another device.
        var prefTheme = UserCtx.Preferences?.Theme;
        if (!string.IsNullOrEmpty(prefTheme))
        {
            try { await JS.InvokeVoidAsync("animarr_setTheme", prefTheme); } catch { }
        }
        // Same idea for accent hue — server is the truth.
        var prefHue = UserCtx.Preferences?.AccentHue;
        if (prefHue is int hue && hue >= 0 && hue < 360)
        {
            try { await JS.InvokeVoidAsync("animarr_setAccentHue", hue); } catch { }
        }

        // 2c. Reconcile tv-mode class with the server preference. index.html's
        //     bootstrap resolver picks an initial value from localStorage +
        //     UA heuristic; here we override with what the user actually
        //     chose in ProfilePanel → Appearance, persisted server-side. If
        //     the user toggled TV mode on a phone (localStorage was "0") but
        //     turned it on from another device, this call adds the class
        //     post-boot. Conversely if the heuristic auto-on'd it but the
        //     user explicitly disabled it server-side, we strip the class.
        //     Mirroring back into localStorage keeps the bootstrap resolver
        //     and the server preference in lockstep on the next boot.
        if (UserCtx.Preferences is { } prefs)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    prefs.TvMode
                        ? "document.documentElement.classList.add('tv-mode');" +
                          "try{localStorage.setItem('animarr_tv_mode','1');}catch(_){};"
                        : "document.documentElement.classList.remove('tv-mode');" +
                          "try{localStorage.setItem('animarr_tv_mode','0');}catch(_){};");
            }
            catch { }
        }
    }

    /// <summary>
    /// Device gates, run once per MainLayout mount (i.e. on app open and on
    /// every return from an AuthLayout page such as /switch or /set-pin):
    ///
    ///   • anonymous: the device's "Sign in by default" profile → straight in
    ///     (server-side, no PIN); else PIN-protected profiles on this device →
    ///     the "Who's watching" picker; else /welcome.
    ///   • signed in, first time this browser session / app launch: a default
    ///     profile → enter it (switching if another profile's session was
    ///     left behind); else ≥2 profiles on this device → the picker.
    ///   • signed in without a PIN on this device → the blocking /set-pin.
    ///
    /// Returns false when it navigated away (the caller stops booting this
    /// layout). An older server without /api/auth/device skips the device
    /// gates entirely and keeps the plain signed-in/anonymous routing.
    /// </summary>
    private async Task<bool> RunDeviceGatesAsync(Task<DeviceStateDto?> deviceState)
    {
        var state = await deviceState;   // DeviceProfiles.RefreshAsync, started with the auth probe
        if (state is null) return true;

        var gatePassed = await DeviceProfiles.IsGatePassedAsync();

        if (!UserCtx.IsAuthenticated)
        {
            if (state.DefaultUserId is not null && await TryEnterDefaultAsync())
            {
                state = DeviceProfiles.State ?? state;   // now signed in as the default
            }
            else if (state.Profiles.Any(p => p.HasPin))
            {
                Nav.NavigateTo("/switch", replace: true);
                return false;
            }
            else
            {
                return true;   // the plain anonymous route guard sends to /welcome
            }
        }
        else if (!gatePassed)
        {
            if (state.DefaultUserId is Guid defaultId)
            {
                if (defaultId != UserCtx.Me!.User.Id) await TryEnterDefaultAsync();
                await DeviceProfiles.MarkGatePassedAsync();
                state = DeviceProfiles.State ?? state;
            }
            else if (state.Profiles.Length >= 2)
            {
                Nav.NavigateTo("/switch", replace: true);
                return false;
            }
            else
            {
                await DeviceProfiles.MarkGatePassedAsync();
            }
        }

        if (UserCtx.IsAuthenticated && DeviceProfiles.CurrentUserNeedsPin)
        {
            Nav.NavigateTo("/set-pin", replace: true);
            return false;
        }
        return true;
    }

    /// <summary>Sign in as the device default profile; refreshes identity and
    /// device state. False when the server refused (no default any more).</summary>
    private async Task<bool> TryEnterDefaultAsync()
    {
        try
        {
            if (await Api.EnterDeviceDefaultAsync() is null) return false;
        }
        catch { return false; }
        await UserCtx.RefreshMeAsync();
        await DeviceProfiles.RefreshAsync();
        await DeviceProfiles.MarkGatePassedAsync();
        return UserCtx.IsAuthenticated;
    }

    /// <summary>Recompute LLM popup counters (_llmDone, _llmTotal, recent list)
    /// from a single /api/identification-queue snapshot. Called on initial
    /// mount and on every QueueChanged hub broadcast.</summary>
    private async Task RefreshIdentificationStatusAsync()
    {
        try
        {
            var entries = await Api.GetIdentificationQueueAsync();
            _llmTotal = entries.Length;
            _llmDone  = entries.Count(e =>
                e.Status == IdentificationQueueStatus.Done ||
                e.Status == IdentificationQueueStatus.Failed);
            _recentIdentifications = entries
                .Where(e => e.Status == IdentificationQueueStatus.Done && e.ProcessedAt is not null)
                .OrderByDescending(e => e.ProcessedAt!.Value)
                .Take(5)
                .Select(e => new LLMStatusPopup.RecentItem(e.FolderLabel, 0.92))
                .ToList();
            try { _llmPaused = (await Api.GetIdentificationStatusAsync())?.IsPaused ?? _llmPaused; } catch { }
            await InvokeAsync(StateHasChanged);
        }
        catch { /* offline — popup just shows 0/0 */ }
    }

    /// <summary>Pause/resume the identification (AI parsing) queue from the popup
    /// button. Optimistic flip; the QueueChanged hub broadcast that SetPaused fires
    /// re-confirms the state on the next RefreshIdentificationStatusAsync.</summary>
    private async Task OnToggleIdentPauseAsync()
    {
        var next = !_llmPaused;
        _llmPaused = next;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (next) await Api.PauseIdentificationAsync();
            else      await Api.ResumeIdentificationAsync();
        }
        catch
        {
            _llmPaused = !next;   // rollback on failure
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyAccentHueToDomAsync()
    {
        int hue = UserCtx.Preferences?.AccentHue ?? ThemeService.AccentHue;
        try { await JS.InvokeVoidAsync("animarr_setAccentHue", hue); }
        catch { }
    }

    private async Task StartBackdropAsync()
    {
        var prefs = UserCtx.Preferences;
        if (prefs?.BackdropEnabled == false) return;
        try
        {
            var interval   = prefs?.BackdropIntervalSec ?? 30;
            var blur       = prefs?.BackdropBlurPx      ?? 14;
            var brightness = prefs?.BackdropBrightness  ?? 38;
            if (blur > 30) blur = 14;

            var paths = await Api.GetBackdropRotationAsync();
            if (paths.Length > 0)
            {
                // Route through MediaUrl so the backdrop slideshow uses the
                // user's chosen server authority. Raw "/api/image?…" URLs
                // resolve against the WebView2 virtual host on MAUI Windows
                // (https://0.0.0.1) and 404.
                // Under the default 14 px blur a 480 px-wide variant looks the
                // same as full-size fanart but decodes ~8× less (a 1920×1080
                // fanart is a ~8 MB texture, re-rasterised under the blur) and
                // transfers ~20 KB instead of ~300 KB per slide. A near-sharp
                // user setting keeps the original.
                int? bgWidth = blur >= 10 ? Animarr.UI.Services.MediaUrl.BlurredBackdropWidth : null;
                var urls = paths
                    .Select(p => Animarr.UI.Services.MediaUrl.Image(p, width: bgWidth))
                    .ToArray();
                _everywhereBackdropStarted = true;
                await JS.InvokeVoidAsync("initGlobalBackdrop", (object)urls, interval, blur, brightness);
            }
        }
        catch { }
    }

    private async Task LoadFolderNamesAsync()
    {
        try
        {
            var sections = await Api.GetSectionFoldersAsync();
            _folderNames = sections
                .OrderBy(f => f.Label)
                .Select(f => f.Label)
                .ToArray();
        }
        catch { _folderNames = Array.Empty<string>(); }
    }

    private async Task StartTorrentHubAsync()
    {
        var hubUri = ServerAddr.HubUri(Nav.Uri, ApiRoutes.HubTorrents);
        _hub = Animarr.UI.Services.AnimarrHub.Build(hubUri);
        _hub.On<TorrentSnapshotEnvelope>(TorrentHubMethods.LiveSnapshot, env =>
        {
            var live = env.Items.Count(s =>
                s.State == "Downloading" || s.DownloadRate > 0 || s.UploadRate > 0);
            if (live != _activeDownloads)
            {
                _activeDownloads = live;
                InvokeAsync(StateHasChanged);
            }
        });
        try { await _hub.StartAsync(); } catch { }
    }

    /// <summary>Identification hub — broadcasts QueueChanged on every status
    /// transition inside the LLM/metadata pipeline. We just refetch the snapshot
    /// rather than diff-mutating local state; the popup re-render is cheap and
    /// the queue rarely exceeds ~50 rows in practice.</summary>
    private async Task StartIdentificationHubAsync()
    {
        var hubUri = ServerAddr.HubUri(Nav.Uri, ApiRoutes.HubIdentification);
        _identHub = Animarr.UI.Services.AnimarrHub.Build(hubUri);
        _identHub.On<IdentificationProgressEnvelope>(IdentificationHubMethods.QueueChanged, _ =>
        {
            InvokeAsync(QueueIdentificationRefresh);
        });
        try { await _identHub.StartAsync(); } catch { }
    }

    /// <summary>Trailing window that folds a burst of QueueChanged pings into
    /// one refetch (a job raises several; older servers sent up to 20 per event).</summary>
    private const int IdentRefreshDebounceMs = 400;
    private bool _identRefreshQueued;   // a refresh is waiting or in flight
    private bool _identRefreshDirty;    // another ping landed meanwhile

    /// <summary>Debounced, single-flight <see cref="RefreshIdentificationStatusAsync"/>
    /// for hub pings: each refresh is a 200-row queue fetch + status fetch, and
    /// they used to run once per ping, overlapping. Runs on the renderer's
    /// context (InvokeAsync), so the flags need no locking.</summary>
    private void QueueIdentificationRefresh()
    {
        if (_identRefreshQueued) { _identRefreshDirty = true; return; }
        _identRefreshQueued = true;
        _ = RunIdentificationRefreshAsync();
    }

    private async Task RunIdentificationRefreshAsync()
    {
        try
        {
            do
            {
                await Task.Delay(IdentRefreshDebounceMs);
                // Everything up to here is covered by this fetch; a ping that
                // arrives while it runs earns exactly one more.
                _identRefreshDirty = false;
                await RefreshIdentificationStatusAsync();
            }
            while (_identRefreshDirty);
        }
        finally { _identRefreshQueued = false; }
    }

    /// <summary>Push the active server's authority into MediaUrl + JS shim so
    /// every &lt;img src&gt; and url(…) in the page resolves against the
    /// real Animarr host (not the WebView2 virtual host 0.0.0.1 that
    /// MAUI mounts the bundle under). Called once on first render and again
    /// every time ServerRegistryState fires OnChange (Discovery pick,
    /// ProfilePanel switch).</summary>
    private void ApplyServerBase()
    {
        var apiBase = ServerAddr.Current?.GetLeftPart(UriPartial.Authority) ?? "";
        Animarr.UI.Services.MediaUrl.SetBase(apiBase);
        // Also publish to JS; backdrop.js + animarr-player.js use this when
        // they construct absolute fetch URLs outside the HttpClient pipeline.
        // animarrSetApiBase (defined in animarr-player.js) checks whether
        // the page is HTTPS while the api base is HTTP — that's the MAUI
        // BlazorWebView scenario where the virtual host forces HTTPS but
        // the LAN server is plain HTTP. In that case the helper rewrites
        // the base to a same-origin proxy path that AnimarrWebViewClient
        // (Android) intercepts and proxies via native HttpClient. On
        // matching schemes the helper is a passthrough.
        try { _ = JS.InvokeVoidAsync("animarrSetApiBase", apiBase); }
        catch { /* JS not ready on first call — next render will succeed */ }
        // Force a re-render so any image whose src was cached at the wrong
        // base re-evaluates against the new one.
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChangedCloseDrawer(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!_navDrawerOpen) return;
        _navDrawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    // ── Deep links (the phone app's animarr://play/{id}) ─────────────────────
    private DotNetObjectReference<MainLayout>? _deepLinkRef;

    /// <summary>Consume a link that started the app, and register for the
    /// ones that arrive while it runs (the activity calls back). No hook (a
    /// browser) → nothing.</summary>
    private async Task RegisterDeepLinksAsync()
    {
        _deepLinkRef ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("animarrOnDeepLink", _deepLinkRef); }
        catch { return; }
        await ConsumeDeepLinkAsync();
    }

    [JSInvokable]
    public Task ConsumeDeepLink() => InvokeAsync(ConsumeDeepLinkAsync);

    private async Task ConsumeDeepLinkAsync()
    {
        if (!UserCtx.IsAuthenticated) return;   // stays pending until a signed-in layout
        string? id = null;
        try { id = await JS.InvokeAsync<string?>("animarrConsumePendingDeepLink"); }
        catch { return; }
        // The title's page (MediaDetail, /catalog/{id}); the id is a GUID (the
        // activity only keeps those) — checked again before it becomes a route.
        if (Guid.TryParse(id, out var mediaId)) Nav.NavigateTo($"/catalog/{mediaId}");
    }

    public async ValueTask DisposeAsync()
    {
        _deepLinkRef?.Dispose();
        Animarr.UI.Services.MediaUrl.OnBaseChanged -= OnMediaUrlChanged;
        _mediaTokenTimer?.Dispose();
        UserCtx.OnChange -= OnUserCtxChanged;
        ThemeService.OnChange -= OnThemeChanged;
        L.LanguageChanged -= OnLanguageChanged;
        Toasts.OnShow -= OnToastShown;
        Nav.LocationChanged -= OnLocationChangedCloseDrawer;
        ServerReg.OnChange -= ApplyServerBase;
        if (_hub is not null) await _hub.DisposeAsync();
        if (_identHub is not null) await _identHub.DisposeAsync();
        if (_everywhereBackdropStarted)
            try { await JS.InvokeVoidAsync("stopBackdrop"); } catch { }
    }
}
