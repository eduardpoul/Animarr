@*
    Top-level layout for Animarr.UI's WASM + MAUI hosts.

    Loads the active language pack on first render (idempotent — Web.Client's
    Program.cs may have pre-loaded "en" already; the MAUI hybrid relies on
    this path entirely). Wires the NeedsReviewChip into the header nav so
    catalog-wide identification status is visible from every page.
*@
@inherits LayoutComponentBase
@inject LocalizationService Loc
@inject IAnimarrApiClient Api

<div class="ui-shell">
    <header class="ui-shell-header">
        <a href="" class="ui-shell-logo">Animarr</a>
        <nav class="ui-shell-nav">
            <NavLink href="" Match="NavLinkMatch.All">Catalog</NavLink>
            <NavLink href="torrents">Torrents</NavLink>
            <NavLink href="history">History</NavLink>
            <NavLink href="settings">Settings</NavLink>
        </nav>
        <div class="ui-shell-spacer"></div>
        <Animarr.UI.Components.Pages.NeedsReviewChip />
    </header>
    <main class="ui-shell-main">
        @Body
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Resolve the user's preferred language from server config before
        // pulling the corresponding pack. Falls back to whatever Program.cs
        // pre-loaded if the lookup fails (e.g. server unreachable).
        try
        {
            var pref = await Api.GetAppConfigValueAsync(AppConfigKeys.Language);
            var lang = pref?.Value ?? "en";
            if (!string.Equals(lang, Loc.CurrentLanguage, StringComparison.OrdinalIgnoreCase))
                await Loc.LoadAsync(lang);
        }
        catch { /* offline / first start — keys-as-values is fine */ }
    }
}
