@*
    Mobile shell (< 960px) — Fluent 2 mobile pattern:
      • top app bar (brand + live-downloads pill + avatar). Transparent over
        the hero at the top of the page, acrylic once the page scrolls
        (html.is-scrolled, set by app-shell.js).
      • bottom tab bar with the main destinations — Home · Library · Search ·
        Downloads · More. "More" opens the full NavPane as a slide-in drawer
        (Calendar, Watchlist, Stats, folders, settings, profile…).
    Hidden on desktop, where the NavPane is pinned on the left.
*@

@inject NavigationManager Nav
@inject UserContextState UserCtx
@inject LocalizationService Loc
@implements IDisposable

<nav class="d-mobile-nav" aria-label="@L["mobile.top_nav_aria"]">
    <a href="/" class="d-mobile-nav__brand tv-focus">
        <BrandMark Size="28" ExtraClass="animarr-brand-mark" />
        <span class="animarr-brand-name">Animarr</span>
    </a>
    <span class="d-mobile-nav__spacer"></span>
    @if (ActiveDownloads > 0)
    {
        <span class="sb-live" title="@L.Get("mobile.active_fmt", ActiveDownloads)">
            <span class="sb-live__dot"></span>@ActiveDownloads @L["layout.live_label"]
        </span>
    }
    @if (UserCtx.Me is { } me)
    {
        <button type="button" class="d-mobile-nav__avatar tv-focus" @onclick="OnProfileClick" aria-label="@L["mobile.open_profile_aria"]">
            <Avatar Name="@me.User.Name" HueOverride="me.User.AvatarHue" ImagePath="@me.User.AvatarPath" Size="sm" />
        </button>
    }
</nav>

<nav class="d-tabbar" aria-label="@L["mobile.tabbar_aria"]">
    @Tab("", "home", "home-f", L["nav.home"], !MoreOpen && IsHome())
    @Tab("library", "library", "library-f", L["nav.library"], !MoreOpen && IsRoute("/library"))
    @Tab("search", "search", "search", L["search.title"], !MoreOpen && IsRoute("/search"))
    @if (UserCtx.Can(p => p.UploadContent))
    {
        @Tab("downloads", "download", "download-f", L["topbar.downloads"], !MoreOpen && (IsRoute("/downloads") || IsRoute("/torrents")))
    }
    <button type="button" class="@($"d-tabbar__item tv-focus {(MoreOpen ? "d-tabbar__item--active" : "")}")"
            aria-expanded="@(MoreOpen ? "true" : "false")" @onclick="OnMoreClick">
        <DIcon Name="more" Size="24" />
        <span class="d-tabbar__label">@L["mobile.tab_more"]</span>
    </button>
</nav>

@code {
    [Parameter] public int ActiveDownloads { get; set; }
    [Parameter] public EventCallback OnProfileClickEvent { get; set; }
    /// <summary>"More" tab — the layout opens / closes the NavPane drawer.</summary>
    [Parameter] public EventCallback OnMoreClickEvent { get; set; }
    /// <summary>Whether that drawer is open (highlights the More tab).</summary>
    [Parameter] public bool MoreOpen { get; set; }

    private Task OnProfileClick() => OnProfileClickEvent.InvokeAsync();
    private Task OnMoreClick()    => OnMoreClickEvent.InvokeAsync();

    private RenderFragment Tab(string href, string icon, string iconActive, string label, bool active) => __builder =>
    {
        <a href="@href" class="@($"d-tabbar__item tv-focus {(active ? "d-tabbar__item--active" : "")}")"
           aria-current="@(active ? "page" : null)">
            <DIcon Name="@(active ? iconActive : icon)" Size="24" />
            <span class="d-tabbar__label">@label</span>
        </a>
    };

    private string Path => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimStart('/');
    private bool IsHome() => Path == "/";
    private bool IsRoute(string prefix) => Path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    // Re-render on navigation (active tab) and when the language pack finishes
    // loading — on MAUI the tab bar mounts before MainLayout hydrates the dict.
    protected override void OnInitialized()
    {
        Loc.LanguageChanged += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }
    public void Dispose()
    {
        Loc.LanguageChanged -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);
}
