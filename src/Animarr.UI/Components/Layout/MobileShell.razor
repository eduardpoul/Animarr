@*
    Mobile shell — top 56px strip + bottom tabbar. Only rendered on
    viewports < 960px (see d-mobile-nav / d-tabbar media queries in
    Styles/components.css). Mirrors the v3 pattern; v4 adds an
    Avatar-icon entry point to ProfilePanel.
*@

@inject NavigationManager Nav
@inject UserContextState UserCtx

<nav class="d-mobile-nav" aria-label="Top navigation">
    <a href="/" class="d-mobile-nav__brand tv-focus">
        <span class="animarr-brand-mark">A</span>
        <span class="animarr-brand-name">ANIMARR</span>
    </a>
    <span class="d-mobile-nav__spacer"></span>
    @if (ActiveDownloads > 0)
    {
        <span class="sb-live" title="@($"{ActiveDownloads} active")">
            <span class="sb-live__dot"></span>@ActiveDownloads LIVE
        </span>
    }
    @if (UserCtx.Me is { } me)
    {
        <button type="button" class="d-mobile-nav__avatar tv-focus" @onclick="OnProfileClick" aria-label="Open profile">
            <Avatar Name="@me.User.Name" HueOverride="me.User.AvatarHue" ImagePath="@me.User.AvatarPath" Size="sm" />
        </button>
    }
</nav>

<nav class="d-tabbar" aria-label="Primary mobile navigation">
    <NavLink class="d-tabbar__item tv-focus" Match="NavLinkMatch.All" href="" ActiveClass="d-tabbar__item--active">
        <DIcon Name="catalog" Size="22" />
        <span class="d-tabbar__label">@L["nav.catalog"]</span>
    </NavLink>
    @if (UserCtx.Can(p => p.UploadContent))
    {
        <NavLink class="d-tabbar__item tv-focus" Match="NavLinkMatch.Prefix" href="downloads" ActiveClass="d-tabbar__item--active">
            <DIcon Name="torrent" Size="22" />
            <span class="d-tabbar__label">@L["nav.torrents"]</span>
        </NavLink>
    }
    @* Settings tab — always visible. Opens ProfilePanel full-screen (the
       panel's own media-query expands to width: 100vw on mobile). The
       Server-Settings deep-link lives inside the panel's Identity tab,
       gated by the systemSettings permission. The previous /server
       NavLink that used to live here had two problems: it was hidden
       for non-admin users, leaving them with no Settings entry, and it
       skipped per-user prefs (theme / audio / language). *@
    <button type="button" class="d-tabbar__item tv-focus" @onclick="OnSettingsClick"
            aria-label="@L["nav.settings"]">
        <DIcon Name="settings" Size="22" />
        <span class="d-tabbar__label">@L["nav.settings"]</span>
    </button>
</nav>

@code {
    [Parameter] public int ActiveDownloads { get; set; }
    [Parameter] public EventCallback OnProfileClickEvent { get; set; }
    private Task OnProfileClick()  => OnProfileClickEvent.InvokeAsync();
    private Task OnSettingsClick() => OnProfileClickEvent.InvokeAsync();
}
