@* Global imports for every page/component in Animarr.UI.
   Phase 3 migrates Animarr.Web pages into this RCL; the using directives
   here mirror what the Razor pages need without pulling in any
   server-only types (no DbContext, no MonoTorrent, no DLNA service).

   IAnimarrApiClient is the only data dependency — pages call it directly. *@
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop

@using Animarr.Shared
@using Animarr.Shared.Models
@using Animarr.Shared.Realtime
@using Animarr.Shared.Requests
@using Animarr.UI
