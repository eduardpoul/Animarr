<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Animarr.App"
             x:Class="Animarr.App.NativeDetailPage"
             x:Name="Root"
             BackgroundColor="#0a0c10">
    <Grid>
    <ScrollView x:Name="PageScroll" Scrolled="OnPageScrolled">
        <VerticalStackLayout Spacing="0">

            <!-- ── HERO ─────────────────────────────────────────────── -->
            <Grid HeightRequest="360">
                <Image x:Name="BackdropImage" Aspect="AspectFill" />
                <BoxView InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#700a0c10" Offset="0" />
                            <GradientStop Color="#FF0a0c10" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <Label x:Name="CjkLabel" InputTransparent="True" HorizontalOptions="End"
                       VerticalOptions="Start" Margin="0,16,24,0" FontSize="40"
                       TextColor="#20FFFFFF" MaxLines="1" />

                <!-- back -->
                <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="24,18,0,0"
                        WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" BackgroundColor="#99000000">
                    <Border.Behaviors>
                        <local:TvFocusBehavior x:Name="BackFocus" Radius="12" />
                    </Border.Behaviors>
                    <Label Text="‹" TextColor="White" FontSize="26" TranslationY="-2" HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- favorite -->
                <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,18,24,0"
                        WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" BackgroundColor="#99000000">
                    <Border.Behaviors>
                        <local:TvFocusBehavior x:Name="FavFocus" Radius="12" />
                    </Border.Behaviors>
                    <Label x:Name="FavLabel" Text="☆" TextColor="White" FontSize="20" TranslationY="-1.5"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- poster + title block -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="26" VerticalOptions="End"
                      Padding="24,0,24,28">
                    <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            BackgroundColor="#15171d" VerticalOptions="End">
                        <Image x:Name="PosterImage" WidthRequest="150" HeightRequest="225"
                               Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="6">
                        <Label x:Name="TitleLabel" TextColor="White" FontFamily="ArchivoBlack" FontAttributes="Bold"
                               FontSize="34" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label x:Name="AltLabel" TextColor="#9aa3b2" FontFamily="GeistMono"
                               FontSize="13" IsVisible="False" />

                        <HorizontalStackLayout Spacing="7" Margin="0,4,0,0"
                                BindableLayout.ItemsSource="{Binding Pills, Source={x:Reference Root}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            Padding="9,3" BackgroundColor="#241c14">
                                        <Label Text="{Binding .}" TextColor="#e8a33d"
                                               FontFamily="GeistMono" FontSize="10" CharacterSpacing="0.8" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <Label x:Name="MetaLabel" TextColor="#cfd3da" FontFamily="GeistMono"
                               FontSize="12" CharacterSpacing="0.4" Margin="0,4,0,0" />

                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                BackgroundColor="#e8772e" Padding="24,11" HorizontalOptions="Start"
                                Margin="0,10,0,0">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="PlayFocus" Radius="8" />
                            </Border.Behaviors>
                            <Label x:Name="PlayLabel" Text="▶   Смотреть" TextColor="White"
                                   FontFamily="Geist" FontSize="15" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- ── 3-COLUMN BODY ────────────────────────────────────── -->
            <!-- synopsis gets the lion's share; details + identification hug the right -->
            <Grid ColumnDefinitions="1.6*,1*,0.8*" ColumnSpacing="48" Padding="24,22,24,6">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="SYNOPSIS" TextColor="#6b7280" FontFamily="GeistMono"
                           FontSize="10" CharacterSpacing="2" />
                    <Label x:Name="SynopsisLabel" TextColor="#b8bcc4" FontSize="13" LineHeight="1.45" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="DETAILS" TextColor="#6b7280" FontFamily="GeistMono"
                           FontSize="10" CharacterSpacing="2" />
                    <VerticalStackLayout Spacing="6"
                            BindableLayout.ItemsSource="{Binding DetailRows, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Key}" TextColor="#6b7280"
                                           FontFamily="GeistMono" FontSize="11" />
                                    <Label Grid.Column="1" Text="{Binding Value}" TextColor="#cfd3da" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="8">
                    <Label x:Name="IdentTitle" Text="IDENTIFICATION" TextColor="#6b7280"
                           FontFamily="GeistMono" FontSize="10" CharacterSpacing="2" />
                    <VerticalStackLayout Spacing="7"
                            BindableLayout.ItemsSource="{Binding IdentRows, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                            Padding="7,2" BackgroundColor="#1a1d24">
                                        <Label Text="{Binding Src}" TextColor="#9aa3b2"
                                               FontFamily="GeistMono" FontSize="10" />
                                    </Border>
                                    <Label Text="{Binding Id}" TextColor="#84c0d2" FontSize="12"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- ── SEASON TABS + grid⇄list toggle + watched counters ── -->
            <VerticalStackLayout x:Name="SeasonsSection" Padding="24,16,24,4" IsVisible="False"
                                 Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <ScrollView Grid.Column="0" Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10"
                                BindableLayout.ItemsSource="{Binding SeasonTabs, Source={x:Reference Root}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                            Padding="15,7" BackgroundColor="{Binding Bg}">
                                        <Border.Behaviors>
                                            <local:TvFocusBehavior Radius="16" Command="{Binding Select}" />
                                        </Border.Behaviors>
                                        <HorizontalStackLayout Spacing="7">
                                            <Label Text="{Binding Label}" TextColor="{Binding Fg}"
                                                   FontFamily="Geist" FontSize="13" />
                                            <Label Text="{Binding Count}" TextColor="{Binding CountFg}"
                                                   FontFamily="GeistMono" FontSize="11" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- grid ⇄ list, mirrors the web toggle + EpisodeListView pref -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Border x:Name="GridViewBtn" WidthRequest="34" HeightRequest="34"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="#1a1d24">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="GridViewFocus" Radius="10" />
                            </Border.Behaviors>
                            <Label x:Name="GridViewIcon" Text="⊞" TextColor="#c7ccd4" FontSize="16"
                                   TranslationY="-1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border x:Name="ListViewBtn" WidthRequest="34" HeightRequest="34"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="#1a1d24">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="ListViewFocus" Radius="10" />
                            </Border.Behaviors>
                            <Label x:Name="ListViewIcon" Text="☰" TextColor="#c7ccd4" FontSize="14"
                                   TranslationY="-1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
                <!-- web: "164 of 175 watched · 171 of 175 on disk" -->
                <Label x:Name="WatchedCounter" TextColor="#6b7280" FontFamily="GeistMono"
                       FontSize="10" CharacterSpacing="0.4" IsVisible="False" />
            </VerticalStackLayout>

            <!-- ── EPISODES: code-built cards, appended in chunks as the page
                 scrolls toward the end (no per-visit cap — see AppendEpisodeChunk).
                 Right padding 14: the last card in a row carries its own 10dp gap. ── -->
            <FlexLayout x:Name="EpisodesHost" Wrap="Wrap" Direction="Row"
                        JustifyContent="Start" AlignItems="Start" AlignContent="Start"
                        Padding="24,14,14,60" />
        </VerticalStackLayout>
    </ScrollView>

    <!-- loading spinner until the detail payload lands -->
    <ActivityIndicator x:Name="Loader" IsRunning="True" Color="#e8772e"
                       WidthRequest="52" HeightRequest="52"
                       VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
