<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Animarr.App"
             x:Class="Animarr.App.NativeDetailPage"
             x:Name="Root"
             BackgroundColor="#0a0c10">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── HERO ─────────────────────────────────────────────── -->
            <Grid HeightRequest="360">
                <Image x:Name="BackdropImage" Aspect="AspectFill" />
                <BoxView InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#700a0c10" Offset="0" />
                            <GradientStop Color="#FF0a0c10" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <Label x:Name="CjkLabel" InputTransparent="True" HorizontalOptions="End"
                       VerticalOptions="Start" Margin="0,16,24,0" FontSize="40"
                       TextColor="#20FFFFFF" MaxLines="1" />

                <!-- back -->
                <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="56,20,0,0"
                        WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" BackgroundColor="#99000000">
                    <Border.Behaviors>
                        <local:TvFocusBehavior x:Name="BackFocus" Radius="12" />
                    </Border.Behaviors>
                    <Label Text="‹" TextColor="White" FontSize="26" HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- favorite -->
                <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,20,56,0"
                        WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" BackgroundColor="#99000000">
                    <Border.Behaviors>
                        <local:TvFocusBehavior x:Name="FavFocus" Radius="12" />
                    </Border.Behaviors>
                    <Label x:Name="FavLabel" Text="☆" TextColor="White" FontSize="20"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- poster + title block -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="26" VerticalOptions="End"
                      Padding="56,0,56,28">
                    <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            BackgroundColor="#15171d" VerticalOptions="End">
                        <Image x:Name="PosterImage" WidthRequest="150" HeightRequest="225"
                               Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="6">
                        <Label x:Name="TitleLabel" TextColor="White" FontFamily="ArchivoBlack"
                               FontSize="34" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label x:Name="AltLabel" TextColor="#9aa3b2" FontFamily="GeistMono"
                               FontSize="13" IsVisible="False" />

                        <HorizontalStackLayout Spacing="7" Margin="0,4,0,0"
                                BindableLayout.ItemsSource="{Binding Pills, Source={x:Reference Root}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            Padding="9,3" BackgroundColor="#241c14">
                                        <Label Text="{Binding .}" TextColor="#e8a33d"
                                               FontFamily="GeistMono" FontSize="10" CharacterSpacing="0.8" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <Label x:Name="MetaLabel" TextColor="#cfd3da" FontFamily="GeistMono"
                               FontSize="12" CharacterSpacing="0.4" Margin="0,4,0,0" />

                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                BackgroundColor="#e8772e" Padding="24,11" HorizontalOptions="Start"
                                Margin="0,10,0,0">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="PlayFocus" Radius="8" />
                            </Border.Behaviors>
                            <Label x:Name="PlayLabel" Text="▶   Смотреть" TextColor="White"
                                   FontFamily="Geist" FontSize="15" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- ── 3-COLUMN BODY ────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="40" Padding="60,22,60,6">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="SYNOPSIS" TextColor="#6b7280" FontFamily="GeistMono"
                           FontSize="10" CharacterSpacing="2" />
                    <Label x:Name="SynopsisLabel" TextColor="#b8bcc4" FontSize="13" LineHeight="1.45" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="DETAILS" TextColor="#6b7280" FontFamily="GeistMono"
                           FontSize="10" CharacterSpacing="2" />
                    <VerticalStackLayout Spacing="6"
                            BindableLayout.ItemsSource="{Binding DetailRows, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Key}" TextColor="#6b7280"
                                           FontFamily="GeistMono" FontSize="11" />
                                    <Label Grid.Column="1" Text="{Binding Value}" TextColor="#cfd3da" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="8">
                    <Label x:Name="IdentTitle" Text="IDENTIFICATION" TextColor="#6b7280"
                           FontFamily="GeistMono" FontSize="10" CharacterSpacing="2" />
                    <VerticalStackLayout Spacing="7"
                            BindableLayout.ItemsSource="{Binding IdentRows, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                            Padding="7,2" BackgroundColor="#1a1d24">
                                        <Label Text="{Binding Src}" TextColor="#9aa3b2"
                                               FontFamily="GeistMono" FontSize="10" />
                                    </Border>
                                    <Label Text="{Binding Id}" TextColor="#84c0d2" FontSize="12"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- ── SEASON TABS ──────────────────────────────────────── -->
            <VerticalStackLayout x:Name="SeasonsSection" Padding="60,16,40,4" IsVisible="False">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10"
                            BindableLayout.ItemsSource="{Binding SeasonTabs, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                        Padding="15,7" BackgroundColor="{Binding Bg}">
                                    <Border.Behaviors>
                                        <local:TvFocusBehavior Radius="16" Command="{Binding Select}" />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="7">
                                        <Label Text="{Binding Label}" TextColor="{Binding Fg}"
                                               FontFamily="Geist" FontSize="13" />
                                        <Label Text="{Binding Count}" TextColor="{Binding CountFg}"
                                               FontFamily="GeistMono" FontSize="11" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- ── EPISODES (FlexLayout wrap; each a native focus target) ── -->
            <FlexLayout Wrap="Wrap" Direction="Row" Padding="60,14,40,60"
                        BindableLayout.ItemsSource="{Binding Episodes, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#15171d"
                                Margin="0,0,16,16" WidthRequest="236" Opacity="{Binding ArtOpacity}">
                            <Border.Behaviors>
                                <local:TvFocusBehavior Radius="8" Command="{Binding Play}" />
                            </Border.Behaviors>
                            <VerticalStackLayout>
                                <Grid HeightRequest="133">
                                    <Image Source="{Binding ThumbUrl}" Aspect="AspectFill" />
                                    <BoxView InputTransparent="True">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0.3" />
                                                <GradientStop Color="#C7000000" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <BoxView HorizontalOptions="Start" WidthRequest="3"
                                             Color="{Binding Strip}" InputTransparent="True" />
                                    <Label Text="{Binding Number}" InputTransparent="True"
                                           HorizontalOptions="Start" VerticalOptions="Start"
                                           Margin="12,8,0,0" FontFamily="ArchivoBlack" FontSize="24" TextColor="White" />
                                    <Border InputTransparent="True" HorizontalOptions="End" VerticalOptions="Start"
                                            Margin="0,8,8,0" WidthRequest="26" HeightRequest="26" StrokeThickness="1"
                                            Stroke="{Binding ChipFg}" StrokeShape="RoundRectangle 6" BackgroundColor="#66000000">
                                        <Label Text="{Binding ChipText}" TextColor="{Binding ChipFg}"
                                               FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <ProgressBar Progress="{Binding BarValue}" ProgressColor="{Binding BarColor}"
                                                 IsVisible="{Binding HasBar}" VerticalOptions="End" InputTransparent="True" />
                                </Grid>
                                <VerticalStackLayout Padding="12,8,12,10" Spacing="1">
                                    <Label Text="{Binding Title}" TextColor="{Binding TitleFg}"
                                           FontFamily="Geist" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Meta}" TextColor="{Binding MetaFg}"
                                           FontFamily="GeistMono" FontSize="9" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>

    <!-- loading spinner until the detail payload lands -->
    <ActivityIndicator x:Name="Loader" IsRunning="True" Color="#e8772e"
                       WidthRequest="52" HeightRequest="52"
                       VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
