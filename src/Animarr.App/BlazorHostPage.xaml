<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:Animarr.UI.Components;assembly=Animarr.UI"
             x:Class="Animarr.App.BlazorHostPage"
             BackgroundColor="#0a0c10">
    <!-- Hybrid: hosts the existing Blazor app (same Routes component as the
         WASM client / old MainPage) at a given StartPath, pushed over the native
         catalog. Lets the long-tail screens (settings, themes, pairing,
         discovery, edit-metadata) work as-is without a native rewrite. -->
    <BlazorWebView x:Name="WebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
