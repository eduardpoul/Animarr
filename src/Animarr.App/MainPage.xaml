<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Animarr.App"
             xmlns:ui="clr-namespace:Animarr.UI.Components;assembly=Animarr.UI"
             x:Class="Animarr.App.MainPage">

    <!--
        Hosts the same Animarr.UI Routes component as the WASM client.
        BlazorWebView renders inside a native shell, so iOS / Android / macOS
        / Windows all get identical UI, talking to the API via HttpClient
        configured in MauiProgram.cs.
    -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
