<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Animarr.App"
             x:Class="Animarr.App.ServerPickerPage"
             x:Name="Root"
             BackgroundColor="#1c1c1c">
    <Grid RowDefinitions="*,Auto,*" Padding="80,0">
        <VerticalStackLayout Grid.Row="1" Spacing="18" MaximumWidthRequest="720"
                             HorizontalOptions="Center">
            <Label Text="ВЫБОР СЕРВЕРА" TextColor="#f49157" FontFamily="sans-serif"
                   FontSize="13" CharacterSpacing="3" />
            <Label Text="Подключитесь к серверу Animarr"
                   TextColor="White" FontFamily="sans-serif-medium" FontAttributes="Bold" FontSize="34" />

            <!-- Discovered servers appear here as focusable cards. -->
            <VerticalStackLayout x:Name="FoundList" Spacing="10" Margin="0,10,0,0" />

            <Label Text="Или введите адрес вручную" TextColor="#9a9a9a"
                   FontFamily="sans-serif" FontSize="12" CharacterSpacing="1" Margin="0,8,0,0" />

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="#2b2b2b" Padding="16,4">
                <Entry x:Name="UrlEntry" Placeholder="192.168.1.50:8080"
                       TextColor="White" PlaceholderColor="#8f8f8f"
                       FontFamily="sans-serif" FontSize="18" Keyboard="Url"
                       BackgroundColor="Transparent" />
            </Border>

            <Border x:Name="ConnectButton" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="#bb5000" Padding="0,15" HorizontalOptions="Fill">
                <Border.Behaviors>
                    <local:TvFocusBehavior x:Name="ConnectFocus" Radius="10" />
                </Border.Behaviors>
                <Label Text="Подключиться" TextColor="White" FontFamily="sans-serif"
                       FontSize="17" HorizontalOptions="Center" />
            </Border>

            <Label x:Name="StatusLabel" Text="" TextColor="#9a9a9a"
                   FontFamily="sans-serif" FontSize="13" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
