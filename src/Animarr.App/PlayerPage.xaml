<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Animarr.App"
             x:Class="Animarr.App.PlayerPage"
             x:Name="Root"
             BackgroundColor="Black">
    <Grid x:Name="RootGrid">
        <!-- native ExoPlayer TextureView is inserted at index 0 in code-behind -->

        <!-- HUD overlay (hidden by default; shown via code-behind) -->
        <Grid x:Name="Hud" IsVisible="False">

            <!-- top scrim + back hint + title -->
            <Grid VerticalOptions="Start" HeightRequest="150">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#CC000000" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <VerticalStackLayout Padding="56,26,56,0" Spacing="4" VerticalOptions="Start">
                    <Label Text="‹  НАЗАД" TextColor="#8b93a1" FontFamily="GeistMono"
                           FontSize="11" CharacterSpacing="2" />
                    <Label x:Name="TitleLabel" TextColor="White" FontFamily="ArchivoBlack"
                           FontSize="26" MaxLines="1" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <!-- centre flash icon + buffering -->
            <Grid VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="104" HeightRequest="104">
                <Border StrokeThickness="0" BackgroundColor="#59000000"
                        StrokeShape="RoundRectangle 52" WidthRequest="104" HeightRequest="104">
                    <Label x:Name="CenterIcon" Text="❚❚" TextColor="White" FontSize="40"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <ActivityIndicator x:Name="BufferSpinner" IsRunning="True" IsVisible="False"
                                   Color="#e8772e" WidthRequest="72" HeightRequest="72"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- skip intro / credits (focusable) -->
            <Border x:Name="SkipButton" IsVisible="False" HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,56,210" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="#E6e8772e" Padding="20,12">
                <Border.Behaviors>
                    <local:TvFocusBehavior x:Name="SkipFocus" Radius="10" />
                </Border.Behaviors>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="▲" TextColor="White" FontSize="14" VerticalOptions="Center" />
                    <Label x:Name="SkipLabel" Text="Пропустить" TextColor="White"
                           FontFamily="Geist" FontSize="15" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- bottom scrim + scrubber + time + transport buttons -->
            <Grid VerticalOptions="End" HeightRequest="230">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="#E6000000" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <VerticalStackLayout VerticalOptions="End" Padding="56,0,56,34" Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Label Grid.Column="0" x:Name="PositionLabel" Text="0:00" TextColor="White"
                               FontFamily="GeistMono" FontSize="14" VerticalOptions="Center" />
                        <ProgressBar Grid.Column="1" x:Name="Scrubber" Progress="0"
                                     ProgressColor="#e8772e" VerticalOptions="Center" />
                        <Label Grid.Column="2" x:Name="DurationLabel" Text="0:00" TextColor="#cfd3da"
                               FontFamily="GeistMono" FontSize="14" VerticalOptions="Center" />
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Start" Spacing="10">
                        <Border x:Name="SeekBackButton" WidthRequest="50" HeightRequest="38"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#26FFFFFF">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="SeekBackFocus" Radius="8" />
                            </Border.Behaviors>
                            <Label Text="⏪" FontSize="15" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border x:Name="PlayPauseButton" WidthRequest="54" HeightRequest="38"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#e8772e">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="PlayPauseFocus" Radius="8" />
                            </Border.Behaviors>
                            <Label x:Name="PlayPauseIcon" Text="❚❚" FontSize="16" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border x:Name="SeekFwdButton" WidthRequest="50" HeightRequest="38"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#26FFFFFF">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="SeekFwdFocus" Radius="8" />
                            </Border.Behaviors>
                            <Label Text="⏩" FontSize="15" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
