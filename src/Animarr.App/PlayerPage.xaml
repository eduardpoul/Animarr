<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Animarr.App.PlayerPage"
             x:Name="Root"
             BackgroundColor="Black">
    <Grid x:Name="RootGrid">
        <!-- native ExoPlayer TextureView is inserted at index 0 in code-behind -->

        <!-- HUD overlay (visual only; control is via D-pad in code-behind) -->
        <Grid x:Name="Hud" InputTransparent="True">

            <!-- top scrim + back hint + title -->
            <Grid VerticalOptions="Start" HeightRequest="150">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#CC000000" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <VerticalStackLayout Padding="56,26,56,0" Spacing="4" VerticalOptions="Start">
                    <Label Text="‹  НАЗАД" TextColor="#8b93a1" FontFamily="GeistMono"
                           FontSize="11" CharacterSpacing="2" />
                    <Label x:Name="TitleLabel" TextColor="White" FontFamily="ArchivoBlack"
                           FontSize="26" MaxLines="1" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <!-- centre play/pause + buffering -->
            <Grid VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="104" HeightRequest="104">
                <Border StrokeThickness="0" BackgroundColor="#66000000"
                        StrokeShape="RoundRectangle 52" WidthRequest="104" HeightRequest="104">
                    <Label x:Name="CenterIcon" Text="❚❚" TextColor="White" FontSize="40"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <ActivityIndicator x:Name="BufferSpinner" IsRunning="True" IsVisible="False"
                                   Color="#e8772e" WidthRequest="72" HeightRequest="72"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- skip intro / credits (▲) -->
            <Border x:Name="SkipButton" IsVisible="False" HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,56,150" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="#E6e8772e" Padding="20,12">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="▲" TextColor="White" FontSize="14" VerticalOptions="Center" />
                    <Label x:Name="SkipLabel" Text="Пропустить" TextColor="White"
                           FontFamily="Geist" FontSize="15" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- bottom scrim + scrubber + time + hints -->
            <Grid VerticalOptions="End" HeightRequest="170">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="#E6000000" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <VerticalStackLayout VerticalOptions="End" Padding="56,0,56,40" Spacing="12">
                    <ProgressBar x:Name="Scrubber" Progress="0" ProgressColor="#e8772e" />
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" x:Name="PositionLabel" Text="0:00" TextColor="White"
                               FontFamily="GeistMono" FontSize="14" />
                        <Label Grid.Column="1" Text="◀ ▶  перемотка ±10с    ·    OK  пауза    ·    ▲  пропустить"
                               TextColor="#7b8290" FontFamily="GeistMono" FontSize="11"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Grid.Column="2" x:Name="DurationLabel" Text="0:00" TextColor="#cfd3da"
                               FontFamily="GeistMono" FontSize="14" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
