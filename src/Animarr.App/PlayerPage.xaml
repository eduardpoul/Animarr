<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Animarr.App"
             x:Class="Animarr.App.PlayerPage"
             x:Name="Root"
             BackgroundColor="Black">
    <Grid x:Name="RootGrid">
        <!-- the ExoPlayer SurfaceView (index 0) and the SubtitleView (index 1)
             are inserted in code-behind -->

        <Grid x:Name="Hud" IsVisible="False">

            <!-- top: back (left) + now-playing (centre). The gradient is
                 full-bleed (no container padding) so it fades edge-to-edge like
                 the bottom bar — otherwise the inset scrim reads as a floating
                 "frame". Button + title get their insets via Margin instead. -->
            <Grid VerticalOptions="Start" HeightRequest="150">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B3000000" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Border x:Name="BackButton" HorizontalOptions="Start" VerticalOptions="Start"
                        Margin="40,26,0,0" WidthRequest="48" HeightRequest="38" StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                    <Border.Behaviors>
                        <local:TvFocusBehavior x:Name="BackFocus" Radius="8" FillOnFocus="True" />
                    </Border.Behaviors>
                    <Label Text="‹" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Margin="0,28,0,0" Spacing="2">
                    <Label x:Name="EyebrowLabel" Text="NOW PLAYING" TextColor="#f49157"
                           FontFamily="sans-serif" FontSize="10" CharacterSpacing="2"
                           HorizontalOptions="Center" />
                    <Label x:Name="TitleLabel" TextColor="White" FontFamily="sans-serif-medium" FontAttributes="Bold"
                           FontSize="18" MaxLines="1" LineBreakMode="TailTruncation"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- buffering -->
            <ActivityIndicator x:Name="BufferSpinner" IsRunning="True" IsVisible="False"
                               Color="#bb5000" WidthRequest="64" HeightRequest="64"
                               HorizontalOptions="Center" VerticalOptions="Center" />

            <!-- bottom: progress + time + controls -->
            <Grid VerticalOptions="End" HeightRequest="180">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="#E6000000" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <VerticalStackLayout VerticalOptions="End" Padding="40,0,40,28" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0" x:Name="PositionLabel" Text="0:00" TextColor="White"
                               FontFamily="sans-serif" FontSize="13" VerticalOptions="Center" />
                        <!-- seek bar + chapter ticks (laid out in code-behind) -->
                        <Grid Grid.Column="1" VerticalOptions="Center" HeightRequest="14">
                            <ProgressBar x:Name="Scrubber" Progress="0"
                                         ProgressColor="#bb5000" VerticalOptions="Center" />
                            <AbsoluteLayout x:Name="ChapterMarks" InputTransparent="True" />
                        </Grid>
                        <Label Grid.Column="2" x:Name="DurationLabel" Text="0:00" TextColor="#d6d6d6"
                               FontFamily="sans-serif" FontSize="13" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <!-- left: transport cluster -->
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Border x:Name="SeekBackButton" WidthRequest="48" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="SeekBackFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="-10" TextColor="White" FontFamily="sans-serif" FontSize="12"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="PrevButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="PrevFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="⏮" TextColor="White" FontSize="14"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="PlayPauseButton" WidthRequest="52" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="PlayPauseFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label x:Name="PlayPauseIcon" Text="❚❚" TextColor="White" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="NextButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="NextFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="⏭" TextColor="White" FontSize="14"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="SeekFwdButton" WidthRequest="48" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="SeekFwdFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="+10" TextColor="White" FontFamily="sans-serif" FontSize="12"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="SkipButton" IsVisible="False" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="#E6bb5000" Padding="14,0" Margin="8,0,0,0">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="SkipFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label x:Name="SkipLabel" Text="Пропустить" TextColor="White" FontFamily="sans-serif"
                                       FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- right: settings cluster -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <!-- playback speed 0.5–2× (remembered) -->
                            <Border x:Name="SpeedButton" WidthRequest="52" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="SpeedFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label x:Name="SpeedLabel" Text="1×" TextColor="White" FontFamily="sans-serif" FontSize="12"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="VolumeButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="VolumeFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="VOL" TextColor="White" FontFamily="sans-serif" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="AudioButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="AudioFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="AT" TextColor="White" FontFamily="sans-serif" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="SubsButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="SubsFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="CC" TextColor="White" FontFamily="sans-serif" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="QualityButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="QualityFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="HD" TextColor="White" FontFamily="sans-serif" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <!-- aspect ratio (fit / stretch / zoom / forced) -->
                            <Border x:Name="AspectButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="AspectFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="AR" TextColor="White" FontFamily="sans-serif" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="InfoButton" WidthRequest="44" HeightRequest="36" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Border.Behaviors><local:TvFocusBehavior x:Name="InfoFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                                <Label Text="ⓘ" TextColor="White" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- transient info line (codec / audio / subs / quality feedback, seek
             target): outside the HUD, so it also shows while the HUD is hidden
             (a seek with ◀/▶, a fallback rung, a media key). -->
        <Label x:Name="InfoLine" IsVisible="False" Text="" TextColor="White"
               FontFamily="sans-serif" FontSize="13" HorizontalOptions="Center"
               VerticalOptions="End" Margin="0,0,0,200" BackgroundColor="#B3000000"
               Padding="16,8" />

        <!-- Up Next: the next episode near the credits (detected start, else
             95 %), a countdown in the last 10 s, then the next episode starts.
             Shown with the HUD, and on its own while it announces itself and
             during the countdown. -->
        <Border x:Name="UpNextCard" IsVisible="False" HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,40,200" Padding="22,16" WidthRequest="440" StrokeThickness="0"
                StrokeShape="RoundRectangle 14" BackgroundColor="#F2202020">
            <VerticalStackLayout Spacing="10">
                <Label Text="ДАЛЕЕ" TextColor="#f49157" FontFamily="sans-serif" FontSize="10" CharacterSpacing="2" />
                <Label x:Name="UpNextName" Text="" TextColor="White" FontFamily="sans-serif-medium"
                       FontAttributes="Bold" FontSize="17" MaxLines="1" LineBreakMode="TailTruncation" />
                <HorizontalStackLayout Spacing="8">
                    <Border x:Name="UpNextPlayButton" HeightRequest="36" Padding="14,0" StrokeThickness="0"
                            StrokeShape="RoundRectangle 8" BackgroundColor="#E6bb5000">
                        <Border.Behaviors><local:TvFocusBehavior x:Name="UpNextPlayFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                        <Label x:Name="UpNextPlayLabel" Text="▶  Смотреть" TextColor="White" FontFamily="sans-serif"
                               FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="UpNextSkipButton" IsVisible="False" HeightRequest="36" Padding="14,0" StrokeThickness="0"
                            StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                        <Border.Behaviors><local:TvFocusBehavior x:Name="UpNextSkipFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                        <Label Text="Пропустить титры" TextColor="White" FontFamily="sans-serif"
                               FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="UpNextHideButton" HeightRequest="36" Padding="14,0" StrokeThickness="0"
                            StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                        <Border.Behaviors><local:TvFocusBehavior x:Name="UpNextHideFocus" Radius="8" FillOnFocus="True" /></Border.Behaviors>
                        <Label Text="Скрыть" TextColor="#d6d6d6" FontFamily="sans-serif"
                               FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
                <Label x:Name="UpNextHint" Text="OK — смотреть · Назад — скрыть" TextColor="#9a9a9a"
                       FontFamily="sans-serif" FontSize="11" />
            </VerticalStackLayout>
        </Border>

        <!-- submenu overlay: volume slider / audio-subs-quality selection.
             Sits above the HUD; keys are captured in code-behind (_sheetMode). -->
        <Grid x:Name="SheetOverlay" IsVisible="False">
            <BoxView Color="#B3000000" />
            <Border HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="#F22b2b2b" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16" Padding="26,22" MinimumWidthRequest="380">
                <VerticalStackLayout Spacing="16">
                    <Label x:Name="SheetTitle" Text="" TextColor="White"
                           FontFamily="sans-serif-medium" FontAttributes="Bold" FontSize="15" CharacterSpacing="1" />

                    <!-- volume: focusable slider row (◀/▶ adjust, OK closes) -->
                    <VerticalStackLayout x:Name="VolumePanel" IsVisible="False" Spacing="10" WidthRequest="400">
                        <Border x:Name="VolumeSlider" BackgroundColor="Transparent" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8" Padding="14,10">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="VolumeSliderFocus" Radius="8" FillOnFocus="True" />
                            </Border.Behaviors>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Label Grid.Column="0" Text="VOL" TextColor="#b3b3b3"
                                       FontFamily="sans-serif" FontSize="12" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" x:Name="VolumeBar" Progress="1"
                                             ProgressColor="#bb5000" VerticalOptions="Center" />
                                <Label Grid.Column="2" x:Name="VolumeValue" Text="100%" TextColor="White"
                                       FontFamily="sans-serif" FontSize="13" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="◀ / ▶ — тише / громче · OK — готово" TextColor="#9a9a9a"
                               FontFamily="sans-serif" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- audio / subtitles / quality: option rows built in code-behind.
                         Scrolls (the focused row is kept in view) so a file with
                         10+ subtitle tracks stays reachable. -->
                    <ScrollView x:Name="SheetScroll" IsVisible="False" Orientation="Vertical"
                                WidthRequest="460" MaximumHeightRequest="380" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="SheetItems" Spacing="4" MinimumWidthRequest="360" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
