<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Network Security Config — relaxes the strict defaults so the
    BlazorWebView can reach a self-hosted Animarr server on the LAN.

    Default Android policy (since API 28):
      • cleartext HTTP blocked everywhere
      • user-added CAs not trusted by app traffic
      • WebView inherits the same restrictions

    For a self-hosted setup we typically want:
      • HTTP allowed on RFC1918 / .local / .lan / explicit LAN IPs
      • System CAs trusted for everything else (HTTPS to public)
      • User-added CAs trusted *only* for debug builds (lets you import a
        self-signed Caddy cert via Settings → Security → Trusted Credentials)

    Drop your tower's hostname (or LAN IP range) into the cleartext domain
    list. The wildcards cover the common private ranges.
-->
<network-security-config>

    <!-- Allow cleartext + invalid certs to typical LAN destinations. Tighten
         this if your tower is reachable over HTTPS — leave only the entries
         you actually need. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">tower.one</domain>
        <domain includeSubdomains="true">animarr.tower.one</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>       <!-- Android emulator → host -->
        <domain includeSubdomains="false">192.168.0.0/16</domain>
        <domain includeSubdomains="false">10.0.0.0/8</domain>
        <domain includeSubdomains="false">172.16.0.0/12</domain>
        <domain includeSubdomains="true">local</domain>            <!-- .local mDNS -->
        <domain includeSubdomains="true">lan</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>

    <!-- Everywhere else: strict HTTPS, system CAs only. Debug builds also
         trust user-added CAs so you can drop a self-signed cert in Settings
         and have it Just Work for testing. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>

</network-security-config>
