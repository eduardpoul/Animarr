<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>

    <!-- App Transport Security
         Self-hosted Animarr server may be reachable via LAN-only IP, mDNS
         (.local), or a self-signed Caddy cert. The default ATS policy blocks
         all three. NSAllowsLocalNetworking permits clear-text + invalid-cert
         loads from RFC1918 / .local hosts, while NSAllowsArbitraryLoadsInWebContent
         relaxes only the WKWebView surface — the network layer stays strict
         for any background HTTP we do from native code. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>

    <!-- Local Network usage description — required since iOS 14 when the app
         talks to anything on the LAN (Animarr server on 192.168.x.x, DLNA
         discovery). Without it iOS silently drops the connection on first
         attempt. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Animarr needs local network access to reach your self-hosted server and stream media.</string>

    <!-- Bonjour services we may use for server discovery (mDNS). -->
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp</string>
        <string>_https._tcp</string>
    </array>

    <!-- Background-audio capability so playback continues when screen locks
         or user switches apps. Pairs with MediaSession in the WebView. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
