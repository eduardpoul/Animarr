<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Animarr.App"
             x:Class="Animarr.App.CatalogNativePage"
             x:Name="Root"
             BackgroundColor="#0a0c10">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="6">

                <!-- ── HERO ─────────────────────────────────────────────── -->
                <Grid HeightRequest="380">
                    <Image Source="{Binding Hero.Backdrop, Source={x:Reference Root}}"
                           Aspect="AspectFill" />
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F00a0c10" Offset="0" />
                                <GradientStop Color="#000a0c10" Offset="0.7" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.4" />
                                <GradientStop Color="#FF0a0c10" Offset="1" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Start"
                                         Padding="60,0,0,30" Spacing="8" MaximumWidthRequest="820">
                        <Label Text="{Binding Hero.Eyebrow, Source={x:Reference Root}}"
                               TextColor="#e8a33d" FontFamily="GeistMono" FontSize="11"
                               CharacterSpacing="2.5" />
                        <Label Text="{Binding Hero.Title, Source={x:Reference Root}}"
                               TextColor="White" FontFamily="ArchivoBlack" FontSize="42"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Hero.Meta, Source={x:Reference Root}}"
                               TextColor="#cfd3da" FontFamily="GeistMono" FontSize="13"
                               CharacterSpacing="0.5" Margin="0,2,0,0" />
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                BackgroundColor="#e8772e" Padding="26,12"
                                HorizontalOptions="Start" Margin="0,12,0,0">
                            <Border.Behaviors>
                                <local:TvFocusBehavior x:Name="HeroFocus" Radius="8" />
                            </Border.Behaviors>
                            <Label Text="▶   Смотреть" TextColor="White" FontFamily="Geist" FontSize="15" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- ── RAILS (BindableLayout so each poster is a real focus target) ── -->
                <VerticalStackLayout Spacing="28" Padding="0,12,0,60"
                        BindableLayout.ItemsSource="{Binding Rails, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding Title}" TextColor="#e8eaed"
                                       FontFamily="Geist" FontSize="20" Margin="60,0,0,0" />
                                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout Spacing="16" Padding="60,6,40,10"
                                            BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                        BackgroundColor="#15171d" WidthRequest="170">
                                                    <Border.Behaviors>
                                                        <local:TvFocusBehavior Radius="10" Command="{Binding Open}" />
                                                    </Border.Behaviors>
                                                    <Grid RowDefinitions="255,Auto">
                                                        <Grid Grid.Row="0">
                                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                                            <BoxView InputTransparent="True">
                                                                <BoxView.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="Transparent" Offset="0.55" />
                                                                        <GradientStop Color="#D90A0807" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </BoxView.Background>
                                                            </BoxView>
                                                            <Border InputTransparent="True" HorizontalOptions="Start"
                                                                    VerticalOptions="Start" Margin="8" Padding="6,2"
                                                                    IsVisible="{Binding HasType}"
                                                                    StrokeThickness="1" Stroke="#1FFFFFFF"
                                                                    StrokeShape="RoundRectangle 3" BackgroundColor="#8C000000">
                                                                <Label Text="{Binding TypeLabel}" FontFamily="GeistMono"
                                                                       FontSize="8" TextColor="White" CharacterSpacing="1.4" />
                                                            </Border>
                                                            <ProgressBar Progress="{Binding Progress}"
                                                                         IsVisible="{Binding HasProgress}"
                                                                         ProgressColor="#e8772e" VerticalOptions="End"
                                                                         InputTransparent="True" />
                                                        </Grid>
                                                        <Label Grid.Row="1" Text="{Binding Title}" FontFamily="Geist"
                                                               FontSize="12" TextColor="White" MaxLines="2"
                                                               LineBreakMode="TailTruncation" Padding="10,7,10,10"
                                                               HeightRequest="54" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── TOP BAR (overlay) ────────────────────────────────────────── -->
        <Grid VerticalOptions="Start" Padding="60,22,32,0" ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="12">
            <Label Grid.Column="0" Text="ANIMARR" TextColor="White" FontFamily="ArchivoBlack"
                   FontSize="22" CharacterSpacing="3" VerticalOptions="Center" />

            <Border Grid.Column="2" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" BackgroundColor="#B3151a21">
                <Border.Behaviors>
                    <local:TvFocusBehavior x:Name="SearchFocus" Radius="12" />
                </Border.Behaviors>
                <Label Text="🔍" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Border Grid.Column="3" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" BackgroundColor="#e8772e">
                <Border.Behaviors>
                    <local:TvFocusBehavior x:Name="ProfileFocus" Radius="12" />
                </Border.Behaviors>
                <Label Text="👤" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
